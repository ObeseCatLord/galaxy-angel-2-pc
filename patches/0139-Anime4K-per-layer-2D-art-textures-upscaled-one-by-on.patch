+        // ---- per-layer upscaling (ga2_layers, gs_texpacks.h) ----------------------------------------------------------
+        // Two chains: the second 2x step reads the first's output (each chain owns its result texture).
+        std::unique_ptr<ga2_mpv::Chain> g_layerChain[2];
+        int g_layerChainKind = -1; // 0 Anime4K, 1 Anime4K HQ
+
+        std::unique_ptr<ga2_mpv::Chain> layerChain(bool hq)
+        {
+            const std::vector<std::string> files =
+                hq ? std::vector<std::string>{"anime4k/Anime4K_Clamp_Highlights.glsl", "anime4k/Anime4K_Restore_CNN_VL.glsl",
+                                              "anime4k/Anime4K_Upscale_CNN_x2_VL.glsl"}
+                   : std::vector<std::string>{"anime4k/Anime4K_Clamp_Highlights.glsl", "anime4k/Anime4K_Restore_CNN_M.glsl",
+                                              "anime4k/Anime4K_Upscale_CNN_x2_M.glsl"};
+            auto chain = std::make_unique<ga2_mpv::Chain>();
+            for (const std::string &file : files)
+            {
+                std::string error;
+                const std::string text = readFile(shaderDir() / file);
+                if (text.empty() || !chain->add(text, file, error))
+                {
+                    std::fprintf(stderr, "[layers] cannot use %s%s%s\n", file.c_str(), error.empty() ? "" : ": ", error.c_str());
+                    return nullptr;
+                }
+            }
+            return chain;
+        }
+
+        // Colour into the transparent pixels from their opaque neighbours (a few rings), so the network does not
+        // see the black behind a sprite's edge.
+        void bleed(std::vector<uint32_t> &rgba, uint32_t w, uint32_t h)
+        {
+            std::vector<uint8_t> known(rgba.size()), nextKnown;
+            for (size_t i = 0; i < rgba.size(); ++i)
+                known[i] = (rgba[i] >> 24) >= 8u ? 1 : 0;
+            std::vector<uint32_t> next = rgba;
+            for (int pass = 0; pass < 6; ++pass)
+            {
+                nextKnown = known;
+                bool any = false;
+                for (uint32_t y = 0; y < h; ++y)
+                    for (uint32_t x = 0; x < w; ++x)
+                    {
+                        const size_t at = size_t(y) * w + x;
+                        if (known[at])
+                            continue;
+                        uint32_t r = 0, g = 0, b = 0, n = 0;
+                        for (int dy = -1; dy <= 1; ++dy)
+                            for (int dx = -1; dx <= 1; ++dx)
+                            {
+                                const int nx = int(x) + dx, ny = int(y) + dy;
+                                if (nx < 0 || ny < 0 || nx >= int(w) || ny >= int(h) || !known[size_t(ny) * w + size_t(nx)])
+                                    continue;
+                                const uint32_t o = rgba[size_t(ny) * w + size_t(nx)];
+                                r += o & 255u, g += (o >> 8) & 255u, b += (o >> 16) & 255u, ++n;
+                            }
+                        if (n)
+                        {
+                            next[at] = (rgba[at] & 0xFF000000u) | (r / n) | (g / n) << 8 | (b / n) << 16;
+                            nextKnown[at] = 1;
+                            any = true;
+                        }
+                    }
+                rgba = next;
+                known.swap(nextKnown);
+                if (!any)
+                    break;
+            }
+        }
+
+        // A few queued textures per frame (about 6 ms), the GL context current.
+        void processLayerJobs(bool hq)
+        {
+            const int kind = hq ? 1 : 0;
+            if (g_layerChainKind != kind)
+            {
+                g_layerChain[0] = layerChain(hq);
+                g_layerChain[1] = layerChain(hq);
+                g_layerChainKind = kind;
+            }
+            if (!g_layerChain[0] || !g_layerChain[1])
+                return;
+            rlDrawRenderBatchActive();
+            const auto start = std::chrono::steady_clock::now();
+            ga2_layers::Job job;
+            while (std::chrono::steady_clock::now() - start < std::chrono::milliseconds(6) && ga2_layers::takeJob(job))
+            {
+                const int scale = ga2_layers::scale();
+                std::vector<uint32_t> rgb = job.rgba;
+                bleed(rgb, job.w, job.h);
+                ::Image source{rgb.data(), int(job.w), int(job.h), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                Texture2D input = LoadTextureFromImage(source);
+                int w = int(job.w), h = int(job.h);
+                uint32_t result = input.id;
+                for (int step = 0; step < (scale >= 4 ? 2 : 1) && result; ++step)
+                {
+                    int rw = 0, rh = 0;
+                    result = g_layerChain[step]->run(result, w, h, w * 2, h * 2, rw, rh);
+                    w = rw, h = rh;
+                }
+                std::vector<uint32_t> out;
+                if (result && w == int(job.w) * scale && h == int(job.h) * scale)
+                {
+                    std::vector<float> texels(size_t(w) * size_t(h) * 4u);
+                    glBindTexture(GL_TEXTURE_2D, result);
+                    glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_FLOAT, texels.data());
+                    glBindTexture(GL_TEXTURE_2D, 0);
+                    // The alpha channel scaled on its own (the network works on colour).
+                    ::Image alpha = ImageCopy(::Image{job.rgba.data(), int(job.w), int(job.h), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8});
+                    ImageResize(&alpha, w, h);
+                    const auto *a = static_cast<const uint32_t *>(alpha.data);
+                    out.resize(size_t(w) * size_t(h));
+                    for (size_t i = 0; i < out.size(); ++i)
+                    {
+                        auto c = [&](int k) { return uint32_t(std::lround(std::clamp(texels[i * 4 + size_t(k)], 0.0f, 1.0f) * 255.0f)); };
+                        out[i] = c(0) | c(1) << 8 | c(2) << 16 | (a[i] & 0xFF000000u);
+                    }
+                    UnloadImage(alpha);
+                }
+                UnloadTexture(input);
+                ga2_layers::finish(job.hash, uint32_t(w), uint32_t(h), std::move(out));
+            }
+            glViewport(0, 0, GetRenderWidth(), GetRenderHeight());
+        }
+
