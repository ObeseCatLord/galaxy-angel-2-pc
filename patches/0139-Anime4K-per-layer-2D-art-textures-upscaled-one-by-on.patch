+
+// Per-layer upscaling (the 2D filter Anime4K at 2x and 4x): every 2D art texture (CGs, backgrounds, character
+// sprites, UI art) the GS samples is upscaled on its own by the filter's network, so each layer keeps its own edges,
+// and the GS composes the upscaled layers. A texture is queued the first time it is seen in a 2D scene; the
+// presentation runs the network (GL, the main thread) a few textures a frame and hands the results back, cached on
+// disk (<cache>/anime4k/); until then the texture shows as it is.
+namespace ga2_layers
+{
+    // On, and the scale (2 or 4: the internal resolution). A change drops the GS's cached textures.
+    void setEnabled(bool on, int scale);
+    bool enabled();
+    int scale();
+    struct Job
+    {
+        uint64_t hash = 0;
+        uint32_t w = 0, h = 0;
+        std::vector<uint32_t> rgba; // RGBA, alpha 255 = opaque
+    };
+    bool takeJob(Job &job);
+    // The upscaled image of a job (RGBA, alpha 255 = opaque), or an empty one when it could not be made.
+    void finish(uint64_t hash, uint32_t w, uint32_t h, std::vector<uint32_t> rgba);
+}
 #endif
