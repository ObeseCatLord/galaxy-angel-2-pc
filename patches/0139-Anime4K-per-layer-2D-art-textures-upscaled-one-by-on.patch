-        if (g_ready && g_chain && !scene3d && sizesMatch)
+        if (g_ready && g_chain && !scene3d && sizesMatch && !ga2_layers::enabled())
         {
             rlDrawRenderBatchActive();
             // Above the game's size (2x / 4x): the network sees the picture at the game's size, and the detail
diff --git a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
index 0b7871d..d0b6675 100644
--- a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
@@ -8,6 +8,7 @@
 #include "gs_texpacks.h"
 #include "runtime/ga2_hitext.h"
 #include "runtime/ga2_text_icons.h"
+#include "runtime/ga2_activity.h"
 
 #include <atomic>
 
@@ -43,6 +44,9 @@ namespace ga2_text_icons
 #include <filesystem>
 #include <fstream>
 #include <iterator>
+#include <deque>
+#include <thread>
+#include <memory>
 #include <list>
 #include <map>
 #include <mutex>
@@ -54,6 +58,184 @@ using namespace Vulkan;
 using namespace ParallelGS;
 using namespace ga2_texregion;
 
+// ---- per-layer upscaling (gs_texpacks.h) ------------------------------------------------------------------------
+namespace ga2_layers
+{
+    namespace
+    {
+        std::atomic<bool> g_on{false};
+        std::atomic<int> g_scale{4};
+        std::atomic<bool> g_changedLayers{false};
+        std::mutex g_layerMutex;
+        std::deque<Job> g_jobs;
+        std::unordered_set<uint64_t> g_queued;    // queued or being made
+        std::unordered_set<uint64_t> g_failed;    // could not be made: shown as they are
+        struct Result
+        {
+            uint32_t w = 0, h = 0;
+            std::vector<uint32_t> rgba;
+        };
+        std::unordered_map<uint64_t, std::shared_ptr<const Result>> g_results; // the CPU copies (also on disk)
+        std::deque<uint64_t> g_resultOrder;
+        std::chrono::steady_clock::time_point g_lastDrop{};
+        bool g_dropPending = false;
+
+        std::filesystem::path cacheDir()
+        {
+            std::filesystem::path base;
+            if (const char *dir = std::getenv("GA2_CACHE_DIR"); dir && *dir)
+                base = dir;
+            else if (const char *xdg = std::getenv("XDG_CACHE_HOME"); xdg && *xdg)
+                base = std::filesystem::path(xdg) / "ga2";
+            else if (const char *local = std::getenv("LOCALAPPDATA"); local && *local)
+                base = std::filesystem::path(local) / "ga2" / "cache";
+            else if (const char *home = std::getenv("HOME"); home && *home)
+                base = std::filesystem::path(home) / ".cache" / "ga2";
+            else
+                return {};
+            return base / "anime4k";
+        }
+
+        std::filesystem::path cacheFile(uint64_t hash, int scale)
+        {
+            const std::filesystem::path dir = cacheDir();
+            if (dir.empty())
+                return {};
+            char name[48];
+            std::snprintf(name, sizeof(name), "%016llx_x%d.png", (unsigned long long)hash, scale);
+            return dir / name;
+        }
+
+        // g_layerMutex held: drop the GS's cached textures now and then while results come in (each drop makes it
+        // ask for every texture again), and once more when the queue is empty.
+        void dropSoon()
+        {
+            const auto now = std::chrono::steady_clock::now();
+            if (g_jobs.empty() || now - g_lastDrop > std::chrono::milliseconds(750))
+            {
+                g_changedLayers = true;
+                g_lastDrop = now;
+                g_dropPending = false;
+            }
+            else
+                g_dropPending = true;
+        }
+    }
+
+    void setEnabled(bool on, int scale)
+    {
+        scale = scale >= 4 ? 4 : 2;
+        if (g_on.exchange(on) != on || g_scale.exchange(scale) != scale)
+            g_changedLayers = true;
+    }
+    bool enabled() { return g_on.load(); }
+    int scale() { return g_scale.load(); }
+
+    bool takeJob(Job &job)
+    {
+        std::lock_guard<std::mutex> lock(g_layerMutex);
+        if (g_jobs.empty())
+        {
+            if (g_dropPending)
+                dropSoon();
+            return false;
+        }
+        job = std::move(g_jobs.front());
+        g_jobs.pop_front();
+        return true;
+    }
+
+    void finish(uint64_t hash, uint32_t w, uint32_t h, std::vector<uint32_t> rgba)
+    {
+        const int scale = g_scale.load();
+        std::lock_guard<std::mutex> lock(g_layerMutex);
+        g_queued.erase(hash);
+        if (rgba.empty() || rgba.size() != size_t(w) * h)
+        {
+            g_failed.insert(hash);
+            return;
+        }
+        auto result = std::make_shared<Result>();
+        result->w = w, result->h = h;
+        result->rgba = std::move(rgba);
+        g_results[hash] = result;
+        g_resultOrder.push_back(hash);
+        while (g_resultOrder.size() > 32)
+        {
+            g_results.erase(g_resultOrder.front());
+            g_resultOrder.pop_front();
+        }
+        // Kept on disk for the next session (written by a worker: PNG encoding takes a while).
+        const std::filesystem::path file = cacheFile(hash, scale);
+        if (!file.empty())
+            std::thread([result, file] {
+                std::error_code ec;
+                std::filesystem::create_directories(file.parent_path(), ec);
+                const std::filesystem::path partial = file.string() + ".part";
+                ::Image image{const_cast<uint32_t *>(result->rgba.data()), int(result->w), int(result->h), 1,
+                              PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                if (ExportImage(image, (partial.string() + ".png").c_str()))
+                    std::filesystem::rename(partial.string() + ".png", file, ec);
+            }).detach();
+        dropSoon();
+    }
+
+    bool takeChangedInternal() { return g_changedLayers.exchange(false); }
+
+    // GS thread (texture replacement): the upscaled image of a texture, or queue it (in a 2D scene). `pixels` makes
+    // the texture's RGBA (GS alpha, 0x80 = opaque) when needed.
+    template <class Pixels>
+    std::shared_ptr<const Result> lookup(uint64_t hash, uint32_t w, uint32_t h, const Pixels &pixels)
+    {
+        const int scale = g_scale.load();
+        {
+            std::lock_guard<std::mutex> lock(g_layerMutex);
+            if (const auto it = g_results.find(hash); it != g_results.end())
+                return it->second;
+            if (g_queued.count(hash) || g_failed.count(hash))
+                return nullptr;
+        }
+        // From an earlier session.
+        const std::filesystem::path file = cacheFile(hash, scale);
+        std::error_code ec;
+        if (!file.empty() && std::filesystem::exists(file, ec))
+        {
+            ::Image image = LoadImage(file.string().c_str());
+            if (image.data && image.width == int(w) * scale && image.height == int(h) * scale)
+            {
+                ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                auto result = std::make_shared<Result>();
+                result->w = uint32_t(image.width), result->h = uint32_t(image.height);
+                const auto *texels = static_cast<const uint32_t *>(image.data);
+                result->rgba.assign(texels, texels + size_t(image.width) * size_t(image.height));
+                UnloadImage(image);
+                std::lock_guard<std::mutex> lock(g_layerMutex);
+                g_results[hash] = result;
+                g_resultOrder.push_back(hash);
+                while (g_resultOrder.size() > 32)
+                {
+                    g_results.erase(g_resultOrder.front());
+                    g_resultOrder.pop_front();
+                }
+                return result;
+            }
+            if (image.data)
+                UnloadImage(image);
+        }
+        if (ga2_activity::scene3d())
+            return nullptr; // 3D scenes' textures are not 2D art
+        Job job;
+        job.hash = hash, job.w = w, job.h = h;
+        job.rgba = pixels();
+        for (uint32_t &c : job.rgba)
+            c = (c & 0x00FFFFFFu) | (std::min<uint32_t>(255u, (c >> 24) * 2u) << 24);
+        std::lock_guard<std::mutex> lock(g_layerMutex);
+        if (g_queued.insert(hash).second && g_jobs.size() < 4096)
+            g_jobs.push_back(std::move(job));
+        return nullptr;
+    }
+}
+
