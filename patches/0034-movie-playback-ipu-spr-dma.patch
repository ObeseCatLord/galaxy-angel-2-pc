+// Scratchpad DMA interleave (mode 2) and chain (mode 1) transfers. libmpeg's
+// motion compensation fetches reference blocks with interleave transfers;
+// dropping them left predicted macroblocks empty.
+bool PS2Memory::processScratchpadDmaModes(uint32_t channelBase, uint32_t chcr, uint32_t mode)
+{
+    static constexpr uint32_t kSprFromChannel = 0x1000D000u;
+    const bool fromScratchpad = channelBase == kSprFromChannel;
+    uint32_t &madr = m_ioRegisters[channelBase + 0x10u];
+    uint32_t &qwcReg = m_ioRegisters[channelBase + 0x20u];
+    uint32_t &sadr = m_ioRegisters[channelBase + 0x80u];
+    static const bool trace = std::getenv("GA2_IPU_TRACE") != nullptr;
+    static int traced = 0;
+    if (trace && traced < 200)
+    {
+        ++traced;
+        std::fprintf(stderr, "[spr dma] ch=%s mode=%u chcr=%08x qwc=%u madr=%08x sadr=%04x tadr=%08x sqwc=%08x\n",
+                     fromScratchpad ? "from" : "to", mode, chcr, qwcReg & 0xFFFFu, madr, sadr,
+                     m_ioRegisters[channelBase + 0x30u], m_ioRegisters[0x1000E030u]);
+    }
+
+    auto copyQwords = [&](uint32_t mainAddress, uint32_t qwords) -> bool
+    {
+        for (uint32_t i = 0; i < qwords; ++i)
+        {
+            uint32_t mainOffset = 0u;
+            try
+            {
+                mainOffset = translateAddress((mainAddress + i * 16u) & 0x7FFFFFF0u);
+            }
+            catch (const std::exception &)
+            {
+                return false;
+            }
+            if (mainOffset + 16u > PS2_RAM_SIZE)
+                return false;
+            const uint32_t sprOffset = sadr & (PS2_SCRATCHPAD_SIZE - 16u);
+            if (fromScratchpad)
+            {
+                std::memcpy(m_rdram + mainOffset, m_scratchpad + sprOffset, 16);
+                markModified(mainOffset, 16u);
+            }
+            else
+                std::memcpy(m_scratchpad + sprOffset, m_rdram + mainOffset, 16);
+            sadr = (sadr + 16u) & 0x3FF0u;
+        }
+        return true;
+    };
+
+    if (mode == 2u)
+    {
+        // D_SQWC: SQWC (qwords skipped in main memory) [7:0], TQWC (qwords transferred) [23:16].
+        const uint32_t sqwc = m_ioRegisters[0x1000E030u] & 0xFFu;
+        const uint32_t tqwc = (m_ioRegisters[0x1000E030u] >> 16u) & 0xFFu;
+        uint32_t remaining = qwcReg & 0xFFFFu;
+        if (tqwc == 0u)
+            return false;
+        while (remaining != 0u)
+        {
+            const uint32_t run = std::min(tqwc, remaining);
+            if (!copyQwords(madr, run))
+                return false;
+            madr = (madr + run * 16u) & 0x7FFFFFF0u;
+            remaining -= run;
+            if (run == tqwc)
+                madr = (madr + sqwc * 16u) & 0x7FFFFFF0u;
+        }
+        qwcReg = 0u;
+        completeDmacChannel(channelBase, fromScratchpad ? 8u : 9u);
+        return true;
+    }
+
+    if (mode == 1u)
+    {
+        for (int guard = 0; guard < 65536; ++guard)
+        {
+            if ((qwcReg & 0xFFFFu) != 0u)
+            {
+                const uint32_t qwc = qwcReg & 0xFFFFu;
+                if (!copyQwords(madr, qwc))
+                    return false;
+                madr = (madr + qwc * 16u) & 0x7FFFFFF0u;
+                qwcReg = 0u;
+            }
+            uint64_t tag = 0u;
+            if (fromScratchpad)
+            {
+                // Destination chain: the tag precedes the data in the scratchpad.
+                std::memcpy(&tag, m_scratchpad + (sadr & (PS2_SCRATCHPAD_SIZE - 16u)), sizeof(tag));
+                sadr = (sadr + 16u) & 0x3FF0u;
+            }
+            else
+            {
+                const uint32_t tadr = m_ioRegisters[channelBase + 0x30u];
+                uint32_t tagOffset = 0u;
+                try
+                {
+                    tagOffset = translateAddress(tadr & 0x7FFFFFF0u);
+                }
+                catch (const std::exception &)
+                {
+                    return false;
+                }
+                if (tagOffset + 16u > PS2_RAM_SIZE)
+                    return false;
+                std::memcpy(&tag, m_rdram + tagOffset, sizeof(tag));
+            }
+            const uint32_t qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            const uint32_t id = static_cast<uint32_t>((tag >> 28u) & 7u);
+            const uint32_t address = static_cast<uint32_t>(tag >> 32u) & 0x7FFFFFF0u;
+            const bool irq = ((tag >> 31u) & 1u) != 0u && (chcr & 0x80u) != 0u;
+            m_ioRegisters[channelBase] = (m_ioRegisters[channelBase] & 0xFFFFu) | (static_cast<uint32_t>(tag >> 16u) & 0xFFFF0000u);
+            bool end = irq;
+            if (fromScratchpad)
+            {
+                // cnts/cnt (0) and end (7) both write at ADDR.
+                madr = address;
+                end = end || id == 7u;
+            }
+            else
+            {
+                const uint32_t tadr = m_ioRegisters[channelBase + 0x30u];
+                switch (id)
+                {
+                case 0u: madr = address; end = true; m_ioRegisters[channelBase + 0x30u] = tadr + 16u; break; // REFE
+                case 1u: madr = tadr + 16u; m_ioRegisters[channelBase + 0x30u] = tadr + 16u + qwc * 16u; break; // CNT
+                case 2u: madr = tadr + 16u; m_ioRegisters[channelBase + 0x30u] = address; break; // NEXT
+                case 3u: case 4u: madr = address; m_ioRegisters[channelBase + 0x30u] = tadr + 16u; break; // REF/REFS
+                case 7u: madr = tadr + 16u; end = true; break; // END
+                default: return false; // CALL/RET are not valid for scratchpad DMA
+                }
+            }
+            if (qwc != 0u)
+            {
+                if (!copyQwords(madr, qwc))
+                    return false;
+                madr = (madr + qwc * 16u) & 0x7FFFFFF0u;
+            }
+            if (end)
+                break;
+        }
+        qwcReg = 0u;
+        completeDmacChannel(channelBase, fromScratchpad ? 8u : 9u);
+        return true;
+    }
+    return false;
+}
