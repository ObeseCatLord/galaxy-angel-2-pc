+
+    bool storyOverlayUp()
+    {
+        if (!g_ram)
+            return false;
+        // System menu: one red row (the cursor) and three blue ones, at the same rows the pointer menus use.
+        {
+            const VisualMenu &menu = visualMenus().front();
+            int red = 0, blue = 0;
+            for (const Item &it : menu.items)
+            {
+                const int y = static_cast<int>((it.y0 + it.y1) * 0.5f);
+                int r = 0, g = 0, b = 0, n = 0;
+                for (int x = static_cast<int>(it.x0) + 15; x < static_cast<int>(it.x1) - 8; x += 6, ++n)
+                {
+                    uint8_t rgb[3];
+                    if (!ps2_mouse::pixel(x, y, rgb))
+                        return false;
+                    r += rgb[0];
+                    g += rgb[1];
+                    b += rgb[2];
+                }
+                if (n == 0)
+                    return false;
+                r /= n;
+                g /= n;
+                b /= n;
+                if (r > b + 30 && r > g + 25 && g < 110 && b < 120)
+                    ++red;
+                else if (b > r + 30)
+                    ++blue;
+            }
+            if (red == 1 && blue == static_cast<int>(menu.items.size()) - 1)
+                return true;
+        }
+        // Backlog: a black caption corner and a dark green scroll track down the right side.
+        {
+            uint8_t rgb[3];
+            if (ps2_mouse::pixel(40, 27, rgb) && rgb[0] < 16 && rgb[1] < 16 && rgb[2] < 16)
+            {
+                int track = 0;
+                for (int y : {120, 300, 380})
+                    if (ps2_mouse::pixel(548, y, rgb) && rgb[0] < 24 && rgb[1] >= 50 && rgb[1] <= 90 && rgb[2] >= 36 && rgb[2] <= 70)
+                        ++track;
+                if (track >= 2)
+                    return true;
+            }
+        }
+        return false;
+    }
 }
