diff --git a/ps2xRuntime/include/runtime/ga2_framepace.h b/ps2xRuntime/include/runtime/ga2_framepace.h
index 982351f..b489c71 100644
--- a/ps2xRuntime/include/runtime/ga2_framepace.h
+++ b/ps2xRuntime/include/runtime/ga2_framepace.h
@@ -89,6 +89,27 @@ namespace ga2_framepace
     };
     void setScriptedPad(uint16_t held);
     uint16_t scriptedPad();
+
+    // Message skipping: holding Ctrl presses Circle (the confirm button that advances a message) every other pad frame,
+    // 30 a second at the native rate (the games take presses as edges), but only while that is the right thing: a
+    // story script is on (the ADV scene updates in the adventure scene) and nothing that must not be confirmed is up
+    // (a choice or menu, the ship map). The pad side holds the button; the game side says what is up.
+    //   setSkipHeld     main thread (ps2_pad.cpp): Ctrl is down; never in scripted pad runs or with the cheat menu open.
+    //   setSkipScreenBlocked / skipDisarm  main thread: a menu is on the picture / the player pressed another button
+    //                   (the system menu, the backlog, Auto, Cross, Start ...): skipping stops until Ctrl is released.
+    //   skipSeenMessage game thread (native/compat/ga2_skip.cpp), at each update of the story scene.
+    //   skipSeenBlock   game thread, at each call of the choice / menu builtin and each update of the ship map.
+    //   skipAdvance     game thread, once per pad frame (port 0 read): decides from the calls since the last frame;
+    //                   a state seen within the last three pad frames counts as current.
+    //   skipNow         the decision of the current frame: PSPadBackend::readState presses Circle.
+    void setSkipHeld(bool held);
+    bool skipHeld();
+    void setSkipScreenBlocked(bool blocked);
+    void skipDisarm();
+    void skipSeenMessage();
+    void skipSeenBlock();
+    void skipAdvance();
+    bool skipNow();
 }
 
 // The oracle: one line per game loop iteration plus events, stamped with the
diff --git a/ps2xRuntime/src/lib/ga2_framepace.cpp b/ps2xRuntime/src/lib/ga2_framepace.cpp
index 30ad141..7aa3d37 100644
--- a/ps2xRuntime/src/lib/ga2_framepace.cpp
+++ b/ps2xRuntime/src/lib/ga2_framepace.cpp
@@ -183,8 +183,50 @@ namespace ga2_framepace
     namespace
     {
         std::atomic<uint16_t> g_scriptedPad{0};
+        std::atomic<bool> g_skipHeld{false};
     }
     void setScriptedPad(uint16_t held) { g_scriptedPad.store(held, std::memory_order_relaxed); }
+    namespace
+    {
+        std::atomic<bool> g_skipDisarmed{false}, g_skipScreenBlocked{false};
+    }
+    void setSkipHeld(bool held)
+    {
+        g_skipHeld.store(held, std::memory_order_relaxed);
+        if (!held)
+            g_skipDisarmed.store(false, std::memory_order_relaxed); // Ctrl released: armed again at the next press
+    }
+    void setSkipScreenBlocked(bool blocked) { g_skipScreenBlocked.store(blocked, std::memory_order_relaxed); }
+    void skipDisarm() { g_skipDisarmed.store(true, std::memory_order_relaxed); }
+    bool skipHeld() { return g_skipHeld.load(std::memory_order_relaxed); }
+
+    namespace
+    {
+        // Pad frames (port 0 reads) and the frame each state was last seen at.
+        std::atomic<uint64_t> g_skipFrame{1000};
+        std::atomic<uint64_t> g_skipMessageAt{0}, g_skipBlockAt{0};
+        std::atomic<bool> g_skipNow{false};
+        constexpr uint64_t kSkipFresh = 3;
+    }
+    void skipSeenMessage() { g_skipMessageAt.store(g_skipFrame.load(std::memory_order_relaxed), std::memory_order_relaxed); }
+    void skipSeenBlock() { g_skipBlockAt.store(g_skipFrame.load(std::memory_order_relaxed), std::memory_order_relaxed); }
+    void skipAdvance()
+    {
+        const uint64_t frame = g_skipFrame.fetch_add(1, std::memory_order_relaxed) + 1;
+        const bool message = frame - g_skipMessageAt.load(std::memory_order_relaxed) <= kSkipFresh;
+        const bool block = frame - g_skipBlockAt.load(std::memory_order_relaxed) <= kSkipFresh;
+        const bool ready = skipHeld() && message && !block && !g_skipDisarmed.load(std::memory_order_relaxed) &&
+                           !g_skipScreenBlocked.load(std::memory_order_relaxed);
+        // Circle every other pad frame: a press, a release (the games take presses as edges: 30 a second at the native rate).
+        const bool now = ready && (frame & 1u) == 0;
+        static const bool trace = std::getenv("GA2_SKIP_TRACE") != nullptr;
+        if (trace && now != g_skipNow.load(std::memory_order_relaxed))
+            std::fprintf(stderr, "[skip] %lld ms pad frame %llu: Circle %s (ctrl %d, message %d, blocked %d)\n",
+                         (long long)(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count() % 1000000), (unsigned long long)frame,
+                         now ? "pressed" : "released", skipHeld() ? 1 : 0, message ? 1 : 0, block ? 1 : 0);
+        g_skipNow.store(now, std::memory_order_relaxed);
+    }
+    bool skipNow() { return g_skipNow.load(std::memory_order_relaxed); }
     uint16_t scriptedPad() { return g_scriptedPad.load(std::memory_order_relaxed); }
 
     namespace
