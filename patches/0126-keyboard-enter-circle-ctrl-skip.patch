diff --git a/ps2xTest/src/pad_keymap_tests.cpp b/ps2xTest/src/pad_keymap_tests.cpp
new file mode 100644
index 0000000..97fc0ad
--- /dev/null
+++ b/ps2xTest/src/pad_keymap_tests.cpp
@@ -0,0 +1,151 @@
+#include "MiniTest.h"
+
+#include "ps2_pad_keys.h"
+#include "runtime/ga2_framepace.h"
+
+#include <set>
+
+namespace
+{
+    using ps2_pad_keys::held;
+
+    // A fake keyboard: the keys held now, and the ones that went down this frame.
+    struct Keyboard
+    {
+        std::set<int> down, pressed;
+        ps2_pad_keys::State state;
+        uint16_t read() { return held(state, [&](int k) { return down.count(k) != 0; }, [&](int k) { return pressed.count(k) != 0; }); }
+        uint16_t only(std::initializer_list<int> keys)
+        {
+            down.clear();
+            pressed.clear();
+            state = {};
+            down.insert(keys);
+            pressed.insert(keys);
+            return read();
+        }
+    };
+}
+
+void register_pad_keymap_tests()
+{
+    MiniTest::Case("PadKeymap", [](TestCase &tc) {
+        tc.Run("Enter, keypad Enter, C and Esc are Circle (the confirm button)", [](TestCase &t) {
+            Keyboard kb;
+            for (int key : {KEY_ENTER, KEY_KP_ENTER, KEY_C, KEY_ESCAPE})
+                t.Equals(unsigned(kb.only({key})), unsigned(ps2_pad_keys::Circle), "key is exactly Circle");
+        });
+
+        tc.Run("Start is P and no longer Enter", [](TestCase &t) {
+            Keyboard kb;
+            t.Equals(unsigned(kb.only({KEY_P})), unsigned(ps2_pad_keys::Start), "P is Start");
+            t.IsTrue((kb.only({KEY_ENTER}) & ps2_pad_keys::Start) == 0, "Enter is not Start");
+        });
+
+        tc.Run("Alt+Enter (fullscreen) is not Circle, in either order", [](TestCase &t) {
+            Keyboard kb;
