diff --git a/ps2xRuntime/src/lib/ps2_pad_keys.h b/ps2xRuntime/src/lib/ps2_pad_keys.h
new file mode 100644
index 0000000..1d6a256
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_pad_keys.h
@@ -0,0 +1,88 @@
+#pragma once
+
+// The keyboard's pad map (docs/PLAYING.md, native/buttons/keyboard/*.png: the
+// prompt icons show these keys). Header only so the tests can drive it with a
+// fake keyboard.
+//
+//   D-pad      arrows, WASD (the left stick follows, see ps2_pad.cpp)
+//   Circle     Enter, keypad Enter, C, Esc     (Alt+Enter is fullscreen, not Circle)
+//   Cross      X, Space
+//   Square     Z, keypad 0
+//   Triangle   V, keypad 1
+//   L1 / R1    Q / E
+//   L2 / R2    Left Shift / Right Shift
+//   Start      P
+//   Select     Tab
+//   L3 / R3    R / F
+//   Ctrl (held) skips messages: skipHeld() below, used by ps2_pad.cpp
+#include <cstdint>
+#include <initializer_list>
+
+#include "ps2_host_backend.h"
+
+namespace ps2_pad_keys
+{
+    // The PS2 pad's bit values (a pressed button is a 0 bit in the pad data).
+    enum Bit : uint16_t
+    {
+        Select = 0x0001u, L3 = 0x0002u, R3 = 0x0004u, Start = 0x0008u,
+        Up = 0x0010u, Right = 0x0020u, Down = 0x0040u, Left = 0x0080u,
+        L2 = 0x0100u, R2 = 0x0200u, L1 = 0x0400u, R1 = 0x0800u,
+        Triangle = 0x1000u, Circle = 0x2000u, Cross = 0x4000u, Square = 0x8000u,
+    };
+
+    // Memory between samples: an Enter that went down with Alt held is the
+    // fullscreen shortcut for as long as it stays down, even if Alt is released
+    // first (it must not turn into Circle half way through the keystroke).
+    struct State
+    {
+        bool enterIsShortcut = false;
+    };
+
+    // The buttons the keyboard holds now (active-high). `down(key)` is "the key
+    // is held", `pressed(key)` "went down this frame" (raylib's IsKeyDown /
+    // IsKeyPressed).
+    template <class DownFn, class PressedFn>
+    uint16_t held(State &state, DownFn &&down, PressedFn &&pressed)
+    {
+        uint16_t out = 0;
+        auto any = [&](std::initializer_list<int> keys) {
+            for (int key : keys)
+                if (down(key))
+                    return true;
+            return false;
+        };
+        const bool alt = down(KEY_LEFT_ALT) || down(KEY_RIGHT_ALT);
+        if (!down(KEY_ENTER))
+            state.enterIsShortcut = false;
+        else if (alt && pressed(KEY_ENTER))
+            state.enterIsShortcut = true;
+
+        if (any({KEY_UP, KEY_W})) out |= Up;
+        if (any({KEY_DOWN, KEY_S})) out |= Down;
+        if (any({KEY_LEFT, KEY_A})) out |= Left;
+        if (any({KEY_RIGHT, KEY_D})) out |= Right;
+        if (any({KEY_X, KEY_SPACE})) out |= Cross;
+        if (any({KEY_C, KEY_ESCAPE, KEY_KP_ENTER}) || (down(KEY_ENTER) && !alt && !state.enterIsShortcut))
+            out |= Circle;
+        if (any({KEY_Z, KEY_KP_0})) out |= Square;
+        if (any({KEY_V, KEY_KP_1})) out |= Triangle;
+        if (down(KEY_Q)) out |= L1;
+        if (down(KEY_E)) out |= R1;
+        if (down(KEY_LEFT_SHIFT)) out |= L2;
+        if (down(KEY_RIGHT_SHIFT)) out |= R2;
+        if (down(KEY_P)) out |= Start;
+        if (down(KEY_TAB)) out |= Select;
+        // Stick clicks (battles: pilot view / map with L3, unit camera with R3).
+        if (down(KEY_R)) out |= L3;
+        if (down(KEY_F)) out |= R3;
+        return out;
+    }
+
+    // Ctrl (either side) held: skip messages.
+    template <class DownFn>
+    bool skipHeld(DownFn &&down)
+    {
+        return down(KEY_LEFT_CONTROL) || down(KEY_RIGHT_CONTROL);
+    }
+}
