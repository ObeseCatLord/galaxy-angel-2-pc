+            t.Equals(unsigned(kb.only({KEY_RIGHT_ALT, KEY_ENTER})), 0u, "right Alt too");
+            // Alt is released first while Enter is still down: still the shortcut, not Circle.
+            kb.only({KEY_LEFT_ALT, KEY_ENTER});
+            kb.down.erase(KEY_LEFT_ALT);
+            kb.pressed.clear();
+            t.Equals(unsigned(kb.read()), 0u, "Alt released, Enter still down: nothing");
+            // Released and pressed again: Circle.
+            kb.down.erase(KEY_ENTER);
+            kb.read();
+            kb.down.insert(KEY_ENTER);
+            kb.pressed.insert(KEY_ENTER);
+            t.Equals(unsigned(kb.read()), unsigned(ps2_pad_keys::Circle), "a fresh Enter is Circle again");
