+// Pure helpers of the texture-pack hook (gs_texpacks.cpp), kept in a header
+// without Vulkan or raylib so the tests can drive them: decoding a texture
+// region from GS memory, the region hash that names textures in dumps, packs
+// and the button map, and a digest of the GS pages a decode reads.
+#pragma once
+
+#include "runtime/gs/ps2_gs_memory.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace ga2_texregion
+{
+
+    inline uint32_t expand16(uint32_t c)
+    {
+        const uint32_t r = (c & 31u) << 3, g = ((c >> 5) & 31u) << 3, b = ((c >> 10) & 31u) << 3;
+        const uint32_t a = (c & 0x8000u) ? 0x80u : 0u;
+        return r | (g << 8) | (b << 16) | (a << 24);
+    }
+
+    inline bool isPaletted(uint32_t psm)
+    {
+        return psm == 0x13u || psm == 0x1Bu || psm == 0x14u || psm == 0x24u || psm == 0x2Cu;
+    }
+
+    inline bool supportedPsm(uint32_t psm)
+    {
+        switch (psm)
+        {
+        case 0x00u: case 0x01u: case 0x02u: case 0x0Au:
+        case 0x13u: case 0x1Bu: case 0x14u: case 0x24u: case 0x2Cu:
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    // The region the replacement hook is asked about, clipped to the
+    // texture; false outside it or for formats not handled here.
+    inline bool clampRegion(uint64_t tex0, uint32_t rx, uint32_t ry, uint32_t &w, uint32_t &h)
+    {
+        const uint32_t psm = uint32_t((tex0 >> 20) & 0x3Fu);
+        const uint32_t tw = 1u << std::min<uint32_t>(10u, uint32_t((tex0 >> 26) & 0xFu));
+        const uint32_t th = 1u << std::min<uint32_t>(10u, uint32_t((tex0 >> 30) & 0xFu));
+        if (rx >= tw || ry >= th || !supportedPsm(psm))
+            return false;
+        w = std::min(w, tw - rx);
+        h = std::min(h, th - ry);
+        return true;
+    }
+
+    template <class Read>
+    inline void fillRegion(std::vector<uint32_t> &out, uint32_t rx, uint32_t ry, uint32_t w, uint32_t h, Read read)
+    {
+        uint32_t *dst = out.data();
+        for (uint32_t oy = 0; oy < h; ++oy)
+            for (uint32_t ox = 0; ox < w; ++ox)
+                *dst++ = read(rx + ox, ry + oy);
+    }
+
+    // The (clamped, supported) region as RGBA (PS2 alpha, 0x80 = opaque).
+    inline void decodePixels(const uint8_t *gsVram, uint64_t tex0, uint32_t rx, uint32_t ry, uint32_t w, uint32_t h, const uint32_t *palette,
+                      std::vector<uint32_t> &out)
+    {
+        uint8_t *vram = const_cast<uint8_t *>(gsVram);
+        const uint32_t tbp = uint32_t(tex0 & 0x3FFFu), tbw = uint32_t((tex0 >> 14) & 0x3Fu);
+        const uint32_t psm = uint32_t((tex0 >> 20) & 0x3Fu);
+        out.resize(size_t(w) * h);
+        switch (psm)
+        {
+        case 0x00u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return GSMem::ReadCT32(vram, tbp, tbw, x, y); }); break;
+        case 0x01u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return GSMem::ReadCT24(vram, tbp, tbw, x, y) | 0x80000000u; }); break;
+        case 0x02u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return expand16(GSMem::ReadCT16(vram, tbp, tbw, x, y)); }); break;
+        case 0x0Au: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return expand16(GSMem::ReadCT16S(vram, tbp, tbw, x, y)); }); break;
+        case 0x13u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return palette[GSMem::ReadP8(vram, tbp, tbw, x, y) & 255u]; }); break;
+        case 0x1Bu: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return palette[GSMem::ReadP8H(vram, tbp, tbw, x, y) & 255u]; }); break;
+        case 0x14u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return palette[GSMem::ReadP4(vram, tbp, tbw, x, y) & 15u]; }); break;
+        case 0x24u: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return palette[GSMem::ReadP4HL(vram, tbp, tbw, x, y) & 15u]; }); break;
+        case 0x2Cu: fillRegion(out, rx, ry, w, h, [&](uint32_t x, uint32_t y) { return palette[GSMem::ReadP4HH(vram, tbp, tbw, x, y) & 15u]; }); break;
+        default: break; // clampRegion refused these
+        }
+    }
+
+    struct Digest
+    {
+        uint64_t a = 0x243F6A8885A308D3ull, b = 0x13198A2E03707344ull, c = 0xA4093822299F31D0ull, d = 0x082EFA98EC4E6C89ull;
+    };
+
+    inline void digestWords(Digest &s, const uint8_t *p, size_t bytes)
+    {
+        // bytes is a multiple of 32; four independent lanes keep the
+        // multiplies pipelined.
+        uint64_t a = s.a, b = s.b, c = s.c, d = s.d;
+        for (const uint8_t *end = p + bytes; p != end; p += 32)
+        {
+            uint64_t w0, w1, w2, w3;
+            std::memcpy(&w0, p, 8);
+            std::memcpy(&w1, p + 8, 8);
+            std::memcpy(&w2, p + 16, 8);
+            std::memcpy(&w3, p + 24, 8);
+            a = (a ^ w0) * 0x9E3779B97F4A7C15ull;
+            b = (b ^ w1) * 0xC2B2AE3D27D4EB4Full;
+            c = (c ^ w2) * 0x165667B19E3779F9ull;
+            d = (d ^ w3) * 0xD6E8FEB86659FD93ull;
+            a ^= a >> 32;
+            b ^= b >> 32;
+            c ^= c >> 32;
+            d ^= d >> 32;
+        }
+        s.a = a; s.b = b; s.c = c; s.d = d;
+    }
+
+    // Page extent in pixels of the GS storage mode (the swizzle's unit).
+    inline void pageExtent(uint32_t psm, uint32_t &pw, uint32_t &ph)
+    {
+        switch (psm)
+        {
+        case 0x02u: case 0x0Au: pw = 64; ph = 64; break;
+        case 0x13u: pw = 128; ph = 64; break;
+        case 0x14u: pw = 128; ph = 128; break;
+        default: pw = 64; ph = 32; break; // 32/24-bit and the high-nibble modes
+        }
+    }
+
+    // Digest of the GS pages a decode of this region can read: those the
+    // region's pixels fall in (GSMem::PixelStorageTraits::PageId) and the
+    // page after each, where the block offset of a texture that does not
+    // start on a page boundary spills over.
+    inline void digestRegion(const uint8_t *vram, uint64_t tex0, uint32_t rx, uint32_t ry, uint32_t w, uint32_t h, Digest &digest)
+    {
+        constexpr uint32_t kPageBytes = 8192, kPages = 4u * 1024u * 1024u / kPageBytes; // 512
+        const uint32_t tbp = uint32_t(tex0 & 0x3FFFu), tbw = uint32_t((tex0 >> 14) & 0x3Fu);
+        const uint32_t psm = uint32_t((tex0 >> 20) & 0x3Fu);
+        uint32_t pw, ph;
+        pageExtent(psm, pw, ph);
+        const uint32_t basePage = tbp / 32u, perRow = (tbw * 64u) / pw;
+        const uint32_t spill = (tbp % 32u) ? 1u : 0u;
+        const uint32_t row0 = ry / ph, row1 = (ry + h - 1u) / ph, col0 = rx / pw, col1 = (rx + w - 1u) / pw;
+        for (uint32_t row = row0; row <= row1; ++row)
+            for (uint32_t page = basePage + row * perRow + col0, last = basePage + row * perRow + col1 + spill; page <= last;
+                 ++page)
+                digestWords(digest, vram + size_t(page % kPages) * kPageBytes, kPageBytes);
+    }
+
+    inline uint64_t hashPixels(const std::vector<uint32_t> &px, uint32_t w, uint32_t h)
+    {
+        uint64_t hash = 0x9E3779B97F4A7C15ull ^ (uint64_t(w) << 32 | h);
+        for (uint32_t v : px)
+        {
+            hash ^= v;
+            hash *= 0x100000001B3ull;
+            hash ^= hash >> 29;
+        }
+        return hash;
+    }
+
+}
