new file mode 100644
index 0000000..5db3481
--- /dev/null
+++ b/ps2xTest/src/ps2_texregion_tests.cpp
@@ -0,0 +1,109 @@
+#include "MiniTest.h"
+#include "gs/gs_texregion.h"
+#include "runtime/gs/ps2_gs_memory.h"
+
+#include <cstdint>
+#include <vector>
+
+namespace
+{
+    struct Rng
+    {
+        uint64_t s;
+        uint32_t next()
+        {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            return uint32_t(s >> 16);
+        }
+    };
+
+    uint64_t makeTex0(uint32_t tbp, uint32_t tbw, uint32_t psm, uint32_t tw, uint32_t th)
+    {
+        return uint64_t(tbp) | uint64_t(tbw) << 14 | uint64_t(psm) << 20 | uint64_t(tw) << 26 | uint64_t(th) << 30;
+    }
+}
+
+void register_ps2_texregion_tests()
+{
+    MiniTest::Case("TexRegion", [](TestCase &tc)
+    {
+        tc.Run("the region digest covers every GS page a decode reads", [](TestCase &t)
+        {
+            GSMem::InitLookupTables();
+            constexpr size_t kVram = 4u * 1024u * 1024u, kPage = 8192u;
+            const uint32_t psms[] = {0x00u, 0x01u, 0x02u, 0x0Au, 0x13u, 0x1Bu, 0x14u, 0x24u, 0x2Cu};
+            Rng rng{0x9E3779B97F4A7C15ull};
+            std::vector<uint8_t> vram(kVram);
+            uint32_t palette[256];
+            uint32_t uncovered = 0, trials = 0, readPages = 0;
+            for (uint32_t psm : psms)
+                for (int trial = 0; trial < 8; ++trial)
+                {
+                    for (size_t i = 0; i < kVram; i += 4)
+                    {
+                        const uint32_t v = rng.next() ^ rng.next() << 16;
+                        std::memcpy(&vram[i], &v, 4);
+                    }
+                    for (uint32_t &c : palette)
+                        c = rng.next() ^ rng.next() << 16;
+                    // Mix aligned and unaligned bases, narrow and wide buffers,
+                    // and bases near the end of GS memory (the wrap).
+                    uint32_t tbp = rng.next() % 16384u;
+                    if (trial % 3 == 0)
+                        tbp &= ~31u;
+                    if (trial % 7 == 6)
+                        tbp = 16384u - 1u - rng.next() % 96u;
+                    const uint32_t tbw = 1u + rng.next() % 10u;
+                    const uint32_t twLog = 3u + rng.next() % 5u, thLog = 3u + rng.next() % 5u; // 8..128 px
+                    uint64_t tex0 = makeTex0(tbp, tbw, psm, twLog, thLog);
+                    const uint32_t tw = 1u << twLog, th = 1u << thLog;
+                    uint32_t rx = rng.next() % tw, ry = rng.next() % th;
+                    uint32_t w = 1u + rng.next() % 100u, h = 1u + rng.next() % 100u;
+                    t.IsTrue(ga2_texregion::clampRegion(tex0, rx, ry, w, h), "region inside the texture");
+
+                    std::vector<uint32_t> base, changed;
+                    ga2_texregion::decodePixels(vram.data(), tex0, rx, ry, w, h, palette, base);
+                    ga2_texregion::Digest d0;
+                    ga2_texregion::digestRegion(vram.data(), tex0, rx, ry, w, h, d0);
+                    for (size_t page = 0; page < kVram / kPage; ++page)
+                    {
+                        uint8_t *p = vram.data() + page * kPage;
+                        for (size_t i = 0; i < kPage; ++i)
+                            p[i] ^= 0xFFu;
+                        ga2_texregion::decodePixels(vram.data(), tex0, rx, ry, w, h, palette, changed);
+                        ga2_texregion::Digest d1;
+                        ga2_texregion::digestRegion(vram.data(), tex0, rx, ry, w, h, d1);
+                        const bool decodeChanged = changed != base;
+                        const bool digestChanged = d0.a != d1.a || d0.b != d1.b || d0.c != d1.c || d0.d != d1.d;
+                        if (decodeChanged)
+                        {
+                            ++readPages;
+                            if (!digestChanged)
+                                ++uncovered;
+                        }
+                        for (size_t i = 0; i < kPage; ++i)
+                            p[i] ^= 0xFFu;
+                    }
+                    ++trials;
+                }
+            t.IsTrue(trials >= 72 && readPages > 100, "the sweep read pages");
+            t.Equals(uncovered, 0u, "pages the decode reads but the digest misses");
+        });
+
+        tc.Run("the region digest is stable for equal contents and differs for changed ones", [](TestCase &t)
+        {
+            GSMem::InitLookupTables();
+            std::vector<uint8_t> vram(4u * 1024u * 1024u, 0x5Au);
+            const uint64_t tex0 = makeTex0(96, 10, 0x13u, 10, 9);
+            ga2_texregion::Digest a, b, c;
+            ga2_texregion::digestRegion(vram.data(), tex0, 0, 0, 640, 480, a);
+            ga2_texregion::digestRegion(vram.data(), tex0, 0, 0, 640, 480, b);
+            t.IsTrue(a.a == b.a && a.b == b.b && a.c == b.c && a.d == b.d, "equal contents, equal digest");
+            vram[96u * 256u + 1000u] ^= 1u;
+            ga2_texregion::digestRegion(vram.data(), tex0, 0, 0, 640, 480, c);
+            t.IsTrue(a.a != c.a || a.b != c.b || a.c != c.c || a.d != c.d, "a changed byte changes the digest");
+        });
+    });
+}
