+        memory.write32(stack + 16u, 0u);
+        const auto invoke = [&](uint32_t rd, uint32_t src, uint32_t dst, uint32_t size, uint32_t sp)
+        {
+            IopCpuState cpu{};
+            cpu.gpr[4] = rd; cpu.gpr[5] = src; cpu.gpr[6] = dst; cpu.gpr[7] = size; cpu.gpr[29] = sp;
+            if (!rpc.dispatchSifCmdImport(23u, cpu)) return int32_t(12345);
+            return int32_t(cpu.gpr[2]);
+        };
+        // EE and IOP have separate address spaces. Cached aliases must still
+        // reach the host translator; the receive copies real bytes, not zeros.
+        if (!expect(invoke(receive, ReceiveHost::Base + 4u, destination, 32u, stack) == 0,
+                    "synchronous receive failed")) return false;
+        std::array<uint8_t, 34> output{};
+        memory.readRam(destination - 1u, output.data(), output.size());
+        if (!expect(output.front() == 0xA5u && output.back() == 0xA5u &&
+                    std::equal(output.begin() + 1, output.end() - 1, host.ee.begin() + 4),
+                    "receive lost payload bytes or wrote outside destination") ||
+            !expect(memory.read32(receive) == 0u && memory.read32(receive + 8u) == 0xFFFFFFFFu &&
+                    memory.read32(receive + 4u) == 0xA5A5A5A5u && memory.read32(receive + 12u) == 0xA5A5A5A5u &&
+                    memory.read32(receive + 16u) == 0xA5A5A5A5u,
+                    "receive completion fields or neighboring fields incorrect")) return false;
+        if (!expect(invoke(0x80000000u | receive, 0xA0000000u | ReceiveHost::Base,
+                           0xA0000000u | destination, 16u, stack) == 0,
+                    "aliased synchronous receive failed")) return false;
+        std::array<uint8_t, 16> aliased{};
+        memory.readRam(destination, aliased.data(), aliased.size());
+        if (!expect(std::equal(aliased.begin(), aliased.end(), host.ee.begin()),
+                    "aliased receive returned success without exact bytes")) return false;
+        std::array<uint8_t, 32> hole{};
+        hole.fill(0x7Bu);
+        memory.writeRam(0x700u, hole.data(), 8u);
+        memory.writeRam(0x709u, hole.data() + 9u, 23u);
+        const auto unchangedFailure = [&](uint32_t rd, uint32_t src, uint32_t dst, uint32_t size, uint32_t sp)
+        {
+            // Each failure starts with distinct, incomplete output sentinels.
+            // A leaked host prefix or premature completion must change them.
+            std::array<uint8_t, 32> payloadSentinel{};
+            payloadSentinel.fill(0xC3u);
+            std::array<uint8_t, 16> descriptorSentinel{};
+            descriptorSentinel.fill(0xD4u);
+            memory.writeRam(destination, payloadSentinel.data(), payloadSentinel.size());
+            memory.writeRam(receive, descriptorSentinel.data(), descriptorSentinel.size());
+            std::array<uint8_t, 0x800> before{}, after{};
+            memory.readRam(0u, before.data(), before.size());
+            const int32_t result = invoke(rd, src, dst, size, sp);
+            memory.readRam(0u, after.data(), after.size());
