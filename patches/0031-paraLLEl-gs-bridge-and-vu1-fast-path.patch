diff --git a/ps2xRuntime/include/runtime/gs/gs_pgs.h b/ps2xRuntime/include/runtime/gs/gs_pgs.h
new file mode 100644
index 0000000..ee8e082
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_pgs.h
@@ -0,0 +1,35 @@
+// paraLLEl-GS bridge: the PS2 GS emulated in Vulkan compute (Arntzen Software,
+// LGPL-3.0+). The CPU GS frontend keeps parsing every packet (register state,
+// CSR/SIGNAL/FINISH, transfers) but skips rasterisation; paraLLEl-GS receives
+// the same raw GIF stream, renders it on the GPU and scans out at each vblank.
+//
+// Enabled by default when built with PS2X_HAVE_PGS and a Vulkan device is
+// available; GA2_GS=cpu forces the software renderer. GA2_PGS_SSAA=1|2|4|8|16
+// selects super-sampling, GA2_PGS_HIRES=0|1|2 the scanout scale (1x/2x/4x).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+struct GSRegisters;
+
+namespace ga2_pgs
+{
+    // True once the backend initialised successfully (first call initialises).
+    bool active();
+    // Lock-free: whether the GPU renders (set once active() succeeded).
+    bool rendering();
+    // Raw GIF data in stream order. path is 1..3.
+    void gifTransfer(uint32_t path, const uint8_t *data, size_t size);
+    // A host->local image upload delivered through a native fast path.
+    void imageUpload(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                     const uint8_t *data, size_t size);
+    // Local->host transfer data (TRXDIR=1) produced by the GPU's VRAM.
+    void readLocalToHost(uint8_t *dst, uint32_t qwords);
+    // Game thread, at vblank: flush, scan out with the live CRTC registers and
+    // queue an asynchronous readback of the frame.
+    void vsync(const GSRegisters &regs);
+    // Present thread: newest frame as RGBA8. False when nothing new arrived.
+    bool takeFrame(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height);
+}
