 }
 
@@ -1062,6 +1065,11 @@ void GS::writeRegisterPacked(uint8_t regDesc, uint64_t lo, uint64_t hi)
 void GS::writeRegister(uint8_t regAddr, uint64_t value)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    {
+        // Direct register writes from HLE stubs: forward as a one-register A+D packet.
+        uint64_t packet[4] = {1ull | (1ull << 15) | (1ull << 60), 0xEull, value, regAddr};
+        ga2_pgs::gifTransfer(3u, reinterpret_cast<const uint8_t *>(packet), sizeof(packet));
+    }
     writeRegisterUnlocked(regAddr, value);
 }
 
@@ -1629,6 +1637,14 @@ bool GS::clearActiveFramebuffer(uint32_t rgba)
 uint32_t GS::consumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
 {
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (ga2_pgs::active())
+    {
+        // The GPU owns rendered VRAM; the CPU copy is not drawn into.
+        const uint32_t produced = m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
+        if (produced >= 16u)
+            ga2_pgs::readLocalToHost(dst, produced / 16u);
+        return produced;
+    }
     return m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
 }
 
diff --git a/ps2xRuntime/src/lib/gs/gs_pgs.cpp b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
new file mode 100644
index 0000000..0e9bc6e
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
@@ -0,0 +1,378 @@
+// paraLLEl-GS bridge. See runtime/gs/gs_pgs.h. Structure follows BT3-Recomp's
+// ps2_gs_pgs.cpp (GPL-3.0) without its game-specific seams.
+#include "runtime/gs/gs_pgs.h"
+
+#if defined(PS2X_HAVE_PGS)
+
+#include "runtime/ps2_memory.h"
+
+#include "context.hpp"
+#include "device.hpp"
+#include "gs_interface.hpp"
+#include "thread_id.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <string>
+
+using namespace Vulkan;
+using namespace ParallelGS;
+
+namespace
+{
+    bool envOff(const char *name, const char *offValue)
+    {
+        const char *v = std::getenv(name);
+        return v && std::string(v) == offValue;
+    }
+
+    int envInt(const char *name, int fallback)
+    {
+        const char *v = std::getenv(name);
+        return v && *v ? std::atoi(v) : fallback;
+    }
+
+    struct ReadbackSlot
+    {
+        BufferHandle buffer;
+        Fence fence;
+        ImageHandle image;
+        uint32_t width = 0, height = 0;
+        VkFormat format = VK_FORMAT_UNDEFINED;
+        bool pending = false;
+    };
+
+    struct State
+    {
+        std::mutex mutex;
+        bool tried = false;
+        bool ok = false;
+        Context context;
+        Device device;
+        GSInterface gs;
+        uint32_t ssaa = 1;
+        uint32_t field = 0;
+        ReadbackSlot slots[3];
+        uint32_t slotIndex = 0;
+
+        std::mutex frameMutex;
+        std::vector<uint8_t> frame;
+        uint32_t frameWidth = 0, frameHeight = 0;
+        bool frameFresh = false;
+
+        // statistics
+        uint64_t swaps = 0, packets = 0, bytes = 0;
+        double gifMs = 0.0, vsyncMs = 0.0;
+        std::chrono::steady_clock::time_point statStart = std::chrono::steady_clock::now();
+    };
+
+    std::atomic<bool> g_rendering{false};
+
+    State &state()
+    {
+        // Leaked on purpose: the device must outlive any thread still calling in.
+        static State *s = new State;
+        return *s;
+    }
+
+    void registerThread()
+    {
+        // Granite keys command pools by registered thread index; every caller is
+        // serialised by the state mutex, so they share index 0.
+        static thread_local bool registered = false;
+        if (!registered)
+        {
+            Util::register_thread_index(0);
+            registered = true;
+        }
+    }
+
+    bool initLocked(State &s)
+    {
+        registerThread();
+        if (s.tried)
+            return s.ok;
+        s.tried = true;
+        if (envOff("GA2_GS", "cpu"))
+        {
+            std::fprintf(stderr, "[pgs] disabled by GA2_GS=cpu; using the software GS\n");
+            return false;
+        }
+        if (!Context::init_loader(nullptr))
+        {
+            std::fprintf(stderr, "[pgs] Vulkan loader unavailable; using the software GS\n");
+            return false;
+        }
+        s.context.set_num_thread_indices(1);
+        if (!s.context.init_instance_and_device(nullptr, 0, nullptr, 0,
+                                                CONTEXT_CREATION_ENABLE_PUSH_DESCRIPTOR_BIT |
+                                                    CONTEXT_CREATION_ENABLE_DESCRIPTOR_HEAP_BIT |
+                                                    CONTEXT_CREATION_ENABLE_DESCRIPTOR_BUFFER_BIT))
+        {
+            std::fprintf(stderr, "[pgs] no usable Vulkan device; using the software GS\n");
+            return false;
+        }
+        s.device.set_context(s.context);
+        s.device.init_frame_contexts(4);
+
+        GSOptions options = {};
+        const int r = envInt("GA2_PGS_SSAA", 1);
+        options.super_sampling = r >= 16 ? SuperSampling::X16 : r >= 8 ? SuperSampling::X8
+                                 : r >= 4 ? SuperSampling::X4 : r >= 2 ? SuperSampling::X2 : SuperSampling::X1;
+        s.ssaa = static_cast<uint32_t>(options.super_sampling);
+        if (!s.gs.init(&s.device, options))
+        {
+            std::fprintf(stderr, "[pgs] GSInterface init failed; using the software GS\n");
+            return false;
+        }
+        s.ok = true;
+        g_rendering.store(true, std::memory_order_release);
+        std::fprintf(stderr, "[pgs] paraLLEl-GS active on %s, ssaa=%u\n",
+                     s.device.get_gpu_properties().deviceName, s.ssaa);
+        return true;
+    }
+
+    void consumeSlotLocked(State &s, ReadbackSlot &slot)
+    {
+        const auto *src = static_cast<const uint32_t *>(s.device.map_host_buffer(*slot.buffer, MEMORY_ACCESS_READ_BIT));
+        const size_t pixels = size_t(slot.width) * slot.height;
+        {
+            std::lock_guard<std::mutex> lock(s.frameMutex);
+            s.frame.resize(pixels * 4u);
+            const bool bgra = slot.format == VK_FORMAT_B8G8R8A8_UNORM || slot.format == VK_FORMAT_B8G8R8A8_SRGB;
+            uint8_t *dst = s.frame.data();
+            for (size_t i = 0; i < pixels; ++i)
+            {
+                const uint32_t p = src[i];
+                if (bgra)
+                {
+                    dst[i * 4 + 0] = uint8_t(p >> 16);
+                    dst[i * 4 + 1] = uint8_t(p >> 8);
+                    dst[i * 4 + 2] = uint8_t(p);
+                }
+                else
+                {
+                    dst[i * 4 + 0] = uint8_t(p);
+                    dst[i * 4 + 1] = uint8_t(p >> 8);
+                    dst[i * 4 + 2] = uint8_t(p >> 16);
+                }
+                dst[i * 4 + 3] = 0xff;
+            }
+            s.frameWidth = slot.width;
+            s.frameHeight = slot.height;
+            s.frameFresh = true;
+        }
+        s.device.unmap_host_buffer(*slot.buffer, MEMORY_ACCESS_READ_BIT);
+        slot.pending = false;
+        slot.image.reset();
+        slot.fence.reset();
+    }
+
+    // Asynchronous readback ring: never wait for the GPU on the game thread.
+    void readbackLocked(State &s, const ScanoutResult &result)
+    {
+        for (int k = 1; k <= 2; ++k)
+        {
+            ReadbackSlot &old = s.slots[(s.slotIndex + k) % 3];
+            if (old.pending && old.fence && old.fence->wait_timeout(0))
+                consumeSlotLocked(s, old);
+        }
+        ReadbackSlot &slot = s.slots[s.slotIndex];
+        if (slot.pending)
+        {
+            if (slot.fence && slot.fence->wait_timeout(0))
+                consumeSlotLocked(s, slot);
+            else
+                return; // GPU is behind; drop this frame's copy
+        }
+        const uint32_t w = result.image->get_width(), h = result.image->get_height();
+        if (!slot.buffer || slot.width != w || slot.height != h)
+        {
+            BufferCreateInfo info = {};
+            info.size = VkDeviceSize(w) * h * 4u;
+            info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT;
+            info.domain = BufferDomain::CachedHost;
+            slot.buffer = s.device.create_buffer(info);
+            slot.width = w;
+            slot.height = h;
+        }
+        slot.format = result.image->get_format();
+        auto cmd = s.device.request_command_buffer();
+        cmd->image_barrier(*result.image, VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           VK_PIPELINE_STAGE_2_FRAGMENT_SHADER_BIT, 0,
+                           VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_READ_BIT);
+        cmd->copy_image_to_buffer(*slot.buffer, *result.image, 0, {}, {w, h, 1}, 0, 0,
+                                  {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1});
+        cmd->barrier(VK_PIPELINE_STAGE_2_COPY_BIT, VK_ACCESS_2_TRANSFER_WRITE_BIT,
+                     VK_PIPELINE_STAGE_2_HOST_BIT, VK_ACCESS_2_HOST_READ_BIT);
+        Fence fence;
+        s.device.submit(cmd, &fence);
+        slot.fence = std::move(fence);
+        slot.image = result.image;
+        slot.pending = true;
+        s.slotIndex = (s.slotIndex + 1u) % 3u;
+    }
+
+    template <typename T>
+    void put(T &dst, uint64_t value)
+    {
+        // Upstream SMODE2Bits pads to 65 bits; only the low 64 carry fields.
+        std::memcpy(&dst, &value, std::min(sizeof(T), sizeof(value)));
+    }
+}
+
+namespace ga2_pgs
+{
+    bool rendering() { return g_rendering.load(std::memory_order_acquire); }
+
+    bool active()
+    {
+        State &s = state();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        return initLocked(s);
+    }
+
+    void gifTransfer(uint32_t path, const uint8_t *data, size_t size)
+    {
+        if (!data || size < 16u)
+            return;
+        State &s = state();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (!initLocked(s))
+            return;
+        const auto t0 = std::chrono::steady_clock::now();
+        s.gs.gif_transfer(path, data, size & ~size_t(15));
+        s.gifMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+        ++s.packets;
+        s.bytes += size;
+    }
+
+    void imageUpload(uint64_t bitbltbuf, uint64_t trxpos, uint64_t trxreg, uint64_t trxdir,
+                     const uint8_t *data, size_t size)
+    {
+        if (!data || size == 0)
+            return;
+        // Rebuild the GIF packet the native fast path consumed: A+D setup, then IMAGE.
+        std::vector<uint8_t> packet(16u + 4u * 16u + 16u + ((size + 15u) & ~size_t(15)));
+        auto store64 = [&](size_t offset, uint64_t v) { std::memcpy(packet.data() + offset, &v, 8); };
+        store64(0, 4ull | (1ull << 15) | (0ull << 58) | (1ull << 60)); // NLOOP=4 EOP PACKED NREG=1
+        store64(8, 0xEull);                                            // A+D
+        const uint64_t regs[4][2] = {{bitbltbuf, 0x50}, {trxpos, 0x51}, {trxreg, 0x52}, {trxdir, 0x53}};
+        for (int i = 0; i < 4; ++i)
+        {
+            store64(16u + i * 16u, regs[i][0]);
+            store64(24u + i * 16u, regs[i][1]);
+        }
+        const size_t imageOffset = 16u + 4u * 16u;
+        const uint64_t qwords = (size + 15u) / 16u;
+        store64(imageOffset, (qwords & 0x7fffu) | (1ull << 15) | (2ull << 58)); // IMAGE, EOP
+        store64(imageOffset + 8u, 0);
+        std::memcpy(packet.data() + imageOffset + 16u, data, size);
+        gifTransfer(3, packet.data(), packet.size());
+    }
+
+    void readLocalToHost(uint8_t *dst, uint32_t qwords)
+    {
+        State &s = state();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (!initLocked(s))
+            return;
+        s.gs.read_transfer_fifo(dst, qwords);
+    }
+
+    void vsync(const GSRegisters &r)
+    {
+        State &s = state();
+        std::lock_guard<std::mutex> lock(s.mutex);
+        if (!initLocked(s))
+            return;
+        const auto t0 = std::chrono::steady_clock::now();
+        s.gs.flush();
+
+        auto &p = s.gs.get_priv_register_state();
+        put(p.pmode, r.pmode);
+        // NTSC default when the CRTC was never programmed.
+        put(p.smode1, r.smode1 ? r.smode1 : 0x0000000740814504ull);
+        put(p.smode2, r.smode2);
+        put(p.syncv, r.syncv);
+        put(p.dispfb1, r.dispfb1);
+        put(p.display1, r.display1);
+        put(p.dispfb2, r.dispfb2);
+        put(p.display2, r.display2);
+        put(p.extbuf, r.extbuf);
+        put(p.extdata, r.extdata);
+        put(p.extwrite, r.extwrite);
+        put(p.bgcolor, r.bgcolor);
+
+        VSyncInfo info = {};
+        info.phase = s.field ^= 1u;
+        info.dst_layout = VK_IMAGE_LAYOUT_READ_ONLY_OPTIMAL;
+        info.dst_stage = VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT;
+        info.dst_access = VK_ACCESS_2_SHADER_SAMPLED_READ_BIT;
+        info.force_progressive = true;
+        info.anti_blur = true;
+        info.overscan = false;
+        info.crtc_offsets = false;
+        info.raw_circuit_scanout = true;
+        const uint32_t maxShift = s.ssaa >= 16 ? 2u : s.ssaa >= 4 ? 1u : 0u;
+        const uint32_t shift = std::min<uint32_t>(static_cast<uint32_t>(std::max(0, envInt("GA2_PGS_HIRES", int(maxShift)))), maxShift);
+        info.high_resolution_scanout = shift >= 1;
+        info.high_resolution_scanout_shift = shift >= 2 ? 2u : 1u;
+
+        const ScanoutResult result = s.gs.vsync(info);
+        if (result.image)
+            readbackLocked(s, result);
+        const auto t1 = std::chrono::steady_clock::now();
+        s.vsyncMs += std::chrono::duration<double, std::milli>(t1 - t0).count();
+        ++s.swaps;
+
+        const double elapsed = std::chrono::duration<double>(t1 - s.statStart).count();
+        if (elapsed >= 5.0 && std::getenv("GA2_PERF"))
+        {
+            std::fprintf(stderr, "[pgs] %.1f swaps/s, %.0f packets/s, %.2f MB/s, gif %.2f ms/swap, vsync %.2f ms/swap, frame %ux%u\n",
+                         s.swaps / elapsed, s.packets / elapsed, s.bytes / elapsed / 1048576.0,
+                         s.swaps ? s.gifMs / s.swaps : 0.0, s.swaps ? s.vsyncMs / s.swaps : 0.0,
+                         s.frameWidth, s.frameHeight);
+            std::fprintf(stderr, "[pgs] pmode=%llx smode1=%llx smode2=%llx dispfb1=%llx display1=%llx dispfb2=%llx display2=%llx bgcolor=%llx\n",
+                         (unsigned long long)r.pmode, (unsigned long long)r.smode1, (unsigned long long)r.smode2,
+                         (unsigned long long)r.dispfb1, (unsigned long long)r.display1,
+                         (unsigned long long)r.dispfb2, (unsigned long long)r.display2, (unsigned long long)r.bgcolor);
+            s.swaps = s.packets = s.bytes = 0;
+            s.gifMs = s.vsyncMs = 0.0;
+            s.statStart = t1;
+        }
+    }
+
+    bool takeFrame(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height)
+    {
+        State &s = state();
+        std::lock_guard<std::mutex> lock(s.frameMutex);
+        if (!s.frameFresh)
+            return false;
+        rgba.swap(s.frame);
+        width = s.frameWidth;
+        height = s.frameHeight;
+        s.frameFresh = false;
+        return true;
+    }
+}
