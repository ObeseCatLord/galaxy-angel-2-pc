+
+void GifArbiter::runPacket(GifPathId pathId, const std::vector<uint8_t> &data, bool hasTapData, const std::vector<uint8_t> &tapData)
+{
+    if (m_tapFn)
+    {
+        if (!hasTapData)
+            m_tapFn(pathId, data.data(), static_cast<uint32_t>(data.size()));
+        else if (!tapData.empty())
+            m_tapFn(pathId, tapData.data(), static_cast<uint32_t>(tapData.size()));
+    }
+    m_processFn(data.data(), static_cast<uint32_t>(data.size()));
+}
+
+// A packet the EE sees the effect of at once: an A+D write to SIGNAL, FINISH or
+// LABEL (CSR bits, SIGLBLID, the GS interrupt) or to the display registers
+// (0x59-0x5F, kept in the privileged registers). Such a packet runs on the
+// draining thread. A REGLIST naming A+D is taken inline too (no GS defines it).
+bool GifArbiter::needsInline(const uint8_t *data, uint32_t sizeBytes)
+{
+    uint32_t offset = 0u;
+    while (offset + 16u <= sizeBytes)
+    {
+        uint64_t tagLo = 0, tagHi = 0;
+        std::memcpy(&tagLo, data + offset, sizeof(tagLo));
+        std::memcpy(&tagHi, data + offset + 8u, sizeof(tagHi));
+        offset += 16u;
+        const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+        const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
+        uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+        if (nreg == 0u)
+            nreg = 16u;
+        uint32_t adMask = 0u; // descriptor slots that are A+D
+        for (uint32_t r = 0; r < nreg; ++r)
+            if (((tagHi >> (r * 4u)) & 0xFu) == 0xEu)
+                adMask |= 1u << r;
+        if (flg == 0u) // PACKED
+        {
+            const uint64_t bytes = uint64_t(nloop) * nreg * 16u;
+            if (adMask != 0u)
+            {
+                const uint64_t end = std::min<uint64_t>(sizeBytes, offset + bytes);
+                uint32_t r = 0;
+                for (uint64_t q = offset; q + 16u <= end; q += 16u)
+                {
+                    if (adMask & (1u << r))
+                    {
+                        const uint8_t addr = data[q + 8u];
+                        if ((addr >= 0x59u && addr <= 0x5Fu) || (addr >= 0x60u && addr <= 0x62u))
+                            return true;
+                    }
+                    if (++r == nreg)
+                        r = 0;
+                }
+            }
+            if (bytes > sizeBytes - offset)
+                return false;
+            offset += static_cast<uint32_t>(bytes);
+        }
+        else if (flg == 1u) // REGLIST
+        {
+            if (adMask != 0u)
+                return true;
+            const uint64_t bytes = (uint64_t(nloop) * nreg * 8u + 15u) & ~uint64_t(15u);
+            if (bytes > sizeBytes - offset)
+                return false;
+            offset += static_cast<uint32_t>(bytes);
+        }
+        else if (flg == 2u) // IMAGE
+        {
+            const uint64_t bytes = uint64_t(nloop) * 16u;
+            if (bytes > sizeBytes - offset)
+                return false;
+            offset += static_cast<uint32_t>(bytes);
+        }
+    }
+    return false;
+}
+
+void GifArbiter::enqueue(GifArbiterPacket &pkt)
+{
+    bool backlog = false;
+    {
+        std::lock_guard<std::mutex> lock(m_workerMutex);
+        if (m_incomingCount == m_incoming.size())
+            m_incoming.emplace_back();
+        GifArbiterPacket &job = m_incoming[m_incomingCount++];
+        job.pathId = pkt.pathId;
+        job.hasTapData = pkt.hasTapData;
+        job.data.swap(pkt.data); // the packet slot takes the job's old buffer
+        job.tapData.swap(pkt.tapData);
+        m_incomingBytes += job.data.size() + job.tapData.size();
+        m_submitted.fetch_add(1, std::memory_order_relaxed);
+        // Woken per batch, not per packet (a frame is thousands of small XGKICK packets); sync() wakes it for the rest.
+        if (m_workerSleeping && m_incomingCount >= 64u)
+            m_workCv.notify_one();
+        // Bound what waits: a frame's packets are a few MB at most.
+        backlog = m_incomingCount >= 16384u || m_incomingBytes >= (64u << 20);
+    }
+    ++m_stats.queuedPackets;
+    if (backlog)
+        sync();
+}
+
+void GifArbiter::workerLoop()
+{
+    t_onGsWorker = true;
+    std::unique_lock<std::mutex> lock(m_workerMutex);
+    for (;;)
+    {
+        m_workerSleeping = true;
+        m_workCv.wait(lock, [this] { return m_incomingCount != 0u || m_stopWorker; });
+        m_workerSleeping = false;
+        if (m_incomingCount == 0u)
+            break; // stopping, nothing left
+        m_working.swap(m_incoming);
+        const size_t count = m_incomingCount;
+        m_incomingCount = 0;
+        m_incomingBytes = 0;
+        lock.unlock();
+        for (size_t i = 0; i < count; ++i)
+        {
+            GifArbiterPacket &job = m_working[i];
+            try
+            {
+                runPacket(job.pathId, job.data, job.hasTapData, job.tapData);
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[gs worker] packet failed: %s\n", e.what());
+            }
+            catch (...)
+            {
+                std::fprintf(stderr, "[gs worker] packet failed\n");
+            }
+            constexpr size_t kRetainBytes = 256u * 1024u;
+            if (job.data.capacity() > kRetainBytes)
+                std::vector<uint8_t>().swap(job.data);
+            if (job.tapData.capacity() > kRetainBytes)
+                std::vector<uint8_t>().swap(job.tapData);
+        }
+        lock.lock();
+        m_completed.fetch_add(count, std::memory_order_release);
+        m_idleCv.notify_all();
+    }
+}
+
+void GifArbiter::startWorker()
+{
+    if (m_workerRunning)
+        return;
+    m_stopWorker = false;
+    m_workerRunning = true;
+    m_worker = std::thread([this] { workerLoop(); });
+}
+
+void GifArbiter::stopWorker()
+{
+    if (!m_workerRunning)
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_workerMutex);
+        m_stopWorker = true;
+        m_workCv.notify_one();
+    }
+    if (m_worker.joinable())
+        m_worker.join();
+    m_workerRunning = false;
+}
+
+GifArbiter::~GifArbiter()
+{
+    stopWorker();
+}
+
+bool GifArbiter::onWorkerThread()
+{
+    return t_onGsWorker;
+}
+
+void GifArbiter::sync()
+{
+    if (!m_workerRunning || t_onGsWorker)
+        return;
+    const uint64_t target = m_submitted.load(std::memory_order_relaxed);
+    if (m_completed.load(std::memory_order_acquire) >= target)
+        return;
+    const auto t0 = std::chrono::steady_clock::now();
+    {
+        std::unique_lock<std::mutex> lock(m_workerMutex);
+        if (m_workerSleeping && m_incomingCount != 0u)
+            m_workCv.notify_one();
+        m_idleCv.wait(lock, [&] { return m_completed.load(std::memory_order_acquire) >= target; });
+    }
+    ++m_stats.waits;
+    m_stats.waitMs += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
+}
+
+GifArbiter::WorkerStats GifArbiter::takeWorkerStats()
+{
+    const WorkerStats out = m_stats;
+    m_stats = WorkerStats{};
+    return out;
+}
