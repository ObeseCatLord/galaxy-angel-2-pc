index 0000000..7c465da
--- /dev/null
+++ b/ps2xRuntime/src/lib/ps2_disc_mount.cpp
@@ -0,0 +1,276 @@
+#if defined(_WIN32) && !defined(NOMINMAX)
+#define NOMINMAX
+#endif
+#include "ps2_disc_mount.h"
+#include "ps2_runtime.h"
+
+#include <nlohmann/json.hpp>
+#ifdef PS2X_DISC_SHA256
+#include <openssl/evp.h>
+#endif
+#include <algorithm>
+#include <array>
+#include <fstream>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <unordered_map>
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/stat.h>
+#endif
+
+namespace ps2_disc
+{
+    namespace
+    {
+        std::mutex mutex;
+        uint64_t mountGeneration = 1u;
+        std::filesystem::path verifiedImage;
+        enum class Mode { Raw, NeedsVerification, Verified };
+        Mode mode = Mode::Raw;
+        struct Identity
+        {
+            uint64_t device = 0u, file = 0u, size = 0u;
+            int64_t modified = 0, changed = 0;
+            int64_t modifiedFraction = 0, changedFraction = 0;
+            bool operator==(const Identity &) const = default;
+        };
+        Identity verifiedIdentity;
+        std::unordered_map<std::string, File> files;
+
+        bool identity(const std::filesystem::path &path, Identity &result)
+        {
+#ifdef _WIN32
+            const HANDLE handle = CreateFileW(path.c_str(), FILE_READ_ATTRIBUTES,
+                FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, nullptr,
+                OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+            if (handle == INVALID_HANDLE_VALUE) return false;
+            BY_HANDLE_FILE_INFORMATION info{}; FILE_BASIC_INFO basic{};
+            const bool ok = GetFileInformationByHandle(handle, &info) &&
+                GetFileInformationByHandleEx(handle, FileBasicInfo, &basic, sizeof(basic));
+            CloseHandle(handle);
+            if (!ok) return false;
+            result = {info.dwVolumeSerialNumber, uint64_t(info.nFileIndexHigh) << 32u | info.nFileIndexLow,
+                      uint64_t(info.nFileSizeHigh) << 32u | info.nFileSizeLow,
+                      basic.LastWriteTime.QuadPart, basic.ChangeTime.QuadPart, 0, 0};
+#else
+            struct stat info{};
+            if (::stat(path.c_str(), &info) != 0 || !S_ISREG(info.st_mode) || info.st_size < 0) return false;
+#ifdef __APPLE__
+            const auto modified = info.st_mtimespec, changed = info.st_ctimespec;
+#else
+            const auto modified = info.st_mtim, changed = info.st_ctim;
+#endif
+            result = {uint64_t(info.st_dev), uint64_t(info.st_ino), uint64_t(info.st_size),
+                      modified.tv_sec, changed.tv_sec, modified.tv_nsec, changed.tv_nsec};
+#endif
+            return true;
+        }
+
+        void retireLocked(Mode nextMode)
+        {
+            ++mountGeneration;
+            if (mountGeneration == 0u) ++mountGeneration;
+            verifiedImage.clear(); files.clear();
+            mode = nextMode;
+        }
+
+        void refreshIdentityLocked()
+        {
+            if (verifiedImage.empty()) return;
+            Identity current;
+            if (PS2Runtime::getIoPaths().cdImage != verifiedImage ||
+                !identity(verifiedImage, current) || current != verifiedIdentity)
+                retireLocked(Mode::NeedsVerification);
+        }
+
+        bool digestFile(const std::filesystem::path &path, std::string &hex, std::string *snapshot = nullptr)
+        {
+#ifndef PS2X_DISC_SHA256
+            (void)path; (void)hex; (void)snapshot;
+            return false;
+#else
+            std::ifstream stream(path, std::ios::binary);
+            if (!stream) return false;
+            std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> ctx(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+            if (!ctx || EVP_DigestInit_ex(ctx.get(), EVP_sha256(), nullptr) != 1) return false;
+            std::vector<char> buffer(1024u * 1024u);
+            while (stream)
+            {
+                stream.read(buffer.data(), buffer.size());
+                const auto count = stream.gcount();
+                if (snapshot && count)
+                {
+                    if (snapshot->size() + size_t(count) > 8u * 1024u * 1024u) return false;
+                    snapshot->append(buffer.data(), size_t(count));
+                }
+                if (count && EVP_DigestUpdate(ctx.get(), buffer.data(), size_t(count)) != 1) return false;
+            }
+            if (!stream.eof()) return false;
+            std::array<unsigned char, EVP_MAX_MD_SIZE> result{};
+            unsigned int size = 0u;
+            if (EVP_DigestFinal_ex(ctx.get(), result.data(), &size) != 1 || size != 32u) return false;
+            constexpr char digits[] = "0123456789abcdef";
+            hex.clear();
+            for (unsigned int i = 0u; i < size; ++i)
+            { hex += digits[result[i] >> 4u]; hex += digits[result[i] & 15u]; }
+            return true;
+#endif
+        }
+
+        uint64_t unsignedField(const nlohmann::json &item, const char *name)
+        {
+            const auto &field = item.at(name);
+            if (!field.is_number_unsigned()) throw std::runtime_error("non-unsigned disc metadata field");
+            return field.get<uint64_t>();
+        }
+    }
+
+    std::string pathKey(std::string_view guestPath)
+    {
+        if (guestPath.empty() || guestPath.size() > 1024u) return {};
+        std::string path(guestPath);
+        for (char &c : path)
+        {
+            const unsigned char byte = static_cast<unsigned char>(c);
+            if (byte < 32u || byte > 126u) return {};
+            if (c == '\\') c = '/';
+            else if (c >= 'a' && c <= 'z') c = char(c - 'a' + 'A');
+        }
+        if (path.starts_with("CDROM0:")) path.erase(0u, 7u);
+        else if (path.starts_with("CDROM:")) path.erase(0u, 6u);
+        if (path.find(':') != std::string::npos) return {};
+        while (!path.empty() && path.front() == '/') path.erase(0u, 1u);
+        if (const auto semicolon = path.find(';'); semicolon != std::string::npos)
+        {
+            if (semicolon + 1u == path.size() ||
+                !std::all_of(path.begin() + semicolon + 1u, path.end(), [](char c) { return c >= '0' && c <= '9'; }))
+                return {};
+            path.resize(semicolon);
+        }
+        size_t begin = 0u;
+        while (begin <= path.size())
+        {
+            const auto end = path.find('/', begin);
+            const auto component = path.substr(begin, end == std::string::npos ? end : end - begin);
+            if (component.empty() || component == "." || component == "..") return {};
+            if (end == std::string::npos) break;
+            begin = end + 1u;
+        }
+        return path;
+    }
+
+    void invalidate()
+    {
+        std::lock_guard lock(mutex);
+        // A configured image which opted into verification remains strict across
+        // path reapplication. Only explicit unmount restores legacy raw mode.
+        const bool strict = !PS2Runtime::getIoPaths().cdImage.empty() && mode != Mode::Raw;
+        retireLocked(strict ? Mode::NeedsVerification : Mode::Raw);
+    }
+
+    uint64_t generation()
+    {
+        std::lock_guard lock(mutex);
+        refreshIdentityLocked();
+        return mountGeneration;
+    }
+
+    bool imageReadable()
+    {
+        std::lock_guard lock(mutex);
+        refreshIdentityLocked();
+        return mode != Mode::NeedsVerification;
+    }
+
+    bool mount(const std::filesystem::path &image, const std::filesystem::path &manifest,
+               std::string_view imageSha256, std::string_view manifestSha256, std::string &error)
+    {
+        // Failure retires previously verified metadata, including same-path remounts.
+        invalidate();
+        uint64_t startGeneration;
+        { std::lock_guard lock(mutex); mode = Mode::NeedsVerification; startGeneration = mountGeneration; }
+        error.clear();
+#ifndef PS2X_DISC_SHA256
+        error = "verified disc mounts require OpenSSL Crypto SHA-256 support";
+        return false;
+#endif
+        try
+        {
+            const auto configured = PS2Runtime::getIoPaths().cdImage;
+            if (image.empty() || image.lexically_normal() != configured.lexically_normal())
+                throw std::runtime_error("disc metadata image does not match configured mount");
+            Identity before;
+            if (!identity(image, before)) throw std::runtime_error("disc image identity unavailable");
+            const uint64_t imageSize = before.size;
+            if (imageSize == 0u || imageSize % 2048u != 0u)
+                throw std::runtime_error("invalid disc image size");
+            const uint64_t metadataSize = std::filesystem::file_size(manifest);
+            if (metadataSize == 0u || metadataSize > 8u * 1024u * 1024u)
+                throw std::runtime_error("disc metadata outside bounds");
+            std::string hash, snapshot;
+            if (!digestFile(manifest, hash, &snapshot) || hash != manifestSha256)
+                throw std::runtime_error("disc metadata digest mismatch");
+            if (!digestFile(image, hash) || hash != imageSha256)
+                throw std::runtime_error("disc image digest mismatch");
+            const auto metadata = nlohmann::json::parse(snapshot);
+            if (unsignedField(metadata, "schema_version") != 1u ||
+                unsignedField(metadata.at("iso9660"), "logical_block_size") != 2048u ||
+                unsignedField(metadata.at("iso9660"), "volume_space_size") != imageSize / 2048u)
+                throw std::runtime_error("disc metadata geometry mismatch");
+            const auto &entries = metadata.at("files");
+            if (!entries.is_array() || entries.empty() || entries.size() > 100000u)
+                throw std::runtime_error("disc file table outside bounds");
+            std::unordered_map<std::string, File> pending;
+            for (const auto &entry : entries)
+            {
+                const std::string key = pathKey(entry.at("path").get<std::string>());
+                const uint64_t fileSize = unsignedField(entry, "size");
+                const auto &extents = entry.at("extents");
+                if (key.empty() || fileSize > UINT32_MAX || !extents.is_array() ||
+                    extents.empty() || extents.size() > 256u)
+                    throw std::runtime_error("invalid disc file record");
+                File file{static_cast<uint32_t>(fileSize), {}};
+                uint64_t total = 0u;
+                for (const auto &part : extents)
+                {
+                    const uint64_t lba = unsignedField(part, "lba"), size = unsignedField(part, "size");
+                    if (lba > UINT32_MAX || size > UINT32_MAX || lba * 2048u > imageSize ||
+                        size > imageSize - lba * 2048u)
+                        throw std::runtime_error("disc file extent outside image");
+                    total += size;
+                    file.extents.push_back({static_cast<uint32_t>(lba), static_cast<uint32_t>(size)});
+                }
+                if (total != fileSize || unsignedField(entry, "lba") != file.extents.front().lba ||
+                    !pending.emplace(key, std::move(file)).second)
+                    throw std::runtime_error("duplicate/inconsistent disc file record");
+            }
+            Identity after;
+            if (!identity(image, after) || before != after)
+                throw std::runtime_error("disc image changed during validation");
+            std::lock_guard lock(mutex);
+            if (mountGeneration != startGeneration || PS2Runtime::getIoPaths().cdImage != configured)
+                throw std::runtime_error("disc mount changed during validation");
+            verifiedImage = configured; verifiedIdentity = after;
+            mode = Mode::Verified; files = std::move(pending);
+            return true;
+        }
+        catch (const std::exception &failure)
+        { error = failure.what(); return false; }
+    }
+
+    bool findFile(std::string_view guestPath, File &file)
+    {
+        const std::string key = pathKey(guestPath);
+        std::lock_guard lock(mutex);
+        refreshIdentityLocked();
+        if (verifiedImage.empty() || mode != Mode::Verified) return false;
+        const auto entry = files.find(key);
+        if (entry == files.end()) return false;
+        file = entry->second;
+        return true;
+    }
+}
