+namespace
+{
+    std::string digest(const std::filesystem::path &path)
+    {
+        std::ifstream stream(path, std::ios::binary);
+        std::unique_ptr<EVP_MD_CTX, decltype(&EVP_MD_CTX_free)> ctx(EVP_MD_CTX_new(), EVP_MD_CTX_free);
+        EVP_DigestInit_ex(ctx.get(), EVP_sha256(), nullptr);
+        std::vector<char> buffer(1024u * 1024u);
+        while (stream)
+        { stream.read(buffer.data(), buffer.size()); EVP_DigestUpdate(ctx.get(), buffer.data(), size_t(stream.gcount())); }
+        std::array<unsigned char, 32> hash{}; unsigned int length = 0u;
+        EVP_DigestFinal_ex(ctx.get(), hash.data(), &length);
+        std::string result; constexpr char digits[] = "0123456789abcdef";
+        for (unsigned char byte : hash) { result += digits[byte >> 4]; result += digits[byte & 15]; }
+        return result;
+    }
+
+    struct Env
+    {
+        PS2Runtime::IoPaths previous = PS2Runtime::getIoPaths();
+        std::filesystem::path root = std::filesystem::temp_directory_path() /
+            ("ps2-disc-proof-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        std::vector<uint8_t> ram = std::vector<uint8_t>(PS2_RAM_SIZE, 0xCCu);
+        R5900Context cpu{};
+        PS2Runtime runtime;
+        PS2IopHostAdapter host{runtime};
+        Env() { std::filesystem::create_directories(root); }
+        ~Env()
+        {
+            // Explicitly unmount this fixture before restoring prior legacy paths.
+            auto empty = previous; empty.cdImage.clear(); PS2Runtime::setIoPaths(empty);
+            PS2Runtime::setIoPaths(previous); std::filesystem::remove_all(root);
+        }
+        void paths(const std::filesystem::path &image)
+        {
+            auto paths = previous; paths.cdRoot = root; paths.cdImage = image;
+            PS2Runtime::setIoPaths(paths);
+        }
+        void image(const std::filesystem::path &path, uint64_t sectors, uint32_t lba, uint8_t byte)
+        {
+            std::ofstream out(path, std::ios::binary);
+            out.seekp(std::streamoff(sectors * 2048u - 1u)); out.put('\0');
+            out.seekp(std::streamoff(uint64_t(lba) * 2048u));
+            std::array<char, 2048> payload{}; payload.fill(char(byte)); out.write(payload.data(), payload.size());
+        }
+        std::filesystem::path metadata(const std::filesystem::path &image, uint32_t lba, uint32_t size = 2048u)
+        {
+            nlohmann::json meta = {
+                {"schema_version",1}, {"iso9660", {{"logical_block_size",2048}, {"volume_space_size",std::filesystem::file_size(image)/2048u}}},
+                {"files", nlohmann::json::array({{{"path","/SAME.BIN"},{"lba",lba},{"size",size},
+                    {"extents", nlohmann::json::array({{{"lba",lba},{"size",size}}})}}})}};
+            auto path = image; path += ".json";
+            std::ofstream(path) << meta.dump(); return path;
+        }
+        bool mount(const std::filesystem::path &image, const std::filesystem::path &meta)
+        {
+            paths(image); std::string error;
+            return ps2_disc::mount(image, meta, digest(image), digest(meta), error);
+        }
+        void reg(int number, uint32_t value) { cpu.r[number] = _mm_set_epi64x(0, value); }
+        uint32_t eeSearch()
+        {
+            std::strcpy(reinterpret_cast<char *>(ram.data()+0x1000u), "cdrom0:\\SAME.BIN;1");
+            reg(4, 0x2000u); reg(5, 0x1000u);
+            ps2_stubs::sceCdSearchFile(ram.data(), &cpu, &runtime);
+            return getRegU32(&cpu, 2);
+        }
+        uint32_t eeRead(uint32_t lba)
+        {
+            reg(4,lba); reg(5,1); reg(6,0x3000u); reg(7,0u);
+            ps2_stubs::sceCdRead(ram.data(), &cpu, &runtime);
+            return getRegU32(&cpu,2);
+        }
+        uint32_t word(uint32_t address)
+        { uint32_t value; std::memcpy(&value, ram.data()+address,4u); return value; }
+        std::pair<uint32_t,uint32_t> iopSearch()
+        {
+            using namespace ps2x::iop::detail;
+            IopMemory memory; IopKernel kernel(memory); IopCdvd cdvd(host,memory,kernel);
+            const char path[]="cdrom0:\\SAME.BIN;1";
+            if (!memory.writeRam(0x1000u,path,sizeof(path))) throw std::runtime_error("fixture path write failed");
+            memory.write32(0x2000u,0xCCCCCCCCu);
+            IopCpuState cpu{}; cpu.gpr[4]=0x2000u; cpu.gpr[5]=0x1000u;
+            if (!cdvd.dispatchImport(10u,cpu)) throw std::runtime_error("IOP search unhandled");
+            return {cpu.gpr[2],memory.read32(0x2000u)};
+        }
+    };
+}
+
+void register_ps2_disc_mount_tests()
+{
+    MiniTest::Case("Verified mounted-disc extents", [](TestCase &tc)
+    {
+    tc.Run("EE and IOP search/read agree and mounted image overrides pseudo LBA collision", [](TestCase &t)
+    {
+        Env env; const auto image=env.root/"large.iso";
+        env.image(image,0x100004u,3u,0x31u);
+        { std::fstream out(image,std::ios::binary|std::ios::in|std::ios::out); out.seekp(std::streamoff(uint64_t(0x100000u)*2048u)); out.put(char(0x79u)); }
+        std::ofstream(env.root/"SAME.BIN") << "conflicting loose bytes";
+        auto meta=env.metadata(image,3u);
+        t.IsTrue(env.mount(image,meta),"verified sparse image mounts");
+        t.Equals(env.eeSearch(),1u,"EE search succeeded"); t.Equals(env.word(0x2000u),3u,"EE real LBA");
+        const auto [success,lba]=env.iopSearch(); t.Equals(success,1u,"IOP search succeeded"); t.Equals(lba,3u,"IOP real LBA");
+        t.Equals(env.eeRead(3u),1u,"EE real sector read"); t.Equals(env.ram[0x3000u],uint8_t(0x31u),"EE image bytes");
+        t.Equals(env.eeRead(0x100000u),1u,"collision LBA raw read"); t.Equals(env.ram[0x3000u],uint8_t(0x79u),"collision reads ISO rather than loose file");
+        const auto handle=env.host.openGuestFile("cdrom0:\\SAME.BIN;1");
+        std::array<uint8_t,2048> data{}; size_t read=0u;
+        t.IsTrue(handle!=0u && env.host.readHostFile(handle,0u,data.data(),data.size(),read),"IOP guest file reads original extent");
+        t.Equals(read,data.size(),"exact logical file bytes"); t.Equals(data[0],uint8_t(0x31u),"guest file image payload"); env.host.closeHostFile(handle);
+    });
+    tc.Run("A to B to A and same-path replacement revoke lookup and file handles", [](TestCase &t)
+    {
+        Env env; const auto a=env.root/"a.iso", b=env.root/"b.iso";
+        env.image(a,12u,3u,0x41u); env.image(b,12u,7u,0x42u);
+        const auto ma=env.metadata(a,3u),mb=env.metadata(b,7u);
