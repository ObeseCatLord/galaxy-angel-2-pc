+#include "ps2x/iop/iop_subsystem.h"
+#include "emulator/iop_emulator.h"
+
+#include <cstdio>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop;
+
+    constexpr uint32_t kDbcSid = 0x80001300u;
+
+    void require(bool value, const char *message)
+    {
+        if (!value)
+            throw std::runtime_error(message);
+    }
+
+    class Host final : public IopHost
+    {
+    public:
+        Host()
+            : guest(0x20000u, 0u)
+        {
+        }
+
+        bool readGuest(uint32_t address, void *destination, size_t size) const override
+        {
+            if ((size != 0u && !destination) || address > guest.size() || size > guest.size() - address)
+                return false;
+            if (size != 0u)
+                std::memcpy(destination, guest.data() + address, size);
+            return true;
+        }
+
+        bool writeGuest(uint32_t address, const void *source, size_t size) override
+        {
+            if ((size != 0u && !source) || address > guest.size() || size > guest.size() - address)
+                return false;
+            if (size != 0u)
+                std::memcpy(guest.data() + address, source, size);
+            return true;
+        }
+
+        bool zeroGuest(uint32_t address, size_t size) override
+        {
+            if (address > guest.size() || size > guest.size() - address)
+                return false;
+            if (size != 0u)
+                std::memset(guest.data() + address, 0, size);
+            return true;
+        }
+
+        bool normalizeGuestAddress(uint32_t address, uint32_t &normalized) const override
+        {
+            normalized = address;
+            return address < guest.size();
+        }
+
+        uint32_t allocateIopHandle(IopHandleKind) override { return 1u; }
+        uint32_t allocateGuest(uint32_t, uint32_t) override { return 0u; }
+        void freeGuest(uint32_t) override {}
+        void audioCommand(uint32_t, uint32_t, GuestBuffer, GuestBuffer) override {}
+        std::string hostPath(HostPathKind) const override { return {}; }
+        std::string translateGuestPath(std::string_view path) const override { return std::string(path); }
+        uint64_t openHostFile(std::string_view) override { return 0u; }
+        bool hostFileSize(uint64_t, uint64_t &) const override { return false; }
+        bool readHostFile(uint64_t, uint64_t, void *, size_t, size_t &) override { return false; }
+        void closeHostFile(uint64_t) override {}
+        int32_t memoryCard(const MemoryCardRequest &) override { return 0; }
+        bool hasGuestFunction(uint32_t) const override { return false; }
+        bool invokeGuestFunction(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t *) override
+        {
+            return false;
+        }
+        void log(LogLevel, std::string_view) override {}
+
+        bool writeSifRegister(SifRegister registerId, uint32_t value) override
+        {
+            if (registerId == SifRegister::SmFlag && value == 0x10000u)
+            {
+                ++guestExecutionCallbacks;
+                if (emulatorProbe)
+                    emulatorWasQuiescentDuringGuestExecution = emulatorProbe->isQuiescent();
+                if (resetTarget)
+                {
+                    resetAcceptedDuringGuestExecution = resetTarget->tryReset();
+                    resetTarget->reset();
+                    voidResetInvokedDuringGuestExecution = true;
+                }
+            }
+            return true;
+        }
+
+        void resetIopSifRegisters() override
+        {
+            ++sifResetCalls;
+        }
+
+        IopSubsystem *resetTarget = nullptr;
+        detail::IopEmulator *emulatorProbe = nullptr;
+        bool resetAcceptedDuringGuestExecution = true;
+        bool voidResetInvokedDuringGuestExecution = false;
+        bool emulatorWasQuiescentDuringGuestExecution = true;
+        uint32_t guestExecutionCallbacks = 0u;
+        uint32_t sifResetCalls = 0u;
+        std::vector<uint8_t> guest;
+    };
+
+#pragma pack(push, 1)
+    struct ElfHeader
+    {
+        uint8_t ident[16];
+        uint16_t type;
+        uint16_t machine;
+        uint32_t version;
+        uint32_t entry;
+        uint32_t phoff;
+        uint32_t shoff;
+        uint32_t flags;
+        uint16_t ehsize;
+        uint16_t phentsize;
+        uint16_t phnum;
+        uint16_t shentsize;
+        uint16_t shnum;
+        uint16_t shstrndx;
+    };
+
+    struct ProgramHeader
+    {
+        uint32_t type;
+        uint32_t offset;
+        uint32_t vaddr;
+        uint32_t paddr;
+        uint32_t filesz;
+        uint32_t memsz;
+        uint32_t flags;
+        uint32_t align;
+    };
+#pragma pack(pop)
+
+    static_assert(sizeof(ElfHeader) == 52u);
+    static_assert(sizeof(ProgramHeader) == 32u);
+
+    void writeGuestResetCallbackIrx(Host &host, uint32_t address)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t threadAddress = loadAddress + 0x100u;
+        constexpr uint32_t thbaseTableAddress = loadAddress + 0x180u;
+        constexpr uint32_t createThreadStub = thbaseTableAddress + 20u;
+        constexpr uint32_t startThreadStub = createThreadStub + 8u;
+        constexpr uint32_t sifmanTableAddress = loadAddress + 0x1C0u;
+        constexpr uint32_t sifInitStub = sifmanTableAddress + 20u;
+        constexpr uint32_t threadDescriptor = loadAddress + 0x300u;
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = header.ident[5] = header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x400u; program.memsz = 0x400u; program.flags = 7u; program.align = 4u;
+
+        const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+        const uint32_t entry[] = {
+            0x27BDFFE0u, 0xAFBF001Cu,
+            0x3C040001u, 0x34840300u, jal(createThreadStub), 0x00000000u,
+            0x00408021u,
+            0x02002021u, 0x00002821u, jal(startThreadStub), 0x00000000u,
+            0x8FBF001Cu, 0x00001021u, 0x27BD0020u, 0x03E00008u, 0x00000000u,
+        };
+        const uint32_t thread[] = {
+            jal(sifInitStub), 0x00000000u,
+            0x00001021u, 0x03E00008u, 0x00000000u,
+        };
+        const uint32_t thbaseImports[] = {
+            0x41E00000u, 0u, 0x00000101u,
+            0x61626874u, 0x00006573u,
+            0x03E00008u, 0x24000004u,
+            0x03E00008u, 0x24000006u,
+            0u, 0u,
+        };
+        const uint32_t sifmanImports[] = {
+            0x41E00000u, 0u, 0x00000101u,
+            0x6D666973u, 0x00006E61u,
+            0x03E00008u, 0x24000005u,
+            0u, 0u,
+        };
+        const uint32_t descriptor[] = {0u, 0u, threadAddress, 0x400u, 10u};
+
+        std::vector<uint8_t> segment(program.filesz, 0u);
+        const auto put = [&](uint32_t offset, const void *source, size_t size)
+        {
+            std::memcpy(segment.data() + offset, source, size);
+        };
+        put(0u, entry, sizeof(entry));
+        put(0x100u, thread, sizeof(thread));
+        put(0x180u, thbaseImports, sizeof(thbaseImports));
+        put(0x1C0u, sifmanImports, sizeof(sifmanImports));
+        put(0x300u, descriptor, sizeof(descriptor));
+
+        std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
+    }
+
+    void resetIsRejectedDuringGuestThreadExecution()
+    {
+        Host host;
+        IopSubsystem iop(host);
+        host.resetTarget = &iop;
+
+        require(iop.loadModule("rom0:DBCMAN").moduleId > 0, "could not load HLE provider");
+        constexpr uint32_t allocationSize = 64u;
+        const uint32_t allocation = iop.allocateMemory(allocationSize);
+        require(allocation != 0u, "could not allocate IOP-owned resource");
+        const uint32_t sentinel = 0x52455345u;
+        require(iop.writeMemory(allocation, &sentinel, sizeof(sentinel)), "could not write IOP-owned resource");
+
+        writeGuestResetCallbackIrx(host, 0x1000u);
+        const ModuleLoadResult module = iop.loadModuleBuffer(0x1000u);
+        require(module.moduleId > 0 && module.startResult == 0, "could not start guest-thread IRX");
+        require(iop.canBindRpc(kDbcSid), "HLE provider was absent before callback");
+        require(iop.debugSnapshot().emulatorLoadedModules == 1u, "physical module was absent before callback");
+
+        iop.runEeCycles(8u * 256u);
+
+        require(host.guestExecutionCallbacks == 1u, "guest thread did not reach the existing SIF host callback");
+        require(!host.resetAcceptedDuringGuestExecution, "reset succeeded from active guest execution");
+        require(host.voidResetInvokedDuringGuestExecution, "legacy reset did not use the guarded path");
+        require(host.sifResetCalls == 0u, "rejected reset changed host SIF state");
+        require(iop.canBindRpc(kDbcSid), "rejected reset revoked HLE provider");
+        require(iop.debugSnapshot().emulatorLoadedModules == 1u, "rejected reset cleared loaded physical module");
+        uint32_t observed = 0u;
+        require(iop.readMemory(allocation, &observed, sizeof(observed)) && observed == sentinel,
+                "rejected reset changed IOP-owned allocation");
+
+        require(iop.tryReset(), "quiescent reset was rejected");
+        require(host.sifResetCalls == 1u, "quiescent reset did not update host SIF state");
+        require(!iop.canBindRpc(kDbcSid), "quiescent reset retained HLE provider");
+        const DebugSnapshot snapshot = iop.debugSnapshot();
+        require(snapshot.emulatorLoadedModules == 0u && snapshot.emulatorThreads == 0u && snapshot.emulatorRpcServers == 0u,
+                "quiescent reset retained guest module-owned resources");
+        require(iop.allocateMemory(allocationSize) == allocation, "quiescent reset did not revoke allocator ownership");
+    }
+
+    void scheduledGuestThreadIsNotQuiescent()
+    {
+        Host host;
+        detail::IopEmulator emulator(host);
+        host.emulatorProbe = &emulator;
+        writeGuestResetCallbackIrx(host, 0x1000u);
+        const ModuleLoadResult module = emulator.loadModuleBuffer(0x1000u, nullptr, 0u);
+        require(module.moduleId > 0 && module.startResult == 0, "could not start direct guest-thread IRX");
+
+        emulator.runEeCycles(8u * 256u);
+
+        require(host.guestExecutionCallbacks == 1u, "direct guest thread did not reach SIF host callback");
+        require(!host.emulatorWasQuiescentDuringGuestExecution,
+                "scheduled guest execution was treated as quiescent");
+    }
+}
+
+int main()
+{
+    try
+    {
+        scheduledGuestThreadIsNotQuiescent();
+        resetIsRejectedDuringGuestThreadExecution();
+    }
+    catch (const std::exception &error)
+    {
+        return (std::fputs(error.what(), stderr), std::fputc('\n', stderr), 1);
+    }
+    return 0;
+}
