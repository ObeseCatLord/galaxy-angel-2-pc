+    if (dctrl != m_ioRegisters.end() && (dctrl->second & 1u) == 0u)
+        return;
+    const auto enable = m_ioRegisters.find(0x1000F520u);
+    if (enable != m_ioRegisters.end() && (enable->second & 0x00ff0000u) != 0u)
+        return;
+
+    uint32_t &madr = m_ioRegisters[kChannel + 0x10u];
+    uint32_t &qwc = m_ioRegisters[kChannel + 0x20u];
+    const uint32_t count = std::min(qwc, m_ipu->outputCount());
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        alignas(16) std::array<uint8_t, 16> qword{};
+        m_ipu->readOutput(qword.data(), 1u);
+        if ((madr & 0x80000000u) != 0u)
+            std::memcpy(&m_scratchpad[madr & (PS2_SCRATCHPAD_SIZE - 1u) & ~15u], qword.data(), 16);
