+void PS2Memory::processIpuOutputDma()
+{
+    static constexpr uint32_t kChannel = 0x1000B000u;
+    uint32_t &chcr = m_ioRegisters[kChannel];
+    if ((chcr & 0x100u) == 0u || m_ipu->outputCount() == 0u)
+        return;
