+void PS2Memory::pumpIpu()
+{
+    // Feed toIPU, run the decoder, drain fromIPU, until nothing changes. The
+    // bound only guards against a device bug; real streams settle quickly.
+    for (int iteration = 0; iteration < 1 << 22; ++iteration)
+    {
+        const uint64_t before = m_ipu->activity();
+        processIpuInputDma();
+        m_ipu->run();
+        processIpuOutputDma();
+        if (m_ipu->activity() == before)
+            return;
+    }
+    throw IpuUnsupportedOperation("IPU pump did not settle");
+}
