+    if (dctrl != m_ioRegisters.end() && ((dctrl->second >> 4u) & 3u) == 3u)
+        m_ioRegisters[0x1000E020u] = madr;
+    if (qwc == 0u)
+        completeDmacChannel(kChannel, 3u);
+}
