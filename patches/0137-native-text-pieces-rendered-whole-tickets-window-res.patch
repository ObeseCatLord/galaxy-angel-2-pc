--- a/ps2xRuntime/include/runtime/ga2_hitext.h
+++ b/ps2xRuntime/include/runtime/ga2_hitext.h
@@ -2,18 +2,21 @@
 // 4-bit full-width Shift-JIS glyphs, one proportional 128x144 half-width atlas).
 // At 2x/4x internal resolution that is visibly blocky, so the paraLLEl-GS texture
 // replacement (gs_texpacks.cpp) swaps each glyph texture for the same character
-// drawn from the bundled vector font (Noto Sans JP) at the internal resolution,
-// fitted to the game's own ink box so layout, advances and line breaks do not
-// change. The game side (native/compat/ga2_text.cpp) only reports what the game
-// looks up; nothing in the game's memory or timing changes.
+// drawn from the bundled vector font (Noto Sans JP) at the internal resolution.
+// Full-width characters keep the game's layout. Latin characters are drawn at
+// their natural shape and the game side (native/compat/ga2_text.cpp) moves each
+// one to the font's own advance and kerning (native layout); line breaks stay
+// the game's. Nothing in the game's memory or timing changes.
 //
 //   GA2_SHARP_TEXT=0|1|auto   off / on / on above native resolution (default)
 //   GA2_UI_FONT=<file>        the vector font (default <app>/fonts/NotoSansJP-Medium.otf)
 //   GA2_HITEXT_DUMP=<dir>     writes every replacement glyph next to the game's own (evidence)
 //   GA2_HITEXT_BOLD=<px>      grow strokes by this many game pixels (default 0; GA2_HITEXT_BOLD_LATIN for the atlas)
+//   GA2_NATIVE_TEXT_LAYOUT=0  Latin text in the game's own bitmap-font layout (glyphs fitted to its cells)
 #pragma once
 
 #include <cstdint>
+#include <memory>
 #include <vector>
 
 namespace ga2_hitext
@@ -38,6 +41,66 @@ namespace ga2_hitext
     void noteGlyph(uint32_t sjis, const uint8_t *bitmap288);
     // The half-width metrics table in use: 95 entries (characters 0x20..0x7E) of int32 {u, v, width}.
     void noteAsciiMetrics(const uint8_t *table);
+    // Native layout of the half-width (Latin) characters: the vector font's own advances and kerning instead of
+    // the game's bitmap widths, at the games' 18-pixel size (em 17.1 px). Sharp text draws each character
+    // unstretched with its ink centred in the game's atlas cell, so the game side (ga2_text.cpp) places a cell
+    // `inkCentre - cellWidth / 2` from the pen. Index 0..94 = characters 0x20..0x7E (0 = space); game pixels.
+    struct LatinLayout
+    {
+        float advance[95];
+        float inkCentre[95];
+        float kern[95][95]; // [previous][next], added before `next`
+    };
+    // nullptr without the font.
+    const LatinLayout *latinLayout();
+
+    // ---- native text runs (game side: ga2_text.cpp) ----------------------------------------------------------
+    // With native layout the port renders the games' text itself: each piece of a line in one colour is drawn
+    // whole from the vector font at the internal resolution, with the font's own spacing, kerning and full
+    // descenders, Japanese at its real size. The game draws a "ticket" in its place: a 24x24 glyph bitmap made for
+    // the piece, as one sprite over the piece's rectangle; the texture replacement answers the ticket with the
+    // piece's image, so the GS still composes the text (colour, fades, layers, VR) as it did the game's glyphs.
+    struct RunGlyph
+    {
+        uint32_t codepoint = 0; // Unicode
+        float x = 0.0f;         // pen position, game pixels from the image's left edge
+        float cellTop = 0.0f;   // top of the game's cell for the character, game pixels from the image's top
+        float size = 18.0f;     // the game's character size
+        bool fullWidth = false; // full-width cell (em 23.8 / 24 of the size) or half-width (em 17.1 / 18)
+    };
+    struct RunSpec
+    {
+        int width = 0, height = 0; // game pixels
+        // The GS shows a ticket's image from this far in (the games' texel coordinates start half a texel in): the
+        // ticket's image has its glyphs that much further in.
+        float insetX = 0.0f, insetY = 0.0f;
+        std::vector<RunGlyph> glyphs;
+    };
+    // The font has this character.
+    bool fontHasGlyph(uint32_t codepoint);
+    // Registers the piece and writes its ticket (288 bytes: 24x24, 4 bits per pixel, the games' glyph layout).
+    // Returns the ticket's hash (the piece's identity).
+    uint64_t noteRun(const RunSpec &spec, uint8_t *ticket288);
+    // The port's text drawn in a frame, for the presentation (ga2_present.cpp): it takes the GS's rendering of it
+    // out of the 2D picture and draws the text again at the window's own resolution, so the 2D filters and the
+    // scaling never touch it. notePiece is called per piece drawn (game thread, game 2D coordinates as given to the
+    // screen-rect setter, the sprite colour 0x80 = 1.0); textPieces gives the last complete frame's (empty when no
+    // text was drawn lately).
+    struct Alpha;
+    struct TextPiece
+    {
+        uint64_t hash = 0;
+        std::shared_ptr<const RunSpec> spec;
+        float x0 = 0, y0 = 0, x1 = 0, y1 = 0;
+        uint8_t r = 0x80, g = 0x80, b = 0x80, a = 0x80;
+    };
+    void notePiece(const TextPiece &piece);
+    std::vector<TextPiece> textPieces();
+    // A piece drawn at any scale (game pixels -> pixels: sx, sy) with its rectangle's top left at (ox, oy) pixels,
+    // into w x h: plain coverage 0..255 (not the GS levels), no inset.
+    bool renderRunScaled(const RunSpec &spec, float sx, float sy, float ox, float oy, int w, int h, Alpha &out);
+    // Text is laid out natively: sharp text is on and GA2_NATIVE_TEXT_LAYOUT is not 0.
+    bool nativeLayout();
     // Characters reported, glyph images made, distinct glyph textures the GS then asked for (served), atlas cell images made.
     struct Stats
     {
@@ -80,6 +143,8 @@ namespace ga2_hitext
     // alpha level*8), as reported by noteGlyph. The image is rendered once and cached (a worker thread prepares
     // glyphs as they are first seen).
     bool glyphImage(uint64_t hash, Alpha &out);
+    // The image of the text piece whose ticket decodes to `hash` (noteRun): width*renderScale x height*renderScale.
+    bool runImage(uint64_t hash, Alpha &out);
     // The metrics noteAsciiMetrics supplied (95 entries); false before the game reported them.
     bool asciiCells(AsciiCell (&cells)[95]);
     // The hash a game bitmap has once the GS decoded it (white, alpha level * 8 in the GS's 0..0x80 range).
diff --git a/ps2xRuntime/src/lib/ga2_present.cpp b/ps2xRuntime/src/lib/ga2_present.cpp
index c36863b..2e873e7 100644
--- a/ps2xRuntime/src/lib/ga2_present.cpp
+++ b/ps2xRuntime/src/lib/ga2_present.cpp
@@ -3,6 +3,7 @@
 #include "runtime/ga2_display.h"
 #include "ga2_mpv_shader.h"
 #include "runtime/ga2_activity.h"
+#include "runtime/ga2_hitext.h"
 
 #include "raylib.h"
 #include "rlgl.h"
@@ -18,6 +19,9 @@
 #include <fstream>
 #include <memory>
 #include <sstream>
+#include <list>
+#include <unordered_map>
+#include <string>
 #include <vector>
 
 namespace ga2_present
@@ -135,8 +139,23 @@ uniform sampler2D texture0;   // Anime4K of the small picture
 uniform sampler2D fullPicture; // the picture as rendered
 uniform sampler2D smallPicture;
 uniform vec2 fullSize;
+uniform vec2 outSize;  // the mix's size (the picture as shown)
 uniform float stepPx; // half a small-picture pixel, in full-picture pixels
+uniform vec2 gameSize; // the picture in the game's 2D coordinates (640x480)
+uniform int rectCount; // the port's text (ga2_hitext::textPieces), game coordinates x0, y0, x1, y1
+uniform vec4 rects[64];
+uniform int showMask;  // GA2_TEXT_MASK_SHOW=1: tint what the filter leaves alone
 out vec4 finalColor;
+// The full picture over one output pixel's footprint (4x4 bilinear taps): the picture is usually shown smaller than
+// rendered (4x in a window), and a single bilinear tap skips texels, which makes the strokes of text uneven.
+vec3 fullArea(vec2 uv) {
+    vec2 foot = max(fullSize / outSize, vec2(1.0));
+    vec3 sum = vec3(0.0);
+    for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 4; ++x)
+            sum += texture(fullPicture, uv + ((vec2(x, y) + 0.5) / 4.0 - 0.5) * foot / fullSize).rgb;
+    return sum / 16.0;
+}
 void main() {
     vec2 uv = fragTexCoord;
     // Detail anywhere within one small-picture pixel: Anime4K redraws an edge from the small picture over that
@@ -149,12 +168,44 @@ void main() {
             detail = max(detail, max(d.r, max(d.g, d.b)));
         }
     float m = smoothstep(0.08, 0.22, detail);
-    finalColor = vec4(mix(texture(texture0, uv).rgb, texture(fullPicture, uv).rgb, m), 1.0);
+    // The port's own text is never filtered: it is rendered at the internal resolution already.
+    vec2 g = uv * gameSize;
+    for (int i = 0; i < rectCount; ++i) {
+        vec4 r = rects[i];
+        if (g.x >= r.x - 1.0 && g.x <= r.z + 1.0 && g.y >= r.y - 1.0 && g.y <= r.w + 1.0)
+            m = 1.0;
+    }
+    vec3 c = mix(texture(texture0, uv).rgb, fullArea(uv), m);
+    if (showMask != 0)
+        c = mix(c, vec3(1.0, 0.0, 0.0), 0.35 * m);
+    finalColor = vec4(c, 1.0);
 })";
         Shader g_boxDown{}, g_detailMix{};
         bool g_detailLoaded = false;
         RenderTexture2D g_small{}, g_mixed{};
 
+        // A picture rendered larger than it is shown (2x / 4x internal resolution in a smaller window), made the
+        // shown size by averaging each output pixel's footprint (4x4 bilinear taps, up to 8 texels across): a plain
+        // bilinear draw skips texels when it shrinks by more than 2x and thins or drops the strokes of text.
+        const char *kAreaDown = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 srcSize;
+uniform vec2 dstSize;
+out vec4 finalColor;
+void main() {
+    vec2 foot = max(srcSize / dstSize, vec2(1.0));
+    vec3 sum = vec3(0.0);
+    for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 4; ++x)
+            sum += texture(texture0, fragTexCoord + ((vec2(x, y) + 0.5) / 4.0 - 0.5) * foot / srcSize).rgb;
+    finalColor = vec4(sum / 16.0, 1.0);
+})";
+        Shader g_areaDown{};
+        int g_areaLoaded = -1; // -1 not tried
+        RenderTexture2D g_area{};
+
+
         // A render target of this size (made again when the size changes).
         void ensureTarget(RenderTexture2D &target, int width, int height)
         {
@@ -177,6 +228,343 @@ void main() {
                            0.0f, WHITE);
             EndTextureMode();
         }
+        void dumpPicture(unsigned texture, int width, int height, const std::string &path, bool alpha = false);
+
+        // ---- native text (ga2_hitext::textPieces) -----------------------------------------------------------------
+        // The port's own text reaches the GS as whole pieces (ga2_text.cpp), so the presentation knows exactly what
+        // the GS drew, where, in which colour. It takes that rendering out of the 2D picture (the filters and the
+        // scaling then work on the art alone) and draws the text again at the window's resolution from the vector
+        // font, like any other text on the desktop. Where the picture does not show the text as drawn (a menu or a
+        // fade over it), the GS's text stays and nothing is drawn over it.
+        //   GA2_TEXT_OVERLAY=0   keep the GS's text
+        //   GA2_TEXT_OVERLAY_DEBUG=1   the overlay in magenta, over the picture with the text taken out
+        // The text as the GS drew it, premultiplied (colour * coverage, coverage).
+        const char *kTextLayer = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec4 tint;
+out vec4 finalColor;
+void main() {
+    float k = texture(texture0, fragTexCoord).a * tint.a;
+    finalColor = vec4(tint.rgb * k, k);
+})";
+        // mode 1: where the picture does not show the text layer (occlusion), per PS2 pixel; mode 0: the
+        // picture with the text taken out where it is not occluded: the text's footprint, half a PS2 pixel wider,
+        // filled from the surroundings (taps on four rings, weighted to where there is no text).
+        const char *kTextErase = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;  // the picture
+uniform sampler2D textLayer; // drawn upright into a render target: stored the other way up
+uniform sampler2D occlusion; // mode 0: the widened occlusion
+uniform vec2 size;
+uniform float ring;
+uniform int factor;
+uniform int mode;
+out vec4 finalColor;
+vec4 L(vec2 uv) { return texture(textLayer, vec2(uv.x, 1.0 - uv.y)); }
+// The text's coverage near uv: within a PS2 pixel (the GS's rendering of it is offset and jittered by up to that).
+float nearText(vec2 uv, float reach) {
+    float m = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x)
+            m = max(m, L(uv + vec2(x, y) * reach / size).a);
+    return m;
+}
+void main() {
+    vec2 uv = fragTexCoord;
+    vec3 f = texture(texture0, uv).rgb;
+    float halfPixel = float(factor) * 0.5;
+    // The footprint, a PS2 pixel wider.
+    float near = max(nearText(uv, halfPixel), nearText(uv, float(factor)));
+    if (near < 0.004) {
+        finalColor = mode == 0 ? vec4(f, 1.0) : vec4(0.0, 0.0, 0.0, 1.0);
+        return;
+    }
+    vec3 sum = vec3(0.0);
+    float wsum = 0.0;
+    for (int r = 1; r <= 4; ++r)
+        for (int i = 0; i < 8; ++i) {
+            float ang = 0.785398 * float(i) + 0.39 * float(r);
+            vec2 o = vec2(cos(ang), sin(ang)) * ring * float(r) / size;
+            float w = clamp(1.0 - nearText(uv + o, float(factor)) * 20.0, 0.0, 1.0);
+            if (w > 0.0) {
+                sum += w * texture(texture0, uv + o).rgb;
+                wsum += w;
+            }
+        }
+    vec3 fill = wsum > 0.0 ? sum / wsum : f;
+    if (mode == 1) {
+        // Inside the strokes (coverage k >= 0.8) a visible text pixel is T k + B (1 - k) for whatever background B,
+        // so it lies within 1 - k of T k; a menu or a fade over the text breaks that. Over the samples of one PS2
+        // pixel (the GS's own rendering has sub-pixel combs).
+        float excess = 0.0, n = 0.0;
+        float c = float(factor - 1) * 0.5;
+        for (int y = 0; y < factor; ++y)
+            for (int x = 0; x < factor; ++x) {
+                vec2 t = uv + (vec2(x, y) - c) / size;
+                vec4 lt = L(t);
+                if (lt.a >= 0.8) {
+                    // The best match within half a PS2 pixel: the GS's rendering is jittered by about that much.
+                    float best = 1.0;
+                    for (int j = -1; j <= 1; ++j)
+                        for (int i = -1; i <= 1; ++i) {
+                            vec3 d = abs(texture(texture0, t + vec2(i, j) * halfPixel / size).rgb - lt.rgb);
+                            best = min(best, max(d.r, max(d.g, d.b)));
+                        }
+                    excess += max(0.0, best - (1.0 - lt.a));
+                    n += 1.0;
+                }
+            }
+        // r: this PS2 pixel's strokes do not match; g: it has strokes to judge by.
+        finalColor = vec4(n > 0.0 && excess / n > 0.12 ? 1.0 : 0.0, n > 0.0 ? 1.0 : 0.0, 0.0, 1.0);
+        return;
+    }
+    finalColor = vec4(mix(mix(f, fill, smoothstep(0.0, 0.08, near)), f, texture(occlusion, uv).r), 1.0);
+})";
+        // The occlusion as an area vote (PS2 pixels within 3): occluded where most of the stroke pixels around do not
+        // match (a menu or a fade covers whole glyphs; a stray mismatch of the GS's own rendering does not count).
+        const char *kTextDilate = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 size;
+uniform float ring;
+out vec4 finalColor;
+void main() {
+    float bad = 0.0, judged = 0.0;
+    for (int y = -3; y <= 3; ++y)
+        for (int x = -3; x <= 3; ++x) {
+            vec2 v = texture(texture0, fragTexCoord + vec2(x, y) * ring / size).rg;
+            bad += v.r;
+            judged += v.g;
+        }
+    float occ = judged > 0.0 ? smoothstep(0.35, 0.6, bad / judged) : 0.0;
+    finalColor = vec4(vec3(occ), 1.0);
+})";
+        // A piece at the window's resolution: coverage, the piece's colour, not where occluded.
+        const char *kTextOverlay = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform sampler2D occlusion; // picture orientation
+uniform vec4 occRect;        // the quad in picture coordinates (0..1): x0, y0, x1, y1
+uniform vec4 tint;
+out vec4 finalColor;
+void main() {
+    float occ = texture(occlusion, mix(occRect.xy, occRect.zw, fragTexCoord)).r;
+    finalColor = vec4(tint.rgb, texture(texture0, fragTexCoord).a * tint.a * (1.0 - occ));
+})";
+        Shader g_textLayerShader{}, g_textEraseShader{}, g_textDilateShader{}, g_textOverlayShader{};
+        int g_textLoaded = -1;
+        RenderTexture2D g_textLayer{}, g_textOcc{}, g_textOccWide{}, g_textBg{};
+        bool g_textErased = false; // this frame's text was taken out: draw the overlay
+
+        // Textures of pieces, least recently used first.
+        struct TextureCache
+        {
+            std::list<uint64_t> order;
+            std::unordered_map<uint64_t, std::pair<Texture2D, std::list<uint64_t>::iterator>> map;
+            Texture2D *find(uint64_t key)
+            {
+                const auto it = map.find(key);
+                if (it == map.end())
+                    return nullptr;
+                order.splice(order.end(), order, it->second.second);
+                return &it->second.first;
+            }
+            Texture2D *add(uint64_t key, Texture2D texture)
+            {
+                order.push_back(key);
+                auto &slot = map[key];
+                slot = {texture, std::prev(order.end())};
+                while (order.size() > 192)
+                {
+                    const auto old = map.find(order.front());
+                    UnloadTexture(old->second.first);
+                    map.erase(old);
+                    order.pop_front();
+                }
+                return &map[key].first;
+            }
+        };
+        TextureCache g_gsPieces, g_windowPieces;
+
+        // Coverage (0..255 in alpha) as a white texture.
+        Texture2D coverageTexture(const ga2_hitext::Alpha &alpha, int scaleTo255Of)
+        {
+            ::Image image = GenImageColor(alpha.w, alpha.h, Color{255, 255, 255, 0});
+            auto *texels = static_cast<uint8_t *>(image.data);
+            for (size_t i = 0; i < alpha.a.size(); ++i)
+                texels[4 * i + 3] = uint8_t(std::min(255, int(alpha.a[i]) * 255 / scaleTo255Of));
+            Texture2D texture = LoadTextureFromImage(image);
+            UnloadImage(image);
+            SetTextureFilter(texture, TEXTURE_FILTER_BILINEAR);
+            return texture;
+        }
+
+        bool textShaders()
+        {
+            if (g_textLoaded < 0)
+            {
+                g_textLayerShader = LoadShaderFromMemory(nullptr, kTextLayer);
+                g_textEraseShader = LoadShaderFromMemory(nullptr, kTextErase);
+                g_textDilateShader = LoadShaderFromMemory(nullptr, kTextDilate);
+                g_textOverlayShader = LoadShaderFromMemory(nullptr, kTextOverlay);
+                g_textLoaded = IsShaderValid(g_textLayerShader) && IsShaderValid(g_textEraseShader) &&
+                                       IsShaderValid(g_textDilateShader) && IsShaderValid(g_textOverlayShader)
+                                   ? 1
+                                   : 0;
+                if (!g_textLoaded)
+                    std::fprintf(stderr, "[present] native text overlay shaders failed; the GS's text stays\n");
+            }
+            return g_textLoaded == 1;
+        }
+
+        // The sprite colour (0x80 = 1.0) as the GS applies it to a white coverage texture.
+        Vector4 pieceTint(const ga2_hitext::TextPiece &p)
+        {
+            auto c = [](uint8_t v) { return std::min(1.0f, float(v) / 128.0f); };
+            return Vector4{c(p.r), c(p.g), c(p.b), std::min(2.0f, float(p.a) / 128.0f)};
+        }
+
+        // The picture `frame` (2D, `factor` x 640 wide) with the text the GS drew taken out; false when not done.
+        bool eraseText(const Texture2D &frame, int factor, const std::vector<ga2_hitext::TextPiece> &pieces)
+        {
+            if (!textShaders())
+                return false;
+            const int fw = frame.width, fh = frame.height;
+            // Game 2D coordinates (640x480) to the picture's pixels: the 480 lines are shown on 448.
+            const float fx = float(factor), fy = float(fh) / 480.0f;
+            rlDrawRenderBatchActive();
+            ensureTarget(g_textLayer, fw, fh);
+            // The occlusion is decided per PS2 pixel.
+            ensureTarget(g_textOcc, fw / factor, fh / factor);
+            ensureTarget(g_textOccWide, fw / factor, fh / factor);
+            ensureTarget(g_textBg, fw, fh);
+            // 1. The text layer: each piece's GS image where the GS put it (its glyphs `inset` in, shown from there).
+            BeginTextureMode(g_textLayer);
+            ClearBackground(BLANK);
+            BeginBlendMode(BLEND_ALPHA_PREMULTIPLY);
+            BeginShaderMode(g_textLayerShader);
+            const int tintLoc = GetShaderLocation(g_textLayerShader, "tint");
+            for (const ga2_hitext::TextPiece &p : pieces)
+            {
+                if (!p.spec)
+                    continue;
+                Texture2D *texture = g_gsPieces.find(p.hash);
+                if (!texture)
+                {
+                    ga2_hitext::Alpha alpha;
+                    if (!ga2_hitext::runImage(p.hash, alpha))
+                        continue;
+                    texture = g_gsPieces.add(p.hash, coverageTexture(alpha, 256));
+                }
+                const Vector4 tint = pieceTint(p);
+                SetShaderValue(g_textLayerShader, tintLoc, &tint, SHADER_UNIFORM_VEC4);
+                const float w = float(p.spec->width), h = float(p.spec->height);
+                // The GS samples a pixel at its integer coordinates (not its centre): what it draws lands half a
+                // (game) pixel right and down of the same quad drawn here.
+                DrawTexturePro(*texture, Rectangle{0.0f, 0.0f, float(texture->width), float(texture->height)},
+                               Rectangle{(p.x0 - p.spec->insetX + 0.5f) * fx, (p.y0 - p.spec->insetY + 0.5f) * fy, w * fx, h * fy},
+                               Vector2{0, 0}, 0.0f, WHITE);
+                rlDrawRenderBatchActive(); // the tint is per piece
+            }
+            EndShaderMode();
+            EndBlendMode();
+            EndTextureMode();
