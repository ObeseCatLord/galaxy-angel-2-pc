diff --git a/ps2xIOP/tests/iop_spu31_boundaries.inc b/ps2xIOP/tests/iop_spu31_boundaries.inc
new file mode 100644
index 0000000..a54c7fd
--- /dev/null
+++ b/ps2xIOP/tests/iop_spu31_boundaries.inc
@@ -0,0 +1,347 @@
+#include "iop_compat_test_support.h"
+#include <array>
+extern bool ga2_spu31_fail_next_new;
+
+namespace ps2x::iop::detail {
+void ga2_spu31_boundary_checks() {
+  using namespace ps2x::iop::detail;
+  using iop_test::require;
+  using State = IopEmulator::Impl;
+  constexpr uint32_t base = 0x1f900000u;
+  const auto tsa = [](State &s, unsigned core, uint32_t word) {
+    s.write16(base + core * 0x400u + 0x1a8u, uint16_t(word >> 16u));
+    s.write16(base + core * 0x400u + 0x1aau, uint16_t(word));
+  };
+  const auto dma = [](State &s, unsigned core, uint32_t ram, uint32_t words32,
+                      bool write = true) {
+    const uint32_t chcr = core ? 0x1f801508u : 0x1f8010c8u;
+    s.write32(chcr - 8u, ram);
+    s.write32(chcr - 4u, (1u << 16u) | words32);
+    s.write32(chcr, write ? 0x01000201u : 0x01000200u);
+  };
+  for (unsigned core = 0; core != 2; ++core) {
+    iop_test::Host h;
+    State s(h);
+    require(!s.spu, "unused IOP does not acquire global chip");
+    std::array<uint32_t, 32> input{}, output{};
+    for (unsigned i = 0; i != input.size(); ++i)
+      input[i] = 0x51230000u + i * 0x101u;
+    require(s.writeRam(0x11000u, input.data(), sizeof(input)), "owned source");
+    require(s.writeRam(0x12000u, output.data(), sizeof(output)),
+            "owned destination");
+    tsa(s, core, 0x7000u);
+    dma(s, core, 0x11000u, 32u);
+    const uint32_t chcr = core ? 0x1f801508u : 0x1f8010c8u;
+    require(s.read32(chcr) & 0x01000000u,
+            "CHCR stays active until owner settles");
+    require(!(s.read16(base + core * 0x400u + 0x344u) & 0x80u),
+            "device busy is live");
+    s.advanceIopTime(63u);
+    s.servicePendingDmaInterrupts();
+    require(s.pendingDmaInterrupts.size() == 1u, "no early settlement");
+    s.advanceIopTime(1u);
+    s.servicePendingDmaInterrupts();
+    require(s.pendingDmaInterrupts.empty() && !(s.read32(chcr) & 0x01000000u),
+            "exact owner completion");
+    require(s.read16(base + core * 0x400u + 0x344u) & 0x80u,
+            "ready after device settlement");
+    require(!s.spu->settleOrdinaryDma(core), "cannot settle twice");
+    tsa(s, core, 0x7000u);
+    dma(s, core, 0x12000u, 32u, false);
+    require(s.readRam(0x12000u, output.data(), sizeof(output)) &&
+                input == output,
+            "actual sample RAM roundtrip through both DMA cores");
+    s.write32(chcr, 0u);
+    require(s.pendingDmaInterrupts.empty(),
+            "cancel removes authoritative deadline");
+    s.advanceIopTime(100u);
+    s.servicePendingDmaInterrupts();
+    require(!s.resetRequired, "cancelled event stays retired");
+    tsa(s, core, 0x7000u);
+    const uint16_t first = s.read16(base + core * 0x400u + 0x1acu);
+    require(first == uint16_t(input[0]),
+            "original-width DATA read actual sample");
+    require(s.read16(base + core * 0x400u + 0x1aau) == 0x7001u,
+            "halfword DATA read executes exactly once");
+    dma(s, core, 0x11000u, 32u);
+    s.reset();
+    require(!s.spu && s.pendingDmaInterrupts.empty() && h.pcmResets == 2u,
+            "reset retires device/deadline and host queue");
+    tsa(s, core, 0x7000u);
+    require(s.read16(base + core * 0x400u + 0x1acu) == 0u,
+            "cold sample RAM after reset");
+  }
+  {
+    // Original IRQ36 handler cancels/restarts due IRQ40. Its old captured
+    // completion must not settle the newer transfer.
+    iop_test::Host h;
+    State s(h);
+    std::array<uint32_t, 16> payload{};
+    require(s.writeRam(0x12000u, payload.data(), sizeof(payload)),
+            "handler DMA RAM");
+    const uint32_t code[] = {0x3c081f80u, 0xad001508u, 0x3c090100u, 0x35290201u,
+                             0xad091508u, 0x03e00008u, 0u};
+    require(s.writeRam(0x11000u, code, sizeof(code)), "actual handler code");
+    IopCpuState cpu{};
+    cpu.gpr[4] = 36u;
+    cpu.gpr[6] = 0x11000u;
+    require(s.intrman.dispatchImport(4u, cpu, s), "register actual IRQ36");
+    cpu.gpr[4] = 36u;
+    require(s.intrman.dispatchImport(6u, cpu, s), "enable actual IRQ36");
+    tsa(s, 0u, 0x7000u);
+    tsa(s, 1u, 0x7100u);
+    dma(s, 0u, 0x12000u, 16u);
+    dma(s, 1u, 0x12000u, 16u);
+    const auto oldIdentity = s.pendingDmaInterrupts.at(40).identity;
+    s.advanceIopTime(64u);
+    s.servicePendingDmaInterrupts();
+    require(!s.resetRequired && s.pendingDmaInterrupts.size() == 1u &&
+                s.pendingDmaInterrupts.at(40).identity != oldIdentity,
+            "original handler replaced due transfer identity");
+    require(!(s.read16(base + 0x744u) & 0x80u),
+            "stale completion did not settle replacement");
+    s.advanceIopTime(64u);
+    s.servicePendingDmaInterrupts();
+    require(s.pendingDmaInterrupts.empty() && (s.read16(base + 0x744u) & 0x80u),
+            "replacement settles at own deadline");
+  }
+  {
+    iop_test::Host h;
+    State s(h);
+    s.write16(base + 0x19au, 0u);
+    s.runCycles(767u);
+    require(h.pcm.empty(), "idle fractional clock retained");
+    s.runCycles(1u);
+    require(h.pcm.size() == 2u, "idle sample tick");
+    const uint32_t code[] = {0x24020001u, 0x24420001u, 0x03e00008u, 0u};
+    require(s.writeRam(0x11000u, code, sizeof(code)), "checked timing code");
+    uint32_t result = 0u;
+    require(s.executeGuestFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 100u,
+                                          result) &&
+                result == 2u,
+            "actual checked call");
+    s.runCycles(768u - (s.totalCycles % 768u));
+    require(h.pcm.size() / 2u == s.totalCycles / 768u &&
+                s.spu->lastIopCycle() == (s.totalCycles / 768u) * 768u,
+            "checked+idle partition preserves all ticks");
+    h.acceptPcm = false;
+    s.runCycles(768u);
+    require(s.resetRequired && s.spu->faulted(),
+            "host rejection halts unchecked runtime path");
+    h.acceptPcm = true;
+    s.reset();
+    require(!s.resetRequired && h.pcm.empty(),
+            "reset recovers failed device and drains PCM");
+  }
+  {
+    iop_test::Host h;
+    State s(h);
+    tsa(s, 0u, 0x7000u);
+    s.write16(base + 0x19cu, 0u);
+    s.write16(base + 0x19eu, 0x7001u);
+    s.write16(base + 0x19au, 0x40u);
+    const uint32_t bytes[] = {0x12345678u, 0x98765432u};
+    require(s.writeRam(0x11000u, bytes, sizeof(bytes)), "address IRQ source");
+    dma(s, 0u, 0x11000u, 2u);
+    s.advanceIopTime(768u);
+    require(s.memory.interruptStatus() & (1u << 9u),
+            "address IRQ distinct hardware source");
+    require(s.pendingDmaInterrupts.size() == 1u,
+            "address IRQ does not claim DMA completion");
+  }
+  {
+    iop_test::Host h;
+    State s(h);
+    const uint16_t adpcm[] = {0x0700u, 0x1234u, 0x5678u, 0x2468u,
+                              0x1357u, 0x7f00u, 0x00f7u, 0x4242u};
+    require(s.writeRam(0x12000u, adpcm, sizeof(adpcm)),
+            "authored looping ADPCM source");
+    tsa(s, 0u, 0x2800u);
+    dma(s, 0u, 0x12000u, 4u);
+    s.advanceIopTime(64u);
+    s.servicePendingDmaInterrupts();
+    for (unsigned voice : {0u, 16u}) {
+      const uint32_t reg = base + voice * 16u;
+      s.write16(reg, 0x3fffu);
+      s.write16(reg + 2u, 0x3fffu);
+      s.write16(reg + 4u, 0x1000u);
+      s.write16(reg + 6u, 0u);
+      s.write16(reg + 8u, 0u);
+      s.write16(base + 0x1c0u + voice * 12u, 0u);
+      s.write16(base + 0x1c2u + voice * 12u, 0x2800u);
+    }
+    for (uint32_t reg : {0x188u, 0x18au, 0x190u, 0x192u})
+      s.write16(base + reg, 1u);
+    s.write16(base + 0x198u, 0x0c00u);
+    s.write16(base + 0x598u, 0x000cu);
+    for (uint32_t reg : {0x760u, 0x762u, 0x788u, 0x78au, 0x790u, 0x792u})
+      s.write16(base + reg, 0x3fffu);
+    s.write16(base + 0x19au, 0u);
+    s.write16(base + 0x1a2u, 1u);
+    s.runCycles(512u * 768u);
+    require(s.read16(base + 16u * 16u + 0xau) != 0u,
+            "voice16 actually started");
+    s.write16(base + 0x1a6u, 1u);
+    s.runCycles(128u * 768u);
+    require(s.read16(base + 16u * 16u + 0xau) == 0u,
+            "voice16 actually stopped");
+    const uint32_t sh = 0xa5090000u;
+    require(s.writeRam(0x11000u, &sh, sizeof(sh)), "original SH fixture code");
+    IopCpuState cpu{};
+    cpu.pc = 0x11000u;
+    cpu.gpr[8] = base + 0x1a0u;
+    cpu.gpr[9] = 1u;
+    require(s.step(cpu), "actual CPU halfword key-on");
+    s.runCycles(512u * 768u);
+    require(s.read16(base + 0xau) != 0u &&
+                s.read16(base + 16u * 16u + 0xau) == 0u,
+            "SH starts intended voice without replaying high command shadow");
+    require(std::any_of(h.pcm.begin(), h.pcm.end(),
+                        [](int16_t x) { return x != 0; }),
+            "authored ADPCM produces actual typed PCM through IOP path");
+    const uint32_t nax =
+        (uint32_t(s.read16(base + 0x1c8u)) << 16u) | s.read16(base + 0x1cau);
+    require(nax != 0x2800u, "NAX is actual advancing device state");
+    s.write16(base + 0x1a4u, 1u);
+    s.runCycles(128u * 768u);
+    require(s.read16(base + 0xau) == 0u, "KOFF stops actual IOP voice");
+  }
+  for (unsigned failure = 0u; failure != 5u; ++failure) {
+    iop_test::Host h;
+    State s(h);
+    try {
+      if (failure == 0u)
+        s.write8(base + 0x1a0u, 1u);
+      if (failure == 1u)
+        (void)s.read8(base + 0x1acu);
+      if (failure == 2u)
+        s.write16(base + 1u, 1u);
+      if (failure == 3u)
+        dma(s, 0u, 0x11000u, 4u); // unowned
+      if (failure == 4u)
+        s.write16(base + 0x1b0u, 1u); // AutoDMA
+      require(false, "unsupported input must fail");
+    } catch (const std::exception &) {
+      require(s.resetRequired, "unsupported operation cannot report success");
+    }
+  }
+  {
+    iop_test::Host h;
+    State s(h);
+    s.write16(base + 0x19au, 0u);
+    h.beforePcm = [&] { s.reset(); };
+    s.runCycles(768u);
+    require(s.resetRequired && s.spu && s.spu->faulted(),
+            "callback cannot destroy active device");
+    h.beforePcm = {};
+    s.reset();
+    s.write16(base + 0x19au, 0u);
+    s.runCycles(768u);
+    h.acceptReset = false;
+    const auto undrained = h.pcm;
+    const unsigned beforeFailure = h.pcmResets;
+    require(!undrained.empty(), "failed drain begins with actual queued PCM");
+    try {
+      s.reset();
+      require(false, "failed host reset must fail");
+    } catch (const std::exception &) {
+      require(s.resetRequired, "failed reset remains explicit");
+    }
+    require(s.spu != nullptr && h.pcm == undrained,
+            "failed drain retains device and genuinely undrained PCM for retry");
+    h.acceptReset = true;
+    s.reset();
+    require(!s.spu && !s.resetRequired && h.pcm.empty() && h.pcmResets == beforeFailure + 2u,
+            "retry actually drains host before recovery");
+  }
+  for (bool allocationFailure : {false, true}) {
+    iop_test::Host h; State s(h);
+    const uint32_t payload[] = {0x12345678u, 0x87654321u};
+    require(s.writeRam(0x11000u, payload, sizeof(payload)), "bookkeeping failure owned DMA");
+    tsa(s, 0u, 0x7000u);
+    s.memory.write32(0x1f8010c0u, 0x11000u);
+    s.memory.write32(0x1f8010c4u, 0x00010002u);
+    s.memory.write32(0x1f8010c8u, 0x01000201u);
+    require(!(s.read16(base + 0x344u) & 0x80u), "DMA already consumed before bookkeeping injection");
+    if (allocationFailure) ga2_spu31_fail_next_new = true;
+    else s.nextCallbackIdentity = UINT64_MAX;
+    bool threw = false;
+    try { s.schedulePendingDma(); } catch (...) { threw = true; }
+    require(threw && s.resetRequired && s.pendingDmaInterrupts.empty() &&
+            !ga2_spu31_fail_next_new, "actual map allocation or identity failure latches reset");
+    const auto cycles = s.totalCycles;
+    s.runCycles(768u);
+    require(s.totalCycles == cycles && !s.servicingDmaInterrupts, "failed owner cannot resume unchecked execution");
+    s.reset();
+    require(!s.resetRequired && !s.spu, "failed bookkeeping recovers through quiescent reset");
+  }
+  {
+    iop_test::Host h; State s(h);
+    s.write16(base + 0x19au, 0u); s.runCycles(768u);
+    const auto before = h.pcm;
+    h.beforePcmReset = [&] { s.write16(base + 0x19au, 0u); };
+    bool threw = false;
+    try { s.reset(); } catch (...) { threw = true; }
+    require(threw && s.resetRequired && s.spu && h.pcm == before,
+            "host drain callback cannot reenter device or erase recovery witness");
+    h.beforePcmReset = {}; s.reset();
+    require(!s.resetRequired && !s.spu && h.pcm.empty(), "reentrant failed drain recovered");
+  }
+  {
+    iop_test::Host h; State s(h);
+    h.beforePcmReset = [&] { s.runCycles(768u); };
+    bool threw = false;
+    try { s.write16(base, 0x1234u); } catch (...) { threw = true; }
+    require(threw && s.resetRequired && s.spu && s.totalCycles == 0u && h.pcm.empty() &&
+            s.spu->lastIopCycle() == 0u && s.spu->read16(base) != 0x1234u,
+            "nonthrowing acquisition scheduler reentry cannot advance, submit or finish MMIO");
+    h.beforePcmReset = {}; s.reset();
+    s.write16(base + 0x19au, 0u);
+    h.beforePcm = [&] { s.runCycles(768u); };
+    s.runCycles(768u);
+    require(s.resetRequired && s.spu->faulted() && s.totalCycles == 768u,
+            "nonthrowing PCM scheduler reentry faults device without guest time advance");
+    h.beforePcm = {}; s.reset();
+  }
+  {
+    iop_test::Host firstHost, secondHost;
+    State second(secondHost);
+    {
+      State first(firstHost); first.write16(base + 0x19au, 0u);
+      bool threw = false;
+      try { second.write16(base + 0x19au, 0u); } catch (...) { threw = true; }
+      require(threw && second.resetRequired && !second.spu && secondHost.pcmResets == 0u,
+              "competing chip acquisition fails before draining another host");
+      first.runCycles(768u);
+      require(!first.resetRequired && firstHost.pcm.size() == 2u,
+              "failed competitor preserves original device and host");
+    }
+    second.reset(); second.write16(base + 0x19au, 0u); second.runCycles(768u);
+    require(!second.resetRequired && secondHost.pcm.size() == 2u,
+            "competing owner recovers only after actual original destruction");
+  }
+  for (unsigned teardownFailure : {0u, 1u, 2u}) {
+    const bool failedTeardown = teardownFailure != 0u;
+    iop_test::Host h;
+    {
+      State s(h); s.write16(base + 0x19au, 0u); s.runCycles(768u);
+      require(!h.pcm.empty(), "owner teardown begins with queued device PCM");
+      h.acceptReset = !failedTeardown;
+      if (teardownFailure == 2u) h.beforePcmReset = [] { throw std::runtime_error("teardown drain injection"); };
+    }
+    require(h.pcm.empty() != failedTeardown, "actual teardown honors successful or failed drain");
+    State replacement(h);
+    if (failedTeardown) {
+      const auto before = h.pcm; bool threw = false;
+      try { replacement.write16(base + 0x19au, 0u); } catch (...) { threw = true; }
+      require(threw && replacement.resetRequired && h.pcm == before,
+              "replacement cannot append to undrained previous owner's stream");
+      h.acceptReset = true; h.beforePcmReset = {}; replacement.reset();
+    }
+    replacement.write16(base + 0x19au, 0u);
+    require(h.pcm.empty(), "replacement begins with a checked clean host stream");
+    replacement.runCycles(768u);
+    require(h.pcm.size() == 2u, "replacement submits only its own PCM");
+  }
+}
+} // namespace ps2x::iop::detail
diff --git a/ps2xIOP/tests/iop_spu31_tests.cpp b/ps2xIOP/tests/iop_spu31_tests.cpp
new file mode 100644
index 0000000..b29347f
--- /dev/null
+++ b/ps2xIOP/tests/iop_spu31_tests.cpp
@@ -0,0 +1,23 @@
+#include <iostream>
+#include <cstdlib>
+#include <new>
+bool ga2_spu31_fail_next_new = false;
+void *operator new(std::size_t size) {
+  if (ga2_spu31_fail_next_new) { ga2_spu31_fail_next_new = false; throw std::bad_alloc(); }
+  if (void *p = std::malloc(size ? size : 1u)) return p;
+  throw std::bad_alloc();
+}
+void operator delete(void *p) noexcept { std::free(p); }
+void operator delete(void *p, std::size_t) noexcept { std::free(p); }
+namespace ps2x::iop::detail {
+void ga2_spu31_boundary_checks();
+}
+int main() {
+  try {
+    ps2x::iop::detail::ga2_spu31_boundary_checks();
+    std::cout << "SPU31 integration checks passed\n";
+  } catch (const std::exception &e) {
+    std::cerr << e.what() << '\n';
+    return 1;
+  }
+}
