+  require(run(s,4,1,0x100)==code&&s.memory.ownsRamRange(code,0x100),"same address not reused owned");
+  s.runCycles(1000001);require(!s.resetRequired&&s.memory.read32(0x13100)==0&&s.pendingGuestCallbacks.empty(),"reused backing revived retired alarm");
+  s.reset();prepare(s);require(run(s,7)==H&&run(s,8)==H,"reset did not restore queries");
+  require(!s.memory.ownsRamRange(code,4),"reset retained reused backing ownership");
+  std::cout<<"PASS MIPS retirement/reuse and cold reset\n";
+ }
+ return true;
+}
+}
