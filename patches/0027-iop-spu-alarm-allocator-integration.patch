+        // Derived from the existing allocation vector; no second free-space state.
+        template <class Visitor>
+        bool visitFreeExtents(std::span<const IopMemory::Allocation> blocks, Visitor &&visitor)
+        {
+            uint32_t cursor = IopMemory::HeapBase;
+            while (cursor < IopMemory::HeapLimit)
+            {
+                uint32_t nextStart = IopMemory::HeapLimit;
+                uint32_t nextEnd = IopMemory::HeapLimit;
+                bool covered = false;
+                for (const auto &block : blocks)
+                {
+                    const uint64_t end = uint64_t(block.address) + block.size;
+                    if (block.size == 0u || block.address < IopMemory::HeapBase || end > IopMemory::HeapLimit)
+                        return false;
+                    if (block.address <= cursor && cursor < end)
+                    {
+                        cursor = uint32_t(end);
+                        covered = true;
+                        break;
+                    }
+                    if (block.address > cursor && block.address < nextStart)
+                    {
+                        nextStart = block.address;
+                        nextEnd = uint32_t(end);
+                    }
+                }
+                if (covered)
+                    continue;
+                if (cursor < nextStart && !visitor(cursor, nextStart))
+                    return true;
+                cursor = nextEnd;
+            }
+            return true;
+        }
+
+        uint64_t alignUpChecked(uint32_t value, uint32_t alignment)
+        {
+            return (uint64_t(value) + alignment - 1u) & ~(uint64_t(alignment) - 1u);
+        }
     }
 
