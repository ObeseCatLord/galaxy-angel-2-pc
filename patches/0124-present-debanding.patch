+        // GA2_DEBAND_DUMP=<dir> (a developer aid): every 300th presented frame, the picture before and after the
+        // debanding pass is written as <dir>/plain-<n>.ppm and deband-<n>.ppm (8-bit, at the picture's resolution).
+        void dumpPicture(unsigned texture, int width, int height, const std::string &path)
+        {
+            std::vector<float> pixels(size_t(width) * size_t(height) * 4u);
+            glBindTexture(GL_TEXTURE_2D, texture);
+            glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_FLOAT, pixels.data());
+            std::vector<unsigned char> rgb(size_t(width) * size_t(height) * 3u);
+            for (size_t i = 0; i < size_t(width) * size_t(height); ++i)
+                for (size_t c = 0; c < 3; ++c)
+                    rgb[i * 3 + c] = (unsigned char)std::lround(std::clamp(pixels[i * 4 + c], 0.0f, 1.0f) * 255.0f);
+            if (std::FILE *f = std::fopen(path.c_str(), "wb"))
+            {
+                std::fprintf(f, "P6\n%d %d\n255\n", width, height);
+                std::fwrite(rgb.data(), 1, rgb.size(), f);
+                std::fclose(f);
+            }
+        }
+
+        // Builds (or drops) the debanding pass for a level; the GL objects of the old one are freed first.
+        void loadDeband(int level)
+        {
+            if (g_deband)
+                g_deband->release();
+            g_deband.reset();
+            g_debandLevel = level;
+            if (level > 0)
