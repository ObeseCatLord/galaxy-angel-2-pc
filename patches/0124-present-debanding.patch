+                g_deband = std::make_unique<ga2_mpv::Chain>();
+                std::string error;
+                if (!g_deband->add(debandShader(level), "deband", error))
+                {
+                    std::fprintf(stderr, "[present] deband: %s\n", error.c_str());
+                    g_deband.reset();
+                }
+            }
+            if (level > 0 && !g_ditherLoaded)
+            {
+                g_dither = LoadShaderFromMemory(nullptr, kDither);
+                g_ditherLoaded = IsShaderValid(g_dither);
+            }
+            std::fprintf(stderr, "[present] debanding: %s\n", level == 0 ? "off" : level == 1 ? "low" : "high");
+        }
