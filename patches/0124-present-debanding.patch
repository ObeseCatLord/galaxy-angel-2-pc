+        // A debanded picture is a float image: drawing it to the 8-bit window re-quantizes it, and the smooth
+        // ramps would band again. Noise of +-0.45 of an 8-bit step added at the window's own pixels (before the
+        // rounding) breaks the steps up; a pixel the pass left alone is an exact 8-bit value and stays unchanged.
+        const char *kDither = R"(#version 330
+in vec2 fragTexCoord;
+in vec4 fragColor;
+uniform sampler2D texture0;
+uniform vec4 colDiffuse;
+uniform float ditherAmount;
+uniform int ditherSeed;
+out vec4 finalColor;
+void main() {
+    finalColor = texture(texture0, fragTexCoord) * fragColor * colDiffuse;
+    uint q = uint(gl_FragCoord.x) * 1973u + uint(gl_FragCoord.y) * 9277u + uint(ditherSeed) * 26699u;
+    q = (q ^ (q >> 15u)) * 2246822519u; q = (q ^ (q >> 13u)) * 3266489917u; q ^= q >> 16u;
+    finalColor.rgb += (float(q) * (1.0 / 4294967296.0) - 0.5) * ditherAmount / 255.0;
+}
+)";
+
+        // Debanding, an mpv-style user shader run on the picture at its own resolution (before the window scales
+        // it). A sparse edge-preserving average: every pixel looks at a few neighbours at random angles and
+        // distances (and the ones 90 degrees round from them), and averages with those that are within the
+        // threshold of its own colour in every channel. The steps of 16-bit colour (8/255 per channel) are within
+        // the threshold, so a band edge is averaged with the next band over about the radius; a real edge (text,
+        // lines, sprites, texture detail) is far above it and is never mixed. The radius is given for a 448-line
+        // picture and grows with the picture's height, so 4x internal resolution smooths as wide as native. The
+        // taps are fixed per pixel (no shimmer); texelFetch keeps them to real pixels (no bilinear blur).
+        struct DebandLevel
+        {
+            float threshold; // per channel, 0..1 (one 5-bit colour step is 0.031)
+            float radius;    // pixels at 448 lines
+            int iterations;  // random distances; four taps each
+        };
+        const DebandLevel kDebandLevels[2] = {{0.036f, 20.0f, 2}, {0.045f, 40.0f, 4}};
+
+        const char *kDebandBody = R"(
+uint pcg(uint v) {
+    uint s = v * 747796405u + 2891336277u;
+    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
+    return (w >> 22u) ^ w;
+}
+float rnd(inout uint state) {
+    state = pcg(state);
+    return float(state) * (1.0 / 4294967296.0);
+}
+vec4 hook() {
+    ivec2 size = ivec2(HOOKED_size);
+    ivec2 p = min(ivec2(HOOKED_pos * HOOKED_size), size - 1);
+    vec4 c0 = texelFetch(HOOKED_raw, p, 0);
+    float radius = DB_RADIUS * HOOKED_size.y * (1.0 / 448.0);
+    uint state = pcg(uint(p.x) + pcg(uint(p.y)));
+    vec3 sum = c0.rgb;
+    float count = 1.0;
+    for (int i = 0; i < DB_ITER; ++i) {
+        float d = max(1.0, radius * (float(i) + rnd(state)) / float(DB_ITER));
+        float a = rnd(state) * 6.2831853;
+        ivec2 o = ivec2(round(d * vec2(cos(a), sin(a))));
+        ivec2 q = ivec2(-o.y, o.x);
+        ivec2 taps[4] = ivec2[4](p + o, p - o, p + q, p - q);
+        for (int k = 0; k < 4; ++k) {
+            vec3 t = texelFetch(HOOKED_raw, clamp(taps[k], ivec2(0), size - 1), 0).rgb;
+            vec3 df = abs(t - c0.rgb);
+            if (max(df.r, max(df.g, df.b)) < DB_THRESHOLD) {
+                sum += t;
+                count += 1.0;
+            }
+        }
+    }
+    return vec4(sum / count, c0.a);
+}
+)";
+
+        std::string debandShader(int level)
+        {
+            const DebandLevel &l = kDebandLevels[std::max(1, std::min(level, 2)) - 1];
+            char defines[200];
+            std::snprintf(defines, sizeof(defines), "#define DB_THRESHOLD %.4f\n#define DB_RADIUS %.2f\n#define DB_ITER %d\n",
+                          l.threshold, l.radius, l.iterations);
+            return std::string("//!DESC GA2 deband\n//!HOOK MAIN\n//!BIND HOOKED\n") + defines + kDebandBody;
+        }
