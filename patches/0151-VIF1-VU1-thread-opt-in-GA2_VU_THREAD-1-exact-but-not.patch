+#include "runtime/ga2_vuthread.h"
 #include "runtime/gs/gs_cpu_backend.h"
 #include "ps2_log.h"
 #include "runtime/ps2_memory.h"
@@ -1654,6 +1655,15 @@ bool GS::clearActiveFramebuffer(uint32_t rgba)
