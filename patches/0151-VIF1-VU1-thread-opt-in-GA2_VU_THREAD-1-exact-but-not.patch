new file mode 100644
index 0000000..2f0f3c1
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_vuthread.h
@@ -0,0 +1,65 @@
+// VIF1 and VU1 on their own thread (as PCSX2's MTVU). The game thread walks DMA as before and completes it at once;
+// what VIF1 and PATH3 receive (copied, so the EE may reuse its buffers) goes to this thread as one job per DMA pass:
+// PATH3 packets, VIF1 unpack/MPG/MSCAL (VU1 runs and its XGKICK packets) and the GIF arbiter's drain, in the order
+// the game thread used to run them. VIF1 state, VU1 memory and registers and the PATH3 mask then belong to this
+// thread; everything the EE can observe of them waits for it first (sync()): VU1 memory accesses, the GIF/VIF
+// registers and FIFOs, GIF packets from elsewhere, the native GIF fast paths, VIF1 downloads, the GS entries and the
+// paraLLEl-GS readback. The frame tick's scan-out marker goes through the same queue (postTick), so it follows the
+// frame's VU packets; the EE stays at most a frame ahead. Started by the runtime with the GS worker when
+// GA2_VU_THREAD=1 (off by default). A pass whose GIF data raises CSR bits is split at that packet's DIRECT: the VU
+// thread takes what comes before, the game thread waits for it and runs the rest, so SIGNAL/FINISH and their
+// interrupts keep their EE timing. The GA2 games end every frame's VIF1 chain with such a FINISH, which puts the VU
+// work back on the game thread's critical path: measured slower than without the thread (see ps2_runtime.cpp).
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <vector>
+
+namespace ga2_vuthread
+{
+    // owner: the PS2Memory whose VIF1/VU1 the thread runs (other instances, e.g. in tests, are not affected).
+    void start(const void *owner);
+    void stop();
+    // True when the thread runs for `owner` and the caller is not that thread (nor the GS worker, which never waits
+    // for it): such a caller hands work over or syncs.
+    bool active(const void *owner);
+    bool onWorker();
+    // Runs `job` on the thread after everything posted before it.
+    void post(std::function<void()> job);
+    // The same for a frame tick: at most one tick waits or runs (the next waits for it).
+    void postTick(std::function<void()> job);
+    // Returns once everything posted so far has run. No-op on the thread itself and on the GS worker.
+    void sync();
+    // Whether this DMA pass may go to the thread (false: run it inline after sync()). Set by the runtime: VU1 D/T
+    // stop bits enabled (the EE would read VPU_STAT) keep the work on the game thread.
+    void setPostGuard(std::function<bool()> guard);
+    bool mayPost();
+
+    // Whether GIF data writes, by A+D, a register whose effect the EE sees at once (SIGNAL, FINISH, LABEL, the display
+    // registers 0x59-0x5F), or holds REGLIST A+D: such a pass stays on the game thread so CSR bits and the GS interrupt
+    // keep their EE timing. (Same rule as GifArbiter's inline packets.)
+    bool gifRaisesCsr(const uint8_t *data, uint32_t sizeBytes);
+    // The same for VIF1 data: the GIF data inside its DIRECT/DIRECTHL commands. The scan mirrors the VIF1 parser's
+    // sizes on the game thread (cycle and the DIRECT bytes still to come are its state, copied from the real VIF1 state
+    // whenever the EE has synced and written a VIF register; `carry` holds an unfinished DIRECT's GIF bytes).
+    struct Vif1Scan
+    {
+        uint32_t cycle = 0; // VIF1 CYCLE (STCYCL): an UNPACK's length depends on it
+        uint32_t directPending = 0;
+        std::vector<uint8_t> carry;
+        // Where the DIRECT being collected began (chunk index as passed, byte offset of its command), and once one is
+        // found to raise CSR bits, that position: the pass can go to the VU thread up to there.
+        uint32_t directChunk = 0, directOffset = 0;
+        uint32_t hitChunk = 0, hitOffset = 0;
+    };
+    // True when the chunk (index `chunk` of the pass) completes a DIRECT that raises CSR bits; scan.hitChunk/hitOffset
+    // then point at that DIRECT's command. Scanning stops there.
+    bool vif1RaisesCsr(Vif1Scan &scan, uint32_t chunk, const uint8_t *data, uint32_t sizeBytes);
+
+    // Busy time of the worker threads (nanoseconds, cumulative), for the frame-rate governor's load: the VU thread's
+    // jobs and the GS worker's batches (GifArbiter adds its own).
+    uint64_t busyNanos();
+    void addGsBusyNanos(uint64_t nanos);
+    uint64_t gsBusyNanos();
+}
