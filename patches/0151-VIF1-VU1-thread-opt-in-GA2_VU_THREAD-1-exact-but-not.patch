diff --git a/ps2xRuntime/src/lib/ga2_vuthread.cpp b/ps2xRuntime/src/lib/ga2_vuthread.cpp
new file mode 100644
index 0000000..f8c76a5
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_vuthread.cpp
@@ -0,0 +1,339 @@
+#include "runtime/ga2_vuthread.h"
+#include "runtime/gs/ps2_gif_arbiter.h"
+#include "ThreadNaming.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace
+{
+    thread_local bool t_onVuWorker = false;
+
+    struct Worker
+    {
+        std::thread thread;
+        std::mutex mutex;
+        std::condition_variable work, idle;
+        std::deque<std::function<void()>> jobs;
+        bool sleeping = false, stopping = false;
+        uint64_t posted = 0, ticksPosted = 0;
+        std::atomic<uint64_t> done{0}, ticksDone{0};
+        std::atomic<const void *> owner{nullptr};
+        std::atomic<bool> running{false};
+        std::atomic<uint64_t> busy{0}, gsBusy{0};
+        std::function<bool()> guard;
+    };
+
+    Worker &worker()
+    {
+        static Worker *w = new Worker; // outlives static destruction: the thread may still be stopping
+        return *w;
+    }
+
+    void loop()
+    {
+        t_onVuWorker = true;
+        ThreadNaming::SetCurrentThreadName("VUWorker");
+        Worker &w = worker();
+        std::unique_lock<std::mutex> lock(w.mutex);
+        std::deque<std::function<void()>> batch;
+        for (;;)
+        {
+            w.sleeping = true;
+            w.work.wait(lock, [&] { return !w.jobs.empty() || w.stopping; });
+            w.sleeping = false;
+            if (w.jobs.empty())
+                break;
+            batch.swap(w.jobs);
+            lock.unlock();
+            const auto t0 = std::chrono::steady_clock::now();
+            uint64_t count = 0;
+            for (auto &job : batch)
+            {
+                try
+                {
+                    job();
+                }
+                catch (const std::exception &e)
+                {
+                    std::fprintf(stderr, "[vu thread] job failed: %s\n", e.what());
+                }
+                catch (...)
+                {
+                    std::fprintf(stderr, "[vu thread] job failed\n");
+                }
+                ++count;
+            }
+            batch.clear();
+            w.busy.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - t0).count()),
+                             std::memory_order_relaxed);
+            lock.lock();
+            w.done.fetch_add(count, std::memory_order_release);
+            w.idle.notify_all();
+        }
+    }
+
+    void push(std::function<void()> job)
+    {
+        Worker &w = worker();
+        std::lock_guard<std::mutex> lock(w.mutex);
+        w.jobs.push_back(std::move(job));
+        ++w.posted;
+        if (w.sleeping)
+            w.work.notify_one();
+    }
+}
+
+namespace ga2_vuthread
+{
+    void start(const void *owner)
+    {
+        Worker &w = worker();
+        if (w.running.load())
+            return;
+        w.stopping = false;
+        w.owner.store(owner);
+        w.running.store(true);
+        w.thread = std::thread(loop);
+    }
+
+    void stop()
+    {
+        Worker &w = worker();
+        if (!w.running.load())
+            return;
+        {
+            std::lock_guard<std::mutex> lock(w.mutex);
+            w.stopping = true;
+            w.work.notify_one();
+        }
+        if (w.thread.joinable())
+            w.thread.join();
+        w.running.store(false);
+        w.owner.store(nullptr);
+    }
+
+    bool onWorker() { return t_onVuWorker; }
+
+    bool active(const void *owner)
+    {
+        Worker &w = worker();
+        return w.running.load(std::memory_order_acquire) && w.owner.load(std::memory_order_relaxed) == owner && !t_onVuWorker &&
+               !GifArbiter::onWorkerThread();
+    }
+
+    void post(std::function<void()> job)
+    {
+        if (!worker().running.load() || t_onVuWorker)
+        {
+            job();
+            return;
+        }
+        push(std::move(job));
+    }
+
+    void postTick(std::function<void()> job)
+    {
+        Worker &w = worker();
+        if (!w.running.load() || t_onVuWorker)
+        {
+            job();
+            return;
+        }
+        // At most one tick in the queue: wait for the previous one to run.
+        {
+            std::unique_lock<std::mutex> lock(w.mutex);
+            w.idle.wait(lock, [&] { return w.ticksDone.load(std::memory_order_acquire) >= w.ticksPosted; });
+            ++w.ticksPosted;
+        }
+        push([job = std::move(job)] {
+            job();
+            Worker &w2 = worker();
+            {
+                std::lock_guard<std::mutex> lock(w2.mutex);
+                w2.ticksDone.fetch_add(1, std::memory_order_release);
+            }
+            w2.idle.notify_all();
+        });
+    }
+
+    void sync()
+    {
+        Worker &w = worker();
+        if (!w.running.load(std::memory_order_acquire) || t_onVuWorker || GifArbiter::onWorkerThread())
+            return;
+        std::unique_lock<std::mutex> lock(w.mutex);
+        const uint64_t target = w.posted;
+        w.idle.wait(lock, [&] { return w.done.load(std::memory_order_acquire) >= target; });
+    }
+
+    void setPostGuard(std::function<bool()> guard) { worker().guard = std::move(guard); }
+
+    bool mayPost()
+    {
+        const auto &guard = worker().guard;
+        return !guard || guard();
+    }
+
+    uint64_t busyNanos() { return worker().busy.load(std::memory_order_relaxed); }
+    void addGsBusyNanos(uint64_t nanos) { worker().gsBusy.fetch_add(nanos, std::memory_order_relaxed); }
+    uint64_t gsBusyNanos() { return worker().gsBusy.load(std::memory_order_relaxed); }
+}
+
+namespace ga2_vuthread
+{
+    bool gifRaisesCsr(const uint8_t *data, uint32_t sizeBytes)
+    {
+        uint32_t offset = 0u;
+        while (offset + 16u <= sizeBytes)
+        {
+            uint64_t tagLo = 0, tagHi = 0;
+            std::memcpy(&tagLo, data + offset, sizeof(tagLo));
+            std::memcpy(&tagHi, data + offset + 8u, sizeof(tagHi));
+            offset += 16u;
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
+            uint32_t nreg = static_cast<uint32_t>((tagLo >> 60) & 0xFu);
+            if (nreg == 0u)
+                nreg = 16u;
+            uint32_t adMask = 0u;
+            for (uint32_t r = 0; r < nreg; ++r)
+                if (((tagHi >> (r * 4u)) & 0xFu) == 0xEu)
+                    adMask |= 1u << r;
+            uint64_t bytes = 0u;
+            if (flg == 0u)
+            {
+                bytes = uint64_t(nloop) * nreg * 16u;
+                if (adMask != 0u)
+                {
+                    const uint64_t end = std::min<uint64_t>(sizeBytes, offset + bytes);
+                    uint32_t r = 0;
+                    for (uint64_t q = offset; q + 16u <= end; q += 16u)
+                    {
+                        if (adMask & (1u << r))
+                        {
+                            const uint8_t addr = data[q + 8u];
+                            if (addr >= 0x59u && addr <= 0x62u)
+                                return true;
+                        }
+                        if (++r == nreg)
+                            r = 0;
+                    }
+                }
+            }
+            else if (flg == 1u)
+            {
+                if (adMask != 0u)
+                    return true;
+                bytes = (uint64_t(nloop) * nreg * 8u + 15u) & ~uint64_t(15u);
+            }
+            else if (flg == 2u)
+                bytes = uint64_t(nloop) * 16u;
+            if (bytes > sizeBytes - offset)
+                return false;
+            offset += static_cast<uint32_t>(bytes);
+        }
+        return false;
+    }
+
+    // Mirrors processVIF1Data's command sizes and stops (ps2_vif1_interpreter.cpp): only DIRECT continues across
+    // chunks, and an UNPACK's length follows STCYCL, which the scan tracks from the stream.
+    bool vif1RaisesCsr(Vif1Scan &scan, uint32_t chunk, const uint8_t *data, uint32_t sizeBytes)
+    {
+        bool found = false;
+        uint32_t pos = 0;
+        while (pos < sizeBytes)
+        {
+            if (scan.directPending != 0u)
+            {
+                const uint32_t bytes = std::min(scan.directPending, sizeBytes - pos);
+                scan.carry.insert(scan.carry.end(), data + pos, data + pos + bytes);
+                pos += bytes;
+                scan.directPending -= bytes;
+                if (scan.directPending == 0u)
+                {
+                    found = gifRaisesCsr(scan.carry.data(), static_cast<uint32_t>(scan.carry.size()));
+                    scan.carry.clear();
+                    if (found)
+                    {
+                        scan.hitChunk = scan.directChunk;
+                        scan.hitOffset = scan.directOffset;
+                        return true;
+                    }
+                }
+                continue;
+            }
+            if (sizeBytes - pos < 4u)
+                break;
+            uint32_t cmd;
+            std::memcpy(&cmd, data + pos, 4);
+            pos += 4;
+            const uint8_t opcode = (cmd >> 24) & 0x7F;
+            const uint16_t imm = cmd & 0xFFFF;
+            const uint8_t num = (cmd >> 16) & 0xFF;
+            if (opcode == 0x01) // STCYCL
+                scan.cycle = imm;
+            else if (opcode == 0x20) // STMASK
+            {
+                if (pos + 4 > sizeBytes)
+                    break;
+                pos += 4;
+            }
+            else if (opcode == 0x30 || opcode == 0x31) // STROW, STCOL
+            {
+                if (pos + 16 > sizeBytes)
+                    break;
+                pos += 16;
+            }
+            else if (opcode == 0x4A) // MPG
+            {
+                pos += ((num == 0u) ? 256u : uint32_t(num)) * 8u;
+                if (pos > sizeBytes)
+                    break;
+            }
+            else if (opcode == 0x50 || opcode == 0x51) // DIRECT, DIRECTHL
+            {
+                scan.directPending = (imm == 0u ? 65536u : uint32_t(imm)) * 16u;
+                scan.directChunk = chunk;
+                scan.directOffset = pos - 4u;
+            }
+            else if ((opcode & 0x60) == 0x60) // UNPACK
+            {
+                const uint32_t vn = (opcode >> 2) & 0x3, vl = opcode & 0x3;
+                const uint32_t bitsPerComponent = vl == 0 ? 32 : vl == 1 ? 16 : vl == 2 ? 8 : (vn == 3 ? 4 : 16);
+                const uint32_t bitsPerVector = (vl == 3 && vn == 3) ? 16 : (vn + 1) * bitsPerComponent;
+                const uint32_t bytesPerVector = (bitsPerVector + 7) / 8;
+                const uint32_t writeVectorCount = (num == 0u) ? 256u : uint32_t(num);
+                uint32_t cl = scan.cycle & 0xFFu, wl = (scan.cycle >> 8) & 0xFFu;
+                if (cl == 0u)
+                    cl = 1u;
+                if (wl == 0u)
+                    wl = 1u;
+                uint32_t sourceVectorCount = writeVectorCount;
+                if (cl < wl)
+                {
+                    uint32_t remainder = writeVectorCount % wl;
+                    if (remainder > cl)
+                        remainder = cl;
+                    sourceVectorCount = (writeVectorCount / wl) * cl + remainder;
+                }
+                const uint32_t totalBytes = (sourceVectorCount * bytesPerVector + 3) & ~3u;
+                pos += totalBytes;
+                if (pos > sizeBytes)
+                    break;
+            }
+            // every other command is the 4 bytes read
+        }
+        return found;
+    }
+}
