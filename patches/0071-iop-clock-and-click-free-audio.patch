diff --git a/ps2xIOP/tests/iop_emulator_tests.cpp b/ps2xIOP/tests/iop_emulator_tests.cpp
index fd237d5..c21af9d 100644
--- a/ps2xIOP/tests/iop_emulator_tests.cpp
+++ b/ps2xIOP/tests/iop_emulator_tests.cpp
@@ -1,4 +1,5 @@
 #include "ps2x/iop/iop_subsystem.h"
+#include "emulator/iop_emulator.h"
 
 #include <algorithm>
 #include <chrono>
@@ -1141,6 +1142,26 @@ int main()
     if (!expect(!emittedUnhandledSeek,
                 "sceCdSeek still emitted an unhandled IOP import")) return 1;
 
+    // IOP time follows the EE clock: time the IOP runs on its own (module
+    // start, RPC waits, slice overshoot) is repaid by later EE time rather
+    // than added to it, so the SPU's 48 kHz matches real time.
+    host.logs.clear();
+    ps2x::iop::detail::IopEmulator emulator(host);
+    writeCdvdSeekIrx(host, 0x100u);
+    (void)emulator.loadModuleBuffer(0x100u, nullptr, 0u);
+    const uint64_t lead = emulator.cycles();
+    if (!expect(lead > 0u && lead < 65536u, "module start did not run the IOP ahead of the EE clock")) return 1;
+    emulator.runEeCycles(8u * (lead / 2u));
+    if (!expect(emulator.cycles() == lead, "EE time did not repay the IOP lead")) return 1;
+    uint64_t eeClock = lead / 2u;
+    for (int n = 0; n < 4096; ++n)
+    {
+        emulator.runEeCycles(8u * 7u);
+        eeClock += 7u;
+    }
+    if (!expect(emulator.cycles() >= eeClock && emulator.cycles() < eeClock + 256u,
+                "IOP time drifted from the EE clock")) return 1;
+
     std::cout << "ps2xIOP emulator smoke tests passed\n";
     return 0;
 }
