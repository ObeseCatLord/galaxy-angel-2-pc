diff --git a/ps2xRuntime/src/lib/ps2_pcm_queue.h b/ps2xRuntime/src/lib/ps2_pcm_queue.h
index 5867d5f..daa5110 100644
--- a/ps2xRuntime/src/lib/ps2_pcm_queue.h
+++ b/ps2xRuntime/src/lib/ps2_pcm_queue.h
@@ -6,15 +6,22 @@
 #include <cstdint>
 #include <span>
 
-// Serialized by the backend callback-owner mutex. Samples always stay stereo.
+// SPU output (producer: IOP time) to the audio device (consumer: device
+// clock). Rate control keeps the backlog near SteadyLevelFrames; nothing is
+// ever cut mid-waveform, since every cut is an audible click:
+// - an underrun fades out over FadeFrames, then waits until the backlog is
+//   back at the steady level and fades in again;
+// - a backlog past TargetLatencyFrames (a long burst) skips the excess with
+//   a FadeFrames crossfade.
 class SpuPcmQueue
 {
 public:
     static constexpr size_t CapacityFrames = 96000;
-    // Host output latency is bounded: when the producer runs ahead of the
-    // audio device, the oldest queued frames are dropped instead of rejecting
-    // the new ones (a rejection used to fault the whole IOP).
-    static constexpr size_t TargetLatencyFrames = 7200; // 150 ms at 48 kHz
+    static constexpr size_t TargetLatencyFrames = 24000; // 500 ms at 48 kHz: skip beyond this
+    static constexpr size_t SteadyLevelFrames = 3600;    // 75 ms
+    static constexpr size_t FadeFrames = 96;             // 2 ms
+    static constexpr double MaxRateDeviation = 0.005;    // proportional part
+    static constexpr double MaxDriftCorrection = 0.005;  // integral part
     bool push(std::span<const int16_t> samples)
     {
         if (samples.size() % 2u)
@@ -22,53 +29,66 @@ public:
         if (samples.size() / 2u > CapacityFrames)
             samples = samples.last(CapacityFrames * 2u);
         const size_t incoming = samples.size() / 2u;
-        if (m_count + incoming > TargetLatencyFrames)
+        if (m_count + incoming > CapacityFrames)
         {
-            const size_t drop = std::min(m_count, m_count + incoming - TargetLatencyFrames);
+            const size_t drop = m_count + incoming - CapacityFrames;
             m_head = (m_head + drop) % CapacityFrames;
             m_count -= drop;
             m_dropped += drop;
         }
-        for (size_t i = 0; i < samples.size() / 2u; ++i)
+        for (size_t i = 0; i < incoming; ++i)
         {
             const size_t p = ((m_head + m_count + i) % CapacityFrames) * 2u;
             m_samples[p] = samples[2u*i]; m_samples[p+1u] = samples[2u*i+1u];
         }
-        m_count += samples.size() / 2u;
+        m_count += incoming;
+        m_pushed += incoming;
+        if (m_count > TargetLatencyFrames)
+            skipWithCrossfade(m_count - SteadyLevelFrames);
+        m_peak = std::max(m_peak, m_count);
         return true;
     }
-    // The producer is paced by guest vblanks and the device by its own
-    // crystal; a steady difference would turn into periodic drops at the
-    // latency bound or zero-filled gaps. Consumption runs up to 0.5% faster
-    // or slower to hold the queue near half the bound, interpolating between
-    // frames (exact at the nominal rate). Underruns still zero-fill.
-    static constexpr size_t SteadyLevelFrames = TargetLatencyFrames / 2u;
-    static constexpr double MaxRateDeviation = 0.005;
     void consume(std::span<int16_t> output)
     {
         std::fill(output.begin(), output.end(), int16_t{});
-        const double error = (static_cast<double>(m_count) - SteadyLevelFrames) / SteadyLevelFrames;
-        const double step = 1.0 + std::clamp(error * MaxRateDeviation, -MaxRateDeviation, MaxRateDeviation);
         const size_t frames = output.size() / 2u;
+        m_played += frames;
         size_t written = 0;
+        if (!m_playing)
+        {
+            written = fadeOut(output, 0);
+            if (m_count < SteadyLevelFrames)
+            {
+                if (m_started)
+                    m_underrunFrames += frames - written;
+                return;
+            }
+            // Fade in after an underrun; the very first start is exact.
+            m_gain = m_started ? 0.0 : 1.0;
+            m_playing = m_started = true;
+            m_phase = 0.0;
+        }
+        // Rate control on a smoothed level (pushes arrive in bursts): a
+        // proportional term plus a slow integral that learns the clock drift.
+        const double alpha = std::min(1.0, double(frames) / 4800.0);
+        m_level += (double(m_count) - m_level) * alpha;
+        const double error = std::clamp((m_level - double(SteadyLevelFrames)) / double(SteadyLevelFrames), -1.0, 1.0);
+        m_drift = std::clamp(m_drift + error * DriftGain * double(frames), -MaxDriftCorrection, MaxDriftCorrection);
+        const double step = 1.0 + error * MaxRateDeviation + m_drift;
         for (; written < frames; ++written)
         {
             const size_t index = static_cast<size_t>(m_phase);
             const double fraction = m_phase - static_cast<double>(index);
-            if (index + (fraction != 0.0 ? 1u : 0u) >= m_count)
+            if (index + 1u >= m_count)
                 break; // underrun
+            m_gain = std::min(1.0, m_gain + 1.0 / FadeFrames);
             const size_t a = ((m_head + index) % CapacityFrames) * 2u;
-            if (fraction == 0.0)
-            {
-                output[2u*written] = m_samples[a];
-                output[2u*written+1u] = m_samples[a+1u];
-            }
-            else
+            const size_t b = ((m_head + index + 1u) % CapacityFrames) * 2u;
+            for (size_t c = 0; c < 2u; ++c)
             {
-                const size_t b = ((m_head + index + 1u) % CapacityFrames) * 2u;
-                for (size_t c = 0; c < 2u; ++c)
-                    output[2u*written+c] = static_cast<int16_t>(std::lround(
-                        m_samples[a+c] + (m_samples[b+c] - m_samples[a+c]) * fraction));
+                const double v = m_samples[a+c] + (m_samples[b+c] - m_samples[a+c]) * fraction;
+                m_last[c] = v * m_gain;
+                output[2u*written+c] = static_cast<int16_t>(std::lround(m_last[c]));
             }
             m_phase += step;
         }
@@ -78,26 +98,87 @@ public:
         m_phase -= static_cast<double>(consumed);
         if (written < frames)
         {
-            m_phase = 0.0; // restart cleanly after an underrun
-            if (m_started)
-            {
-                ++m_underruns;
-                m_underrunFrames += frames - written;
-            }
+            // Ran dry: fade the last sample out instead of cutting to zero,
+            // then refill before playing again.
+            m_playing = false;
+            m_fade = FadeFrames;
+            ++m_underruns;
+            m_underrunFrames += frames - written;
+            fadeOut(output, written);
         }
-        m_started = m_started || written > 0;
     }
-    void clear() noexcept { m_head = m_count = 0; m_phase = 0.0; }
+    void clear() noexcept
+    {
+        m_head = m_count = 0;
+        m_phase = 0.0;
+        m_playing = false;
+        m_started = false;
+        m_fade = 0;
+        m_level = double(SteadyLevelFrames);
+    }
     size_t queuedFrames() const noexcept { return m_count; }
     uint64_t droppedFrames() const noexcept { return m_dropped; }
-    // Device callbacks that ran out of queued audio (after the first sound)
-    // and the frames they zero-filled.
+    uint64_t skippedFrames() const noexcept { return m_skipped; }
     uint64_t underruns() const noexcept { return m_underruns; }
     uint64_t underrunFrames() const noexcept { return m_underrunFrames; }
+    uint64_t pushedFrames() const noexcept { return m_pushed; }
+    uint64_t playedFrames() const noexcept { return m_played; }
+    double driftCorrection() const noexcept { return m_drift; }
+    size_t takePeak() noexcept { const size_t p = m_peak; m_peak = m_count; return p; }
 private:
+    // The integral reaches 0.5% after ~10 s at full error.
+    static constexpr double DriftGain = MaxDriftCorrection / (48000.0 * 10.0);
+
+    // Continue a fade-out of the last played sample; returns the frames written.
+    size_t fadeOut(std::span<int16_t> output, size_t at)
+    {
+        for (; m_fade > 0 && at < output.size() / 2u; ++at)
+        {
+            --m_fade;
+            const double g = double(m_fade) / double(FadeFrames);
+            for (size_t c = 0; c < 2u; ++c)
+                output[2u*at+c] = static_cast<int16_t>(std::lround(m_last[c] * g));
+        }
+        return at;
+    }
+
+    // Drop `skip` frames just past the read position, blending the frames
+    // before the cut into the frames after it so the waveform stays whole.
+    void skipWithCrossfade(size_t skip)
+    {
+        const size_t keep = static_cast<size_t>(m_phase) + 2u; // being interpolated
+        if (m_count < keep + skip + FadeFrames)
+            return;
+        for (size_t f = 0; f < FadeFrames; ++f)
+        {
+            const double w = (double(f) + 0.5) / double(FadeFrames);
+            const size_t from = ((m_head + keep + f) % CapacityFrames) * 2u;
+            const size_t to = ((m_head + keep + skip + f) % CapacityFrames) * 2u;
+            for (size_t c = 0; c < 2u; ++c)
+                m_samples[to+c] = static_cast<int16_t>(std::lround(m_samples[from+c] * (1.0 - w) + m_samples[to+c] * w));
+        }
+        // Move the kept frames up to the cut so the order stays intact.
+        for (size_t i = keep; i-- > 0;)
+        {
+            const size_t from = ((m_head + i) % CapacityFrames) * 2u;
+            const size_t to = ((m_head + i + skip) % CapacityFrames) * 2u;
+            m_samples[to] = m_samples[from];
+            m_samples[to+1u] = m_samples[from+1u];
+        }
+        m_head = (m_head + skip) % CapacityFrames;
+        m_count -= skip;
+        m_skipped += skip;
+        m_level = double(m_count);
+    }
+
     std::array<int16_t, CapacityFrames * 2u> m_samples{};
     size_t m_head = 0, m_count = 0;
     double m_phase = 0.0; // fractional read position past m_head
-    uint64_t m_dropped = 0, m_underruns = 0, m_underrunFrames = 0;
+    double m_level = double(SteadyLevelFrames), m_drift = 0.0, m_gain = 0.0;
+    double m_last[2]{};
+    size_t m_fade = 0; // fade-out frames left after an underrun
+    bool m_playing = false;
     bool m_started = false;
+    uint64_t m_dropped = 0, m_skipped = 0, m_underruns = 0, m_underrunFrames = 0, m_pushed = 0, m_played = 0;
+    size_t m_peak = 0;
 };
diff --git a/ps2xTest/src/ps2_runtime_io_tests.cpp b/ps2xTest/src/ps2_runtime_io_tests.cpp
index 08e4556..bedcae3 100644
--- a/ps2xTest/src/ps2_runtime_io_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_io_tests.cpp
@@ -778,6 +778,63 @@ void register_ps2_runtime_io_tests()
                 t.Equals(silentFrames, size_t{0}, "drift must not underrun once settled");
                 t.IsTrue(queue->queuedFrames() < SpuPcmQueue::TargetLatencyFrames, "level stays below the bound");
             }
+            {
+                // GA2's IOP once ran 0.9% fast; the integral term absorbs drift
+                // beyond the proportional range without skipping.
+                auto queue = std::make_unique<SpuPcmQueue>();
+                std::vector<int16_t> chunk(484u * 2u, int16_t{1000});
+                std::vector<int16_t> out(480u * 2u);
+                for (int i = 0; i < 8; ++i)
+                    queue->push(chunk);
+                for (int i = 0; i < 20000; ++i)
+                {
+                    queue->push(chunk);
+                    queue->consume(out);
+                }
+                t.Equals(queue->skippedFrames() + queue->droppedFrames(), uint64_t{0}, "0.8% drift is absorbed");
+                t.IsTrue(queue->queuedFrames() < 2u * SpuPcmQueue::SteadyLevelFrames, "level returns near steady");
+            }
+        });
+
+        tc.Run("PCM queue never cuts the waveform on stalls and bursts", [](TestCase &t)
+        {
+            // A 440 Hz sine; the producer stalls (underrun) and catches up in
+            // bursts (including one past the latency bound). The output may
+            // fade but must never jump: a jump is an audible click.
+            auto queue = std::make_unique<SpuPcmQueue>();
+            constexpr double kAmp = 12000.0, kStep = 2.0 * 3.14159265358979 * 440.0 / 48000.0;
+            uint64_t produced = 0;
+            auto produce = [&](size_t frames) {
+                std::vector<int16_t> chunk(frames * 2u);
+                for (size_t f = 0; f < frames; ++f, ++produced)
+                    chunk[2u*f] = chunk[2u*f+1u] = static_cast<int16_t>(std::lround(kAmp * std::sin(kStep * double(produced))));
+                queue->push(chunk);
+            };
+            const double maxDelta = kAmp * kStep * 1.05 + 2.0; // steepest slope of the sine
+            std::vector<int16_t> out(480u * 2u);
+            int16_t previous = 0;
+            double worst = 0.0;
+            auto play = [&] {
+                queue->consume(out);
+                for (size_t f = 0; f < 480u; ++f)
+                {
+                    worst = std::max(worst, std::abs(double(out[2u*f]) - double(previous)));
+                    previous = out[2u*f];
+                }
+            };
+            for (int i = 0; i < 3000; ++i)
+            {
+                if (i == 500)
+                    for (int s = 0; s < 20; ++s) play(); // stall: runs dry
+                if (i == 1000) produce(9600);  // catch-up burst
+                if (i == 2000) produce(30000); // past the latency bound: crossfaded skip
+                produce(480);
+                play();
+            }
+            t.IsTrue(queue->underruns() >= 1u, "the stall underran");
+            t.IsTrue(queue->skippedFrames() > 0u, "the large burst was skipped");
+            t.Equals(queue->droppedFrames(), uint64_t{0}, "nothing was hard-dropped");
+            t.IsTrue(worst <= maxDelta, "no sample-to-sample jump beyond the sine's own slope");
         });
     });
 }
