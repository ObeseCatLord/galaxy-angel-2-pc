diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index a5de97e..e0b3678 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -181,6 +181,7 @@ namespace ps2x::iop::detail
             totalCycles = 0;
             totalInstructions = 0;
             eeCycleCarry = 0;
+            eeIopClock = 0;
             activeCpu = nullptr;
             rpcWaitCpu = nullptr;
             rpcInstructionDeadline = rpcCycleDeadline = 0u;
@@ -1348,6 +1349,7 @@ namespace ps2x::iop::detail
         uint64_t totalCycles = 0;
         uint64_t totalInstructions = 0;
         uint64_t eeCycleCarry = 0;
+        uint64_t eeIopClock = 0; // IOP cycles the EE clock has granted
         CpuState *activeCpu = nullptr;
         CpuState *rpcWaitCpu = nullptr;
         uint64_t rpcInstructionDeadline = 0;
@@ -1428,8 +1430,18 @@ namespace ps2x::iop::detail
         const uint64_t total = m_impl->eeCycleCarry + eeCycles;
         const uint64_t iopCycles = total / 8u;
         m_impl->eeCycleCarry = total % 8u;
-        if (iopCycles)
-            m_impl->runCycles(iopCycles);
+        // IOP time is EE time / 8. Synchronous RPC waits and slice overshoot
+        // run the IOP past that (measured ~0.9% in GA2, which made the SPU
+        // produce ~48420 samples per real second); the EE clock repays that
+        // lead instead of stacking new budget on top of it. A lead beyond
+        // kMaxIopLeadCycles (e.g. a long module start) is forgiven so the IOP
+        // never stalls for long.
+        Impl &impl = *m_impl;
+        impl.eeIopClock += iopCycles;
+        if (impl.totalCycles > impl.eeIopClock + kMaxIopLeadCycles)
+            impl.eeIopClock = impl.totalCycles - kMaxIopLeadCycles;
+        if (impl.eeIopClock > impl.totalCycles)
+            impl.runCycles(impl.eeIopClock - impl.totalCycles);
     }
 
     RpcResult IopEmulator::handleRpc(const RpcRequest &request)
diff --git a/ps2xIOP/src/emulator/iop_emulator_const.h b/ps2xIOP/src/emulator/iop_emulator_const.h
index 7004597..d317e0d 100644
--- a/ps2xIOP/src/emulator/iop_emulator_const.h
+++ b/ps2xIOP/src/emulator/iop_emulator_const.h
@@ -10,6 +10,8 @@ constexpr uint64_t kIopClockHz = 36'864'000ull;
 constexpr uint64_t kVblankPeriodCycles = (kIopClockHz * 1001ull + 30'000ull) / 60'000ull;
 constexpr uint64_t kVblankEndPhaseCycles = kVblankPeriodCycles / 16ull;
 constexpr uint32_t kDefaultSlice = 256u;
+// Largest IOP lead over the EE clock that later EE time repays (~1.8 ms).
+constexpr uint64_t kMaxIopLeadCycles = 65536u;
 constexpr uint32_t kMaxCallInstructions = 2'000'000u;
 constexpr uint32_t kModuleLoadBase = 0x00010000u;
 constexpr uint32_t kStackGuardBytes = 64u;
