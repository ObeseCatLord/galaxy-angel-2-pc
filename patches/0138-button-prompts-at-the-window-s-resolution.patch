+        uint64_t g_promptsTag = 0;
+    }
+
+    void notePromptDraw(const PromptDraw &draw)
+    {
+        const uint64_t tag = ga2_activity::vsyncs.load(std::memory_order_relaxed);
+        std::lock_guard<std::mutex> lock(g_promptMutex);
+        if (tag != g_promptsTag)
+        {
+            g_promptsDone.swap(g_promptsNow);
+            g_promptsNow.clear();
+            g_promptsTag = tag;
+        }
+        if (g_promptsNow.size() < 256)
+            g_promptsNow.push_back(draw);
+    }
+
+    std::vector<PromptDraw> promptDraws()
+    {
+        const uint64_t now = ga2_activity::vsyncs.load(std::memory_order_relaxed);
+        std::lock_guard<std::mutex> lock(g_promptMutex);
+        if (now > g_promptsTag + 3)
+            return {};
+        return g_promptsDone;
+    }
