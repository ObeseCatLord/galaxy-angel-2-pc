+        // Icons placed into composed textures, by the uploaded image (its handle keeps the image, so the pointer is
+        // never another image's): file, visible part, and where in the texture (texels of the game's region).
+        struct Placement
+        {
+            std::string file;
+            Rectangle src;
+            float x0, y0, x1, y1;
+        };
+        struct ImagePlacements
+        {
+            ImageHandle keep;
+            float rx = 0, ry = 0; // the region's first texel (sprites address the whole texture)
+            std::vector<Placement> placements;
+        };
+        std::unordered_map<const Vulkan::Image *, ImagePlacements> g_placements;
+
+        // `placed` (pixels of an image `scale` times the region's texels) -> placements of `handle`.
+        void notePlacements(const ImageHandle &handle, const std::vector<ga2_buttonmatch::Placed> &placed, float scaleX,
+                            float scaleY, uint32_t rx, uint32_t ry)
+        {
+            if (!handle || placed.empty())
+                return;
+            ImagePlacements &entry = g_placements[handle.get()];
+            entry.keep = handle;
+            entry.rx = float(rx), entry.ry = float(ry);
+            entry.placements.clear();
+            for (const ga2_buttonmatch::Placed &p : placed)
+            {
+                const auto file = g_iconFile.find(p.art ? p.art->data : nullptr);
+                if (file == g_iconFile.end())
+                    continue;
+                entry.placements.push_back({file->second, p.src, p.dst.x / scaleX, p.dst.y / scaleY,
+                                            (p.dst.x + p.dst.width) / scaleX, (p.dst.y + p.dst.height) / scaleY});
+            }
+        }
