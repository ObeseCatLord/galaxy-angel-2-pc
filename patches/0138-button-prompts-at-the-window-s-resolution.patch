         class Replacement final : public TextureReplacementInterface
         {
         public:
+            // Where the GS drew a composed texture's icons this frame, for the presentation (window resolution).
+            void replaced_sprite(const Vulkan::Image &image, const float xy[4], const float uv[4], uint32_t rgba,
+                                 uint32_t) override
+            {
+                const auto it = g_placements.find(&image);
+                if (it == g_placements.end() || uv[2] == uv[0] || uv[3] == uv[1])
+                    return;
+                // Texel t lands at x0 + (t - u0) / du; the GS samples a pixel at its integer coordinates, which is
+                // half a pixel right and down of a pixel's centre elsewhere.
+                const float ax = (xy[2] - xy[0]) / (uv[2] - uv[0]), ay = (xy[3] - xy[1]) / (uv[3] - uv[1]);
+                for (const Placement &p : it->second.placements)
+                {
+                    ga2_hitext::PromptDraw d;
+                    d.file = p.file;
+                    d.sx0 = p.src.x, d.sy0 = p.src.y, d.sx1 = p.src.x + p.src.width, d.sy1 = p.src.y + p.src.height;
+                    const float rx = it->second.rx, ry = it->second.ry;
+                    float x0 = xy[0] + (rx + p.x0 - uv[0]) * ax + 0.5f, x1 = xy[0] + (rx + p.x1 - uv[0]) * ax + 0.5f;
+                    float y0 = xy[1] + (ry + p.y0 - uv[1]) * ay + 0.5f, y1 = xy[1] + (ry + p.y1 - uv[1]) * ay + 0.5f;
+                    // Only what the sprite shows.
+                    const float lo = std::min(xy[0], xy[2]), hi = std::max(xy[0], xy[2]);
+                    const float top = std::min(xy[1], xy[3]), bottom = std::max(xy[1], xy[3]);
+                    if (std::min(x0, x1) < lo - 1.0f || std::max(x0, x1) > hi + 1.0f || std::min(y0, y1) < top - 1.0f ||
+                        std::max(y0, y1) > bottom + 1.0f)
+                        continue;
+                    d.x0 = x0, d.y0 = y0, d.x1 = x1, d.y1 = y1;
+                    d.rgba = rgba;
+                    ga2_hitext::notePromptDraw(d);
+                }
+            }
