diff --git a/ps2xRuntime/src/lib/ga2_present.cpp b/ps2xRuntime/src/lib/ga2_present.cpp
index 2e873e7..b515455 100644
--- a/ps2xRuntime/src/lib/ga2_present.cpp
+++ b/ps2xRuntime/src/lib/ga2_present.cpp
@@ -565,6 +565,109 @@ void main() {
             EndShaderMode();
         }
 
+        // ---- button prompts (ga2_hitext::promptDraws) --------------------------------------------------------------
+        // The icons and prompt words the texture replacement drew into the games' textures, drawn again at the window's
+        // resolution from their image files (mipmapped). Only where the picture shows the icon as the GS drew it (a 4x4
+        // grid of its opaque pixels compared), so a menu or a fade over it keeps the GS's.
+        const char *kPromptOverlay = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0; // the icon, premultiplied
+uniform sampler2D picture;  // the GS's picture, with its own rendering of the icon
+uniform vec4 srcRect;       // the icon's visible part (uv)
+uniform vec4 pictureRect;   // where it is in the picture (uv)
+uniform vec4 tint;          // the sprite colour
+out vec4 finalColor;
+void main() {
+    float diff = 0.0, n = 0.0;
+    for (int y = 0; y < 4; ++y)
+        for (int x = 0; x < 4; ++x) {
+            vec2 g = (vec2(x, y) + 0.5) / 4.0;
+            vec4 ic = textureLod(texture0, mix(srcRect.xy, srcRect.zw, g), 2.0);
+            if (ic.a > 0.9) {
+                vec3 d = abs(texture(picture, mix(pictureRect.xy, pictureRect.zw, g)).rgb - ic.rgb / ic.a * tint.rgb);
+                diff += max(d.r, max(d.g, d.b));
+                n += 1.0;
+            }
+        }
+    float shown = n > 0.0 ? 1.0 - smoothstep(0.18, 0.35, diff / n) : 0.0;
+    vec4 c = texture(texture0, fragTexCoord);
+    float k = tint.a * shown;
+    finalColor = vec4(c.rgb * tint.rgb * k, c.a * k);
+})";
+        Shader g_promptShader{};
+        int g_promptLoaded = -1;
+        std::unordered_map<std::string, Texture2D> g_promptTextures;
+
+        void drawPromptOverlay(const Texture2D &gsPicture, Rect picture)
+        {
+            static const bool allowed = [] {
+                const char *v = std::getenv("GA2_PROMPT_OVERLAY");
+                return !(v && std::string(v) == "0");
+            }();
+            if (!allowed)
+                return;
+            const std::vector<ga2_hitext::PromptDraw> draws = ga2_hitext::promptDraws();
+            if (draws.empty())
+                return;
+            if (g_promptLoaded < 0)
+            {
+                g_promptShader = LoadShaderFromMemory(nullptr, kPromptOverlay);
+                g_promptLoaded = IsShaderValid(g_promptShader) ? 1 : 0;
+            }
+            if (g_promptLoaded != 1)
+                return;
+            const float sx = picture.width / 640.0f, sy = picture.height / 480.0f;
+            rlDrawRenderBatchActive();
+            BeginBlendMode(BLEND_ALPHA_PREMULTIPLY);
+            BeginShaderMode(g_promptShader);
+            const int srcLoc = GetShaderLocation(g_promptShader, "srcRect"), picLoc = GetShaderLocation(g_promptShader, "pictureRect");
+            const int tintLoc = GetShaderLocation(g_promptShader, "tint"), pictureLoc = GetShaderLocation(g_promptShader, "picture");
+            for (const ga2_hitext::PromptDraw &d : draws)
+            {
+                auto it = g_promptTextures.find(d.file);
+                if (it == g_promptTextures.end())
+                {
+                    ::Image image = LoadImage(d.file.c_str());
+                    Texture2D texture{};
+                    if (image.data)
+                    {
+                        ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                        ImageAlphaPremultiply(&image);
+                        texture = LoadTextureFromImage(image);
+                        GenTextureMipmaps(&texture);
+                        SetTextureFilter(texture, TEXTURE_FILTER_TRILINEAR);
+                        UnloadImage(image);
+                    }
+                    it = g_promptTextures.emplace(d.file, texture).first;
+                }
+                const Texture2D &texture = it->second;
+                if (!texture.id)
+                    continue;
+                const float tw = float(texture.width), th = float(texture.height);
+                const float src[4] = {d.sx0 / tw, d.sy0 / th, d.sx1 / tw, d.sy1 / th};
+                const float where[4] = {d.x0 / 640.0f, d.y0 / 480.0f, d.x1 / 640.0f, d.y1 / 480.0f};
+                auto c = [&](int shift) { return std::min(1.0f, float((d.rgba >> shift) & 0xFFu) / 128.0f); };
+                const Vector4 tint{c(0), c(8), c(16), c(24)};
+                SetShaderValue(g_promptShader, srcLoc, src, SHADER_UNIFORM_VEC4);
+                SetShaderValue(g_promptShader, picLoc, where, SHADER_UNIFORM_VEC4);
+                SetShaderValue(g_promptShader, tintLoc, &tint, SHADER_UNIFORM_VEC4);
+                SetShaderValueTexture(g_promptShader, pictureLoc, gsPicture); // dropped at every flush
+                // A few source pixels past the visible part (the edges' anti-aliasing fades out there, and the GS's
+                // own drawing of it has that soft edge too), the destination grown to match.
+                const float m = 4.0f;
+                const float ex0 = std::min(m, d.sx0), ey0 = std::min(m, d.sy0);
+                const float ex1 = std::min(m, tw - d.sx1), ey1 = std::min(m, th - d.sy1);
+                const float kx = (d.x1 - d.x0) * sx / (d.sx1 - d.sx0), ky = (d.y1 - d.y0) * sy / (d.sy1 - d.sy0);
+                DrawTexturePro(texture, Rectangle{d.sx0 - ex0, d.sy0 - ey0, d.sx1 - d.sx0 + ex0 + ex1, d.sy1 - d.sy0 + ey0 + ey1},
+                               Rectangle{picture.x + d.x0 * sx - ex0 * kx, picture.y + d.y0 * sy - ey0 * ky,
+                                         (d.x1 - d.x0) * sx + (ex0 + ex1) * kx, (d.y1 - d.y0) * sy + (ey0 + ey1) * ky},
+                               Vector2{0, 0}, 0.0f, WHITE);
+                rlDrawRenderBatchActive();
+            }
+            EndShaderMode();
+            EndBlendMode();
+        }
+
         RenderTexture2D g_blur[3]{};
         Texture2D g_skybox{};
 
@@ -1322,6 +1425,9 @@ namespace ga2_present
         }
         else
             DrawTexturePro(shown, source, dst, Vector2{0, 0}, 0.0f, WHITE);
+        // Button prompts at the window's resolution (2D pictures; under the text, which may overlap their words).
+        if (g_ready && !scene3d && !g_wide && sizesMatch && gsFrame.width % 640 == 0)
+            drawPromptOverlay(gsFrame, picture);
         if (g_textErased)
             drawTextOverlay(textPieces, picture);
         return picture;
