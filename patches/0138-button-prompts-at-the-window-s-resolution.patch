 ps2xRuntime/src/lib/ga2_present.cpp      | 106 ++++++++++++++++++++
 ps2xRuntime/src/lib/gs/gs_buttonpack.h   |  30 +++++-
 ps2xRuntime/src/lib/gs/gs_hitext.cpp     |  30 ++++++
 ps2xRuntime/src/lib/gs/gs_texpacks.cpp   | 117 +++++++++++++++++++----
 5 files changed, 272 insertions(+), 23 deletions(-)

