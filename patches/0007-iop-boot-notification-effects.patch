diff --git a/ps2xIOP/tests/iop_boot_notify_tests.cpp b/ps2xIOP/tests/iop_boot_notify_tests.cpp
new file mode 100644
index 0000000..2966898
--- /dev/null
+++ b/ps2xIOP/tests/iop_boot_notify_tests.cpp
@@ -0,0 +1,363 @@
+#include "iop_compat_test_support.h"
+
+#include "emulator/core/iop_cpu.h"
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/imports/iop_imports.h"
+#include "emulator/imports/iop_loadcore.h"
+#include "emulator/services/iop_rpc.h"
+
+#include <cstdint>
+#include <functional>
+#include <utility>
+#include <vector>
+
+namespace
+{
+    using namespace iop_test;
+    using namespace ps2x::iop::detail;
+
+    constexpr uint32_t kStatusSentinel = 0xDEADC0DEu;
+
+    struct Call
+    {
+        uint32_t address = 0u;
+        uint32_t a0 = 0u;
+        uint32_t next = 0u;
+        uint32_t delayed = 0u;
+        uint32_t a2 = 0u;
+        uint32_t a3 = 0u;
+        uint32_t gp = 0u;
+        uint32_t budget = 0u;
+    };
+
+    class Executor final : public IopGuestExecutor
+    {
+    public:
+        explicit Executor(IopMemory &memory) : m_memory(memory) {}
+
+        bool executeGuestFunctionChecked(uint32_t address, uint32_t a0, uint32_t a1,
+                                         uint32_t a2, uint32_t a3, uint32_t gp,
+                                         uint32_t budget, uint32_t &result) override
+        {
+            calls.push_back({address, a0, m_memory.read32(a0), a1, a2, a3, gp, budget});
+            if (onCall) onCall(calls.size() - 1u);
+            result = resultFor ? resultFor(address) : callbackResult;
+            return complete;
+        }
+
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t,
+                                      uint32_t, uint32_t) override
+        {
+            return 0u;
+        }
+
+        bool complete = true;
+        uint32_t callbackResult = 0u;
+        std::function<uint32_t(uint32_t)> resultFor;
+        std::function<void(size_t)> onCall;
+        std::vector<Call> calls;
+
+    private:
+        IopMemory &m_memory;
+    };
+
+    class UncheckedExecutor final : public IopGuestExecutor
+    {
+    public:
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t,
+                                      uint32_t, uint32_t) override
+        {
+            ++legacyCalls;
+            return 0u;
+        }
+
+        uint32_t legacyCalls = 0u;
+    };
+
+    void installCallback(IopMemory &memory, uint32_t address)
+    {
+        memory.write32(address, 0u);
+        require(memory.ownsRamRange(address, 4u), "synthetic callback was not owned");
+    }
+
+    IopCpuState notification(uint32_t callback, uint32_t priority, uint32_t status, uint32_t gp)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = callback;
+        cpu.gpr[5] = priority;
+        cpu.gpr[6] = status;
+        cpu.gpr[28] = gp;
+        return cpu;
+    }
+
+    void requireCall(const Call &call, uint32_t callback, uint32_t next,
+                     uint32_t delayed, uint32_t gp)
+    {
+        require(call.address == callback, "callback function address changed");
+        require(call.next == next, "callback next record word was wrong");
+        require(call.delayed == delayed, "callback delay argument was wrong");
+        require(call.a2 == 0u && call.a3 == 0u, "callback acquired unexpected arguments");
+        require(call.gp == gp, "callback GP was not preserved");
+        require(call.budget == 100000u, "callback budget changed");
+    }
+
+    void immediateNotificationExecutesAndReportsCompletion()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t callback = 0x1000u;
+        constexpr uint32_t status = 0x1100u;
+        constexpr uint32_t gp = 0xCAFE0000u;
+        installCallback(memory, callback);
+        memory.write32(status, kStatusSentinel);
+        executor.callbackResult = 0x12345678u;
+
+        IopCpuState cpu = notification(callback, 6u, status, gp);
+        require(loadcore.dispatchImport(20u, cpu, &executor), "post-boot notification was unhandled");
+        require(cpu.gpr[2] == 0u, "post-boot notification did not return completion");
+        require(executor.calls.size() == 1u, "post-boot callback did not execute once");
+        requireCall(executor.calls.front(), callback, 1u, 0u, gp);
+        require(memory.read32(status) == executor.callbackResult, "completed callback did not write status");
+        require(!memory.ownsRamRange(executor.calls.front().a0, 4u),
+                "completed callback record was retained");
+    }
+
+    // ps2sdk loadcore.c: deferred registration retains function/GP only;
+    // next.callback is the first registration word for classes 0..2, and the
+    // callback's own word for class 3. Deferred stat is never retained/written.
+    void collectedNotificationsPreserveSdkClassOrder()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t first = 0x1000u;
+        constexpr uint32_t second = 0x1100u;
+        constexpr uint32_t middle = 0x1200u;
+        constexpr uint32_t final = 0x1300u;
+        constexpr uint32_t statusBase = 0x2000u;
+        const uint32_t callbacks[] = {first, second, middle, final};
+        const uint32_t priorities[] = {0u, 0u, 1u, 3u};
+        const uint32_t gps[] = {0xA0u, 0xA1u, 0xA2u, 0xA3u};
+        for (uint32_t callback : callbacks) installCallback(memory, callback);
+        for (uint32_t index = 0u; index < 4u; ++index) memory.write32(statusBase + 4u * index, kStatusSentinel);
+        executor.resultFor = [](uint32_t callback) { return callback ^ 0x00FF00FFu; };
+
+        require(loadcore.beginBootNotifications(8u), "could not enter boot notification collection");
+        for (uint32_t index = 0u; index < 4u; ++index)
+        {
+            IopCpuState cpu = notification(callbacks[index], priorities[index], statusBase + 4u * index, gps[index]);
+            require(loadcore.dispatchImport(20u, cpu), "boot callback registration was unhandled");
+            require(cpu.gpr[2] == 1u, "boot callback registration did not defer");
+            require(memory.read32(statusBase + 4u * index) == kStatusSentinel,
+                    "deferred callback wrote status before completion");
+        }
+
+        require(loadcore.finishBootNotifications(executor), "collected callbacks did not complete");
+        require(executor.calls.size() == 4u, "collected callbacks did not execute once each");
+        requireCall(executor.calls[0], first, first | 0u, 1u, gps[0]);
+        requireCall(executor.calls[1], second, first | 0u, 1u, gps[1]);
+        requireCall(executor.calls[2], middle, first | 0u, 1u, gps[2]);
+        requireCall(executor.calls[3], final, final | 3u, 1u, gps[3]);
+        for (uint32_t index = 0u; index < 4u; ++index)
+            require(memory.read32(statusBase + 4u * index) == kStatusSentinel,
+                    "deferred callback changed optional status contrary to SDK");
+    }
+
+    void invalidRequestsAndMissingExecutorDoNotExecute()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t callback = 0x1000u;
+        constexpr uint32_t status = 0x1100u;
+        installCallback(memory, callback);
+        memory.write32(status, kStatusSentinel);
+
+        const auto reject = [&](uint32_t requestedCallback, uint32_t requestedStatus)
+        {
+            IopCpuState cpu = notification(requestedCallback, 0u, requestedStatus, 0x44u);
+            cpu.gpr[2] = 0xBAD0u;
+            require(!loadcore.dispatchImport(20u, cpu, &executor), "invalid notification was accepted");
+            require(cpu.gpr[2] == 0xBAD0u, "invalid notification changed its return value");
+            require(executor.calls.empty(), "invalid notification executed a callback");
+            require(memory.read32(status) == kStatusSentinel, "invalid notification changed status");
+        };
+
+        reject(0u, status);
+        reject(callback + 2u, status);
+        reject(0x3000u, status);
+        reject(callback, status + 2u);
+        reject(callback, 0x3000u);
+
+        IopCpuState cpu = notification(callback, 0u, status, 0x44u);
+        require(!loadcore.dispatchImport(20u, cpu), "missing checked executor was accepted");
+        require(executor.calls.empty(), "missing executor caused execution");
+        require(memory.read32(status) == kStatusSentinel, "missing executor changed status");
+
+        UncheckedExecutor unchecked;
+        require(!loadcore.dispatchImport(20u, cpu, &unchecked), "unchecked executor was accepted");
+        require(unchecked.legacyCalls == 0u, "unchecked executor used legacy completion");
+        require(memory.read32(status) == kStatusSentinel, "unchecked executor changed status");
+
+        require(loadcore.dispatchImport(20u, cpu, &executor), "valid call was poisoned by prior rejections");
+        require(executor.calls.size() == 1u, "valid call did not execute after rejected requests");
+    }
+
+    void collectionCapacityAndResetAreBounded()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t callback = 0x1000u;
+        installCallback(memory, callback);
+
+        require(!loadcore.beginBootNotifications(0u), "zero notification capacity was accepted");
+        require(!loadcore.beginBootNotifications(257u), "capacity above firmware bound was accepted");
+        require(loadcore.beginBootNotifications(256u), "maximum notification capacity was rejected");
+        require(!loadcore.beginBootNotifications(1u), "collection reentry was accepted");
+        for (uint32_t index = 0u; index < 256u; ++index)
+        {
+            IopCpuState cpu = notification(callback, index, 0u, index);
+            require(loadcore.dispatchImport(20u, cpu), "notification below capacity was rejected");
+            require(cpu.gpr[2] == 1u, "notification below capacity was not deferred");
+        }
+        IopCpuState overflow = notification(callback, 0u, 0u, 0u);
+        require(!loadcore.dispatchImport(20u, overflow), "notification above capacity was accepted");
+
+        loadcore.reset();
+        require(!loadcore.finishBootNotifications(executor), "reset collection could still finish");
+        require(executor.calls.empty(), "reset collection executed a cancelled callback");
+        require(loadcore.beginBootNotifications(1u), "reset did not return to quiescent collection state");
+        IopCpuState queued = notification(callback, 0u, 0u, 0u);
+        require(loadcore.dispatchImport(20u, queued), "notification could not register after reset");
+        loadcore.reset();
+        require(!loadcore.finishBootNotifications(executor), "second reset collection could still finish");
+    }
+
+    void incompleteCallbackDoesNotCompleteOrReplay()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t callback = 0x1000u;
+        constexpr uint32_t status = 0x1100u;
+        installCallback(memory, callback);
+        memory.write32(status, kStatusSentinel);
+        executor.complete = false;
+        executor.callbackResult = 0xFACECAFEu;
+
+        require(loadcore.beginBootNotifications(1u), "could not begin failure test collection");
+        IopCpuState cpu = notification(callback, 0u, status, 0x77u);
+        require(loadcore.dispatchImport(20u, cpu), "failure test callback did not register");
+        require(!loadcore.finishBootNotifications(executor), "incomplete callback reported completion");
+        require(executor.calls.size() == 1u, "incomplete callback did not execute exactly once");
+        require(memory.read32(status) == kStatusSentinel, "incomplete callback wrote status");
+        require(memory.ownsRamRange(executor.calls.front().a0, 4u),
+                "incomplete callback record was released before reset");
+        require(!loadcore.finishBootNotifications(executor), "consumed failed collection could finish again");
+        require(executor.calls.size() == 1u, "failed collection replayed a callback");
+    }
+
+    void samePriorityRegistrationDuringFinishRunsInClassOrder()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        constexpr uint32_t first = 0x1000u;
+        constexpr uint32_t later = 0x1100u;
+        constexpr uint32_t firstStatus = 0x2000u;
+        constexpr uint32_t laterStatus = 0x2100u;
+        installCallback(memory, first);
+        installCallback(memory, later);
+        memory.write32(firstStatus, kStatusSentinel);
+        memory.write32(laterStatus, kStatusSentinel);
+        executor.resultFor = [=](uint32_t address) { return address ^ 0xA5A50000u; };
+
+        require(loadcore.beginBootNotifications(2u), "could not begin same-priority collection");
+        IopCpuState initial = notification(first, 1u, firstStatus, 0x51u);
+        require(loadcore.dispatchImport(20u, initial), "initial callback did not register");
+        bool attemptedBegin = false;
+        executor.onCall = [&](size_t callIndex)
+        {
+            if (callIndex != 0u) return;
+            attemptedBegin = true;
+            require(!loadcore.beginBootNotifications(1u), "callback reentered collection phase");
+            IopCpuState registered = notification(later, 1u, laterStatus, 0x52u);
+            require(loadcore.dispatchImport(20u, registered), "same-priority callback was not accepted while finishing");
+            require(registered.gpr[2] == 1u, "same-priority callback did not defer while finishing");
+            require(memory.read32(laterStatus) == kStatusSentinel,
+                    "same-priority callback wrote status before completion");
+        };
+
+        require(loadcore.finishBootNotifications(executor), "same-priority finish did not complete");
+        require(attemptedBegin, "callback did not exercise finish-phase reentry guard");
+        require(executor.calls.size() == 2u, "same-priority registration did not run in this finish pass");
+        requireCall(executor.calls[0], first, first | 1u, 1u, 0x51u);
+        requireCall(executor.calls[1], later, first | 1u, 1u, 0x52u);
+        require(memory.read32(firstStatus) == kStatusSentinel, "deferred initial callback changed status");
+        require(memory.read32(laterStatus) == kStatusSentinel, "deferred later callback changed status");
+    }
+
+    void callbackExceptionRetainsRecordWithoutReportingCompletion()
+    {
+        IopMemory memory;
+        IopImportRegistry imports(memory);
+        IopLoadcore loadcore(memory, imports);
+        Executor executor(memory);
+        installCallback(memory, 0x1000u);
+        memory.write32(0x1100u, kStatusSentinel);
+        IopCpuState cpu = notification(0x1000u, 0u, 0x1100u, 0x88u);
+        cpu.gpr[2] = 0xBAD0u;
+        executor.onCall = [](size_t) { throw std::runtime_error("callback interrupted"); };
+        require(!loadcore.dispatchImport(20u, cpu, &executor), "exception reported completion");
+        require(cpu.gpr[2] == 0xBAD0u, "exception changed return value");
+        require(memory.read32(0x1100u) == kStatusSentinel, "exception changed output status");
+        require(memory.ownsRamRange(executor.calls.front().a0, 4u), "exception released callback record");
+        executor.onCall = {};
+        require(loadcore.dispatchImport(20u, cpu, &executor), "exception leaked callback depth");
+        require(executor.calls.size() == 2u, "completed retry did not execute once");
+    }
+
+    void absentHostRegistersCannotReportSifInitialization()
+    {
+        Host host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopRpcBridge rpc(host, memory, kernel);
+        IopCpuState cpu{};
+        cpu.gpr[2] = 0xBAD0u;
+        require(!rpc.dispatchSifManImport(5u, cpu), "SIF init succeeded without host effect");
+        require(cpu.gpr[2] == 0xBAD0u, "unsupported init changed return value");
+        for (uint16_t ordinal : {21u, 22u, 23u, 24u, 25u, 26u, 27u})
+        {
+            require(!rpc.dispatchSifManImport(ordinal, cpu), "unsupported register reported success");
+            require(cpu.gpr[2] == 0xBAD0u, "unsupported register changed return value");
+        }
+        require(rpc.dispatchSifManImport(4u, cpu), "DMA2 setup import was unhandled");
+        require(rpc.dispatchSifManImport(29u, cpu), "init check import was unhandled");
+        require(cpu.gpr[2] == 0u, "DMA2 setup fabricated SIF initialization");
+    }
+}
+
+int main()
+{
+    const Test tests[] = {
+        {"LOADCORE immediate notification executes checked callback", immediateNotificationExecutesAndReportsCompletion},
+        {"LOADCORE boot notifications preserve SDK class order", collectedNotificationsPreserveSdkClassOrder},
+        {"LOADCORE rejects invalid notifications and missing executors", invalidRequestsAndMissingExecutorDoNotExecute},
+        {"LOADCORE bounds collection and reset cancels it", collectionCapacityAndResetAreBounded},
+        {"LOADCORE incomplete callback does not complete or replay", incompleteCallbackDoesNotCompleteOrReplay},
+        {"LOADCORE accepts same-priority registration during finish", samePriorityRegistrationDuringFinishRunsInClassOrder},
+        {"LOADCORE callback exception does not report completion", callbackExceptionRetainsRecordWithoutReportingCompletion},
+        {"SIFMAN absent host registers cannot fabricate initialization", absentHostRegistersCannotReportSifInitialization},
+    };
+    return run(tests);
+}
