+        tc.Run("packet marker follows analog and pressure mode transitions", [](TestCase &t)
+               {
+            std::vector<uint8_t> rdram(PS2_RAM_SIZE, 0);
+            R5900Context ctx;
+            ps2_stubs::scePadInit(rdram.data(), &ctx, nullptr);
+            openPadPort(ctx, rdram);
+            ps2_stubs::setPadOverrideState(static_cast<uint16_t>(0xFFFFu & ~kPadBtnCircle),
+                                          0x80, 0x80, 0x80, 0x80);
+            rdram[kPadDataAddr - 1u] = 0xA5;
+            rdram[kPadDataAddr + 32u] = 0x5A;
+            const auto checkPacket = [&](uint8_t marker, uint8_t circlePressure)
+            {
+                runPadRead(ctx, rdram);
+                t.Equals(getRegU32(&ctx, 2), 1u, "packet read succeeds");
+                t.Equals(rdram[kPadDataAddr], static_cast<uint8_t>(0), "packet status is zero");
+                t.Equals(rdram[kPadDataAddr + 1u], marker, "marker matches negotiated mode");
+                t.Equals(rdram[kPadDataAddr + 2u], static_cast<uint8_t>(0xFF), "low button byte stays FF");
+                t.Equals(rdram[kPadDataAddr + 3u], static_cast<uint8_t>(0xDF), "high button byte retains Circle");
+                t.Equals(rdram[kPadDataAddr + 13u], circlePressure, "Circle pressure follows pressure mode");
+                t.Equals(rdram[kPadDataAddr - 1u], static_cast<uint8_t>(0xA5), "leading byte unchanged");
+                t.Equals(rdram[kPadDataAddr + 32u], static_cast<uint8_t>(0x5A), "trailing byte unchanged");
+            };
+            const auto finishCommand = [&]()
+            {
+                t.Equals(getRegU32(&ctx, 2), 1u, "mode command accepted");
+                ps2_stubs::scePadGetState(rdram.data(), &ctx, nullptr);
+                t.Equals(getRegU32(&ctx, 2), 5u, "command exposes transient execution state");
+                ps2_stubs::scePadGetState(rdram.data(), &ctx, nullptr);
+                t.Equals(getRegU32(&ctx, 2), 6u, "command becomes stable");
+                ps2_stubs::scePadGetReqState(rdram.data(), &ctx, nullptr);
+                t.Equals(getRegU32(&ctx, 2), 0u, "request is complete");
+            };
+            checkPacket(0x41, 0x00);
+            setRegU32(ctx, 6, 1u);
+            setRegU32(ctx, 7, 3u);
+            ps2_stubs::scePadSetMainMode(rdram.data(), &ctx, nullptr);
+            finishCommand();
+            checkPacket(0x73, 0x00);
+            ps2_stubs::scePadEnterPressMode(rdram.data(), &ctx, nullptr);
+            finishCommand();
+            checkPacket(0x79, 0xFF);
+            ps2_stubs::scePadExitPressMode(rdram.data(), &ctx, nullptr);
+            finishCommand();
+            checkPacket(0x73, 0x00);
+            setRegU32(ctx, 6, 0u);
+            setRegU32(ctx, 7, 3u);
+            ps2_stubs::scePadSetMainMode(rdram.data(), &ctx, nullptr);
+            finishCommand();
+            ps2_stubs::scePadEnterPressMode(rdram.data(), &ctx, nullptr);
+            finishCommand();
+            checkPacket(0x41, 0xFF);
+            ps2_stubs::clearPadOverrideState();
+            closePadPort(ctx, rdram);
+        });
