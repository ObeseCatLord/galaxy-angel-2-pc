+    bool testFlaggedDmaInterrupt()
+    {
+        IopMemory memory;
+        IopIntrman intrman(memory);
+        RecordingExecutor executor;
+        IopCpuState cpu{};
+        cpu.gpr[4] = 43u;
+        cpu.gpr[5] = 1u;
+        cpu.gpr[6] = 0x1000u;
+        cpu.gpr[7] = 0x2000u;
+        cpu.gpr[28] = 0x3000u;
+        if (!expect(intrman.dispatchImport(4u, cpu, executor), "DMA IRQ registration unhandled")) return false;
+        cpu = {};
+        cpu.gpr[4] = 0x22Bu;
+        if (!expect(intrman.dispatchImport(6u, cpu, executor), "flagged DMA IRQ enable unhandled") ||
+            !expect(intrman.dispatchInterrupt(43, executor) && executor.calls == 1u &&
+                    executor.lastAddress == 0x1000u && executor.lastArgument == 0x2000u &&
+                    executor.lastGp == 0x3000u, "DMA modes changed handler identity/GP")) return false;
+        if (!expect(!intrman.dispatchInterrupt(0x22B, executor), "mode bits became another IRQ")) return false;
+        cpu = {};
+        cpu.gpr[4] = 0x22Bu;
+        if (!expect(intrman.dispatchImport(7u, cpu, executor) && !intrman.dispatchInterrupt(43, executor),
+                    "flagged disable left DMA callback enabled")) return false;
+        cpu.gpr[4] = 43u;
+        if (!expect(intrman.dispatchImport(6u, cpu, executor) && intrman.dispatchInterrupt(43, executor),
+                    "plain enable did not share flagged IRQ state")) return false;
+        intrman.reset();
+        return expect(!intrman.dispatchInterrupt(43, executor), "reset retained DMA callback");
+    }
+
+    bool testSystemStatusEvent()
+    {
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        const int userEvent = kernel.createInternalEventFlag(0u, 0u, 0x55u);
+        IopCpuState cpu{};
+        if (!expect(kernel.dispatchThreadImport(41u, cpu, 0u), "system status import unhandled")) return false;
+        const int systemEvent = int(cpu.gpr[2]);
+        if (!expect(systemEvent > 0 && systemEvent != userEvent,
+                    "system status flag is not an independent event")) return false;
+        if (!pollEvent(kernel, systemEvent, 0x100u, 0x2000u, -418)) return false;
+        if (!expect(kernel.setInternalEventFlag(systemEvent, 0x900u), "system status event rejected bits")) return false;
+        cpu = {};
+        if (!expect(kernel.dispatchThreadImport(41u, cpu, 0u) && int(cpu.gpr[2]) == systemEvent,
+                    "system status callers do not share one event")) return false;
+        if (!pollEvent(kernel, systemEvent, 0x900u, 0x2000u, 0) ||
+            !expect(memory.read32(0x2000u) == 0x900u, "system status bits do not reach event API")) return false;
+        cpu = {};
+        cpu.gpr[4] = uint32_t(systemEvent);
+        cpu.gpr[5] = ~0x100u;
+        if (!expect(kernel.dispatchEventImport(8u, cpu), "system status clear unhandled") ||
+            !pollEvent(kernel, systemEvent, 0x100u, 0x2000u, -418) ||
+            !pollEvent(kernel, systemEvent, 0x800u, 0x2000u, 0)) return false;
+        kernel.reset();
+        cpu = {};
+        if (!expect(kernel.dispatchThreadImport(41u, cpu, 0u), "system status unavailable after reset")) return false;
+        const int resetEvent = int(cpu.gpr[2]);
+        if (!pollEvent(kernel, resetEvent, 0x800u, 0x2000u, -418)) return false;
+        cpu = {};
+        cpu.gpr[4] = uint32_t(resetEvent);
+        if (!expect(kernel.dispatchEventImport(5u, cpu) && cpu.gpr[2] == 0u,
+                    "test event deletion failed")) return false;
+        cpu = {};
+        return expect(kernel.dispatchThreadImport(41u, cpu, 0u) && cpu.gpr[2] > 0u &&
+                      int(cpu.gpr[2]) != resetEvent,
+                      "deleted system event left a stale cached handle");
+    }
