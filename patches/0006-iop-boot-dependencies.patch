+#include "emulator/services/iop_rpc.h"
+#include "ps2x/iop/iop_host.h"
+
+#include <cstdint>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop;
+    using namespace ps2x::iop::detail;
+
+    constexpr int32_t kErrorBadFile = -9;
+    constexpr int32_t kErrorFault = -14;
+    constexpr int32_t kErrorInvalid = -22;
+    constexpr int32_t kErrorReadOnly = -30;
+    constexpr int32_t kErrorUnsupported = -48;
+    constexpr int32_t kErrorNoEntry = -2;
+
+    class Host final : public IopHost
+    {
+    public:
+        struct File
+        {
+            std::vector<uint8_t> bytes;
+            bool shortRead = false;
+            bool failRead = false;
+        };
+
+        bool readGuest(uint32_t, void *, size_t) const override { return false; }
+        bool writeGuest(uint32_t, const void *, size_t) override { return false; }
+        bool zeroGuest(uint32_t, size_t) override { return false; }
+        bool normalizeGuestAddress(uint32_t, uint32_t &) const override { return false; }
+        uint32_t allocateIopHandle(IopHandleKind) override { return 0u; }
+        uint32_t allocateGuest(uint32_t, uint32_t) override { return 0u; }
+        void freeGuest(uint32_t) override {}
+        void audioCommand(uint32_t, uint32_t, GuestBuffer, GuestBuffer) override {}
+        std::string hostPath(HostPathKind) const override { return {}; }
+        std::string translateGuestPath(std::string_view path) const override
+        {
+            ++translateCalls;
+            const auto found = translations.find(std::string(path));
+            return found == translations.end() ? std::string{} : found->second;
+        }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            const auto found = files.find(std::string(path));
+            if (found == files.end())
+                return 0u;
+            handles.emplace(++nextHandle, &found->second);
+            return nextHandle;
+        }
+        bool hostFileSize(uint64_t handle, uint64_t &size) const override
+        {
+            const auto found = handles.find(handle);
+            if (found == handles.end())
+                return false;
+            size = found->second->bytes.size();
+            return true;
+        }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *destination, size_t size,
+                          size_t &bytesRead) override
+        {
+            bytesRead = 0u;
+            const auto found = handles.find(handle);
+            if (found == handles.end() || offset > found->second->bytes.size() ||
+                size > found->second->bytes.size() - offset)
+                return false;
+            if (found->second->failRead)
+            {
+                if (size != 0u)
+                    std::memset(destination, 0xCC, size);
+                return false;
+            }
+            bytesRead = found->second->shortRead && size != 0u ? size - 1u : size;
+            if (bytesRead != 0u)
+                std::memcpy(destination, found->second->bytes.data() + offset, bytesRead);
+            return true;
+        }
+        void closeHostFile(uint64_t handle) override
+        {
+            closes.push_back(handle);
+            handles.erase(handle);
+        }
+        int32_t memoryCard(const MemoryCardRequest &) override { return 0; }
+        bool hasGuestFunction(uint32_t) const override { return false; }
+        bool invokeGuestFunction(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t *) override
+        {
+            return false;
+        }
+        void log(LogLevel, std::string_view) override {}
+
+        mutable uint32_t translateCalls = 0u;
+        std::map<std::string, std::string> translations;
+        std::map<std::string, File> files;
+        std::map<uint64_t, File *> handles;
+        std::vector<uint64_t> closes;
+        uint64_t nextHandle = 0u;
+    };
+
+    class Executor final : public IopGuestExecutor
+    {
+    public:
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override
+        {
+            return 0u;
+        }
+    };
+
+    bool expect(bool condition, std::string_view message)
+    {
+        if (condition)
+            return true;
+        std::cerr << "FAIL: " << message << '\n';
+        return false;
+    }
+
+    int32_t result(const IopCpuState &cpu)
+    {
+        return static_cast<int32_t>(cpu.gpr[2]);
+    }
+
+    bool writeString(IopMemory &memory, uint32_t address, std::string_view value)
+    {
+        if (!memory.writeRam(address, value.data(), value.size()))
+            return false;
+        memory.write8(address + value.size(), 0u);
+        return true;
+    }
+
+    int32_t callOpen(IopIoman &ioman, Executor &executor, uint32_t path, uint32_t flags)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = path;
+        cpu.gpr[5] = flags;
+        return ioman.dispatchImport(4u, cpu, executor) ? result(cpu) : kErrorInvalid;
+    }
+
+    int32_t callClose(IopIoman &ioman, Executor &executor, int32_t descriptor)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = static_cast<uint32_t>(descriptor);
+        return ioman.dispatchImport(5u, cpu, executor) ? result(cpu) : kErrorInvalid;
+    }
+
+    int32_t callRead(IopIoman &ioman, Executor &executor, int32_t descriptor, uint32_t destination, uint32_t count)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = static_cast<uint32_t>(descriptor);
+        cpu.gpr[5] = destination;
+        cpu.gpr[6] = count;
+        return ioman.dispatchImport(6u, cpu, executor) ? result(cpu) : kErrorInvalid;
+    }
+
+    int32_t callSeek(IopIoman &ioman, Executor &executor, int32_t descriptor, int32_t offset, int32_t whence)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = static_cast<uint32_t>(descriptor);
+        cpu.gpr[5] = static_cast<uint32_t>(offset);
+        cpu.gpr[6] = static_cast<uint32_t>(whence);
+        return ioman.dispatchImport(8u, cpu, executor) ? result(cpu) : kErrorInvalid;
+    }
+
+    bool bytesEqual(const IopMemory &memory, uint32_t address, std::initializer_list<uint8_t> expected)
+    {
+        uint32_t index = 0u;
+        for (const uint8_t value : expected)
+            if (memory.read8(address + index++) != value)
+                return false;
+        return true;
+    }
+
+    bool testDescriptorIndependenceAndSeekBoundaries()
+    {
+        Host host;
+        host.translations["rom0:SECRMAN"] = "firmware/SECRMAN";
+        host.files["firmware/SECRMAN"].bytes = {'A', 'B', 'C', 'D'};
+        IopMemory memory;
+        IopIoman ioman(host, memory);
+        Executor executor;
+        constexpr uint32_t path = 0x1000u;
+        constexpr uint32_t output = 0x1100u;
+        if (!writeString(memory, path, "rom0:SECRMAN") || !memory.zeroRam(output, 33u))
+            return false;
+        const int32_t first = callOpen(ioman, executor, path, 1u);
+        const int32_t second = callOpen(ioman, executor, path, 1u);
+        if (!expect(first == 0 && second == 1, "open did not allocate independent descriptors") ||
+            !expect(callRead(ioman, executor, first, output, 2u) == 2, "first descriptor did not read two bytes") ||
+            !expect(bytesEqual(memory, output, {'A', 'B'}), "first descriptor read wrong bytes") ||
+            !expect(callRead(ioman, executor, second, output + 8u, 1u) == 1, "second descriptor did not read") ||
+            !expect(bytesEqual(memory, output + 8u, {'A'}), "second descriptor inherited first offset") ||
+            !expect(callSeek(ioman, executor, first, -1, 1) == 1, "SEEK_CUR did not return expected offset") ||
+            !expect(callRead(ioman, executor, first, output + 16u, 2u) == 2, "seeked descriptor did not read") ||
+            !expect(bytesEqual(memory, output + 16u, {'B', 'C'}), "seeked descriptor read wrong bytes") ||
+            !expect(callSeek(ioman, executor, second, -1, 2) == 3, "SEEK_END did not return expected offset") ||
+            !expect(callRead(ioman, executor, second, output + 24u, 2u) == 1, "short EOF read did not return one byte") ||
+            !expect(bytesEqual(memory, output + 24u, {'D'}), "short EOF read returned wrong byte"))
+            return false;
+
+        memory.write8(output + 32u, 0xA5u);
+        return expect(callSeek(ioman, executor, first, 0, 2) == 4, "SEEK_END did not reach EOF") &&
+               expect(callRead(ioman, executor, first, output + 32u, 1u) == 0, "EOF read did not return zero") &&
+               expect(memory.read8(output + 32u) == 0xA5u, "EOF read modified destination") &&
+               expect(callSeek(ioman, executor, first, 2, 2) == 6, "seek past EOF was rejected") &&
+               expect(callRead(ioman, executor, first, output + 32u, 1u) == 0 &&
+                      memory.read8(output + 32u) == 0xA5u, "read past EOF did not preserve destination") &&
+               expect(callSeek(ioman, executor, first, -5, 0) == kErrorInvalid, "negative SEEK_SET was accepted") &&
+               expect(callSeek(ioman, executor, first, 0, 3) == kErrorInvalid, "invalid whence was accepted") &&
+               expect(callSeek(ioman, executor, first, INT32_MAX, 1) == kErrorInvalid,
+                      "overflowing SEEK_CUR was accepted");
+    }
+
+    bool testShortAndFailedReadPoison()
+    {
+        Host host;
+        host.translations["rom0:SECRMAN"] = "firmware/SECRMAN";
+        host.files["firmware/SECRMAN"].bytes = {'1', '2', '3', '4'};
+        IopMemory memory;
+        IopIoman ioman(host, memory);
+        Executor executor;
+        constexpr uint32_t path = 0x1200u;
+        constexpr uint32_t output = 0x1300u;
+        if (!writeString(memory, path, "rom0:SECRMAN"))
+            return false;
+        const int32_t descriptor = callOpen(ioman, executor, path, 1u);
+        if (!expect(descriptor == 0, "open failed") || !memory.writeRam(output, "\xA5\xA5\xA5\xA5", 4u))
+            return false;
+        host.files["firmware/SECRMAN"].shortRead = true;
+        if (!expect(callRead(ioman, executor, descriptor, output, 3u) == 2, "short host read returned wrong count") ||
+            !expect(bytesEqual(memory, output, {'1', '2', 0xA5}), "short host read wrote beyond returned count"))
+            return false;
+
+        host.files["firmware/SECRMAN"].shortRead = false;
+        host.files["firmware/SECRMAN"].failRead = true;
+        if (!memory.writeRam(output, "\x5A\x5A", 2u))
+            return false;
+        return expect(callRead(ioman, executor, descriptor, output, 2u) == -5, "failed host read did not return EIO") &&
+               expect(bytesEqual(memory, output, {0x5A, 0x5A}), "failed host read poisoned guest memory") &&
+               expect(callSeek(ioman, executor, descriptor, 0, 1) == 2, "failed host read advanced descriptor offset");
+    }
+
+    bool testInvalidInputsAndHandleRevocation()
+    {
+        Host host;
+        host.translations["rom0:SECRMAN"] = "firmware/SECRMAN";
+        host.files["firmware/SECRMAN"].bytes = {'X'};
+        IopMemory memory;
+        IopIoman ioman(host, memory);
+        Executor executor;
+        constexpr uint32_t path = 0x1400u;
+        constexpr uint32_t output = 0x1500u;
+        if (!writeString(memory, path, "rom0:SECRMAN"))
+            return false;
+        memory.write8(output, 0u);
+        if (!expect(callOpen(ioman, executor, IopMemory::RamSize, 1u) == kErrorFault, "invalid path range was accepted") ||
+            !expect(writeString(memory, path + 0x40u, "unknown0:FILE") &&
+                        callOpen(ioman, executor, path + 0x40u, 1u) == kErrorInvalid,
+                    "unknown device path was accepted") ||
+            !expect(writeString(memory, path + 0x80u, "C:\\not-guest") &&
+                        callOpen(ioman, executor, path + 0x80u, 1u) == kErrorInvalid,
+                    "native host path was accepted") ||
+            !expect(callOpen(ioman, executor, path, 2u) == kErrorReadOnly, "write-only open was accepted") ||
+            !expect(callOpen(ioman, executor, path, 0u) == kErrorInvalid, "zero access mode was accepted") ||
+            !expect(callOpen(ioman, executor, path, 0x40000001u) == kErrorInvalid, "unknown open flag was accepted") ||
+            !expect(callOpen(ioman, executor, path, 1u) == 0, "valid open failed") ||
+            !expect(callRead(ioman, executor, 0, IopMemory::RamSize - 1u, 2u) == kErrorFault,
+                    "invalid read destination was accepted") ||
+            !expect(callClose(ioman, executor, 0) == 0, "close failed") ||
+            !expect(callRead(ioman, executor, 0, output, 1u) == kErrorBadFile, "closed descriptor remained valid") ||
+            !expect(host.handles.empty(), "close did not revoke host handle"))
+            return false;
+
+        for (uint32_t iteration = 0u; iteration < 32u; ++iteration)
+        {
+            const int32_t descriptor = callOpen(ioman, executor, path, 1u);
+            if (!expect(descriptor == 0, "closed descriptor slot was not reused") ||
+                !expect(callClose(ioman, executor, descriptor) == 0, "sequential close failed"))
+                return false;
+        }
+        const int32_t reopened = callOpen(ioman, executor, path, 1u);
+        ioman.reset();
+        return expect(reopened == 0, "closed descriptor slot was not retained safely") &&
+               expect(host.handles.empty(), "reset did not revoke host handle") &&
+               expect(callRead(ioman, executor, reopened, output, 1u) == kErrorBadFile,
+                      "reset descriptor remained valid") &&
+               expect(host.closes.size() == 34u, "close/reset did not close each host handle");
+    }
+
+    bool testMissingAndRegisteredDeviceRoute()
+    {
+        Host host;
+        IopMemory memory;
+        IopIoman ioman(host, memory);
+        Executor executor;
+        constexpr uint32_t path = 0x1600u;
+        constexpr uint32_t driver = 0x1700u;
+        constexpr uint32_t name = 0x1800u;
+        if (!writeString(memory, path, "rom0:SECRMAN") || !writeString(memory, name, "rom"))
+            return false;
+        memory.write32(driver, name);
+        memory.write32(driver + 16u, driver + 0x40u);
+        memory.write32(driver + 0x40u, 0u);
+        if (!expect(callOpen(ioman, executor, path, 1u) == kErrorNoEntry, "missing rom0 path did not return ENOENT"))
+            return false;
+
+        IopCpuState add{};
+        add.gpr[4] = driver;
+        if (!expect(ioman.dispatchImport(20u, add, executor) && result(add) == 0, "AddDrv failed") )
+            return false;
+        const uint32_t translationsBefore = host.translateCalls;
+        return expect(callOpen(ioman, executor, path, 1u) == kErrorUnsupported,
+                      "registered rom driver was bypassed") &&
+               expect(host.translateCalls == translationsBefore, "registered device consulted host path translation");
+    }
+
+    bool testDestructorRevokesHostHandle()
+    {
+        Host host;
+        host.translations["rom0:SECRMAN"] = "firmware/SECRMAN";
+        host.files["firmware/SECRMAN"].bytes = {'X'};
+        IopMemory memory;
+        Executor executor;
+        constexpr uint32_t path = 0x1900u;
+        if (!writeString(memory, path, "rom0:SECRMAN"))
+            return false;
+        {
+            IopIoman ioman(host, memory);
+            if (!expect(callOpen(ioman, executor, path, 1u) == 0, "open for destructor cleanup failed"))
+                return false;
+        }
+        return expect(host.handles.empty(), "destructor did not revoke host handle") &&
+               expect(host.closes.size() == 1u, "destructor did not close host handle once");
+    }
+}
+
+int main()
+{
+    return testDescriptorIndependenceAndSeekBoundaries() &&
+                   testShortAndFailedReadPoison() &&
+                   testInvalidInputsAndHandleRevocation() &&
+                   testMissingAndRegisteredDeviceRoute() &&
+                   testDestructorRevokesHostHandle()
+               ? 0
+               : 1;
+}
