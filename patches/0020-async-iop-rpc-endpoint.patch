+    void verifyMipsImportPipelineContinuation()
+    {
+        Host host;
+        MipsCall16Irx image;
+        image.install(host);
+        IopSubsystem iop(host);
+        const ModuleLoadResult loaded = iop.loadModuleBuffer(0x1000u);
+        require(loaded.handled && loaded.startResult == 0, "synthetic Call16 IRX did not create its worker");
+
+        iop.runEeCycles(8u * 20000u);
+        require(host.submissions == 1u, "MIPS worker did not reach deferred sifcmd Call16 import");
+        require(host.endpoint.isCurrent && host.endpoint.isCurrent(), "MIPS host endpoint was not current before first effect");
+        const auto first = patternedReply(0x11u);
+        host.complete(0, first);
+        require(!host.endpoint.isCurrent(), "first MIPS completion left its endpoint current");
+        std::array<uint8_t, 64> reply{};
+        require(iop.readMemory(MipsCall16Irx::kReply, reply.data(), reply.size()) && reply == first,
+                "first deferred MIPS reply was not committed to IOP RAM");
+
+        iop.runEeCycles(8u * 20000u);
+        require(host.submissions == 2u && host.lastRequest.nonce != 0u,
+                "MIPS worker did not resume once and issue the second Call16 without reset");
+        require(host.endpoint.isCurrent && host.endpoint.isCurrent(), "MIPS host endpoint was not current before second effect");
+        const auto second = patternedReply(0x51u);
+        host.complete(0, second);
+        iop.runEeCycles(8u * 20000u);
+
+        uint32_t firstResult = ~0u;
+        uint32_t secondResult = ~0u;
+        uint32_t continuations = 0u;
+        require(iop.readMemory(MipsCall16Irx::kFirstResult, &firstResult, sizeof(firstResult)) &&
+                    iop.readMemory(MipsCall16Irx::kSecondResult, &secondResult, sizeof(secondResult)) &&
+                    iop.readMemory(MipsCall16Irx::kContinuationCount, &continuations, sizeof(continuations)),
+                "MIPS caller result witnesses were unreadable");
+        if (firstResult != 0u || secondResult != 0u || continuations != 2u)
+            throw std::runtime_error("MIPS caller continuation witnesses were " + std::to_string(firstResult) + "," +
+                                     std::to_string(secondResult) + "," + std::to_string(continuations));
+        require(iop.readMemory(MipsCall16Irx::kReply, reply.data(), reply.size()) && reply == second,
+                "second deferred MIPS reply was not committed");
+    }
