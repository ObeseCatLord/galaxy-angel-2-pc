+            words(0x180u, {
+                0x27BDFFD0u, 0xAFBF002Cu,
+                // a0=client, a1=function0, a2=mode0, a3=send.
+                // stack+16..32 = sendSize, receive, receiveSize, end_fn, end_param.
+                0x3C040001u, 0x34840340u, 0x00002821u, 0x00003021u, 0x3C070001u, 0x34E70370u,
