+        require(suspended.kernel.dispatchThreadImport(29u, suspended.control, 0u), "retired SuspendThread failed");
+        require(suspended.memory.freeAllocation(reply) && suspendedThread.state == IopThreadState::Suspended,
+                "retirement woke suspended worker early");
+        suspended.control = {};
+        suspended.control.gpr[4] = static_cast<uint32_t>(suspendedId);
+        require(suspended.kernel.dispatchThreadImport(31u, suspended.control, 0u) &&
+                    suspendedThread.state == IopThreadState::Ready &&
+                    static_cast<int32_t>(suspendedThread.cpu.gpr[2]) == kFailure,
+                "suspended retirement did not preserve negative result for resume");
+
+        Fixture reset;
+        allocateCallBacking(reset, client, send, reply);
+        const int resetId = reset.createThread();
+        reset.startThread(resetId);
+        IopThread &resetThread = reset.runThread();
+        require(reset.call16(resetThread.cpu, client, 0u, 0u, send), "memory-reset Call16 failed");
+        const ReverseRpcCompletionEndpoint resetEndpoint = reset.host.endpoint;
+        reset.memory.reset();
+        require(resetThread.state == IopThreadState::Ready && static_cast<int32_t>(resetThread.cpu.gpr[2]) == kFailure &&
+                    resetEndpoint.isCurrent && !resetEndpoint.isCurrent(),
+                "direct memory reset did not revoke pending endpoint");
+        allocateCallBacking(reset, client, send, reply);
+        IopThread &afterResetThread = reset.runThread();
+        require(reset.call16(afterResetThread.cpu, client, 0u, 0u, send), "post-reset Call16 failed");
+        require(reset.memory.freeAllocation(reply) && afterResetThread.state == IopThreadState::Ready &&
+                    static_cast<int32_t>(afterResetThread.cpu.gpr[2]) == kFailure,
+                "retirement observer did not survive direct memory reset");
+
+        Fixture duringAdmission;
+        allocateCallBacking(duringAdmission, client, send, reply);
+        duringAdmission.host.checkGuardDuringSubmit = true;
+        bool retiredDuringAdmission = false;
+        duringAdmission.host.duringSubmit = [&]
+        {
+            retiredDuringAdmission = duringAdmission.memory.freeAllocation(reply);
+        };
+        const int admissionId = duringAdmission.createThread();
+        duringAdmission.startThread(admissionId);
+        IopThread &admissionThread = duringAdmission.runThread();
+        std::array<uint8_t, 64> admissionBefore{};
+        require(duringAdmission.memory.readRam(reply, admissionBefore.data(), admissionBefore.size()), "admission canary read failed");
+        require(duringAdmission.call16(admissionThread.cpu, client, 0u, 0u, send), "retiring admission Call16 failed");
+        duringAdmission.host.complete(0, patternedReply());
+        std::array<uint8_t, 64> admissionAfter{};
+        require(retiredDuringAdmission && duringAdmission.host.guardDuringSubmit &&
+                    admissionThread.state == IopThreadState::Ready &&
+                    static_cast<int32_t>(admissionThread.cpu.gpr[2]) == kFailure &&
+                    duringAdmission.memory.readRam(reply, admissionAfter.data(), admissionAfter.size()) &&
+                    admissionAfter == admissionBefore && !duringAdmission.memory.ownsRamRange(reply, 64u),
+                "retirement during admission left a writable endpoint");
+    }
+
+    void verifyRetirementRegistration()
+    {
+        Host host;
+        IopMemory memory;
+        IopKernel kernel{memory};
+        auto first = std::make_unique<IopRpcBridge>(host, memory, kernel);
+        bool rejectedSecondOwner = false;
+        try
+        {
+            IopRpcBridge second{host, memory, kernel};
+        }
+        catch (const std::runtime_error &)
+        {
+            rejectedSecondOwner = true;
+        }
+        require(rejectedSecondOwner, "memory accepted a second live reverse-RPC retirement owner");
+        first.reset();
+        IopRpcBridge successor{host, memory, kernel};
+        (void)successor;
+    }
+
+    void verifyKernelStackRetirement()
+    {
+        const auto run = [](bool cleanupDead)
+        {
+            Fixture fixture;
+            const uint32_t victimEntry = cleanupDead ? kEntry + 0x100u : kEntry + 0x200u;
+            const int victimId = fixture.createThread(victimEntry);
+            const auto victimStack = fixture.memory.allocationContaining(IopMemory::HeapBase);
+            require(victimStack && victimStack->size >= 0x200u, "victim stack allocation missing");
+            const uint32_t retiredClient = victimStack->address + 0x40u;
+            const uint32_t retiredReply = victimStack->address + 0x100u;
+
+            if (cleanupDead)
+            {
+                fixture.startThread(victimId);
+                IopThread &victim = fixture.runThread();
+                fixture.endSlice(victim);
+                fixture.kernel.terminateThreadsInRange(victimEntry, 4u);
+            }
+
+            fixture.prepare(retiredClient, kSend, retiredReply);
+            const int affectedId = fixture.createThread();
+            const int neighborId = fixture.createThread();
+            fixture.startThread(affectedId);
+            IopThread &affected = fixture.runThread();
+            require(fixture.call16(affected.cpu, retiredClient, 0u, 0u, kSend),
+                    "stack-backed Call16 failed");
+            require(fixture.host.submissions == 1u && affected.state == IopThreadState::RpcWait,
+                    "stack-backed Call16 did not install its wait");
+            const ReverseRpcCompletionEndpoint affectedEndpoint = fixture.host.endpoint;
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "stack-backed endpoint was not current immediately after admission");
+            std::array<uint8_t, 40> clientBefore{};
+            std::array<uint8_t, 64> replyBefore{};
+            require(fixture.memory.readRam(retiredClient, clientBefore.data(), clientBefore.size()) &&
+                        fixture.memory.readRam(retiredReply, replyBefore.data(), replyBefore.size()),
+                    "stack-backed canary read failed");
+
+            fixture.prepare();
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "neighbor setup changed stack-backed endpoint identity");
+            fixture.startThread(neighborId);
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "starting neighbor changed stack-backed endpoint identity");
+            IopThread &neighbor = fixture.runThread();
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "scheduling neighbor changed stack-backed endpoint identity");
+            require(fixture.call16(neighbor.cpu), "neighbor Call16 failed");
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "neighbor Call16 changed stack-backed endpoint identity");
+            const ReverseRpcCompletionEndpoint neighborEndpoint = fixture.host.endpoint;
+            require(affectedEndpoint.isCurrent && affectedEndpoint.isCurrent(),
+                    "stack-backed endpoint was not current before retirement");
+            require(neighborEndpoint.isCurrent && neighborEndpoint.isCurrent(),
+                    "neighbor endpoint was not current before retirement");
+
+            if (cleanupDead)
+                fixture.kernel.cleanupDeadThreads();
+            else
+            {
+                fixture.control = {};
+                fixture.control.gpr[4] = static_cast<uint32_t>(victimId);
+                require(fixture.kernel.dispatchThreadImport(5u, fixture.control, 0u), "DeleteThread was not handled");
+                require(fixture.control.gpr[2] == 0u, "DeleteThread failed");
+            }
+
+            require(!fixture.memory.ownsRamRange(retiredClient, 40u) &&
+                        !fixture.memory.ownsRamRange(retiredReply, 64u),
+                    "victim stack backing was not retired");
+            require(affected.state == IopThreadState::Ready,
+                    "stack retirement did not wake the affected wait");
+            require(static_cast<int32_t>(affected.cpu.gpr[2]) == kFailure,
+                    "stack retirement supplied the wrong affected result");
+            require(neighbor.state == IopThreadState::RpcWait && neighborEndpoint.isCurrent && neighborEndpoint.isCurrent(),
+                    "stack retirement revoked the non-overlapping neighbor");
+            require(affectedEndpoint.isCurrent && !affectedEndpoint.isCurrent(),
+                    "stack retirement retained affected endpoint authority");
+            require(fixture.kernel.threadCount() == 2u,
+                    "stack retirement corrupted kernel iteration state");
+            affectedEndpoint.complete(0, patternedReply());
+            std::array<uint8_t, 40> clientAfter{};
+            std::array<uint8_t, 64> replyAfter{};
+            require(fixture.memory.readRam(retiredClient, clientAfter.data(), clientAfter.size()) &&
+                        fixture.memory.readRam(retiredReply, replyAfter.data(), replyAfter.size()) &&
+                        clientAfter == clientBefore && replyAfter == replyBefore &&
+                        !fixture.memory.ownsRamRange(retiredClient, 40u) &&
+                        !fixture.memory.ownsRamRange(retiredReply, 64u),
+                    "late stack-backed completion restored retired ownership or bytes");
+            neighborEndpoint.complete(0, patternedReply());
+            require(neighbor.state == IopThreadState::Ready && neighbor.cpu.gpr[2] == 0u,
+                    "non-overlapping neighbor did not survive stack retirement");
+        };
+
+        run(false);
+        run(true);
+    }
+
+    void verifyLifecycleAndSuspension()
+    {
+        Fixture directReset;
+        directReset.prepare();
+        const int directResetId = directReset.createThread();
+        directReset.startThread(directResetId);
+        IopThread &directResetThread = directReset.runThread();
+        const auto directResetBefore = directReset.reply();
+        require(directReset.call16(directResetThread.cpu), "direct-reset Call16 failed");
+        const ReverseRpcCompletionEndpoint directResetEndpoint = directReset.host.endpoint;
+        directReset.bridge.reset();
+        require(directResetThread.state == IopThreadState::Ready && static_cast<int32_t>(directResetThread.cpu.gpr[2]) == kFailure &&
+                    directReset.reply() == directResetBefore && directResetEndpoint.isCurrent && !directResetEndpoint.isCurrent(),
+                "direct bridge reset orphaned an owned worker or retained endpoint validity");
+
+        Fixture reset;
+        reset.prepare();
+        const int resetId = reset.createThread();
+        reset.startThread(resetId);
+        IopThread &resetThread = reset.runThread();
+        const auto resetBefore = reset.reply();
+        require(reset.call16(resetThread.cpu), "reset Call16 failed");
+        reset.endSlice(resetThread);
+        reset.kernel.reset();
+        reset.bridge.reset();
+        reset.host.complete(0, patternedReply());
+        require(reset.reply() == resetBefore, "late reset completion changed reply");
+
+        Fixture restart;
+        restart.prepare();
+        const int restartId = restart.createThread();
+        restart.startThread(restartId);
+        IopThread &restartThread = restart.runThread();
+        const auto restartBefore = restart.reply();
+        require(restart.call16(restartThread.cpu), "restart Call16 failed");
+        restart.endSlice(restartThread);
+        restart.startThread(restartId);
+        restart.host.complete(0, patternedReply());
+        require(restart.reply() == restartBefore, "restart retained late endpoint");
+
+        Fixture deleted;
+        deleted.prepare();
+        const int deleteId = deleted.createThread();
+        deleted.startThread(deleteId);
+        IopThread &deleteThread = deleted.runThread();
+        const auto deleteBefore = deleted.reply();
+        require(deleted.call16(deleteThread.cpu), "delete Call16 failed");
+        deleted.endSlice(deleteThread);
+        deleted.control = {};
+        deleted.control.gpr[4] = static_cast<uint32_t>(deleteId);
+        require(deleted.kernel.dispatchThreadImport(5u, deleted.control, 0u), "DeleteThread failed");
+        deleted.host.complete(0, patternedReply());
+        require(deleted.reply() == deleteBefore, "deleted worker accepted late completion");
+
+        Fixture unloaded;
+        unloaded.prepare();
+        const int unloadId = unloaded.createThread();
+        unloaded.startThread(unloadId);
+        IopThread &unloadThread = unloaded.runThread();
+        const auto unloadBefore = unloaded.reply();
+        require(unloaded.call16(unloadThread.cpu), "unload Call16 failed");
+        unloaded.endSlice(unloadThread);
+        unloaded.kernel.terminateThreadsInRange(kEntry, 4u);
+        unloaded.kernel.cleanupDeadThreads();
+        unloaded.bridge.removeServersInRange(kEntry, 4u);
+        unloaded.host.complete(0, patternedReply());
+        require(unloaded.reply() == unloadBefore, "unload accepted late completion");
+
+        Fixture suspended;
+        suspended.prepare();
+        const int suspendedId = suspended.createThread();
+        suspended.startThread(suspendedId);
+        IopThread &suspendedThread = suspended.runThread();
+        require(suspended.call16(suspendedThread.cpu), "suspended Call16 failed");
+        suspended.endSlice(suspendedThread);
+        suspended.control = {};
+        suspended.control.gpr[4] = static_cast<uint32_t>(suspendedId);
+        require(suspended.kernel.dispatchThreadImport(29u, suspended.control, 0u), "SuspendThread failed");
+        const auto expected = patternedReply();
+        suspended.host.complete(0, expected);
+        require(suspendedThread.state == IopThreadState::Suspended && suspended.reply() == expected,
+                "suspended completion did not retain result");
+        suspended.control = {};
+        suspended.control.gpr[4] = static_cast<uint32_t>(suspendedId);
+        require(suspended.kernel.dispatchThreadImport(25u, suspended.control, 0u), "unrelated WakeupThread failed");
+        require(suspendedThread.state == IopThreadState::Suspended, "unrelated wake resumed completed suspended RPC");
+        suspended.control = {};
+        suspended.control.gpr[4] = static_cast<uint32_t>(suspendedId);
+        require(suspended.kernel.dispatchThreadImport(31u, suspended.control, 0u), "ResumeThread failed");
+        require(suspendedThread.state == IopThreadState::Ready && suspendedThread.cpu.gpr[2] == 0u,
+                "resume did not consume suspended completion");
+    }
+
+    void verifyDestructionLease()
+    {
+        Host host;
+        IopMemory memory;
+        IopKernel kernel{memory};
+        std::array<uint32_t, 10> client{};
+        client[5] = kBuffer;
+        client[9] = kServer;
+        const auto send = patternedReply();
+        const std::array<uint32_t, 5> args{40u, kReply, 64u, 0u, 0u};
+        std::array<uint8_t, 36> stackBytes{};
+        std::memcpy(stackBytes.data() + 16u, args.data(), sizeof(args));
+        require(memory.writeRam(kClient, client.data(), sizeof(client)) && memory.writeRam(kSend, send.data(), 40u) &&
+                    memory.writeRam(kReply, send.data(), 64u) && memory.writeRam(kStack, stackBytes.data(), stackBytes.size()),
+                "destruction setup failed");
+        memory.write32(kDescriptor + 8u, kEntry);
+        memory.write32(kDescriptor + 12u, 0x400u);
+        memory.write32(kDescriptor + 16u, 10u);
+        IopCpuState control{};
+        control.gpr[4] = kDescriptor;
+        require(kernel.dispatchThreadImport(4u, control, 0u), "destruction CreateThread failed");
+        const int id = static_cast<int>(control.gpr[2]);
+        control = {};
+        control.gpr[4] = static_cast<uint32_t>(id);
+        require(kernel.dispatchThreadImport(7u, control, 0u), "destruction StartThread failed");
+        IopThread *thread = kernel.beginNextReady(0u);
+        require(thread != nullptr, "destruction worker did not run");
+        const auto before = [&]
+        {
+            std::array<uint8_t, 64> bytes{};
+            require(memory.readRam(kReply, bytes.data(), bytes.size()), "destruction reply read failed");
+            return bytes;
+        }();
+        {
+            IopRpcBridge bridge{host, memory, kernel};
+            thread->cpu.gpr[4] = kClient;
+            thread->cpu.gpr[5] = 0u;
+            thread->cpu.gpr[6] = 0u;
+            thread->cpu.gpr[7] = kSend;
+            thread->cpu.gpr[29] = kStack;
+            require(bridge.dispatchSifCmdImport(16u, thread->cpu), "destruction Call16 failed");
+        }
+        host.complete(0, patternedReply());
+        std::array<uint8_t, 64> after{};
+        require(memory.readRam(kReply, after.data(), after.size()) && after == before &&
+                    thread->state == IopThreadState::Ready && static_cast<int32_t>(thread->cpu.gpr[2]) == kFailure &&
+                    host.endpoint.isCurrent && !host.endpoint.isCurrent(),
+                "destroyed bridge callback retained memory or orphaned its wait");
+    }
+}
+
+int main()
+{
+    try
+    {
+        verifyMipsImportPipelineContinuation();
+        verifyDeferredAndExactCompletion();
+        verifyInvalidCompletionsPreserveReply();
+        verifyAdmissionRejections();
+        verifyAdmissionGuard();
+        verifyHostFailureAndDetachedCpu();
+        verifyAliasAndConcurrentClientOwnership();
+        verifyRebindAndIdentityRevocation();
+        verifyBackingRetirement();
+        verifyRetirementRegistration();
+        verifyKernelStackRetirement();
+        verifyLifecycleAndSuspension();
+        verifyDestructionLease();
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "FAIL: " << error.what() << '\n';
+        return 1;
+    }
+    return 0;
+}
