+            constexpr uint32_t createThreadStub = kBase + thbaseTable + 20u;
+            constexpr uint32_t startThreadStub = createThreadStub + 8u;
+            constexpr uint32_t call16Stub = kBase + sifcmdTable + 20u;
+            words(0u, {
