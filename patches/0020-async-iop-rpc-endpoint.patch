+    void verifyDeferredAndExactCompletion()
+    {
+        Fixture fixture;
+        fixture.prepare();
+        const int id = fixture.createThread();
+        fixture.startThread(id);
+        IopThread &thread = fixture.runThread();
+        const uint32_t continuation = thread.cpu.pc;
+        const auto before = fixture.reply();
+        require(fixture.call16(thread.cpu), "Call16 was not handled");
+        require(thread.state == IopThreadState::RpcWait && thread.cpu.yielded, "Call16 did not start owned wait");
+        require(fixture.host.endpoint.isCurrent && fixture.host.endpoint.isCurrent(),
+                "deferred host endpoint was not current before delivery");
+        require(thread.cpu.pc == continuation, "Call16 changed continuation before completion");
+        require(fixture.host.submissions == 1u && fixture.host.lastRequest.clientAddress == kClient &&
+                    fixture.host.lastRequest.receiveAddress == kReply && fixture.host.lastRequest.serverAddress == kServer &&
+                    fixture.host.lastRequest.bufferAddress == kBuffer && fixture.host.lastRequest.function == 0u &&
+                    fixture.host.lastRequest.mode == 0u && fixture.host.lastRequest.send[0] == 0x20u,
+                "host did not receive immutable observed request values");
+        require(fixture.reply() == before, "admission changed reply memory");
+        const auto expected = patternedReply();
+        fixture.host.complete(0, expected);
+        require(thread.state == IopThreadState::Ready && thread.cpu.gpr[2] == 0u && fixture.reply() == expected,
+                "exact deferred completion did not commit reply and resume once");
+        require(!fixture.host.endpoint.isCurrent(), "completed endpoint remained current");
+        fixture.host.complete(0, expected);
+        require(fixture.reply() == expected && thread.cpu.gpr[2] == 0u, "duplicate completion changed result");
+    }
