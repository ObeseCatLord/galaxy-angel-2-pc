+
+        // Anime4K over a picture rendered above 640x448 (2x / 4x internal resolution) in a 2D scene: the network
+        // runs on the picture box-filtered back to the game's size (the 2D art's own detail), and the result is
+        // combined with the full picture wherever that has detail the small one lacks (the vector font's text,
+        // HD button prompts and replacement textures), so those stay as rendered.
+        const char *kBoxDown = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform vec2 srcSize;
+uniform int factor;
+out vec4 finalColor;
+void main() {
+    vec2 base = floor(fragTexCoord * srcSize / float(factor)) * float(factor);
+    vec4 sum = vec4(0.0);
+    for (int y = 0; y < factor; ++y)
+        for (int x = 0; x < factor; ++x)
+            sum += texelFetch(texture0, ivec2(base) + ivec2(x, y), 0);
+    // Opaque: the frame's alpha is the PS2's (0x80 = 0.5), and blending it into the target would darken the picture.
+    finalColor = vec4(sum.rgb / float(factor * factor), 1.0);
+})";
+        const char *kDetailMix = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;   // Anime4K of the small picture
+uniform sampler2D fullPicture; // the picture as rendered
+uniform sampler2D smallPicture;
+uniform vec2 fullSize;
+out vec4 finalColor;
+void main() {
+    vec2 uv = fragTexCoord;
+    float detail = 0.0;
+    for (int y = -1; y <= 1; ++y)
+        for (int x = -1; x <= 1; ++x) {
+            vec2 o = vec2(x, y) / fullSize;
+            vec3 d = abs(texture(fullPicture, uv + o).rgb - texture(smallPicture, uv + o).rgb);
+            detail = max(detail, max(d.r, max(d.g, d.b)));
+        }
+    float m = smoothstep(0.08, 0.22, detail);
+    finalColor = vec4(mix(texture(texture0, uv).rgb, texture(fullPicture, uv).rgb, m), 1.0);
+})";
+        Shader g_boxDown{}, g_detailMix{};
+        bool g_detailLoaded = false;
+        RenderTexture2D g_small{}, g_mixed{};
+
+        // A render target of this size (made again when the size changes).
+        void ensureTarget(RenderTexture2D &target, int width, int height)
+        {
+            if (target.id && target.texture.width == width && target.texture.height == height)
+                return;
+            if (target.id)
+                UnloadRenderTexture(target);
+            target = LoadRenderTexture(width, height);
+            SetTextureFilter(target.texture, TEXTURE_FILTER_BILINEAR);
+        }
+
+        // Draws `texture` (width x height) over the whole of `target`, keeping its orientation.
+        void drawInto(RenderTexture2D &target, uint32_t texture, int width, int height)
+        {
+            BeginTextureMode(target);
+            ClearBackground(BLANK);
+            const Texture2D t{texture, width, height, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+            DrawTexturePro(t, Rectangle{0.0f, 0.0f, float(width), -float(height)},
+                           Rectangle{0.0f, 0.0f, float(target.texture.width), float(target.texture.height)}, Vector2{0, 0},
+                           0.0f, WHITE);
+            EndTextureMode();
+        }
         RenderTexture2D g_blur[3]{};
         Texture2D g_skybox{};
 
@@ -208,6 +275,17 @@ vec4 hook() {
     ivec2 size = ivec2(HOOKED_size);
     ivec2 p = min(ivec2(HOOKED_pos * HOOKED_size), size - 1);
     vec4 c0 = texelFetch(HOOKED_raw, p, 0);
+    // Text and sharp lines are left alone: a pixel near a strong edge (a step far larger than a 16-bit band, in
+    // the 5x5 around it, scaled with the picture) keeps its colour, so letters and their anti-aliasing stay
+    // crisp while the flat gradients around them are smoothed.
+    int guard = max(1, int(round(2.0 * HOOKED_size.y / 448.0)));
+    for (int gy = -2; gy <= 2; ++gy)
+        for (int gx = -2; gx <= 2; ++gx) {
+            vec3 e = texelFetch(HOOKED_raw, clamp(p + ivec2(gx, gy) * guard / 2, ivec2(0), size - 1), 0).rgb;
+            vec3 de = abs(e - c0.rgb);
+            if (max(de.r, max(de.g, de.b)) > 0.2)
+                return c0;
+        }
     float radius = DB_RADIUS * HOOKED_size.y * (1.0 / 448.0);
     uint state = pcg(uint(p.x) + pcg(uint(p.y)));
     vec3 sum = c0.rgb;
@@ -590,11 +668,72 @@ namespace ga2_present
         if (g_ready && g_chain && !scene3d && sizesMatch)
         {
             rlDrawRenderBatchActive();
+            // Above the game's size (2x / 4x): the network sees the picture at the game's size, and the detail
+            // only the full picture has is put back afterwards (kDetailMix). GA2_FILTER_FULL=1 runs it on the
+            // full picture instead (diagnostics).
+            static const bool full = std::getenv("GA2_FILTER_FULL") != nullptr;
+            const int factor = std::max(1, frame.width / 640);
+            const bool hires = factor > 1 && !full;
+            if (hires && !g_detailLoaded)
+            {
+                g_boxDown = LoadShaderFromMemory(nullptr, kBoxDown);
+                g_detailMix = LoadShaderFromMemory(nullptr, kDetailMix);
+                g_detailLoaded = IsShaderValid(g_boxDown) && IsShaderValid(g_detailMix);
+            }
+            uint32_t input = frame.id;
+            int inputW = frame.width, inputH = frame.height;
+            if (hires && g_detailLoaded)
+            {
+                ensureTarget(g_small, frame.width / factor, frame.height / factor);
+                const float size[2] = {float(frame.width), float(frame.height)};
+                SetShaderValue(g_boxDown, GetShaderLocation(g_boxDown, "srcSize"), size, SHADER_UNIFORM_VEC2);
+                SetShaderValue(g_boxDown, GetShaderLocation(g_boxDown, "factor"), &factor, SHADER_UNIFORM_INT);
+                BeginShaderMode(g_boxDown);
+                drawInto(g_small, frame.id, frame.width, frame.height);
+                EndShaderMode();
+                input = g_small.texture.id;
+                inputW = g_small.texture.width;
+                inputH = g_small.texture.height;
+            }
             int w = 0, h = 0;
-            const uint32_t result =
-                g_chain->run(frame.id, frame.width, frame.height, int(picture.width), int(picture.height), w, h);
+            const uint32_t result = g_chain->run(input, inputW, inputH, int(picture.width), int(picture.height), w, h);
             glViewport(0, 0, GetRenderWidth(), GetRenderHeight());
-            if (result)
+            if (result && hires && g_detailLoaded)
+            {
+                // At the size it is shown at, so the full picture's text keeps all its detail (the network's
+                // output, 2x the small picture, is scaled up to it).
+                const int mixW = std::max(w, int(picture.width)), mixH = std::max(h, int(picture.height));
+                ensureTarget(g_mixed, mixW, mixH);
+                // The extra textures are bound after the target is begun (beginning it flushes the batch, which
+                // drops textures bound for the next draw).
+                BeginTextureMode(g_mixed);
+                ClearBackground(BLANK);
+                BeginShaderMode(g_detailMix);
+                const float fullSize[2] = {float(frame.width), float(frame.height)};
+                SetShaderValue(g_detailMix, GetShaderLocation(g_detailMix, "fullSize"), fullSize, SHADER_UNIFORM_VEC2);
+                SetShaderValueTexture(g_detailMix, GetShaderLocation(g_detailMix, "fullPicture"), frame);
+                SetShaderValueTexture(g_detailMix, GetShaderLocation(g_detailMix, "smallPicture"), g_small.texture);
+                const Texture2D networkOut{result, w, h, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                DrawTexturePro(networkOut, Rectangle{0.0f, 0.0f, float(w), -float(h)},
+                               Rectangle{0.0f, 0.0f, float(mixW), float(mixH)}, Vector2{0, 0}, 0.0f, WHITE);
+                EndShaderMode();
+                EndTextureMode();
+                glViewport(0, 0, GetRenderWidth(), GetRenderHeight());
+                shown = g_mixed.texture;
+                source = Rectangle{0.0f, 0.0f, float(mixW), float(mixH)};
+                // GA2_FILTER_DUMP=<dir> (diagnostics): the small picture, the network's output and the mix, now and then.
+                static const char *dump = std::getenv("GA2_FILTER_DUMP");
+                static int mixed = 0;
+                if (dump && *dump && ++mixed % 120 == 0)
+                {
+                    const std::string base = std::string(dump) + "/" + std::to_string(mixed);
+                    dumpPicture(g_small.texture.id, g_small.texture.width, g_small.texture.height, base + "-small.ppm");
+                    dumpPicture(result, w, h, base + "-a4k.ppm");
+                    dumpPicture(g_mixed.texture.id, mixW, mixH, base + "-mix.ppm");
+                    dumpPicture(frame.id, frame.width, frame.height, base + "-full.ppm");
+                }
+            }
+            else if (result)
             {
                 shown = Texture2D{result, w, h, 1, PIXELFORMAT_UNCOMPRESSED_R16G16B16A16};
                 source = Rectangle{0.0f, 0.0f, float(w), float(h)};
diff --git a/ps2xRuntime/src/lib/gs/gs_pgs.cpp b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
