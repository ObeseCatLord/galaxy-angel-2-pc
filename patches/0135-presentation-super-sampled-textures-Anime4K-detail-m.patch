         options.super_sampling = r >= 16 ? SuperSampling::X16 : r >= 8 ? SuperSampling::X8
                                  : r >= 4 ? SuperSampling::X4 : r >= 2 ? SuperSampling::X2 : SuperSampling::X1;
         s.ssaa = static_cast<uint32_t>(options.super_sampling);
+        // Super-sampled textures: a sprite that copies a rendered buffer (a 2D scene composed off screen, then
+        // blitted to the display buffer) keeps the buffer's samples, so the vector text, the HD button icons and
+        // replacement textures of 2D scenes reach the screen at the internal resolution, not 640x448.
+        // GA2_PGS_SS_TEXTURES=0 turns it off.
+        options.super_sampled_textures = envInt("GA2_PGS_SS_TEXTURES", 1) != 0;
         const GSOptions eyeOptions = options;
         if (!s.eyes[0].gs.init(&s.eyes[0].device, options))
         {
diff --git a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
index 50eba33..e693570 100644
--- a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
@@ -34,6 +34,7 @@ namespace ga2_text_icons
 #include "gs_interface.hpp"
 
 #include <algorithm>
+#include <cmath>
 #include <array>
 #include <atomic>
 #include <chrono>
@@ -164,23 +165,36 @@ namespace ga2_texpacks
                 const ::Image *art = icon(spot.button, ga2_buttonmatch::wideSpot(spot.w, spot.h));
                 if (!art)
                     continue;
-                // Cover the PS2 icon with the colour around it, then draw ours.
-                uint64_t sum[4] = {};
-                int n = 0;
-                for (int y = spot.y - 1; y <= spot.y + spot.h; ++y)
-                    for (int x = spot.x - 1; x <= spot.x + spot.w; ++x)
+                // Cover the PS2 icon with what is around it, then draw ours: each pixel blends the border pixels of
+                // its row (left to right) and of its column (top to bottom), so a gradient or pattern behind the icon
+                // continues through the spot instead of showing a flat block around our icon.
+                auto at = [&](int x, int y) {
+                    x = std::clamp(x, 0, int(w) - 1);
+                    y = std::clamp(y, 0, int(h) - 1);
+                    return base[size_t(y) * w + size_t(x)];
+                };
+                auto channel = [](uint32_t c, int i) { return float((c >> (8 * i)) & 255u); };
+                const int x0 = spot.x * k, y0 = spot.y * k, sw = spot.w * k, sh = spot.h * k;
+                for (int Y = 0; Y < sh; ++Y)
+                    for (int X = 0; X < sw; ++X)
                     {
-                        const bool border = y == spot.y - 1 || y == spot.y + spot.h || x == spot.x - 1 || x == spot.x + spot.w;
-                        if (!border || x < 0 || y < 0 || x >= int(w) || y >= int(h))
-                            continue;
-                        const uint32_t c = base[size_t(y) * w + size_t(x)];
+                        const float u = (float(X) + 0.5f) / float(sw), v = (float(Y) + 0.5f) / float(sh);
+                        const int row = spot.y + std::min(spot.h - 1, int(v * float(spot.h)));
+                        const int col = spot.x + std::min(spot.w - 1, int(u * float(spot.w)));
+                        const uint32_t L = at(spot.x - 1, row), R = at(spot.x + spot.w, row);
+                        const uint32_t T = at(col, spot.y - 1), B = at(col, spot.y + spot.h);
+                        // Nearer borders weigh more: the horizontal blend by how close a side is, likewise vertical.
+                        const float dh = std::min(u, 1.0f - u), dv = std::min(v, 1.0f - v);
+                        const float wh = dv / std::max(1e-3f, dh + dv);
+                        uint8_t c[4];
                         for (int i = 0; i < 4; ++i)
-                            sum[i] += (c >> (8 * i)) & 255u;
-                        ++n;
+                        {
+                            const float horizontal = channel(L, i) * (1.0f - u) + channel(R, i) * u;
+                            const float vertical = channel(T, i) * (1.0f - v) + channel(B, i) * v;
+                            c[i] = uint8_t(std::lround(std::clamp(horizontal * wh + vertical * (1.0f - wh), 0.0f, 255.0f)));
+                        }
+                        ImageDrawPixel(&out, x0 + X, y0 + Y, Color{c[0], c[1], c[2], c[3]});
                     }
-                const Color fill = n ? Color{uint8_t(sum[0] / n), uint8_t(sum[1] / n), uint8_t(sum[2] / n), uint8_t(sum[3] / n)}
-                                     : Color{0, 0, 0, 0};
-                ImageDrawRectangle(&out, spot.x * k, spot.y * k, spot.w * k, spot.h * k, fill);
                 // The icon's visible part, fitted into the spot keeping its shape.
                 ga2_buttonmatch::drawIconFitted(out, *art, float(spot.x * k), float(spot.y * k), float(spot.w * k),
                                                 float(spot.h * k));
