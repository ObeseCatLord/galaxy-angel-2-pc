     m_invocationStackTops.clear();
@@ -469,6 +469,19 @@ void EeScheduler::requestStop()
 
 void EeScheduler::postEventAfterCycles(EeEvent event, uint64_t cycles)
 {
+    // m_eeCycle is owned by the executor thread. Device code (GS interrupt
+    // sink, DMA completion) calls this from the game thread today; a caller on
+    // any other thread (a future GS render thread, the debug panel) has no
+    // coherent cycle clock to offset from, so the event is queued for the next
+    // checkpoint instead of reading the clock racily.
+    if (m_executorThread.load(std::memory_order_acquire) != std::this_thread::get_id())
+    {
+        static std::atomic<bool> warned{false};
+        if (!warned.exchange(true, std::memory_order_relaxed))
+            std::fprintf(stderr, "[ee] postEventAfterCycles from a non-executor thread: delivered at the next checkpoint without a cycle delay\n");
+        postEvent(event);
+        return;
+    }
     scheduleEvent(m_eeCycle + cycles, std::chrono::steady_clock::now(), event);
 }
 
@@ -1533,6 +1546,11 @@ void EeScheduler::validateInvocationStackDeclaration(uint32_t address, uint32_t
         throw std::runtime_error("EE stack or heap declaration is not a bounded RAM range");
     validateInvocationStackArenaClaim(address, bytes);
     const uint64_t end = uint64_t(begin) + bytes;
+    // The native SDK pools (RPC packets/servers, TLS, boot mode) are fixed
+    // kernel-RAM claims like the arena: a guest stack inside them is corrupted
+    // by, and corrupts, the runtime's own records.
+    if (begin < ps2_kernel_ram::kNativeSdkPoolEnd && end > ps2_kernel_ram::kNativeSdkPoolBase)
+        throw std::runtime_error("EE stack or heap declaration overlaps the native SDK kernel-RAM pools");
     const auto validate = [begin, end](const GuestInvocation &invocation)
     {
         if (invocation.stackReservationBegin < invocation.stackReservationEnd &&
@@ -1675,6 +1693,18 @@ EeScheduler::InvocationStackChoice EeScheduler::selectInvocationStack()
     }
     validateIsolatedInvocationStack(top);
     m_invocationStackTops.emplace(key, top);
+    if (m_invocationStackArenaEnd > m_invocationStackArenaBegin)
+    {
+        // Exhaustion with every slot live still ends the session (see the throw
+        // above), so say so when the last slot is taken.
+        const size_t capacity = (m_invocationStackArenaEnd - m_invocationStackArenaBegin) / kInvocationStackSize;
+        static bool warned = false;
+        if (!warned && m_invocationStackTops.size() >= capacity)
+        {
+            warned = true;
+            std::fprintf(stderr, "[ee] invocation stack arena at capacity: all %zu slots are keyed (owner/depth)\n", capacity);
+        }
+    }
     return {top, top + 0x10u - kInvocationStackSize, top + 0x10u};
 }
 
