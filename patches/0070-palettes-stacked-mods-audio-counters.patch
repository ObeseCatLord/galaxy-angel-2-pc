diff --git a/ps2xRuntime/include/runtime/gs/gs_clut_snapshot.h b/ps2xRuntime/include/runtime/gs/gs_clut_snapshot.h
new file mode 100644
index 0000000..4d826b6
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_clut_snapshot.h
@@ -0,0 +1,13 @@
+// The CPU GS backend's CLUT buffer (as loaded by TEX0.CLD), for code that
+// decodes paletted textures outside the CPU rasterizer (gs_texpacks).
+#pragma once
+
+#include <array>
+#include <cstdint>
+
+namespace ga2_gs
+{
+    // 512 16-bit halves: CT32 entry i = lo[i] | hi[i + 256] << 16, CT16 entry
+    // i = lo[i] (as GSCpuBackend stores them). False without a CPU backend.
+    bool clutSnapshot(std::array<uint16_t, 512> &out);
+}
diff --git a/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h b/ps2xRuntime/include/runtime/gs/gs_cpu_backend.h
index cbd4c7a..775f40c 100644
