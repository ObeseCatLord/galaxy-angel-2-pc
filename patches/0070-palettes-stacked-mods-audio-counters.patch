+    // GA2_PERF: output queue health every 5 s (underruns and drops are audible
+    // as clicks).
+    static const bool perf = [] { const char *v = std::getenv("GA2_PERF"); return v && *v && *v != '0'; }();
+    static auto lastReport = std::chrono::steady_clock::now();
+    if (perf && std::chrono::steady_clock::now() - lastReport > std::chrono::seconds(5))
+    {
+        lastReport = std::chrono::steady_clock::now();
+        std::lock_guard callbackLock(Impl::callbackMutex);
+        std::fprintf(stderr, "[audio] queued %zu frames, underruns %llu (%llu frames), dropped %llu frames\n",
+                     m_impl->pcm.queuedFrames(), (unsigned long long)m_impl->pcm.underruns(),
+                     (unsigned long long)m_impl->pcm.underrunFrames(), (unsigned long long)m_impl->pcm.droppedFrames());
+    }
     return observe(result);
 #endif
