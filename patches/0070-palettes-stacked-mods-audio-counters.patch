@@ -1,5 +1,6 @@
 #include "runtime/gs/gs_pgs.h"
 #include "runtime/gs/gs_cpu_backend.h"
+#include "runtime/gs/gs_clut_snapshot.h"
 #include "runtime/gs/ps2_gs_common.h"
 #include "runtime/gs/ps2_gs_psmct16.h"
 #include "runtime/gs/ps2_gs_psmct32.h"
@@ -443,8 +444,26 @@ namespace
     }
 }
 
+namespace
+{
+    GSCpuBackend *g_clutOwner = nullptr; // the backend whose CLUT buffer clutSnapshot reads
+}
+
+bool ga2_gs::clutSnapshot(std::array<uint16_t, 512> &out)
+{
+    return g_clutOwner && g_clutOwner->copyClut(out);
+}
+
+bool GSCpuBackend::copyClut(std::array<uint16_t, 512> &out)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    out = m_clut;
+    return true;
+}
+
 GSCpuBackend::GSCpuBackend()
 {
+    g_clutOwner = this;
     using namespace GSMem;
     static std::once_flag lookupTablesOnce;
     std::call_once(lookupTablesOnce, []()
