+                // The icon's visible part, fitted into the spot keeping its shape.
+                const Rectangle src = GetImageAlphaBorder(*art, 0.05f);
+                const float scale = std::min(spot.w * k / src.width, spot.h * k / src.height);
+                const float dw = src.width * scale, dh = src.height * scale;
+                const Rectangle dst{spot.x * k + (spot.w * k - dw) * 0.5f, spot.y * k + (spot.h * k - dh) * 0.5f, dw, dh};
+                ImageDraw(&out, *art, src, dst, WHITE);
                 drew = true;
             }
             return drew;
@@ -204,7 +208,25 @@ namespace ga2_texpacks
             out.resize(size_t(w) * h);
             uint32_t palette[256] = {};
             const bool p8 = psm == 0x13u || psm == 0x1Bu, p4 = psm == 0x14u || psm == 0x24u || psm == 0x2Cu;
-            if (p8 || p4)
+            const uint32_t cld = uint32_t((tex0 >> 61) & 7u), csm = uint32_t((tex0 >> 55) & 1u), csa = uint32_t((tex0 >> 56) & 0x1Fu);
+            std::array<uint16_t, 512> buffer{};
+            if ((p8 || p4) && cld == 0u && ga2_gs::clutSnapshot(buffer))
+            {
+                // The palette loaded earlier (CLD = 0 reuses the GS CLUT buffer),
+                // looked up like GSCpuBackend::LookupCLUT.
+                const bool sixteen = cpsm == 0x02u || cpsm == 0x0Au;
+                const uint32_t base = (csa & (sixteen ? 0x1Fu : 0x0Fu)) << 4;
+                for (uint32_t i = 0; i < (p8 ? 256u : 16u); ++i)
+                {
+                    uint32_t index = (base + i) & (sixteen ? 0x1FFu : 0xFFu);
+                    if (!sixteen && csm == 0u && p8)
+                        index = std::min((i & 0xF0u) + base, 240u) + (i & 0x0Fu);
+                    const uint32_t raw = uint32_t(buffer[index]) | uint32_t(buffer[index + 256u]) << 16;
+                    palette[i] = sixteen ? expand16(buffer[index]) : cpsm == 0x01u ? (raw & 0x00FFFFFFu) | 0x80000000u : raw;
+                }
+            }
+            else if (p8 || p4)
+                // This TEX0 loads its palette from CBP now (CSM1 layout).
                 for (uint32_t i = 0; i < (p8 ? 256u : 16u); ++i)
                     palette[i] = clutEntry(vram, cbp, cpsm, p8, i);
             for (uint32_t oy = 0; oy < h; ++oy)
