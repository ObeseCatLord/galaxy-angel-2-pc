diff --git a/ps2xIOP/tests/iop_module_boundaries.inc b/ps2xIOP/tests/iop_module_boundaries.inc
new file mode 100644
index 0000000..474c49d
--- /dev/null
+++ b/ps2xIOP/tests/iop_module_boundaries.inc
@@ -0,0 +1,107 @@
+// Included by the existing private emulator boundary-test target only.
+//
+// Module lifecycle: stopping (or a NO_RESIDENT_END start) revokes everything
+// the image registered and returns its memory, so repeated load/unload cycles
+// cannot exhaust the pool.
+#include "iop_compat_test_support.h"
+namespace ps2x::iop::detail
+{
+    bool testIopModuleBoundaries()
+    {
+        using State = IopEmulator::Impl;
+        const auto require = [](bool b, const char *s) { if (!b) throw std::runtime_error(s); };
+        const auto jal = [](uint32_t t) { return 0x0C000000u | (t >> 2); };
+        // A module that registers an interrupt handler (IRQ 0x28), enables it,
+        // arms an alarm and registers an RPC server, then returns `residency`.
+        // The image lives inside the heap range so the loader reserves (and
+        // the unload must return) a tracked block.
+        constexpr uint32_t kBase = 0x130000u;
+        const auto module = [&](uint32_t residency, uint32_t imageBytes, bool callbacks = true)
+        {
+            iop_test::Irx image(kBase, imageBytes);
+            image.words(0x100u, {0x41E00000u, 0u, 0x0104u, 0x72746E69u, 0x006E616Du}); // "intrman"
+            for (uint32_t n = 0; n <= 8; ++n) image.words(0x114u + n * 8u, {0x03E00008u, 0x24000000u | n});
+            image.words(0x200u, {0x41E00000u, 0u, 0x0101u, 0x61626874u, 0x00006573u}); // "thbase"
+            for (uint32_t n = 0; n <= 40; ++n) image.words(0x214u + n * 8u, {0x03E00008u, 0x24000000u | n});
+            if (callbacks) image.words(0u, {
+                0x27BDFFE0u, 0xAFBF001Cu,
+                0x34040028u, 0x00002821u, 0x3C060000u | (kBase >> 16u), 0x34C60300u, 0x00003821u, jal(kBase + 0x100u + 20u + 4u * 8u), 0u, // RegisterIntrHandler
+                0x34040028u, jal(kBase + 0x100u + 20u + 6u * 8u), 0u,                                                   // EnableIntr
+                0x3C040000u | (kBase >> 16u), 0x34840400u, 0x3C050000u | (kBase >> 16u), 0x34A50300u, 0x00003021u, jal(kBase + 0x200u + 20u + 35u * 8u), 0u, // SetAlarm
+                0x8FBF001Cu, 0x27BD0020u, 0x03E00008u, 0x34020000u | residency,
+            });
+            else image.words(0u, {0x03E00008u, 0x34020000u | residency}); // initialiser only
+            image.words(0x300u, {0x03E00008u, 0x00001021u}); // handler: return 0
+            image.words(0x400u, {0x00100000u, 0u});          // alarm clock: long delay
+            return image;
+        };
+        try
+        {
+            for (uint32_t residency : {0u, 1u})
+            {
+                iop_test::Host h; State s(h);
+                const uint32_t freeBefore = s.memory.totalFreeMemory();
+                for (unsigned cycle = 0; cycle != 4u; ++cycle)
+                {
+                    // Resident: registrations are revoked and memory returned by stopModule.
+                    // Non-resident initialiser: memory is returned as soon as start returns.
+                    const auto image = module(residency, 0x40000u, residency == 0u);
+                    const auto loaded = s.loadImage("host:cycle.irx", image.bytes, nullptr, 0u);
+                    require(loaded.moduleId > 0 && (uint32_t(loaded.startResult) & 3u) == residency, "module cycle did not load");
+                    if (residency == 0u)
+                    {
+                        require(s.memory.totalFreeMemory() < freeBefore, "the loaded image is a tracked block");
+                        require(s.intrman.dispatchInterrupt(0x28, s) && !s.pendingGuestCallbacks.empty(),
+                                "the module's handler and alarm are registered while resident");
+                        int32_t result = -1;
+                        require(s.stopModule(loaded.moduleId, &result) && result == 0, "stopModule");
+                    }
+                    require(!s.intrman.dispatchInterrupt(0x28, s), "the interrupt handler outlived its module");
+                    require(s.pendingGuestCallbacks.empty(), "the module's alarm outlived the module");
+                    require(!s.resetRequired, "module cycle disabled the IOP");
+                }
+                require(s.memory.totalFreeMemory() == freeBefore, "load/unload cycles leaked IOP RAM");
+                require(s.modules.empty(), "unloaded modules stayed registered");
+            }
+            // A non-resident module that leaves an interrupt handler behind keeps
+            // its backing (the registration would otherwise point at freed code),
+            // but its threads, alarms and servers are revoked.
+            { iop_test::Host h; State s(h);
+              const uint32_t freeBefore = s.memory.totalFreeMemory();
+              const auto image = module(1u, 0x40000u, true);
+              const auto loaded = s.loadImage("host:leaves-handler.irx", image.bytes, nullptr, 0u);
+              require(loaded.moduleId > 0 && s.intrman.dispatchInterrupt(0x28, s), "handler registered by the released module");
+              require(s.pendingGuestCallbacks.empty(), "a released module's alarm must be revoked");
+              require(s.memory.totalFreeMemory() < freeBefore, "backing of a released module with live callbacks must be retained"); }
+            // SIF command/RPC imports validate their o32 stack arguments: a frame
+            // that is not owned IOP RAM is refused instead of reading zeros.
+            { iop_test::Host h; State s(h);
+              IopCpuState cpu{};
+              cpu.gpr[4] = 0x13000u; cpu.gpr[5] = 0x1234u; cpu.gpr[6] = 0x11000u; cpu.gpr[7] = 0x13100u;
+              cpu.gpr[28] = 0x12345u;
+              cpu.gpr[29] = 0x180000u; // inside RAM, never written: not owned
+              require(s.rpc.dispatchSifCmdImport(17u, cpu) && cpu.gpr[2] == 0u && !s.rpc.hasServer(0x1234u),
+                      "RegisterRpc accepted a frame it does not own");
+              cpu.gpr[29] = 0x13FE0u;
+              s.memory.write32(0x13FF0u, 0x11100u); s.memory.write32(0x13FF4u, 0x13200u); s.memory.write32(0x13FF8u, 0x13300u);
+              require(s.rpc.dispatchSifCmdImport(17u, cpu) && cpu.gpr[2] == 0x13000u && s.rpc.hasServer(0x1234u),
+                      "RegisterRpc rejected a valid owned frame");
+              // SendCmd: command id, packet, size, extra source; extra destination/size on the stack.
+              for (uint32_t offset = 0; offset != 64; offset += 4) s.memory.write32(0x13400u + offset, 0u);
+              IopCpuState send{};
+              send.gpr[4] = 0x80000001u; send.gpr[5] = 0x13400u; send.gpr[6] = 32u; send.gpr[7] = 0u;
+              send.gpr[29] = 0x180000u;
+              require(s.rpc.dispatchSifCmdImport(12u, send) && send.gpr[2] == 0u, "SendCmd accepted a frame it does not own");
+              send.gpr[29] = 0x13FE0u;
+              s.memory.write32(0x13FF0u, 0u); s.memory.write32(0x13FF4u, 0u);
+              require(s.rpc.dispatchSifCmdImport(12u, send) && send.gpr[2] != 0u, "SendCmd rejected a valid owned frame"); }
+            std::cout << "PASS module lifecycle (stop and non-resident release revoke registrations and free memory)\n";
+            return true;
+        }
+        catch (const std::exception &error)
+        {
+            std::cerr << "FAIL module lifecycle: " << error.what() << '\n';
+            return false;
+        }
+    }
+}
