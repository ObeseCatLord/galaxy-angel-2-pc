+    size_t IopIoman::retireCodeRange(uint32_t base, uint32_t size, bool apply)
+    {
+        const auto retired = [&](const Device &device)
+        {
+            if (IopMemory::addressInRange(device.address, base, size))
+                return true;
+            // The driver's operation table and its devctl routine live in the module too.
+            if (!m_memory.ownsRamRange(device.address + 16u, 4u))
+                return false;
+            const uint32_t operations = m_memory.read32(device.address + 16u);
+            if (IopMemory::addressInRange(operations, base, size))
+                return true;
+            if (!m_memory.ownsRamRange(operations, 24u * 4u))
+                return false;
+            for (uint32_t index = 0u; index < 24u; ++index)
+            {
+                const uint32_t function = m_memory.read32(operations + index * 4u);
+                if (function != 0u && IopMemory::addressInRange(function, base, size))
+                    return true;
+            }
+            return false;
+        };
+        const size_t count = static_cast<size_t>(std::count_if(m_devices.begin(), m_devices.end(), retired));
+        if (apply)
+            m_devices.erase(std::remove_if(m_devices.begin(), m_devices.end(), retired), m_devices.end());
+        return count;
+    }
+
