+            return true;
+        }
+        bool writeSifRegister(SifRegister reg, uint32_t value) override
+        {
+            writes.emplace_back(reg, value);
+            if (reg == SifRegister::MsFlag) registers[reg] &= ~value;
+            else if (reg == SifRegister::SmFlag) registers[reg] |= value;
+            else registers[reg] = value;
+            return true;
+        }
+        std::map<SifRegister, uint32_t> registers;
+        std::vector<std::pair<SifRegister, uint32_t>> writes;
+    };
+
+    void sifBootHandshakeRaisesInitThenCmdInit()
+    {
+        SifHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        IopRpcBridge rpc(host, memory, kernel);
+        IopCpuState cpu{};
+        // sceSifInit (SIFMAN 5) then sceSifInitCmd (SIFCMD 4), as the original
+        // boot modules do: the EE sees SIF_STAT_SIFINIT then SIF_STAT_CMDINIT.
+        require(rpc.dispatchSifManImport(5u, cpu) && cpu.gpr[2] == 0u, "sceSifInit");
+        require(host.registers[SifRegister::SmFlag] == 0x10000u, "sceSifInit must raise SIFINIT only");
+        require(rpc.dispatchSifCmdImport(4u, cpu) && cpu.gpr[2] == 0u, "sceSifInitCmd");
+        require(host.registers[SifRegister::SmFlag] == 0x30000u, "sceSifInitCmd must add CMDINIT (0x20000)");
+        require(host.writes.size() == 2u && host.writes[0].second == 0x10000u && host.writes[1].second == 0x20000u,
+                "the handshake bits must be raised in SDK order");
+        // The boot-end bit comes later (EESYNC) and nothing else is disturbed.
+        cpu.gpr[4] = 0x40000u;
+        require(rpc.dispatchSifManImport(24u, cpu) && host.registers[SifRegister::SmFlag] == 0x70000u,
+                "boot end must be added to the earlier bits");
+        // The register numbers handed to the host are pinned: a mixed-up
+        // enumerator would silently read or write the wrong EE-visible register.
+        host.registers[SifRegister::MainAddress] = 0x111u;
+        host.registers[SifRegister::SubAddress] = 0x222u;
+        host.registers[SifRegister::MsFlag] = 0xF0u;
+        const std::pair<uint16_t, uint32_t> reads[] = {{25u, 0x111u}, {26u, 0x222u}, {21u, 0xF0u}, {23u, 0x70000u}};
+        for (const auto &[ordinal, expected] : reads)
+        {
+            require(rpc.dispatchSifManImport(ordinal, cpu) && cpu.gpr[2] == expected, "SIF getter reads the wrong register");
+        }
+        cpu.gpr[4] = 0x30u;
+        require(rpc.dispatchSifManImport(22u, cpu) && host.registers[SifRegister::MsFlag] == 0xC0u,
+                "sceSifSetMSFlag must clear the given bits");
+        cpu.gpr[4] = 0x5678u;
+        require(rpc.dispatchSifManImport(27u, cpu) && host.registers[SifRegister::SubAddress] == 0x5678u,
+                "sceSifSetSubAddr must assign");
+    }
+
+    void kprintfFormatsItsArguments()
+    {
+        Host host;
+        IopMemory memory;
+        IopSysmem sysmem(host, memory);
+        require(memory.writeRam(0x1000u, "%s=%d (%x) %5.2s|", 18u), "format string");
+        require(memory.writeRam(0x1100u, "abcdef", 7u), "string argument");
+        IopCpuState cpu{};
+        cpu.gpr[4] = 0x1000u; cpu.gpr[5] = 0x1100u; cpu.gpr[6] = 42u; cpu.gpr[7] = 0xBEEFu;
+        cpu.gpr[29] = 0x1F00u;
+        memory.write32(0x1F00u + 16u, 0x1100u); // fifth argument: stack slot
+        require(sysmem.dispatchImport(14u, cpu), "Kprintf was not handled");
+        require(!host.logs.empty() && host.logs.back() == "[IOP Kprintf] abcdef=42 (beef)    ab|",
+                "Kprintf must log the formatted text, not the raw format string");
+    }
 }
 
