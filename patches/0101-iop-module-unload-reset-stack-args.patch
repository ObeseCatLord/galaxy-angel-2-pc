diff --git a/ps2xIOP/src/emulator/imports/iop_printf.cpp b/ps2xIOP/src/emulator/imports/iop_printf.cpp
new file mode 100644
index 0000000..505214f
--- /dev/null
+++ b/ps2xIOP/src/emulator/imports/iop_printf.cpp
@@ -0,0 +1,70 @@
+#include "iop_printf.h"
+
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+
+namespace ps2x::iop::detail
+{
+    std::string formatIopPrintf(const IopMemory &memory, const IopCpuState &cpu,
+                                uint32_t formatAddress, unsigned firstArgument)
+    {
+        const std::string format = memory.readString(formatAddress, 2048u);
+        unsigned argument = firstArgument;
+        const auto next = [&]() -> uint32_t
+        {
+            const unsigned index = argument++;
+            if (index < 4u)
+                return cpu.gpr[4 + index];
+            return memory.read32(cpu.gpr[29] + 4u * index);
+        };
+        std::string out;
+        for (size_t i = 0; i < format.size(); ++i)
+        {
+            if (format[i] != '%')
+            {
+                out += format[i];
+                continue;
+            }
+            size_t j = i + 1;
+            while (j < format.size() && std::strchr("-+ #0123456789.", format[j]))
+                ++j;
+            while (j < format.size() && (format[j] == 'l' || format[j] == 'h'))
+                ++j;
+            if (j >= format.size())
+                break;
+            std::string spec = format.substr(i, j - i);
+            spec.erase(std::remove(spec.begin(), spec.end(), 'l'), spec.end());
+            spec.erase(std::remove(spec.begin(), spec.end(), 'h'), spec.end());
+            const char conversion = format[j];
+            char buffer[512];
+            switch (conversion)
+            {
+            case '%':
+                out += '%';
+                break;
+            case 'd': case 'i': case 'u': case 'x': case 'X': case 'o': case 'c':
+                std::snprintf(buffer, sizeof(buffer), (spec + conversion).c_str(), next());
+                out += buffer;
+                break;
+            case 'p':
+                std::snprintf(buffer, sizeof(buffer), "0x%08x", next());
+                out += buffer;
+                break;
+            case 's':
+                std::snprintf(buffer, sizeof(buffer), (spec + 's').c_str(), memory.readString(next(), 256u).c_str());
+                out += buffer;
+                break;
+            default:
+                out += spec;
+                out += conversion;
+                break;
+            }
+            i = j;
+        }
+        return out;
+    }
+}
