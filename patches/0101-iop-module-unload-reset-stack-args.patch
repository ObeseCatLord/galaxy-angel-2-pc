+    size_t IopTimrman::retireCodeRange(uint32_t base, uint32_t size, bool apply) noexcept
+    {
+        size_t count = 0u;
+        for (Timer &timer : m_timers)
+        {
+            for (Callback *callback : {&timer.compareCallback, &timer.overflowCallback})
+                if (callback->function != 0u && IopMemory::addressInRange(callback->function, base, size))
+                {
+                    ++count;
+                    if (apply)
+                        *callback = {};
+                }
+            if (apply && timer.compareCallback.function == 0u && timer.overflowCallback.function == 0u)
+            {
+                // Nothing left to deliver to: the timer stops raising events.
+                timer.compareCycle = UINT64_MAX;
+                timer.overflowCycle = UINT64_MAX;
+            }
+        }
+        return count;
+    }
