+
+// Hands the gathered packets to the worker (one lock of its queue for the batch).
+void GifArbiter::flushLocal()
+{
+    bool backlog = false;
+    {
+        std::lock_guard<std::mutex> localLock(m_localMutex);
+        if (m_localCount == 0u)
+            return;
+        std::lock_guard<std::mutex> lock(m_workerMutex);
+        for (size_t i = 0; i < m_localCount; ++i)
+        {
+            if (m_incomingCount == m_incoming.size())
+                m_incoming.emplace_back();
+            GifArbiterPacket &job = m_incoming[m_incomingCount++];
+            GifArbiterPacket &mine = m_local[i];
+            job.pathId = mine.pathId;
+            job.hasTapData = mine.hasTapData;
+            job.data.swap(mine.data);
+            job.tapData.swap(mine.tapData);
+            job.task = nullptr;
+        }
+        m_incomingBytes += m_localBytes;
+        m_submitted.fetch_add(m_localCount, std::memory_order_relaxed);
+        m_localCount = 0;
+        m_localBytes = 0;
+        if (m_workerSleeping)
             m_workCv.notify_one();
         // Bound what waits: a frame's packets are a few MB at most.
         backlog = m_incomingCount >= 16384u || m_incomingBytes >= (64u << 20);
     }
-    ++m_stats.queuedPackets;
     if (backlog)
         sync();
 }
 
