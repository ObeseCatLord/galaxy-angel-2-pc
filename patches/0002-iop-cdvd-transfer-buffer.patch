+    bool testCdvdReadBufferOwnership()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        IopCdvd cdvd(host, memory, kernel);
+        IopCpuState cpu{};
+        constexpr uint32_t bufferBytes = 42128u;
+        if (!expect(cdvd.dispatchImport(47u, cpu), "sceGetFsvRbuf was not handled"))
+            return false;
+        const uint32_t buffer = cpu.gpr[2];
+        if (!expect(buffer != 0u && memory.ownsRamRange(buffer, bufferBytes),
+                    "sceGetFsvRbuf did not allocate an owned IOP transfer buffer"))
+            return false;
+        memory.write32(buffer, 0x12345678u);
+        memory.write32(buffer + bufferBytes - 4u, 0xABCDEF01u);
+        const uint32_t other = memory.allocate(128u, 16u);
+        if (!expect(other != 0u && other >= buffer + bufferBytes, "buffer overlaps another allocation") ||
+            !expect(cdvd.dispatchImport(47u, cpu) && cpu.gpr[2] == buffer,
+                    "sceGetFsvRbuf changed its pointer within a boot") ||
+            !expect(memory.read32(buffer) == 0x12345678u &&
+                        memory.read32(buffer + bufferBytes - 4u) == 0xABCDEF01u,
+                    "repeated lookup cleared live transfer data"))
+            return false;
+        memory.write32(other, 0x76543210u);
+        cdvd.reset();
+        if (!expect(!memory.ownsRamRange(buffer, bufferBytes), "CDVD reset retained buffer ownership") ||
+            !expect(memory.ownsRamRange(other, 128u) && memory.read32(other) == 0x76543210u,
+                    "CDVD reset released unrelated IOP memory"))
+            return false;
+        memory.reset();
+        kernel.reset();
+        if (!expect(cdvd.dispatchImport(47u, cpu) && cpu.gpr[2] != 0u,
+                    "buffer did not allocate after full reboot") ||
+            !expect(memory.read32(cpu.gpr[2]) == 0u &&
+                        memory.read32(cpu.gpr[2] + bufferBytes - 4u) == 0u,
+                    "reboot exposed stale transfer bytes"))
+            return false;
+        cdvd.reset();
+        memory.reset();
+        const uint32_t exhausted = memory.allocate(IopMemory::HeapLimit - IopMemory::HeapBase, 16u);
+        return expect(exhausted != 0u, "could not exhaust the IOP allocator") &&
+               expect(cdvd.dispatchImport(47u, cpu) && cpu.gpr[2] == 0u,
+                      "allocation failure produced a fake transfer-buffer pointer");
+    }
