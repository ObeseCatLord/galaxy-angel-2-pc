diff --git a/ps2xRuntime/include/runtime/gs/gs_pgs.h b/ps2xRuntime/include/runtime/gs/gs_pgs.h
index 4a47020..723e222 100644
--- a/ps2xRuntime/include/runtime/gs/gs_pgs.h
+++ b/ps2xRuntime/include/runtime/gs/gs_pgs.h
@@ -58,14 +58,53 @@ namespace ga2_pgs
     // eye's newest frame with the stereo setup it was rendered with.
     bool stereo();
     // uiSplit (optional): the frame was drawn without its UI layer (see takeUiFrame).
+    // gameTime (optional): the game time of the iteration that drew it (GA2_PRESENT_SHOTS).
     bool takeEyeFrame(int eye, std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height,
-                      ga2_stereo::Setup &setup, bool *uiSplit = nullptr);
+                      ga2_stereo::Setup &setup, bool *uiSplit = nullptr, double *gameTime = nullptr);
     // HUD panel (GA2_VR_HUD_PANEL=1 with the stereo instances): a third GS instance draws the 2D overlay (HUD,
     // dialogue, menus) alone into an RGBA image, alpha as the game wrote it (0x80 = opaque), transparent black
     // elsewhere; while a frame is split (3D stereo scene) the eye frames leave the overlay out.
     bool uiLayer();
     // Newest UI layer image; uiSplit: the eye frames of the same game frame lack their overlay.
     bool takeUiFrame(std::vector<uint8_t> &rgba, uint32_t &width, uint32_t &height, bool &uiSplit);
+    // Zero-copy presentation (GA2_PGS_ZERO_COPY=0 turns it off): each frame of eye 0 (and eye 1 in VR stereo) is
+    // blitted into one of three exportable images per eye that the window's OpenGL imports (GL_EXT_memory_object,
+    // GL_EXT_semaphore) and samples in place, instead of the whole picture going to host memory and being uploaded
+    // again (18 MB per frame at 4x). The readback still delivers a native-resolution copy for what the CPU reads
+    // (mouse menus, frame signatures, shots), and stays the whole path when zero copy is off, unsupported, on
+    // another GPU than the window's, with the jittered 8x mode, and for the HUD panel layer.
+    // Frames in flight per eye: being written, finished, shown and waiting for the window's OpenGL to let go (zero
+    // copy holds the shown image until its fence passes, so three were not enough: every other frame was dropped).
+    constexpr uint32_t kReadbackSlots = 5;
+    struct SharedImage
+    {
+        uint32_t slot = 0;        // the eye's pool index (0..kReadbackSlots-1)
+        uint64_t generation = 0;  // new when the slot's image was recreated (another size): import it again
+        uint32_t width = 0, height = 0;
+        bool import = false;      // the handles below are new; the caller owns them from now
+        intptr_t memory = -1;     // fd (Linux) or HANDLE (Windows) of the image's dedicated memory
+        uint64_t memorySize = 0;
+        intptr_t ready = -1;      // binary semaphore the GPU signals once the image is written
+    };
+    struct SharedFrame
+    {
+        bool shared = false;      // false: a frame made before zero copy started; `small` holds all of it
+        SharedImage image;
+        double gameTime = 0.0;    // of the iteration that drew it
+        // Finished images replaced before they were taken: wait on their semaphore once, then release them.
+        std::vector<SharedImage> skipped;
+    };
+    // Present thread, once the window's OpenGL exists: its device UUID. True when the GS's Vulkan device is that GPU
+    // and can export images; frames then come through takeSharedFrame.
+    bool enableZeroCopy(const uint8_t uuid[16]);
+    bool zeroCopy();
+    // Newest frame of `eye` (0, or 1 in stereo): its shared image and the native-resolution copy for the CPU
+    // (opaque RGBA in `small`). The image stays the caller's until releaseSharedImage. Also true with smallWidth 0
+    // when only skipped images are handed over.
+    bool takeSharedFrame(int eye, SharedFrame &frame, std::vector<uint8_t> &small, uint32_t &smallWidth,
+                         uint32_t &smallHeight, ga2_stereo::Setup &setup, bool *uiSplit = nullptr);
+    // The present thread is done with that image (its OpenGL fence passed): the GS may write it again.
+    void releaseSharedImage(int eye, uint32_t slot);
     // Above 4x (GA2_PGS_JITTER=1): four instances, eye 0 and three moved by half an internal pixel right, down and
     // both; their newest frames of the same game frame (index = x + 2 y of the half-pixel offset) to interleave.
     bool jittered();
diff --git a/ps2xRuntime/src/lib/ga2_zerocopy.cpp b/ps2xRuntime/src/lib/ga2_zerocopy.cpp
new file mode 100644
index 0000000..d9bfaba
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_zerocopy.cpp
@@ -0,0 +1,361 @@
+#include "ga2_zerocopy.h"
+#include "runtime/gs/gs_pgs.h"
+#include "runtime/ga2_stereo.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+
+#if defined(PLATFORM_VITA)
+
+namespace ga2_zerocopy
+{
+    bool init() { return false; }
+    bool active() { return false; }
+    bool take(int, unsigned &, uint32_t &, uint32_t &, bool &, std::vector<uint8_t> &, uint32_t &, uint32_t &,
+              ga2_stereo::Setup &, bool *, double *)
+    {
+        return false;
+    }
+    void endFrame() {}
+    void presentShot(unsigned, int, int, double) {}
+}
+
+#else
+
+#include "raylib.h"
+#include "external/glad.h"
+
+// raylib's desktop platform links GLFW; its loader resolves the extension entry points glad does not carry.
+extern "C" void *glfwGetProcAddress(const char *procname);
+#ifdef _WIN32
+extern "C" __declspec(dllimport) int __stdcall CloseHandle(void *);
+#define GA2_GLAPI __stdcall
+#else
+#define GA2_GLAPI
+#endif
+
+namespace
+{
+    constexpr GLenum kTextureTiling = 0x9580;     // GL_TEXTURE_TILING_EXT
+    constexpr GLenum kDedicatedMemory = 0x9581;   // GL_DEDICATED_MEMORY_OBJECT_EXT
+    constexpr GLenum kOptimalTiling = 0x9584;     // GL_OPTIMAL_TILING_EXT
+    constexpr GLenum kHandleOpaqueFd = 0x9586;    // GL_HANDLE_TYPE_OPAQUE_FD_EXT
+    constexpr GLenum kHandleOpaqueWin32 = 0x9587; // GL_HANDLE_TYPE_OPAQUE_WIN32_EXT
+    constexpr GLenum kNumDeviceUuids = 0x9596;    // GL_NUM_DEVICE_UUIDS_EXT
+    constexpr GLenum kDeviceUuid = 0x9597;        // GL_DEVICE_UUID_EXT
+    constexpr GLenum kLayoutShaderRead = 0x9591;  // GL_LAYOUT_SHADER_READ_ONLY_EXT
+
+    using PfnGetUnsignedBytei = void(GA2_GLAPI *)(GLenum, GLuint, GLubyte *);
+    using PfnCreateMemoryObjects = void(GA2_GLAPI *)(GLsizei, GLuint *);
+    using PfnDeleteMemoryObjects = void(GA2_GLAPI *)(GLsizei, const GLuint *);
+    using PfnMemoryObjectParameteriv = void(GA2_GLAPI *)(GLuint, GLenum, const GLint *);
+    using PfnTexStorageMem2D = void(GA2_GLAPI *)(GLenum, GLsizei, GLenum, GLsizei, GLsizei, GLuint, GLuint64);
+    using PfnImportMemoryFd = void(GA2_GLAPI *)(GLuint, GLuint64, GLenum, GLint);
+    using PfnImportMemoryWin32 = void(GA2_GLAPI *)(GLuint, GLuint64, GLenum, void *);
+    using PfnGenSemaphores = void(GA2_GLAPI *)(GLsizei, GLuint *);
+    using PfnDeleteSemaphores = void(GA2_GLAPI *)(GLsizei, const GLuint *);
+    using PfnWaitSemaphore = void(GA2_GLAPI *)(GLuint, GLuint, const GLuint *, GLuint, const GLuint *, const GLenum *);
+    using PfnImportSemaphoreFd = void(GA2_GLAPI *)(GLuint, GLenum, GLint);
+    using PfnImportSemaphoreWin32 = void(GA2_GLAPI *)(GLuint, GLenum, void *);
+
+    struct Gl
+    {
+        PfnGetUnsignedBytei getUnsignedBytei = nullptr;
+        PfnCreateMemoryObjects createMemoryObjects = nullptr;
+        PfnDeleteMemoryObjects deleteMemoryObjects = nullptr;
+        PfnMemoryObjectParameteriv memoryObjectParameteriv = nullptr;
+        PfnTexStorageMem2D texStorageMem2D = nullptr;
+        PfnImportMemoryFd importMemoryFd = nullptr;
+        PfnImportMemoryWin32 importMemoryWin32 = nullptr;
+        PfnGenSemaphores genSemaphores = nullptr;
+        PfnDeleteSemaphores deleteSemaphores = nullptr;
+        PfnWaitSemaphore waitSemaphore = nullptr;
+        PfnImportSemaphoreFd importSemaphoreFd = nullptr;
+        PfnImportSemaphoreWin32 importSemaphoreWin32 = nullptr;
+    } g_gl;
+
+    // One eye's pool slot as imported into OpenGL.
+    struct Imported
+    {
+        uint64_t generation = 0;
+        GLuint memory = 0, texture = 0, semaphore = 0;
+        uint32_t width = 0, height = 0;
+    };
+
+    struct Retiring
+    {
+        int eye;
+        uint32_t slot;
+        GLsync fence;
+    };
+
+    bool g_tried = false, g_active = false;
+    Imported g_slots[2][ga2_pgs::kReadbackSlots];
+    int g_current[2] = {-1, -1}; // the slot each eye shows now
+    std::vector<Retiring> g_retiring;
+
+    template <typename T>
+    bool load(T &fn, const char *name)
+    {
+        fn = reinterpret_cast<T>(glfwGetProcAddress(name));
+        return fn != nullptr;
+    }
+
+    bool hasExtension(const char *name)
+    {
+        GLint count = 0;
+        glGetIntegerv(GL_NUM_EXTENSIONS, &count);
+        for (GLint i = 0; i < count; ++i)
+            if (const auto *ext = reinterpret_cast<const char *>(glGetStringi(GL_EXTENSIONS, GLuint(i))); ext && std::strcmp(ext, name) == 0)
+                return true;
+        return false;
+    }
+
+    void closeHandle(intptr_t handle)
+    {
+#ifdef _WIN32
+        if (handle && handle != -1)
+            CloseHandle(reinterpret_cast<void *>(handle));
+#else
+        (void)handle; // OpenGL took the fd
+#endif
+    }
+
+    void freeImported(Imported &im)
+    {
+        if (im.texture)
+            glDeleteTextures(1, &im.texture);
+        if (im.memory)
+            g_gl.deleteMemoryObjects(1, &im.memory);
+        if (im.semaphore)
+            g_gl.deleteSemaphores(1, &im.semaphore);
+        im = Imported{};
+    }
+
+    // Imports a slot's image and semaphore when the GS handed over new handles.
+    bool importSlot(int eye, const ga2_pgs::SharedImage &si)
+    {
+        Imported &im = g_slots[eye][si.slot];
+        if (!si.import)
+            return im.texture != 0 && im.generation == si.generation;
+        freeImported(im);
+        while (glGetError() != GL_NO_ERROR)
+        {
+        }
+        if (si.memory != -1 && si.memory != 0)
+        {
+            g_gl.createMemoryObjects(1, &im.memory);
+            const GLint dedicated = GL_TRUE;
+            g_gl.memoryObjectParameteriv(im.memory, kDedicatedMemory, &dedicated);
+#ifdef _WIN32
+            g_gl.importMemoryWin32(im.memory, si.memorySize, kHandleOpaqueWin32, reinterpret_cast<void *>(si.memory));
+#else
+            g_gl.importMemoryFd(im.memory, si.memorySize, kHandleOpaqueFd, GLint(si.memory));
+#endif
+            closeHandle(si.memory);
+            glGenTextures(1, &im.texture);
+            glBindTexture(GL_TEXTURE_2D, im.texture);
+            glTexParameteri(GL_TEXTURE_2D, kTextureTiling, GLint(kOptimalTiling));
+            g_gl.texStorageMem2D(GL_TEXTURE_2D, 1, GL_RGBA8, GLsizei(si.width), GLsizei(si.height), im.memory, 0);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_SWIZZLE_A, GL_ONE); // the readback path forced alpha too
+            glBindTexture(GL_TEXTURE_2D, 0);
+        }
+        if (si.ready != -1 && si.ready != 0)
+        {
+            g_gl.genSemaphores(1, &im.semaphore);
+#ifdef _WIN32
+            g_gl.importSemaphoreWin32(im.semaphore, kHandleOpaqueWin32, reinterpret_cast<void *>(si.ready));
+#else
+            g_gl.importSemaphoreFd(im.semaphore, kHandleOpaqueFd, GLint(si.ready));
+#endif
+            closeHandle(si.ready);
+        }
+        const GLenum error = glGetError();
+        if (error != GL_NO_ERROR || !im.texture || !im.semaphore)
+        {
+            std::fprintf(stderr, "[zerocopy] import of a %ux%u image failed (GL error 0x%x)\n", si.width, si.height, unsigned(error));
+            freeImported(im);
+            return false;
+        }
+        im.generation = si.generation;
+        im.width = si.width;
+        im.height = si.height;
+        std::fprintf(stderr, "[zerocopy] eye %d slot %u: imported %ux%u (%.1f MB)\n", eye, si.slot, si.width, si.height,
+                     double(si.memorySize) / 1048576.0);
+        return true;
+    }
+
+    // Waits (on the GPU) for the GS to finish writing the image, then hands it to `retire` behind a fence.
+    void waitReady(int eye, uint32_t slot)
+    {
+        Imported &im = g_slots[eye][slot];
+        const GLenum layout = kLayoutShaderRead;
+        g_gl.waitSemaphore(im.semaphore, 0, nullptr, 1, &im.texture, &layout);
+    }
+
+    void retire(int eye, uint32_t slot)
+    {
+        g_retiring.push_back(Retiring{eye, slot, glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0)});
+    }
+
+    void releaseFinished()
+    {
+        for (size_t i = 0; i < g_retiring.size();)
+        {
+            const GLenum state = glClientWaitSync(g_retiring[i].fence, 0, 0);
+            if (state == GL_ALREADY_SIGNALED || state == GL_CONDITION_SATISFIED)
+            {
+                glDeleteSync(g_retiring[i].fence);
+                ga2_pgs::releaseSharedImage(g_retiring[i].eye, g_retiring[i].slot);
+                g_retiring.erase(g_retiring.begin() + std::ptrdiff_t(i));
+            }
+            else
+                ++i;
+        }
+    }
+}
+
+namespace ga2_zerocopy
+{
+    bool init()
+    {
+        if (g_tried)
+            return g_active;
+        if (!ga2_pgs::rendering())
+            return false; // asked again once the GS renders
+        g_tried = true;
+#ifdef _WIN32
+        const char *memoryExt = "GL_EXT_memory_object_win32", *semaphoreExt = "GL_EXT_semaphore_win32";
+#else
+        const char *memoryExt = "GL_EXT_memory_object_fd", *semaphoreExt = "GL_EXT_semaphore_fd";
+#endif
+        if (!hasExtension("GL_EXT_memory_object") || !hasExtension("GL_EXT_semaphore") || !hasExtension(memoryExt) ||
+            !hasExtension(semaphoreExt))
+        {
+            std::fprintf(stderr, "[zerocopy] the window's OpenGL lacks %s/%s: frames are read back\n", memoryExt, semaphoreExt);
+            return false;
+        }
+        bool ok = load(g_gl.getUnsignedBytei, "glGetUnsignedBytei_vEXT") &&
+                  load(g_gl.createMemoryObjects, "glCreateMemoryObjectsEXT") &&
+                  load(g_gl.deleteMemoryObjects, "glDeleteMemoryObjectsEXT") &&
+                  load(g_gl.memoryObjectParameteriv, "glMemoryObjectParameterivEXT") &&
+                  load(g_gl.texStorageMem2D, "glTexStorageMem2DEXT") && load(g_gl.genSemaphores, "glGenSemaphoresEXT") &&
+                  load(g_gl.deleteSemaphores, "glDeleteSemaphoresEXT") && load(g_gl.waitSemaphore, "glWaitSemaphoreEXT");
+#ifdef _WIN32
+        ok = ok && load(g_gl.importMemoryWin32, "glImportMemoryWin32HandleEXT") &&
+             load(g_gl.importSemaphoreWin32, "glImportSemaphoreWin32HandleEXT");
+#else
+        ok = ok && load(g_gl.importMemoryFd, "glImportMemoryFdEXT") && load(g_gl.importSemaphoreFd, "glImportSemaphoreFdEXT");
+#endif
+        if (!ok)
+        {
+            std::fprintf(stderr, "[zerocopy] extension entry points missing: frames are read back\n");
+            return false;
+        }
+        GLint devices = 0;
+        glGetIntegerv(kNumDeviceUuids, &devices);
+        GLubyte uuid[16] = {};
+        for (GLint i = 0; i < devices && !g_active; ++i)
+        {
+            g_gl.getUnsignedBytei(kDeviceUuid, GLuint(i), uuid);
+            g_active = ga2_pgs::enableZeroCopy(uuid);
+        }
+        return g_active;
+    }
+
+    bool active() { return g_active; }
+
+    bool take(int eye, unsigned &texture, uint32_t &width, uint32_t &height, bool &shared, std::vector<uint8_t> &small,
+              uint32_t &smallWidth, uint32_t &smallHeight, ga2_stereo::Setup &setup, bool *uiSplit, double *gameTime)
+    {
+        if (eye < 0 || eye > 1)
+            return false;
+        releaseFinished();
+        ga2_pgs::SharedFrame frame;
+        if (!ga2_pgs::takeSharedFrame(eye, frame, small, smallWidth, smallHeight, setup, uiSplit))
+            return false;
+        // Images the GS finished but nobody showed: their semaphore is consumed before they are written again.
+        for (const ga2_pgs::SharedImage &si : frame.skipped)
+        {
+            if (importSlot(eye, si))
+                waitReady(eye, si.slot);
+            retire(eye, si.slot);
+        }
+        shared = frame.shared;
+        if (gameTime)
+            *gameTime = frame.gameTime;
+        if (!frame.shared)
+            return smallWidth != 0;
+        const ga2_pgs::SharedImage &si = frame.image;
+        if (!importSlot(eye, si))
+        {
+            retire(eye, si.slot);
+            return false;
+        }
+        waitReady(eye, si.slot);
+        if (g_current[eye] >= 0)
+            retire(eye, uint32_t(g_current[eye]));
+        g_current[eye] = int(si.slot);
+        const Imported &im = g_slots[eye][si.slot];
+        texture = im.texture;
+        width = im.width;
+        height = im.height;
+        return true;
+    }
+
+    void endFrame()
+    {
+        if (g_active)
+            releaseFinished();
+    }
+
+    void presentShot(unsigned texture, int width, int height, double gameTime)
+    {
+        static std::string dir;
+        static std::vector<double> times;
+        static size_t next = 0;
+        static bool parsed = false;
+        if (!parsed)
+        {
+            parsed = true;
+            if (const char *spec = std::getenv("GA2_PRESENT_SHOTS"); spec && std::strchr(spec, '@'))
+            {
+                dir.assign(spec, size_t(std::strchr(spec, '@') - spec));
+                for (const char *v = std::strchr(spec, '@') + 1; v && *v;)
+                {
+                    char *end = nullptr;
+                    times.push_back(std::strtod(v, &end));
+                    v = end && *end == ',' ? end + 1 : nullptr;
+                }
+            }
+        }
+        if (!texture || width <= 0 || height <= 0)
+            return;
+        while (next < times.size() && gameTime >= times[next] - 1e-6)
+        {
+            std::vector<uint8_t> pixels(size_t(width) * size_t(height) * 4u);
+            glBindTexture(GL_TEXTURE_2D, texture);
+            glPixelStorei(GL_PACK_ALIGNMENT, 1);
+            glGetTexImage(GL_TEXTURE_2D, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+            glBindTexture(GL_TEXTURE_2D, 0);
+            for (size_t i = 3; i < pixels.size(); i += 4)
+                pixels[i] = 0xFF;
+            Image image{pixels.data(), width, height, 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+            char name[64];
+            std::snprintf(name, sizeof(name), "/present-%.3f.png", times[next]);
+            const std::string path = dir + name;
+            ExportImage(image, path.c_str());
+            std::fprintf(stderr, "[zerocopy] present shot %s (%dx%d, frame game time %.3f, %s)\n", path.c_str(), width, height,
+                         gameTime, g_active ? "zero copy" : "read back");
+            ++next;
+        }
+    }
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/ga2_zerocopy.h b/ps2xRuntime/src/lib/ga2_zerocopy.h
new file mode 100644
index 0000000..5024cbe
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_zerocopy.h
@@ -0,0 +1,37 @@
+// Zero-copy presentation, the window's side (OpenGL). The GS (gs_pgs.cpp) blits each frame into exportable Vulkan
+// images; this imports them with GL_EXT_memory_object / GL_EXT_semaphore (_fd on Linux, _win32 on Windows) and the
+// presentation samples them in place. Without the extensions, on another GPU, or with GA2_PGS_ZERO_COPY=0 the GS
+// keeps reading frames back and the presentation uploads them as before.
