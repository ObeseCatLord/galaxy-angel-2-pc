@@ -25,10 +25,16 @@ namespace ga2_framepace
     // software GS). Read once.
     int fps();
     inline bool enabled() { return fps() > 0; }
-    // Seconds per frame at fps(): 1001 / (1000 * fps) (the NTSC-style
+    // The rate the game runs at now: fps() is the maximum, the game side's governor lowers it (down to 60, the
