+void EeScheduler::retuneFrameClock(uint32_t fps) noexcept
+{
+    fps = std::max<uint32_t>(1u, fps);
+    if (!m_frameClockOn)
+    {
+        m_frameFps = fps;
+        return;
+    }
+    if (fps == m_frameFps)
+        return;
+    // The tick already queued fires on the old schedule; the ones after it follow the new rate from here.
+    m_frameFps = fps;
+    m_frameBase = m_frameTicks;
+    m_frameCycle0 = m_eeCycle;
+    m_frameHost0 = std::chrono::steady_clock::now();
+}
+
 bool EeScheduler::frameDriven() const noexcept
 {
     // The game runs a scene at the native rate (ga2_framepace::setNative): the real VBLANK drives the display.
@@ -1959,6 +1976,7 @@ bool EeScheduler::frameDriven() const noexcept
         // The clock starts at the first wait; ticks fire from then on.
         m_frameClockOn = true;
         m_frameTicks = 0;
+        m_frameBase = 0;
         m_frameLastWake = 0;
         m_frameCycle0 = m_eeCycle;
         m_frameHost0 = std::chrono::steady_clock::now();
@@ -2477,8 +2495,9 @@ void EeScheduler::processDueDeadlines()
                 const auto late = std::chrono::steady_clock::now() - scheduled.hostDeadline;
                 if (late > std::chrono::milliseconds(50))
                     m_frameHost0 += late;
-                scheduleEvent(m_frameCycle0 + next * kFrameCycleNumerator / fps,
-                              m_frameHost0 + std::chrono::nanoseconds(next * kFrameNanosecondNumerator / fps),
+                const uint64_t since = next > m_frameBase ? next - m_frameBase : 1u;
+                scheduleEvent(m_frameCycle0 + since * kFrameCycleNumerator / fps,
+                              m_frameHost0 + std::chrono::nanoseconds(since * kFrameNanosecondNumerator / fps),
                               EeEvent{EeEventType::FrameTick, 0, next});
             }
             processEvent(scheduled.event);
diff --git a/ps2xRuntime/src/lib/ga2_framepace.cpp b/ps2xRuntime/src/lib/ga2_framepace.cpp
index 6464fd8..c252a4a 100644
--- a/ps2xRuntime/src/lib/ga2_framepace.cpp
+++ b/ps2xRuntime/src/lib/ga2_framepace.cpp
@@ -101,14 +101,39 @@ namespace ga2_framepace
         return value;
     }
 
-    float step() { return fps() > 0 ? float(1001.0 / (1000.0 * fps())) : float(1001.0 / 60000.0); }
+    namespace
+    {
+        std::atomic<int> g_rate{0};
+    }
+
+    int rate()
+    {
+        const int r = g_rate.load(std::memory_order_relaxed);
+        return r > 0 ? r : fps();
+    }
+
+    int setRate(PS2Runtime &runtime, int value)
+    {
+        const int previous = rate();
+        if (fps() <= 0)
+            return previous;
+        value = std::clamp(value, 60, fps());
+        if (value != previous)
+        {
+            g_rate.store(value, std::memory_order_relaxed);
+            runtime.eeScheduler().retuneFrameClock(uint32_t(value));
+        }
+        return previous;
+    }
+
+    float step() { return rate() > 0 ? float(1001.0 / (1000.0 * rate())) : float(1001.0 / 60000.0); }
 
-    double hz() { return fps() > 0 ? fps() * 1000.0 / 1001.0 : 60000.0 / 1001.0; }
+    double hz() { return rate() > 0 ? rate() * 1000.0 / 1001.0 : 60000.0 / 1001.0; }
 
     [[noreturn]] void waitTick(PS2Runtime &runtime, uint32_t interval, uint32_t resumePc)
     {
         EeScheduler &scheduler = runtime.eeScheduler();
-        scheduler.configureFrameClock(uint32_t(fps()));
+        scheduler.configureFrameClock(uint32_t(rate()));
         scheduler.waitFrameTick(interval, [resumePc](R5900Context &context) { context.pc = resumePc; });
     }
 
@@ -174,7 +199,7 @@ namespace ga2_framepace
                      double(f - g_stats.flips) / seconds, double(g_stats.scans) / seconds,
                      double(g_presented.load(std::memory_order_relaxed) - g_stats.presented) / seconds,
                      double(vsyncTick - g_stats.vsync) / seconds,
-                     100.0 * double(f - g_stats.flips) / seconds / hz(), fps() > 0 ? fps() : 60);
+                     100.0 * double(f - g_stats.flips) / seconds / hz(), rate() > 0 ? rate() : 60);
         // Where the host's time goes: busiest threads, as a share of one core.
         {
             const auto now = threadCpu();
