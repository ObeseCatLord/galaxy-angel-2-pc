From e0925c8889215c78819cd29d9b278cea82416ae7 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Wed, 21 Oct 2026 12:33:18 -0500
Subject: [PATCH] framerate: runtime rate (frame clock retune) for the
 game-side governor; IOP scheduler single pass

ga2_framepace::rate() / setRate(): GA2_FPS is the maximum, the game side's governor (native/compat)
lowers the rate when the host cannot keep the guest at real time and raises it again. step(), hz(),
the frame clock and the perf report follow rate(). EeScheduler::retuneFrameClock moves the tick
origin (m_frameBase) so ticks keep counting and the next ones follow the new rate.

IopKernel::beginNextReady scanned the thread list twice per call (9 % of the game thread in
IOP-heavy phases of the Zettai cockpit/movie): one pass now, the second scan only when a delay
expired. IOP emulator and compatibility tests pass.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ps2xIOP/src/emulator/core/iop_kernel.cpp    | 35 +++++++++++++++------
 ps2xRuntime/include/runtime/ee_scheduler.h  |  5 ++-
 ps2xRuntime/include/runtime/ga2_framepace.h | 10 ++++--
 ps2xRuntime/src/lib/Kernel/EeScheduler.cpp  | 23 ++++++++++++--
 ps2xRuntime/src/lib/ga2_framepace.cpp       | 33 ++++++++++++++++---
 5 files changed, 87 insertions(+), 19 deletions(-)

diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index 4ea261b..162b0f4 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -951,20 +951,35 @@ namespace ps2x::iop::detail
         // Expired delays become ready in (wake time, id) order, behind the
         // threads that are already queued. The next thread is the head of the
         // best priority's FIFO queue: lowest (priority, readySerial).
+        // One pass finds both the expired delays and the best ready thread; only when a delay expired (it queues behind
+        // the ready ones, so the answer can change) is the ready set scanned again.
         std::vector<IopThread *> expired;
-        for (IopThread *thread : m_threadList)
-            if (thread->state == IopThreadState::Delay && thread->wakeCycle <= currentCycle)
-                expired.push_back(thread);
-        std::stable_sort(expired.begin(), expired.end(),
-                         [](const IopThread *a, const IopThread *b) { return a->wakeCycle < b->wakeCycle; });
-        for (IopThread *thread : expired)
-            makeReady(*thread);
         IopThread *next = nullptr;
         for (IopThread *thread : m_threadList)
-            if (thread->state == IopThreadState::Ready &&
-                (next == nullptr || thread->priority < next->priority ||
-                 (thread->priority == next->priority && thread->readySerial < next->readySerial)))
+        {
+            if (thread->state == IopThreadState::Delay)
+            {
+                if (thread->wakeCycle <= currentCycle)
+                    expired.push_back(thread);
+            }
+            else if (thread->state == IopThreadState::Ready &&
+                     (next == nullptr || thread->priority < next->priority ||
+                      (thread->priority == next->priority && thread->readySerial < next->readySerial)))
                 next = thread;
+        }
+        if (!expired.empty())
+        {
+            std::stable_sort(expired.begin(), expired.end(),
+                             [](const IopThread *a, const IopThread *b) { return a->wakeCycle < b->wakeCycle; });
+            for (IopThread *thread : expired)
+                makeReady(*thread);
+            next = nullptr;
+            for (IopThread *thread : m_threadList)
+                if (thread->state == IopThreadState::Ready &&
+                    (next == nullptr || thread->priority < next->priority ||
+                     (thread->priority == next->priority && thread->readySerial < next->readySerial)))
+                    next = thread;
+        }
         if (next == nullptr)
             return nullptr;
 
