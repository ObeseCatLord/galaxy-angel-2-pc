+    bool takeJitterFrames(std::vector<uint8_t> (&rgba)[4], uint32_t &width, uint32_t &height)
+    {
+        State &s = state();
+        if (s.jitterCount != 3)
+            return false;
+        Eye *eyes[4] = {&s.eyes[0], &s.eyes[3], &s.eyes[4], &s.eyes[5]};
+        TakenFrame frames[4];
+        {
+            // All four of the same game frame, or none.
+            std::lock_guard<std::mutex> lock(s.frameMutex);
+            for (Eye *eye : eyes)
+                if (!eye->frameFresh || eye->frameWidth != eyes[0]->frameWidth || eye->frameHeight != eyes[0]->frameHeight)
+                    return false;
+        }
+        for (int i = 0; i < 4; ++i)
+            if (!acquireFrame(s, *eyes[i], frames[i]))
+            {
+                for (TakenFrame &f : frames)
+                    releaseFrame(f);
+                return false;
+            }
+        width = frames[0].width;
+        height = frames[0].height;
+        const size_t pixels = size_t(width) * height;
+        for (int i = 0; i < 4; ++i)
+        {
+            rgba[i].resize(pixels * 4u);
+            auto *dst = reinterpret_cast<uint32_t *>(rgba[i].data());
+            const uint32_t *src = frames[i].src;
+            if (frames[i].bgra)
+                for (size_t p = 0; p < pixels; ++p)
+                {
+                    const uint32_t c = src[p];
+                    dst[p] = ((c >> 16) & 0xFFu) | (c & 0xFF00u) | ((c & 0xFFu) << 16) | 0xFF000000u;
+                }
+            else
+                for (size_t p = 0; p < pixels; ++p)
+                    dst[p] = src[p] | 0xFF000000u;
+            releaseFrame(frames[i]);
+        }
+        return true;
+    }
