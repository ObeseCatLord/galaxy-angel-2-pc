+    // A thread that runs one GS instance's work in order: the jitter instances' vsync (flush, scan-out, readback),
+    // side by side with eye 0's (each instance has its own device). Packets stay on the calling thread (see
+    // gifTransfer).
+    struct InstanceWorker
+    {
+        std::thread thread;
+        std::mutex mutex;
+        std::condition_variable wake, done;
+        std::deque<std::function<void()>> tasks;
+        bool busy = false;
+
+        void start()
+        {
+            thread = std::thread([this] {
+                for (;;)
+                {
+                    std::function<void()> task;
+                    {
+                        std::unique_lock<std::mutex> lock(mutex);
+                        wake.wait(lock, [&] { return !tasks.empty(); });
+                        task = std::move(tasks.front());
+                        tasks.pop_front();
+                        busy = true;
+                    }
+                    task();
+                    {
+                        std::lock_guard<std::mutex> lock(mutex);
+                        busy = false;
+                    }
+                    done.notify_all();
+                }
+            });
+            thread.detach(); // runs until the process ends, like the GS itself
+        }
+        void post(std::function<void()> task)
+        {
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                tasks.push_back(std::move(task));
+            }
+            wake.notify_one();
+        }
+        void wait()
+        {
+            std::unique_lock<std::mutex> lock(mutex);
+            done.wait(lock, [&] { return tasks.empty() && !busy; });
+        }
+    };
+
