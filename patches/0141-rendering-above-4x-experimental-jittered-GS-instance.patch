+// Above 4x (GA2_PGS_JITTER=1): the four jittered instances' frames interleaved into one at twice the width and
+// height: output pixel (2x + i, 2y + j) is instance i + 2 j's pixel (x, y).
+static const char *kJitterJoin = R"(#version 330
+in vec2 fragTexCoord;
+uniform sampler2D texture0;
+uniform sampler2D part1;
+uniform sampler2D part2;
+uniform sampler2D part3;
+uniform vec2 outSize;
+out vec4 finalColor;
+void main() {
+    ivec2 p = ivec2(floor(fragTexCoord * outSize));
+    ivec2 q = p / 2;
+    int k = (p.x & 1) + 2 * (p.y & 1);
+    vec4 c = k == 0 ? texelFetch(texture0, q, 0) : k == 1 ? texelFetch(part1, q, 0) : k == 2 ? texelFetch(part2, q, 0)
+                                                                                     : texelFetch(part3, q, 0);
+    finalColor = vec4(c.rgb, 1.0);
+})";
+
+static bool UploadJitteredFrame(Texture2D &tex, uint32_t &width, uint32_t &height)
+{
+    static std::vector<uint8_t> s_frames[4];
+    static Texture2D s_parts[4]{};
+    static RenderTexture2D s_joined{};
+    static Shader s_join{};
+    static int s_joinLoaded = -1;
+    uint32_t w = 0u, h = 0u;
+    if (!ga2_pgs::takeJitterFrames(s_frames, w, h) || !w || !h)
+        return false;
+    if (s_joinLoaded < 0)
+    {
+        s_join = LoadShaderFromMemory(nullptr, kJitterJoin);
+        s_joinLoaded = IsShaderValid(s_join) ? 1 : 0;
+    }
+    if (s_joinLoaded != 1)
+        return false;
+    for (int i = 0; i < 4; ++i)
+    {
+        if (s_parts[i].width != int(w) || s_parts[i].height != int(h))
+        {
+            if (s_parts[i].id)
+                UnloadTexture(s_parts[i]);
+            Image image = GenImageColor(int(w), int(h), BLACK);
+            s_parts[i] = LoadTextureFromImage(image);
+            UnloadImage(image);
+            SetTextureFilter(s_parts[i], TEXTURE_FILTER_POINT);
+        }
+        UpdateTexture(s_parts[i], s_frames[i].data());
+    }
+    if (s_joined.texture.width != int(2u * w) || s_joined.texture.height != int(2u * h))
+    {
+        if (s_joined.id)
+            UnloadRenderTexture(s_joined);
+        s_joined = LoadRenderTexture(int(2u * w), int(2u * h));
+        SetTextureFilter(s_joined.texture, TEXTURE_FILTER_BILINEAR);
+    }
+    rlDrawRenderBatchActive();
+    BeginTextureMode(s_joined);
+    BeginShaderMode(s_join);
+    const float outSize[2] = {float(2u * w), float(2u * h)};
+    SetShaderValue(s_join, GetShaderLocation(s_join, "outSize"), outSize, SHADER_UNIFORM_VEC2);
+    SetShaderValueTexture(s_join, GetShaderLocation(s_join, "part1"), s_parts[1]);
+    SetShaderValueTexture(s_join, GetShaderLocation(s_join, "part2"), s_parts[2]);
+    SetShaderValueTexture(s_join, GetShaderLocation(s_join, "part3"), s_parts[3]);
+    // Upside down into the render target, so its texture has the frames' orientation.
+    DrawTexturePro(s_parts[0], Rectangle{0.0f, 0.0f, float(w), -float(h)}, Rectangle{0.0f, 0.0f, outSize[0], outSize[1]},
+                   Vector2{0, 0}, 0.0f, WHITE);
+    EndShaderMode();
+    EndTextureMode();
+    tex = s_joined.texture;
+    width = 2u * w;
+    height = 2u * h;
+    ps2_mouse::setFrame(s_frames[0].data(), w, h);
+    return true;
+}
+
