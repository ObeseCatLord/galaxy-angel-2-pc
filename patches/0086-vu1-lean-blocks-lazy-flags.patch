+bool VU1Interpreter::blockMayRunCounted(const BlockGuard *guards, uint32_t guardCount, uint32_t lastIssue,
+                                        uint32_t pairCount, const StepArgs &a) const
+{
+    // Reached when blocks are off (PATH1 active or stopped) or statistics are on.
+    BlockStats &stats = blockStats();
+    const bool counting = s_blockStatsOn;
+    if (counting)
+        ++stats.entries;
+    const auto fail = [&](uint64_t &counter) {
+        if (counting)
+        {
+            ++counter;
+            stats.pairsFailed += pairCount;
+        }
+        return false;
+    };
+    if (m_stopRequested)
+        return fail(stats.failStop);
+    if (m_xgkick.active)
+        return fail(stats.failPath1);
+    const uint64_t entry = m_cycle;
+    if (entry + lastIssue >= a.budgetEnd)
+        return fail(stats.failBudget);
+    for (uint32_t k = 0; k < guardCount; ++k)
+    {
+        const BlockGuard &g = guards[k];
+        const uint64_t limit = entry + g.offset;
+        bool ok = true;
+        switch (g.kind)
+        {
+        case BlockGuardKind::Vf: ok = m_vfReady[g.reg][g.lane] <= limit; break;
+        case BlockGuardKind::Vi: ok = m_viReady[g.reg] <= limit; break;
+        case BlockGuardKind::Acc: ok = m_accReady[g.lane] <= limit; break;
+        case BlockGuardKind::Fdiv: ok = !m_fdiv.valid || m_fdiv.readyCycle <= limit; break;
+        case BlockGuardKind::EfuUnit: ok = m_efuResourceReady <= limit; break;
+        case BlockGuardKind::EfuAll:
+            ok = (!m_efu[0].valid || m_efu[0].readyCycle <= limit) && (!m_efu[1].valid || m_efu[1].readyCycle <= limit);
+            break;
+        }
+        if (!ok)
+            return fail(stats.failGuard[static_cast<uint32_t>(g.kind)]);
+    }
+    if (counting)
+    {
+        ++stats.ran;
+        stats.pairsRan += pairCount;
+        stats.cyclesRan += lastIssue + 1u;
+    }
+    return true;
+}
