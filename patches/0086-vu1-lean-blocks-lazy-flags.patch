+__attribute__((always_inline)) inline void VU1Interpreter::queueStore(uint32_t address, const uint32_t words[4], uint8_t laneMask)
+{
+    // A store becomes visible one cycle after issue. Every pair ends by
+    // advancing one cycle, which commits it before PATH1 reads its next
+    // qword, and no other lower instruction can issue in between; so writing
+    // at issue is observationally identical and keeps the commit path idle.
+    if (!m_activeVuData || address + 16u > m_activeVuDataSize)
+        return;
+    uint8_t *dst = m_activeVuData + address;
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        if ((laneMask & laneForComponent(component)) != 0u)
+            std::memcpy(dst + component * 4u, words + component, sizeof(uint32_t));
+    }
+}
