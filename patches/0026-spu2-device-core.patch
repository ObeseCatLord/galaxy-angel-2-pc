+void test_dma_endpoints_irq_and_cache()
+{
+    Device device;
+    std::vector<std::uint8_t> delivered;
+    device.setSpuAddressIrq([&](std::uint8_t core) { delivered.push_back(core); });
+
+    for (const std::uint8_t core : {std::uint8_t{0}, std::uint8_t{1}}) {
+        device.reset();
+        delivered.clear();
+        device.setSpuAddressIrq([&](std::uint8_t identity) { delivered.push_back(identity); });
+        std::vector<std::uint16_t> one{static_cast<std::uint16_t>(0x1200 + core)};
+        write_tsa(device, core, 0x4000 + core);
+        auto result = write_dma(device, core, one);
+        require(result.status == DmaStatus::Consumed && result.start_tsa == 0x4000 + core &&
+                    result.end_tsa == 0x4000 + core,
+                "pinned write size<2 branch keeps each core TSA");
+        require(device.settleOrdinaryDma(core), "small DMA settles exactly once for each core");
+
+        set_irq(device, 0, 1);
+        set_irq(device, 1, 1);
+        std::vector<std::uint16_t> exact(8, 0x1111);
+        write_tsa(device, core, 0xffff8);
+        result = write_dma(device, core, exact);
+        require(result.status == DmaStatus::Consumed && result.start_tsa == 0xffff8 && result.end_tsa == 1 &&
+                    !result.crossed_spu_irq,
+                "exact 0x100000 write boundary remains non-wrapping with pinned IRQ predicate");
+        require(device.settleOrdinaryDma(core), "exact-boundary DMA settles for each core");
+
+        set_irq(device, 0, 0, false);
+        set_irq(device, 1, 0, false);
+        set_irq(device, 0, 4);
+        set_irq(device, 1, 4);
+        std::vector<std::uint16_t> wrapped{1, 2, 3, 4, 5, 6, 7, 8};
+        write_tsa(device, core, 0xffffc);
+        result = write_dma(device, core, wrapped);
+        require(result.status == DmaStatus::Consumed && result.start_tsa == 0xffffc && result.end_tsa == 5 &&
+                    result.crossed_spu_irq,
+                "wrapped write uses strict wrap and TSA plus one on both cores");
+        require(device.settleOrdinaryDma(core), "wrapped write settles for each core");
+        write_tsa(device, core, 0xffffc);
+        std::vector<std::uint16_t> roundtrip(wrapped.size());
+        result = read_dma(device, core, roundtrip);
+        require(result.status == DmaStatus::Consumed && result.start_tsa == 0xffffc && result.end_tsa == 0x24 &&
+                    roundtrip == wrapped,
+                "wrapped read preserves source words and uses TSA plus 0x20 on both cores");
+        require(device.cancelOrdinaryDma(core), "caller cancels only its own pending read record");
+    }
+
+    device.reset();
+    device.setSpuAddressIrq([&](std::uint8_t identity) { delivered.push_back(identity); });
+    delivered.clear();
+    set_irq(device, 0, 4);
+    std::vector<std::uint16_t> wrapped{1, 2, 3, 4, 5, 6, 7, 8};
+    write_tsa(device, 0, 0xffffc);
+    require(write_dma(device, 0, wrapped).crossed_spu_irq, "core-zero callback identity transfer crosses its fresh IRQ bit");
+    require(device.settleOrdinaryDma(0), "core-zero identity transfer settles");
+    device.advanceTo(kTick);
+    require(delivered == std::vector<std::uint8_t>({0}), "core-zero callback keeps its pending identity");
+    delivered.clear();
+    set_irq(device, 1, 4);
+    write_tsa(device, 0, 0xffffc);
+    require(write_dma(device, 0, wrapped).crossed_spu_irq,
+            "old sticky core zero does not suppress new core-one callback acceptance");
+    require(device.settleOrdinaryDma(0), "core-one identity transfer settles");
+    device.advanceTo(kTick * 2);
+    require(delivered == std::vector<std::uint8_t>({1}),
+            "new core-one callback keeps its identity while core zero remains sticky");
+    delivered.clear();
+    write_tsa(device, 0, 0xffffc);
+    require(write_dma(device, 0, wrapped).status == DmaStatus::Consumed,
+            "two sticky IRQs still execute their pinned address predicate");
+    require(device.settleOrdinaryDma(0), "two-sticky IRQ transfer settles");
+    device.advanceTo(kTick * 3);
+    require(delivered.empty(), "sticky core IRQs do not create duplicate callback identities");
+    set_irq(device, 0, 4, false);
+    set_irq(device, 0, 4, true);
+    write_tsa(device, 0, 0xffffc);
+    require(write_dma(device, 0, wrapped).crossed_spu_irq, "disable/enable re-arms only core zero");
+    require(device.settleOrdinaryDma(0), "rearmed core-zero DMA settles");
+    device.advanceTo(kTick * 4);
+    require(delivered == std::vector<std::uint8_t>({0}), "rearmed callback preserves core-zero identity");
+
+    const auto tsa_before_invalid = read_tsa(device, 0);
+    std::vector<std::uint16_t> empty;
+    require(write_dma(device, 0, empty).status == DmaStatus::InvalidRange, "zero DMA is rejected before mutation");
+    std::vector<std::uint16_t> oversized(ga2::spu::kSampleRamWords + 1);
+    require(write_dma(device, 0, oversized).status == DmaStatus::InvalidRange, "oversized DMA is rejected before mutation");
+    require(read_tsa(device, 0) == tsa_before_invalid, "invalid DMA leaves full TSA unchanged");
+
+    device.reset();
+    std::vector<StereoFrame> pcm;
+    device.setPcmSink([&](std::span<const StereoFrame> frames) { pcm.insert(pcm.end(), frames.begin(), frames.end()); });
+    program_voice(device, true, 0x7777);
+    device.advanceTo(kTick * 40);
+    const auto first_decode = pcm;
+    require(has_nonzero_pcm(first_decode), "first raw ADPCM block decodes to audible PCM");
+    auto overwrite = make_adpcm(0x1111, true);
+    write_adpcm(device, 0x2800, overwrite);
+    device.write16(0x1a0, 1);
+    const auto restart = pcm.size();
+    device.advanceTo(kTick * 80);
+    const auto overwritten_decode = tail_from(pcm, restart);
+    require(has_nonzero_pcm(overwritten_decode) && !equal_pcm(first_decode, overwritten_decode),
+            "overwriting the same cached ADPCM address changes subsequently decoded PCM");
+
+    auto wrapped_tail = std::vector<std::uint16_t>(0x13000, 0x1111);
+    wrapped_tail[0] = 0x0700;
+    const auto tail_offset = 0x100000u - 0xf0000u + 0x2800u;
+    require(tail_offset + 8 <= wrapped_tail.size(), "wrapped DMA contains a tail block above 0x2800");
+    const auto changed_tail = make_adpcm(0x2222, true);
+    std::copy(changed_tail.begin(), changed_tail.end(), wrapped_tail.begin() + tail_offset);
+    write_tsa(device, 0, 0xf0000);
+    require(write_dma(device, 0, wrapped_tail).status == DmaStatus::Consumed, "wrapped tail overwrite consumes all source words");
+    require(device.settleOrdinaryDma(0), "wrapped tail overwrite settles");
+    device.write16(0x1a0, 1);
+    const auto tail_restart = pcm.size();
+    device.advanceTo(kTick * 120);
+    const auto tail_decode = tail_from(pcm, tail_restart);
+    require(has_nonzero_pcm(tail_decode) && !equal_pcm(overwritten_decode, tail_decode),
+            "wrapped DMA tail above 0x2800 invalidates its cached decode rather than retaining old PCM");
+}
