+Device::Device() : m_impl(std::make_unique<Impl>())
+{
+    if (g_live_owner)
+        throw std::logic_error("the legacy SPU core permits exactly one live Device");
+    spu2regs = static_cast<s16*>(std::calloc(1, 0x010000));
+    _spu2mem = static_cast<s16*>(std::calloc(1, 0x200000));
+    pcm_cache_data = static_cast<PcmCacheEntry*>(std::calloc(pcm_BlockCount, sizeof(PcmCacheEntry)));
+    if (!spu2regs || !_spu2mem || !pcm_cache_data) {
+        std::free(pcm_cache_data);
+        std::free(_spu2mem);
+        std::free(spu2regs);
+        pcm_cache_data = nullptr;
+        _spu2mem = nullptr;
+        spu2regs = nullptr;
+        throw std::bad_alloc();
+    }
+    g_live_owner = m_impl.get();
+    reset();
+}
+
+Device::~Device()
+{
+    if (!m_impl)
+        return;
+    g_pcm_batch = nullptr;
+    g_pcm_sink = {};
+    g_address_irq = {};
+    g_new_irq_bits = 0;
+    std::free(pcm_cache_data);
+    std::free(_spu2mem);
+    std::free(spu2regs);
+    pcm_cache_data = nullptr;
+    _spu2mem = nullptr;
+    spu2regs = nullptr;
+    g_live_owner = nullptr;
+}
+
+Device::Device(Device&& other)
+{
+    if (other.m_impl && other.m_impl->in_operation)
+        throw std::logic_error("cannot move an active Device");
+    m_impl = std::move(other.m_impl);
+    if (m_impl)
+        g_live_owner = m_impl.get();
+}
+
+Device& Device::operator=(Device&& other)
+{
+    if ((m_impl && m_impl->in_operation) || (other.m_impl && other.m_impl->in_operation))
+        throw std::logic_error("cannot move an active Device");
+    if (this == &other)
+        return *this;
+    if (m_impl)
+        std::terminate(); // A live legacy core cannot be replaced safely.
+    m_impl = std::move(other.m_impl);
+    if (m_impl)
+        g_live_owner = m_impl.get();
+    return *this;
+}
+
+void Device::reset()
+{
+    if (!m_impl)
+        throw std::logic_error("moved-from Device has no legacy core");
+    auto& impl = *m_impl;
+    Operation operation(impl.in_operation, impl.faulted, true);
+    try {
+        reset_upstream_state();
+        std::memset(pcm_cache_data, 0, sizeof(PcmCacheEntry) * pcm_BlockCount);
+        impl.dma_pending = {};
+        impl.last_cycles = 0;
+        impl.cache_invalidations = 0;
+        g_pcm_batch = nullptr;
+        g_pcm_sink = {};
+        g_address_irq = {};
+        impl.faulted = false;
+    } catch (...) {
+        impl.faulted = true;
+        g_pcm_batch = nullptr;
+        throw;
+    }
+}
+
+std::uint16_t Device::read16(std::uint32_t address) const
+{
+    if (!m_impl || g_live_owner != m_impl.get())
+        throw std::logic_error("Device does not own the legacy core");
+    const auto offset = address & 0x7ff;
+    const auto core = (offset & 0x400) ? 1u : 0u;
+    if ((offset & 0x3ff) == 0x1ac) {
+        auto& impl = *m_impl;
+        Operation operation(impl.in_operation, impl.faulted);
+        return Cores[core].DmaRead();
+    }
+    return *regtable[offset >> 1];
+}
+
+void Device::write16(std::uint32_t address, std::uint16_t value)
+{
+    if (!m_impl)
+        throw std::logic_error("moved-from Device has no legacy core");
+    auto& impl = *m_impl;
+    Operation operation(impl.in_operation, impl.faulted);
+    if ((address & 0x3ff) == 0x1b0 && value != 0)
+        throw std::logic_error("AutoDMA is unsupported by the ordinary-DMA prototype");
+    try {
+        SPU2_FastWrite(address, value);
+    } catch (...) {
+        impl.faulted = true;
+        throw;
+    }
+}
+
+DmaResult Device::transfer(OrdinaryDma transfer)
+{
+    if (!m_impl)
+        return {.status = DmaStatus::Faulted};
+    auto& impl = *m_impl;
+    if (impl.faulted)
+        return {.status = DmaStatus::Faulted};
+    Operation operation(impl.in_operation, impl.faulted);
+    if (transfer.core > 1)
+        return {.status = DmaStatus::InvalidCore};
+    if (transfer.auto_dma)
+        return {.status = DmaStatus::UnsupportedAutoDma};
+    if (transfer.words.empty() || transfer.words.size() > kSampleRamWords ||
+        transfer.words.size() > std::numeric_limits<std::uint32_t>::max())
+        return {.status = DmaStatus::InvalidRange};
+    if (impl.dma_pending[transfer.core])
+        return {.status = DmaStatus::Busy};
+
+    V_Core& core = Cores[transfer.core];
+    const auto words = static_cast<std::uint32_t>(transfer.words.size());
+    const auto start = core.TSA & kSampleRamMask;
+    if (transfer.direction == DmaDirection::ToSpuRam && words < 2) {
+        core.Regs.STATX &= ~0x80;
+        impl.dma_pending[transfer.core] = true;
+        return {.status = DmaStatus::Consumed, .words_transferred = words, .start_tsa = start, .end_tsa = start};
+    }
+
+    try {
+        const auto geometry = dma_geometry(start, words, transfer.direction == DmaDirection::ToSpuRam ? 1u : 0x20u);
+        const auto pending_before = g_new_irq_bits;
+        if (transfer.direction == DmaDirection::ToSpuRam) {
+            // This is the pinned PlainDMAWrite bulk layout. The second
+            // invalidation deliberately covers the wrapped decoded-cache tail.
+            std::memcpy(GetMemPtr(geometry.start), transfer.words.data(), geometry.first_words * sizeof(std::uint16_t));
+            invalidate_cache_segment(geometry.start, geometry.first_words, impl.cache_invalidations);
+            if (geometry.tail_words) {
+                std::memcpy(GetMemPtr(0), transfer.words.data() + geometry.first_words,
+                            geometry.tail_words * sizeof(std::uint16_t));
+                invalidate_cache_segment(0, geometry.tail_words, impl.cache_invalidations);
+            }
+        } else {
+            std::memcpy(transfer.words.data(), GetMemPtr(geometry.start), geometry.first_words * sizeof(std::uint16_t));
+            if (geometry.tail_words)
+                std::memcpy(transfer.words.data() + geometry.first_words, GetMemPtr(0),
+                            geometry.tail_words * sizeof(std::uint16_t));
+        }
+        queue_dma_irqs(geometry);
+        core.TSA = geometry.tda;
+        core.Regs.STATX &= ~0x80;
+        impl.dma_pending[transfer.core] = true;
+        return {.status = DmaStatus::Consumed,
+                .words_transferred = words,
+                .start_tsa = start,
+                .end_tsa = geometry.tda,
+                .crossed_spu_irq = (g_new_irq_bits & ~pending_before) != 0};
+    } catch (...) {
+        impl.faulted = true;
+        throw;
+    }
+}
+
+bool Device::settleOrdinaryDma(std::uint8_t core) noexcept
+{
+    if (!m_impl || m_impl->faulted || m_impl->in_operation || core > 1 || !m_impl->dma_pending[core])
+        return false;
+    m_impl->in_operation = true;
+    Cores[core].Regs.STATX |= 0x80;
+    m_impl->dma_pending[core] = false;
+    m_impl->in_operation = false;
+    return true;
+}
+
+bool Device::cancelOrdinaryDma(std::uint8_t core) noexcept
+{
+    if (!m_impl || m_impl->faulted || m_impl->in_operation || core > 1 || !m_impl->dma_pending[core])
+        return false;
+    m_impl->in_operation = true;
+    Cores[core].Regs.STATX |= 0x80;
+    m_impl->dma_pending[core] = false;
+    m_impl->in_operation = false;
+    return true;
+}
+
+void Device::advanceTo(std::uint64_t iop_cycles)
+{
+    if (!m_impl)
+        throw std::logic_error("moved-from Device has no legacy core");
+    auto& impl = *m_impl;
+    Operation operation(impl.in_operation, impl.faulted);
+    if (iop_cycles <= impl.last_cycles)
+        return;
+    try {
+        while (iop_cycles - impl.last_cycles >= kIopCyclesPerSample) {
+            PcmBatch batch;
+            batch.requested = static_cast<std::size_t>(std::min<std::uint64_t>(
+                kFramesPerBatch, (iop_cycles - impl.last_cycles) / kIopCyclesPerSample));
+            g_pcm_batch = &batch;
+            for (std::size_t index = 0; index < batch.requested; ++index) {
+                // Pinned TimeUpdate delivers already-pending IRQs before the
+                // next sample mix; do not deliver new Mix() IRQs early.
+                dispatch_pending_irqs();
+                ++Cycles;
+                start_voices();
+                Mix();
+                if (batch.count != index + 1)
+                    throw std::logic_error("upstream mixer did not produce exactly one PCM frame");
+                impl.last_cycles += kIopCyclesPerSample;
+                lClocks = static_cast<u32>(impl.last_cycles);
+            }
+            g_pcm_batch = nullptr;
+            if (g_pcm_sink && batch.count)
+                g_pcm_sink(std::span<const StereoFrame>(batch.frames.data(), batch.count));
+        }
+    } catch (...) {
+        g_pcm_batch = nullptr;
+        impl.faulted = true;
+        throw;
+    }
+}
