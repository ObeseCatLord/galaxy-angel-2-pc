+DmaGeometry dma_geometry(std::uint32_t start, std::uint32_t words, std::uint32_t endpoint_bias)
+{
+    const std::uint64_t end = static_cast<std::uint64_t>(start) + words;
+    const bool wrapped = end > ga2::spu::kSampleRamWords; // Pinned source is strict here.
+    const auto first_words = static_cast<std::uint32_t>(wrapped ? ga2::spu::kSampleRamWords - start : words);
+    return {start, first_words, words - first_words,
+            static_cast<std::uint32_t>((end + endpoint_bias) & ga2::spu::kSampleRamMask), wrapped};
+}
+
+bool crosses_pinned_dma_irq(const DmaGeometry& geometry, std::uint32_t irq_address)
+{
+    return geometry.wrapped ? irq_address > geometry.start || irq_address <= geometry.tda
+                            : irq_address > geometry.start && irq_address <= geometry.tda;
+}
