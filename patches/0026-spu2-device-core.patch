+std::vector<std::uint16_t> make_adpcm(std::uint16_t sample_word, bool loop)
+{
+    std::vector<std::uint16_t> adpcm(8, sample_word);
+    // The high byte is the XA flags byte.  A one-block loop needs LOOP_START,
+    // LOOP, and LOOP_END; LOOP_START alone is not a playable loop.
+    adpcm[0] = loop ? 0x0700 : 0x0100;
+    constexpr std::array<std::uint16_t, 7> kNibbles{0x1234, 0x5678, 0x2468, 0x1357, 0x7f00, 0x00f7, 0x4242};
+    for (std::size_t index = 1; index < adpcm.size(); ++index)
+        adpcm[index] ^= kNibbles[index - 1];
+    return adpcm;
+}
