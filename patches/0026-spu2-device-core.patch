diff --git a/ps2xIOP/spu2core/README.md b/ps2xIOP/spu2core/README.md
new file mode 100644
index 0000000..b854e16
--- /dev/null
+++ b/ps2xIOP/spu2core/README.md
@@ -0,0 +1,26 @@
+# GA2 pure SPU device core prototype
+
+This is a private, standalone C++20 prototype.  It owns only serialized SPU
+state and exposes 16-bit MMIO, synchronous ordinary DMA, timestamped device
+advancement, PCM delivery, and a distinct SPU-address IRQ callback.
+
+`Device::transfer()` consumes its span before returning and never completes an
+IOP DMA channel.  Its caller owns pending-DMA creation, cancellation, status
+settlement, and completion IRQ policy.  AutoDMA returns `UnsupportedAutoDma`;
+it has no fabricated completion path.
+
+PCM spans are borrowed and synchronous.  No host thread can read guest RAM or
+device state through this library.  Calls must be serialized by one owner.
+There may be exactly one live `Device`, because the imported legacy core has
+process-global state.  A second construction throws.  Reset and destruction
+clear the borrowed PCM/IRQ callbacks and any active batch pointer.  A missing
+PCM sink discards generated frames; a throwing sink propagates after that batch
+has committed device time, so retrying does not replay it.
+
+The device algorithms are derived from the read-only PCSX2 v1.6.0 SPU2-X study
+at commit `aaaf29557fe63870ede815dd6d2e48a98279ca59`: register layout and
+side effects (`regs.h`, `spu2sys.cpp`), plain DMA/cache behavior (`Dma.cpp`),
+and ADSR/ADPCM/pitch/loop/mix behavior (`ADSR.cpp`, `Mixer.cpp`), with exact
+upstream `Reverb.cpp` retained.  The legacy
+plugin's host output, configuration, VM state, and DMA countdown/callback
+policy are intentionally absent.
diff --git a/ps2xIOP/spu2core/adapted/README.md b/ps2xIOP/spu2core/adapted/README.md
new file mode 100644
index 0000000..face55d
--- /dev/null
+++ b/ps2xIOP/spu2core/adapted/README.md
@@ -0,0 +1,10 @@
+# Reproducible upstream adaptations
+
+`generate_upstream.cmake` reads only the pinned files named in
+`../upstream-provenance.json` and writes generated copies into the private CMake
+build directory. It fails when either exact source fragment differs.
+
+The mixer delta replaces only its reachable function-static noise seed and
+removes the final frontend dealias/EQ block. The SPU-system delta reports a bit
+only after pinned `SetIrqCall` has accepted it. The checked-in unified diff is
+an audit aid; vendor sources remain unchanged.
diff --git a/ps2xIOP/spu2core/adapted/generate_upstream.cmake b/ps2xIOP/spu2core/adapted/generate_upstream.cmake
new file mode 100644
index 0000000..5d5cf54
--- /dev/null
+++ b/ps2xIOP/spu2core/adapted/generate_upstream.cmake
@@ -0,0 +1,44 @@
+if(NOT DEFINED SOURCE_FILE OR NOT DEFINED OUTPUT_FILE OR NOT DEFINED MODE)
+    message(FATAL_ERROR "SOURCE_FILE, OUTPUT_FILE, and MODE are required")
+endif()
+
+file(READ "${SOURCE_FILE}" source)
+if(MODE STREQUAL "mixer")
+    set(old_noise "    static u16 lfsr = 0xC0FEu;")
+    set(new_noise "    u16& lfsr = ga2_spu_noise_lfsr();")
+    set(old_filter [=[#ifdef DEBUG_KEYS
+        if (postprocess_filter_enabled)
+#endif
+        {
+            if (postprocess_filter_dealias) {
+                // Dealias filter emphasizes the highs too much.
+                Out = Apply_Dealias_Filter(Out);
+            }
+            Out = Apply_Frequency_Response_Filter(Out);
+        }]=])
+    set(new_filter "")
+elseif(MODE STREQUAL "spu2sys")
+    set(old_noise [=[    Spdif.Info |= 4 << core;
+    has_to_call_irq = true;]=])
+    set(new_noise [=[    Spdif.Info |= 4 << core;
+    has_to_call_irq = true;
+    ga2_spu_record_new_irq(static_cast<u8>(core));]=])
+    set(old_filter "")
+    set(new_filter "")
+else()
+    message(FATAL_ERROR "Unsupported adaptation mode: ${MODE}")
+endif()
+
+string(FIND "${source}" "${old_noise}" offset)
+if(offset EQUAL -1)
+    message(FATAL_ERROR "Pinned ${MODE} source no longer matches the audited delta")
+endif()
+string(REPLACE "${old_noise}" "${new_noise}" source "${source}")
+if(MODE STREQUAL "mixer")
+    string(FIND "${source}" "${old_filter}" offset)
+    if(offset EQUAL -1)
+        message(FATAL_ERROR "Pinned mixer filter block no longer matches the audited delta")
+    endif()
+    string(REPLACE "${old_filter}" "${new_filter}" source "${source}")
+endif()
+file(WRITE "${OUTPUT_FILE}" "${source}")
