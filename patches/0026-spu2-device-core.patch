+struct Device::Impl {
+    std::array<bool, 2> dma_pending{};
+    std::uint64_t last_cycles{};
+    std::uint64_t cache_invalidations{};
+    bool in_operation{};
+    bool faulted{};
+};
+
+namespace {
+
+class Operation final {
+public:
+    Operation(bool& in_operation, bool faulted, bool allow_fault = false) : m_in_operation(in_operation)
+    {
+        if (m_in_operation)
+            throw std::logic_error("Device callbacks must not reenter Device");
+        if (faulted && !allow_fault)
+            throw std::logic_error("Device is faulted; reset is required");
+        m_in_operation = true;
+    }
+    ~Operation() { m_in_operation = false; }
+
+private:
+    bool& m_in_operation;
+};
+
+void invalidate_cache_segment(std::uint32_t start, std::uint32_t words, std::uint64_t& cache_invalidations)
+{
+    if (words == 0)
+        return;
+    const auto first = start / pcm_WordsPerBlock;
+    const auto last = (start + words - 1) / pcm_WordsPerBlock;
+    for (std::uint32_t index = first; index <= last; ++index) {
+        if (pcm_cache_data[index].Validated)
+            ++cache_invalidations;
+        pcm_cache_data[index].Validated = false;
+    }
+}
+
+void queue_dma_irqs(const DmaGeometry& geometry)
+{
+    for (const auto& irq_core : Cores) {
+        if (irq_core.IRQEnable && crosses_pinned_dma_irq(geometry, irq_core.IRQA))
+            SetIrqCall(irq_core.Index);
+    }
+}
+
+void dispatch_pending_irqs()
+{
+    const auto pending = g_new_irq_bits;
+    g_new_irq_bits = 0;
+    has_to_call_irq = false;
+    if (!g_address_irq)
+        return;
+    for (std::uint8_t core = 0; core != 2; ++core) {
+        if (pending & (1u << core))
+            g_address_irq(core);
+    }
+}
+
+void start_voices()
+{
+    for (int core = 0; core != 2; ++core) {
+        if (!Cores[core].KeyOn)
+            continue;
+        for (int voice = 0; voice != 24; ++voice) {
+            if ((Cores[core].KeyOn >> voice) & 1u && Cores[core].Voices[voice].Start())
+                Cores[core].KeyOn &= ~(1u << voice);
+        }
+    }
+}
+
