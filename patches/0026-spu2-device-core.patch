+        device.setPcmSink([&](std::span<const StereoFrame> frames) { pcm.insert(pcm.end(), frames.begin(), frames.end()); });
+        program_voice(device, true);
+        std::vector<std::uint32_t> nax;
+        for (std::uint64_t sample = 1; sample <= 41; ++sample) {
+            device.advanceTo(kTick * sample);
+            nax.push_back(read_nax(device));
+        }
+        const auto running_nax = nax.back();
+        require(has_nonzero_pcm(pcm) &&
+                    std::all_of(nax.begin(), nax.end(), [](const auto value) { return value >= 0x2800 && value < 0x2808; }) &&
+                    std::adjacent_find(nax.begin(), nax.end(), std::not_equal_to<>()) != nax.end(),
+                "one real LOOP_START|LOOP|LOOP_END block yields nonzero PCM and evolving full NAX within its loop");
+        const auto first_trajectory = tail_from(pcm, 0);
+        device.write16(0x1a0, 1);
+        const auto retrigger_first = pcm.size();
+        device.advanceTo(kTick * 42);
+        const auto retrigger_nax = read_nax(device);
+        device.advanceTo(kTick * 81);
+        const auto retriggered = tail_from(pcm, retrigger_first);
+        require(running_nax != retrigger_nax && has_nonzero_pcm(retriggered) &&
+                    equal_pcm(std::vector<StereoFrame>(first_trajectory.begin(), first_trajectory.begin() + 40), retriggered),
+                "repeated KON after running NAX resets the voice to its original audible trajectory");
+    }
+
+    {
+        Device device;
+        std::vector<StereoFrame> pcm;
+        device.setPcmSink([&](std::span<const StereoFrame> frames) { pcm.insert(pcm.end(), frames.begin(), frames.end()); });
+        program_voice(device);
+        device.advanceTo(kTick * 64);
+        const auto normal_pcm = pcm;
+        const auto normal_nax = read_nax(device);
+        device.reset();
+        pcm.clear();
+        device.setPcmSink([&](std::span<const StereoFrame> frames) { pcm.insert(pcm.end(), frames.begin(), frames.end()); });
+        program_voice(device);
+        device.write16(0x004, 0x1800);
+        device.advanceTo(kTick * 64);
+        require(has_nonzero_pcm(pcm) && !equal_pcm(normal_pcm, pcm) && normal_nax != read_nax(device),
+                "pitch change measurably changes both NAX advancement and decoded PCM");
+
+        const auto before_koff = pcm;
+        device.write16(0x1a4, 1);
+        const auto after_koff_begin = pcm.size();
+        device.advanceTo(kTick * 128);
+        const auto after_koff = tail_from(pcm, after_koff_begin);
+        const auto final_window = tail_from(after_koff, after_koff.size() - 16);
+        require(has_nonzero_pcm(before_koff) && pcm_peak(after_koff) < pcm_peak(before_koff) && !has_nonzero_pcm(final_window),
+                "known fast ADSR release drops and ends audible PCM after KOFF");
+    }
+
+    {
+        Device device;
+        program_voice(device, false);
+        device.advanceTo(kTick * 128);
+        require((device.read16(0x340) & 1u) != 0, "non-loop ADPCM flags set ENDX");
+    }
+
+    {
+        Device moved_from;
+        write_tsa(moved_from, 0, 0x5000);
+        moved_from.write16(0x1ac, 0x6a5a);
+        write_tsa(moved_from, 1, 0x6000);
+        moved_from.write16(0x5ac, 0x5a6a);
+        write_tsa(moved_from, 0, 0x5000);
+        write_tsa(moved_from, 1, 0x6000);
+        Device moved(std::move(moved_from));
+        require_logic_error([&] { (void)moved_from.read16(0x1ac); }, "moved-from data-port read rejects before TSA mutation");
+        require_logic_error([&] { (void)moved_from.read16(0x5ac); }, "moved-from core-one data-port read rejects before TSA mutation");
+        require(moved.read16(0x1ac) == 0x6a5a && moved.read16(0x5ac) == 0x5a6a,
+                "moved owner retains both data-port TSAs and RAM ownership");
+        std::size_t frames = 0;
+        bool constructor_rejected = false;
+        moved.setPcmSink([&](std::span<const StereoFrame> values) {
+            frames += values.size();
+            try {
+                Device forbidden(std::move(moved));
+                (void)forbidden;
+            } catch (const std::logic_error&) {
+                constructor_rejected = true;
+            }
+        });
+        moved.advanceTo(kTick);
+        require(constructor_rejected && moved.lastIopCycle() == kTick,
+                "active callback move construction rejects before owner mutation and leaves Device usable");
+        Device& inactive = moved_from;
+        bool assignment_rejected = false;
+        moved.setPcmSink([&](std::span<const StereoFrame> values) {
+            frames += values.size();
+            try {
+                inactive = std::move(moved);
+            } catch (const std::logic_error&) {
+                assignment_rejected = true;
+            }
+        });
+        moved.advanceTo(kTick * 2);
+        require(assignment_rejected && moved.lastIopCycle() == kTick * 2,
+                "active callback move assignment rejects before owner mutation and preserves later operations");
+        moved.advanceTo(kTick * 10016);
+        require(frames == 10016 && moved.lastIopCycle() == kTick * 10016,
+                "moved owner retains large-jump clock state after rejected active moves");
+    }
+}
+
+void test_allocation_failure_does_not_claim_owner()
+{
+    for (int failure = 1; failure <= 3; ++failure) {
+        g_calloc_calls = 0;
+        g_nonnull_frees = 0;
+        g_fail_calloc_call = failure;
+        try {
+            Device rejected;
+            (void)rejected;
+            require(false, "selected legacy calloc failure propagates");
+        } catch (const std::bad_alloc&) {
+        }
+        g_fail_calloc_call = 0;
+        require(g_calloc_calls == 3 && g_nonnull_frees == 2,
+                "each selected legacy calloc failure still cleans up its two successfully allocated peer pointers exactly once");
+        Device recovered;
+        recovered.advanceTo(kTick);
+        require(!recovered.faulted(), "each calloc failure leaves no live-owner residue for next construction");
+    }
+}
+
+} // namespace
+
+#if defined(GA2_TEST_CALLOC_WRAP)
+extern "C" void* __real_calloc(std::size_t count, std::size_t size);
+extern "C" void __real_free(void* pointer);
+
+extern "C" void* __wrap_calloc(std::size_t count, std::size_t size)
+{
+    ++g_calloc_calls;
+    if (g_fail_calloc_call == g_calloc_calls)
+        return nullptr;
+    return __real_calloc(count, size);
+}
+
+extern "C" void __wrap_free(void* pointer)
+{
+    if (pointer)
+        ++g_nonnull_frees;
+    __real_free(pointer);
+}
+#endif
+
+int main(int argc, char** argv)
+{
+    if (argc == 2 && std::string(argv[1]) == "--fresh-signature") {
+        std::cout << cold_signature(false) << '\n';
+        return 0;
+    }
+    require(argc == 1, "unexpected test argument");
+    test_cold_reset_recreate_and_fresh_process(argv[0]);
+    test_dma_irq_boundary_matrix();
+    test_dma_endpoints_irq_and_cache();
+    test_irq_fault_rearm_and_reentrancy();
+    test_pcm_clock_voice_and_move_contracts();
+    test_allocation_failure_does_not_claim_owner();
+    std::cout << "ga2_spu_device_core_tests: PASS\n";
+}
