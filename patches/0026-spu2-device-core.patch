+void test_irq_fault_rearm_and_reentrancy()
+{
+    Device device;
+    std::vector<std::uint16_t> words(8, 0x1111);
+    set_irq(device, 0, 0x2804);
+    device.setSpuAddressIrq([](std::uint8_t) { throw std::runtime_error("first irq"); });
+    write_tsa(device, 0, 0x2800);
+    require(write_dma(device, 0, words).crossed_spu_irq, "first IRQ is pending");
+    require(device.settleOrdinaryDma(0), "first IRQ DMA settles before delivery");
+    try {
+        device.advanceTo(kTick);
+        require(false, "first IRQ throw propagates");
+    } catch (const std::runtime_error&) {
+    }
+    require(device.faulted() && device.lastIopCycle() == 0, "first IRQ throw faults without replaying a sample");
+    require(device.transfer({.words = words}).status == DmaStatus::Faulted, "faulted core cannot transfer");
+    require(!device.settleOrdinaryDma(0), "faulted core cannot settle");
+    require(device.read16(0x000) == 0, "faulted Device keeps non-mutating register diagnostics readable");
+
+    device.reset();
+    std::size_t delivered = 0;
+    device.setSpuAddressIrq([&](std::uint8_t) { ++delivered; });
+    device.advanceTo(kTick);
+    require(delivered == 0, "reset clears a failed borrowed IRQ batch instead of replaying it");
+
+    set_irq(device, 0, 0x2804);
+    write_tsa(device, 0, 0x2800);
+    require(write_dma(device, 0, words).crossed_spu_irq, "rearmed IRQ is pending");
+    require(device.settleOrdinaryDma(0), "rearmed DMA settles");
+    device.advanceTo(kTick * 2);
+    require(delivered == 1, "reset enables a new IRQ delivery");
+
+    set_irq(device, 0, 0, false);
+    set_irq(device, 0, 0x2804);
+    write_tsa(device, 0, 0x2800);
+    require(write_dma(device, 0, words).crossed_spu_irq, "guest IRQ disable/enable acknowledges sticky state");
+    require(device.settleOrdinaryDma(0), "rearmed sticky DMA settles");
+    device.advanceTo(kTick * 3);
+    require(delivered == 2, "disable/enable rearm yields one new identity-preserving delivery");
+
+    bool rejected_reentry0 = false;
+    bool rejected_reentry1 = false;
+    write_tsa(device, 0, 0x4000);
+    device.write16(0x1ac, 0x55aa);
+    write_tsa(device, 1, 0x5000);
+    device.write16(0x5ac, 0xaa55);
+    write_tsa(device, 0, 0x4000);
+    write_tsa(device, 1, 0x5000);
+    require(device.read16(0x1ac) == 0x55aa,
+            "core-zero data-port read returns RAM through the guarded path");
+    require(device.read16(0x5ac) == 0xaa55, "core-one data-port read returns RAM through the guarded path");
+    write_tsa(device, 0, 0x4000);
+    write_tsa(device, 1, 0x5000);
+    device.setPcmSink([&](std::span<const StereoFrame>) {
+        try {
+            (void)device.read16(0x1ac);
+        } catch (const std::logic_error&) {
+            rejected_reentry0 = true;
+        }
+        try {
+            (void)device.read16(0x5ac);
+        } catch (const std::logic_error&) {
+            rejected_reentry1 = true;
+        }
+    });
+    device.advanceTo(kTick * 4);
+    require(rejected_reentry0 && rejected_reentry1 && read_tsa(device, 0) == 0x4000 && read_tsa(device, 1) == 0x5000,
+            "both data-port callback reads reject before either TSA mutates");
+
+    device.reset();
+    std::size_t delivered_pcm = 0;
+    device.setPcmSink([&](std::span<const StereoFrame> frames) { delivered_pcm += frames.size(); });
+    program_voice(device);
+    set_irq(device, 0, 0x2804);
+    device.setSpuAddressIrq([](std::uint8_t) { throw std::runtime_error("intermediate voice IRQ"); });
+    try {
+        device.advanceTo(kTick * 64);
+        require(false, "intermediate voice IRQ throw propagates from one advanceTo call");
+    } catch (const std::runtime_error&) {
+    }
+    const auto committed_prefix = device.lastIopCycle();
+    require(device.faulted() && committed_prefix >= kTick && committed_prefix < kTick * 64,
+            "intermediate voice IRQ preserves a completed sample prefix before faulting");
+    require(delivered_pcm == 0, "fault discards the borrowed PCM batch containing the undelivered prefix");
+    require(!device.settleOrdinaryDma(0) && device.transfer({.words = words}).status == DmaStatus::Faulted,
+            "fault after a committed prefix permits neither settle nor transfer replay");
+    device.reset();
+    std::size_t after_reset = 0;
+    device.setPcmSink([&](std::span<const StereoFrame> frames) { after_reset += frames.size(); });
+    device.advanceTo(kTick);
+    require(after_reset == 1 && device.lastIopCycle() == kTick,
+            "reset discards remaining notifications and restarts from a new clock epoch");
+}
