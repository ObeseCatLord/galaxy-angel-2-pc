+void write_adpcm(Device& device, std::uint32_t address, std::span<std::uint16_t> adpcm)
+{
+    write_tsa(device, 0, address);
+    require(device.transfer({.core = 0, .direction = DmaDirection::ToSpuRam, .words = adpcm}).status == DmaStatus::Consumed,
+            "voice ADPCM DMA consumed");
+    require(device.settleOrdinaryDma(0), "voice ADPCM DMA settled by caller");
+}
+
+void program_voice(Device& device, bool loop = true, std::uint16_t sample_word = 0x7777, bool noise = false)
+{
+    auto adpcm = make_adpcm(sample_word, loop);
+    write_adpcm(device, 0x2800, adpcm);
+    device.write16(0x000, 0x3fff);
+    device.write16(0x002, 0x3fff);
+    device.write16(0x004, 0x1000);
+    device.write16(0x006, 0x0000); // Fast linear attack.
+    device.write16(0x008, 0x0000); // Fast linear release for the KOFF check.
+    device.write16(0x1c0, 0x0000);
+    device.write16(0x1c2, 0x2800);
+    device.write16(0x188, 0x0001);
+    device.write16(0x190, 0x0001);
+    device.write16(0x198, 0x0c00);
+    device.write16(0x760, 0x3fff);
+    device.write16(0x762, 0x3fff);
+    device.write16(0x788, 0x3fff);
+    device.write16(0x78a, 0x3fff);
+    device.write16(0x790, 0x3fff);
+    device.write16(0x792, 0x3fff);
+    device.write16(0x598, 0x000c);
+    device.write16(0x19a, 0x0000);
+    device.write16(0x184, noise ? 0x0001 : 0x0000);
+    device.write16(0x1a0, 0x0001);
+}
+
+std::vector<StereoFrame> render_voice(const std::vector<std::uint64_t>& timestamps)
+{
+    Device device;
+    std::vector<StereoFrame> pcm;
+    device.setPcmSink([&](std::span<const StereoFrame> frames) { pcm.insert(pcm.end(), frames.begin(), frames.end()); });
+    program_voice(device, true);
+    for (const auto timestamp : timestamps)
+        device.advanceTo(timestamp);
+    return pcm;
+}
+
+bool equal_pcm(const std::vector<StereoFrame>& left, const std::vector<StereoFrame>& right)
+{
+    if (left.size() != right.size())
+        return false;
+    for (std::size_t index = 0; index < left.size(); ++index) {
+        if (left[index].left != right[index].left || left[index].right != right[index].right)
+            return false;
+    }
+    return true;
+}
+
+bool has_nonzero_pcm(const std::vector<StereoFrame>& frames)
+{
+    return std::any_of(frames.begin(), frames.end(), [](const StereoFrame frame) {
+        return frame.left != 0 || frame.right != 0;
+    });
+}
+
+std::int32_t pcm_peak(const std::vector<StereoFrame>& frames)
+{
+    std::int32_t peak = 0;
+    for (const auto frame : frames) {
+        peak = std::max(peak, std::abs(static_cast<std::int32_t>(frame.left)));
+        peak = std::max(peak, std::abs(static_cast<std::int32_t>(frame.right)));
+    }
+    return peak;
+}
+
+std::vector<StereoFrame> tail_from(const std::vector<StereoFrame>& frames, std::size_t first)
+{
+    require(first <= frames.size(), "PCM tail is inside recorded output");
+    return {frames.begin() + static_cast<std::ptrdiff_t>(first), frames.end()};
+}
+
+void program_noise_reverb(Device& device)
+{
+    program_voice(device, true, std::uint16_t{0x7777}, true);
+    device.write16(0x198, 0x0fff); // Enable dry and wet voice gates.
+    device.write16(0x2e0, 8);
+    device.write16(0x2e2, 0);
+    device.write16(0x33c, 8);      // Valid 0x80000..0x8ffff-word work area.
+    auto tap = [&](std::uint32_t reg, std::uint16_t offset) {
+        device.write16(reg, 0); device.write16(reg+2, offset);
+    };
+    for (auto [reg, offset] : std::array<std::pair<std::uint32_t,std::uint16_t>,14>{{
+        {0x2e4,8},{0x2e8,8},{0x2ec,0x100},{0x2f0,0x200},
+        {0x2f4,0xff},{0x2f8,0x1ff},{0x304,0xff},{0x308,0x1ff},
+        {0x30c,0x300},{0x310,0x400},{0x32c,0x500},{0x330,0x600},
+        {0x334,0x700},{0x338,0x800}}}) tap(reg,offset);
+    device.write16(0x774,0x7fff); // IIR coefficient.
+    device.write16(0x776,0x7fff); // First comb path reads preceding IIR output.
+    device.write16(0x77e,0x4000);
+    device.write16(0x780,0x4000);
+    device.write16(0x782,0x4000);
+    device.write16(0x784,0x7fff);
+    device.write16(0x786,0x7fff);
+    device.write16(0x764,0x7fff);
+    device.write16(0x766,0x7fff);
+    device.write16(0x19a,0x0180); // Enable effects without reinitializing voices.
+    require(device.read16(0x184)==1 && (device.read16(0x19a)&0x80),
+            "fixture actually enables noise and reverb");
+}
+
+std::vector<std::uint16_t> effects_ram(Device& device)
+{
+    write_tsa(device,0,0x80000);
+    std::vector<std::uint16_t> data(0x10000);
+    require(read_dma(device,0,data).status==DmaStatus::Consumed,"effects RAM read succeeds");
+    require(device.settleOrdinaryDma(0),"effects RAM diagnostic transfer settles");
+    return data;
+}
+
+bool nonzero_words(const std::vector<std::uint16_t>& data)
+{
+    return std::any_of(data.begin(),data.end(),[](auto x){return x!=0;});
+}
+
+void dirty_noise_reverb(Device& device)
+{
+    const auto noise_before=ga2_spu_noise_lfsr();
+    std::vector<StereoFrame> pcm;
+    device.setPcmSink([&](auto frames){pcm.insert(pcm.end(),frames.begin(),frames.end());});
+    program_noise_reverb(device);
+    device.advanceTo(kTick*512);
+    require(ga2_spu_noise_lfsr()!=noise_before,"live noise engine changes its reachable LFSR state");
+    require(has_nonzero_pcm(pcm),"noise/reverb fixture emits real nonzero PCM before reset");
+    require(nonzero_words(effects_ram(device)),"live reverb actually writes nonzero work RAM");
+    // Callback borrows this local vector only until this helper returns.
+    device.setPcmSink({});
+}
+
+std::string cold_signature(bool poison_then_reset)
+{
+    Device device;
+    if (poison_then_reset) { dirty_noise_reverb(device); device.reset(); }
+    std::uint64_t cold_hash=1469598103934665603ull;
+    // Capture all nonmutating register state before reprogramming or RAM reads.
+    for (std::uint32_t reg=0;reg<0x800;reg+=2) {
+        if ((reg&0x3ff)==0x1ac) continue;
+        cold_hash^=device.read16(reg);cold_hash*=1099511628211ull;
+    }
+    require(!nonzero_words(effects_ram(device)),"reset/fresh effects RAM is cold before reprogramming");
+    std::vector<StereoFrame> pcm;
+    device.setPcmSink([&](auto frames){pcm.insert(pcm.end(),frames.begin(),frames.end());});
+    program_noise_reverb(device);
+    device.advanceTo(kTick*512);
+    require(has_nonzero_pcm(pcm),"comparison trajectory actively renders noise/reverb");
+    auto ram=effects_ram(device);
+    require(nonzero_words(ram),"comparison trajectory actually changes valid reverb work RAM");
+    std::uint64_t hash=1469598103934665603ull;
+    for (auto frame:pcm) {
+        hash^=static_cast<std::uint16_t>(frame.left);hash*=1099511628211ull;
+        hash^=static_cast<std::uint16_t>(frame.right);hash*=1099511628211ull;
+    }
+    for (auto word:ram) { hash^=word;hash*=1099511628211ull; }
+    std::ostringstream signature;signature<<cold_hash<<':'<<pcm.size()<<':'<<hash;
+    return signature.str();
+}
+
+void test_cold_reset_recreate_and_fresh_process(const char* executable)
+{
+    const auto reset=cold_signature(true);
+    { Device dirty;dirty_noise_reverb(dirty); } // Destroy while dirty, without reset.
+    const auto recreate=cold_signature(false);
+    require(reset==recreate,"dirty reset/recreation match cold registers and identical active noise/reverb PCM/RAM");
+    const std::string command=std::string(executable)+" --fresh-signature";
+    FILE* child=popen(command.c_str(),"r");
+    require(child!=nullptr,"fresh-process signature starts");
+    char buffer[512]{};
+    require(std::fgets(buffer,sizeof(buffer),child)!=nullptr,"fresh-process signature returns");
+    require(pclose(child)==0,"fresh-process signature exits cleanly");
+    std::string fresh(buffer);
+    if (!fresh.empty() && fresh.back()=='\n') fresh.pop_back();
+    require(reset==fresh,"dirty reset/recreation match active fresh-process noise/reverb trajectory");
+}
