diff --git a/ps2xIOP/spu2core/include/ga2/spu_device.h b/ps2xIOP/spu2core/include/ga2/spu_device.h
new file mode 100644
index 0000000..95736fa
--- /dev/null
+++ b/ps2xIOP/spu2core/include/ga2/spu_device.h
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <span>
+
+namespace ga2::spu {
+
+inline constexpr std::uint32_t kSampleRamWords = 0x100000;
+inline constexpr std::uint32_t kSampleRamMask = kSampleRamWords - 1;
+inline constexpr std::uint64_t kIopCyclesPerSample = 768;
+
+struct StereoFrame {
+    std::int16_t left{};
+    std::int16_t right{};
+};
+
+enum class DmaDirection : std::uint8_t { ToSpuRam, FromSpuRam };
+enum class DmaStatus : std::uint8_t {
+    Consumed,
+    Busy,
+    InvalidCore,
+    InvalidRange,
+    UnsupportedAutoDma,
+    Faulted,
+    Cancelled,
+};
+
+// guest_address is diagnostic metadata supplied by the bus owner.  It is not
+// dereferenced here; `words` is synchronously consumed before transfer returns.
+struct OrdinaryDma {
+    std::uint8_t core{};
+    DmaDirection direction{DmaDirection::ToSpuRam};
+    std::uint32_t canonical_guest_address{};
+    std::span<std::uint16_t> words{};
+    bool auto_dma{};
+};
+
+struct DmaResult {
+    DmaStatus status{DmaStatus::Cancelled};
+    std::uint32_t words_transferred{};
+    std::uint32_t start_tsa{};
+    std::uint32_t end_tsa{};
+    bool crossed_spu_irq{};
+};
+
+// The spans passed to PcmSink remain valid only for the duration of the call.
+// A throwing sink observes fully committed samples, then faults the Device;
+// reset() is required before any mutable operation can resume.
+using PcmSink = std::function<void(std::span<const StereoFrame>)>;
+using SpuAddressIrq = std::function<void(std::uint8_t core)>;
+
+class Device final {
+public:
+    Device();
+    ~Device();
+    Device(Device&&);
+    Device& operator=(Device&&);
+    Device(const Device&) = delete;
+    Device& operator=(const Device&) = delete;
+
+    void reset();
+    [[nodiscard]] std::uint16_t read16(std::uint32_t address) const;
+    void write16(std::uint32_t address, std::uint16_t value);
+
+    // This synchronously consumes the source but never schedules or signals
+    // completion. The bus owner must call settleOrdinaryDma() exactly once.
+    [[nodiscard]] DmaResult transfer(OrdinaryDma transfer);
+    [[nodiscard]] bool settleOrdinaryDma(std::uint8_t core) noexcept;
+    [[nodiscard]] bool cancelOrdinaryDma(std::uint8_t core) noexcept;
+
+    // `iop_cycles` is a monotonic 64-bit timestamp.  Every elapsed 768-cycle
+    // interval produces one frame; no elapsed time is dropped or host-paced.
+    void advanceTo(std::uint64_t iop_cycles);
+    void setPcmSink(PcmSink sink);
+    void setSpuAddressIrq(SpuAddressIrq callback);
+
+    [[nodiscard]] std::uint64_t lastIopCycle() const noexcept;
+    [[nodiscard]] std::uint64_t cacheInvalidationCount() const noexcept;
+    [[nodiscard]] bool faulted() const noexcept;
+
+private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
+
+} // namespace ga2::spu
