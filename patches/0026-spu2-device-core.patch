+    std::memset(spu2regs, 0, 0x010000);
+    std::memset(_spu2mem, 0, 0x200000);
+    std::memset(_spu2mem + 0x2800, 7, 0x10);
+    std::memcpy(regtable, regtable_original, sizeof(regtable));
+    for (uint address = 0; address < 0x800; address += 2) {
+        if (!regtable[address >> 1])
+            regtable[address >> 1] = &spu2Ru16(address);
