+void test_dma_irq_boundary_matrix()
+{
+    struct Case { std::uint32_t start,irq; bool write_irq,read_irq; };
+    const std::array<Case,20> cases{{
+        {0x4000,0x4000,false,false},{0x4000,0x4001,true,true},
+        {0x4000,0x4008,true,true},{0x4000,0x4009,true,true},
+        {0x4000,0x400a,false,true},{0x4000,0x4020,false,true},
+        {0x4000,0x4028,false,true},{0x4000,0x4029,false,false},
+        {0xffff8,0xffff8,false,false},{0xffff8,0xfffff,false,false},
+        {0xffff8,0,false,false},{0xffff8,1,false,false},
+        {0xffff8,0x20,false,false},{0xffff8,0x21,false,false},
+        {0xffffc,0xffffc,false,false},{0xffffc,0xffffd,true,true},
+        {0xffffc,0,true,true},{0xffffc,5,true,true},
+        {0xffffc,0x24,false,true},{0xffffc,0x25,false,false}
+    }};
+    std::size_t checked=0;
+    for (std::uint8_t transfer_core:{std::uint8_t{0},std::uint8_t{1}})
+        for (std::uint8_t irq_core:{std::uint8_t{0},std::uint8_t{1}})
+            for (bool read:{false,true}) for (const auto& item:cases) {
+                Device device;
+                set_irq(device,0,0,false);set_irq(device,1,0,false);
+                std::vector<std::uint16_t> words(8,0x3456);
+                if (read) {
+                    write_tsa(device,transfer_core,item.start);
+                    require(write_dma(device,transfer_core,words).status==DmaStatus::Consumed,"read matrix source upload");
+                    require(device.settleOrdinaryDma(transfer_core),"read matrix source upload settles");
+                }
+                set_irq(device,irq_core,item.irq,true);
+                std::vector<std::uint8_t> delivered;
+                device.setSpuAddressIrq([&](auto core){delivered.push_back(core);});
+                write_tsa(device,transfer_core,item.start);
+                const auto result=read?read_dma(device,transfer_core,words):write_dma(device,transfer_core,words);
+                const bool expected=read?item.read_irq:item.write_irq;
+                const std::uint32_t endpoint=(item.start+8+(read?0x20:1))&0xfffff;
+                require(result.status==DmaStatus::Consumed && result.end_tsa==endpoint &&
+                        read_tsa(device,transfer_core)==endpoint,"both transfer-core TSA endpoints match frozen source");
+                require(result.crossed_spu_irq==expected,"fresh both-direction/core IRQ start/end/extra-region predicate");
+                device.advanceTo(kTick);
+                require(delivered==(expected?std::vector<std::uint8_t>{irq_core}:std::vector<std::uint8_t>{}),
+                        "fresh IRQ callback identity matches requested IRQ core, including wrap/exact-boundary");
+                require(device.settleOrdinaryDma(transfer_core),"boundary transfer remains externally settled");
+                ++checked;
+            }
+    require(checked==160,"complete fresh DMA/IRQ boundary matrix ran");
+}
