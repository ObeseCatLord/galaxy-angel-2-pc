From 6210edbd5e479ee2aa7811d412e7ceedc6b6c6e4 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Thu, 22 Oct 2026 22:24:47 -0500
Subject: [PATCH] mouse menus: the load/save list answers the pointer on every
 row

The list (six slots, the same in all three games) had no definition: its
upper rows passed the system menu's colour test, so only those answered
the pointer, at the wrong places. It is now a picture menu of its own,
tested first. Cursor steps wait until the picture shows the previous one
(it lags the game by a few frames: moving from the last row to the second
overshot to the first and stopped), and a target is kept, and a click's
confirm sent, only once the cursor has stayed on it for 8 frames.
Diagnostics: GA2_MENU_PROBE=1|<x> (row colours, a column, pointer and
cursor), GA2_MOUSE_FRAME_DUMP=<file.ppm> (the picture the probes read).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/src/lib/ps2_mouse.cpp       | 12 ++++
 ps2xRuntime/src/lib/ps2_mouse_menus.cpp | 89 ++++++++++++++++++++++++-
 2 files changed, 100 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/ps2_mouse.cpp b/ps2xRuntime/src/lib/ps2_mouse.cpp
index e90f1b9..9c07bb0 100644
--- a/ps2xRuntime/src/lib/ps2_mouse.cpp
+++ b/ps2xRuntime/src/lib/ps2_mouse.cpp
@@ -589,6 +589,18 @@ namespace ps2_mouse
         g_frame = rgba;
         g_frameWidth = width;
         g_frameHeight = height;
+        // GA2_MOUSE_FRAME_DUMP=<file.ppm>: every 10 s, the picture the menu probes read (diagnostic).
+        static const char *dump = std::getenv("GA2_MOUSE_FRAME_DUMP");
+        static int frames = 0;
+        if (dump && *dump && rgba && ++frames % 600 == 0)
+            if (FILE *f = std::fopen(dump, "wb"))
+            {
+                std::fprintf(f, "P6\n%u %u\n255\n", width, height);
+                for (size_t i = 0; i < size_t(width) * height; ++i)
+                    std::fwrite(rgba + i * 4u, 1, 3, f);
+                std::fclose(f);
+                std::fprintf(stderr, "[mouse] frame %ux%u (source %.0fx%.0f) -> %s\n", width, height, g_sourceWidth, g_sourceHeight, dump);
+            }
     }
 
     bool pixel(int x, int y, uint8_t rgb[3])
diff --git a/ps2xRuntime/src/lib/ps2_mouse_menus.cpp b/ps2xRuntime/src/lib/ps2_mouse_menus.cpp
index bed3545..1e8efc6 100644
--- a/ps2xRuntime/src/lib/ps2_mouse_menus.cpp
+++ b/ps2xRuntime/src/lib/ps2_mouse_menus.cpp
@@ -2,6 +2,7 @@
 #include "ps2_mouse.h"
 #include "ps2_host_backend.h"
 
+#include <cstdio>
 #include <cstdlib>
 #include <cstring>
 #include <string>
@@ -114,9 +115,22 @@ namespace ps2_mouse_menus
             int sampleRow = -1;      // row tested, from each item's top (-1: centre)
         };
 
+        constexpr size_t kSystemMenu = 1; // visualMenus() index of the story's system menu
+
         const std::vector<VisualMenu> &visualMenus()
         {
             static const std::vector<VisualMenu> table = {
+                // Load / save list, the same in all three games: six slots, the selected one gold, the others dark
+                // blue; the band above each slot's text is tested. First, because its upper rows also pass the
+                // system menu's test below (that matched by accident: only the first rows answered the pointer).
+                {{{60, 63, 436, 100},
+                  {60, 100, 436, 137.5f},
+                  {60, 137.5f, 436, 175},
+                  {60, 175, 436, 212.5f},
+                  {60, 212.5f, 436, 249.5f},
+                  {60, 249.5f, 436, 287}},
+                 false,
+                 4},
                 // System menu (Select in dialogue): ロード / セーブ / オプション / ゲームをやめる.
                 {{{241, 121, 407, 149}, {241, 155, 407, 183}, {241, 188, 407, 216}, {241, 221, 407, 249}}},
                 // Battle pause menu (Start to pause, then Select): オプション / ゲームをやめる.
@@ -131,6 +145,57 @@ namespace ps2_mouse_menus
             return table;
         }
 
+        // GA2_MENU_PROBE=1: once a second, the averaged colour of every row of every picture menu (diagnostic).
+        void probe()
+        {
+            static const bool on = std::getenv("GA2_MENU_PROBE") != nullptr;
+            static int frames = 0;
+            if (!on || ++frames % 60 != 0)
+                return;
+            // GA2_MENU_PROBE=<x>: also the column at x (every 2nd row, 96..300) where it changes.
+            if (const int column = std::atoi(std::getenv("GA2_MENU_PROBE")); column > 1)
+            {
+                std::string line = "[menu probe] column " + std::to_string(column) + ":";
+                int last[3] = {-100, -100, -100};
+                for (int y = 96; y <= 300; y += 2)
+                {
+                    uint8_t rgb[3] = {0, 0, 0};
+                    ps2_mouse::pixel(column, y, rgb);
+                    if (std::abs(rgb[0] - last[0]) + std::abs(rgb[1] - last[1]) + std::abs(rgb[2] - last[2]) > 30)
+                    {
+                        line += " " + std::to_string(y) + "=(" + std::to_string(rgb[0]) + "," + std::to_string(rgb[1]) + "," +
+                                std::to_string(rgb[2]) + ")";
+                        last[0] = rgb[0];
+                        last[1] = rgb[1];
+                        last[2] = rgb[2];
+                    }
+                }
+                std::fprintf(stderr, "%s\n", line.c_str());
+            }
+            for (size_t m = 0; m < visualMenus().size(); ++m)
+            {
+                const VisualMenu &menu = visualMenus()[m];
+                std::string line = "[menu probe] " + std::to_string(m) + ":";
+                for (const Item &it : menu.items)
+                {
+                    const int y = menu.sampleRow >= 0 ? static_cast<int>(it.y0) + menu.sampleRow
+                                                      : static_cast<int>((it.y0 + it.y1) * 0.5f);
+                    int r = 0, g = 0, b = 0, n = 0;
+                    for (int x = static_cast<int>(it.x0) + 15; x < static_cast<int>(it.x1) - 8; x += 6, ++n)
+                    {
+                        uint8_t rgb[3] = {0, 0, 0};
+                        ps2_mouse::pixel(x, y, rgb);
+                        r += rgb[0];
+                        g += rgb[1];
+                        b += rgb[2];
+                    }
+                    if (n)
+                        line += " (" + std::to_string(r / n) + "," + std::to_string(g / n) + "," + std::to_string(b / n) + ")";
+                }
+                std::fprintf(stderr, "%s\n", line.c_str());
+            }
+        }
+
         int visualCursor(const VisualMenu &menu)
         {
             int selected = -1;
@@ -226,6 +291,11 @@ namespace ps2_mouse_menus
         uint32_t g_object = 0;           // its object address
         int g_scanDelay = 0;
         int g_target = -1, g_moves = 0, g_phase = 0;
+        // The picture shows the game a few frames late: after a cursor press the next step waits until the picture
+        // shows the cursor somewhere else (or kSettleFrames passed), and the target is kept (and a confirm sent) only
+        // once the cursor has stayed on it for kSettleFrames.
+        constexpr int kSettleFrames = 8;
+        int g_cursorAtPress = -1, g_waitFrames = 0, g_onTargetFrames = 0;
         bool g_confirm = false, g_owns = false;
         uint16_t g_pulse = 0;
         float g_lastX = -1, g_lastY = -1;
@@ -320,6 +390,7 @@ namespace ps2_mouse_menus
         }
         // The menu on screen: one recognised from the picture, else a known
         // game object found in RAM.
+        probe();
         const std::vector<Item> *items = nullptr;
         const std::vector<Extra> *extras = nullptr;
         int cursor = -1;
@@ -372,11 +443,15 @@ namespace ps2_mouse_menus
         }
         g_owns = hovered >= 0;
         const bool moved = on && (x != g_lastX || y != g_lastY);
+        if (std::getenv("GA2_MENU_PROBE") && moved)
+            std::fprintf(stderr, "[menu probe] pointer %.0f,%.0f on %d, hovered %d, cursor %d, target %d\n", x, y, int(on),
+                         hovered, cursor, g_target);
         if (on) { g_lastX = x; g_lastY = y; }
         if (hovered >= 0 && (moved || ps2_mouse::clickedGame()) && hovered != g_target)
         {
             g_target = hovered;
             g_moves = 0;
+            g_onTargetFrames = 0;
         }
         if (hovered >= 0 && ps2_mouse::clickedGame())
             g_confirm = true;
@@ -390,6 +465,13 @@ namespace ps2_mouse_menus
         }
         if (g_target < 0)
             return 0;
+        // The last press has not shown on the picture yet: wait for it (a few frames at most).
+        if (g_cursorAtPress >= 0 && cursor == g_cursorAtPress && g_waitFrames < kSettleFrames)
+        {
+            ++g_waitFrames;
+            return 0;
+        }
+        g_cursorAtPress = -1;
         const int list = static_cast<int>(items->size());
         const int count = list + (extras ? static_cast<int>(extras->size()) : 0);
         if (cursor != g_target && g_moves < 2 * count)
@@ -402,8 +484,13 @@ namespace ps2_mouse_menus
                 g_pulse = g_target > cursor ? nextKey : prevKey; // works whether or not the list wraps
             ++g_moves;
             g_phase = 6;
+            g_cursorAtPress = cursor;
+            g_waitFrames = 0;
+            g_onTargetFrames = 0;
             return g_pulse;
         }
+        if (cursor == g_target && ++g_onTargetFrames < kSettleFrames)
+            return 0; // on the target: make sure it stays there (no step still on its way)
         if (cursor == g_target && g_confirm)
         {
             g_confirm = false;
@@ -428,7 +515,7 @@ namespace ps2_mouse_menus
             return false;
         // System menu: one red row (the cursor) and three blue ones, at the same rows the pointer menus use.
         {
-            const VisualMenu &menu = visualMenus().front();
+            const VisualMenu &menu = visualMenus()[kSystemMenu];
             int red = 0, blue = 0;
             for (const Item &it : menu.items)
             {
-- 
