+        tc.Run("GS PSMCT24 upload carries pixels split across IMAGE qwords", [](TestCase &t)
+        {
+            std::vector<uint8_t> vram(PS2_GS_VRAM_SIZE, 0u);
+            GS gs;
+            gs.init(vram.data(), static_cast<uint32_t>(vram.size()), nullptr);
+            const uint64_t bitblt = (static_cast<uint64_t>(1u) << 16) | (static_cast<uint64_t>(GS_PSM_CT24) << 24) |
+                                    (static_cast<uint64_t>(1u) << 48) | (static_cast<uint64_t>(GS_PSM_CT24) << 56);
+            gs.writeRegister(GS_REG_BITBLTBUF, bitblt);
+            gs.writeRegister(GS_REG_TRXPOS, 0ull);
+            gs.writeRegister(GS_REG_TRXREG, (32ull << 0) | (1ull << 32)); // 32 pixels => 96 bytes
+            gs.writeRegister(GS_REG_TRXDIR, 0ull);
+
+            uint8_t source[96] = {};
+            for (uint32_t i = 0; i < 96u; ++i)
+                source[i] = static_cast<uint8_t>(0x30u + i * 7u);
+            for (uint32_t qw = 0; qw < 6u; ++qw) // one qword per packet: pixels straddle every boundary
+            {
+                std::vector<uint8_t> packet;
+                appendU64(packet, makeGifTag(1u, GIF_FMT_IMAGE, 0u, true));
+                appendU64(packet, 0ull);
+                packet.insert(packet.end(), source + qw * 16u, source + qw * 16u + 16u);
+                gs.processGIFPacket(packet.data(), static_cast<uint32_t>(packet.size()));
+            }
+            for (uint32_t x = 0; x < 32u; ++x)
+            {
+                const uint32_t expected = static_cast<uint32_t>(source[x * 3u]) |
+                                          (static_cast<uint32_t>(source[x * 3u + 1u]) << 8u) |
+                                          (static_cast<uint32_t>(source[x * 3u + 2u]) << 16u);
+                t.Equals(gs.ReadVram(GS_PSM_CT24, 0u, 1u, x, 0u) & 0xFFFFFFu, expected,
+                         "every PSMCT24 pixel must survive qword-split IMAGE packets");
+            }
+        });
