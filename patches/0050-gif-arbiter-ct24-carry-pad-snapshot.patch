-            if (sizeBytes - offset < 3u)
+            uint8_t bytes[3];
+            uint32_t have = m_uploadCarryBytes;
+            std::memcpy(bytes, m_uploadCarry.data(), have);
+            while (have < 3u && offset < sizeBytes)
+                bytes[have++] = data[offset++];
+            m_uploadCarryBytes = 0u;
+            if (have < 3u)
