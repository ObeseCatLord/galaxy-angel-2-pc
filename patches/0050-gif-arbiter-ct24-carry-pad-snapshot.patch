diff --git a/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp b/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
index 88b190c..76c5fd4 100644
--- a/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
+++ b/ps2xRuntime/src/lib/gs/ps2_gif_arbiter.cpp
@@ -44,20 +44,27 @@ void GifArbiter::drain()
     if (!m_processFn)
         return;
 
+    // PATH1/PATH2 drain as they arrive, so a batch is queued PATH3 packets plus
+    // at most a few later PATH1/PATH2 ones, all pending together. Those win
+    // arbitration over PATH3 (kept in submission order), except that DIRECTHL
+    // cannot preempt PATH3 IMAGE data. One integer rank per packet keeps the
+    // ordering strict-weak for stable_sort.
     if (m_count > 1u)
-        std::stable_sort(m_queue.begin(), m_queue.begin() + static_cast<std::ptrdiff_t>(m_count),
-                     [](const GifArbiterPacket &a, const GifArbiterPacket &b)
-                     {
-                         // DIRECTHL cannot preempt PATH3 IMAGE transfers.
-                         if (a.path2DirectHl != b.path2DirectHl || a.path3Image != b.path3Image)
-                         {
-                             if (a.path3Image && b.path2DirectHl)
-                                 return true;
-                             if (a.path2DirectHl && b.path3Image)
-                                 return false;
-                         }
-                         return pathPriority(a.pathId) < pathPriority(b.pathId);
-                     });
+    {
+        const auto end = m_queue.begin() + static_cast<std::ptrdiff_t>(m_count);
+        const bool path3ImageQueued = std::any_of(m_queue.begin(), end,
+            [](const GifArbiterPacket &packet) { return packet.path3Image; });
+        const auto rank = [path3ImageQueued](const GifArbiterPacket &packet)
+        {
+            if (packet.pathId == GifPathId::Path3)
+                return 2;
+            if (packet.path2DirectHl && path3ImageQueued)
+                return 3;
+            return pathPriority(packet.pathId) == pathPriority(GifPathId::Path1) ? 0 : 1;
+        };
+        std::stable_sort(m_queue.begin(), end, [&rank](const GifArbiterPacket &a, const GifArbiterPacket &b)
+                         { return rank(a) < rank(b); });
+    }
 
     for (size_t i = 0; i < m_count; ++i)
     {
