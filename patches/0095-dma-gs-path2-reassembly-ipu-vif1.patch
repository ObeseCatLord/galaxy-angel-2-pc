+            std::vector<uint8_t> image;
+            appendU64(image, makeGifTagPrim(0u, GS_PRIM_TRIANGLE, GIF_FMT_IMAGE, 0u, true, true));
+            appendU64(image, 0ull);
+            gs.processGIFPacket(image.data(), static_cast<uint32_t>(image.size()));
+            t.IsTrue(primType() == before, "an IMAGE tag leaves PRIM alone even with PRE set");
+
+            std::vector<uint8_t> packed;
+            appendU64(packed, makeGifTagPrim(0u, GS_PRIM_TRIANGLE, GIF_FMT_PACKED, 1u, true, true));
+            appendU64(packed, 0x0Eull);
+            gs.processGIFPacket(packed.data(), static_cast<uint32_t>(packed.size()));
+            t.IsTrue(primType() == GS_PRIM_TRIANGLE, "a PACKED tag with PRE sets PRIM");
+        });
+
+        tc.Run("GIF arbiter finds a PATH3 IMAGE tag after a setup packet", [](TestCase &t)
+        {
+            std::vector<uint8_t> order;
+            GifArbiter arbiter([&](const uint8_t *data, uint32_t sizeBytes)
+            {
+                if (data && sizeBytes > 0u)
+                    order.push_back(data[0]);
+            });
+            // A+D setup (tag + 4 registers), then IMAGE: the first tag alone is not an image.
+            std::vector<uint8_t> upload;
+            appendU64(upload, makeGifTag(0x04u, GIF_FMT_PACKED, 1u, false)); // first byte 0x04
+            appendU64(upload, 0x0Eull);
+            for (int i = 0; i < 8; ++i) appendU64(upload, 0ull);
+            appendU64(upload, makeGifTag(1u, GIF_FMT_IMAGE, 0u, true));
+            appendU64(upload, 0ull);
+            appendU64(upload, 0ull); appendU64(upload, 0ull);
+            const std::vector<uint8_t> directHl(16u, 0xD2u);
+            arbiter.submit(GifPathId::Path3, upload.data(), static_cast<uint32_t>(upload.size()));
+            arbiter.submit(GifPathId::Path2, directHl.data(), static_cast<uint32_t>(directHl.size()), true);
+            arbiter.drain();
+            const std::vector<uint8_t> expected{0x04u, 0xD2u};
+            t.IsTrue(order == expected, "DIRECTHL waits behind a PATH3 upload whose IMAGE tag is not the first tag");
+        });
+
+        tc.Run("GIF arbiter keeps working after an oversized packet", [](TestCase &t)
+        {
+            uint32_t seen = 0u;
+            GifArbiter arbiter([&](const uint8_t *, uint32_t size) { seen += size; });
+            std::vector<uint8_t> big(2u * 1024u * 1024u, 0u);
+            const uint64_t tag = makeGifTag(0x7FFFu, GIF_FMT_IMAGE, 0u, true);
+            std::memcpy(big.data(), &tag, sizeof(tag));
+            arbiter.submit(GifPathId::Path3, big.data(), static_cast<uint32_t>(big.size()));
+            arbiter.drain();
+            const std::vector<uint8_t> small(32u, 0u);
+            arbiter.submit(GifPathId::Path2, small.data(), 32u);
+            arbiter.drain();
+            t.Equals(seen, static_cast<uint32_t>(big.size() + 32u), "both packets are delivered in full");
+        });
+    });
