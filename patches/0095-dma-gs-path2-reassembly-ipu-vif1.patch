 bool GifArbiter::isImagePacket(const uint8_t *data, uint32_t sizeBytes)
 {
-    if (!data || sizeBytes < 16u)
-        return false;
-
-    uint64_t tagLo = 0;
-    std::memcpy(&tagLo, data, sizeof(tagLo));
-    const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
-    return flg == 2u;
+    // A PATH3 submission often opens with an A+D setup packet (BITBLTBUF/TRXPOS/
+    // TRXREG/TRXDIR) and carries the IMAGE tag second, so every tag in the
+    // submission is walked, not only the first. Tags are consumed by their
+    // declared payload; a payload running past the end ends the walk.
+    uint32_t offset = 0u;
+    while (data && offset + 16u <= sizeBytes)
+    {
+        uint64_t tagLo = 0;
+        std::memcpy(&tagLo, data + offset, sizeof(tagLo));
+        offset += 16u;
+        const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
+        if (flg == 2u)
+            return true;
+        const uint64_t nloop = tagLo & 0x7FFFu;
+        uint64_t nreg = (tagLo >> 60) & 0xFu;
+        if (nreg == 0u)
+            nreg = 16u;
+        uint64_t payload = 0u;
+        if (flg == 0u)
+            payload = nloop * nreg * 16ull;
+        else if (flg == 1u)
+            payload = (nloop * nreg * 8ull + 15ull) & ~15ull;
+        // flg 3 (reserved) carries no payload in the GS frontend's parser either.
+        if (payload > sizeBytes - offset)
+            return false;
+        offset += static_cast<uint32_t>(payload);
+    }
+    return false;
 }
 
