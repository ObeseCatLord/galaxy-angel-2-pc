@@ -82,6 +103,20 @@ void GifArbiter::drain()
         }
     }
     m_count = 0;
+    // The queue keeps its slots (and their buffers) between drains so steady
+    // state allocates nothing; give back the rare oversized upload so one big
+    // packet does not pin its memory in every later frame.
+    constexpr size_t kRetainBytes = 256u * 1024u;
+    for (auto &slot : m_queue)
+    {
+        if (slot.data.capacity() > kRetainBytes)
+            std::vector<uint8_t>().swap(slot.data);
+        if (slot.tapData.capacity() > kRetainBytes)
+            std::vector<uint8_t>().swap(slot.tapData);
+    }
+    constexpr size_t kRetainSlots = 64u;
+    if (m_queue.size() > kRetainSlots)
+        m_queue.resize(kRetainSlots);
 }
 
