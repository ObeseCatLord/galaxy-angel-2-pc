diff --git a/ps2xRuntime/include/runtime/ga2_ui_font.h b/ps2xRuntime/include/runtime/ga2_ui_font.h
new file mode 100644
index 0000000..743f42e
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_ui_font.h
@@ -0,0 +1,227 @@
+#pragma once
+
+// The port's own UI font (Noto Sans JP, native/fonts, shipped next to the executables) for the text the launcher and
+// the engines draw with raylib: menus, notices, on-screen pad labels. The font is a vector font rasterised at the
+// pixel size actually drawn (one atlas per size, built the first time that size is used, with only the glyphs the
+// text needs), so the text is as sharp as the window is at any resolution; bitmap fonts blown up would not be.
+// A glyph the atlas does not have yet is added by rebuilding that size's atlas, so any Japanese string works.
+//
+// Without the file (or when it cannot be rasterised) every call falls back to raylib's default font, so a missing
+// font never breaks a menu. GL thread only: atlases are textures.
+//
+//   GA2_UI_FONT=<file>   use this font file instead of <app dir>/fonts/NotoSansJP-Medium.otf
+//
+// Sizes are "DrawText font sizes": a size-20 line is about as tall as raylib's default font at 20.
+
+#include "raylib.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace ga2_ui_font
+{
+    namespace detail
+    {
+        // raylib sizes a TTF by its ascent-to-descent height; Noto Sans JP's is about 1.45 em with capitals 0.73 em
+        // tall, so this factor gives capitals about as tall as the default font's at the same nominal size.
+        constexpr float kRasterScale = 1.38f;
+        // Where the baseline sits in a text box of the nominal size (top of the box = y of the draw call).
+        constexpr float kBaseline = 0.80f;
+        constexpr size_t kMaxFaces = 24;
+
+        struct Face
+        {
+            Font font{};
+            std::vector<int> have; // sorted codepoints in the atlas
+            int baseline = 0;      // from the top of a glyph line to the baseline, in atlas pixels
+            uint64_t used = 0;
+        };
+
+        struct State
+        {
+            std::filesystem::path file;
+            bool fileSet = false, tried = false;
+            std::vector<unsigned char> data;
+            std::map<int, Face> faces;
+            uint64_t tick = 0;
+        };
+
+        inline State &state()
+        {
+            static State s;
+            return s;
+        }
+
+        inline std::filesystem::path pathFromUtf8(const char *text)
+        {
+            const std::string s(text);
+            return std::filesystem::path(std::u8string(s.begin(), s.end()));
+        }
+
+        inline bool available()
+        {
+            State &s = state();
+            if (s.tried)
+                return !s.data.empty();
+            s.tried = true;
+            std::filesystem::path file = s.file;
+            if (!s.fileSet)
+            {
+                if (const char *env = std::getenv("GA2_UI_FONT"); env && *env)
+                    file = pathFromUtf8(env);
+                else
+                    file = pathFromUtf8(GetApplicationDirectory()) / "fonts" / "NotoSansJP-Medium.otf";
+            }
+            std::ifstream in(file, std::ios::binary);
+            if (in)
+                s.data.assign(std::istreambuf_iterator<char>(in), std::istreambuf_iterator<char>());
+            return !s.data.empty();
+        }
+
+        // Codepoints every atlas starts with: ASCII, Latin-1 and the arrows and punctuation the menus use.
+        inline const std::vector<int> &baseCodepoints()
+        {
+            static const std::vector<int> base = [] {
+                std::vector<int> v;
+                for (int c = 32; c < 127; ++c) v.push_back(c);
+                for (int c = 160; c < 256; ++c) v.push_back(c);
+                for (int c : {0x2013, 0x2014, 0x2018, 0x2019, 0x201C, 0x201D, 0x2022, 0x2026, 0x2190, 0x2191, 0x2192, 0x2193})
+                    v.push_back(c);
+                return v;
+            }();
+            return base;
+        }
+
+        inline void unload(Face &face)
+        {
+            if (face.font.texture.id)
+                UnloadFont(face.font);
+            face.font = Font{};
+        }
+
+        inline bool build(Face &face, int pixels, const std::vector<int> &codepoints)
+        {
+            State &s = state();
+            Font font = LoadFontFromMemory(".otf", s.data.data(), int(s.data.size()), pixels,
+                                           const_cast<int *>(codepoints.data()), int(codepoints.size()));
+            if (!font.texture.id || font.glyphCount <= 0)
+            {
+                if (font.texture.id)
+                    UnloadFont(font);
+                return false;
+            }
+            SetTextureFilter(font.texture, TEXTURE_FILTER_BILINEAR);
+            unload(face);
+            face.font = font;
+            face.have = codepoints;
+            // The bottom of a capital H sits on the baseline.
+            const int h = GetGlyphIndex(font, 'H');
+            face.baseline = font.glyphs[h].offsetY + int(font.recs[h].height);
+            return true;
+        }
+
+        // The atlas for `pixels` with every codepoint of `text` in it, or nullptr to fall back.
+        inline Face *face(int pixels, const char *text)
+        {
+            if (!available())
+                return nullptr;
+            State &s = state();
+            int count = 0;
+            int *decoded = LoadCodepoints(text, &count);
+            std::vector<int> wanted(decoded, decoded + count);
+            UnloadCodepoints(decoded);
+            auto it = s.faces.find(pixels);
+            const bool fresh = it == s.faces.end();
+            Face &f = fresh ? s.faces[pixels] : it->second;
+            std::vector<int> missing;
+            for (int c : wanted)
+                if (c > 32 && c != 0xFFFD && !std::binary_search(f.have.begin(), f.have.end(), c) &&
+                    std::find(missing.begin(), missing.end(), c) == missing.end())
+                    missing.push_back(c);
+            if (fresh || !missing.empty())
+            {
+                std::vector<int> all = fresh ? baseCodepoints() : f.have;
+                all.insert(all.end(), missing.begin(), missing.end());
+                std::sort(all.begin(), all.end());
+                all.erase(std::unique(all.begin(), all.end()), all.end());
+                if (!build(f, pixels, all) && fresh)
+                {
+                    s.faces.erase(pixels);
+                    s.data.clear(); // cannot rasterise: the default font from now on
+                    return nullptr;
+                }
+                // Resizing a window walks through many sizes: keep the recent ones.
+                while (s.faces.size() > kMaxFaces)
+                {
+                    auto oldest = s.faces.end();
+                    for (auto i = s.faces.begin(); i != s.faces.end(); ++i)
+                        if (i->first != pixels && (oldest == s.faces.end() || i->second.used < oldest->second.used))
+                            oldest = i;
+                    unload(oldest->second);
+                    s.faces.erase(oldest);
+                }
+            }
+            Face &used = s.faces[pixels];
+            used.used = ++s.tick;
+            return used.font.texture.id ? &used : nullptr;
+        }
+
+        inline int rasterPixels(float size) { return std::max(6, int(std::lround(size * kRasterScale))); }
+    }
+
+    // Use this font file (UTF-8 aware path) instead of GA2_UI_FONT / <app dir>/fonts. Call before the first draw.
+    inline void setFile(const std::filesystem::path &file)
+    {
+        detail::State &s = detail::state();
+        s.file = file;
+        s.fileSet = true;
+        s.tried = false;
+        s.data.clear();
+    }
+
+    // Frees the atlases (before the window and its GL context go away).
+    inline void shutdown()
+    {
+        detail::State &s = detail::state();
+        for (auto &entry : s.faces)
+            detail::unload(entry.second);
+        s.faces.clear();
+        s.tried = false;
+        s.data.clear();
+    }
+
+    // Width in pixels of `text` (UTF-8, one line) at `size`.
+    inline float measure(const char *text, float size)
+    {
+        if (detail::Face *f = detail::face(detail::rasterPixels(size), text))
+            return MeasureTextEx(f->font, text, float(f->font.baseSize), 0.0f).x;
+        return float(MeasureText(text, int(size)));
+    }
+
+    // Draws one line with the top of its box at (x, y), like DrawText.
+    inline void draw(const char *text, float x, float y, float size, Color tint)
+    {
+        if (detail::Face *f = detail::face(detail::rasterPixels(size), text))
+        {
+            // Whole pixels, so a glyph's edges land on pixel edges.
+            const float top = std::round(y + size * detail::kBaseline - float(f->baseline));
+            DrawTextEx(f->font, text, Vector2{std::round(x), top}, float(f->font.baseSize), 0.0f, tint);
+            return;
+        }
+        DrawText(text, int(x), int(y), int(size), tint);
+    }
+
+    inline void draw(const std::string &text, float x, float y, float size, Color tint)
+    {
+        draw(text.c_str(), x, y, size, tint);
+    }
+    inline float measure(const std::string &text, float size) { return measure(text.c_str(), size); }
+}
