diff --git a/ps2xRuntime/include/runtime/sha256.h b/ps2xRuntime/include/runtime/sha256.h
new file mode 100644
index 0000000..ea27fbf
--- /dev/null
+++ b/ps2xRuntime/include/runtime/sha256.h
@@ -0,0 +1,185 @@
+// SHA-256 for disc identity checks (no OpenSSL dependency, so the same code
+// builds for Linux and Windows). Uses the x86 SHA extensions when the CPU
+// has them (~2 GB/s), otherwise a portable implementation.
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <string>
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <immintrin.h>
+#define GA2_SHA256_X86 1
+#endif
+
+namespace ga2_sha256
+{
+    inline constexpr uint32_t kRound[64] = {
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};
+
+    inline uint32_t rotr(uint32_t x, int n) { return (x >> n) | (x << (32 - n)); }
+
+    inline void compressPortable(uint32_t state[8], const uint8_t *block, size_t blocks)
+    {
+        for (; blocks != 0u; --blocks, block += 64)
+        {
+            uint32_t w[64];
+            for (int i = 0; i < 16; ++i)
+                w[i] = uint32_t(block[4 * i]) << 24 | uint32_t(block[4 * i + 1]) << 16 |
+                       uint32_t(block[4 * i + 2]) << 8 | uint32_t(block[4 * i + 3]);
+            for (int i = 16; i < 64; ++i)
+            {
+                const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
+                const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
+                w[i] = w[i - 16] + s0 + w[i - 7] + s1;
+            }
+            uint32_t a = state[0], b = state[1], c = state[2], d = state[3];
+            uint32_t e = state[4], f = state[5], g = state[6], h = state[7];
+            for (int i = 0; i < 64; ++i)
+            {
+                const uint32_t t1 = h + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e & f) ^ (~e & g)) + kRound[i] + w[i];
+                const uint32_t t2 = (rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a & b) ^ (a & c) ^ (b & c));
+                h = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
+            }
+            state[0] += a; state[1] += b; state[2] += c; state[3] += d;
+            state[4] += e; state[5] += f; state[6] += g; state[7] += h;
+        }
+    }
+
+#if defined(GA2_SHA256_X86) && (defined(__GNUC__) || defined(__clang__))
+    // Intel SHA extensions: state kept as ABEF/CDGH, four rounds per sha256rnds2 pair.
+    __attribute__((target("sha,sse4.1"))) inline void compressShaNi(uint32_t state[8], const uint8_t *block, size_t blocks)
+    {
+        const __m128i byteSwap = _mm_set_epi64x(0x0c0d0e0f08090a0bll, 0x0405060700010203ll);
+        __m128i tmp = _mm_loadu_si128(reinterpret_cast<const __m128i *>(&state[0]));
+        __m128i state1 = _mm_loadu_si128(reinterpret_cast<const __m128i *>(&state[4]));
+        tmp = _mm_shuffle_epi32(tmp, 0xB1);          // CDAB
+        state1 = _mm_shuffle_epi32(state1, 0x1B);    // EFGH
+        __m128i state0 = _mm_alignr_epi8(tmp, state1, 8); // ABEF
+        state1 = _mm_blend_epi16(state1, tmp, 0xF0);      // CDGH
+        for (; blocks != 0u; --blocks, block += 64)
+        {
+            const __m128i save0 = state0, save1 = state1;
+            __m128i msg[4];
+            for (int r = 0; r < 16; ++r)
+            {
+                if (r < 4)
+                    msg[r] = _mm_shuffle_epi8(_mm_loadu_si128(reinterpret_cast<const __m128i *>(block + 16 * r)), byteSwap);
+                __m128i wk = _mm_add_epi32(msg[r & 3], _mm_loadu_si128(reinterpret_cast<const __m128i *>(&kRound[4 * r])));
+                state1 = _mm_sha256rnds2_epu32(state1, state0, wk);
+                wk = _mm_shuffle_epi32(wk, 0x0E);
+                state0 = _mm_sha256rnds2_epu32(state0, state1, wk);
+                // Message schedule: finish W[r+1] (msg2), start W[r+3] (msg1).
+                if (r >= 3 && r <= 14)
+                    msg[(r + 1) & 3] = _mm_sha256msg2_epu32(
+                        _mm_add_epi32(msg[(r + 1) & 3], _mm_alignr_epi8(msg[r & 3], msg[(r + 3) & 3], 4)), msg[r & 3]);
+                if (r >= 1 && r <= 12)
+                    msg[(r + 3) & 3] = _mm_sha256msg1_epu32(msg[(r + 3) & 3], msg[r & 3]);
+            }
+            state0 = _mm_add_epi32(state0, save0);
+            state1 = _mm_add_epi32(state1, save1);
+        }
+        tmp = _mm_shuffle_epi32(state0, 0x1B);    // FEBA
+        state1 = _mm_shuffle_epi32(state1, 0xB1); // DCHG
+        state0 = _mm_blend_epi16(tmp, state1, 0xF0);      // DCBA
+        state1 = _mm_alignr_epi8(state1, tmp, 8);         // HGFE
+        _mm_storeu_si128(reinterpret_cast<__m128i *>(&state[0]), state0);
+        _mm_storeu_si128(reinterpret_cast<__m128i *>(&state[4]), state1);
+    }
+#endif
+
+    class Hasher
+    {
+    public:
+        Hasher() { reset(); }
+
+        void reset()
+        {
+            static constexpr uint32_t kInit[8] = {0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+                                                  0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19};
+            std::memcpy(m_state, kInit, sizeof(m_state));
+            m_length = 0u;
+            m_buffered = 0u;
+        }
+
+        void update(const void *data, size_t size)
+        {
+            const uint8_t *bytes = static_cast<const uint8_t *>(data);
+            m_length += size;
+            if (m_buffered != 0u)
+            {
+                const size_t take = std::min<size_t>(64u - m_buffered, size);
+                std::memcpy(m_buffer + m_buffered, bytes, take);
+                m_buffered += take; bytes += take; size -= take;
+                if (m_buffered < 64u) return;
+                compress(m_buffer, 1u);
+                m_buffered = 0u;
+            }
+            if (size >= 64u)
+            {
+                compress(bytes, size / 64u);
+                bytes += size / 64u * 64u;
+                size %= 64u;
+            }
+            std::memcpy(m_buffer, bytes, size);
+            m_buffered = size;
+        }
+
+        std::array<uint8_t, 32> finish()
+        {
+            const uint64_t bits = m_length * 8u;
+            const uint8_t one = 0x80u;
+            update(&one, 1u);
+            const uint8_t zero = 0u;
+            while (m_buffered != 56u) update(&zero, 1u);
+            uint8_t length[8];
+            for (int i = 0; i < 8; ++i) length[i] = static_cast<uint8_t>(bits >> (56 - 8 * i));
+            update(length, 8u);
+            std::array<uint8_t, 32> digest{};
+            for (int i = 0; i < 8; ++i)
+                for (int j = 0; j < 4; ++j)
+                    digest[size_t(4 * i + j)] = static_cast<uint8_t>(m_state[i] >> (24 - 8 * j));
+            return digest;
+        }
+
+        std::string finishHex()
+        {
+            static constexpr char kHex[] = "0123456789abcdef";
+            std::string out;
+            for (uint8_t byte : finish())
+            {
+                out.push_back(kHex[byte >> 4]);
+                out.push_back(kHex[byte & 15u]);
+            }
+            return out;
+        }
+
+    private:
+        void compress(const uint8_t *block, size_t blocks)
+        {
+#if defined(GA2_SHA256_X86) && (defined(__GNUC__) || defined(__clang__))
+            static const bool shaNi = __builtin_cpu_supports("sha") && __builtin_cpu_supports("sse4.1");
+            if (shaNi)
+            {
+                compressShaNi(m_state, block, blocks);
+                return;
+            }
+#endif
+            compressPortable(m_state, block, blocks);
+        }
+
+        uint32_t m_state[8];
+        uint64_t m_length = 0u;
+        uint8_t m_buffer[64];
+        size_t m_buffered = 0u;
+    };
+}
