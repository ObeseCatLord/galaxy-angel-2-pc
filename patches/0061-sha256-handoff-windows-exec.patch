 ps2xRuntime/include/runtime/sha256.h   | 185 +++++++++++++++++++++++++
 ps2xRuntime/src/lib/ps2_disc_mount.cpp |  27 +---
 ps2xRuntime/src/lib/ps2_runtime.cpp    |  48 ++++++-
 4 files changed, 236 insertions(+), 29 deletions(-)
 create mode 100644 ps2xRuntime/include/runtime/sha256.h

