diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index e188ef3..b06270f 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1253,6 +1253,9 @@ void PS2Runtime::addExecTarget(ExecTarget target)
     execTargets().push_back(std::move(target));
 }
 
+// Exit status that tells the launcher a handoff command is waiting.
+static constexpr int kHandoffExitCode = 75;
+
 bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std::string> &args)
 {
     // "cdrom0:\SLPM_667.79;1" -> "SLPM_667.79"
@@ -1304,6 +1307,23 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
     // included) and keep the new program from inheriting our descriptors
     // (disc images, card files, audio and GPU devices).
     std::fflush(nullptr);
+    // Started by the launcher: hand it the next command line (one argument
+    // per line) and exit with kHandoffExitCode; the launcher runs it and keeps
+    // waiting, which also works on Windows where exec spawns a new process.
+    if (const char *handoff = std::getenv("GA2_HANDOFF_FILE"); handoff && *handoff)
+    {
+        std::ofstream out(std::filesystem::path(handoff), std::ios::trunc);
+        for (const auto &arg : argv)
+            out << arg << '\n';
+        out.close();
+        if (out)
+        {
+            std::fflush(nullptr);
+            std::_Exit(kHandoffExitCode);
+        }
+        std::cerr << "[exec] cannot write the handoff file " << handoff << std::endl;
+        return false;
+    }
 #ifndef _WIN32
     if (DIR *fds = opendir("/proc/self/fd"))
     {
@@ -1321,7 +1341,33 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
     for (auto &arg : argv) raw.push_back(arg.data());
     raw.push_back(nullptr);
 #ifdef _WIN32
-    _execv(raw[0], raw.data());
+    // The CRT joins argv with spaces unquoted; quote like CommandLineToArgvW.
+    std::vector<std::string> quoted;
+    for (const auto &arg : argv)
+    {
+        if (!arg.empty() && arg.find_first_of(" \t\"") == std::string::npos)
+        {
+            quoted.push_back(arg);
+            continue;
+        }
+        std::string q = "\"";
+        size_t slashes = 0;
+        for (char c : arg)
+        {
+            if (c == '\\') { ++slashes; continue; }
+            if (c == '"') q.append(slashes * 2 + 1, '\\');
+            else q.append(slashes, '\\');
+            slashes = 0;
+            q.push_back(c);
+        }
+        q.append(slashes * 2, '\\');
+        q.push_back('"');
+        quoted.push_back(q);
+    }
+    std::vector<const char *> rawQuoted;
+    for (auto &arg : quoted) rawQuoted.push_back(arg.c_str());
+    rawQuoted.push_back(nullptr);
+    _execv(argv.front().c_str(), rawQuoted.data());
 #else
     execv(raw[0], raw.data());
 #endif
