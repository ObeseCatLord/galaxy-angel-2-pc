diff --git a/ps2xIOP/tests/iop_rpc_wait_tests.cpp b/ps2xIOP/tests/iop_rpc_wait_tests.cpp
new file mode 100644
index 0000000..e58ebc4
--- /dev/null
+++ b/ps2xIOP/tests/iop_rpc_wait_tests.cpp
@@ -0,0 +1,414 @@
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/iop_emulator_const.h"
+
+#include <cstdint>
+#include <array>
+#include <cstring>
+#include <exception>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <tuple>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+
+    constexpr uint32_t kDescriptorAddress = 0x1000u;
+    constexpr uint32_t kThreadEntry = 0x4000u;
+    constexpr uint32_t kArgument = 0x12345678u;
+    constexpr uint32_t kSecondArgument = 0x87654321u;
+    constexpr uint32_t kGp = 0x00123450u;
+
+    void require(bool condition, std::string_view message)
+    {
+        if (!condition)
+            throw std::runtime_error(std::string(message));
+    }
+
+    auto cpuFields(const IopCpuState &cpu)
+    {
+        return std::tie(cpu.gpr, cpu.hi, cpu.lo, cpu.pc, cpu.cop0,
+                        cpu.pendingLoadReg, cpu.pendingLoadValue, cpu.pendingLoad,
+                        cpu.branchPending, cpu.branchTarget, cpu.stopped, cpu.yielded,
+                        cpu.exception, cpu.missingImport, cpu.executionFault);
+    }
+
+    void requireCpu(const IopCpuState &cpu, const IopCpuState &expected, std::string_view message)
+    {
+        require(cpuFields(cpu) == cpuFields(expected), message);
+    }
+
+    void seedContinuation(IopCpuState &cpu, int id)
+    {
+        for (size_t index = 0; index < cpu.gpr.size(); ++index)
+        {
+            cpu.gpr[index] = 0xA5000000u + static_cast<uint32_t>(index);
+            cpu.cop0[index] = 0xB6000000u + static_cast<uint32_t>(index);
+        }
+        cpu.gpr[4] = static_cast<uint32_t>(id); // Also valid target for aliased imports.
+        cpu.pc = kThreadEntry + 0x24u;
+        cpu.hi = 0x13579BDFu;
+        cpu.lo = 0x2468ACE0u;
+        cpu.pendingLoadReg = 8u;
+        cpu.pendingLoadValue = 0xCAFEBABEu;
+        cpu.pendingLoad = true;
+        cpu.branchPending = true;
+        cpu.branchTarget = kThreadEntry + 0x80u;
+    }
+
+    struct KernelFixture
+    {
+        IopMemory memory;
+        IopKernel kernel{memory};
+        IopCpuState control{};
+
+        int createThread(uint32_t entry = kThreadEntry)
+        {
+            memory.write32(kDescriptorAddress + 0u, 0u);
+            memory.write32(kDescriptorAddress + 4u, 0u);
+            memory.write32(kDescriptorAddress + 8u, entry);
+            memory.write32(kDescriptorAddress + 12u, 0x400u);
+            memory.write32(kDescriptorAddress + 16u, 10u);
+            control = {};
+            control.gpr[4] = kDescriptorAddress;
+            require(kernel.dispatchThreadImport(4u, control, 0u), "CreateThread was not handled");
+            require(static_cast<int32_t>(control.gpr[2]) > 0, "CreateThread failed");
+            return static_cast<int>(control.gpr[2]);
+        }
+
+        void startThread(int id)
+        {
+            control = {};
+            control.gpr[4] = static_cast<uint32_t>(id);
+            control.gpr[5] = kArgument;
+            control.gpr[6] = kSecondArgument;
+            control.gpr[28] = kGp;
+            require(kernel.dispatchThreadImport(7u, control, 0u), "StartThreadArgs was not handled");
+            require(control.gpr[2] == 0u, "StartThreadArgs failed");
+        }
+
+        IopThread &runThread()
+        {
+            IopThread *thread = kernel.beginNextReady(0u);
+            require(thread != nullptr, "no ready worker");
+            require(thread->state == IopThreadState::Running, "worker did not enter running state");
+            require(thread->cpu.gpr[4] == kArgument && thread->cpu.gpr[5] == kSecondArgument &&
+                        thread->cpu.gpr[28] == kGp,
+                    "StartThreadArgs did not preserve continuation arguments");
+            return *thread;
+        }
+
+        void endSlice(IopThread &thread)
+        {
+            kernel.endTimeslice(thread, kThreadReturnSentinel);
+            require(!kernel.hasCurrentThread(), "timeslice owner was retained");
+        }
+
+        void importForThread(uint16_t ordinal, int id)
+        {
+            control = {};
+            control.gpr[4] = static_cast<uint32_t>(id);
+            IopCpuState expected = control;
+            expected.gpr[2] = 0u;
+            require(kernel.dispatchThreadImport(ordinal, control, 0u), "thread import was not handled");
+            require(control.gpr[2] == 0u, "thread import failed");
+            requireCpu(control, expected, "thread import altered separate caller continuation");
+        }
+
+        [[nodiscard]] IopKernel::RpcWaitOwner beginWait(IopThread &thread, uint64_t nonce)
+        {
+            IopCpuState expected = thread.cpu;
+            expected.yielded = true;
+            const auto owner = kernel.beginRpcWait(thread.cpu, nonce);
+            require(owner.has_value(), "beginRpcWait rejected the running worker");
+            require(thread.state == IopThreadState::RpcWait && thread.cpu.yielded,
+                    "beginRpcWait did not block and yield the worker");
+            requireCpu(thread.cpu, expected, "beginRpcWait changed worker continuation");
+            return *owner;
+        }
+    };
+
+    constexpr uint32_t kReplyAddress = 0x2000u;
+    using Reply = std::array<uint8_t, 16>;
+
+    Reply readReply(KernelFixture &fixture)
+    {
+        Reply reply{};
+        require(fixture.memory.readRam(kReplyAddress, reply.data(), reply.size()), "reply read failed");
+        return reply;
+    }
+
+    bool guardedReply(KernelFixture &fixture, const IopKernel::RpcWaitOwner &owner, uint8_t byte, int32_t result)
+    {
+        // Mirror the required bridge ordering: validate before any reply bytes
+        // are written, then complete. Predicate alone must reject stale owners.
+        if (!fixture.kernel.isRpcWaitCurrent(owner))
+            return false;
+        Reply reply{};
+        reply.fill(byte);
+        require(fixture.memory.writeRam(kReplyAddress, reply.data(), reply.size()), "reply write failed");
+        return fixture.kernel.completeRpcWait(owner, result);
+    }
+
+    void requireStaleOwner(KernelFixture &fixture, IopThread &thread,
+                           const IopKernel::RpcWaitOwner &owner)
+    {
+        const IopCpuState before = thread.cpu;
+        const auto state = thread.state;
+        const Reply reply = readReply(fixture);
+        require(!fixture.kernel.isRpcWaitCurrent(owner), "stale owner predicate remained true");
+        require(!guardedReply(fixture, owner, 0xEEu, -123), "stale owner passed guarded reply write");
+        require(readReply(fixture) == reply, "stale guarded reply changed memory");
+        require(!fixture.kernel.completeRpcWait(owner, -456), "stale direct completion accepted");
+        requireCpu(thread.cpu, before, "stale completion changed CPU continuation");
+        require(thread.state == state, "stale completion changed thread state");
+    }
+
+    void rejectAliasImport(KernelFixture &fixture, IopThread &thread, uint16_t ordinal)
+    {
+        const IopCpuState before = thread.cpu;
+        const auto state = thread.state;
+        const auto lifetime = thread.rpcLifetimeGeneration;
+        const auto generation = thread.rpcWaitGeneration;
+        const auto nonce = thread.rpcWaitNonce;
+        const auto result = thread.rpcWaitResult;
+        const auto ready = thread.rpcWaitResultReady;
+        const auto wakeups = thread.wakeupCount;
+        const auto current = fixture.kernel.hasCurrentThread();
+        require(!fixture.kernel.dispatchThreadImport(ordinal, thread.cpu, 0u), "blocked CPU import alias was accepted");
+        requireCpu(thread.cpu, before, "rejected alias changed CPU continuation");
+        require(thread.state == state && thread.rpcLifetimeGeneration == lifetime &&
+                    thread.rpcWaitGeneration == generation && thread.rpcWaitNonce == nonce &&
+                    thread.rpcWaitResult == result && thread.rpcWaitResultReady == ready &&
+                    thread.wakeupCount == wakeups && fixture.kernel.hasCurrentThread() == current,
+                "rejected alias changed owned wait or scheduler state");
+    }
+
+    void exactOwnershipWakeReleaseAndCompletion()
+    {
+        KernelFixture fixture;
+        const int id = fixture.createThread();
+        fixture.startThread(id);
+        IopThread &thread = fixture.runThread();
+        thread.cpu.gpr[2] = 0xA5A5A5A5u;
+        const uint32_t continuation = thread.cpu.pc;
+
+        IopCpuState impostor;
+        std::memcpy(&impostor, &thread.cpu, sizeof(impostor));
+        require(std::memcmp(&impostor, &thread.cpu, sizeof(impostor)) == 0, "foreign CPU copy was not byte-identical");
+        const IopCpuState beforeAdmission = thread.cpu;
+        require(!fixture.kernel.beginRpcWait(impostor, 1u).has_value(), "foreign CPU acquired RPC wait ownership");
+        require(!fixture.kernel.beginRpcWait(thread.cpu, 0u).has_value(), "zero RPC nonce was accepted");
+        requireCpu(thread.cpu, beforeAdmission, "rejected admission changed worker CPU");
+        requireCpu(impostor, beforeAdmission, "rejected admission changed foreign CPU");
+        const auto first = fixture.beginWait(thread, 1u);
+        const IopCpuState pendingCpu = thread.cpu;
+        const auto pendingGeneration = thread.rpcWaitGeneration;
+        require(!fixture.kernel.beginRpcWait(thread.cpu, 1u), "duplicate pending admission accepted same nonce");
+        require(!fixture.kernel.beginRpcWait(thread.cpu, 2u), "duplicate pending admission accepted new nonce");
+        requireCpu(thread.cpu, pendingCpu, "duplicate admission changed CPU");
+        require(thread.rpcWaitGeneration == pendingGeneration && fixture.kernel.isRpcWaitCurrent(first),
+                "duplicate admission changed owner");
+        require(thread.cpu.gpr[2] == 0xA5A5A5A5u && thread.cpu.pc == continuation,
+                "beginRpcWait modified V0 or continuation");
+        fixture.endSlice(thread);
+
+        fixture.importForThread(25u, id); // WakeupThread
+        fixture.importForThread(18u, id); // ReleaseWaitThread
+        require(thread.state == IopThreadState::RpcWait && fixture.kernel.beginNextReady(0u) == nullptr,
+                "generic wake or release advanced an RPC wait");
+
+        require(fixture.kernel.completeRpcWait(first, -37), "first RPC completion was rejected");
+        require(thread.state == IopThreadState::Ready && static_cast<int32_t>(thread.cpu.gpr[2]) == -37,
+                "negative RPC completion did not resume with V0");
+        require(!fixture.kernel.completeRpcWait(first, 99), "duplicate completion was accepted");
+        require(static_cast<int32_t>(thread.cpu.gpr[2]) == -37, "duplicate completion changed V0");
+
+        IopThread &secondRun = fixture.runThread();
+        const auto second = fixture.beginWait(secondRun, 2u);
+        fixture.endSlice(secondRun);
+        const uint32_t beforeWrongNonce = secondRun.cpu.gpr[2];
+        require(!fixture.kernel.completeRpcWait(first, 19), "wrong-nonce completion was accepted");
+        require(secondRun.state == IopThreadState::RpcWait && secondRun.cpu.gpr[2] == beforeWrongNonce,
+                "wrong-nonce completion changed the live wait");
+        require(fixture.kernel.completeRpcWait(second, 19), "success completion was rejected");
+        require(secondRun.state == IopThreadState::Ready && secondRun.cpu.gpr[2] == 19u,
+                "success completion did not resume the worker once");
+    }
+
+    void sameNonceCannotReviveCompletedOwner()
+    {
+        KernelFixture fixture;
+        const int id = fixture.createThread();
+        fixture.startThread(id);
+        IopThread &thread = fixture.runThread();
+        seedContinuation(thread.cpu, id);
+        const auto first = fixture.beginWait(thread, 77u);
+        const auto firstGeneration = thread.rpcWaitGeneration;
+        fixture.endSlice(thread);
+        require(guardedReply(fixture, first, 0x31u, 17), "first guarded reply failed");
+        const auto lifetime = thread.rpcLifetimeGeneration;
+        IopCpuState expected = thread.cpu;
+        expected.yielded = false;
