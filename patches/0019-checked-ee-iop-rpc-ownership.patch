+        thread.cpu.gpr[2] = static_cast<uint32_t>(result);
+        if (thread.state == IopThreadState::Suspended)
+        {
+            thread.rpcWaitResult = result;
+            thread.rpcWaitResultReady = true;
+            return true;
+        }
+
+        invalidateRpcWait(thread);
+        thread.state = IopThreadState::Ready;
+        return true;
+    }
