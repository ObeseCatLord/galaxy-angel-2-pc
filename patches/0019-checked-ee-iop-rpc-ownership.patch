+    try
+    {
+        exactOwnershipWakeReleaseAndCompletion();
+        sameNonceCannotReviveCompletedOwner();
+        suspendResumePreservesRpcWait();
+        lifecycleInvalidatesOldOwners();
+    }
+    catch (const std::exception &error)
+    {
+        std::cerr << "FAIL: " << error.what() << '\n';
+        return 1;
+    }
+    return 0;
+}
