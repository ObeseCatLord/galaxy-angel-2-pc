+        fixture.importForThread(11u, id); // TerminateThread
+        require(!fixture.kernel.isRpcWaitCurrent(restartedOwner) && !fixture.kernel.completeRpcWait(restartedOwner, 2),
+                "TerminateThread retained RPC ownership");
+
+        fixture.startThread(id);
+        IopThread &deletable = fixture.runThread();
+        const auto beforeDelete = fixture.beginWait(deletable, 6u);
+        fixture.endSlice(deletable);
+        fixture.importForThread(5u, id); // DeleteThread
+        require(!fixture.kernel.completeRpcWait(beforeDelete, 3), "DeleteThread retained RPC ownership");
+
+        const int rangeId = fixture.createThread(kThreadEntry + 0x100u);
+        fixture.startThread(rangeId);
+        IopThread &ranged = fixture.runThread();
+        const auto beforeRangeCleanup = fixture.beginWait(ranged, 7u);
+        fixture.endSlice(ranged);
+        fixture.kernel.terminateThreadsInRange(kThreadEntry + 0x100u, 4u);
+        fixture.kernel.cleanupDeadThreads();
+        require(!fixture.kernel.completeRpcWait(beforeRangeCleanup, 4),
+                "module-range cleanup retained RPC ownership");
+
+        const int resetId = fixture.createThread();
+        fixture.startThread(resetId);
+        IopThread &resettable = fixture.runThread();
+        const auto beforeReset = fixture.beginWait(resettable, 8u);
+        const auto preResetLifetime = resettable.rpcLifetimeGeneration;
+        const auto preResetWaitGeneration = resettable.rpcWaitGeneration;
+        fixture.endSlice(resettable);
+        fixture.kernel.reset();
+        require(!fixture.kernel.completeRpcWait(beforeReset, 5), "reset retained RPC ownership");
+
+        int reusedId = 0;
+        for (int expectedId = 1; expectedId <= resetId; ++expectedId)
+        {
+            reusedId = fixture.createThread();
+            require(reusedId == expectedId, "reset thread ID sequence changed");
+        }
+        require(reusedId == resetId, "reset replacement did not reuse exact old owner's thread ID");
+        fixture.startThread(reusedId);
+        IopThread &reused = fixture.runThread();
+        const auto reusedOwner = fixture.beginWait(reused, 8u);
+        require(reused.rpcLifetimeGeneration > preResetLifetime && reused.rpcWaitGeneration > preResetWaitGeneration,
+                "kernel-issued generation counter did not survive reset");
+        fixture.endSlice(reused);
+        const uint32_t reusedV0 = reused.cpu.gpr[2];
+        requireStaleOwner(fixture, reused, beforeReset);
+        require(reused.state == IopThreadState::RpcWait && reused.cpu.gpr[2] == reusedV0,
+                "stale reset completion touched reused ID and nonce");
+        require(fixture.kernel.completeRpcWait(reusedOwner, 7), "reused worker completion was rejected");
+    }
+}
