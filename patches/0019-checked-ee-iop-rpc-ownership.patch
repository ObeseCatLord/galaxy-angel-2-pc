+    std::optional<IopKernel::RpcWaitOwner> IopKernel::beginRpcWait(IopCpuState &cpu, uint64_t transactionNonce) noexcept
+    {
+        if (transactionNonce == 0u || m_currentThread == nullptr || &m_currentThread->cpu != &cpu ||
+            m_currentThread->state != IopThreadState::Running || m_currentThread->rpcWaitNonce != 0u ||
+            m_currentThread->rpcLifetimeGeneration == 0u)
