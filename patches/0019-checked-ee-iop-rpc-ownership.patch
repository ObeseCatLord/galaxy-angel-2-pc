+        fixture.endSlice(thread);
+        requireStaleOwner(fixture, thread, first);
+        require(fixture.kernel.isRpcWaitCurrent(second), "same-nonce second owner was not live");
+        require(guardedReply(fixture, second, 0x42u, -17), "same-nonce second completion failed");
+        requireStaleOwner(fixture, thread, second);
+    }
+
+    void suspendResumeScenario(bool endBeforeImports, bool replyBeforeResume, uint16_t suspendOrdinal)
+    {
+        KernelFixture fixture;
+        const int id = fixture.createThread();
+        fixture.startThread(id);
+        IopThread &thread = fixture.runThread();
+        seedContinuation(thread.cpu, id);
+        const auto owner = fixture.beginWait(thread, 3u);
+        const uint16_t resumeOrdinal = suspendOrdinal + 2u;
+        if (endBeforeImports)
+            fixture.endSlice(thread);
+        rejectAliasImport(fixture, thread, suspendOrdinal);
+        rejectAliasImport(fixture, thread, resumeOrdinal);
+        IopCpuState expected = thread.cpu;
+        fixture.importForThread(suspendOrdinal, id);
+        require(thread.state == IopThreadState::Suspended, "SuspendThread did not suspend RPC wait");
+        requireCpu(thread.cpu, expected, "separate suspension changed worker CPU");
+        rejectAliasImport(fixture, thread, suspendOrdinal);
+        rejectAliasImport(fixture, thread, resumeOrdinal);
+
+        const int32_t result = replyBeforeResume ? 42 : -9;
+        if (replyBeforeResume)
+        {
+            require(guardedReply(fixture, owner, 0x57u, result), "suspended reply failed");
+            expected.gpr[2] = static_cast<uint32_t>(result);
+            requireCpu(thread.cpu, expected, "suspended reply changed continuation beyond V0");
+            require(thread.state == IopThreadState::Suspended && fixture.kernel.beginNextReady(0u) == nullptr,
+                    "suspended reply made worker runnable");
+            requireStaleOwner(fixture, thread, owner);
+            rejectAliasImport(fixture, thread, suspendOrdinal);
+            rejectAliasImport(fixture, thread, resumeOrdinal);
+        }
+        fixture.importForThread(resumeOrdinal, id);
+        requireCpu(thread.cpu, expected, "separate resume changed worker continuation");
+        if (!replyBeforeResume)
+        {
+            require(thread.state == IopThreadState::RpcWait && fixture.kernel.isRpcWaitCurrent(owner),
+                    "resume-before-reply did not restore owned wait");
+            require(fixture.kernel.beginNextReady(0u) == nullptr, "resume-before-reply made worker runnable");
+            rejectAliasImport(fixture, thread, suspendOrdinal);
+            rejectAliasImport(fixture, thread, resumeOrdinal);
+            require(guardedReply(fixture, owner, 0x68u, result), "resumed wait reply failed");
+            expected.gpr[2] = static_cast<uint32_t>(result);
+        }
+        require(thread.state == IopThreadState::Ready, "completed resumed worker was not ready");
+        requireCpu(thread.cpu, expected, "reply/resume corrupted full continuation");
+        if (!endBeforeImports)
+            fixture.endSlice(thread);
+        expected.yielded = false;
+        require(fixture.kernel.beginNextReady(0u) == &thread, "reply/resume did not schedule exact worker");
+        requireCpu(thread.cpu, expected, "scheduler corrupted resumed RPC continuation");
+        fixture.endSlice(thread);
+    }
+
+    void suspendResumePreservesRpcWait()
+    {
+        for (bool endBeforeImports : {false, true})
+            for (bool replyBeforeResume : {false, true})
+                for (uint16_t suspendOrdinal : {29u, 30u})
+                    suspendResumeScenario(endBeforeImports, replyBeforeResume, suspendOrdinal);
+    }
+
+    void lifecycleInvalidatesOldOwners()
+    {
+        KernelFixture fixture;
+        const int id = fixture.createThread();
+        fixture.startThread(id);
+        IopThread &thread = fixture.runThread();
+        const auto beforeRestart = fixture.beginWait(thread, 5u);
+        fixture.endSlice(thread);
+
+        fixture.startThread(id);
+        IopThread &restarted = fixture.runThread();
+        const auto restartedOwner = fixture.beginWait(restarted, 5u);
+        fixture.endSlice(restarted);
+        const uint32_t restartV0 = restarted.cpu.gpr[2];
+        require(!fixture.kernel.completeRpcWait(beforeRestart, 1), "restart allowed an old owner to complete");
+        require(restarted.state == IopThreadState::RpcWait && restarted.cpu.gpr[2] == restartV0,
