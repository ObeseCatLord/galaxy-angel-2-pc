+               it->second.rpcLifetimeGeneration == owner.m_lifetimeGeneration &&
+               it->second.rpcWaitGeneration == owner.m_waitGeneration &&
+               it->second.rpcWaitNonce == owner.m_transactionNonce;
+    }
