+            IopCpuState cpu{};
+            cpu.gpr[4] = 0x13300u;
+            require(state.kernel.dispatchThreadImport(4u, cpu, state.totalCycles), "create owned thread");
+            const uint32_t id = cpu.gpr[2];
+            cpu.gpr[4] = id;
+            require(state.kernel.dispatchThreadImport(6u, cpu, state.totalCycles) && cpu.gpr[2] == 0u,
+                    "start owned thread");
+            return id;
+        };
+        try
+        {
+            // Real MIPS calls, two distinct asynchronous signals, same frame.
+            iop_test::Host host;
+            Impl state(host);
+            prepare(state);
+            for (const auto [irq, cycle] : {std::pair{36u, 100u}, std::pair{40u, 500u}})
+            {
+                IopCpuState registration{};
+                registration.gpr[4] = irq;
+                registration.gpr[6] = 0x11200u;
+                require(state.intrman.dispatchImport(4u, registration, state) &&
+                        state.intrman.dispatchImport(6u, registration, state), "register and enable DMA IRQ");
+                state.pendingDmaInterrupts.emplace(int(irq), cycle);
+            }
+            uint32_t result = 0u;
+            require(state.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0x165432u, 2000u, result)
+                        == IopGuestCallStatus::Completed && result == 0x14000u,
+                    "two waits did not return through held native RPC");
+            require(state.memory.read32(0x14000u) == 2u && state.memory.read32(0x14010u) == 2u &&
+                    state.memory.read32(0x14004u) == 0x165432u &&
+                    state.memory.read32(0x14008u) == kCallStackLimit - 64u &&
+                    state.memory.read32(0x1400Cu) == kCallReturnSentinel,
+                    "callback/chunk count or original GP/SP/RA frame changed");
+            IopCpuState poll{}; poll.gpr[4] = 1u;
+            require(state.kernel.dispatchSemaphoreImport(9u, poll) && int32_t(poll.gpr[2]) == -419,
+                    "signals were not consumed exactly once");
+            require(!state.activeCpu && !state.rpcWaitCpu && !state.kernel.hasCurrentThread() && state.callDepth == 0u,
+                    "successful call leaked execution ownership");
+
+            // Both IRQs fire in one pump. Reservation of the first signal must
+            // leave room for the second even when maximum semaphore count is 1.
+            iop_test::Host doubleHost; Impl doubleSignal(doubleHost); prepare(doubleSignal);
+            for (uint32_t irq : {36u, 40u})
+            {
+                IopCpuState registration{};
+                registration.gpr[4] = irq; registration.gpr[6] = 0x11200u;
+                require(doubleSignal.intrman.dispatchImport(4u, registration, doubleSignal) &&
+                        doubleSignal.intrman.dispatchImport(6u, registration, doubleSignal), "same-pump IRQ setup");
+                doubleSignal.pendingDmaInterrupts.emplace(int(irq), 100u);
+            }
+            require(doubleSignal.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::Completed && doubleSignal.memory.read32(0x14000u) == 2u &&
+                    doubleSignal.memory.read32(0x14010u) == 2u,
+                    "same-pump signals collapsed instead of reserving the first token");
+            poll.gpr[4] = 1u;
+            require(doubleSignal.kernel.dispatchSemaphoreImport(9u, poll) && int32_t(poll.gpr[2]) == -419,
+                    "two waits did not consume exactly two same-pump signals");
+
+            // A real worker signals then polls before the pump returns. The
+            // pending RPC already owns that first token, so its poll must fail.
+            iop_test::Host stealHost; Impl steal(stealHost); prepare(steal);
+            words(steal, 0x11500u, {
+                0x27BDFFE0u, 0xAFBF001Cu, 0x34040001u, 0x0C004809u, 0u,
+                0x34040001u, 0x0C004807u, 0u,
+                0x3C080001u, 0xAD024014u,
+                0x8FBF001Cu, 0u, 0x27BD0020u, 0x03E00008u, 0u,
+            });
+            thread(steal, 0x11500u);
+            require(steal.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::Completed && int32_t(steal.memory.read32(0x14014u)) == -419 &&
+                    !steal.kernel.hasDetachedSemaphoreWait(1), "competing poll stole the reserved RPC token");
+
+            // Normal JAL ExitThread/ExitDeleteThread terminates the producer,
+            iop_test::Host acquiredHost; Impl acquired(acquiredHost); prepare(acquired);
+            words(acquired, 0x11500u, {
+                0x27BDFFE0u, 0xAFBF001Cu,
+                0x34040001u, 0x0C004809u, 0u, 0x34040001u, 0x0C004809u, 0u,
+                0x34040001u, 0x0C004805u, 0u, 0x3C080001u, 0xAD024018u,
+                0x8FBF001Cu, 0u, 0x27BD0020u, 0x03E00008u, 0u,
+            });
+            acquired.memory.write32(0x14018u, 0xBADu);
+            thread(acquired, 0x11500u);
+            require(acquired.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::Completed && acquired.memory.read32(0x14018u) == 0u,
+                    "acquired reservation rejected worker's safe wait on the second signal");
+
+            iop_test::Host tailHost; Impl tail(tailHost); prepare(tail);
+            words(tail, 0x11400u, {0x34040001u, 0x08004805u, 0u});
+            tail.pendingGuestCallbacks.emplace(90u, Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+            require(tail.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 100u, result)
+                        == IopGuestCallStatus::Completed && result == 0u && tail.totalCycles == 100u &&
+                    tail.totalInstructions < 100u && !tail.kernel.hasDetachedSemaphoreWait(1),
+                    "completed tail wait was rejected at the exact cycle deadline");
+
+            // Normal JAL ExitThread/ExitDeleteThread terminates the producer,
+            // with an internal RA rather than the thread-return sentinel.
+            for (uint32_t ordinal : {8u, 9u})
+            {
+                iop_test::Host exitHost; Impl exiting(exitHost); prepare(exiting);
+                words(exiting, 0x12080u, {0x41E00000u, 0u, 0x0101u});
+                require(exiting.memory.writeRam(0x1208Cu, "thbase", 7u), "exit import table");
+                words(exiting, 0x12094u, {0x03E00008u, 0x24000000u | ordinal, 0u, 0u});
+                words(exiting, 0x11500u, {0x34040001u, 0x0C004809u, 0u, 0x0C004825u, 0u});
+                thread(exiting, 0x11500u);
+                require(exiting.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                            == IopGuestCallStatus::Completed && !exiting.kernel.hasCurrentThread() &&
+                        !exiting.activeCpu && !exiting.rpcWaitCpu && exiting.kernel.threadCount() == (ordinal == 8u ? 1u : 0u),
+                        "normal worker exit poisoned RPC or leaked ownership");
+            }
+
+            // A worker erases and replaces the server while the RPC waits. Its
+            // zero return must use the submitting server's default reply buffer.
+            iop_test::Host replaceHost; Impl replacing(replaceHost); prepare(replacing);
+            auto replaceImage = iop_test::rpcServer(0x81234567u, 0x12345678u);
+            replaceImage.words(0x300u, {
+                0x27BDFFE0u, 0xAFBF001Cu, 0x34040001u, 0x0C004805u, 0u,
+                0x8FBF001Cu, 0u, 0x27BD0020u, 0x03E00008u, 0x00001021u,
+            });
+            require(replacing.loadImage("host:replace.irx", replaceImage.bytes, nullptr, 0u).moduleId > 0,
+                    "replaceable native server load");
+            words(replacing, 0x1007Cu, {0x03E00008u, 0x24000018u,
+                                       0x03E00008u, 0x24000011u, 0u, 0u});
+            words(replacing, 0x11500u, {
+                0x27BDFFE0u, 0xAFBF001Cu,
+                0x3C040001u, 0x34840200u, 0x0C00401Fu, 0u,
+                0x3C040001u, 0x34843040u, 0x3C058123u, 0x34A54567u,
+                0x3C060001u, 0x34C61580u, 0x3C070001u, 0x34E74100u,
+                0xAFA00010u, 0xAFA00014u, 0xAFA00018u, 0x0C004021u, 0u,
+                0x34040001u, 0x8FBF001Cu, 0u, 0x27BD0020u, 0x08004809u, 0u,
+            });
+            words(replacing, 0x11580u, {0x3C020001u, 0x34424100u, 0x03E00008u, 0u});
+            words(replacing, 0x14100u, {0x8765ABCDu, 0x8765ABCDu, 0x8765ABCDu, 0x8765ABCDu});
+            thread(replacing, 0x11500u);
+            auto replacementReply = replacing.rpc.handleRpc(iop_test::request(0x81234567u, 1u), replacing);
+            require(replacementReply.handled && replacementReply.failureResult == 0 && replaceHost.word(0x800u) == 0x12345678u,
+                    "RPC did not retain original server metadata across replacement");
+            replacementReply = replacing.rpc.handleRpc(iop_test::request(0x81234567u, 1u), replacing);
+            require(replacementReply.handled && replacementReply.failureResult == 0 && replaceHost.word(0x800u) == 0x8765ABCDu,
+                    "next RPC did not use replacement metadata");
+
+            // Invalid IDs are ordinary guest errors, not transport failure.
+            iop_test::Host invalidHost; Impl invalid(invalidHost); prepare(invalid);
+            words(invalid, 0x11400u, {0x34040063u, 0x08004805u, 0u});
+            require(invalid.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 100u, result)
+                        == IopGuestCallStatus::Completed && int32_t(result) == -1 && !invalid.resetRequired,
+                    "invalid semaphore changed the guest error contract");
+
+            // Owned threads retain the kernel's real blocking behavior.
+            thread(invalid, 0x11400u);
+            IopThread *owned = invalid.kernel.beginNextReady(invalid.totalCycles);
+            require(owned != nullptr, "owned wait fixture not ready");
+            owned->cpu.gpr[4] = 1u;
+            require(invalid.kernel.dispatchSemaphoreImport(8u, owned->cpu) && owned->cpu.yielded &&
+                    owned->state == IopThreadState::Semaphore, "ordinary owned wait no longer blocks");
+            invalid.kernel.endTimeslice(*owned, kThreadReturnSentinel);
+            require(invalid.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 100u, result)
+                        == IopGuestCallStatus::ResetRequired,
+                    "detached polling competed with an existing waiter");
+
+            iop_test::Host competitorHost; Impl competitor(competitorHost); prepare(competitor);
+            words(competitor, 0x11400u, {0x34040001u, 0x08004805u, 0u});
+            thread(competitor, 0x11400u);
+            require(competitor.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && !competitor.kernel.hasCurrentThread() &&
+                    competitor.memory.read32(0x14000u) == 0u,
+                    "new scheduled waiter raced held-RPC token acquisition");
+
+            // The second wait does not renew the absolute cycle budget.
+            iop_test::Host timeoutHost; Impl timeout(timeoutHost); prepare(timeout);
+            timeout.pendingGuestCallbacks.emplace(100u, Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+            timeout.pendingGuestCallbacks.emplace(1500u, Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+            require(timeout.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && timeout.totalCycles <= 1001u &&
+                    timeout.memory.read32(0x14000u) == 1u && timeout.memory.read32(0x14010u) == 1u &&
+                    !timeout.kernel.hasDetachedSemaphoreWait(1),
+                    "second wait renewed deadline or resumed without its signal");
+
+            // A scheduled CPU's architectural fault restores current ownership.
+            iop_test::Host faultHost; Impl fault(faultHost); prepare(fault);
+            words(fault, 0x11500u, {0x0000000Du}); // BREAK
+            thread(fault, 0x11500u);
+            require(fault.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && !fault.kernel.hasCurrentThread() &&
+                    !fault.activeCpu && !fault.rpcWaitCpu && fault.callDepth == 0u &&
+                    fault.memory.read32(0x14000u) == 0u,
+                    "scheduler fault completed RPC or leaked its owner");
+
+            // Exceptions from a real scheduled device read restore ownership.
+            iop_test::Host throwHost; Impl throwing(throwHost); prepare(throwing);
+            words(throwing, 0x11500u, {0x3C081F40u, 0x8D09200Cu, 0u, 0x03E00008u, 0u});
+            throwing.memory.setCdvdDiscTypeReader([]() -> uint8_t { throw std::runtime_error("injected device read failure"); });
+            thread(throwing, 0x11500u);
+            require(throwing.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && !throwing.kernel.hasCurrentThread() &&
+                    !throwing.activeCpu && !throwing.rpcWaitCpu && throwing.callDepth == 0u &&
+                    throwing.memory.read32(0x14000u) == 0u,
+                    "scheduler exception was swallowed or leaked execution ownership");
+
+            // Nested guest execution shares the outer instruction deadline.
+            iop_test::Host nestedHost; Impl nested(nestedHost); prepare(nested);
+            words(nested, 0x11500u, {0x08004540u, 0u}); // infinite callback
+            nested.pendingGuestCallbacks.emplace(100u, Impl::ScheduledGuestCallback{0x11500u, 0u, 0u});
+            require(nested.executeRpcFunctionChecked(0x11000u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && nested.totalInstructions <= 1001u &&
+                    !nested.servicingGuestCallbacks && !nested.activeCpu && !nested.rpcWaitCpu,
+                    "nested execution escaped the RPC budget or ownership guard");
+
+            // Bridge failure is handled and cannot copy or request completion.
+            iop_test::Host recursiveHost; Impl recursive(recursiveHost); prepare(recursive);
+            words(recursive, 0x12300u, {0x41E00000u, 0u, 0x0101u});
+            require(recursive.memory.writeRam(0x1230Cu, "intrman", 8u), "recursive import table");
+            words(recursive, 0x12314u, {0x03E00008u, 0x2400000Eu, 0u, 0u});
+            words(recursive, 0x11500u, {0x3C040001u, 0x34841500u, 0x080048C5u, 0u});
+            require(recursive.executeRpcFunctionChecked(0x11500u, 0u, 0u, 0u, 0u, 0u, 100u, result)
+                        == IopGuestCallStatus::ResetRequired && recursive.totalInstructions == 100u &&
+                    recursive.totalCycles == 100u && recursive.callDepth == 0u && !recursive.activeCpu && !recursive.rpcWaitCpu,
+                    "suspended recursive imports incremented counters past the absolute budget");
+
+            // Deleting a pending semaphore fails the checked call and detaches
+            // its scoped reservation rather than completing without a token.
+            iop_test::Host deleteHost; Impl deleting(deleteHost); prepare(deleting);
+            words(deleting, 0x1202Cu, {0x03E00008u, 0x24000005u, 0u, 0u});
+            words(deleting, 0x11500u, {0x34040001u, 0x0800480Bu, 0u});
+            deleting.pendingGuestCallbacks.emplace(100u, Impl::ScheduledGuestCallback{0x11500u, 0u, 0u});
+            require(deleting.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::ResetRequired && !deleting.kernel.hasDetachedSemaphoreWait(1) &&
+                    !deleting.activeCpu && !deleting.rpcWaitCpu,
+                    "deleted pending semaphore completed RPC or leaked its reservation");
+
+            // Bridge failure is handled and cannot copy or request completion.
+            iop_test::Host deleteAcquiredHost; Impl deleteAcquired(deleteAcquiredHost); prepare(deleteAcquired);
+            words(deleteAcquired, 0x1202Cu, {0x03E00008u, 0x24000005u, 0u, 0u});
+            words(deleteAcquired, 0x11500u, {
+                0x27BDFFE0u, 0xAFBF001Cu, 0x34040001u, 0x0C004809u, 0u,
+                0x34040001u, 0x0C00480Bu, 0u,
+                0x8FBF001Cu, 0u, 0x27BD0020u, 0x03E00008u, 0u,
+            });
+            thread(deleteAcquired, 0x11500u);
+            require(deleteAcquired.executeRpcFunctionChecked(0x11400u, 0u, 0u, 0u, 0u, 0u, 1000u, result)
+                        == IopGuestCallStatus::Completed && !deleteAcquired.kernel.hasDetachedSemaphoreWait(1),
+                    "deletion revoked an already acquired token or leaked its reservation");
+
+            // Bridge failure is handled and cannot copy or request completion.
+            iop_test::Host bridgeHost; Impl bridge(bridgeHost);
+            auto image = iop_test::rpcServer(0x81234567u, 0x12345678u);
+            image.words(0x300u, {0x080040C0u, 0u}); // infinite native RPC
+            require(bridge.loadImage("host:failure.irx", image.bytes, nullptr, 0u).moduleId > 0,
+                    "native failing RPC server did not register");
+            const size_t writes = bridgeHost.guestWrites;
+            auto reply = bridge.rpc.handleRpc(iop_test::request(0x81234567u, 1u), bridge);
+            require(reply.handled && reply.failureResult < 0 && !reply.signalCompletion && !reply.signalNowaitCompletion &&
+                    reply.callbackPolicy == CallbackPolicy::Suppress && reply.serverDispatchPolicy == ServerDispatchPolicy::Suppress &&
+                    bridgeHost.guestWrites == writes && bridgeHost.word(0x800u) == 0xCCCCCCCCu,
+                    "failed native RPC copied reply or fell through to success");
+            std::cout << "PASS checked RPC wait/continuation/deadline/ownership/failure boundaries\n";
+            return true;
+        }
+        catch (const std::exception &error)
+        {
+            std::cerr << "FAIL checked RPC waits: " << error.what() << '\n';
+            return false;
+        }
+    }
+}
