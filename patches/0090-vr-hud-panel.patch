+        // The HUD panel over an eye's stereo frame: the UI layer image as a quad at a fixed distance, alpha blended,
+        // seen from the pose the frame is submitted with (viewProj), so both eyes get their parallax at that
+        // distance and the compositor reprojects it with the scene.
+        void drawHudPanel(const M4 &viewProj, const ga2_stereo::Setup &st)
+        {
+            const HudPanel &h = hudPanel();
+            M4 model;
+            if (h.headLock)
+                std::memcpy(model.m, st.headAnchor, sizeof(model.m));
+            glDisable(GL_CULL_FACE);
+            glDisable(GL_DEPTH_TEST);
+            glDepthMask(GL_FALSE);
+            glEnable(GL_BLEND);
+            glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+            glUseProgram(g_gl.hud);
+            setMatrix(g_gl.hud, "mvp", mul(viewProj, model));
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, g_uiImage.texture);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glUniform1i(glGetUniformLocation(g_gl.hud, "tex"), 0);
+            glUniform2f(glGetUniformLocation(g_gl.hud, "extent"), 1.0f, 1.0f);
+            glUniform1f(glGetUniformLocation(g_gl.hud, "gain"), h.gain);
+            rect(V3{0.0f, h.centerY, -h.distance}, V3{h.halfWidth, 0, 0}, V3{0, h.halfHeight, 0}, false);
+            glDisable(GL_BLEND);
+            glDepthMask(GL_TRUE);
+            glUseProgram(0);
+            glBindVertexArray(0);
+        }
