+    // Minimal PNG writer (stored deflate blocks), for the HUD debug dumps.
+    void writePng(const std::string &path, const uint8_t *rgba, uint32_t w, uint32_t h)
+    {
+        static uint32_t table[256];
+        static bool init = false;
+        if (!init)
+        {
+            for (uint32_t n = 0; n < 256; ++n)
+            {
+                uint32_t c = n;
+                for (int k = 0; k < 8; ++k)
+                    c = c & 1 ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+                table[n] = c;
+            }
+            init = true;
+        }
+        auto crc = [&](const uint8_t *d, size_t n, uint32_t c = 0xFFFFFFFFu) {
+            for (size_t i = 0; i < n; ++i)
+                c = table[(c ^ d[i]) & 0xFF] ^ (c >> 8);
+            return c;
+        };
+        std::vector<uint8_t> raw;
+        raw.reserve((size_t(w) * 4u + 1u) * h);
+        for (uint32_t y = 0; y < h; ++y)
+        {
+            raw.push_back(0);
+            raw.insert(raw.end(), rgba + size_t(y) * w * 4u, rgba + size_t(y + 1) * w * 4u);
+        }
+        std::vector<uint8_t> z = {0x78, 0x01};
+        uint32_t a = 1, b = 0;
+        for (size_t i = 0; i < raw.size(); i += 65535)
+        {
+            const size_t n = std::min<size_t>(65535, raw.size() - i);
+            z.push_back(i + n >= raw.size() ? 1 : 0);
+            z.push_back(uint8_t(n)), z.push_back(uint8_t(n >> 8));
+            z.push_back(uint8_t(~n)), z.push_back(uint8_t((~n) >> 8));
+            z.insert(z.end(), raw.begin() + i, raw.begin() + i + n);
+        }
+        for (uint8_t v : raw)
+        {
+            a = (a + v) % 65521u;
+            b = (b + a) % 65521u;
+        }
+        for (int sft = 24; sft >= 0; sft -= 8)
+            z.push_back(uint8_t(((b << 16 | a) >> sft) & 0xFF));
+        FILE *f = std::fopen(path.c_str(), "wb");
+        if (!f)
+            return;
+        auto be = [&](uint32_t v) {
+            const uint8_t d[4] = {uint8_t(v >> 24), uint8_t(v >> 16), uint8_t(v >> 8), uint8_t(v)};
+            std::fwrite(d, 1, 4, f);
+        };
+        auto chunk = [&](const char *type, const std::vector<uint8_t> &data) {
+            be(uint32_t(data.size()));
+            std::vector<uint8_t> td(type, type + 4);
+            td.insert(td.end(), data.begin(), data.end());
+            std::fwrite(td.data(), 1, td.size(), f);
+            be(~crc(td.data(), td.size()));
+        };
+        const uint8_t sig[8] = {0x89, 'P', 'N', 'G', 0x0D, 0x0A, 0x1A, 0x0A};
+        std::fwrite(sig, 1, 8, f);
+        std::vector<uint8_t> ihdr = {uint8_t(w >> 24), uint8_t(w >> 16), uint8_t(w >> 8), uint8_t(w),
+                                     uint8_t(h >> 24), uint8_t(h >> 16), uint8_t(h >> 8), uint8_t(h), 8, 6, 0, 0, 0};
+        chunk("IHDR", ihdr);
+        chunk("IDAT", z);
+        chunk("IEND", {});
+        std::fclose(f);
+    }
+
+    void dumpHudDebugLocked(State &s)
+    {
+        const char *prefix = std::getenv("GA2_VR_HUD_DUMP");
+        if (!prefix || !*prefix)
+            return;
+        const auto now = std::chrono::steady_clock::now();
+        const double at = envInt("GA2_VR_HUD_DUMP_AT", 20);
+        const int count = std::max(1, envInt("GA2_VR_HUD_DUMP_COUNT", 1));
+        if (s.dbgDumped >= count || std::chrono::duration<double>(now - s.dbgStart).count() < at ||
+            std::chrono::duration<double>(now - s.dbgLast).count() < envInt("GA2_VR_HUD_DUMP_GAP", 1) || s.dbgUi.empty() || s.dbgScene.empty())
+            return;
+        s.dbgLast = now;
+        std::vector<uint8_t> scene, ui;
+        uint32_t sw, sh, uw, uh;
+        {
+            std::lock_guard<std::mutex> lock(s.frameMutex);
+            scene = s.dbgScene, ui = s.dbgUi;
+            sw = s.dbgSceneW, sh = s.dbgSceneH, uw = s.dbgUiW, uh = s.dbgUiH;
+        }
+        const std::string base = std::string(prefix) + (count > 1 ? "-" + std::to_string(s.dbgDumped) : "");
+        writePng(base + "-scene.png", scene.data(), sw, sh);
+        writePng(base + "-ui.png", ui.data(), uw, uh);
+        // The composite as the headset draws it (premultiplied over the scene, nearest-neighbour resample of the
+        // UI image to the scene size).
+        std::vector<uint8_t> comp(scene);
+        for (uint32_t y = 0; y < sh; ++y)
+            for (uint32_t x = 0; x < sw; ++x)
+            {
+                const uint8_t *u = &ui[(size_t(y * uh / sh) * uw + size_t(x * uw / sw)) * 4u];
+                const float a = std::min(1.0f, u[3] * (255.0f / 128.0f) / 255.0f);
+                uint8_t *c = &comp[(size_t(y) * sw + x) * 4u];
+                for (int k = 0; k < 3; ++k)
+                    c[k] = uint8_t(std::min(255.0f, c[k] * (1.0f - a) + u[k]));
+            }
+        writePng(base + "-comp.png", comp.data(), sw, sh);
+        std::fprintf(stderr, "[pgs] hud debug dump %s (scene %ux%u, ui %ux%u)\n", base.c_str(), sw, sh, uw, uh);
+        ++s.dbgDumped;
+    }
+
