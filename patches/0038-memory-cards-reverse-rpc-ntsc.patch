+// Default IOP->EE RPC service. It does what the SDK's sceSifExecRequest does
+// for the registered sceSifServeData (func at +4, buff at +8): copy the request
+// into the server buffer, run func(fno, buff, size) as a guest invocation on
+// an isolated stack, and return the bytes at the pointer it returns.
+bool PS2IopHostAdapter::submitGenericReverseRpc(const ps2x::iop::ReverseRpcRequest &request,
+                                                ps2x::iop::ReverseRpcCompletionEndpoint endpoint)
+{
+    constexpr uint32_t kReplyBytes = 64u;
+    uint8_t *const rdram = m_activeRdram ? m_activeRdram : m_runtime.memory().getRDRAM();
+    const auto physical = [](uint32_t address) { return address & 0x1FFFFFFFu; };
+    const auto inRam = [&](uint32_t address, uint32_t size)
+    { return physical(address) < PS2_RAM_SIZE && size <= PS2_RAM_SIZE - physical(address); };
+    if (!rdram || !endpoint.isCurrent || !endpoint.complete || !endpoint.isCurrent() ||
+        !inRam(request.serverAddress, 68u) || !inRam(request.bufferAddress, request.send.size()))
+        return false;
+    const auto word = [&](uint32_t address)
+    {
+        uint32_t value = 0;
+        std::memcpy(&value, rdram + physical(address), 4);
+        return value;
+    };
+    const auto putWord = [&](uint32_t address, uint32_t value)
+    { std::memcpy(rdram + physical(address), &value, 4); };
+    const uint32_t sd = request.serverAddress;
+    const uint32_t func = word(sd + 4u);
+    if (word(sd + 8u) != request.bufferAddress || !m_runtime.hasFunction(func))
+        return false;
+
+    std::memcpy(rdram + physical(request.bufferAddress), request.send.data(), request.send.size());
+    putWord(sd + 12u, static_cast<uint32_t>(request.send.size())); // size
+    putWord(sd + 36u, request.function);                           // fno
+    putWord(sd + 40u, request.receiveAddress);                     // receive (IOP)
+    putWord(sd + 44u, kReplyBytes);                                // rsize
+
+    GuestInvocation call{};
+    call.kind = GuestInvocationKind::RpcCallback;
+    call.tag = request.nonce;
+    call.context = m_runtime.cpu();
+    call.context.pc = func;
+    SET_GPR_U32(&call.context, 4, request.function);
+    SET_GPR_U32(&call.context, 5, request.bufferAddress);
+    SET_GPR_U32(&call.context, 6, static_cast<uint32_t>(request.send.size()));
+    SET_GPR_U32(&call.context, 29, 0u);
+    SET_GPR_U32(&call.context, 31, 0u);
+    call.requireGuestReturn = true;
+    auto shared = std::make_shared<ps2x::iop::ReverseRpcCompletionEndpoint>(std::move(endpoint));
+    call.isValid = [shared] { return shared->isCurrent && shared->isCurrent(); };
+    call.onCancel = [shared]
+    {
+        if (shared->isCurrent && shared->isCurrent())
+            shared->complete(-1, {});
+    };
+    call.onComplete = [this, shared, inRam](const R5900Context &returned, R5900Context &)
+    {
+        uint8_t *const ram = m_activeRdram ? m_activeRdram : m_runtime.memory().getRDRAM();
+        const uint32_t reply = getRegU32(&returned, 2);
+        std::array<uint8_t, kReplyBytes> bytes{};
+        if (!ram || !inRam(reply, kReplyBytes))
+        {
+            shared->complete(-1, {});
+            return;
+        }
+        std::memcpy(bytes.data(), ram + (reply & 0x1FFFFFFFu), kReplyBytes);
+        shared->complete(0, bytes);
+    };
+    m_runtime.eeScheduler().queueInvocation(std::move(call));
+    return true;
+}
