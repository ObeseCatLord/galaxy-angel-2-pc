+        // The hand: a clear holographic reticle across the aim (uv 0..1): a
+        // glassy disc with a bright rim, a dashed ring turning one way and
+        // four ticks the other, a centre pip, faint scan lines.
+        const char *kCursorFs = R"(#version 330
+in vec2 v_uv;
+uniform float time;
+uniform float strength; // 1 for the hand that clicks, dimmer for the other
+out vec4 o;
+void main() {
+    vec2 p = (v_uv - 0.5) * 2.0;
+    float r = length(p);
+    if (r > 1.0) discard;
+    float a = atan(p.y, p.x);
+    float rim = exp(-pow((r - 0.88) * 30.0, 2.0));
+    float halo = exp(-pow((r - 0.88) * 7.0, 2.0)) * 0.25;
+    float dash = step(0.35, fract(a / 6.2831853 * 12.0 + time * 0.35));
+    float ring = exp(-pow((r - 0.62) * 45.0, 2.0)) * dash;
+    float tickA = fract(a / 6.2831853 * 4.0 - time * 0.2);
+    float ticks = smoothstep(0.035, 0.0, abs(tickA - 0.5) - 0.0) * smoothstep(0.0, 0.03, r - 0.70) * smoothstep(0.0, 0.03, 0.80 - r);
+    float pip = exp(-r * r * 160.0);
+    float glass = (0.05 + 0.10 * r * r) * smoothstep(0.9, 0.85, r);
+    float scan = 0.8 + 0.2 * sin(p.y * 70.0 - time * 7.0);
+    vec3 cyan = vec3(0.32, 0.70, 1.0), white = vec3(0.85, 0.95, 1.0);
+    vec3 col = cyan * (rim * 1.1 + halo + ring * 0.8 + ticks * 0.9 + glass) * scan + white * (pip * 1.2 + rim * 0.35);
+    o = vec4(col * strength, 1.0);
+})";
+
