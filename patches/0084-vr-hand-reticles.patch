+        // The hands: beam, reticle and (on the screen) the hit point; additive
+        // light, so they read as clear holograms over whatever is behind.
+        void drawHands(const M4 &viewProj, V3 eye, const std::array<Laser, 2> &lasers, float time)
+        {
+            for (const Laser &l : lasers)
+            {
+                if (!l.visible)
+                    continue;
+                const V3 axis = l.to - l.from;
+                const float length = std::sqrt(dot(axis, axis));
+                if (length < 1e-3f)
+                    continue;
+                const V3 dir = axis * (1.0f / length);
+                const V3 mid = (l.from + l.to) * 0.5f;
+                V3 side = cross(dir, normalize(eye - mid));
+                side = normalize(side) * 0.012f;
+                const V3 a0 = l.from - side, a1 = l.from + side, b0 = l.to - side, b1 = l.to + side;
+                const float beam[30] = {a0.x, a0.y, a0.z, 0, -1, b0.x, b0.y, b0.z, length, -1, b1.x, b1.y, b1.z, length, 1,
+                                        a0.x, a0.y, a0.z, 0, -1, b1.x, b1.y, b1.z, length, 1, a1.x, a1.y, a1.z, 0, 1};
+                glUseProgram(g_gl.beam);
+                setMatrix(g_gl.beam, "mvp", viewProj);
+                glUniform1f(glGetUniformLocation(g_gl.beam, "time"), time);
+                glUniform1f(glGetUniformLocation(g_gl.beam, "beamLength"), length);
+                glUniform1f(glGetUniformLocation(g_gl.beam, "fadeEnd"), l.hit || length > 2.0f ? 0.0f : 1.0f);
+                drawMesh(beam, 6);
+                // The reticle just ahead of the controller, across the aim.
+                {
+                    const V3 up = std::fabs(dir.y) > 0.95f ? V3{1, 0, 0} : V3{0, 1, 0};
+                    const V3 u = normalize(cross(dir, up)) * 0.032f;
+                    const V3 v = normalize(cross(u, dir)) * 0.032f;
+                    glUseProgram(g_gl.cursor);
+                    setMatrix(g_gl.cursor, "mvp", viewProj);
+                    glUniform1f(glGetUniformLocation(g_gl.cursor, "time"), time);
+                    glUniform1f(glGetUniformLocation(g_gl.cursor, "strength"), l.active ? 1.0f : 0.55f);
+                    rect(l.from + dir * 0.05f, u, v, false);
+                }
+                if (l.hit)
+                {
+                    const V3 toEye = normalize(eye - l.to);
+                    V3 u = normalize(cross(V3{0, 1, 0}, toEye)) * 0.045f;
+                    V3 v = normalize(cross(toEye, u)) * 0.045f;
+                    glUseProgram(g_gl.dot);
+                    setMatrix(g_gl.dot, "mvp", viewProj);
+                    glUniform1f(glGetUniformLocation(g_gl.dot, "time"), time);
+                    rect(l.to + toEye * 0.01f, u, v, false);
+                }
+            }
+        }
