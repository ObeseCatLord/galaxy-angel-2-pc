+    class ImageHost final : public NullHost
+    {
+    public:
+        std::string mounted = "A";
+        std::filesystem::path looseRoot;
+        std::map<std::string, std::vector<uint8_t>> images;
+        std::map<uint64_t, std::string> handles;
+        uint64_t nextHandle = 0;
+        unsigned closes = 0;
+        std::string hostPath(HostPathKind kind) const override
+        {
+            if (kind == HostPathKind::CdImage) return mounted;
+            if (kind == HostPathKind::CdRoot) return looseRoot.string();
+            return {};
+        }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            if (!images.contains(std::string(path))) return 0;
+            handles[++nextHandle] = path;
+            return nextHandle;
+        }
+        bool hostFileSize(uint64_t handle, uint64_t &size) const override
+        {
+            const auto found = handles.find(handle);
+            if (found == handles.end()) return false;
+            size = images.at(found->second).size();
+            return true;
+        }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *out, size_t size,
+                          size_t &read) override
+        {
+            read = 0;
+            uint64_t length;
+            if (!hostFileSize(handle, length) || offset > length || size > length - offset)
+                return false;
+            std::memcpy(out, images.at(handles.at(handle)).data() + offset, size);
+            read = size;
+            return true;
+        }
+        void closeHostFile(uint64_t handle) override { handles.erase(handle); ++closes; }
+    };
