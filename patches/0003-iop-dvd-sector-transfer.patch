+    bool testDvdSectorTransfer()
+    {
+        ImageHost host;
+        host.images["A"] = std::vector<uint8_t>(20u * 2048u, 0x31u);
+        host.images["B"] = std::vector<uint8_t>(20u * 2048u, 0x72u);
+        host.images["short"] = std::vector<uint8_t>(13u, 0xEEu);
+        const auto suffix = std::to_string(std::chrono::steady_clock::now().time_since_epoch().count());
+        host.looseRoot = std::filesystem::temp_directory_path() / ("ga2-cdvd-failure-" + suffix);
+        std::filesystem::create_directory(host.looseRoot);
+        struct RemoveFixture
+        {
+            std::filesystem::path path;
+            ~RemoveFixture() { std::error_code e; std::filesystem::remove_all(path, e); }
+        } remove{host.looseRoot};
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        IopCdvd cdvd(host, memory, kernel);
+        memory.setCdvdDiscTypeReader([&] { return cdvd.discType(); });
+        constexpr uint32_t mode = 0x2000u, stack = 0x3000u, function = 0x4000u;
+        memory.write32(mode, 0x10u);
+        memory.write32(function, 0x03E00008u);
+        memory.write32(stack + 16u, 2u);
+        memory.write32(stack + 20u, function);
+        const uint32_t allocation = memory.allocate(2u * 2064u + 32u);
+        const uint32_t destination = allocation + 16u;
+        std::vector<uint8_t> poison(2u * 2064u + 32u, 0xCCu);
+        (void)memory.writeRam(allocation, poison.data(), poison.size());
+        IopCpuState cpu{};
+        cpu.gpr[4] = 3u; cpu.gpr[5] = 2u; cpu.gpr[6] = destination;
+        cpu.gpr[7] = mode; cpu.gpr[29] = stack; cpu.gpr[28] = 0x5678u;
+        for (const auto &path : {"A", "B", "A"})
+        {
+            host.mounted = path;
+            if (!expect(memory.read8(0xBF40200Fu) == 0x14u, "MMIO did not report mounted DVD") ||
+                !expect(cdvd.dispatchImport(63u, cpu) && cpu.gpr[2] == 1u, "DVD transfer failed"))
+                return false;
+            const auto callback = cdvd.takeCompletionCallback();
+            if (!expect(callback && callback->address == function && callback->gp == 0x5678u &&
+                            callback->reason == 0u, "explicit completion callback lost its ABI"))
+                return false;
+            std::vector<uint8_t> bytes(poison.size());
+            (void)memory.readRam(allocation, bytes.data(), bytes.size());
+            if (!expect(bytes.front() == 0xCCu && bytes.back() == 0xCCu,
+                        "DVD read overwrote allocation guards")) return false;
+            for (unsigned s = 0; s < 2; ++s)
+            {
+                const auto *raw = bytes.data() + 16u + s * 2064u;
+                if (!expect(raw[0] == 0x20u && raw[1] == 3u && raw[2] == 0u && raw[3] == 3u + s,
+                            "DVD sector ID does not match requested LSN") ||
+                    !expect(std::memcmp(raw + 12u, host.images.at(path).data() + (3u + s) * 2048u,
+                                        2048u) == 0, "DVD payload came from stale media")) return false;
+            }
+        }
+        if (!expect(host.closes == 2u, "mount changes did not retire prior image handles")) return false;
+        for (const auto &path : {"missing", "short"})
+        {
+            host.mounted = path;
+            (void)memory.writeRam(allocation, poison.data(), poison.size());
+            cpu.gpr[4] = 16u; cpu.gpr[5] = 1u;
+            if (!expect(memory.read8(0x1F40200Fu) == 0u, "failed image reported a DVD") ||
+                !expect(cdvd.dispatchImport(63u, cpu) && cpu.gpr[2] == 0u,
+                        "failed configured image fell back to virtual PVD") ||
+                !expect(!cdvd.takeCompletionCallback(), "failed transfer scheduled completion")) return false;
+            std::vector<uint8_t> bytes(poison.size());
+            (void)memory.readRam(allocation, bytes.data(), bytes.size());
+            if (!expect(bytes == poison, "failed transfer changed destination bytes")) return false;
+        }
+        host.mounted = "A";
+        cpu.gpr[4] = 3u; cpu.gpr[5] = 3u;
+        return expect(cdvd.dispatchImport(63u, cpu) && cpu.gpr[2] == 0u,
+                      "unsupported multi-chunk transfer claimed full completion");
+    }
