diff --git a/ps2xRuntime/include/runtime/ps2_vu1.h b/ps2xRuntime/include/runtime/ps2_vu1.h
index 7007935..2d1231e 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1.h
+++ b/ps2xRuntime/include/runtime/ps2_vu1.h
@@ -192,6 +192,67 @@ public:
     bool resumesInDelaySlot() const { return m_state.branchPending || m_state.ebit || m_state.haltAfterDelaySlot; }
     StepResult stepGeneric(const StepArgs &args);
 
+    // ---- Statically scheduled blocks (ga2_vu1_gen)
+    // A block is a run of consecutive pairs with no branch, E/D/T bit,
+    // XGKICK or reserved instruction, entered at its first pair. When nothing
+    // issued before the block can delay any of its pairs (the guards), every
+    // pair issues at a fixed offset from the block's entry cycle, so the
+    // generator works the timing out ahead of time (scheduleBlockForCodegen
+    // runs the block through stepPairAfter on a scratch VU from an idle
+    // pipeline) and the block runs without ready-cycle bookkeeping.
+    enum class BlockGuardKind : uint8_t
+    {
+        Vf,      // m_vfReady[reg][lane] <= entry + offset
+        Vi,      // m_viReady[reg] <= entry + offset
+        Acc,     // m_accReady[lane] <= entry + offset
+        Fdiv,    // a pending FDIV result is ready by entry + offset
+        EfuUnit, // m_efuResourceReady <= entry + offset
+        EfuAll   // every pending EFU result is ready by entry + offset
+    };
+    struct BlockGuard
+    {
+        BlockGuardKind kind;
+        uint8_t reg;
+        uint8_t lane;
+        uint32_t offset;
+    };
+    enum class BlockFinalKind : uint8_t
+    {
+        Vf,
+        Vi,
+        Acc
+    };
+    struct BlockFinal
+    {
+        BlockFinalKind kind;
+        uint8_t reg;
+        uint8_t lane;
+        uint32_t offset; // ready cycle relative to the entry cycle
+    };
+    struct BlockSchedule
+    {
+        std::array<uint32_t, 64> issue{}; // issue cycle of each pair, relative to entry
+        uint32_t count = 0;
+        uint32_t regWriteReady = 0; // relative latest write ready cycle (0: none)
+        BlockGuard guards[160];
+        uint32_t guardCount = 0;
+        BlockFinal finals[160];
+        uint32_t finalCount = 0;
+    };
+    static constexpr uint32_t kMaxBlockPairs = 64u;
+    // Whether this pair may be part of a block.
+    static bool blockablePair(const DecodedInstructionPair &decoded);
+    static bool scheduleBlockForCodegen(const DecodedInstructionPair *pairs, uint32_t count, BlockSchedule &out);
+    // Generated code: whether the block may run on its schedule from now;
+    // lastIssue is the last pair's issue offset.
+    inline bool blockMayRun(const BlockGuard *guards, uint32_t guardCount, uint32_t lastIssue, const StepArgs &args) const;
+    // One pair of a block: stall cycles are known; no ready bookkeeping.
+    inline StepResult stepPairScheduled(const DecodedInstructionPair &decoded, uint32_t stallCycles, const StepArgs &args);
+    // After the block: its writes' ready cycles, as the pairs would have left them.
+    inline void finishBlock(uint64_t entryCycle, const BlockFinal *finals, uint32_t finalCount, uint32_t regWriteReady);
+    uint64_t currentCycle() const { return m_cycle; }
+    bool stopRequested() const { return m_stopRequested; }
+
 private:
 
     struct FlagPipelineEntry
diff --git a/ps2xRuntime/include/runtime/ps2_vu1_step.inl b/ps2xRuntime/include/runtime/ps2_vu1_step.inl
index a85cc14..3f453f7 100644
--- a/ps2xRuntime/include/runtime/ps2_vu1_step.inl
+++ b/ps2xRuntime/include/runtime/ps2_vu1_step.inl
@@ -341,3 +341,171 @@ __attribute__((always_inline)) inline VU1Interpreter::StepResult VU1Interpreter:
