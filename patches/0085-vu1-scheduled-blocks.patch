     return programEnded ? StepResult::Ended : StepResult::Continue;
 }
+
+// ---- Statically scheduled blocks (see ps2_vu1.h)
+
+__attribute__((always_inline)) inline bool VU1Interpreter::blockMayRun(const BlockGuard *guards, uint32_t guardCount,
+                                                                        uint32_t lastIssue, const StepArgs &a) const
+{
+    const uint64_t entry = m_cycle;
+    if (entry + lastIssue >= a.budgetEnd || m_stopRequested)
+        return false;
+    bool ok = true;
+#pragma clang loop unroll(full)
+    for (uint32_t k = 0; k < guardCount; ++k)
+    {
+        const BlockGuard &g = guards[k];
+        const uint64_t limit = entry + g.offset;
+        switch (g.kind)
+        {
+        case BlockGuardKind::Vf:
+            ok = ok && m_vfReady[g.reg][g.lane] <= limit;
+            break;
+        case BlockGuardKind::Vi:
+            ok = ok && m_viReady[g.reg] <= limit;
+            break;
+        case BlockGuardKind::Acc:
+            ok = ok && m_accReady[g.lane] <= limit;
+            break;
+        case BlockGuardKind::Fdiv:
+            ok = ok && (!m_fdiv.valid || m_fdiv.readyCycle <= limit);
+            break;
+        case BlockGuardKind::EfuUnit:
+            ok = ok && m_efuResourceReady <= limit;
+            break;
+        case BlockGuardKind::EfuAll:
+            ok = ok && (!m_efu[0].valid || m_efu[0].readyCycle <= limit) && (!m_efu[1].valid || m_efu[1].readyCycle <= limit);
+            break;
+        }
+    }
+    return ok;
+}
+
+// stepPairAfter for a pair inside a block that may run on its schedule:
+// nothing can be pending from a branch, E bit or halt, the stall is known,
+// and the ready cycles are written once by finishBlock.
+__attribute__((always_inline)) inline VU1Interpreter::StepResult VU1Interpreter::stepPairScheduled(const DecodedInstructionPair &decoded,
+                                                                                                uint32_t stallCycles,
+                                                                                                const StepArgs &a)
+{
+    (void)a;
+    if (stallCycles != 0u)
+        advanceTo(m_cycle + stallCycles);
+
+    uint8_t writtenVi = 0u;
+    int32_t oldVi = 0;
+    for (uint32_t reg = 1; reg < 16u; ++reg)
+    {
+        if ((decoded.lowerUsage.viWrite & (1u << reg)) != 0u)
+        {
+            writtenVi = static_cast<uint8_t>(reg);
+            oldVi = m_state.vi[reg];
+            break;
+        }
+    }
+
+    const VfAccess upperWrite = decoded.upperUsage.vfWrite;
+    const VfAccess lowerWrite = decoded.lowerUsage.vfWrite;
+    const bool hasUpperWrite = upperWrite.reg != 0u;
+    const bool hasLowerWrite = lowerWrite.reg != 0u && decoded.suppressedLowerVf != lowerWrite.reg;
+    const bool hasDistinctLowerWrite = hasLowerWrite && (!hasUpperWrite || lowerWrite.reg != upperWrite.reg);
+    float oldUpperVf[4]{};
+    float oldLowerVf[4]{};
+    float oldAcc[4]{};
+    if (hasUpperWrite)
+        std::memcpy(oldUpperVf, m_state.vf[upperWrite.reg], sizeof(oldUpperVf));
+    if (hasDistinctLowerWrite)
+        std::memcpy(oldLowerVf, m_state.vf[lowerWrite.reg], sizeof(oldLowerVf));
+    if (decoded.upperUsage.accWrite != 0u)
+        std::memcpy(oldAcc, m_state.acc, sizeof(oldAcc));
+
+    if (decoded.iBit)
+    {
+        execUpper(decoded.upper, decoded.flagMode);
+        float immediate = 0.0f;
+        std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
+        m_state.i = normalizeOperand(immediate);
+    }
+    else if (decoded.upperVfShadowReg != 0u)
+    {
+        float oldVf[4]{};
+        float upperVf[4]{};
+        std::memcpy(oldVf, m_state.vf[decoded.upperVfShadowReg], sizeof(oldVf));
+        execUpper(decoded.upper, decoded.flagMode);
+        std::memcpy(upperVf, m_state.vf[decoded.upperVfShadowReg], sizeof(upperVf));
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], oldVf, sizeof(oldVf));
+        execLower(decoded.lower, a.vuData, a.dataSize, *a.gs, a.memory, decoded.upper);
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg], upperVf, sizeof(upperVf));
+    }
+    else
+    {
+        execUpper(decoded.upper, decoded.flagMode);
+        execLower(decoded.lower, a.vuData, a.dataSize, *a.gs, a.memory, decoded.upper);
+    }
+
+    m_viBranchBackupValid = false;
+
+    if (hasUpperWrite && upperWrite.lanes != 0u)
+    {
+        float *reg = m_state.vf[upperWrite.reg];
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((upperWrite.lanes & ga2_vu1::laneForComponent(component)) == 0u)
+                reg[component] = oldUpperVf[component];
+    }
+    else if (hasUpperWrite)
+        std::memcpy(m_state.vf[upperWrite.reg], oldUpperVf, sizeof(oldUpperVf));
+    if (hasDistinctLowerWrite && lowerWrite.lanes != 0u)
+    {
+        float *reg = m_state.vf[lowerWrite.reg];
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((lowerWrite.lanes & ga2_vu1::laneForComponent(component)) == 0u)
+                reg[component] = oldLowerVf[component];
+    }
+    else if (hasDistinctLowerWrite)
+        std::memcpy(m_state.vf[lowerWrite.reg], oldLowerVf, sizeof(oldLowerVf));
+    if (decoded.upperUsage.accWrite != 0u)
+    {
+        for (uint32_t component = 0; component < 4u; ++component)
+            if ((decoded.upperUsage.accWrite & ga2_vu1::laneForComponent(component)) == 0u)
+                m_state.acc[component] = oldAcc[component];
+    }
+    if (writtenVi != 0u)
+        m_state.vi[writtenVi] = static_cast<int16_t>(m_state.vi[writtenVi]);
+    if (writtenVi != 0u && decoded.lowerUsage.delaysNextBranchRead)
+        recordViWriteForBranch(writtenVi, oldVi);
+
+    m_state.vf[0][0] = 0.0f;
+    m_state.vf[0][1] = 0.0f;
+    m_state.vf[0][2] = 0.0f;
+    m_state.vf[0][3] = 1.0f;
+    m_state.vi[0] = 0;
+
+    m_state.pc += 8u;
+    advanceOneCycle();
+    return StepResult::Continue;
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::finishBlock(uint64_t entryCycle, const BlockFinal *finals,
+                                                                        uint32_t finalCount, uint32_t regWriteReady)
+{
+#pragma clang loop unroll(full)
+    for (uint32_t k = 0; k < finalCount; ++k)
+    {
+        const BlockFinal &f = finals[k];
+        const uint64_t ready = entryCycle + f.offset;
+        switch (f.kind)
+        {
+        case BlockFinalKind::Vf:
+            m_vfReady[f.reg][f.lane] = ready;
+            break;
+        case BlockFinalKind::Vi:
+            m_viReady[f.reg] = ready;
+            break;
+        case BlockFinalKind::Acc:
+            m_accReady[f.lane] = ready;
+            break;
+        }
+    }
+    if (regWriteReady != 0u)
+        m_regWriteReady = std::max(m_regWriteReady, entryCycle + regWriteReady);
+}
