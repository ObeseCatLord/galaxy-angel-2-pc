+
     std::string header()
     {
         return "// Generated by ga2_vu1_gen from a VU1 code image. Do not edit.\n"
@@ -352,12 +386,80 @@ namespace
         if (!write(outdir + "/" + base + ".cpp", dispatch))
             return false;
 
+        // GA2_VU1GEN_BLOCKS=0: no statically scheduled blocks.
+        static const bool blocksEnabled = [] {
+            const char *v = std::getenv("GA2_VU1GEN_BLOCKS");
+            return !(v && *v == '0');
+        }();
+        size_t blockCount = 0, blockPairs = 0;
         for (size_t c = 0; c < chunks.size(); ++c)
         {
             std::string out = header() + "\nnamespace\n{\n";
+            std::vector<VU::DecodedInstructionPair> decoded;
             for (uint32_t index : chunks[c])
+            {
+                VU::DecodedInstructionPair d = VU::decodeForCodegen(code.data(), index * 8u);
+                d.flagMode = modes[index];
+                decoded.push_back(d);
                 out += "constexpr VU::DecodedInstructionPair kP" + std::to_string(index) + " = " +
                        pair(VU::decodeForCodegen(code.data(), index * 8u), modes[index]) + ";\n";
+            }
+            // Blocks: runs of consecutive pairs that fall through to each
+            // other, with nothing pending from a branch, E bit or halt.
+            std::unordered_map<uint32_t, Block> blockAt;
+            if (blocksEnabled)
+            {
+                const std::vector<uint32_t> &ch = chunks[c];
+                auto inBlock = [&](size_t k) {
+                    const uint32_t index = ch[k];
+                    return index + 1u < pairs && !facts.mayBranch[index] && !facts.mayEnd[index] && !facts.mayHalt[index] &&
+                           VU::blockablePair(decoded[k]);
+                };
+                for (size_t k = 0; k < ch.size();)
+                {
+                    if (!inBlock(k))
+                    {
+                        ++k;
+                        continue;
