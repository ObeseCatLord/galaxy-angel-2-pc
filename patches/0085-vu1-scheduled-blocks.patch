index 3528769..cbc6fbb 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -1213,6 +1213,150 @@ bool VU1Interpreter::upperProducesFmacFlags(uint32_t upper)
     return produced;
 }
 
+bool VU1Interpreter::blockablePair(const DecodedInstructionPair &d)
+{
+    return !d.upperUsage.reserved && !d.lowerUsage.reserved && !d.eBit && !d.dBit && !d.tBit &&
+           d.lowerUsage.pipeline != PipelineBranch && d.lowerUsage.pipeline != PipelineXgkick;
+}
+
+bool VU1Interpreter::scheduleBlockForCodegen(const DecodedInstructionPair *pairs, uint32_t count, BlockSchedule &out)
+{
+    out = BlockSchedule{};
+    if (count == 0u || count > kMaxBlockPairs)
+        return false;
+    for (uint32_t i = 0; i < count; ++i)
+        if (!blockablePair(pairs[i]))
+            return false;
+
+    // Timing: run the block on a scratch VU whose pipelines are idle. Timing
+    // does not depend on data (branches and XGKICK are excluded), so every
+    // issue and ready cycle here holds for any entry that passes the guards.
+    static std::vector<uint8_t> code(0x4000u), data(0x4000u);
+    static GS gs;
+    auto vu = std::make_unique<VU1Interpreter>(Unit::VU1);
+    constexpr uint64_t kBase = 1000u;
+    vu->reset();
+    vu->m_cycle = kBase;
+    vu->m_state.cycles = kBase;
+    vu->m_activeVuData = data.data();
+    vu->m_activeVuDataSize = static_cast<uint32_t>(data.size());
+    vu->m_activeGs = &gs;
+    std::fill(data.begin(), data.end(), 0u);
+    const StepArgs args{code.data(), data.data(), static_cast<uint32_t>(data.size()), &gs, nullptr,
+                        static_cast<uint32_t>(code.size()), ~0ull};
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        if (vu->stepPairAfter(pairs[i], PairEntry{false, false, false}, args) != StepResult::Continue || vu->m_stopRequested)
+            return false;
+        out.issue[i] = static_cast<uint32_t>(vu->m_cycle - 1u - kBase);
+    }
+    out.count = count;
+    out.regWriteReady = vu->m_regWriteReady > kBase ? static_cast<uint32_t>(vu->m_regWriteReady - kBase) : 0u;
+    auto addFinal = [&](BlockFinalKind kind, uint32_t reg, uint32_t lane, uint64_t ready) {
+        if (ready == 0u)
+            return true;
+        if (out.finalCount >= std::size(out.finals))
+            return false;
+        out.finals[out.finalCount++] = BlockFinal{kind, static_cast<uint8_t>(reg), static_cast<uint8_t>(lane),
+                                                  static_cast<uint32_t>(ready - kBase)};
+        return true;
+    };
+    for (uint32_t reg = 0; reg < 32u; ++reg)
+        for (uint32_t lane = 0; lane < 4u; ++lane)
+            if (!addFinal(BlockFinalKind::Vf, reg, lane, vu->m_vfReady[reg][lane]))
+                return false;
+    for (uint32_t reg = 0; reg < 16u; ++reg)
+        if (!addFinal(BlockFinalKind::Vi, reg, 0, vu->m_viReady[reg]))
+            return false;
+    for (uint32_t lane = 0; lane < 4u; ++lane)
+        if (!addFinal(BlockFinalKind::Acc, 0, lane, vu->m_accReady[lane]))
+            return false;
+
+    // Guards: whatever a pair consults that no earlier pair of the block has
+    // written must be ready by that pair's issue cycle (its first consultation
+    // has the smallest offset, so later ones follow).
+    bool vfWritten[32][4]{}, viWritten[16]{}, accWritten[4]{};
+    bool vfGuarded[32][4]{}, viGuarded[16]{}, accGuarded[4]{};
+    bool fdivIssued = false, efuIssued = false, fdivGuarded = false, efuUnitGuarded = false, efuAllGuarded = false;
+    auto addGuard = [&](BlockGuardKind kind, uint32_t reg, uint32_t lane, uint32_t offset) {
+        if (out.guardCount >= std::size(out.guards))
+            return false;
+        out.guards[out.guardCount++] = BlockGuard{kind, static_cast<uint8_t>(reg), static_cast<uint8_t>(lane), offset};
+        return true;
+    };
+    for (uint32_t i = 0; i < count; ++i)
+    {
+        const DecodedInstructionPair &p = pairs[i];
+        const uint32_t offset = out.issue[i];
+        for (const InstructionUsage *u : {&p.upperUsage, &p.lowerUsage})
+        {
+            for (uint32_t k = 0; k < u->vfReadCount && k < 2u; ++k)
+                for (uint32_t lane = 0; lane < 4u; ++lane)
+                {
+                    const uint32_t reg = u->vfRead[k].reg;
+                    // VF0 is never written, so its ready cycles stay zero.
+                    if (reg == 0u || (u->vfRead[k].lanes & ga2_vu1::laneForComponent(lane)) == 0u ||
+                        vfWritten[reg][lane] || vfGuarded[reg][lane])
+                        continue;
+                    vfGuarded[reg][lane] = true;
+                    if (!addGuard(BlockGuardKind::Vf, reg, lane, offset))
+                        return false;
+                }
+            for (uint32_t reg = 1; reg < 16u; ++reg)
+                if ((u->viRead & (1u << reg)) != 0u && !viWritten[reg] && !viGuarded[reg])
+                {
+                    viGuarded[reg] = true;
+                    if (!addGuard(BlockGuardKind::Vi, reg, 0, offset))
+                        return false;
+                }
+            for (uint32_t lane = 0; lane < 4u; ++lane)
+                if ((u->accRead & ga2_vu1::laneForComponent(lane)) != 0u && !accWritten[lane] && !accGuarded[lane])
+                {
+                    accGuarded[lane] = true;
+                    if (!addGuard(BlockGuardKind::Acc, 0, lane, offset))
+                        return false;
+                }
+        }
+        const InstructionUsage &low = p.lowerUsage;
+        if ((low.pipeline == PipelineFdiv || low.waitQ) && !fdivIssued && !fdivGuarded)
+        {
+            fdivGuarded = true;
+            if (!addGuard(BlockGuardKind::Fdiv, 0, 0, offset))
+                return false;
+        }
+        if (low.pipeline == PipelineEfu && !efuIssued && !efuUnitGuarded)
+        {
+            efuUnitGuarded = true;
+            if (!addGuard(BlockGuardKind::EfuUnit, 0, 0, offset))
+                return false;
+        }
+        if (low.waitP && !efuAllGuarded)
+        {
+            efuAllGuarded = true;
+            if (!addGuard(BlockGuardKind::EfuAll, 0, 0, offset))
+                return false;
+        }
+        // Writes, as markPairWrites records them.
+        if (low.vfWrite.reg != 0u && p.suppressedLowerVf != low.vfWrite.reg)
+            for (uint32_t lane = 0; lane < 4u; ++lane)
+                if ((low.vfWrite.lanes & ga2_vu1::laneForComponent(lane)) != 0u)
+                    vfWritten[low.vfWrite.reg][lane] = true;
+        if (p.upperUsage.vfWrite.reg != 0u)
+            for (uint32_t lane = 0; lane < 4u; ++lane)
+                if ((p.upperUsage.vfWrite.lanes & ga2_vu1::laneForComponent(lane)) != 0u)
+                    vfWritten[p.upperUsage.vfWrite.reg][lane] = true;
+        for (uint32_t reg = 1; reg < 16u; ++reg)
+            if ((low.viWrite & (1u << reg)) != 0u)
+                viWritten[reg] = true;
+        for (uint32_t lane = 0; lane < 4u; ++lane)
+            if ((p.upperUsage.accWrite & ga2_vu1::laneForComponent(lane)) != 0u)
+                accWritten[lane] = true;
+        fdivIssued = fdivIssued || low.pipeline == PipelineFdiv;
+        efuIssued = efuIssued || low.pipeline == PipelineEfu;
+    }
+    return true;
+}
+
 VU1Interpreter::StepResult VU1Interpreter::stepGeneric(const StepArgs &args)
 {
     return stepPair(getDecodedInstructionPairForPc(args.vuCode, args.codeSize, args.memory, m_state.pc), args);
