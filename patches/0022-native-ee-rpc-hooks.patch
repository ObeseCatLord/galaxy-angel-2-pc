+void PS2IopHostAdapter::configureNativeEeRpcHooks(NativeEeRpcHooks hooks)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    if (m_nativeEeRpcHooksActive || m_activeToken != 0u || m_runtime.eeScheduler().isRunning())
+        throw std::logic_error("native EE RPC hooks require quiescent execution");
+    if (bool(hooks.submit) != bool(hooks.guestBoundary))
+        throw std::invalid_argument("native EE RPC hooks must configure both boundaries");
+    if (m_nativeEeRpcHooks && m_runtime.eeScheduler().hasExecutionContexts())
+        throw std::logic_error("native EE RPC hook replacement requires old execution retirement");
+    NativeEeRpcHookScope hookScope(m_nativeEeRpcHooksActive);
+    std::unique_ptr<NativeEeRpcHooks> replacement;
+    if (hooks.submit) replacement = std::make_unique<NativeEeRpcHooks>(std::move(hooks));
+    // The pair releases its captures here. Native profiles must use sole
+    // long-term hook ownership and weak observers/invocations, or explicitly
+    // detach an externally retained controller before replacement.
+    m_nativeEeRpcHooks.swap(replacement);
+}
+
+bool PS2IopHostAdapter::submitReverseRpc(const ps2x::iop::ReverseRpcRequest &request,
+                                        ps2x::iop::ReverseRpcCompletionEndpoint endpoint)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    if (m_activeToken == 0u || !m_nativeEeRpcHooks || !m_nativeEeRpcHooks->submit) return false;
+    NativeEeRpcHookScope hookScope(m_nativeEeRpcHooksActive);
+    return m_nativeEeRpcHooks->submit(request, std::move(endpoint));
+}
