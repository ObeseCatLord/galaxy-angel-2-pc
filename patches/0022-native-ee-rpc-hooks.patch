+namespace
+{
+    constexpr uint32_t kMainEntry = 0x001D3000u;
+    constexpr uint32_t kHandlerEntry = 0x001D3040u;
+    constexpr uint32_t kCommandId = 0x80005555u;
+    static_assert(kHandlerEntry < PS2_RAM_SIZE && (kHandlerEntry & 3u) == 0u);
+
+    struct SifTrace
+    {
+        unsigned handlers = 0u;
+        uint32_t carrier = 0u;
+        bool normalReturn = true;
+        bool guestThrows = false;
+        std::array<uint32_t, 16> packet{};
+        bool packetMatches = false;
+    };
+
+    SifTrace g_trace;
+
+    void stopMain(uint8_t *, R5900Context *, PS2Runtime *runtime)
+    {
+        runtime->requestStop();
+    }
+
+    void commandHandler(uint8_t *ram, R5900Context *cpu, PS2Runtime *runtime)
+    {
+        ++g_trace.handlers;
+        g_trace.carrier = getRegU32(cpu, 4);
+        g_trace.packetMatches = g_trace.carrier != 0u &&
+            std::memcmp(ram + g_trace.carrier, g_trace.packet.data(), sizeof(g_trace.packet)) == 0;
+        if (g_trace.guestThrows) throw std::runtime_error("intentional guest handler fault");
+        cpu->pc = 0u;
+        if (g_trace.normalReturn) runtime->observeGuestReturn(cpu, 0u);
+    }
+
+    struct TestEnv
+    {
+        PS2Runtime runtime;
+        uint8_t *ram = nullptr;
+
+        TestEnv()
+        {
+            if (!runtime.memory().initialize()) throw std::runtime_error("SIF fixture RAM initialization failed");
+            ram = runtime.memory().getRDRAM();
+        }
+    };
+
+    void prepareTrace()
+    {
+        g_trace = {};
+        for (size_t i = 0u; i != g_trace.packet.size(); ++i)
+            g_trace.packet[i] = 0xAB000000u + static_cast<uint32_t>(i);
+        g_trace.packet[0] = sizeof(g_trace.packet);
+        g_trace.packet[2] = kCommandId;
+    }
+
+    void registerHandler(TestEnv &env, TestCase &t)
+    {
+        t.IsTrue(env.runtime.registerFunction(kMainEntry, stopMain) &&
+                     env.runtime.registerFunction(kHandlerEntry, commandHandler),
+                 "SIF fixture entries must register in the test function table");
+        R5900Context main{};
+        main.pc = kMainEntry;
+        env.runtime.eeScheduler().reset(env.ram, main);
+        ps2_stubs::resetSifState();
+        R5900Context registration{};
+        SET_GPR_U32(&registration, 4, kCommandId);
+        SET_GPR_U32(&registration, 5, kHandlerEntry);
+        SET_GPR_U32(&registration, 6, 0u);
+        ps2_stubs::sceSifAddCmdHandler(env.ram, &registration, &env.runtime);
+    }
+
+    void runCase(TestCase &t, bool checked, bool returned, bool valid, bool epochChanged,
+                 bool fault, bool throwComplete, bool throwCancel)
+    {
+        prepareTrace();
+        TestEnv env;
+        registerHandler(env, t);
+        g_trace.normalReturn = returned;
+        g_trace.guestThrows = fault;
+
+        unsigned completed = 0u;
+        unsigned cancelled = 0u;
+        const uint32_t expectedCarrier = env.runtime.guestMalloc(sizeof(g_trace.packet), 16u);
+        t.IsTrue(expectedCarrier != 0u, "packet heap probe must allocate");
+        env.runtime.guestFree(expectedCarrier);
+        uint32_t retainedAllocation = 0u;
+        const auto claimReleasedCarrier = [&]
+        {
+            retainedAllocation = env.runtime.guestMalloc(sizeof(g_trace.packet), 16u);
+            t.Equals(retainedAllocation, expectedCarrier,
+                     "packet must be freed before its settlement callback runs");
+        };
+
+        ps2_stubs::SifCommandInvocationHooks hooks{};
+        hooks.requireGuestReturn = checked;
+        hooks.isValid = [valid] { return valid; };
+        hooks.onComplete = [&](const R5900Context &cpu, R5900Context &)
+        {
+            ++completed;
+            claimReleasedCarrier();
+            t.Equals(cpu.pc, 0u, "completion must follow the guest return boundary");
+            if (throwComplete) throw std::runtime_error("intentional completion fault");
+        };
+        hooks.onCancel = [&]
+        {
+            ++cancelled;
+            claimReleasedCarrier();
+            if (throwCancel) throw std::runtime_error("intentional cancellation fault");
+        };
+        t.IsTrue(ps2_stubs::dispatchSifCommand(env.ram, &env.runtime, kCommandId,
+                                               g_trace.packet.data(), sizeof(g_trace.packet), std::move(hooks)),
+                 "registered command must be admitted");
+        if (epochChanged) ps2_stubs::resetSifState();
+
+        bool threw = false;
+        try { env.runtime.eeScheduler().run(); }
+        catch (const std::runtime_error &) { threw = true; }
+        const bool success = valid && !epochChanged && !fault && (!checked || returned);
+        t.Equals(completed, unsigned(success), "command completion must settle exactly once on success");
+        t.Equals(cancelled, unsigned(!success), "command cancellation must settle exactly once on failure");
+        t.Equals(g_trace.handlers, unsigned(valid && !epochChanged),
+                 "invalid or epoch-revoked command must not call its guest handler");
+        if (valid && !epochChanged) t.IsTrue(g_trace.packetMatches, "guest handler must observe unchanged packet bytes");
+        t.Equals(threw, fault || (success && throwComplete) || (!success && throwCancel),
+                 "guest and settlement faults must preserve their failure result");
+
+        const uint32_t reused = env.runtime.guestMalloc(sizeof(g_trace.packet), 16u);
+        t.IsTrue(retainedAllocation == expectedCarrier && reused != 0u && reused != retainedAllocation,
+                 "settlement must not free the callback's reused packet carrier twice");
+        env.runtime.guestFree(retainedAllocation);
+        env.runtime.guestFree(reused);
+    }
+
+    void legacyFallback(TestCase &t)
+    {
+        prepareTrace();
+        TestEnv env;
+        registerHandler(env, t);
+        g_trace.normalReturn = false;
+        t.IsTrue(ps2_stubs::dispatchSifCommand(env.ram, &env.runtime, kCommandId,
+                                               g_trace.packet.data(), sizeof(g_trace.packet)),
+                 "legacy command dispatch must be admitted");
+        env.runtime.eeScheduler().run();
+        t.Equals(g_trace.handlers, 1u, "legacy unchecked command must run its handler");
+        t.IsTrue(g_trace.packetMatches, "legacy handler must observe its packet bytes");
+        const uint32_t reused = env.runtime.guestMalloc(sizeof(g_trace.packet), 16u);
+        t.IsTrue(reused == g_trace.carrier && g_trace.carrier != 0u,
+                 "legacy packet ownership must return the handler carrier to the heap");
+        env.runtime.guestFree(reused);
+    }
+}
