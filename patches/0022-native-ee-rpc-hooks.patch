+    void retainedDiscardRetry(TestCase &t)
+    {
+        std::array<uint32_t, 2> expected{}, retained{};
+        std::array<unsigned, 2> notifications{};
+        prepareTrace(); TestEnv env; registerHandler(env, t);
+        if (!env.runtime.eeScheduler().retireInvocationStacksForColdLoad() ||
+            env.runtime.eeScheduler().hasExecutionContexts())
+            throw std::runtime_error("pending-only cancellation fixture did not retire ordinary contexts");
+        for (size_t i = 0; i < 2; ++i)
+        {
+            expected[i] = env.runtime.guestMalloc(sizeof(g_trace.packet), 16);
+            if (!expected[i]) throw std::runtime_error("retry heap probe failed");
+            env.runtime.guestFree(expected[i]);
+            ps2_stubs::SifCommandInvocationHooks hooks{};
+            hooks.onCancel = [&, i]
+            {
+                ++notifications[i];
+                retained[i] = env.runtime.guestMalloc(sizeof(g_trace.packet), 16);
+                t.Equals(retained[i], expected[i], "cancellation must release its own packet before notification");
+                if (i == 1) throw std::runtime_error("intentional second queued cancellation");
+            };
+            if (!ps2_stubs::dispatchSifCommand(env.ram, &env.runtime, kCommandId,
+                                              g_trace.packet.data(), sizeof(g_trace.packet), std::move(hooks)))
+                throw std::runtime_error("retry command was not admitted");
+        }
+        bool threw = false;
+        try { env.runtime.eeScheduler().discardInvocations(); }
+        catch (const std::runtime_error &) { threw = true; }
+        t.IsTrue(threw && notifications[0] == 1 && notifications[1] == 1 &&
+                 env.runtime.eeScheduler().hasExecutionContexts(),
+                 "throwing cancellation must retain the actual queued command collection");
+        env.runtime.eeScheduler().discardInvocations();
+        t.IsTrue(notifications[0] == 1 && notifications[1] == 1 &&
+                 !env.runtime.eeScheduler().hasExecutionContexts(),
+                 "retry must retire commands without replaying their notifications");
+        const uint32_t next = env.runtime.guestMalloc(sizeof(g_trace.packet), 16);
+        t.IsTrue(next && next != retained[0] && next != retained[1],
+                 "retained cancellation retry must not free a callback-owned replacement allocation");
+        env.runtime.guestFree(next);
+        for (auto allocation : retained) env.runtime.guestFree(allocation);
+    }
+
+    void earlyAdmissionFailure(TestCase &t)
+    {
+        unsigned completed = 0, cancelled = 0;
+        prepareTrace(); TestEnv env; registerHandler(env, t);
+        R5900Context unavailable{};
+        SET_GPR_U32(&unavailable, 4, kCommandId);
+        SET_GPR_U32(&unavailable, 5, PS2_RAM_SIZE);
+        ps2_stubs::sceSifAddCmdHandler(env.ram, &unavailable, &env.runtime);
+        t.IsFalse(env.runtime.hasFunction(PS2_RAM_SIZE), "fixture handler address must be outside the test table");
+        ps2_stubs::SifCommandInvocationHooks hooks{};
+        hooks.onComplete = [&](const auto &, auto &) { ++completed; };
+        hooks.onCancel = [&] { ++cancelled; };
+        t.IsFalse(ps2_stubs::dispatchSifCommand(env.ram, &env.runtime, kCommandId,
+                                               g_trace.packet.data(), sizeof(g_trace.packet), std::move(hooks)),
+                  "unavailable command handler must reject admission");
+        t.IsTrue(completed == 0 && cancelled == 0,
+                 "false admission must leave transaction settlement to the caller");
+    }
