+void PS2IopHostAdapter::dispatchNativeEeRpcBoundary(uint32_t entry, uint8_t *rdram,
+                                                  R5900Context *ctx,
+                                                  void (*original)(uint8_t *, R5900Context *, PS2Runtime *))
+{
+    if (!rdram || !ctx || !original) throw std::invalid_argument("native EE RPC boundary has no original function");
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    if (m_nativeEeRpcHooks && m_nativeEeRpcHooks->guestBoundary)
+    {
+        if (m_activeToken != 0u) throw std::logic_error("EE SDK dispatch cannot run inside an IOP call scope");
+        NativeEeRpcHookScope hookScope(m_nativeEeRpcHooksActive);
+        m_nativeEeRpcHooks->guestBoundary(entry, rdram, ctx, &m_runtime, original);
+    }
+    else original(rdram, ctx, &m_runtime);
 }
 
