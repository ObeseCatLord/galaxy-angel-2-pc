+// AutoDMA (from pinned PCSX2 SPU2-X v1.6.0 Dma.cpp, split-stereo mode only):
+// each call moves one 512-byte half block (256 L + 256 R samples) from the
+// device-owned transfer copy into the core's input area in sample RAM.
+std::uint8_t g_adma_completed = 0;
+static void ga2_adma_done_core0() { g_adma_completed |= 1u; }
+static void ga2_adma_done_core1() { g_adma_completed |= 2u; }
+
 void V_Core::AutoDMAReadBuffer(int)
 {
-    throw std::logic_error("AutoDMA consumption is unsupported by this prototype");
+    const int spos = ((InputPosRead + 0xff) & 0x100);
+    if (DMAPtr != NULL)
+        memcpy(GetMemPtr(0x2000 + (Index << 10) + spos), DMAPtr + InputDataProgress, 0x200);
+    MADR += 0x200;
+    InputDataLeft -= 0x100;
+    InputDataProgress += 0x100;
+    if (DMAPtr != NULL)
+        memcpy(GetMemPtr(0x2200 + (Index << 10) + spos), DMAPtr + InputDataProgress, 0x200);
+    MADR += 0x200;
+    InputDataLeft -= 0x100;
+    InputDataProgress += 0x100;
 }
 
