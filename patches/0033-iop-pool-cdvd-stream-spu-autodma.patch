+bool Device::autoDmaEnabled(std::uint8_t core) const noexcept
+{
+    return core <= 1 && (Cores[core].AutoDMACtrl & (core + 1)) != 0;
+}
+
+bool Device::cancelAutoDma(std::uint8_t core) noexcept
+{
+    if (!m_impl || core > 1 || !m_impl->adma_active[core])
+        return false;
+    Cores[core].InputDataLeft = 0;
+    Cores[core].AdmaInProgress = 0;
+    Cores[core].DMAPtr = nullptr;
+    m_impl->adma_active[core] = false;
+    g_adma_completed &= static_cast<std::uint8_t>(~(1u << core));
+    return true;
+}
+
+std::uint8_t Device::takeAutoDmaCompletions() noexcept
+{
+    const std::uint8_t done = g_adma_completed;
+    g_adma_completed = 0;
+    if (m_impl) {
+        for (std::uint8_t core = 0; core < 2; ++core)
+            if (done & (1u << core))
+                m_impl->adma_active[core] = false;
+    }
+    return done;
+}
