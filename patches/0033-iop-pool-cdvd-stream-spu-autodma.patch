+    uint32_t IopMemory::allocateLowest(uint32_t size, uint32_t alignment)
+    {
+        size = alignUp(std::max(size, 1u), 16u);
+        alignment = std::max<uint32_t>(alignment, 4u);
+        if ((alignment & (alignment - 1u)) != 0u || size > HeapLimit - PoolBase)
+            return 0u;
+        std::vector<Allocation> sorted = m_allocations;
+        std::sort(sorted.begin(), sorted.end(), [](const Allocation &a, const Allocation &b) { return a.address < b.address; });
+        uint64_t cursor = PoolBase;
+        for (const Allocation &block : sorted)
+        {
+            const uint64_t aligned = alignUpChecked(uint32_t(std::min<uint64_t>(cursor, 0xFFFFFFFFull)), alignment);
+            if (aligned + size <= block.address)
+                break;
+            cursor = std::max<uint64_t>(cursor, uint64_t(block.address) + block.size);
+        }
+        const uint64_t aligned = alignUpChecked(uint32_t(std::min<uint64_t>(cursor, 0xFFFFFFFFull)), alignment);
+        if (aligned + size > HeapLimit)
+            return 0u;
+        m_allocations.push_back({uint32_t(aligned), size});
+        markOwned(uint32_t(aligned), size);
+        return uint32_t(aligned);
+    }
