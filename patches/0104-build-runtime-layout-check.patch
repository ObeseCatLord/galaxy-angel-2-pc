From 6a2bbe02c988125be737bd9ebab4a57a60d93cf6 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Tue, 20 Oct 2026 10:26:21 -0500
Subject: [PATCH] build: runtime layout check, FP contraction off,
 program-table export helper

Review 55 D1, D2, D3, A5 and the VU1 plan's branch-target wrap (A6).

- Game executables compare sizeof(PS2Runtime/PS2Memory/GS/R5900Context/
  VU1Interpreter) with the shared library's (ps2x_runtime_abi_sizes) and refuse
  to start on a mismatch: CMAKE_LINK_DEPENDS_NO_SHARED does not relink them
  after a runtime header change. GA2_SKIP_ABI_CHECK=1 overrides;
  PS2X_LINK_DEPENDS_SHARED=ON (release/CI) turns the shortcut off.
- -ffp-contract=off is PUBLIC on ps2_runtime so the VU1 interpreter and the
  generated programs never fuse a multiply and an add (aarch64).
- One programLinked() guards all four weak function-table symbols.
- ps2x_export_program_table(target) replaces the repeated linker option.
- The generator's analyses wrap branch targets for any image size (the old
  modulo went negative below 1024 pairs); output for the 2048-pair images is
  byte-identical (checked against the current generated vu1 sources).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                               | 12 +++++--
 ps2xRuntime/CMakeLists.txt                   |  9 ++++++
 ps2xRuntime/cmake/ProgramTable.cmake         |  9 ++++++
 ps2xRuntime/src/lib/ps2_runtime.cpp          | 33 ++++++++++++++++----
 ps2xRuntime/src/main.cpp                     | 29 +++++++++++++++++
 ps2xTest/CMakeLists.txt                      |  4 +--
 ps2xTest/src/ga2_vu1_plan.h                  | 18 +++++++++--
 ps2xTest/src/ps2_runtime_expansion_tests.cpp | 13 ++++++++
 8 files changed, 113 insertions(+), 14 deletions(-)
 create mode 100644 ps2xRuntime/cmake/ProgramTable.cmake

diff --git a/CMakeLists.txt b/CMakeLists.txt
index dd0a14d..33b927c 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,10 +20,18 @@ option(PS2X_BUILD_TEST "Build ps2xTest" ON)
 # Shared ps2_runtime: changing the runtime relinks one library instead of
 # every (very large) recompiled game executable.
 option(PS2X_RUNTIME_SHARED "Build ps2_runtime as a shared library" OFF)
+# Developer shortcut with a catch: executables built against the shared runtime
+# are not relinked when only the library changes, so after a runtime header
+# change (class layout, PCH users) a game target must be rebuilt by hand, for
+# example `ninja ga2_<disc>`. Game executables refuse to start when their view
+# of PS2Runtime/PS2Memory/GS differs from the library's (ps2x_runtime_abi_sizes,
+# GA2_SKIP_ABI_CHECK=1 overrides). Release and CI builds turn the shortcut off.
+option(PS2X_LINK_DEPENDS_SHARED "Relink executables when the shared runtime changes (release/CI)" OFF)
 if(PS2X_RUNTIME_SHARED)
     set(CMAKE_POSITION_INDEPENDENT_CODE ON)
-    # Executables need not relink when only the runtime library changes.
-    set(CMAKE_LINK_DEPENDS_NO_SHARED ON)
+    if(NOT PS2X_LINK_DEPENDS_SHARED)
+        set(CMAKE_LINK_DEPENDS_NO_SHARED ON)
+    endif()
 endif()
 option(PS2X_BUILD_STUDIO "Build ps2xStudio" ON)
 
diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index d3f360a..2555693 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -33,6 +33,7 @@ if(PS2X_ENABLE_SCCACHE)
 endif()
 
 include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/ReleaseMode.cmake")
+include("${CMAKE_CURRENT_SOURCE_DIR}/cmake/ProgramTable.cmake")
 
 set(PS2X_IS_VITA OFF)
 
@@ -540,6 +541,14 @@ if(PS2X_RUNTIME_SHARED AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
     target_link_options(ps2_runtime PRIVATE "LINKER:-Bsymbolic-functions")
 endif()
 
+# The VU1 interpreter and the generated VU1 programs are bit-exact only when
+# the compiler never fuses a multiply and an add (no FP contraction): x86-64
+# without -mfma cannot, aarch64 can. PUBLIC, so the generated programs built by
+# consumers of ps2_runtime use the same setting as the interpreter.
+if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+    target_compile_options(ps2_runtime PUBLIC -ffp-contract=off)
+endif()
+
 # paraLLEl-GS (Vulkan compute GS, LGPL-3.0+): built standalone from an external
 # checkout when PS2X_PGS_DIR points at it.
 set(PS2X_PGS_DIR "" CACHE PATH "paraLLEl-GS checkout (with Granite) for the GPU GS")
diff --git a/ps2xRuntime/cmake/ProgramTable.cmake b/ps2xRuntime/cmake/ProgramTable.cmake
new file mode 100644
index 0000000..fdf5106
--- /dev/null
+++ b/ps2xRuntime/cmake/ProgramTable.cmake
@@ -0,0 +1,9 @@
+# A shared ps2_runtime reads the recompiled program's function table
+# (g_ps2RecompiledFunctionTable*, see ps2_runtime.h) from the executable that
+# loaded it, so the executable must export those symbols dynamically. Call this
+# for every executable that defines a program (game targets, probes, tests).
+function(ps2x_export_program_table target)
+    if(PS2X_RUNTIME_SHARED)
+        target_link_options(${target} PRIVATE "LINKER:--export-dynamic-symbol=g_ps2RecompiledFunctionTable*")
+    endif()
+endfunction()
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index 09c53ed..c35aa12 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1497,10 +1497,20 @@ void PS2Runtime::configureIoPathsFromElf(const std::string &elfPath)
 
 namespace
 {
+    // The program defines these four symbols together; all are weak so tools
+    // and the shared runtime load without one. Every access goes through here.
+    bool programLinked()
+    {
+        return &g_ps2RecompiledFunctionTableBase != nullptr && &g_ps2RecompiledFunctionTableEnd != nullptr &&
+               &g_ps2RecompiledFunctionTableSlotCount != nullptr && g_ps2RecompiledFunctionTable != nullptr;
+    }
+
+    uint32_t programTableBase() { return programLinked() ? g_ps2RecompiledFunctionTableBase : 0u; }
+    uint32_t programTableEnd() { return programLinked() ? g_ps2RecompiledFunctionTableEnd : 0u; }
+
     bool generatedFunctionTableSlot(uint32_t address, uint32_t &slot)
     {
-        if ((address & 3u) != 0u || &g_ps2RecompiledFunctionTableSlotCount == nullptr ||
-            g_ps2RecompiledFunctionTableSlotCount == 0u)
+        if ((address & 3u) != 0u || !programLinked() || g_ps2RecompiledFunctionTableSlotCount == 0u)
         {
             return false;
         }
@@ -1522,8 +1532,8 @@ bool PS2Runtime::replaceFunction(uint32_t address, RecompiledFunction func)
     if (!generatedFunctionTableSlot(address, slot))
     {
         std::cerr << "[function-table] cannot replace guest PC 0x" << std::hex << address
-                  << ": outside generated dense table [0x" << g_ps2RecompiledFunctionTableBase
-                  << ", 0x" << g_ps2RecompiledFunctionTableEnd << ")"
+                  << ": outside generated dense table [0x" << programTableBase()
+                  << ", 0x" << programTableEnd() << ")"
                   << std::dec << std::endl;
         return false;
     }
@@ -1577,8 +1587,8 @@ PS2Runtime::RecompiledFunction PS2Runtime::lookupFunction(uint32_t address)
     }
 
     std::cerr << "Error: No exact recompiled function for guest PC 0x" << std::hex << address
-              << " tableBase=0x" << g_ps2RecompiledFunctionTableBase
-              << " tableEnd=0x" << g_ps2RecompiledFunctionTableEnd
+              << " tableBase=0x" << programTableBase()
+              << " tableEnd=0x" << programTableEnd()
               << " codeRegion=" << (m_memory.isCodeAddress(address) ? "yes" : "no")
               << " trace=" << formatDispatchHistory()
               << std::dec << std::endl;
@@ -3103,3 +3113,14 @@ void PS2Runtime::run()
 
     RUNTIME_LOG("[run] exiting loop");
 }
+
+// Layout stamp for game executables (see ps2xRuntime/src/main.cpp).
+extern "C" void ps2x_runtime_abi_sizes(uint64_t *out)
+{
+    out[0] = sizeof(PS2Runtime);
+    out[1] = sizeof(PS2Memory);
+    out[2] = sizeof(GS);
+    out[3] = sizeof(R5900Context);
+    out[4] = sizeof(VU1Interpreter);
+    out[5] = out[6] = out[7] = 0u;
+}
diff --git a/ps2xRuntime/src/main.cpp b/ps2xRuntime/src/main.cpp
index 1a1d2b5..88adfad 100644
--- a/ps2xRuntime/src/main.cpp
+++ b/ps2xRuntime/src/main.cpp
@@ -181,6 +181,33 @@ namespace
     }
 }
 
+// Defined by the runtime library (ps2_runtime.cpp), compiled from the headers
+// the library saw. A game executable built against older headers while only the
+// shared library was rebuilt (CMAKE_LINK_DEPENDS_NO_SHARED does not relink
+// executables) disagrees on these sizes and would run with a mismatched view
+// of PS2Runtime/PS2Memory/GS: refuse with a clear message instead.
+extern "C" void ps2x_runtime_abi_sizes(uint64_t *out);
+
+namespace
+{
+    bool runtimeAbiMatches()
+    {
+        uint64_t library[8]{};
+        ps2x_runtime_abi_sizes(library);
+        const uint64_t executable[8] = {sizeof(PS2Runtime), sizeof(PS2Memory), sizeof(GS),
+                                        sizeof(R5900Context), sizeof(VU1Interpreter), 0u, 0u, 0u};
+        for (int i = 0; i < 8; ++i)
+            if (library[i] != executable[i])
+            {
+                std::cerr << "This executable was built against different runtime headers than the runtime library it loaded"
+                          << " (layout field " << i << ": executable " << executable[i] << ", library " << library[i]
+                          << "). Rebuild the game target (for example: ninja ga2_<disc>)." << std::endl;
+                return false;
+            }
+        return true;
+    }
+}
+
 int main(int argc, char *argv[])
 {
 #if defined(__ANDROID__)
@@ -212,6 +239,8 @@ int main(int argc, char *argv[])
         }
     }
 #endif
+    if (!std::getenv("GA2_SKIP_ABI_CHECK") && !runtimeAbiMatches())
+        return 3;
 
     try
     {
diff --git a/ps2xTest/CMakeLists.txt b/ps2xTest/CMakeLists.txt
index 9e22f1b..0ba452f 100644
--- a/ps2xTest/CMakeLists.txt
+++ b/ps2xTest/CMakeLists.txt
@@ -136,6 +136,4 @@ target_link_libraries(ga2_vu1_gen PRIVATE ps2_runtime)
 add_executable(ga2_vu1_fuzz src/ga2_vu1_fuzz.cpp)
 target_link_libraries(ga2_vu1_fuzz PRIVATE ps2_runtime)
 
-if(PS2X_RUNTIME_SHARED)
-    target_link_options(ps2x_tests PRIVATE "LINKER:--export-dynamic-symbol=g_ps2RecompiledFunctionTable*")
-endif()
+ps2x_export_program_table(ps2x_tests)
diff --git a/ps2xTest/src/ga2_vu1_plan.h b/ps2xTest/src/ga2_vu1_plan.h
index eb1720f..134b0dc 100644
--- a/ps2xTest/src/ga2_vu1_plan.h
+++ b/ps2xTest/src/ga2_vu1_plan.h
@@ -17,6 +17,18 @@ namespace ga2_vu1plan
 {
 using VU = VU1Interpreter;
 
+// A branch target as the hardware forms it: the pair index wraps in the code
+// memory (2048 pairs on VU1). The immediate reaches back 1024 pairs, so with
+// the former `(index + imm + pairs) % pairs` a smaller image gave a negative
+// operand and a wrong, huge target; this wraps for any size.
+inline uint32_t wrapPair(int64_t index, uint32_t pairs)
+{
+    int64_t wrapped = index % static_cast<int64_t>(pairs);
+    if (wrapped < 0)
+        wrapped += pairs;
+    return static_cast<uint32_t>(wrapped);
+}
+
 // Which FMAC flag results can any instruction observe? (Whole-program.)
 //
 // Status: only FSAND/FSEQ/FSOR read it, so it is dead everywhere unless the
@@ -96,7 +108,7 @@ inline std::vector<uint8_t> flagModes(const std::vector<uint8_t> &code, const st
             const uint32_t lower = word(before, 0);
             int32_t imm = static_cast<int32_t>(lower & 0x7FFu);
             if (imm & 0x400) imm -= 0x800;
-            const uint32_t target = static_cast<uint32_t>((static_cast<int64_t>(before) + 1 + imm + pairs) % pairs);
+            const uint32_t target = wrapPair(static_cast<int64_t>(before) + 1 + imm, pairs);
             succ[2u * i + 1u] = {static_cast<int>(2u * target)};
             if (branchKind[before] == kConditional)
                 succ[2u * i + 1u].push_back(nextAfter(i));
@@ -220,7 +232,7 @@ inline EntryFacts entryFacts(const std::vector<uint8_t> &code)
         {
             int32_t imm = static_cast<int32_t>(word(b, 0) & 0x7FFu);
             if (imm & 0x400) imm -= 0x800;
-            targets.push_back(static_cast<uint32_t>((static_cast<int64_t>(b) + 1 + imm + pairs) % pairs));
+            targets.push_back(wrapPair(static_cast<int64_t>(b) + 1 + imm, pairs));
             targets.push_back((b + 2u) % pairs);
         }
         for (uint32_t t : targets)
@@ -245,7 +257,7 @@ inline std::vector<bool> branchTargets(const std::vector<uint8_t> &code)
             continue;
         int32_t imm = static_cast<int32_t>(lower & 0x7FFu);
         if (imm & 0x400) imm -= 0x800;
-        target[static_cast<uint32_t>((static_cast<int64_t>(b) + 1 + imm + pairs) % pairs)] = true;
+        target[wrapPair(static_cast<int64_t>(b) + 1 + imm, pairs)] = true;
     }
     return target;
 }
diff --git a/ps2xTest/src/ps2_runtime_expansion_tests.cpp b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
index 3cb64d9..fd158bf 100644
--- a/ps2xTest/src/ps2_runtime_expansion_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_expansion_tests.cpp
@@ -311,6 +311,8 @@ namespace
 
 }
 
+extern "C" void ps2x_runtime_abi_sizes(uint64_t *out);
+
 void register_ps2_runtime_expansion_tests()
 {
     MiniTest::Case("PS2RuntimeExpansion", [](TestCase &tc)
@@ -1520,5 +1522,16 @@ void register_ps2_runtime_expansion_tests()
             std::memcpy(&directCmd, rdram.data() + kBaseAddr + 12u, sizeof(directCmd));
             t.Equals(directCmd, 0x50000001u, "sceVif1PkCloseDirectCode should store a 1-QW DIRECT length");
         });
+
+        tc.Run("the runtime library reports the layout this build compiled against", [](TestCase &t)
+        {
+            uint64_t library[8]{};
+            ps2x_runtime_abi_sizes(library);
+            t.Equals(library[0], static_cast<uint64_t>(sizeof(PS2Runtime)), "PS2Runtime size");
+            t.Equals(library[1], static_cast<uint64_t>(sizeof(PS2Memory)), "PS2Memory size");
+            t.Equals(library[2], static_cast<uint64_t>(sizeof(GS)), "GS size");
+            t.Equals(library[3], static_cast<uint64_t>(sizeof(R5900Context)), "R5900Context size");
+            t.Equals(library[4], static_cast<uint64_t>(sizeof(VU1Interpreter)), "VU1Interpreter size");
+        });
     });
 }
