+int main(int argc, char **argv)
+{
+    if (argc == 3 && std::string_view(argv[1]) == "--emit-child")
+        return emitChild(argv[2]);
+    if (argc != 1)
+    {
+        std::cerr << "usage: ps2_iop_module_start_tests [--emit-child PATH]\n";
+        return 2;
+    }
+
+    const std::array<std::pair<const char *, void (*)()>, 4> tests{{
+        {"modload startup ABI and failure side effects", callerExercisesStartupAbiAndErrors},
+        {"malformed physical module does not fall back to HLE", publicMalformedFileCannotFallBackToHle},
+        {"budget and missing-import startup failures", incompleteStartupIsNegative},
+        {"module completion residency and result", completionResidencyUsesLowBitsButKeepsRawResult},
+    }};
+    size_t failed = 0u;
+    for (const auto &[name, test] : tests)
+    {
+        try
+        {
+            test();
+            std::cout << "PASS " << name << '\n';
+        }
+        catch (const std::exception &error)
+        {
+            ++failed;
+            std::cerr << "FAIL " << name << ": " << error.what() << '\n';
+        }
+    }
+    return failed == 0u ? 0 : 1;
+}
