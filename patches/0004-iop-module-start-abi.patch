+{
+    using namespace ps2x::iop;
+
+    constexpr uint32_t kChildBase = 0x00010000u;
+    constexpr uint32_t kChildMarker = kChildBase + 0x700u;
+    constexpr uint32_t kChildLeftCanary = kChildMarker - 4u;
+    constexpr uint32_t kChildRightCanary = kChildMarker + 24u;
+    constexpr uint32_t kChildGp = kChildBase + 0x500u;
+    constexpr uint32_t kChildSnapshot = kChildBase + 0x740u;
+    constexpr uint32_t kCallerBase = 0x00018000u;
+    constexpr uint32_t kCallerMarker = kCallerBase + 0x700u;
+    constexpr uint32_t kCanary = 0xC0DEF00Du;
+
+    constexpr uint32_t kPtLoad = 1u;
+    constexpr uint32_t kPtSceIopMod = 0x70000080u;
+
+    void require(bool value, const char *message)
+    {
+        if (!value)
+            throw std::runtime_error(message);
+    }
+
+    class Host final : public IopHost
+    {
+    public:
+        Host()
+            : guest(0x20000u, 0u)
+        {
+        }
+
+        struct File
+        {
+            std::vector<uint8_t> bytes;
+            bool shortRead = false;
+        };
+
+        bool readGuest(uint32_t address, void *destination, size_t size) const override
+        {
+            if ((size != 0u && !destination) || address > guest.size() || size > guest.size() - address)
+                return false;
+            if (size != 0u)
+                std::memcpy(destination, guest.data() + address, size);
+            return true;
+        }
+        bool writeGuest(uint32_t address, const void *source, size_t size) override
+        {
+            if ((size != 0u && !source) || address > guest.size() || size > guest.size() - address)
+                return false;
+            if (size != 0u)
+                std::memcpy(guest.data() + address, source, size);
+            return true;
+        }
+        bool zeroGuest(uint32_t address, size_t size) override
+        {
+            if (address > guest.size() || size > guest.size() - address)
+                return false;
+            std::memset(guest.data() + address, 0, size);
+            return true;
+        }
+        bool normalizeGuestAddress(uint32_t address, uint32_t &normalized) const override
+        {
+            normalized = address;
+            return address < guest.size();
+        }
+        uint32_t allocateIopHandle(IopHandleKind) override { return 1u; }
+        uint32_t allocateGuest(uint32_t, uint32_t) override { return 0u; }
+        void freeGuest(uint32_t) override {}
+        void audioCommand(uint32_t, uint32_t, GuestBuffer, GuestBuffer) override {}
+        std::string hostPath(HostPathKind) const override { return {}; }
+        std::string translateGuestPath(std::string_view path) const override { return std::string(path); }
+        uint64_t openHostFile(std::string_view path) override
+        {
+            const auto found = files.find(std::string(path));
+            if (found == files.end())
+                return 0u;
+            handles[++nextHandle] = &found->second;
+            return nextHandle;
+        }
+        bool hostFileSize(uint64_t handle, uint64_t &size) const override
+        {
+            const auto found = handles.find(handle);
+            if (found == handles.end())
+                return false;
+            size = found->second->bytes.size();
+            return true;
+        }
+        bool readHostFile(uint64_t handle, uint64_t offset, void *destination, size_t size,
+                          size_t &bytesRead) override
+        {
+            bytesRead = 0u;
+            const auto found = handles.find(handle);
+            if (found == handles.end() || offset > found->second->bytes.size() ||
+                size > found->second->bytes.size() - offset)
+                return false;
+            if (size != 0u)
+                std::memcpy(destination, found->second->bytes.data() + offset, size);
+            bytesRead = found->second->shortRead && size != 0u ? size - 1u : size;
+            return true;
+        }
+        void closeHostFile(uint64_t handle) override { handles.erase(handle); }
+        int32_t memoryCard(const MemoryCardRequest &) override { return 0; }
+        bool hasGuestFunction(uint32_t) const override { return false; }
+        bool invokeGuestFunction(uint64_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t *) override
+        {
+            return false;
+        }
+        void log(LogLevel, std::string_view message) override { logs.emplace_back(message); }
+
+        std::vector<uint8_t> guest;
+        std::map<std::string, File> files;
+        std::map<uint64_t, const File *> handles;
+        uint64_t nextHandle = 0u;
+        std::vector<std::string> logs;
+    };
+
+    class Irx
+    {
+    public:
+        Irx(uint32_t base, uint32_t span, bool iopMod)
+            : base(base), span(span), bytes(0x100u + span, 0u)
+        {
+            put32(0u, 0x464C457Fu);
+            bytes[4] = bytes[5] = bytes[6] = 1u;
+            put16(16u, 2u);
+            put16(18u, 8u);
+            put32(20u, 1u);
+            put32(24u, base);
+            put32(28u, 52u);
+            put16(40u, 52u);
+            put16(42u, 32u);
+            put16(44u, iopMod ? 2u : 1u);
+            program(52u, kPtLoad, 0x100u, base, span, span, 7u);
+        }
+
+        void program(uint32_t offset, uint32_t type, uint32_t fileOffset, uint32_t vaddr,
+                     uint32_t fileSize, uint32_t memorySize, uint32_t flags)
+        {
+            put32(offset, type);
+            put32(offset + 4u, fileOffset);
+            put32(offset + 8u, vaddr);
+            put32(offset + 12u, vaddr);
+            put32(offset + 16u, fileSize);
+            put32(offset + 20u, memorySize);
+            put32(offset + 24u, flags);
+            put32(offset + 28u, 4u);
+        }
+
+        void word(uint32_t segmentOffset, uint32_t value) { put32(0x100u + segmentOffset, value); }
+        void half(uint32_t segmentOffset, uint16_t value) { put16(0x100u + segmentOffset, value); }
+        void data(uint32_t segmentOffset, const void *source, size_t size)
+        {
+            require(segmentOffset <= span && size <= span - segmentOffset, "IRX fixture overflow");
+            std::memcpy(bytes.data() + 0x100u + segmentOffset, source, size);
+        }
+        void string(uint32_t segmentOffset, std::string_view value)
+        {
+            data(segmentOffset, value.data(), value.size());
+            const uint8_t zero = 0u;
+            data(segmentOffset + uint32_t(value.size()), &zero, 1u);
+        }
+
+        uint32_t base;
+        uint32_t span;
+        std::vector<uint8_t> bytes;
+
+    private:
+        void put16(uint32_t offset, uint16_t value)
+        {
+            require(offset <= bytes.size() && 2u <= bytes.size() - offset, "IRX header overflow");
+            bytes[offset] = static_cast<uint8_t>(value);
+            bytes[offset + 1u] = static_cast<uint8_t>(value >> 8u);
+        }
+        void put32(uint32_t offset, uint32_t value)
+        {
+            put16(offset, static_cast<uint16_t>(value));
+            put16(offset + 2u, static_cast<uint16_t>(value >> 16u));
+        }
+    };
+
+    constexpr uint32_t addiu(uint32_t rt, uint32_t rs, int16_t immediate)
+    {
+        return 0x24000000u | (rs << 21u) | (rt << 16u) | static_cast<uint16_t>(immediate);
+    }
+    constexpr uint32_t lui(uint32_t rt, uint16_t immediate) { return 0x3C000000u | (rt << 16u) | immediate; }
+    constexpr uint32_t ori(uint32_t rt, uint32_t rs, uint16_t immediate)
+    {
+        return 0x34000000u | (rs << 21u) | (rt << 16u) | immediate;
+    }
+    constexpr uint32_t lw(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0x8C000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t lbu(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0x90000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t lhu(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0x94000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t sw(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0xAC000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t sb(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0xA0000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t sh(uint32_t rt, uint32_t base, int16_t offset)
+    {
+        return 0xA4000000u | (base << 21u) | (rt << 16u) | static_cast<uint16_t>(offset);
+    }
+    constexpr uint32_t jal(uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); }
+    constexpr uint32_t jump(uint32_t target) { return 0x08000000u | ((target >> 2u) & 0x03FFFFFFu); }
+    constexpr uint32_t jr(uint32_t reg) { return 0x00000008u | (reg << 21u); }
+    constexpr uint32_t addu(uint32_t rd, uint32_t rs, uint32_t rt)
+    {
+        return (rs << 21u) | (rt << 16u) | (rd << 11u) | 0x21u;
+    }
+
+    void emitConstant(std::vector<uint32_t> &code, uint32_t reg, uint32_t value)
+    {
+        code.push_back(lui(reg, static_cast<uint16_t>(value >> 16u)));
+        code.push_back(ori(reg, reg, static_cast<uint16_t>(value)));
+    }
+
+    Irx childIrx(uint32_t base = kChildBase, uint32_t result = 2u, bool missingImport = false,
+                 bool loop = false)
+    {
+        constexpr uint32_t span = 0x800u;
+        Irx image(base, span, true);
+        image.program(84u, kPtSceIopMod, 0x100u + 0x280u, base + 0x280u, 24u, 24u, 0u);
+        image.word(0x280u, base + 0x2A0u);
+        image.word(0x284u, base);
+        image.word(0x288u, base + 0x500u);
+        image.word(0x28Cu, 0x80u);
+        image.word(0x290u, 0x10u);
+        image.word(0x294u, 0x20u);
+        image.word(0x2A0u, base + 0x2B0u);
+        image.half(0x2A4u, 0x0201u);
+        image.string(0x2B0u, "argvmark");
+        image.word(0x6FCu, kCanary);
+        image.word(0x718u, kCanary);
+        image.word(0x714u, kCanary);
+
+        if (loop)
+        {
+            image.word(0u, jump(base));
+            image.word(4u, 0u);
+            return image;
+        }
+        if (missingImport)
+        {
+            image.word(0u, addu(16u, 31u, 0u));
+            image.word(4u, jal(base + 0x340u + 20u));
+            image.word(8u, 0u);
+            image.word(12u, addiu(2u, 0u, 0));
+            image.word(16u, jr(16u));
+            image.word(20u, 0u);
+            const uint32_t imports[] = {0x41E00000u, 0u, 0x0101u, 0x73696D6Du, 0x00676E69u,
+                                        jr(31u), addiu(0u, 0u, 1), 0u, 0u};
+            image.data(0x340u, imports, sizeof(imports));
+            return image;
+        }
+
+        std::vector<uint32_t> code;
+        emitConstant(code, 8u, base + 0x700u);
+        code.push_back(sw(4u, 8u, 0));
+        code.push_back(sw(5u, 8u, 4));
+        code.push_back(sw(28u, 8u, 8));
+        code.push_back(sw(7u, 8u, 12));
+        code.push_back(sw(6u, 8u, 16));
+        // argv is freed after entry returns. Copy the observed arguments into
+        // the child image so the test and external probe inspect entry-time data.
+        code.push_back(lw(9u, 5u, 0));
+        code.push_back(0u);
+        for (uint32_t offset = 0u; offset < 19u; ++offset)
+        {
+            code.push_back(lbu(10u, 9u, static_cast<int16_t>(offset)));
+            code.push_back(0u);
+            code.push_back(sb(10u, 8u, static_cast<int16_t>(0x40u + offset)));
+        }
+        code.push_back(lw(9u, 5u, 4));
+        code.push_back(0u);
+        for (uint32_t offset = 0u; offset < 6u; ++offset)
+        {
+            code.push_back(lbu(10u, 9u, static_cast<int16_t>(offset)));
+            code.push_back(0u);
+            code.push_back(sb(10u, 8u, static_cast<int16_t>(0x54u + offset)));
+        }
+        code.push_back(lw(9u, 5u, 8));
+        code.push_back(0u);
+        code.push_back(lbu(10u, 9u, 0));
+        code.push_back(0u);
+        code.push_back(sb(10u, 8u, 0x5A));
+        code.push_back(lw(10u, 5u, 12));
+        code.push_back(0u);
+        code.push_back(sw(10u, 8u, 0x5C));
+        emitConstant(code, 2u, result);
+        code.push_back(jr(31u));
+        code.push_back(0u);
+        for (uint32_t index = 0u; index < code.size(); ++index)
+            image.word(index * 4u, code[index]);
+        return image;
+    }
+
+    Irx callerIrx()
+    {
+        Irx image(kCallerBase, 0x800u, false);
+        constexpr uint32_t imports = kCallerBase + 0x300u;
+        constexpr uint32_t childPath = kCallerBase + 0x400u;
+        constexpr uint32_t missingPath = kCallerBase + 0x420u;
+        constexpr uint32_t shortPath = kCallerBase + 0x440u;
+        constexpr uint32_t malformedPath = kCallerBase + 0x460u;
+        constexpr uint32_t goodArgs = kCallerBase + 0x480u;
+        constexpr uint32_t badArgs = kCallerBase + 0x490u;
+        const auto stub = [](uint32_t ordinal) { return imports + 20u + ordinal * 8u; };
+
+        image.string(0x400u, "host0:ga2-test.irx");
+        image.string(0x420u, "host0:missing.irx");
+        image.string(0x440u, "host0:short.irx");
+        image.string(0x460u, "host0:bad.irx");
+        constexpr std::array<uint8_t, 7> args = {'a', 'l', 'p', 'h', 'a', 0u, 0u};
+        constexpr std::array<uint8_t, 5> unterminated = {'a', 'l', 'p', 'h', 'a'};
+        image.data(0x480u, args.data(), args.size());
+        image.data(0x490u, unterminated.data(), unterminated.size());
+        for (uint32_t offset = 0u; offset < 0x40u; offset += 4u)
+            image.word(0x700u + offset, kCanary);
+
+        std::vector<uint32_t> code;
+        code.push_back(addu(16u, 31u, 0u));
+        const auto load = [&](uint32_t path, int32_t size, uint32_t arguments, uint32_t output, uint32_t resultOffset)
+        {
+            emitConstant(code, 4u, path);
+            emitConstant(code, 5u, static_cast<uint32_t>(size));
+            emitConstant(code, 6u, arguments);
+            emitConstant(code, 7u, output);
+            code.push_back(jal(stub(7u)));
+            code.push_back(0u);
+            emitConstant(code, 8u, kCallerMarker + resultOffset);
+            code.push_back(sw(2u, 8u, 0));
+        };
+
+        emitConstant(code, 4u, childPath);
+        code.push_back(jal(stub(15u)));
+        code.push_back(0u);
+        emitConstant(code, 8u, kCallerMarker);
+        code.push_back(sw(2u, 8u, 0));
+        load(childPath, 7, goodArgs, kCallerMarker + 8u, 4u);
+        load(missingPath, 0, 0u, kCallerMarker + 16u, 12u);
+        load(childPath, 5, badArgs, kCallerMarker + 24u, 20u);
+        load(childPath, 7, 0x00300000u, kCallerMarker + 32u, 28u);
+        load(childPath, 7, goodArgs, 0x00300000u, 36u);
+        load(shortPath, 0, 0u, kCallerMarker + 44u, 40u);
+        load(malformedPath, 0, 0u, kCallerMarker + 52u, 48u);
+        code.push_back(addiu(2u, 0u, 0));
+        code.push_back(jr(16u));
+        code.push_back(0u);
+        for (uint32_t index = 0u; index < code.size(); ++index)
+            image.word(index * 4u, code[index]);
+
+        image.word(0x300u, 0x41E00000u);
+        image.word(0x304u, 0u);
+        image.word(0x308u, 0x0101u);
+        image.word(0x30Cu, 0x6C646F6Du);
+        image.word(0x310u, 0x0064616Fu);
+        for (uint32_t ordinal = 0u; ordinal <= 15u; ++ordinal)
+        {
+            image.word(0x314u + ordinal * 8u, jr(31u));
+            image.word(0x318u + ordinal * 8u, addiu(0u, 0u, static_cast<int16_t>(ordinal)));
+        }
+        image.word(0x314u + 16u * 8u, 0u);
+        image.word(0x318u + 16u * 8u, 0u);
+        return image;
+    }
+
+    uint32_t word(const IopSubsystem &iop, uint32_t address)
+    {
+        uint32_t value = 0u;
+        require(iop.readMemory(address, &value, sizeof(value)), "expected owned IOP word");
+        return value;
+    }
+
+    uint16_t half(const IopSubsystem &iop, uint32_t address)
+    {
+        uint16_t value = 0u;
+        require(iop.readMemory(address, &value, sizeof(value)), "expected owned IOP halfword");
+        return value;
+    }
+
+    std::string string(const IopSubsystem &iop, uint32_t address)
+    {
+        std::string value;
+        for (uint32_t n = 0u; n < 128u; ++n)
+        {
+            uint8_t byte = 0u;
+            require(iop.readMemory(address + n, &byte, 1u), "expected owned IOP string");
+            if (byte == 0u)
+                return value;
+            value.push_back(static_cast<char>(byte));
+        }
+        throw std::runtime_error("unterminated IOP string");
+    }
+
+    void callerExercisesStartupAbiAndErrors()
+    {
+        Host host;
+        host.files.emplace("host0:caller.irx", Host::File{callerIrx().bytes});
+        host.files.emplace("host0:ga2-test.irx", Host::File{childIrx().bytes});
+        host.files.emplace("host0:short.irx", Host::File{childIrx(0x00011000u).bytes, true});
+        host.files.emplace("host0:bad.irx", Host::File{{0x01u, 0x02u, 0x03u}});
+        IopSubsystem iop(host);
+
+        const ModuleLoadResult caller = iop.loadModule("host0:caller.irx");
+        require(caller.moduleId > 0 && caller.startResult == 0, "synthetic modload caller did not complete");
+        require(word(iop, kCallerMarker) == 0u, "modload ordinal 15 predicate did not succeed");
+        const uint32_t childId = word(iop, kCallerMarker + 4u);
+        require(childId > 0u && word(iop, kCallerMarker + 8u) == 2u, "modload ordinal 7 result/output mismatch");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 12u)) == -203, "missing host file did not report -203");
+        require(word(iop, kCallerMarker + 16u) == kCanary, "missing file modified output buffer");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 20u)) == -201, "unterminated packed args accepted");
+        require(word(iop, kCallerMarker + 24u) == kCanary, "bad packed args modified output buffer");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 28u)) == -201, "invalid packed-args pointer accepted");
+        require(word(iop, kCallerMarker + 32u) == kCanary, "invalid packed-args pointer modified output buffer");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 36u)) == -201, "invalid result pointer accepted");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 40u)) == -204, "short read did not report -204");
+        require(word(iop, kCallerMarker + 44u) == kCanary, "short read modified output buffer");
+        require(static_cast<int32_t>(word(iop, kCallerMarker + 48u)) == -201, "malformed ELF did not report -201");
+        require(word(iop, kCallerMarker + 52u) == kCanary, "malformed ELF modified output buffer");
+        require(iop.debugSnapshot().emulatorLoadedModules == 2u, "failed module starts changed published module count");
+
+        require(word(iop, kChildLeftCanary) == kCanary && word(iop, kChildRightCanary) == kCanary,
+                "child marker canary was overwritten");
+        require(word(iop, kChildMarker) == 3u, "child argc is not filename plus alpha plus empty argument");
+        const std::array<uint8_t, 20> expectedPath = {
+            'h', 'o', 's', 't', '0', ':', 'g', 'a', '2', '-', 't', 'e', 's', 't', '.', 'i', 'r', 'x', 0u, 0u};
+        std::array<uint8_t, 20> observedPath{};
+        require(iop.readMemory(kChildSnapshot, observedPath.data(), observedPath.size()), "missing argv[0] snapshot");
+        require(observedPath == expectedPath, "argv[0] pathname snapshot mismatch");
+        const std::array<uint8_t, 6> expectedAlpha = {'a', 'l', 'p', 'h', 'a', 0u};
+        std::array<uint8_t, 6> observedAlpha{};
+        require(iop.readMemory(kChildSnapshot + 20u, observedAlpha.data(), observedAlpha.size()), "missing argv[1] snapshot");
+        require(observedAlpha == expectedAlpha, "argv[1] snapshot mismatch");
+        uint8_t empty = 1u;
+        require(iop.readMemory(kChildSnapshot + 26u, &empty, 1u) && empty == 0u,
+                "argv[2] is not the packed empty argument");
+        require(word(iop, kChildSnapshot + 28u) == 0u, "argv vector lacks a trailing null");
+        require(word(iop, kChildMarker + 8u) == kChildGp, "module GP was not supplied to entry");
+        require(word(iop, kChildMarker + 16u) == 0u, "module entry a2 is not zero");
+
+        const uint32_t info = word(iop, kChildMarker + 12u);
+        require(string(iop, word(iop, info + 4u)) == "argvmark", "ModuleInfo_t name offset mismatch");
+        require(half(iop, info + 8u) == 0x0201u && half(iop, info + 10u) == 0x0013u,
+                "ModuleInfo_t version or post-start flags mismatch");
+        require(half(iop, info + 12u) == childId, "ModuleInfo_t id offset mismatch");
+        require(word(iop, info + 16u) == kChildBase && word(iop, info + 20u) == kChildGp,
+                "ModuleInfo_t entry or GP mismatch");
+        require(word(iop, info + 24u) == kChildBase && word(iop, info + 28u) == 0x80u &&
+                    word(iop, info + 32u) == 0x10u && word(iop, info + 36u) == 0x20u,
+                "ModuleInfo_t base or segment sizes mismatch");
+    }
+
+    void publicMalformedFileCannotFallBackToHle()
+    {
+        Host host;
+        host.files.emplace("host0:LIBSD.IRX", Host::File{{0x01u, 0x02u, 0x03u}});
+        IopSubsystem iop(host);
+        const ModuleLoadResult result = iop.loadModule("host0:LIBSD.IRX");
+        require(result.moduleId == -201 && result.startResult == -1,
+                "malformed host0:LIBSD.IRX incorrectly became an HLE success");
+    }
+
+    void incompleteStartupIsNegative()
+    {
+        for (const auto &[path, image] : std::array<std::pair<const char *, Irx>, 2>{
+                 std::pair{"host0:loop.irx", childIrx(0x00010000u, 0u, false, true)},
+                 std::pair{"host0:missing-import.irx", childIrx(0x00011000u, 0u, true)},
+             })
+        {
+            Host host;
+            host.files.emplace(path, Host::File{image.bytes});
+            IopSubsystem iop(host);
+            const ModuleLoadResult result = iop.loadModule(path);
+            require(result.moduleId == -200 && result.startResult == -1,
+                    "budgeted or missing-import startup was reported as a success");
+            require(iop.debugSnapshot().emulatorLoadedModules == 0u,
+                    "incomplete startup was published as a loaded module");
+        }
+    }
+
+    void completionResidencyUsesLowBitsButKeepsRawResult()
+    {
+        struct Case { uint32_t result; bool published; };
+        for (const Case test : std::array<Case, 4>{{{0u, true}, {1u, false}, {2u, true}, {3u, true}}})
+        {
+            Host host;
+            host.files.emplace("host0:result.irx", Host::File{childIrx(0x00010000u, test.result).bytes});
+            IopSubsystem iop(host);
+            const ModuleLoadResult result = iop.loadModule("host0:result.irx");
+            require(result.moduleId > 0 && static_cast<uint32_t>(result.startResult) == test.result,
+                    "completed entry result was not preserved");
+            require((iop.debugSnapshot().emulatorLoadedModules != 0u) == test.published,
+                    "entry result low bits produced the wrong publication state");
+        }
+    }
+
+    int emitChild(std::string_view path)
+    {
+        const Irx image = childIrx(0x00040000u);
+        std::ofstream output(std::string(path), std::ios::binary | std::ios::trunc);
+        if (!output.write(reinterpret_cast<const char *>(image.bytes.data()), static_cast<std::streamsize>(image.bytes.size())))
+        {
+            std::cerr << "failed to write child fixture\n";
+            return 1;
+        }
+        return 0;
+    }
+}
