+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -985,6 +985,7 @@ namespace
 std::atomic<uint64_t> ga2_activity::vu1Runs{0};
 std::atomic<uint64_t> ga2_activity::vsyncs{0};
 std::atomic<int64_t> ga2_activity::last3dNanos{INT64_MIN / 2};
+std::atomic<int64_t> ga2_activity::last3dVsync{INT64_MIN / 2};
 std::atomic<float> ga2_activity::horPlus{1.0f};
 
 VU1Interpreter::PerfSample VU1Interpreter::takePerfSample()
@@ -1015,6 +1016,7 @@ void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
     } perfScope{perfStart, perfCycle, m_cycle};
     if ((ga2_activity::vu1Runs.fetch_add(1, std::memory_order_relaxed) & 31u) == 0u)
         ga2_activity::last3dNanos.store(ga2_activity::nowNanos(), std::memory_order_relaxed);
+        ga2_activity::last3dVsync.store(int64_t(ga2_activity::vsyncs.load(std::memory_order_relaxed)), std::memory_order_relaxed);
     m_activeVuData = vuData;
     m_activeVuDataSize = dataSize;
     m_activeGs = &gs;
