+            constexpr uint32_t kVif1 = 0x10009000u;
+            constexpr uint32_t kDst = 0x00034000u;
+            uint32_t available = 0u; // qwords the GS FIFO holds
+            mem.setLocalToHostReader([&available](uint8_t *dst, uint32_t bytes) -> uint32_t
+            {
+                if (available == 0u || bytes < 16u)
+                    return 0u;
+                --available;
+                std::memset(dst, 0xA5, 16u);
+                return 16u;
+            });
+            std::memset(mem.getRDRAM() + kDst, 0x11, 32u);
+            mem.writeIORegister(kVif1 + 0x10u, kDst);
+            mem.writeIORegister(kVif1 + 0x20u, 2u);
+            mem.writeIORegister(kVif1 + 0x00u, 0x100u); // DIR = 0: from VIF1
+            t.IsTrue((mem.readIORegister(kVif1) & 0x100u) != 0u, "a stalled download stays busy");
+            t.Equals(mem.readIORegister(kVif1 + 0x20u) & 0xFFFFu, 2u, "nothing transferred from an empty FIFO");
+            t.Equals(static_cast<uint32_t>(mem.getRDRAM()[kDst]), 0x11u, "no fabricated data");
+            t.IsTrue(mem.consumeDelayedDmacCauses().empty(), "no completion while stalled");
+            available = 2u; // the GS transfer started
+            mem.processPendingTransfers();
+            t.Equals(mem.readIORegister(kVif1 + 0x20u) & 0xFFFFu, 0u, "download finished once data arrived");
+            t.Equals(static_cast<uint32_t>(mem.getRDRAM()[kDst + 16u]), 0xA5u, "downloaded data reaches memory");
+            t.Equals(mem.consumeDelayedDmacCauses().size(), size_t{1}, "one delayed completion");
+        });
