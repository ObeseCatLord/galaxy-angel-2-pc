+bool PS2Memory::drainVif1Download()
+{
+    static constexpr uint32_t kVif1 = 0x10009000u;
+    if (!m_localToHostReader)
+        return false;
+    uint32_t count = m_ioRegisters[kVif1 + 0x20u] & 0xFFFFu;
+    uint32_t address = m_ioRegisters[kVif1 + 0x10u] & 0x7FFFFFF0u;
+    const uint32_t requested = count;
+    while (count != 0u)
+    {
+        uint8_t qword[16]{};
+        // The GS hands out whole qwords (the last one of a transfer padded).
+        // An empty FIFO stalls the channel as on hardware: no fabricated data.
+        if (m_localToHostReader(qword, 16u) == 0u)
+            break;
+        uint32_t offset = 0;
+        try
+        {
+            offset = translateAddress(address);
+        }
+        catch (const std::exception &)
+        {
+            break;
+        }
+        if (offset + 16u > PS2_RAM_SIZE)
+            break;
+        std::memcpy(m_rdram + offset, qword, 16u);
+        markModified(offset, 16u);
+        address += 16u;
+        --count;
+    }
+    m_ioRegisters[kVif1 + 0x10u] = address;
+    m_ioRegisters[kVif1 + 0x20u] = (m_ioRegisters[kVif1 + 0x20u] & ~0xFFFFu) | count;
+    if (count != 0u)
+    {
+        static bool logged = false;
+        if (!logged)
+            std::fprintf(stderr, "[dma] VIF1 download stalled: GS FIFO empty with %u of %u qwords left\n", count, requested);
+        logged = true;
+        return false;
+    }
+    // The GS streams a download at roughly a qword per bus cycle; the
+    // completion interrupt must not beat the guest to SleepThread.
+    completeDmacChannelDelayed(kVif1, 1u, std::max<uint64_t>(2000u, uint64_t(requested) * 4u));
+    return true;
+}
+
 void PS2Memory::completeDmacChannelDelayed(uint32_t channelBase, uint32_t cause, uint64_t latencyCycles)
 {
     completeDmacChannel(channelBase, cause);
@@ -2438,6 +2460,10 @@ void PS2Memory::processPendingTransfers()
         m_ioRegisters[VIF1_CHANNEL + 0x00] &= ~0x100u;
         m_ioRegisters[VIF1_CHANNEL + 0x20] = 0;
     }
+
+    const uint32_t vif1Chcr = m_ioRegisters[0x10009000u];
+    if ((vif1Chcr & 0x101u) == 0x100u && (m_ioRegisters[0x10009020u] & 0xFFFFu) != 0u)
+        (void)drainVif1Download(); // resume a download that found the FIFO empty
 }
 
 void PS2Memory::queueCompletedDmacCause(uint32_t cause)
@@ -2906,6 +2932,10 @@ uint32_t PS2Memory::readIORegister(uint32_t address)
             {
                 if (address == 0x1000B400u || address == 0x1000B000u)
                     return m_ioRegisters[address];
+                // A VIF1 download stalled on an empty GS FIFO is still busy.
+                if (address == 0x10009000u && (m_ioRegisters[address] & 0x101u) == 0x100u &&
+                    (m_ioRegisters[0x10009020u] & 0xFFFFu) != 0u)
+                    return m_ioRegisters[address];
                 uint32_t channelStatus = m_ioRegisters[address] & ~0x100u;
                 m_ioRegisters[address] = channelStatus;
                 return channelStatus;
