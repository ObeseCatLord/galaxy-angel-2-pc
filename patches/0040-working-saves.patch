+// SIGNAL/FINISH set their CSR bit; the GS interrupt is raised on the 0->1
+// edge when the matching IMR mask bit (SIGMSK 8, FINISHMSK 9) is clear.
+void GS::raiseCsrInterrupt(uint32_t bit, uint64_t maskBit)
+{
+    const uint64_t previous = m_privRegs->csr.fetch_or(bit);
+    static const bool trace = std::getenv("GA2_DMA_TRACE") != nullptr;
+    if (trace)
+        std::fprintf(stderr, "[gs] csr bit %u set (prev csr=%llx imr=%llx)\n", bit,
+                     static_cast<unsigned long long>(previous), static_cast<unsigned long long>(m_privRegs->imr));
+    if ((previous & bit) == 0u && (m_privRegs->imr & maskBit) == 0u && m_interruptSink)
+        m_interruptSink(bit);
+}
