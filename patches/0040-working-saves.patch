+void PS2Memory::completeDmacChannelDelayed(uint32_t channelBase, uint32_t cause, uint64_t latencyCycles)
+{
+    completeDmacChannel(channelBase, cause);
+    std::lock_guard<std::mutex> lock(m_completedDmacMutex);
+    // completeDmacChannel queued the cause for immediate dispatch; move it.
+    auto it = std::find(m_completedDmacCauses.rbegin(), m_completedDmacCauses.rend(), cause);
+    if (it != m_completedDmacCauses.rend())
+        m_completedDmacCauses.erase(std::next(it).base());
+    m_delayedDmacCauses.emplace_back(cause, latencyCycles);
+}
+
+std::vector<std::pair<uint32_t, uint64_t>> PS2Memory::consumeDelayedDmacCauses()
+{
+    std::lock_guard<std::mutex> lock(m_completedDmacMutex);
+    std::vector<std::pair<uint32_t, uint64_t>> causes;
+    causes.swap(m_delayedDmacCauses);
+    return causes;
+}
