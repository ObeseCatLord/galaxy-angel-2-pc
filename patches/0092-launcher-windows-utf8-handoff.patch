diff --git a/ps2xRuntime/src/main.cpp b/ps2xRuntime/src/main.cpp
index 7f9eb23..1a1d2b5 100644
--- a/ps2xRuntime/src/main.cpp
+++ b/ps2xRuntime/src/main.cpp
@@ -25,6 +25,21 @@
 #include <cstring>
 #endif
 
+#ifdef _WIN32
+// The few Win32 calls the UTF-8 command line needs, declared here instead of
+// including <windows.h>: this file shares unity batches with generated code,
+// which must not see the Win32 macros (near, far, ...). The declarations match
+// the SDK's.
+extern "C"
+{
+    __declspec(dllimport) wchar_t *__stdcall GetCommandLineW(void);
+    __declspec(dllimport) wchar_t **__stdcall CommandLineToArgvW(const wchar_t *, int *);
+    __declspec(dllimport) void *__stdcall LocalFree(void *);
+    __declspec(dllimport) int __stdcall WideCharToMultiByte(unsigned, unsigned long, const wchar_t *, int, char *, int,
+                                                           const char *, int *);
+}
+#endif
+
 namespace
 {
 #if defined(__ANDROID__)
@@ -172,6 +187,31 @@ int main(int argc, char *argv[])
     redirectStdioToLogcat();
 #endif
     setupTerminateLogger();
+#ifdef _WIN32
+    // The CRT's argv is in the ANSI code page: a path with characters outside
+    // it (a user name, the launcher's data folder) would arrive as '?'. Decode
+    // the wide command line to UTF-8 instead (std::filesystem reads UTF-8).
+    std::vector<std::string> utf8Arguments;
+    std::vector<char *> utf8Argv;
+    {
+        int wideCount = 0;
+        if (wchar_t **wide = CommandLineToArgvW(GetCommandLineW(), &wideCount))
+        {
+            for (int i = 0; i < wideCount; ++i)
+            {
+                const int size = WideCharToMultiByte(65001u /* CP_UTF8 */, 0, wide[i], -1, nullptr, 0, nullptr, nullptr);
+                std::string text(size > 1 ? size_t(size - 1) : 0u, '\0');
+                if (size > 1) WideCharToMultiByte(65001u, 0, wide[i], -1, text.data(), size, nullptr, nullptr);
+                utf8Arguments.push_back(std::move(text));
+            }
+            LocalFree(wide);
+            for (auto &text : utf8Arguments) utf8Argv.push_back(text.data());
+            utf8Argv.push_back(nullptr);
+            argc = wideCount;
+            argv = utf8Argv.data();
+        }
+    }
+#endif
 
     try
     {
@@ -280,7 +320,9 @@ int main(int argc, char *argv[])
                 else if (option == "--disc-manifest") metadata = std::filesystem::absolute(argv[index]).lexically_normal();
                 else if (option == "--disc-image-sha256") imageHash = argv[index];
                 else metadataHash = argv[index];
+                continue;
             }
+            std::cerr << "[main] ignoring unknown option " << option << std::endl;
         }
         PS2Runtime::setGuestArgs(guestArgs);
         if (!image.empty() || !metadata.empty() || !imageHash.empty() || !metadataHash.empty())
