@@ -23,6 +25,7 @@
 #include <windows.h>
 #else
 #include <sys/stat.h>
+#include <unistd.h>
 #endif
 
 namespace ps2_disc
@@ -145,11 +148,14 @@ namespace ps2_disc
 
         // Hashing a 4 GB image costs seconds per launch. A disc whose file
         // identity (device, inode, size, mtime, ctime) matches an earlier
-        // successful verification is trusted without re-reading it.
+        // successful verification is trusted without re-reading it. This is a
+        // convenience for the player's own machine, not a security boundary:
+        // the file is user-writable and keyed by path and file identity, so a
+        // modified image with restored timestamps would be trusted.
         std::filesystem::path digestCachePath()
         {
 #ifdef _WIN32
-            const char *base = std::getenv("LOCALAPPDATA");
+            const wchar_t *base = _wgetenv(L"LOCALAPPDATA"); // wide: the narrow value loses non-ANSI characters
             return base ? std::filesystem::path(base) / "ga2" / "disc-verify.json" : std::filesystem::path{};
 #else
             if (const char *xdg = std::getenv("XDG_CACHE_HOME"); xdg && *xdg)
@@ -179,6 +185,15 @@ namespace ps2_disc
             catch (const std::exception &) { return false; }
         }
 
+        unsigned long processId()
+        {
+#ifdef _WIN32
+            return GetCurrentProcessId();
+#else
+            return static_cast<unsigned long>(getpid());
+#endif
+        }
+
         void rememberDigest(const std::filesystem::path &image, const Identity &id, std::string_view sha)
         {
             try
@@ -191,9 +206,29 @@ namespace ps2_disc
                 if (!cache.is_object()) cache = nlohmann::json::object();
                 cache[image.string()] = {{"identity", identityJson(id)}, {"sha256", std::string(sha)}};
                 std::filesystem::create_directories(path.parent_path());
-                const auto temp = path.string() + ".tmp";
-                std::ofstream(temp) << cache.dump(1) << '\n';
-                std::filesystem::rename(temp, path);
+                // The launcher writes this file too: a temporary named per
+                // process and call (never shared), renamed over the cache. A
+                // concurrent writer can cost one entry (the next launch hashes
+                // once), not a torn file; a failed write leaves no temporary.
+                static std::atomic<unsigned> counter{0u};
+                auto temp = path;
+                temp += ".tmp" + std::to_string(processId()) + "." + std::to_string(counter++);
+                try
+                {
+                    {
+                        std::ofstream out(temp, std::ios::trunc);
+                        out << cache.dump(1) << '\n';
+                        out.flush();
+                        if (!out) throw std::runtime_error("cannot write the digest cache");
+                    }
+                    std::filesystem::rename(temp, path);
+                }
+                catch (...)
+                {
+                    std::error_code ignored;
+                    std::filesystem::remove(temp, ignored);
+                    throw;
+                }
             }
             catch (const std::exception &) {}
         }
@@ -347,6 +382,9 @@ namespace ps2_disc
             if (!digestFile(manifest, hash, &snapshot) || hash != manifestSha256)
                 throw std::runtime_error("disc metadata digest mismatch");
             const bool cached = cachedDigestMatches(image, before, imageSha256);
+            std::cerr << "[disc mount] " << (cached ? "image digest taken from the verification cache"
+                                                    : "hashing the image (no matching verification cache entry)")
+                      << std::endl;
             if (!cached && (!digestFile(image, hash) || hash != imageSha256))
                 throw std::runtime_error("disc image digest mismatch");
             const auto metadata = nlohmann::json::parse(snapshot);
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
