-            if (c == '\\') { ++slashes; continue; }
-            if (c == '"') q.append(slashes * 2 + 1, '\\');
-            else q.append(slashes, '\\');
-            slashes = 0;
-            q.push_back(c);
-        }
-        q.append(slashes * 2, '\\');
-        q.push_back('"');
-        quoted.push_back(q);
-    }
-    std::vector<const char *> rawQuoted;
-    for (auto &arg : quoted) rawQuoted.push_back(arg.c_str());
-    rawQuoted.push_back(nullptr);
-    _execv(argv.front().c_str(), rawQuoted.data());
-#else
