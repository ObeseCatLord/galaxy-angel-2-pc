+    std::vector<std::string> argv{utf8(target->binary), utf8(target->bootElf)};
     for (size_t i = 0u; i < discs.size(); ++i)
     {
         if (int(i) != boot) continue;
-        argv.insert(argv.end(), {"--disc-image", discs[i].image.string(), "--disc-manifest", discs[i].manifest.string(),
+        argv.insert(argv.end(), {"--disc-image", utf8(discs[i].image), "--disc-manifest", utf8(discs[i].manifest),
                                  "--disc-image-sha256", discs[i].imageSha256,
                                  "--disc-manifest-sha256", discs[i].manifestSha256});
     }
     for (size_t i = 0u; i < discs.size(); ++i)
         if (int(i) != boot)
-            argv.insert(argv.end(), {"--extra-disc", discs[i].image.string(), discs[i].manifest.string(),
+            argv.insert(argv.end(), {"--extra-disc", utf8(discs[i].image), utf8(discs[i].manifest),
                                      discs[i].imageSha256, discs[i].manifestSha256});
     if (const auto &mc = getIoPaths().mcRoot; !mc.empty())
-        argv.insert(argv.end(), {"--mc-root", mc.string()});
+        argv.insert(argv.end(), {"--mc-root", utf8(mc)});
     for (const auto &t : targets)
-        argv.insert(argv.end(), {"--exec-target", t.elfName, t.binary.string(), t.bootElf.string()});
+        argv.insert(argv.end(), {"--exec-target", t.elfName, utf8(t.binary), utf8(t.bootElf)});
     for (const auto &arg : args)
         argv.insert(argv.end(), {"--guest-arg", arg});
     std::cerr << "[exec] handing over to " << target->binary.filename().string() << std::endl;
@@ -1378,12 +1383,18 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
     // included) and keep the new program from inheriting our descriptors
     // (disc images, card files, audio and GPU devices).
     std::fflush(nullptr);
-    // Started by the launcher: hand it the next command line (one argument
-    // per line) and exit with kHandoffExitCode; the launcher runs it and keeps
-    // waiting, which also works on Windows where exec spawns a new process.
-    if (const char *handoff = std::getenv("GA2_HANDOFF_FILE"); handoff && *handoff)
+    // Started by the launcher: hand it the next command line (one UTF-8
+    // argument per line) and exit with kHandoffExitCode; the launcher runs it
+    // and keeps waiting (which also works on Windows, where there is no exec).
+    std::filesystem::path handoffPath;
+#ifdef _WIN32
+    if (const wchar_t *handoff = _wgetenv(L"GA2_HANDOFF_FILE"); handoff && *handoff) handoffPath = handoff;
+#else
+    if (const char *handoff = std::getenv("GA2_HANDOFF_FILE"); handoff && *handoff) handoffPath = handoff;
+#endif
+    if (!handoffPath.empty())
     {
-        std::ofstream out(std::filesystem::path(handoff), std::ios::trunc);
+        std::ofstream out(handoffPath, std::ios::trunc);
         for (const auto &arg : argv)
             out << arg << '\n';
         out.close();
@@ -1392,10 +1403,21 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
             std::fflush(nullptr);
             std::_Exit(kHandoffExitCode);
         }
-        std::cerr << "[exec] cannot write the handoff file " << handoff << std::endl;
+        std::cerr << "[exec] cannot write the handoff file " << utf8(handoffPath) << std::endl;
         return false;
     }
-#ifndef _WIN32
+#ifdef _WIN32
+    // Windows has no exec: _execv starts a second process and returns in this
+    // one, which would leave two engines on one memory card while the guest
+    // saw a failure. The launcher (ga2.exe) does the handoff; without it the
+    // guest gets the error and keeps running.
+    std::cerr << "[exec] a program handoff needs the launcher (GA2_HANDOFF_FILE is not set); "
+                 "start the game through ga2.exe"
+              << std::endl;
+    return false;
+#else
+    // Keep the new program from inheriting our descriptors (disc images, card
+    // files, audio and GPU devices).
     if (DIR *fds = opendir("/proc/self/fd"))
     {
         const int self = dirfd(fds);
@@ -1407,39 +1429,9 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
         }
         closedir(fds);
     }
-#endif
     std::vector<char *> raw;
     for (auto &arg : argv) raw.push_back(arg.data());
     raw.push_back(nullptr);
-#ifdef _WIN32
-    // The CRT joins argv with spaces unquoted; quote like CommandLineToArgvW.
-    std::vector<std::string> quoted;
-    for (const auto &arg : argv)
-    {
-        if (!arg.empty() && arg.find_first_of(" \t\"") == std::string::npos)
