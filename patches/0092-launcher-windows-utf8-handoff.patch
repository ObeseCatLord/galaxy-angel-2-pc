+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -1353,22 +1353,27 @@ bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std
         std::cerr << "[exec] no registered disc holds " << guestPath << std::endl;
