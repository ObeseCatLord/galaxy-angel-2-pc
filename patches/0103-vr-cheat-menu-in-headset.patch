+        // A quad with the menu image: centre c and half height in the model's frame, 4:3.
+        void drawMenuQuad(const M4 &viewProj, const M4 &model, V3 c, float halfHeight)
+        {
+            glDisable(GL_CULL_FACE);
+            glDisable(GL_DEPTH_TEST);
+            glDepthMask(GL_FALSE);
+            glEnable(GL_BLEND);
+            glBlendFuncSeparate(GL_ONE, GL_ONE_MINUS_SRC_ALPHA, GL_ZERO, GL_ONE);
+            glUseProgram(g_gl.menu);
+            setMatrix(g_gl.menu, "mvp", mul(viewProj, model));
+            glActiveTexture(GL_TEXTURE0);
+            glBindTexture(GL_TEXTURE_2D, g_menu.texture);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+            glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+            glUniform1i(glGetUniformLocation(g_gl.menu, "tex"), 0);
+            rect(c, V3{halfHeight * (4.0f / 3.0f), 0, 0}, V3{0, halfHeight, 0}, true); // render textures are bottom-up
+            glDisable(GL_BLEND);
+            glDepthMask(GL_TRUE);
+            glUseProgram(0);
+            glBindVertexArray(0);
+        }
