From 393a5defc91c29f72c6fda823049233fd4d9fdfd Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Tue, 20 Oct 2026 10:26:21 -0500
Subject: [PATCH] mc: card free space and entry space from the host card
 (review 55 E2)

GetInfo's free clusters and GetEntSpace (EE stub and the MCSERV RPC, which
returned constant 1024) are derived from the files on the card: 1 KiB
clusters, data rounded up, directory entries two per cluster. An empty card
still reports its full capacity. ChangePriority stays a success, with the
reason written down: the host serves the card without an MCSERV thread.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 ps2xIOP/include/ps2x/iop/iop_host.h           |  1 +
 ps2xIOP/src/modules/mcserv.cpp                |  6 +-
 .../src/lib/Kernel/Stubs/MemoryCard.cpp       | 75 ++++++++++++++++++-
 ps2xRuntime/src/lib/ps2_iop_host.cpp          |  3 +
 ps2xTest/src/ps2_runtime_io_tests.cpp         | 49 ++++++++++++
 5 files changed, 131 insertions(+), 3 deletions(-)

diff --git a/ps2xIOP/include/ps2x/iop/iop_host.h b/ps2xIOP/include/ps2x/iop/iop_host.h
index cfda7a1..477407b 100644
--- a/ps2xIOP/include/ps2x/iop/iop_host.h
+++ b/ps2xIOP/include/ps2x/iop/iop_host.h
@@ -99,6 +99,7 @@ namespace ps2x::iop
         Format,
         Unformat,
         Mkdir,
+        GetEntSpace,
     };
 
     struct MemoryCardRequest
diff --git a/ps2xIOP/src/modules/mcserv.cpp b/ps2xIOP/src/modules/mcserv.cpp
index fe94d03..ce3116d 100644
--- a/ps2xIOP/src/modules/mcserv.cpp
+++ b/ps2xIOP/src/modules/mcserv.cpp
@@ -305,7 +305,8 @@ namespace ps2x::iop::detail
                                 static_cast<uint32_t>(parameter.flags),
                                 static_cast<uint32_t>(std::max(parameter.maxEntries, 0)), parameter.pointer);
                 case Operation::GetEnt:
-                    return 1024;
+                    // Free directory entries come from the card the host keeps.
+                    return call(MemoryCardOperation::GetEntSpace, port, slot, nameAddress);
                 default:
                     return kDenied;
                 }
@@ -370,6 +371,9 @@ namespace ps2x::iop::detail
                                 static_cast<uint32_t>(parameter.port),
                                 static_cast<uint32_t>(parameter.slot));
                 case Operation::ChangePriority:
+                    // The real call reprioritises the MCSERV server thread. This service is
+                    // served by the host without a thread of its own, so there is nothing whose
+                    // scheduling the request could change; success is the faithful result.
                     return kSucceeded;
                 default:
                     return kDenied;
diff --git a/ps2xRuntime/src/lib/Kernel/Stubs/MemoryCard.cpp b/ps2xRuntime/src/lib/Kernel/Stubs/MemoryCard.cpp
index 26fd612..021315d 100644
--- a/ps2xRuntime/src/lib/Kernel/Stubs/MemoryCard.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Stubs/MemoryCard.cpp
@@ -252,6 +252,43 @@ namespace ps2_stubs
             return resolved.lexically_normal();
         }
 
+        // The host directory is the card. Its occupancy is accounted the way the card
+        // file system allocates: 1 KiB clusters, file data rounded up, and directory
+        // entries (512 bytes each, "." and ".." included) in clusters of their own.
+        int64_t mcDirectoryEntryCount(const std::filesystem::path &dir)
+        {
+            int64_t count = 0;
+            std::error_code ec;
+            for (std::filesystem::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+                ++count;
+            return count;
+        }
+
+        // The root directory's first cluster (its "." and ".." entries) belongs to the
+        // card's fixed overhead, which kMcFreeClusters already excludes.
+        int64_t mcUsedClusters(const std::filesystem::path &dir, int depth = 0)
+        {
+            int64_t clusters = (mcDirectoryEntryCount(dir) + 2 + 1) / 2 - (depth == 0 ? 1 : 0);
+            if (depth > 16)
+                return clusters;
+            std::error_code ec;
+            for (std::filesystem::directory_iterator it(dir, ec), end; !ec && it != end; it.increment(ec))
+            {
+                std::error_code entryEc;
+                if (it->is_directory(entryEc))
+                    clusters += mcUsedClusters(it->path(), depth + 1);
+                else if (const auto size = it->file_size(entryEc); !entryEc)
+                    clusters += static_cast<int64_t>((size + 1023u) / 1024u);
+            }
+            return clusters;
+        }
+
+        int32_t mcFreeClustersLocked(int32_t port)
+        {
+            const int64_t used = mcUsedClusters(getMcRootPath(port));
+            return static_cast<int32_t>(std::max<int64_t>(0, static_cast<int64_t>(kMcFreeClusters) - used));
+        }
+
         // Card entries carry the console clock, which on a Japanese PS2 (and in
         // the CDVD RTC this runtime reports) is JST: UTC+9, no DST.
         bool consoleTimeMc(const std::time_t *value, std::tm *out)
@@ -529,6 +566,8 @@ namespace ps2_stubs
 
     void sceMcChangeThreadPriority(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
+        // Reprioritises MCSERV's IOP thread on hardware. The host serves the card
+        // without such a thread, so there is no scheduling to change.
         setReturnS32(ctx, 0);
     }
 
@@ -867,10 +906,42 @@ namespace ps2_stubs
 
     void sceMcGetEntSpace(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
     {
+        const int32_t port = static_cast<int32_t>(getRegU32(ctx, 4));
+        const int32_t slot = static_cast<int32_t>(getRegU32(ctx, 5));
+        const uint32_t pathAddr = getRegU32(ctx, 6);
+        const std::string rawPath =
+            (pathAddr != 0u) ? readPs2CStringBounded(rdram, pathAddr, kMcMaxPathLen) : std::string{};
+
+        int32_t result = kMcResultNoEntry;
         {
             std::lock_guard<std::mutex> lock(g_mcStateMutex);
-            setMcCommandResultLocked(kMcCmdGetEntSpace, 1024);
+            if (isValidMcPortSlot(port, slot))
+            {
+                if (!g_mcPorts[static_cast<size_t>(port)].formatted)
+                {
+                    result = kMcResultNoFormat;
+                }
+                else
+                {
+                    ensureMcRootExists(port);
+                    const std::string guestDir = normalizeGuestMcPathLocked(port, rawPath.empty() ? "." : rawPath);
+                    const std::filesystem::path hostDir = guestMcPathToHostPath(port, guestDir);
+                    std::error_code ec;
+                    if (std::filesystem::is_directory(hostDir, ec) && !ec)
+                    {
+                        // Entries are 512 bytes, two per 1 KiB cluster, so a directory holding an
+                        // odd number of entries (counting "." and "..") has one free slot before it
+                        // needs another cluster, and every free cluster adds two more.
+                        const int64_t entries = mcDirectoryEntryCount(hostDir) + 2;
+                        const int64_t slack = entries % 2;
+                        const int64_t space = slack + 2 * static_cast<int64_t>(mcFreeClustersLocked(port));
+                        result = static_cast<int32_t>(std::min<int64_t>(space, INT32_MAX));
+                    }
+                }
+            }
+            setMcCommandResultLocked(kMcCmdGetEntSpace, result);
         }
+        RUNTIME_LOG("[MC] GetEntSpace port=" << port << " '" << rawPath << "' -> " << result);
         setReturnS32(ctx, 0);
     }
 
@@ -893,7 +964,7 @@ namespace ps2_stubs
             {
                 McPortState &state = g_mcPorts[static_cast<size_t>(port)];
                 cardType = kMcTypePs2;
-                freeBlocks = state.formatted ? kMcFreeClusters : 0;
+                freeBlocks = state.formatted ? mcFreeClustersLocked(port) : 0;
                 format = state.formatted ? kMcFormatted : kMcUnformatted;
                 result = state.formatted ? kMcResultSucceed : kMcResultNoFormat;
             }
diff --git a/ps2xRuntime/src/lib/ps2_iop_host.cpp b/ps2xRuntime/src/lib/ps2_iop_host.cpp
index f8dcff9..91caac2 100644
--- a/ps2xRuntime/src/lib/ps2_iop_host.cpp
+++ b/ps2xRuntime/src/lib/ps2_iop_host.cpp
@@ -850,6 +850,9 @@ int32_t PS2IopHostAdapter::memoryCard(const ps2x::iop::MemoryCardRequest &reques
     case ps2x::iop::MemoryCardOperation::Mkdir:
         handler = ps2_stubs::sceMcMkdir;
         break;
+    case ps2x::iop::MemoryCardOperation::GetEntSpace:
+        handler = ps2_stubs::sceMcGetEntSpace;
+        break;
     }
     if (!handler)
     {
diff --git a/ps2xTest/src/ps2_runtime_io_tests.cpp b/ps2xTest/src/ps2_runtime_io_tests.cpp
index bedcae3..1ce99df 100644
--- a/ps2xTest/src/ps2_runtime_io_tests.cpp
+++ b/ps2xTest/src/ps2_runtime_io_tests.cpp
@@ -627,6 +627,55 @@ void register_ps2_runtime_io_tests()
             t.Equals(readGuestS32(test.rdram.data(), formatAddr), 0, "sceMcGetInfo should report an unformatted card after sceMcUnformat");
         });
 
+        tc.Run("card free space and entry space follow the files on the card", [](TestCase &t)
+        {
+            TestContext test;
+            constexpr uint32_t typeAddr = GUEST_BUFFER_AREA_START + 0x900;
+            constexpr uint32_t freeAddr = GUEST_BUFFER_AREA_START + 0x904;
+            constexpr uint32_t formatAddr = GUEST_BUFFER_AREA_START + 0x908;
+            constexpr uint32_t pathAddr = GUEST_STRING_AREA_START + 0xB40;
+            int32_t cmd = 0;
+            const auto freeClusters = [&]()
+            {
+                clearContext(test.ctx);
+                setRegU32(test.ctx, 4, 0u);
+                setRegU32(test.ctx, 5, 0u);
+                setRegU32(test.ctx, 6, typeAddr);
+                setRegU32(test.ctx, 7, freeAddr);
+                setRegU32(test.ctx, 8, formatAddr);
+                ps2_stubs::sceMcGetInfo(test.rdram.data(), &test.ctx, nullptr);
+                (void)syncMc(test.rdram, &cmd);
+                return readGuestS32(test.rdram.data(), freeAddr);
+            };
+            const auto entrySpace = [&](const char *path)
+            {
+                writeGuestString(test.rdram.data(), pathAddr, path);
+                clearContext(test.ctx);
+                setRegU32(test.ctx, 4, 0u);
+                setRegU32(test.ctx, 5, 0u);
+                setRegU32(test.ctx, 6, pathAddr);
+                ps2_stubs::sceMcGetEntSpace(test.rdram.data(), &test.ctx, nullptr);
+                return syncMc(test.rdram, &cmd);
+            };
+
+            const int32_t empty = freeClusters();
+            t.Equals(empty, 0x2000, "an empty card reports its full capacity");
+            const int32_t emptyEntries = entrySpace("/");
+            t.IsTrue(emptyEntries > 0, "an empty card has room for entries");
+
+            std::filesystem::create_directories(test.paths.mcRoot / "SAVEDATA");
+            {
+                std::ofstream out(test.paths.mcRoot / "SAVEDATA" / "game.dat", std::ios::binary);
+                const std::string block(10u * 1024u + 1u, 'x'); // 11 clusters
+                out.write(block.data(), static_cast<std::streamsize>(block.size()));
+            }
+            const int32_t used = freeClusters();
+            t.IsTrue(used <= empty - 11, "file data (rounded up to clusters) is taken from the free space");
+            t.IsTrue(entrySpace("/SAVEDATA") > 0, "a directory with room reports free entries");
+            t.IsTrue(entrySpace("/SAVEDATA") <= 2 * used + 1, "free entries cannot exceed what the free clusters hold");
+            t.Equals(entrySpace("/NOSUCHDIR"), -4, "a directory that does not exist has no entry space");
+        });
+
         tc.Run("sceMcEnd resets libmc state so sync reports no active command", [](TestCase &t)
         {
             TestContext test;
