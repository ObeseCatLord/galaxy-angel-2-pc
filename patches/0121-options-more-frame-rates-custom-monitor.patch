-            if (rate < 1)
+            // GA2_FPS: "monitor", or a rate (the engine rounds it): 60 or less is the PS2 rate, 61..240 a choice or the
+            // custom number, anything else is not a rate (the engine falls back to the PS2 rate).
+            if (text == "monitor")
