diff --git a/ps2xRuntime/include/runtime/ga2_menu_select.h b/ps2xRuntime/include/runtime/ga2_menu_select.h
new file mode 100644
index 0000000..0f6e404
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_menu_select.h
@@ -0,0 +1,72 @@
+// Which item of a menu is shown as selected, shared by the launcher and the in-game menus (F1 cheats, F2 settings).
+// Nothing is highlighted unless
+//   - the mouse pointer is over an item (that item, while hovered), or
+//   - the keyboard / controller chose an item (that one, until the mouse moves or clicks again).
+// Up/Down with nothing chosen picks the item last hovered or chosen, or the first. Keys that act on the item (confirm,
+// Left/Right) use keySelection() only, which is -1 while the mouse is in charge; clicks act on the hovered item.
+#pragma once
+
+namespace ga2_menu
+{
+    class Selector
+    {
+    public:
+        // Once per frame, before the keys are read. `hovered`: the item under the pointer (-1: none); `pointerMoved`
+        // and `clicked` hand the control back to the mouse.
+        void begin(int hovered, bool pointerMoved, bool clicked)
+        {
+            m_hover = hovered;
+            if (pointerMoved || clicked)
+                m_keyboard = false;
+            if (!m_keyboard && m_hover >= 0)
+                m_last = m_hover;
+        }
+
+        // Up / Down (delta -1 / +1) over `count` items. Taking the control from the mouse does not move further when
+        // nothing was hovered: the first press only shows where the selection is.
+        void move(int delta, int count)
+        {
+            if (count <= 0)
+                return;
+            if (!m_keyboard)
+            {
+                m_keyboard = true;
+                if (m_hover >= 0 && m_hover < count)
+                    m_sel = m_hover;
+                else
+                {
+                    m_sel = m_last >= 0 && m_last < count ? m_last : 0;
+                    m_last = m_sel;
+                    return;
+                }
+            }
+            m_sel = (m_sel + delta % count + count) % count;
+            m_last = m_sel;
+        }
+
+        // Home / End, or any key that picks `item` (digits typed on a hovered row).
+        void adopt(int item)
+        {
+            m_keyboard = true;
+            m_sel = item;
+            m_last = item;
+        }
+
+        // The item to highlight (-1: none).
+        int shown() const { return m_keyboard ? m_sel : m_hover; }
+        // The item keys act on (-1: the mouse is in charge).
+        int keySelection() const { return m_keyboard ? m_sel : -1; }
+        int hovered() const { return m_hover; }
+        bool keyboard() const { return m_keyboard; }
+        // The menu was opened or closed: nothing chosen by keys; the last item is remembered for Up / Down.
+        void release()
+        {
+            m_keyboard = false;
+            m_hover = -1;
+        }
+
+    private:
+        int m_sel = 0, m_last = -1, m_hover = -1;
+        bool m_keyboard = false;
+    };
+}
