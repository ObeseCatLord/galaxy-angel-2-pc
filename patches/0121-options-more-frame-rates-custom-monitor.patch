+    // ---- the editable number ----
+
+    inline bool hasCustom(const Option &o) { return o.customChoice >= 0; }
+
+    // The index of the choice with this stored value; -1 when there is none.
+    inline int choiceIndex(size_t option, const char *value)
+    {
+        const Option &o = options()[option];
+        for (size_t c = 0; c < o.choices.size(); ++c)
+            if (std::string(o.choices[c].value) == value)
+                return int(c);
+        return -1;
+    }
+
+    // Plain decimal digits only (no sign, no spaces), at most five of them.
+    inline bool parseWhole(const std::string &text, int &out)
+    {
+        if (text.empty() || text.size() > 5)
+            return false;
+        int n = 0;
+        for (char ch : text)
+        {
+            if (ch < '0' || ch > '9')
+                return false;
+            n = n * 10 + (ch - '0');
+        }
+        out = n;
+        return true;
+    }
+
+    inline int clampCustom(const Option &o, int number)
+    {
+        return number < o.customMin ? o.customMin : number > o.customMax ? o.customMax : number;
+    }
+
+    // The number a choice's value stands for when it is one (the frame rate presets); `fallback` otherwise.
+    inline int choiceNumber(const Option &o, int choice, int fallback)
+    {
+        int n = 0;
+        if (choice >= 0 && choice < int(o.choices.size()) && choice != o.customChoice && parseWhole(o.choices[size_t(choice)].value, n) &&
+            n >= o.customMin && n <= o.customMax)
+            return n;
+        return fallback;
+    }
+
+    // The number to start from when `to` is the custom choice and `from` the one before: a preset's own number
+    // (stepping from 144 to Custom shows 144), else what the custom number was.
+    inline int carryNumber(const Option &o, int from, int to, int number)
+    {
+        if (to == o.customChoice && from != o.customChoice)
+            return choiceNumber(o, from, number);
+        return number;
+    }
+
+    // What settings.ini stores for a state: the custom choice stores its number, the others their value.
+    inline std::string storedValue(size_t option, int choice, int number)
+    {
+        const Option &o = options()[option];
+        if (choice == o.customChoice)
+            return std::to_string(clampCustom(o, number));
+        return o.choices[size_t(choice)].value;
+    }
+
+    // The state a stored value stands for. A value that is one choice's value is that choice; otherwise a whole number
+    // in the custom range is the custom choice with that number. False for anything else (the state is left alone).
+    inline bool parseStored(size_t option, const std::string &text, int &choice, int &number)
+    {
+        const Option &o = options()[option];
+        for (size_t c = 0; c < o.choices.size(); ++c)
+            if (int(c) != o.customChoice && text == o.choices[c].value)
+            {
+                choice = int(c);
+                return true;
+            }
+        int n = 0;
+        if (hasCustom(o) && parseWhole(text, n) && n >= o.customMin && n <= o.customMax)
+        {
+            choice = o.customChoice;
+            number = n;
+            return true;
+        }
+        return false;
+    }
+
+    // The text a menu shows for a state ("Custom: 173" for the custom choice).
+    inline std::string choiceLabel(size_t option, int choice, int number)
+    {
+        const Option &o = options()[option];
+        if (choice == o.customChoice)
+            return std::string(o.choices[size_t(choice)].label) + ": " + std::to_string(clampCustom(o, number));
+        return o.choices[size_t(choice)].label;
+    }
+
     // The environment text for a choice. `dumpDir` is where the texture dump
     // goes when it is on.
-    inline std::string envValue(size_t option, int choice, const std::string &dumpDir)
