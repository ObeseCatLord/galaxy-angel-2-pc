+    bool mount(const std::filesystem::path &image, const std::filesystem::path &manifest,
+               std::string_view imageSha256, std::string_view manifestSha256, std::string &error)
+    {
+        // Failure retires previously verified metadata, including same-path remounts.
+        invalidate();
+        uint64_t startGeneration;
+        { std::lock_guard lock(mutex); mode = Mode::NeedsVerification; startGeneration = mountGeneration; }
+        error.clear();
+        try
+        {
+            const auto configured = PS2Runtime::getIoPaths().cdImage;
+            if (image.empty() || image.lexically_normal() != configured.lexically_normal())
+                throw std::runtime_error("disc metadata image does not match configured mount");
+            Disc disc = loadDisc(image, manifest, imageSha256, manifestSha256);
             std::lock_guard lock(mutex);
             if (mountGeneration != startGeneration || PS2Runtime::getIoPaths().cdImage != configured)
                 throw std::runtime_error("disc mount changed during validation");
-            verifiedImage = configured; verifiedIdentity = after;
-            mode = Mode::Verified; files = std::move(pending);
+            verifiedImage = configured; verifiedIdentity = disc.identity;
+            mode = Mode::Verified; files = std::move(disc.files);
+            discs.clear(); currentDisc = 0u;
+            discs.push_back(Disc{configured, verifiedIdentity, {}, disc.info});
             return true;
         }
         catch (const std::exception &failure)
         { error = failure.what(); return false; }
     }
 
-    bool findFile(std::string_view guestPath, File &file)
+    bool addDisc(const std::filesystem::path &image, const std::filesystem::path &manifest,
+                 std::string_view imageSha256, std::string_view manifestSha256, std::string &error)
+    {
+        error.clear();
+        uint64_t startGeneration;
+        {
+            std::lock_guard lock(mutex);
+            if (mode != Mode::Verified || discs.empty())
+            { error = "the boot disc must be mounted first"; return false; }
+            startGeneration = mountGeneration;
+        }
+        try
+        {
+            Disc disc = loadDisc(image, manifest, imageSha256, manifestSha256);
+            std::lock_guard lock(mutex);
+            if (mountGeneration != startGeneration)
+                throw std::runtime_error("disc mount changed during validation");
+            for (const auto &known : discs)
+                if (known.image == disc.image) return true;
+            discs.push_back(std::move(disc));
+            return true;
+        }
+        catch (const std::exception &failure)
+        { error = failure.what(); return false; }
+    }
+
+    std::filesystem::path currentImage()
+    {
+        std::lock_guard lock(mutex);
+        return discs.empty() ? PS2Runtime::getIoPaths().cdImage : verifiedImage;
+    }
+
+    std::vector<DiscInfo> registeredDiscs()
+    {
+        std::lock_guard lock(mutex);
+        std::vector<DiscInfo> out;
+        for (const auto &disc : discs) out.push_back(disc.info);
+        return out;
+    }
+
+    int discHolding(std::string_view guestPath)
+    {
+        const std::string key = pathKey(guestPath);
+        std::lock_guard lock(mutex);
+        for (size_t index = 0u; index < discs.size(); ++index)
+        {
+            const auto &table = index == currentDisc ? files : discs[index].files;
+            if (table.count(key)) return static_cast<int>(index);
+        }
+        return -1;
+    }
+
+    void armChanger()
+    {
+        std::lock_guard lock(mutex);
+        if (!changerArmedLocked()) trayPolls = 0u;
+        changerArmedAt = std::chrono::steady_clock::now();
+    }
+
+    bool trayOpenNow()
+    {
+        std::lock_guard lock(mutex);
+        // A disc-change scene resets its tray flags on entry, so keep cycling:
+        // open for one status poll, then closed for 29.
+        return changerArmedLocked() && trayPolls++ % 30u == 0u;
+    }
+
+    bool findFile(std::string_view guestPath, File &file, std::filesystem::path *image)
     {
         const std::string key = pathKey(guestPath);
         std::lock_guard lock(mutex);
         refreshIdentityLocked();
         if (verifiedImage.empty() || mode != Mode::Verified) return false;
-        const auto entry = files.find(key);
-        if (entry == files.end()) return false;
-        file = entry->second;
-        return true;
+        if (const auto entry = files.find(key); entry != files.end())
+        {
+            file = entry->second;
+            if (image) *image = verifiedImage;
+            return true;
+        }
+        if (discs.size() < 2u || !changerArmedLocked()) return false;
+        // The game is asking for a disc it does not see: insert the registered
+        // disc that has the file (boot disc first, then registration order).
+        for (size_t index = 0u; index < discs.size(); ++index)
+        {
+            if (index == currentDisc) continue;
+            const auto entry = discs[index].files.find(key);
+            if (entry == discs[index].files.end()) continue;
+            file = entry->second;
+            selectDiscLocked(index);
+            if (image) *image = verifiedImage;
+            std::fprintf(stderr, "[disc] changer: inserted %s (for %s)\n",
+                         verifiedImage.filename().string().c_str(), key.c_str());
+            return true;
+        }
+        return false;
     }
 }
