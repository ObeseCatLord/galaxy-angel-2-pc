+
+bool PS2Runtime::loadExecPS2(const std::string &guestPath, const std::vector<std::string> &args)
+{
+    // "cdrom0:\SLPM_667.79;1" -> "SLPM_667.79"
+    std::string leaf = guestPath.substr(guestPath.find_last_of("\\/:") + 1u);
+    leaf = leaf.substr(0u, leaf.find(';'));
+    std::transform(leaf.begin(), leaf.end(), leaf.begin(), [](unsigned char c) { return char(std::toupper(c)); });
+    const auto &targets = execTargets();
+    const auto target = std::find_if(targets.begin(), targets.end(),
+                                     [&](const ExecTarget &t) { return t.elfName == leaf; });
+    std::cerr << "[exec] LoadExecPS2 " << guestPath;
+    for (const auto &arg : args) std::cerr << ' ' << arg;
+    std::cerr << std::endl;
+    if (target == targets.end())
+    {
+        std::cerr << "[exec] no native binary registered for " << leaf << std::endl;
+        return false;
+    }
+    // The disc holding the program boots; the rest of the set comes along.
+    const auto discs = ps2_disc::registeredDiscs();
+    const int boot = ps2_disc::discHolding(guestPath);
+    std::vector<std::string> argv{target->binary.string(), target->bootElf.string()};
+    for (size_t i = 0u; i < discs.size(); ++i)
+    {
+        if (int(i) != boot) continue;
+        argv.insert(argv.end(), {"--disc-image", discs[i].image.string(), "--disc-manifest", discs[i].manifest.string(),
+                                 "--disc-image-sha256", discs[i].imageSha256,
+                                 "--disc-manifest-sha256", discs[i].manifestSha256});
+    }
+    for (size_t i = 0u; i < discs.size(); ++i)
+        if (int(i) != boot)
+            argv.insert(argv.end(), {"--extra-disc", discs[i].image.string(), discs[i].manifest.string(),
+                                     discs[i].imageSha256, discs[i].manifestSha256});
+    if (const auto &mc = getIoPaths().mcRoot; !mc.empty())
+        argv.insert(argv.end(), {"--mc-root", mc.string()});
+    for (const auto &t : targets)
+        argv.insert(argv.end(), {"--exec-target", t.elfName, t.binary.string(), t.bootElf.string()});
+    for (const auto &arg : args)
+        argv.insert(argv.end(), {"--guest-arg", arg});
+    std::cerr << "[exec] handing over to " << target->binary.filename().string() << std::endl;
+    std::cout.flush();
+    std::cerr.flush();
+    std::vector<char *> raw;
+    for (auto &arg : argv) raw.push_back(arg.data());
+    raw.push_back(nullptr);
+#ifdef _WIN32
+    _execv(raw[0], raw.data());
+#else
+    execv(raw[0], raw.data());
+#endif
+    std::cerr << "[exec] exec failed: " << std::strerror(errno) << std::endl;
+    return false;
+}
