diff --git a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
index a345c4b..60c6357 100644
--- a/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
+++ b/ps2xRuntime/src/lib/Kernel/Syscalls/System.cpp
@@ -533,6 +533,23 @@ namespace ps2_syscalls
         }
 
         scheduler.setupCurrentThread(initialStack, stackSize, getRegU32(ctx, 28));
+        // crt0's argument block: { int argc; char *argv[16]; char text[256]; }.
+        if (const uint32_t argsAddress = getRegU32(ctx, 7) & 0x1FFFFFFu;
+            argsAddress != 0u && argsAddress + 0x144u <= PS2_RAM_SIZE)
+        {
+            uint8_t *block = rdram + argsAddress;
+            uint32_t argc = 0u, text = 0x44u;
+            for (const std::string &arg : PS2Runtime::guestArgs())
+            {
+                if (argc == 16u || text + arg.size() + 1u > 0x144u) break;
+                const uint32_t pointer = argsAddress + text;
+                std::memcpy(block + 4u + 4u * argc, &pointer, 4u);
+                std::memcpy(block + text, arg.c_str(), arg.size() + 1u);
+                text += static_cast<uint32_t>(arg.size()) + 1u;
+                ++argc;
+            }
+            std::memcpy(block, &argc, 4u);
+        }
         setReturnU32(ctx, sp);
     }
 
