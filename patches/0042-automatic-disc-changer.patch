+        // Hashing a 4 GB image costs seconds per launch. A disc whose file
+        // identity (device, inode, size, mtime, ctime) matches an earlier
+        // successful verification is trusted without re-reading it.
+        std::filesystem::path digestCachePath()
+        {
+#ifdef _WIN32
+            const char *base = std::getenv("LOCALAPPDATA");
+            return base ? std::filesystem::path(base) / "ga2" / "disc-verify.json" : std::filesystem::path{};
+#else
+            if (const char *xdg = std::getenv("XDG_CACHE_HOME"); xdg && *xdg)
+                return std::filesystem::path(xdg) / "ga2" / "disc-verify.json";
+            const char *home = std::getenv("HOME");
+            return home ? std::filesystem::path(home) / ".cache" / "ga2" / "disc-verify.json" : std::filesystem::path{};
+#endif
+        }
+
+        nlohmann::json identityJson(const Identity &id)
+        {
+            return nlohmann::json::array({id.device, id.file, id.size, id.modified, id.changed,
+                                          id.modifiedFraction, id.changedFraction});
+        }
+
+        bool cachedDigestMatches(const std::filesystem::path &image, const Identity &id, std::string_view sha)
+        {
+            try
+            {
+                std::ifstream in(digestCachePath());
+                if (!in) return false;
+                const auto cache = nlohmann::json::parse(in);
+                const auto entry = cache.find(image.string());
+                return entry != cache.end() && entry->at("identity") == identityJson(id) &&
+                       entry->at("sha256").get<std::string>() == sha;
+            }
+            catch (const std::exception &) { return false; }
+        }
+
+        void rememberDigest(const std::filesystem::path &image, const Identity &id, std::string_view sha)
+        {
+            try
+            {
+                const auto path = digestCachePath();
+                if (path.empty()) return;
+                nlohmann::json cache = nlohmann::json::object();
+                if (std::ifstream in(path); in)
+                    cache = nlohmann::json::parse(in, nullptr, false);
+                if (!cache.is_object()) cache = nlohmann::json::object();
+                cache[image.string()] = {{"identity", identityJson(id)}, {"sha256", std::string(sha)}};
+                std::filesystem::create_directories(path.parent_path());
+                const auto temp = path.string() + ".tmp";
+                std::ofstream(temp) << cache.dump(1) << '\n';
+                std::filesystem::rename(temp, path);
+            }
+            catch (const std::exception &) {}
+        }
+
+        bool changerArmedLocked()
+        {
+            return std::chrono::steady_clock::now() - changerArmedAt < kChangerHold;
+        }
