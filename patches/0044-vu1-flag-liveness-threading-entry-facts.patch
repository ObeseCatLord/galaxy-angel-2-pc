 }
 
-__attribute__((always_inline)) inline void VU1Interpreter::applyFmacDest(float *dst, float *result, uint8_t dest, uint32_t upper)
+// flagMode (kFlagMac | kFlagStatus) says which flag results a later
+// instruction can observe; the generator clears bits it proves dead. Result
+// values are computed identically either way.
+__attribute__((always_inline)) inline void VU1Interpreter::produceFmacFlags(float *result, uint8_t dest, uint32_t upper,
+                                                                          uint8_t flagMode)
 {
     uint8_t laneFlags[4]{};
-    normalizeFmacResult(result, dest, upper, laneFlags);
-    updateFmacFlags(laneFlags, dest, calculateFmacProductSticky(upper, dest));
+    normalizeFmacResult(result, dest, upper, laneFlags, flagMode != 0u);
+    if (flagMode == kFlagAll)
+        updateFmacFlags(laneFlags, dest, calculateFmacProductSticky(upper, dest));
+    else if (flagMode == kFlagMac)
+        updateFmacFlags(laneFlags, dest, 0u, false);
+    else if (flagMode == kFlagStatus)
+        updateFmacFlags(laneFlags, dest, calculateFmacProductSticky(upper, dest), true, false);
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::applyFmacDest(float *dst, float *result, uint8_t dest, uint32_t upper,
+                                                                       uint8_t flagMode)
+{
+    produceFmacFlags(result, dest, upper, flagMode);
     applyDest(dst, result, dest);
 }
 
