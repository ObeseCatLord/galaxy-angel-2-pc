     if (dest == 0u)
         return;
@@ -428,23 +461,37 @@ __attribute__((always_inline)) inline void VU1Interpreter::updateFmacFlags(const
     entry->mac = mac;
     entry->status = status;
     entry->extraSticky = extraSticky;
