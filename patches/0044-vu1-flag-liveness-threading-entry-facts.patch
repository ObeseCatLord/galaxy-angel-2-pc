+// Accumulating instructions (MADD/MSUB/OPMSUB and their ACC, Q and I forms)
+// round twice in float, so their value and flags need the exact result.
+__attribute__((always_inline)) inline bool VU1Interpreter::isFmacProductSum(uint32_t upper)
+{
+    const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+    const uint8_t special = op >= 0x3Cu ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : 0xFFu;
+    return (op >= 0x08u && op <= 0x0Fu) ||
+           op == 0x21u || op == 0x23u || op == 0x25u || op == 0x27u ||
+           op == 0x29u || op == 0x2Du || op == 0x2Eu ||
+           (special >= 0x08u && special <= 0x0Fu) ||
+           special == 0x21u || special == 0x23u || special == 0x25u ||
+           special == 0x27u || special == 0x29u || special == 0x2Du;
+}
+
 __attribute__((always_inline)) inline void VU1Interpreter::normalizeFmacResult(float *result, uint8_t dest, uint32_t upper,
-                                         uint8_t laneFlags[4])
+                                         uint8_t laneFlags[4], bool flagsNeeded)
 {
+    const bool productSum = isFmacProductSum(upper);
     for (uint32_t component = 0; component < 4u; ++component)
     {
         laneFlags[component] = 0u;
         if ((dest & laneForComponent(component)) == 0u)
             continue;
 
+        if (!productSum)
+        {
+            // One rounding toward zero from normalized operands: the float
+            // result classifies exactly like the exact one, except that 0
+            // hides exact zero vs underflow and FLT_MAX hides overflow; those
+            // differ only in flags, never in the value.
+            uint32_t bits = 0u;
+            std::memcpy(&bits, &result[component], sizeof(bits));
+            const uint32_t magnitude = bits & 0x7FFFFFFFu;
+            if (!flagsNeeded || (magnitude != 0u && magnitude != 0x7F7FFFFFu))
+            {
+                uint32_t flags = 0u;
+                result[component] = normalizeResult(result[component], flags);
+                laneFlags[component] = static_cast<uint8_t>(flags);
+                continue;
+            }
+        }
+
         // float*float is exact in double and every flag threshold except
         // FLT_MAX classifies identically under round-to-zero, so double is
         // used unless the double result sits exactly on FLT_MAX.
@@ -390,7 +423,7 @@ __attribute__((always_inline)) inline uint32_t VU1Interpreter::calculateFmacProd
 }
 
 __attribute__((always_inline)) inline void VU1Interpreter::updateFmacFlags(const uint8_t laneFlags[4], uint8_t dest,
