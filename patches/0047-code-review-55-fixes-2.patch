-        uint64_t expected = csr.load();
-        uint64_t desired;
-        do
-        {
-            desired = (expected & kW1cMask) | (value & ~kW1cMask);
-            desired &= ~(value & kW1cMask);
-        } while (!csr.compare_exchange_weak(expected, desired));
