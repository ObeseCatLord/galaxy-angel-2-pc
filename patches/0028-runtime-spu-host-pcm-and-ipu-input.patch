+// PRIVATE OBSERVER: bytes submitted by the existing single PCM producer.
+// Called with existing m_mutex held. No audio-thread I/O, clock adjustment,
+// playback replacement, or modification of the original queue return value.
+namespace {
+struct PrivatePcmObservation {
+    FILE* raw = nullptr;
+    FILE* rows = nullptr;
+    uint64_t frames = 0, calls = 0, failed = 0, next_row = 48000;
+    bool disabled = false;
+    std::chrono::steady_clock::time_point origin = std::chrono::steady_clock::now();
+    PrivatePcmObservation() {
+        const char* folder = std::getenv("GA2_PRIVATE_PCM_OBSERVATION");
+        if (!folder || !*folder) { disabled = true; return; }
+        std::string prefix(folder);
+        // Exclusive creation: never overwrite a previous/private user file.
+        raw = std::fopen((prefix + "/producer-pcm.s16le").c_str(), "wbx");
+        rows = std::fopen((prefix + "/producer-rows.csv").c_str(), "wx");
+        if (!raw || !rows) { disabled = true; std::fprintf(stderr,"[private PCM observer] exclusive open failed\n"); return; }
+        std::fprintf(rows,"host_seconds,submitted_frames,calls,failed_submission_calls,raw_bytes\n");
+        std::fflush(rows);
+    }
+    ~PrivatePcmObservation() { if (raw) std::fclose(raw); if (rows) std::fclose(rows); }
+    bool record(std::span<const int16_t> samples, bool result) noexcept {
+        if (disabled) return result;
+        if (samples.size()/2 > 32000000 - frames) {
+            disabled = true; std::fprintf(stderr,"[private PCM observer] 32M frame cap reached\n"); return result;
+        }
+        const size_t written = std::fwrite(samples.data(), sizeof(int16_t), samples.size(), raw);
+        if (written != samples.size()) {
+            disabled = true; std::fprintf(stderr,"[private PCM observer] raw write failed\n"); return result;
+        }
+        frames += samples.size()/2; ++calls; failed += !result;
+        // Retain a bounded prefix even if the owned game is terminated.
+        if (calls%1024 == 0 && std::fflush(raw)) {
+            disabled = true; std::fprintf(stderr,"[private PCM observer] raw flush failed\n"); return result;
+        }
+        if (frames >= next_row) {
+            const double elapsed = std::chrono::duration<double>(std::chrono::steady_clock::now()-origin).count();
+            if (std::fflush(raw) || std::fprintf(rows,"%.9f,%llu,%llu,%llu,%llu\n",elapsed,
+                (unsigned long long)frames,(unsigned long long)calls,
+                (unsigned long long)failed,(unsigned long long)(frames*4)) < 0 || std::fflush(rows)) {
+                disabled = true; std::fprintf(stderr,"[private PCM observer] row write failed\n"); return result;
+            }
+            next_row = frames + 48000;
+        }
+        return result;
+    }
+};
+PrivatePcmObservation& privatePcmObservation() { static PrivatePcmObservation observation; return observation; }
+}
