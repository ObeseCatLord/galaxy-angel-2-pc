+    static std::mutex callbackMutex;
+    static Impl *callbackOwner;
+    static void pcmCallback(void *buffer, unsigned int frames)
+    {
+        auto output = std::span<int16_t>(static_cast<int16_t *>(buffer), size_t(frames) * 2u);
+        std::lock_guard lock(callbackMutex);
+        if (callbackOwner) callbackOwner->pcm.consume(output);
+        else std::fill(output.begin(), output.end(), int16_t{});
+    }
+    void closePcm()
+    {
+#if !defined(PLATFORM_VITA)
+        // Raylib callback executes under its audio lock. Detachment waits for
+        // it before clearing ownership. Never hold callbackMutex in raylib.
+        if (pcmStarted) SetAudioStreamCallback(pcmStream, nullptr);
+        {
+            std::lock_guard lock(callbackMutex);
+            if (callbackOwner == this) callbackOwner = nullptr;
+            pcm.clear();
+        }
+        if (pcmStarted) { StopAudioStream(pcmStream); UnloadAudioStream(pcmStream); }
+        pcmStarted = false; pcmStream = {};
+#endif
+    }
 };
 
+std::mutex PS2AudioBackend::Impl::callbackMutex;
+PS2AudioBackend::Impl *PS2AudioBackend::Impl::callbackOwner = nullptr;
+
+bool PS2AudioBackend::submitSpuPcm(std::span<const int16_t> samples, uint32_t sampleRate)
+{
+#if defined(PLATFORM_VITA)
+    (void)samples; (void)sampleRate;
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    if (!m_audioReady || sampleRate != 48000 || samples.size() % 2u ||
+        samples.size() / 2u > SpuPcmQueue::CapacityFrames) return false;
+    if (samples.empty()) return true;
+    auto observe = [&](bool result) noexcept {
+        try { return privatePcmObservation().record(samples, result); }
+        catch (...) { std::fprintf(stderr,"[private PCM observer] initialization failed\n"); return result; }
+    };
+    if (!m_impl->pcmStarted)
+    {
+        bool initialPushSucceeded = true;
+        {
+            std::lock_guard callbackLock(Impl::callbackMutex);
+            if (Impl::callbackOwner && Impl::callbackOwner != m_impl.get()) initialPushSucceeded = false;
+            else {
+                Impl::callbackOwner = m_impl.get();
+                if (!m_impl->pcm.push(samples)) { Impl::callbackOwner = nullptr; initialPushSucceeded = false; }
+            }
+        }
+        if (!initialPushSucceeded) return observe(false);
+        m_impl->pcmStream = LoadAudioStream(48000, 16, 2);
+        if (!IsAudioStreamValid(m_impl->pcmStream)) { m_impl->closePcm(); return observe(false); }
+        m_impl->pcmStarted = true;
+        SetAudioStreamCallback(m_impl->pcmStream, Impl::pcmCallback);
+        PlayAudioStream(m_impl->pcmStream);
+        return observe(true);
+    }
+    bool result;
+    { std::lock_guard callbackLock(Impl::callbackMutex); result = m_impl->pcm.push(samples); }
+    return observe(result);
+#endif
+}
+
+bool PS2AudioBackend::resetSpuPcm()
+{
+#if defined(PLATFORM_VITA)
+    return false;
+#else
+    std::lock_guard lock(m_mutex);
+    m_impl->closePcm();
+    return true;
+#endif
+}
+
 PS2AudioBackend::PS2AudioBackend() : m_impl(std::make_unique<Impl>())
 {
 }
