+void PS2Memory::processIpuDma()
+{
+    static constexpr uint32_t kChannel = 0x1000B400u;
+    uint32_t chcr = m_ioRegisters[kChannel];
+    const auto dctrl = m_ioRegisters.find(0x1000E000u);
+    if (dctrl != m_ioRegisters.end() && (dctrl->second & 1u) == 0u)
+        return;
+    const auto enable = m_ioRegisters.find(0x1000F520u);
+    if (enable != m_ioRegisters.end() && (enable->second & 0x00ff0000u) != 0u)
+        return;
+    if ((chcr & 0x100u) == 0u || !m_ipu->needsData())
+        return;
+
+    const uint32_t mode = (chcr >> 2u) & 0x3u;
+    if (mode != 0u && mode != 1u)
+        throw IpuUnsupportedOperation("unsupported IPU DMA mode " + std::to_string(mode));
+
+    auto readQword = [this](uint32_t address, std::array<uint8_t, 16> &out)
+    {
+        if ((address & 0x80000000u) != 0u || isScratchpad(address))
+            throw IpuUnsupportedOperation("IPU DMA scratchpad source is unsupported");
+        const uint32_t physical = translateAddress(address);
+        if (physical >= PS2_RAM_SIZE || (address & 15u) != 0u)
+            throw IpuUnsupportedOperation("IPU DMA requires an aligned RDRAM source");
+        for (uint32_t offset = 0u; offset < out.size(); ++offset)
+            out[offset] = m_rdram[(physical + offset) & PS2_RAM_MASK];
+    };
+
+    auto finish = [this]()
+    {
+        completeDmacChannel(kChannel, 4u);
+    };
+
+    auto consumeBlock = [&]()
+    {
+        uint32_t &madr = m_ioRegisters[kChannel + 0x10u];
+        uint32_t &qwc = m_ioRegisters[kChannel + 0x20u];
+        while (qwc != 0u && m_ipu->needsData())
+        {
+            std::array<uint8_t, 16> qword{};
+            readQword(madr, qword);
+            if (!m_ipu->writeInput(qword.data(), false))
+                break;
+            madr = (madr + 16u) & 0x7ffffff0u;
+            --qwc;
+        }
+        m_ipu->service();
+    };
+
+    if (mode == 0u)
+    {
+        consumeBlock();
+        if (m_ioRegisters[kChannel + 0x20u] == 0u)
+            finish();
+        return;
+    }
+
+    // QWC and CHCR.TAG already describe retained chain progress. Derive
+    // termination from them at execution, including starts deferred by DMAE or
+    // suspension; separately cached flags become stale if QWC is reprogrammed.
+    auto finalTag = [&]()
+    {
+        const uint32_t tagId = (chcr >> 28u) & 7u;
+        return tagId == 0u || tagId == 7u ||
+               ((chcr & 0x80000000u) != 0u && (chcr & 0x80u) != 0u);
+    };
+    constexpr uint32_t kMaxZeroQwordTags = 4096u;
+    uint32_t zeroQwordTags = 0u;
+    while (m_ipu->needsData())
+    {
+        uint32_t &qwc = m_ioRegisters[kChannel + 0x20u];
+        if (qwc == 0u)
+        {
+            if (++zeroQwordTags > kMaxZeroQwordTags)
+                throw IpuUnsupportedOperation("IPU DMA REF/REFE chain exceeded zero-QW tag bound");
+            const uint32_t tadr = m_ioRegisters[kChannel + 0x30u];
+            std::array<uint8_t, 16> tagBytes{};
+            readQword(tadr, tagBytes);
+            uint64_t tag = 0u;
+            std::memcpy(&tag, tagBytes.data(), sizeof(tag));
+            const uint16_t tagQwc = static_cast<uint16_t>(tag & 0xffffu);
+            const uint8_t id = static_cast<uint8_t>((tag >> 28u) & 0x7u);
+            if (id != 3u && id != 0u)
+                throw IpuUnsupportedOperation("unsupported IPU DMA tag id " + std::to_string(id));
+
+            qwc = tagQwc;
+            const uint32_t tagAddress = static_cast<uint32_t>(tag >> 32u);
+            if ((tagAddress & 0x80000000u) != 0u)
+                throw IpuUnsupportedOperation("IPU DMA scratchpad tag is unsupported");
+            m_ioRegisters[kChannel + 0x10u] = tagAddress & 0x7ffffff0u;
+            m_ioRegisters[kChannel + 0x30u] = tadr + 16u;
+            chcr = (chcr & 0x0000ffffu) |
+                   (static_cast<uint32_t>((tag >> 16u) & 0xffffu) << 16u);
+            m_ioRegisters[kChannel] = chcr;
+            if (qwc == 0u && finalTag())
+            {
+                finish();
+                return;
+            }
+            if (qwc == 0u)
+                continue;
+        }
+
+        consumeBlock();
+        if (m_ioRegisters[kChannel + 0x20u] != 0u)
+            return;
+        if (finalTag())
+        {
+            finish();
+            return;
+        }
