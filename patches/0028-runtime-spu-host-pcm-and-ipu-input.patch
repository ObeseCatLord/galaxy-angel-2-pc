+// This deliberately models only the input side that the reached movie parser
+// uses.  It follows PCSX2's IPU FIFO/BP transition rules without importing its
+// decoder or output/presentation ownership.
+class IpuDevice
+{
+public:
+    static constexpr uint32_t kCommand = 0x10002000u;
+    static constexpr uint32_t kControl = 0x10002010u;
+    static constexpr uint32_t kBitPointer = 0x10002020u;
+    static constexpr uint32_t kTop = 0x10002030u;
+    static constexpr uint32_t kInputFifo = 0x10007010u;
+    static constexpr uint32_t kOutputFifo = 0x10007000u;
+
+    IpuDevice() { reset(); }
+
+    void reset()
+    {
+        input_.fill({});
+        internal_.fill({});
+        quantIntra_.fill(0);
+        quantNonIntra_.fill(0);
+        vq_.fill(0);
+        thresholds_.fill(0);
+        inputRead_ = inputWrite_ = inputCount_ = 0u;
+        bp_ = fp_ = 0u;
+        control_ = data_ = top_ = 0u;
+        command_ = 0xffffffffu;
+        busy_ = dataBusy_ = topBusy_ = dataRequested_ = interrupt_ = false;
+        pending_ = Pending::None;
+        pendingBytes_ = pendingTarget_ = 0u;
+        fdecSkipApplied_ = false;
+    }
+
+    uint32_t readCommand()
+    {
+        // CMD reads outside FDEC/VDEC peek the bit window without advancing it.
+        if ((command_ >> 28u) != 4u)
+            (void)peek32(data_);
+        return data_;
+    }
+    uint32_t readCommandBusy() const { return dataBusy_ ? 0x80000000u : 0u; }
+    uint64_t readCommand64()
+    {
+        return static_cast<uint64_t>(readCommand()) |
+               (static_cast<uint64_t>(dataBusy_ ? 0x80000000u : 0u) << 32u);
+    }
+    uint32_t readControl() const
+    {
+        return (control_ & 0x47f30000u) |
+               (inputCount_ & 0xfu) |
+               (busy_ ? 0x80000000u : 0u);
+    }
+    uint32_t readBitPointer() const
+    {
+        return (bp_ & 0x7fu) | ((inputCount_ & 0xfu) << 8u) | ((fp_ & 0x3u) << 16u);
+    }
+    uint64_t readTop64() const
+    {
+        return static_cast<uint64_t>(top_) |
+               (static_cast<uint64_t>(topBusy_ ? 0x80000000u : 0u) << 32u);
+    }
+    uint32_t readTop() const { return top_; }
+    bool consumeInterrupt()
+    {
+        const bool wasPending = interrupt_;
+        interrupt_ = false;
+        return wasPending;
+    }
+    bool needsData() const { return dataRequested_; }
+    uint32_t inputCount() const { return inputCount_; }
+
+    void writeControl(uint32_t value)
+    {
+        control_ = (control_ & 0x8000ffffu) | (value & 0x47f30000u);
+        if ((value & (1u << 30u)) != 0u)
+            softReset();
+    }
+
+    void writeCommand(uint32_t value)
+    {
+        const uint32_t opcode = value >> 28u;
+        if (busy_ && opcode != 0u && opcode != 9u)
+            throw IpuUnsupportedOperation("IPU command while busy: 0x" + hex(value));
+
+        command_ = value;
+        fdecSkipApplied_ = false;
+        pendingBytes_ = pendingTarget_ = 0u;
+        switch (opcode)
+        {
+        case 0: // BCLR
+            clearInput(value & 0x7fu);
+            dataBusy_ = false;
+            completeCommand();
+            return;
+        case 4: // FDEC
+            pending_ = Pending::Fdec;
+            busy_ = true;
+            dataBusy_ = topBusy_ = true;
+            service();
+            return;
+        case 5: // SETIQ: 64-byte quantizer matrix
+            pending_ = Pending::SetIq;
+            pendingTarget_ = quantIntra_.size();
+            busy_ = true;
+            service();
+            return;
+        case 6: // SETVQ: 16 RGB16 entries
+            pending_ = Pending::SetVq;
+            pendingTarget_ = vq_.size();
+            busy_ = true;
+            service();
+            return;
+        case 9: // SETTH
+            thresholds_[0] = static_cast<uint16_t>(value & 0x1ffu);
+            thresholds_[1] = static_cast<uint16_t>((value >> 16u) & 0x1ffu);
+            completeCommand();
+            return;
+        default:
+            throw IpuUnsupportedOperation("unsupported IPU command 0x" + hex(value) +
+                                          " (opcode " + std::to_string(opcode) + ")");
+        }
+    }
+
+    bool writeInput(const uint8_t *qword, bool serviceNow = true)
+    {
+        if (inputCount_ == input_.size())
+            return false;
+        std::memcpy(input_[inputWrite_].data(), qword, input_[inputWrite_].size());
+        inputWrite_ = (inputWrite_ + 1u) & 7u;
+        ++inputCount_;
+        if (inputCount_ == input_.size())
+            dataRequested_ = false;
+        if (serviceNow)
+            service();
+        return true;
+    }
+
+    void service()
+    {
+        if (!busy_)
+            return;
+
+        switch (pending_)
+        {
+        case Pending::Fdec:
+            if (!fdecSkipApplied_)
+            {
+                if (!advance(command_ & 0x3fu))
+                    return;
+                fdecSkipApplied_ = true;
+            }
+            if (!peek32(data_))
+                return;
+            top_ = data_;
+            dataBusy_ = topBusy_ = false;
+            completeCommand();
+            return;
+        case Pending::SetIq:
+        case Pending::SetVq:
+            if (pending_ == Pending::SetIq && !fdecSkipApplied_)
+            {
+                if (!advance(command_ & 0x3fu))
+                    return;
+                fdecSkipApplied_ = true;
+            }
+            while (pendingBytes_ < pendingTarget_)
+            {
+                // SETIQ/SETVQ accept one 64-bit table word at a time. A partial
+                // word must not advance BP or become a completed table prefix.
+                if (!fill(64u))
+                    return;
+                for (uint32_t index = 0; index < 8u; ++index)
+                {
+                    uint8_t byte = 0u;
+                    for (uint32_t bit = 0u; bit < 8u; ++bit)
+                    {
+                        const uint32_t sourceBit = bp_ + index * 8u + bit;
+                        const uint8_t source = internal_[sourceBit / 128u][(sourceBit % 128u) / 8u];
+                        byte = static_cast<uint8_t>((byte << 1u) | ((source >> (7u - (sourceBit & 7u))) & 1u));
+                    }
+                    if (pending_ == Pending::SetIq)
+                    {
+                        auto &matrix = (command_ & (1u << 27u)) != 0u ? quantNonIntra_ : quantIntra_;
+                        matrix[pendingBytes_ + index] = byte;
+                    }
+                    else
+                        vq_[pendingBytes_ + index] = byte;
+                }
+                advance(64u);
+                pendingBytes_ += 8u;
+            }
+            completeCommand();
+            return;
+        case Pending::None:
+            return;
+        }
+    }
+
+private:
+    enum class Pending : uint8_t { None, Fdec, SetIq, SetVq };
+
+    static std::string hex(uint32_t value)
+    {
+        static constexpr char digits[] = "0123456789abcdef";
+        std::string result(8u, '0');
+        for (size_t index = 0; index < result.size(); ++index)
+            result[result.size() - 1u - index] = digits[(value >> (index * 4u)) & 0xfu];
+        return result;
+    }
+
+    void clearInput(uint32_t bitOffset)
+    {
+        input_.fill({});
+        internal_.fill({});
+        inputRead_ = inputWrite_ = inputCount_ = 0u;
+        bp_ = bitOffset;
+        fp_ = 0u;
+        dataRequested_ = true;
+    }
+
+    void softReset()
+    {
+        clearInput(0u);
+        thresholds_.fill(0u);
+        control_ &= 0x07f33f00u;
+        data_ = top_ = 0u;
+        command_ = 0xffffffffu;
+        busy_ = dataBusy_ = topBusy_ = false;
+        pending_ = Pending::None;
+        pendingBytes_ = pendingTarget_ = 0u;
+        fdecSkipApplied_ = false;
+        interrupt_ = true;
+    }
+
+    void completeCommand()
+    {
+        busy_ = false;
+        pending_ = Pending::None;
+        pendingBytes_ = pendingTarget_ = 0u;
+        interrupt_ = true;
+    }
+
+    bool popInput(std::array<uint8_t, 16> &out)
+    {
+        if (inputCount_ <= 1u)
+            dataRequested_ = true;
+        if (inputCount_ == 0u)
+            return false;
+        out = input_[inputRead_];
+        inputRead_ = (inputRead_ + 1u) & 7u;
+        --inputCount_;
+        return true;
+    }
+
+    bool fill(uint32_t bits)
+    {
+        while (fp_ * 128u < bp_ + bits)
+        {
+            if (fp_ == internal_.size() || !popInput(internal_[fp_]))
+                return false;
+            ++fp_;
+        }
+        return true;
+    }
+
+    bool advance(uint32_t bits)
+    {
+        // PCSX2's tIPU_BP::Advance intentionally applies the new BP even when
+        // FillBuffer starves.  The pending command then resumes at that BP.
+        (void)fill(bits);
+        bp_ += bits;
+        if (bp_ < 128u)
+            return true;
+
+        bp_ -= 128u;
+        if (fp_ == 2u)
+        {
+            internal_[0] = internal_[1];
+            fp_ = 1u;
+        }
+        else if (popInput(internal_[0]))
+        {
+            fp_ = 1u;
+        }
+        else
+        {
+            fp_ = 0u;
+        }
+        return true;
+    }
+
+    bool peek32(uint32_t &out)
+    {
+        if (!fill(32u))
+            return false;
+        uint32_t result = 0u;
+        for (uint32_t bit = 0u; bit < 32u; ++bit)
+        {
+            const uint32_t sourceBit = bp_ + bit;
+            const uint8_t byte = internal_[sourceBit / 128u][(sourceBit % 128u) / 8u];
+            result = (result << 1u) | ((byte >> (7u - (sourceBit & 7u))) & 1u);
+        }
+        out = result;
+        return true;
+    }
