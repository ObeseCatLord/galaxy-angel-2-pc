+// Included by the existing private emulator boundary-test target only.
+//
+// Alarms follow thbase (ps2sdk-study thbase.c / thcommon.c timer_handler):
+// duplicate pair = KE_FOUND_HANDLER, short delays are raised to min_wait, the
+// alarm leaves the queue before its callback runs, a non-zero return
+// reschedules, and no request or callback outcome shuts the IOP down.
+#include "iop_compat_test_support.h"
+#include <cstdlib>
+namespace ps2x::iop::detail
+{
+    bool testIopAlarmBoundaries()
+    {
+        using State = IopEmulator::Impl;
+        const auto require = [](bool b, const char *s) { if (!b) throw std::runtime_error(s); };
+        constexpr uint32_t CLOCK = 0x13000, MARK = 0x13100, NEXT = 0x13104, SECOND = 0x13108;
+        constexpr uint64_t MINWAIT = kAlarmMinWaitCycles;
+        const auto words = [](State &s, uint32_t a, std::initializer_list<uint32_t> v) { for (auto w : v) { s.memory.write32(a, w); a += 4; } };
+        const auto jal = [](uint32_t t) { return 0x0C000000u | (t >> 2); };
+        const auto prepare = [&](State &s, uint32_t delay = 1000)
+        {
+            require(s.memory.zeroRam(0x10000, 0x5000), "RAM seed");
+            words(s, 0x12000, {0x41E00000, 0, 0x101}); require(s.memory.writeRam(0x1200C, "thbase", 7), "thbase");
+            for (uint32_t n = 0; n <= 41; n++) words(s, 0x12014 + n * 8, {0x03E00008, 0x24000000 | n});
+            words(s, 0x12400, {0x41E00000, 0, 0x101}); require(s.memory.writeRam(0x1240C, "sysmem", 7), "sysmem");
+            for (uint32_t n = 0; n <= 15; n++) words(s, 0x12414 + n * 8, {0x03E00008, 0x24000000 | n});
+            // Callback 0x11000: ++*(int*)a0; return 0.
+            words(s, 0x11000, {0x8C880000, 0, 0x25080001, 0xAC880000, 0x03E00008, 0x00001021});
+            s.memory.write32(CLOCK, delay); s.memory.write32(CLOCK + 4, 0);
+        };
+        // Real MIPS calls into thbase: SetAlarm(35)/iSetAlarm(36)/CancelAlarm(37)/iCancelAlarm(38).
+        const auto driver = [&](State &s, uint32_t ordinal, uint32_t function = 0x11000, uint32_t clock = CLOCK, uint32_t argument = MARK)
+        {
+            std::vector<uint32_t> w = {0x27BDFFE8, 0xAFBF0010};
+            const auto li = [&](unsigned r, uint32_t a) { w.push_back(0x3C000000 | (r << 16) | (a >> 16)); w.push_back(0x34000000 | (r << 21) | (r << 16) | (a & 65535)); };
+            li(4, ordinal <= 36 ? clock : function); li(5, ordinal <= 36 ? function : argument); li(6, argument);
+            w.insert(w.end(), {jal(0x12014 + ordinal * 8), 0, 0x8FBF0010, 0, 0x27BD0018, 0x03E00008, 0});
+            uint32_t a = 0x11200; for (auto v : w) { s.memory.write32(a, v); a += 4; }
+            uint32_t result = 0;
+            const auto status = s.executeGuestFunctionWithStackArgumentsChecked(0x11200, 0, 0, 0, 0, 0, {}, 100000, result);
+            require(status == IopGuestCallStatus::Completed, "alarm driver did not complete");
+            return int32_t(result);
+        };
+        try
+        {
+            // One-shot: raised to min_wait, not early, delivered once.
+            { iop_test::Host h; State s(h); prepare(s);
+              require(driver(s, 35) == 0, "SetAlarm rejected");
+              s.runCycles(MINWAIT - 100); require(s.memory.read32(MARK) == 0, "alarm fired before min_wait (delay 1000 ticks)");
+              s.runCycles(300); require(!s.resetRequired && s.memory.read32(MARK) == 1, "one-shot not delivered at min_wait");
+              s.runCycles(3 * MINWAIT); require(s.memory.read32(MARK) == 1 && s.pendingGuestCallbacks.empty(), "one-shot repeated"); }
+            // A delay of zero is not an error (raised to min_wait), a long one is honoured.
+            { iop_test::Host h; State s(h); prepare(s, 0);
+              require(driver(s, 36) == 0, "zero delay was refused");
+              s.runCycles(MINWAIT + 100); require(!s.resetRequired && s.memory.read32(MARK) == 1, "zero-delay alarm not delivered");
+              s.memory.write32(CLOCK, uint32_t(5 * MINWAIT)); require(driver(s, 35) == 0, "long alarm");
+              s.runCycles(4 * MINWAIT); require(s.memory.read32(MARK) == 1, "long alarm fired early");
+              s.runCycles(2 * MINWAIT); require(s.memory.read32(MARK) == 2, "long alarm not delivered"); }
+            // Duplicate pair: KE_FOUND_HANDLER, still exactly one delivery.
+            { iop_test::Host h; State s(h); prepare(s);
+              require(driver(s, 35) == 0 && driver(s, 35) == -104 && driver(s, 36) == -104 && !s.resetRequired, "duplicate registration");
+              require(driver(s, 35, 0x11000, CLOCK, NEXT) == 0, "a different argument is a different alarm");
