+            for (uint32_t ordinal : {37u, 38u})
+            { iop_test::Host h; State s(h); prepare(s);
+              require(driver(s, ordinal) == -105 && !s.resetRequired, "missing cancel");
+              require(driver(s, 35) == 0 && driver(s, ordinal) == 0 && driver(s, ordinal) == -105 && !s.resetRequired, "cancel then cancel again");
+              s.runCycles(2 * MINWAIT); require(s.memory.read32(MARK) == 0 && s.pendingGuestCallbacks.empty(), "cancelled alarm fired");
+              require(driver(s, 35) == 0, "register after cancel"); s.runCycles(2 * MINWAIT);
+              require(driver(s, ordinal) == -105 && s.memory.read32(MARK) == 1, "expired cancel"); }
+            // Too many alarms and bad pointers are error results.
+            { iop_test::Host h; State s(h); prepare(s);
+              int accepted = 0; int32_t last = 0;
+              for (uint32_t n = 0; n < 70; n++) { last = driver(s, 35, 0x11000, CLOCK, 0x13200 + n * 4); if (last == 0) ++accepted; }
+              require(accepted == 64 && last == -400 && !s.resetRequired, "alarm table limit must be an error, not a shutdown");
+              require(driver(s, 35, 0x11002) == -402 && !s.resetRequired, "unaligned callback");
+              require(driver(s, 35, 0x11000, 0x13003) == -1 && !s.resetRequired, "unaligned clock");
+              require(driver(s, 35, 0x11000, 0x00300000) == -1 && !s.resetRequired, "clock outside RAM");
+              s.runCycles(2 * MINWAIT); require(!s.resetRequired, "pending alarms after refusals"); }
+            // A callback cancelling itself sees KE_NOTFOUND_HANDLER and can re-arm itself.
+            { iop_test::Host h; State s(h); prepare(s);
+              words(s, 0x11000, {0x27BDFFE8, 0xAFBF0010, 0x8C880000, 0, 0x25080001, 0xAC880000,        // ++*a0
+                  0x3C040001, 0x34841000, 0x3C050001, 0x34A53100, jal(0x12014 + 37 * 8), 0,             // CancelAlarm(self)
+                  0x3C080001, 0xAD024104, 0x8FBF0010, 0, 0x27BD0018, 0x03E00008, 0x00001021});          // store v0; return 0
+              require(driver(s, 35) == 0, "register self-cancelling alarm");
+              s.runCycles(2 * MINWAIT);
+              require(!s.resetRequired && s.memory.read32(MARK) == 1 && int32_t(s.memory.read32(0x14104)) == -105,
+                      "self cancel from the callback must be KE_NOTFOUND_HANDLER"); }
+            { iop_test::Host h; State s(h); prepare(s);
+              // The callback re-arms itself (same pair) from inside the callback.
+              words(s, 0x11000, {0x27BDFFE8, 0xAFBF0010, 0x8C880000, 0, 0x25080001, 0xAC880000,
+                  0x3C040001, 0x34843000, 0x3C050001, 0x34A51000, 0x3C060001, 0x34C63100, jal(0x12014 + 36 * 8), 0,
+                  0x3C080001, 0xAD024104, 0x8FBF0010, 0, 0x27BD0018, 0x03E00008, 0x00001021});
+              require(driver(s, 35) == 0, "register re-arming alarm");
+              s.runCycles(MINWAIT + 5000);
+              require(!s.resetRequired && s.memory.read32(MARK) == 1 && s.memory.read32(0x14104) == 0u && s.pendingGuestCallbacks.size() == 1,
+                      "a callback must be able to re-arm itself");
+              s.runCycles(MINWAIT + 5000); require(s.memory.read32(MARK) == 2, "the re-armed alarm did not fire"); }
+            // Non-zero return: reschedules after the previous target (+ max(ret, min_wait)).
+            { iop_test::Host h; State s(h); prepare(s);
+              const uint32_t period = uint32_t(2 * MINWAIT);
+              // callback: ++*a0; return (*a0 < 3) ? period : 0
+              words(s, 0x11000, {0x8C880000, 0, 0x25080001, 0xAC880000,
+                                 0x29090003,                      // slti t1,t0,3
+                                 0x11200004,                      // beq t1,zero,+4 (-> return 0)
+                                 0x3C020000 | (period >> 16),     // lui v0,hi
+                                 0x34420000 | (period & 0xFFFF),  // ori v0,v0,lo
+                                 0x03E00008, 0});
+              words(s, 0x11028, {0x03E00008, 0x00001021}); // branch target: return 0
+              require(driver(s, 35) == 0, "register periodic alarm");
+              s.runCycles(MINWAIT + 100); require(s.memory.read32(MARK) == 1 && s.pendingGuestCallbacks.size() == 1, "first period");
+              s.runCycles(period); require(s.memory.read32(MARK) == 2, "second period");
+              s.runCycles(period); require(s.memory.read32(MARK) == 3 && s.pendingGuestCallbacks.empty(), "third period ends the alarm");
+              s.runCycles(4 * period); require(!s.resetRequired && s.memory.read32(MARK) == 3, "periodic alarm kept firing"); }
+            // A callback that never returns is dropped (logged) without stopping the IOP or other alarms.
+            { iop_test::Host h; State s(h); prepare(s);
+              words(s, 0x11100, {0x08004440, 0});                       // j self
+              require(driver(s, 35, 0x11100) == 0 && driver(s, 35, 0x11000, CLOCK, SECOND) == 0, "register hung and healthy alarms");
+              s.runCycles(2 * MINWAIT);
+              s.runCycles(1000); // the hung callback consumed its whole budget of IOP time
+              require(!s.resetRequired && s.memory.read32(SECOND) == 1 && s.pendingGuestCallbacks.empty(),
+                      "a hung alarm callback shut the IOP down or blocked another alarm");
+              bool logged = false; for (const auto &line : h.logs) logged = logged || line.find("alarm callback") != std::string::npos;
+              require(logged, "the dropped alarm callback was not logged"); }
+            // The callback budget is no longer silent for interrupt-style callbacks either.
+            { iop_test::Host h; State s(h); prepare(s);
+              words(s, 0x11100, {0x08004440, 0});
+              s.pendingGuestCallbacks.emplace(10u, State::ScheduledGuestCallback{0x11100u, 0u, 0u});
+              s.runCycles(100);
+              bool logged = false; for (const auto &line : h.logs) logged = logged || line.find("abandoned") != std::string::npos;
+              require(!s.resetRequired && logged, "an abandoned callback must be logged"); }
+            // Retirement of an executable or the whole module removes its alarms.
+            { iop_test::Host h; State s(h); prepare(s);
+              require(driver(s, 35) == 0, "register"); s.retireAlarms(0x11000, 4); s.runCycles(2 * MINWAIT);
+              require(!s.resetRequired && s.memory.read32(MARK) == 0, "retired callback fired"); }
+            { iop_test::Host h; State s(h); prepare(s);
+              const uint32_t code = s.memory.allocate(0x100, 16); require(code != 0, "code allocation");
+              std::array<uint8_t, 24> body{};
+              require(s.memory.readRam(0x11000, body.data(), body.size()) && s.memory.writeRam(code, body.data(), body.size()), "callback copy");
+              require(driver(s, 35, code) == 0, "register");
+              require(s.memory.freeAllocation(code), "free code"); s.runCycles(2 * MINWAIT);
+              require(!s.resetRequired && s.memory.read32(MARK) == 0, "freed code still ran"); }
+            { iop_test::Host h; State s(h); prepare(s);
+              const uint32_t clock = s.memory.allocate(0x100, 16); require(clock != 0, "clock allocation");
+              s.memory.write32(clock, 1000); s.memory.write32(clock + 4, 0); require(driver(s, 35, 0x11000, clock) == 0, "register");
+              require(s.memory.freeAllocation(clock), "free clock"); s.runCycles(2 * MINWAIT);
+              require(!s.resetRequired && s.memory.read32(MARK) == 1, "the copied clock is not a live dependency"); }
+            { iop_test::Host h; State s(h); prepare(s); require(driver(s, 35) == 0, "register");
+              s.reset(); s.runCycles(2 * MINWAIT); require(!s.resetRequired && s.pendingGuestCallbacks.empty(), "reset kept alarms"); }
+            std::cout << "PASS alarm boundaries (thbase SetAlarm/CancelAlarm contract)\n";
+            return true;
+        }
+        catch (const std::exception &error)
+        {
+            std::cerr << "FAIL alarm boundaries: " << error.what() << '\n';
+            return false;
+        }
+    }
+}
