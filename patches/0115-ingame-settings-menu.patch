+namespace ga2_settings
+{
+    namespace
+    {
+        std::once_flag g_once;
+        std::array<std::atomic<int>, ga2_options::KeyCount> g_current{};
+        std::array<int, ga2_options::KeyCount> g_started{};
+        std::array<bool, ga2_options::KeyCount> g_changed{};
+        std::atomic<uint32_t> g_generation{1};
+
+        std::string env(const char *name)
+        {
+            const char *v = std::getenv(name);
+            return v ? std::string(v) : std::string();
+        }
+
+        bool envSet(const char *name) { return std::getenv(name) != nullptr; }
+
+        void putEnv(const char *name, const std::string &value)
+        {
+#ifdef _WIN32
+            _putenv_s(name, value.c_str());
+#else
+            setenv(name, value.c_str(), 1);
+#endif
+        }
+
+        std::filesystem::path pathFromUtf8(const std::string &text)
+        {
+            return std::filesystem::path(std::u8string(text.begin(), text.end()));
+        }
+
+        // The launcher's folder (Library::defaultDataDir).
+        std::filesystem::path defaultDataDir()
+        {
+#ifdef _WIN32
+            if (const std::string appdata = env("APPDATA"); !appdata.empty())
+                return pathFromUtf8(appdata) / "ga2";
+            return std::filesystem::current_path() / "ga2-data";
+#else
+            if (const std::string xdg = env("XDG_DATA_HOME"); !xdg.empty())
+                return pathFromUtf8(xdg) / "ga2";
+            if (const std::string home = env("HOME"); !home.empty())
+                return pathFromUtf8(home) / ".local" / "share" / "ga2";
+            return std::filesystem::current_path() / "ga2-data";
+#endif
+        }
+
+        int choiceForValue(size_t option, const std::string &text)
+        {
+            const auto &o = ga2_options::options()[option];
+            for (size_t c = 0; c < o.choices.size(); ++c)
+                if (text == o.choices[c].value)
+                    return int(c);
+            return -1;
+        }
+
+        void doInit()
+        {
+            const auto &table = ga2_options::options();
+            // settings.ini, only for a run that names the data folder.
+            std::array<int, ga2_options::KeyCount> fromFile;
+            fromFile.fill(-1);
+            if (envSet("GA2_DATA_DIR"))
+            {
+                std::ifstream in(settingsFile());
+                for (std::string line; std::getline(in, line);)
+                {
+                    if (!line.empty() && line.back() == '\r')
+                        line.pop_back();
+                    const auto equals = line.find('=');
+                    if (equals == std::string::npos)
+                        continue;
+                    const std::string key = line.substr(0, equals), text = line.substr(equals + 1);
+                    for (size_t i = 0; i < table.size(); ++i)
+                        if (key == table[i].key)
+                            fromFile[i] = choiceForValue(i, text);
+                }
+            }
+            int fromEnvironment = 0, fromSettingsFile = 0;
+            for (size_t i = 0; i < table.size(); ++i)
+            {
+                int choice = 0;
+                if (envSet(table[i].env))
+                {
+                    choice = std::max(0, ga2_options::choiceFromEnv(i, env(table[i].env)));
+                    ++fromEnvironment;
+                }
+                else if (fromFile[i] >= 0)
+                {
+                    choice = fromFile[i];
+                    putEnv(table[i].env, ga2_options::envValue(i, choice, dumpDirectory()));
+                    ++fromSettingsFile;
+                }
+                g_started[i] = choice;
+                g_current[i].store(choice);
+            }
+            std::fprintf(stderr, "[settings] %d options from the environment, %d from %s; changes are saved to %s\n", fromEnvironment,
+                         fromSettingsFile, envSet("GA2_DATA_DIR") ? "settings.ini" : "(no data folder given)",
+                         settingsFile().string().c_str());
+        }
+    }
+
+    void init() { std::call_once(g_once, doInit); }
+
+    int get(Key key)
+    {
+        init();
+        return g_current[key].load(std::memory_order_relaxed);
+    }
+
+    const char *value(Key key) { return ga2_options::options()[key].choices[size_t(get(key))].value; }
+
+    int started(Key key)
+    {
+        init();
+        return g_started[key];
+    }
+
+    void set(Key key, int choice)
+    {
+        init();
+        const int count = int(ga2_options::options()[key].choices.size());
+        choice = std::max(0, std::min(choice, count - 1));
+        if (choice == g_current[key].load())
+            return;
+        g_current[key].store(choice);
+        g_changed[key] = true;
+        g_generation.fetch_add(1);
+    }
+
+    uint32_t generation()
+    {
+        init();
+        return g_generation.load(std::memory_order_relaxed);
+    }
+
+    bool changed(Key key)
+    {
+        init();
+        return g_changed[key];
+    }
+
+    bool takesEffectNow(Key key, int choice, const char **why)
+    {
+        init();
+        const auto &o = ga2_options::options()[key];
+        if (o.apply == ga2_options::Apply::Restart)
+        {
+            if (why)
+                *why = "applies after restart";
+            return false;
+        }
+        if (key == ga2_options::Fps)
+        {
+            // The high frame rate machinery (hooks, display pacing) is set up at the start for the rate the run
+            // started with; the rate can move between 60 and that. VR keeps the PS2 rate.
+            const int wanted = std::atoi(o.choices[size_t(choice)].value);
+            const int top = ga2_framepace::fps();
+            if (wanted > 60 && wanted > top)
+            {
+                if (why)
+                    *why = top > 0 ? "above this run's top rate: applies after restart" : "applies after restart";
+                return false;
+            }
+        }
+        return true;
+    }
+
+    bool restartPending(Key key)
+    {
+        init();
+        const int now = g_current[key].load();
+        if (ga2_options::options()[key].apply == ga2_options::Apply::Restart)
+            return now != g_started[key];
+        return !takesEffectNow(key, now) && now != g_started[key];
+    }
+
+    std::filesystem::path dataDir()
+    {
+        const std::string dir = env("GA2_DATA_DIR");
+        return dir.empty() ? defaultDataDir() : pathFromUtf8(dir);
+    }
+
+    std::filesystem::path settingsFile() { return dataDir() / "settings.ini"; }
+
+    std::string dumpDirectory()
+    {
+        const auto path = dataDir() / "dumps" / "textures";
+        const auto text = path.u8string();
+        return std::string(text.begin(), text.end());
+    }
+
+    bool save()
+    {
+        init();
+        const auto &table = ga2_options::options();
+        const std::filesystem::path file = settingsFile();
+        std::vector<std::string> lines;
+        {
+            std::ifstream in(file);
+            for (std::string line; std::getline(in, line);)
+            {
+                if (!line.empty() && line.back() == '\r')
+                    line.pop_back();
+                lines.push_back(line);
+            }
+        }
+        for (size_t i = 0; i < table.size(); ++i)
+        {
+            if (!g_changed[i])
+                continue;
+            const std::string line = std::string(table[i].key) + "=" + table[i].choices[size_t(g_current[i].load())].value;
+            bool found = false;
+            for (std::string &existing : lines)
+                if (existing.compare(0, std::strlen(table[i].key) + 1, std::string(table[i].key) + "=") == 0)
+                {
+                    existing = line;
+                    found = true;
+                }
+            if (!found)
+                lines.push_back(line);
+        }
+        std::error_code error;
+        std::filesystem::create_directories(file.parent_path(), error);
+        // A temporary file renamed over the old one: a crash cannot leave half a settings file.
+        std::filesystem::path temporary = file;
+        temporary += ".tmp";
+        {
+            std::ofstream out(temporary, std::ios::trunc);
+            for (const std::string &line : lines)
+                out << line << '\n';
+            if (!out)
+                return false;
+        }
+        std::filesystem::rename(temporary, file, error);
+        if (error)
+        {
+            std::fprintf(stderr, "[settings] cannot write %s: %s\n", file.string().c_str(), error.message().c_str());
+            return false;
+        }
+        return true;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ga2_settings_menu.cpp b/ps2xRuntime/src/lib/ga2_settings_menu.cpp
new file mode 100644
index 0000000..c4d29c0
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_settings_menu.cpp
@@ -0,0 +1,298 @@
+#include "ga2_settings_menu.h"
+
+#include "ga2_present.h"
+#include "runtime/ga2_activity.h"
+#include "runtime/ga2_framepace.h"
+#include "runtime/ga2_settings.h"
+#include "ga2_vr.h"
+
+#include "raylib.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace ga2_settings_menu
+{
+    namespace
+    {
+        using ga2_options::Key;
+
+        int g_selected = 0;
+        std::string g_notice;
+        double g_noticeUntil = 0.0;
+        // The fullscreen row shows the window as it is (F11 and Alt+Enter change it too).
+        bool fullscreenNow() { return IsWindowFullscreen() || IsWindowState(FLAG_BORDERLESS_WINDOWED_MODE); }
+
+        int shownChoice(Key key)
+        {
+            if (key == ga2_options::Fullscreen)
+                return fullscreenNow() ? 1 : 0;
+            return ga2_settings::get(key);
+        }
+
+        // ---- layout: logical units, scaled by the canvas ----
+        constexpr float kPanelWidth = 620.0f, kTitleHeight = 52.0f, kRowHeight = 26.0f, kHelpHeight = 92.0f,
+                        kFooterHeight = 24.0f, kPad = 14.0f;
+
+        struct Layout
+        {
+            float u;          // logical unit in pixels
+            float x, y, w, h; // the panel
+        };
+
+        Layout layout(const Canvas &c)
+        {
+            const float rows = float(ga2_options::KeyCount);
+            const float height = kTitleHeight + rows * kRowHeight + kHelpHeight + kFooterHeight;
+            float u = std::min((c.width - 20.0f * c.scale) / kPanelWidth, (c.height - 20.0f * c.scale) / height);
+            u = std::clamp(u, 0.4f, c.vr ? 2.0f : 1.4f);
+            Layout l;
+            l.u = u;
+            l.w = kPanelWidth * u;
+            l.h = height * u;
+            l.x = (c.width - l.w) * 0.5f;
+            l.y = (c.height - l.h) * 0.5f;
+            return l;
+        }
+
+        Rectangle rowRect(const Layout &l, int i)
+        {
+            return Rectangle{l.x + 8.0f * l.u, l.y + (kTitleHeight + kRowHeight * float(i)) * l.u, l.w - 16.0f * l.u,
+                             kRowHeight * l.u};
+        }
+
+        // The value column: [<] value [>] between these fractions of the row.
+        constexpr float kValueFrom = 0.43f, kValueTo = 0.80f;
+
+        // ---- changing a value ----
+        const char *choiceLabel(Key key, int choice) { return ga2_options::options()[key].choices[size_t(choice)].label; }
+
+        void say(const std::string &text)
+        {
+            g_notice = text;
+            g_noticeUntil = GetTime() + 4.0;
+        }
+
+        void change(Key key, int delta)
+        {
+            const auto &option = ga2_options::options()[key];
+            const int count = int(option.choices.size());
+            const int before = shownChoice(key);
+            const int choice = (before + delta % count + count) % count;
+            if (choice == before)
+                return;
+            const char *why = nullptr;
+            const bool now = ga2_settings::takesEffectNow(key, choice, &why);
+            ga2_settings::set(key, choice);
+            if (key == ga2_options::Fullscreen && fullscreenNow() != (choice == 1))
+                ToggleBorderlessWindowed();
+            if (key == ga2_options::Fps && now)
+                ga2_framepace::setUserCap(std::atoi(option.choices[size_t(choice)].value));
+            const bool saved = ga2_settings::save();
+            std::string text = std::string(option.label) + ": " + choiceLabel(key, choice);
+            if (!now)
+                text += std::string(" (") + (why ? why : "applies after restart") + ")";
+            if (!saved)
+                text += " - could not save settings.ini";
+            say(text);
+        }
+
+        // One line about the selected row beyond its help text: what applies when, and what the setting needs.
+        std::string context(Key key)
+        {
+            char text[200];
+            switch (key)
+            {
+            case ga2_options::Fps:
+            {
+                const int top = ga2_framepace::fps();
+                if (ga2_vr::headsetRunning())
+                    return "In VR the headset sets the rate.";
+                if (top <= 0)
+                    return "This run started at the PS2's 60: higher rates apply after restart.";
+                std::snprintf(text, sizeof(text), "Now %d fps (up to %d in this run; higher applies after restart).",
+                              std::max(60, ga2_framepace::rate()), top);
+                return text;
+            }
+            case ga2_options::Sides:
+                if (ga2_settings::get(key) == 2 && ga2_present::skyboxMissing())
+                    return "No skybox picture yet (the launcher extracts it from your discs): sides stay black.";
+                return "";
+            case ga2_options::Widescreen3d:
+                if (ga2_vr::headsetRunning())
+                    return "Not used in VR (the headset's view replaces it).";
+                if (ga2_settings::get(ga2_options::Aspect) == 3)
+                    return "Needs a wider screen shape than 4:3.";
+                return "";
+            case ga2_options::Filter:
+                return ga2_activity::scene3d() ? "This is a 3D scene: the filter shows in 2D scenes." : "";
+            case ga2_options::DumpTextures:
+                return "Textures the game loads from now on go to the dump folder.";
+            case ga2_options::Vr:
+                return "Takes effect when the game is started again.";
+            default:
+                return ga2_options::options()[key].apply == ga2_options::Apply::Restart ? "Takes effect when the game is started again." : "";
+            }
+        }
+
+        std::vector<std::string> wrap(const std::string &text, int fontSize, float width)
+        {
+            std::vector<std::string> lines;
+            std::string line, word;
+            auto flush = [&] {
+                if (!word.empty())
+                {
+                    const std::string trial = line.empty() ? word : line + " " + word;
+                    if (!line.empty() && float(MeasureText(trial.c_str(), fontSize)) > width)
+                    {
+                        lines.push_back(line);
+                        line = word;
+                    }
+                    else
+                        line = trial;
+                    word.clear();
+                }
+            };
+            for (char ch : text)
+            {
+                if (ch == ' ')
+                    flush();
+                else
+                    word += ch;
+            }
+            flush();
+            if (!line.empty())
+                lines.push_back(line);
+            return lines;
+        }
+    }
+
+    void opened()
+    {
+        // The row stays where it was; what was said last does not.
+        g_notice.clear();
+        g_noticeUntil = 0.0;
+    }
+
+    void update(const Input &in, const Canvas &window)
+    {
+        const int count = int(ga2_options::KeyCount);
+        if (in.home)
+            g_selected = 0;
+        if (in.end)
+            g_selected = count - 1;
+        if (in.up)
+            g_selected = (g_selected + count - 1) % count;
+        if (in.down)
+            g_selected = (g_selected + 1) % count;
+        if (in.left)
+            change(Key(g_selected), -1);
+        if (in.right || in.confirm)
+            change(Key(g_selected), 1);
+        const Layout l = layout(window);
+        for (int i = 0; i < count; ++i)
+        {
+            const Rectangle r = rowRect(l, i);
+            if (in.x < r.x || in.x >= r.x + r.width || in.y < r.y || in.y >= r.y + r.height)
+                continue;
+            if (in.pointerMoved)
+                g_selected = i;
+            const float inRow = (in.x - r.x) / r.width;
+            if (in.click)
+            {
+                g_selected = i;
+                // Left of the value's middle: back, right of it: forward; the label only selects.
+                if (inRow >= kValueFrom && inRow < kValueTo)
+                    change(Key(i), inRow < (kValueFrom + kValueTo) * 0.5f ? -1 : 1);
+            }
+            if (in.wheel != 0.0f)
+            {
+                g_selected = i;
+                change(Key(i), in.wheel > 0.0f ? -1 : 1);
+            }
+        }
+    }
+
+    void draw(const Canvas &c)
+    {
+        const Layout l = layout(c);
+        const float u = l.u;
+        const Rectangle panel{l.x, l.y, l.w, l.h};
+        if (!c.vr)
+            DrawRectangle(0, 0, int(c.width), int(c.height), Color{0, 0, 0, 120});
+        DrawRectangleRounded(panel, 0.03f, 8, Color{12, 18, 44, 240});
+        DrawRectangleRoundedLinesEx(panel, 0.03f, 8, std::max(1.0f, 2.0f * u), Color{90, 160, 255, 255});
+        DrawText("SETTINGS", int(l.x + 20 * u), int(l.y + 14 * u), int(28 * u), Color{230, 236, 250, 255});
+        const char *hint = c.vr ? "Stick: choose and change   B: close" : "Up/Down: choose  Left/Right: change  F2/Esc: close";
+        {
+            const int fs = int(14 * u);
+            const int w = MeasureText(hint, fs);
+            DrawText(hint, int(l.x + l.w - w - 18 * u), int(l.y + 24 * u), fs, Color{130, 140, 170, 255});
+        }
+
+        const int fontSize = std::max(8, int(18 * u));
+        const auto &table = ga2_options::options();
+        for (int i = 0; i < int(ga2_options::KeyCount); ++i)
+        {
+            const Key key = Key(i);
+            const Rectangle r = rowRect(l, i);
+            const int ty = int(r.y + (r.height - float(fontSize)) * 0.5f);
+            if (i == g_selected)
+                DrawRectangleRec(r, Color{30, 44, 90, 255});
+            DrawText(table[key].label, int(r.x + 8 * u), ty, fontSize, Color{230, 236, 250, 255});
+
+            const int choice = shownChoice(key);
+            const bool pending = ga2_settings::restartPending(key);
+            const char *label = choiceLabel(key, choice);
+            const float vx0 = r.x + r.width * kValueFrom, vx1 = r.x + r.width * kValueTo;
+            const Color valueColor = pending ? Color{255, 190, 90, 255} : Color{150, 200, 255, 255};
+            const int w = MeasureText(label, fontSize);
+            DrawText(label, int((vx0 + vx1) * 0.5f) - w / 2, ty, fontSize, valueColor);
+            if (i == g_selected)
+            {
+                DrawText("<", int(vx0), ty, fontSize, Color{230, 236, 250, 255});
+                DrawText(">", int(vx1) - MeasureText(">", fontSize), ty, fontSize, Color{230, 236, 250, 255});
+            }
+            const char *tag = pending ? "after restart" : table[key].apply == ga2_options::Apply::Restart ? "restart" : "";
+            if (*tag)
+            {
+                const int tf = std::max(8, int(13 * u));
+                DrawText(tag, int(r.x + r.width - 8 * u) - MeasureText(tag, tf), int(r.y + (r.height - float(tf)) * 0.5f), tf,
+                         pending ? Color{255, 190, 90, 255} : Color{110, 118, 140, 255});
+            }
+        }
+
+        // Help for the selected row, then what applies now.
+        const float helpTop = l.y + (kTitleHeight + kRowHeight * float(ga2_options::KeyCount) + 6.0f) * u;
+        const int helpSize = std::max(8, int(15 * u));
+        const Key key = Key(g_selected);
+        float y = helpTop;
+        for (const std::string &line : wrap(table[key].help, helpSize, l.w - 36.0f * u))
+        {
+            DrawText(line.c_str(), int(l.x + 18 * u), int(y), helpSize, Color{190, 198, 220, 255});
+            y += float(helpSize) * 1.25f;
+        }
+        const std::string status = g_noticeUntil > GetTime() ? g_notice : context(key);
+        std::string saved = std::string("Saved to ") + ga2_settings::settingsFile().string();
+        const float bottom = l.y + l.h - (kFooterHeight + 4.0f) * u;
+        if (!status.empty())
+        {
+            const auto lines = wrap(status, helpSize, l.w - 36.0f * u);
+            float sy = bottom - float(lines.size()) * float(helpSize) * 1.25f + 2.0f * u;
+            for (const std::string &line : lines)
+            {
+                DrawText(line.c_str(), int(l.x + 18 * u), int(sy), helpSize, Color{255, 205, 120, 255});
+                sy += float(helpSize) * 1.25f;
+            }
+        }
+        const int footer = std::max(8, int(12 * u));
+        // A long folder name loses its beginning.
+        while (saved.size() > 12 && float(MeasureText(saved.c_str(), footer)) > l.w - 36.0f * u)
+            saved = "..." + saved.substr(saved.size() > 60 ? saved.size() - 60 : 4);
+        DrawText(saved.c_str(), int(l.x + 18 * u), int(l.y + l.h - (kFooterHeight - 6.0f) * u), footer, Color{110, 118, 140, 255});
+    }
+}
diff --git a/ps2xRuntime/src/lib/ga2_settings_menu.h b/ps2xRuntime/src/lib/ga2_settings_menu.h
new file mode 100644
index 0000000..5ad6eee
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_settings_menu.h
@@ -0,0 +1,36 @@
+#pragma once
+
+#include <cstdint>
+
+// The settings page of the in-game menu (ga2_cheat_menu.cpp owns the window, the input and the headset texture and
+// opens this page with F2). One row per player option (runtime/ga2_options.h, the same table as the launcher's
+// Options screen): left / right change the value, which takes effect at once (the live options) or is saved for the
+// next start and marked "restart". Changes go through ga2_settings, which the consumers read, and are written to
+// settings.ini right away.
+namespace ga2_settings_menu
+{
+    // Where and how big the menu is drawn: the window (scale 1) or the headset's texture (scale 2).
+    struct Canvas
+    {
+        float width, height, scale;
+        bool vr;
+    };
+
+    // One frame of what the player asked for, from keyboard, pad, VR controllers and mouse.
+    struct Input
+    {
+        bool up = false, down = false, left = false, right = false;
+        bool confirm = false;       // the same as right: next value
+        bool home = false, end = false; // first / last row
+        bool pointerMoved = false;  // the mouse moved this frame
+        bool click = false;         // left button pressed
+        float x = 0.0f, y = 0.0f;   // mouse position in the window canvas
+        float wheel = 0.0f;
+    };
+
+    // The menu was opened: the selected row stays, pending notices are cleared.
+    void opened();
+    // Main thread, while the page is open.
+    void update(const Input &input, const Canvas &window);
+    void draw(const Canvas &canvas);
+}
