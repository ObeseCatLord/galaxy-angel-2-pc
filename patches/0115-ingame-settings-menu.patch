diff --git a/ps2xRuntime/include/runtime/ga2_options.h b/ps2xRuntime/include/runtime/ga2_options.h
new file mode 100644
index 0000000..aeffb58
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_options.h
@@ -0,0 +1,151 @@
+// The player options, one table shared by the launcher's Options screen
+// (native/launcher/settings.cpp), the in-game settings menu
+// (src/lib/ga2_settings_menu.cpp) and the runtime's settings registry
+// (ga2_settings.h). Header only, so the launcher needs no runtime library.
+//
+// Values live in <data>/settings.ini (key=value); the launcher hands them to
+// the engines as the environment variables named here.
+#pragma once
+
+#include <cstddef>
+#include <cstdlib>
+#include <string>
+#include <vector>
+
+namespace ga2_options
+{
+    // Index into options(); the launcher's and the registry's arrays use it.
+    enum Key : size_t
+    {
+        Language,
+        Resolution,
+        Fullscreen,
+        Aspect,
+        Widescreen3d,
+        Sides,
+        Scale2d,
+        Filter,
+        Fps,
+        Dither,
+        Buttons,
+        Vr,
+        OnscreenPad,
+        DumpTextures,
+        KeyCount
+    };
+
+    // Whether the running game can take the change at once. Restart options
+    // are saved and applied by the next start (the launcher, or the engine
+    // with GA2_DATA_DIR set, reads settings.ini).
+    enum class Apply
+    {
+        Live,
+        Restart
+    };
+
+    struct Choice
+    {
+        const char *value; // stored in settings.ini
+        const char *label; // shown in the menus
+    };
+
+    struct Option
+    {
+        const char *key;   // settings.ini key
+        const char *label;
+        const char *help;  // one line under the list
+        const char *env;   // the variable the engines read
+        Apply apply;
+        std::vector<Choice> choices; // the first is the default
+    };
+
+    inline const std::vector<Option> &options()
+    {
+        static const std::vector<Option> table = {
+            {"language", "Language", "Game names in the window title (language packs follow the same setting).", "GA2_LANG",
+             Apply::Restart, {{"ja", "Japanese"}, {"en", "English"}}},
+            {"resolution", "Internal resolution", "3D detail (the 2D art is drawn at its native 640x448 size; 4x needs a fast GPU).",
+             "GA2_PGS_SSAA", Apply::Restart, {{"0", "Native (640x448)"}, {"1", "2x (1280x896)"}, {"2", "4x (2560x1792)"}}},
+            {"fullscreen", "Display", "F11 or Alt+Enter also switches while playing.", "GA2_FULLSCREEN", Apply::Live,
+             {{"0", "Window"}, {"1", "Fullscreen"}}},
+            {"aspect", "Screen shape", "Shape of the play area. 4:3 scenes are centred in wider shapes.", "GA2_ASPECT", Apply::Live,
+             {{"16:9", "16:9"}, {"16:10", "16:10"}, {"21:9", "21:9 ultrawide"}, {"4:3", "4:3 (PS2)"}, {"fit", "Fill the window"}}},
+            {"widescreen3d", "3D widescreen (hor+)",
+             "3D scenes show more to the sides on wide screens (same height as the PS2's view; menus and text keep their shape).",
+             "GA2_WIDESCREEN_3D", Apply::Live, {{"1", "On"}, {"0", "Off (4:3 with sides)"}}},
+            {"sides", "Sides of 4:3 scenes", "What fills the area beside a 4:3 picture.", "GA2_SIDES", Apply::Live,
+             {{"black", "Black"}, {"blur", "Blurred picture"}, {"skybox", "Space skybox"}}},
+            {"scale2d", "2D scene size", "Visual-novel scenes: fill the play area, or whole multiples (2x, 3x) for crisp pixels.",
+             "GA2_SCALE_2D", Apply::Live, {{"fill", "Fill"}, {"integer", "Integer (crisp)"}}},
+            {"filter", "2D picture filter", "Applies to 2D scenes only; 3D scenes always use plain bilinear.", "GA2_FILTER",
+             Apply::Live,
+             {{"bilinear", "Bilinear"}, {"smooth", "Smooth (removes dither grain)"}, {"anime4k", "Anime4K"},
+              {"anime4k-hq", "Anime4K HQ (fast GPU)"}, {"sharp", "Sharp pixels"}, {"nearest", "Nearest (raw pixels)"}}},
+            {"fps", "Frame rate",
+             "Frames drawn per second; the game keeps its own speed. Needs a fast PC (a PC that can't keep up runs the game slower); VR keeps the PS2 rate.",
+             "GA2_FPS", Apply::Live, {{"60", "60 (PS2)"}, {"120", "120"}, {"144", "144"}, {"165", "165"}, {"240", "240"}}},
+            {"dither", "PS2 dithering", "The PS2's checkerboard dither when it reduces colours to 16 bits.", "GA2_PGS_DITHER",
+             Apply::Live, {{"0", "Off"}, {"1", "On (original look)"}}},
+            {"buttons", "Button prompts", "Which button icons the games show: follows the controller or keyboard you use.",
+             "GA2_BUTTONS", Apply::Live, {{"auto", "Automatic"}, {"playstation", "PlayStation"}, {"xbox", "Xbox"}, {"keyboard", "Keyboard"}}},
+            {"vr", "VR mode", "Plays in a headset through SteamVR or Monado (OpenXR). Hold both grips to recentre the screen.",
+             "GA2_VR", Apply::Restart, {{"0", "Off"}, {"1", "On (headset)"}}},
+            {"onscreen_pad", "On-screen pad", "Clickable pad buttons beside the picture, for mouse-only play.", "GA2_ONSCREEN_PAD",
+             Apply::Live, {{"0", "Off"}, {"1", "On"}}},
+            {"dump_textures", "Dump textures (modding)",
+             "Saves every texture the game shows to <data>/dumps/textures as <hash>_<w>x<h>.png.", "GA2_TEX_DUMP", Apply::Live,
+             {{"0", "Off"}, {"1", "On"}}},
+        };
+        return table;
+    }
+
+    // The environment text for a choice. `dumpDir` is where the texture dump
+    // goes when it is on.
+    inline std::string envValue(size_t option, int choice, const std::string &dumpDir)
+    {
+        const Option &o = options()[option];
+        const std::string value = o.choices[size_t(choice)].value;
+        switch (Key(option))
+        {
+        case Resolution:
+            return value == "2" ? "16" : value == "1" ? "4" : "1";
+        case DumpTextures:
+            return value == "1" ? dumpDir : std::string();
+        default:
+            return value;
+        }
+    }
+
+    // The choice an environment text stands for; -1 when it is none of them.
+    inline int choiceFromEnv(size_t option, const std::string &text)
+    {
+        const Option &o = options()[option];
+        switch (Key(option))
+        {
+        case DumpTextures: // any path means on
+            return text.empty() ? 0 : 1;
+        case Vr: // "preview" (a developer mode) counts as on
+            if (text == "preview")
+                return 1;
+            break;
+        case Fps:
+        {
+            // GA2_FPS accepts any rate: the highest choice that is not above it.
+            const int rate = std::atoi(text.c_str());
+            if (rate < 1)
+                return -1;
+            int best = 0;
+            for (size_t c = 0; c < o.choices.size(); ++c)
+                if (std::atoi(o.choices[c].value) <= rate)
+                    best = int(c);
+            return best;
+        }
+        default:
+            break;
+        }
+        for (size_t c = 0; c < o.choices.size(); ++c)
+            if (text == envValue(option, int(c), "1"))
+                return int(c);
+        return -1;
+    }
+}
diff --git a/ps2xRuntime/include/runtime/ga2_settings.h b/ps2xRuntime/include/runtime/ga2_settings.h
new file mode 100644
index 0000000..60458d1
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_settings.h
@@ -0,0 +1,54 @@
+// The player options while the game runs: the launcher's settings (ga2_options.h) as live values. The in-game
+// settings menu (src/lib/ga2_settings_menu.cpp) writes them; the consumers (presentation, hor+, frame rate, GS, ...)
+// read them each frame instead of the environment, so a change shows at once where the setting allows it.
+//
+// Start: init() takes every option from its environment variable (the launcher sets them all); a variable that is
+// not set falls back to <data>/settings.ini when GA2_DATA_DIR names the data folder (the launcher sets that too), so
+// an engine started by hand with GA2_DATA_DIR sees the same options and a handoff to another disc's engine keeps what
+// was changed in game. The launcher's settings.ini is also where changes are saved: the data folder is GA2_DATA_DIR,
+// or where the launcher keeps it (XDG_DATA_HOME/ga2, ~/.local/share/ga2, %APPDATA%\ga2).
+#pragma once
+
+#include "runtime/ga2_options.h"
+
+#include <atomic>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+
+namespace ga2_settings
+{
+    using ga2_options::Key;
+
+    // Reads the environment (and settings.ini for what is unset) once. Call before anything reads GA2_* variables:
+    // for the options that are not set it also sets them in the environment, so code that still reads the
+    // environment (the engines at their start) sees the file's values. Safe to call again.
+    void init();
+
+    // The current choice (index into ga2_options::options()[key].choices) and its value text.
+    int get(Key key);
+    const char *value(Key key);
+    // The choice the game started with (what the engines read at their start).
+    int started(Key key);
+
+    // Main thread: takes a new choice. Does not save (see save()); consumers pick it up by value() / generation().
+    void set(Key key, int choice);
+    // Counts every set(): consumers cache what they derived and rebuild when it changes.
+    uint32_t generation();
+    // The player changed it in this run (what save() writes).
+    bool changed(Key key);
+
+    // The running game cannot take `choice` of `key` now (a restart option, or a frame rate above what this run
+    // started with); the menu then says "after restart". `why` gets a short reason.
+    bool takesEffectNow(Key key, int choice, const char **why = nullptr);
+    // The saved setting differs from what this run uses and needs a restart.
+    bool restartPending(Key key);
+
+    // <data>/settings.ini. Written by save(): the keys the player changed in this run replace their lines, other
+    // lines (the launcher's window_scale, options this run did not touch) stay as they are.
+    std::filesystem::path dataDir();
+    std::filesystem::path settingsFile();
+    bool save();
+    // The folder for texture dumps (<data>/dumps/textures).
+    std::string dumpDirectory();
+}
