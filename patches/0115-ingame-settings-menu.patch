diff --git a/ps2xTest/src/ga2_settings_tests.cpp b/ps2xTest/src/ga2_settings_tests.cpp
new file mode 100644
index 0000000..5e2d8df
--- /dev/null
+++ b/ps2xTest/src/ga2_settings_tests.cpp
@@ -0,0 +1,119 @@
+#include "MiniTest.h"
+
+#include "runtime/ga2_options.h"
+#include "runtime/ga2_settings.h"
+
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <set>
+#include <sstream>
+#include <string>
+
+namespace
+{
+    using namespace ga2_options;
+
+    void setEnv(const char *name, const char *value)
+    {
+#ifdef _WIN32
+        _putenv_s(name, value ? value : "");
+#else
+        if (value)
+            setenv(name, value, 1);
+        else
+            unsetenv(name);
+#endif
+    }
+
+    std::map<std::string, std::string> readIni(const std::filesystem::path &file)
+    {
+        std::map<std::string, std::string> out;
+        std::ifstream in(file);
+        for (std::string line; std::getline(in, line);)
+            if (const auto equals = line.find('='); equals != std::string::npos)
+                out[line.substr(0, equals)] = line.substr(equals + 1);
+        return out;
+    }
+}
+
+void register_ga2_settings_tests()
+{
+    MiniTest::Case("Ga2Settings", [](TestCase &tc) {
+        tc.Run("the option table has unique keys and variables, and every choice survives the environment round trip", [](TestCase &t) {
+            std::set<std::string> keys, envs;
+            t.Equals(options().size(), size_t(KeyCount), "one option per key");
+            for (size_t i = 0; i < options().size(); ++i)
+            {
+                const Option &o = options()[i];
+                t.IsTrue(keys.insert(o.key).second, std::string("unique key ") + o.key);
+                t.IsTrue(envs.insert(o.env).second, std::string("unique variable ") + o.env);
+                t.IsTrue(o.choices.size() >= 2, std::string("choices for ") + o.key);
+                for (size_t c = 0; c < o.choices.size(); ++c)
+                    t.Equals(choiceFromEnv(i, envValue(i, int(c), "/data/dumps/textures")), int(c),
+                             std::string(o.key) + "=" + o.choices[c].value + " round trip");
+            }
+            t.Equals(std::string(envValue(Resolution, 2, "")), std::string("16"), "4x is 16 samples");
+            t.Equals(std::string(envValue(DumpTextures, 0, "/d")), std::string(), "dump off is an empty path");
+            t.Equals(std::string(envValue(DumpTextures, 1, "/d")), std::string("/d"), "dump on is the folder");
+            t.Equals(choiceFromEnv(Vr, "preview"), 1, "preview counts as VR on");
+            t.Equals(choiceFromEnv(Fps, "130"), 1, "any rate maps to the nearest choice below it");
+            t.Equals(choiceFromEnv(Fps, "300"), 4, "above the table: the top choice");
+            t.Equals(choiceFromEnv(Aspect, "bogus"), -1, "unknown text");
+        });
+
+        tc.Run("the registry reads settings.ini under GA2_DATA_DIR, lets the environment win and saves only what changed", [](TestCase &t) {
+            namespace fs = std::filesystem;
+            const fs::path dir = fs::temp_directory_path() / ("ga2-settings-test-" + std::to_string(std::rand()));
+            fs::create_directories(dir);
+            {
+                std::ofstream ini(dir / "settings.ini");
+                ini << "filter=anime4k\nfps=144\nvr=0\nwindow_scale=3\nfuture_key=x\nbuttons=xbox\n";
+            }
+            for (const Option &o : options())
+                setEnv(o.env, nullptr);
+            setEnv("GA2_DATA_DIR", dir.string().c_str());
+            setEnv("GA2_BUTTONS", "keyboard"); // the environment wins over the file
+            ga2_settings::init();
+            t.Equals(std::string(ga2_settings::value(Filter)), std::string("anime4k"), "filter from the file");
+            t.Equals(std::string(ga2_settings::value(Fps)), std::string("144"), "frame rate from the file");
+            t.Equals(std::string(ga2_settings::value(Buttons)), std::string("keyboard"), "environment wins");
+            t.Equals(std::string(ga2_settings::value(Sides)), std::string("black"), "default where nothing says otherwise");
+            t.Equals(std::string(std::getenv("GA2_FILTER") ? std::getenv("GA2_FILTER") : ""), std::string("anime4k"),
+                     "the file's value is handed to code that reads the environment");
+            t.Equals(ga2_settings::get(Filter), ga2_settings::started(Filter), "nothing changed yet");
+            t.IsFalse(ga2_settings::changed(Filter), "not changed");
+
+            const uint32_t before = ga2_settings::generation();
+            ga2_settings::set(Dither, 1);
+            ga2_settings::set(Filter, 0);
+            ga2_settings::set(Vr, 1);
+            t.IsTrue(ga2_settings::generation() > before, "a change bumps the generation");
+            t.IsTrue(ga2_settings::changed(Dither) && ga2_settings::changed(Filter), "changed keys are marked");
+            t.IsFalse(ga2_settings::changed(Fps), "untouched keys are not");
+            t.IsTrue(ga2_settings::restartPending(Vr), "VR waits for a restart");
+            t.IsFalse(ga2_settings::restartPending(Filter), "the filter is live");
+            const char *why = nullptr;
+            t.IsFalse(ga2_settings::takesEffectNow(Vr, 1, &why), "VR is a restart option");
+            t.IsTrue(why != nullptr, "with a reason");
+            t.IsTrue(ga2_settings::takesEffectNow(Filter, 2), "filter is live");
+            t.IsTrue(ga2_settings::takesEffectNow(Fps, 0), "the PS2 rate is always possible");
+            ga2_settings::set(Vr, 0);
+            t.IsFalse(ga2_settings::restartPending(Vr), "back to what the run started with");
+
+            t.IsTrue(ga2_settings::save(), "saved");
+            const auto ini = readIni(dir / "settings.ini");
+            t.Equals(ini.at("filter"), std::string("bilinear"), "changed value replaces its line");
+            t.Equals(ini.at("dither"), std::string("1"), "new key appended");
+            t.Equals(ini.at("fps"), std::string("144"), "untouched keys stay as they were");
+            t.Equals(ini.at("buttons"), std::string("xbox"), "a key an environment override hid is not rewritten");
+            t.Equals(ini.at("window_scale"), std::string("3"), "the launcher's own lines stay");
+            t.Equals(ini.at("future_key"), std::string("x"), "unknown lines stay");
+            t.IsTrue(ini.count("vr") == 1 && ini.at("vr") == "0", "VR set and set back writes the final value");
+            t.IsFalse(fs::exists(dir / "settings.ini.tmp"), "no temporary file left");
+            t.Equals(ga2_settings::dumpDirectory(), (dir / "dumps" / "textures").string(), "dump folder under the data folder");
+            fs::remove_all(dir);
+        });
+    });
+}
