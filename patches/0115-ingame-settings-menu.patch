diff --git a/ps2xRuntime/src/lib/gs/gs_pgs.cpp b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
index 8e09d0d..5bb57d5 100644
--- a/ps2xRuntime/src/lib/gs/gs_pgs.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_pgs.cpp
@@ -6,6 +6,7 @@
 
 #include "runtime/ga2_stereo.h"
 #include "runtime/ga2_framepace.h"
+#include "runtime/ga2_settings.h"
 #include "runtime/ps2_memory.h"
 #include "gs_texpacks.h"
 
@@ -192,6 +193,8 @@ namespace
     };
 
     std::atomic<bool> g_rendering{false};
+    // The player's dither choice while playing (-1: as the environment said at the start); applied at vsync.
+    std::atomic<int> g_ditherWanted{-1};
 
     // Persistent Vulkan pipeline cache. paraLLEl-GS pre-compiles ~2000 compute
     // pipelines at start; without a cache every launch recompiles them.
@@ -748,6 +751,23 @@ namespace ga2_pgs
 
     void setButtonStyle(const std::string &style) { ga2_texpacks::setButtonStyle(style); }
 
+    void applySettings()
+    {
+        static uint32_t seen = 0;
+        const uint32_t generation = ga2_settings::generation();
+        if (generation == seen)
