+        tc.Run("ELF segments overlapping the native SDK pools in kernel RAM are refused", [](TestCase &t)
+        {
+            Env env;
+            t.IsTrue(env.runtime.memory().initialize(), "loader requires actual RDRAM backing");
+            R5900Context main{};
+            resetAndBind(env, main, kReturnEntry);
+            TempElf overlapping(0x00100000u, 0x00050FFCu, 8u);
+            t.IsFalse(env.runtime.loadELF(overlapping.path.string()),
+                      "a segment reaching into the pools must fail the load");
+            t.Equals(read32(env.runtime.memory().getRDRAM(), 0x00050FFCu), 0u,
