diff --git a/ps2xRuntime/include/runtime/ee_kernel_ram.h b/ps2xRuntime/include/runtime/ee_kernel_ram.h
new file mode 100644
index 0000000..48529dd
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ee_kernel_ram.h
@@ -0,0 +1,14 @@
+#pragma once
+
+#include <cstdint>
+
+// Native SDK pools (RPC packets/servers, TLS, boot mode) live in EE kernel RAM
+// below 0x80000, which games never touch; at the top of user RAM they
+// overlapped game heaps (Eigou's file buffers at 0x01F0xxxx were corrupted by
+// server records). The ELF loader and the invocation-stack arena refuse
+// anything that overlaps them.
+namespace ps2_kernel_ram
+{
+    inline constexpr uint32_t kNativeSdkPoolBase = 0x00020000u;
+    inline constexpr uint32_t kNativeSdkPoolEnd = 0x00051000u;
+}
diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index c4586c2..171311a 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -6,6 +6,7 @@
 #include "ps2_log.h"
 #include "ps2_runtime_macros.h"
 #include "runtime/ee_guest_range.h"
+#include "runtime/ee_kernel_ram.h"
 
 #include <algorithm>
 #include <cassert>
@@ -1453,7 +1454,7 @@ void EeScheduler::configureInvocationStackArena(uint32_t begin, uint32_t end)
     if (overlaps(m_runtime.guestHeapBase(), m_runtime.guestHeapLimit()))
         throw std::runtime_error("EE callback arena overlaps guest heap entitlement");
     // Existing native SDK packet/server/TLS/boot-mode pools are fixed claims.
-    if (overlaps(0x00020000u, 0x00051000u)) // kNativeSdkPoolBase..kNativeSdkPoolEnd
+    if (overlaps(ps2_kernel_ram::kNativeSdkPoolBase, ps2_kernel_ram::kNativeSdkPoolEnd))
         throw std::runtime_error("EE callback arena overlaps native SDK storage");
     for (const auto &[id, owner] : m_threads)
     {
@@ -1628,10 +1629,36 @@ EeScheduler::InvocationStackChoice EeScheduler::selectInvocationStack()
         return {existing->second, existing->second + 0x10u - kInvocationStackSize,
                 existing->second + 0x10u};
     }
-    const uint32_t top = m_runtime.reserveAsyncCallbackStack(kInvocationStackSize, 16u);
+    uint32_t top = m_runtime.reserveAsyncCallbackStack(kInvocationStackSize, 16u);
     if (top == 0u)
     {
-        throw std::runtime_error("EE invocation stack space exhausted");
+        // The arena is full. Slots stay keyed by (owner, depth) after their
+        // invocation retires, so re-key one that no live or queued invocation holds.
+        const auto held = [this](uint32_t slotTop)
+        {
+            const auto holds = [slotTop](const GuestInvocation &invocation)
+            { return invocation.stackReservationEnd == slotTop + 0x10u; };
+            if (std::any_of(m_pendingInvocations.begin(), m_pendingInvocations.end(), holds)) return true;
+            for (const auto &[id, thread] : m_threads)
+                if (std::any_of(thread.invocations.begin(), thread.invocations.end(), holds)) return true;
+            return false;
+        };
+        for (auto it = m_invocationStackTops.begin(); it != m_invocationStackTops.end(); ++it)
+        {
+            if (held(it->second)) continue;
+            top = it->second;
+            m_invocationStackTops.erase(it);
+            break;
+        }
+        if (top == 0u)
+        {
+            std::fprintf(stderr, "[ee] invocation stack arena exhausted; slots:");
+            for (const auto &[slotKey, slotTop] : m_invocationStackTops)
+                std::fprintf(stderr, " owner=%d/depth=%u@0x%x", static_cast<int32_t>(slotKey >> 32u),
+                             static_cast<uint32_t>(slotKey), slotTop);
+            std::fprintf(stderr, " request owner=%d/depth=%zu\n", static_cast<int32_t>(keyOwner), depth);
+            throw std::runtime_error("EE invocation stack space exhausted");
+        }
     }
     validateIsolatedInvocationStack(top);
     m_invocationStackTops.emplace(key, top);
