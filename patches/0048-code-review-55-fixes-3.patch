--- a/ps2xRuntime/src/lib/ps2_iop_host.cpp
+++ b/ps2xRuntime/src/lib/ps2_iop_host.cpp
@@ -191,11 +191,23 @@ bool PS2IopHostAdapter::submitGenericReverseRpc(const ps2x::iop::ReverseRpcReque
     constexpr uint32_t kReplyBytes = 64u;
     uint8_t *const rdram = m_activeRdram ? m_activeRdram : m_runtime.memory().getRDRAM();
     const auto physical = [](uint32_t address) { return address & 0x1FFFFFFFu; };
-    const auto inRam = [&](uint32_t address, uint32_t size)
-    { return physical(address) < PS2_RAM_SIZE && size <= PS2_RAM_SIZE - physical(address); };
-    if (!rdram || !endpoint.isCurrent || !endpoint.complete || !endpoint.isCurrent() ||
-        !inRam(request.serverAddress, 68u) || !inRam(request.bufferAddress, request.send.size()))
+    // Same pointer rule as the SDK metadata walk: aligned main-RAM aliases only,
+    // so a corrupted record cannot reach scratchpad or mirrored addresses.
+    const auto inRam = [](uint32_t address, uint32_t size) { return nativeRpcRamRange(address, size); };
+    const auto rejected = [](const char *what, uint32_t address)
+    {
+        static bool logged = false;
+        if (!logged)
+            std::cerr << "[reverse rpc] rejected " << what << " 0x" << std::hex << address << std::dec << '\n';
+        logged = true;
         return false;
+    };
+    if (!rdram || !endpoint.isCurrent || !endpoint.complete || !endpoint.isCurrent())
+        return false;
+    if (!inRam(request.serverAddress, 68u))
+        return rejected("server", request.serverAddress);
+    if (!inRam(request.bufferAddress, request.send.size()))
+        return rejected("buffer", request.bufferAddress);
     const auto word = [&](uint32_t address)
     {
         uint32_t value = 0;
@@ -216,7 +228,7 @@ bool PS2IopHostAdapter::submitGenericReverseRpc(const ps2x::iop::ReverseRpcReque
                   << (word(sd + 8u) != request.bufferAddress || !m_runtime.hasFunction(func) ? " REJECTED" : "") << '\n';
     }
     if (word(sd + 8u) != request.bufferAddress || !m_runtime.hasFunction(func))
-        return false;
+        return rejected("server record", sd);
 
     std::memcpy(rdram + physical(request.bufferAddress), request.send.data(), request.send.size());
     putWord(sd + 12u, static_cast<uint32_t>(request.send.size())); // size
@@ -249,6 +261,7 @@ bool PS2IopHostAdapter::submitGenericReverseRpc(const ps2x::iop::ReverseRpcReque
         std::array<uint8_t, kReplyBytes> bytes{};
         if (!ram || !inRam(reply, kReplyBytes))
         {
+            std::cerr << "[reverse rpc] reply pointer 0x" << std::hex << reply << std::dec << " rejected\n";
             shared->complete(-1, {});
             return;
         }
@@ -818,10 +831,18 @@ int32_t PS2IopHostAdapter::memoryCard(const ps2x::iop::MemoryCardRequest &reques
     setRegU32(&context, 8, request.arguments[4]);
     setRegU32(&context, 9, request.arguments[5]);
 
