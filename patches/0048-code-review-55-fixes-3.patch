@@ -485,6 +485,31 @@ void register_ps2_idle_irq_stack_tests()
             t.IsTrue(exhausted, "a fifth live callback reservation must exhaust the four-frame arena");
         });
 
+        tc.Run("configured arena re-keys slots whose invocations retired", [](TestCase &t)
+        {
+            TestEnv env;
+            EeScheduler &scheduler = env.runtime.eeScheduler();
+            scheduler.configureInvocationStackArena(kInvocationArenaBegin, kInvocationArenaEnd);
+            R5900Context main{};
+            setReg(main, 29, 0x00180000u);
+            scheduler.reset(env.ram.data(), main);
+            scheduler.bindMainContextForSyscall(main, env.ram.data());
+            // Each external invocation deepens the owner without holding a slot, so
+            // every depth asks for a new key; slots no invocation holds are re-keyed.
+            std::vector<uint32_t> tops;
+            for (int depth = 0; depth < 6; ++depth)
+            {
+                tops.push_back(scheduler.invocationStackTop());
+                GuestInvocation external{};
+                setReg(external.context, 29, 0x00018000u);
+                try { scheduler.invokeCurrent(std::move(external)); }
+                catch (const EeDispatcherTransfer &) {}
+            }
+            for (uint32_t top : tops)
+                t.IsTrue(top >= kInvocationArenaBegin && top < kInvocationArenaEnd, "re-keyed slot must stay in the arena");
+            t.IsTrue(tops[4] != 0u && tops[5] != 0u, "fifth and sixth keys must reuse retired slots");
+        });
+
         tc.Run("arena rejects mirror registration and removal before map or memory mutation", [](TestCase &t)
         {
             TestEnv env;
