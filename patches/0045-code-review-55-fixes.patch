diff --git a/ps2xRuntime/src/lib/ps2_ipu.cpp b/ps2xRuntime/src/lib/ps2_ipu.cpp
index e95dee9..441d0c0 100644
--- a/ps2xRuntime/src/lib/ps2_ipu.cpp
+++ b/ps2xRuntime/src/lib/ps2_ipu.cpp
@@ -16,6 +16,7 @@
 #include "ps2_ipu_vlc.h"
 
 #include <algorithm>
+#include <cassert>
 #include <chrono>
 #include <cstdio>
 #include <cstdlib>
@@ -427,6 +428,8 @@ void IpuDevice::align()
 
 uint32_t IpuDevice::ubits(uint32_t bits) const
 {
+    // A 32-bit load shifted by up to 7 bits: exact for at most 25 bits.
+    assert(bits <= 25u);
     uint32_t result = loadBe32(&m_internal[m_bp / 8u]);
     result <<= (m_bp & 7u);
     return result >> (32u - bits);
@@ -434,6 +437,7 @@ uint32_t IpuDevice::ubits(uint32_t bits) const
 
 int32_t IpuDevice::sbits(uint32_t bits) const
 {
+    assert(bits <= 25u);
     int32_t result = static_cast<int32_t>(loadBe32(&m_internal[m_bp / 8u]));
     result = static_cast<int32_t>(static_cast<uint32_t>(result) << (m_bp & 7u));
     return result >> (32u - bits);
@@ -461,11 +465,12 @@ bool IpuDevice::getBits32(uint8_t *out, bool adv)
 {
     if (!fillBuffer(32))
         return false;
-    const uint32_t v = ubits(32);
-    out[0] = static_cast<uint8_t>(v >> 24);
-    out[1] = static_cast<uint8_t>(v >> 16);
-    out[2] = static_cast<uint8_t>(v >> 8);
-    out[3] = static_cast<uint8_t>(v);
+    // ubits() only covers 25 bits at an unaligned position; like PCSX2, the
+    // low bits of each byte come from the next byte.
+    const uint32_t shift = m_bp & 7u;
+    const uint8_t *p = &m_internal[m_bp / 8u];
+    for (int i = 0; i < 4; ++i)
+        out[i] = shift == 0u ? p[i] : static_cast<uint8_t>((p[i] << shift) | (p[i + 1] >> (8u - shift)));
     if (adv)
         advance(32);
     return true;
