+    class RejectedStackExecutor final : public IopGuestExecutor
+    {
+    public:
+        IopGuestCallStatus executeGuestFunctionWithStackArgumentsChecked(
+            uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t,
+            std::span<const uint32_t>, uint32_t, uint32_t &result) override
+        {
+            ++stackCalls;
+            result = uint32_t(kErrorUnsupported);
+            return IopGuestCallStatus::Rejected;
+        }
+
+        uint32_t executeGuestFunction(uint32_t, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) override
+        {
+            return 0u;
+        }
+
+        uint32_t stackCalls = 0u;
+    };
