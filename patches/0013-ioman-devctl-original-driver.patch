+    bool testDevctlIncompleteRequiresReset()
+    {
+        // Tail-calling a yielding import returns PC to the call sentinel while
+        // the callback is incomplete. Missing imports and budget exhaustion
+        // likewise must quarantine side effects and prevent subsequent code.
+        for (uint32_t failure = 0u; failure < 3u; ++failure)
+        {
+            iop_test::Host host;
+            IopEmulator emulator(host);
+            iop_test::Irx image = devctlIrx();
+            const uint32_t importOrdinal = failure == 0u ? 16u : 4u;
+            image.words(0x560u, {0x41E00000u, 0u, 0x0101u});
+            writeIrxString(image, 0x56Cu, failure == 0u ? "thbase" : "nosvc");
+            for (uint32_t ordinal = 0u; ordinal <= importOrdinal; ++ordinal)
+                image.words(0x574u + ordinal * 8u, {0x03E00008u, 0x24000000u | ordinal});
+            const uint32_t target = failure == 2u ? 0x10410u : 0x10574u + importOrdinal * 8u;
+            image.words(0x400u, {
+                0x3C080001u, 0x35080500u, 0x24090001u, 0xAD090000u,
+                0x08000000u | (target >> 2u), 0u,
+            });
+            const ModuleLoadResult failed = emulator.loadModuleImage("host0:incomplete-devctl.irx", image.bytes);
+            uint32_t marker = 0u;
+            if (!expect(failed.moduleId < 0, "incomplete callback reported successful startup") ||
+                !expect(emulator.readMemory(0x10500u, &marker, 4u) && marker == 1u,
+                        "failure fixture did not execute its side effect before interruption")) return false;
+            const uint64_t before = emulator.instructions();
+            emulator.runEeCycles(1000000u);
+            const iop_test::Irx complete = devctlIrx();
+            const ModuleLoadResult blocked = emulator.loadModuleImage("host0:blocked-after-failure.irx", complete.bytes);
+            if (!expect(emulator.instructions() == before && blocked.moduleId < 0,
+                        "reset-required emulator executed more guest instructions") ||
+                !expect(emulator.readMemory(0x10500u, &marker, 4u) && marker == 1u,
+                        "reset-required load replaced quarantined callback backing")) return false;
+            emulator.reset();
+            const ModuleLoadResult recovered = emulator.loadModuleImage("host0:after-reset.irx", complete.bytes);
+            if (!expect(recovered.moduleId > 0 && recovered.startResult == 0,
+                        "reset did not retire quarantine and restore guest execution")) return false;
+        }
+        return true;
+    }
