+    bool testDevctlRejectsInvalidCallsBeforeCallback()
+    {
+        Host host;
+        IopMemory memory;
+        IopIoman ioman(host, memory);
+        RejectedStackExecutor executor;
+        constexpr uint32_t driver = 0x1000u;
+        constexpr uint32_t operations = 0x1100u;
+        constexpr uint32_t device = 0x1200u;
+        constexpr uint32_t name = 0x1300u;
+        constexpr uint32_t argument = 0x1400u;
+        constexpr uint32_t buffer = 0x1500u;
+        constexpr uint32_t stack = 0x1600u;
+        constexpr uint32_t handler = 0x1800u;
+        if (!memory.zeroRam(driver, 20u) || !memory.zeroRam(operations, 96u) ||
+            !memory.zeroRam(device, 4u) || !memory.zeroRam(name, 32u) ||
+            !memory.zeroRam(argument, 4u) || !memory.zeroRam(buffer, 4u) || !memory.zeroRam(stack, 24u) ||
+            !memory.zeroRam(handler, 4u) || !writeString(memory, device, "dev") ||
+            !writeString(memory, name, "dev3:/leaf") || !writeString(memory, name + 16u, "bad:/leaf"))
+            return false;
+        memory.write32(driver, device);
+        memory.write32(driver + 4u, 0x10000010u);
+        memory.write32(driver + 16u, operations);
+        memory.write32(operations + 23u * 4u, handler);
+        memory.write32(stack + 16u, buffer);
+        memory.write32(stack + 20u, 4u);
+        IopCpuState add{};
+        add.gpr[4] = driver;
+        add.gpr[28] = 0x11112222u;
+        if (!expect(ioman.dispatchImport(20u, add, executor) && result(add) == 0, "devctl test driver did not register"))
+            return false;
+
+        if (!expect(callDevctl(ioman, executor, name + 16u, argument, stack) < 0 && executor.stackCalls == 0u,
+                    "malformed device entered devctl callback") ||
+            !expect(callDevctl(ioman, executor, name, argument, IopMemory::RamSize - 16u) < 0 && executor.stackCalls == 0u,
+                    "unowned caller stack entered devctl callback"))
+            return false;
+        memory.write32(stack + 16u, IopMemory::RamSize - 1u);
+        if (
+            !expect(callDevctl(ioman, executor, name, argument, stack) < 0 && executor.stackCalls == 0u,
+                    "unowned callback buffer entered devctl callback"))
+            return false;
+
+        memory.write32(stack + 16u, buffer);
+        memory.write32(driver + 4u, 0x30000010u);
+        if (!expect(callDevctl(ioman, executor, name, argument, stack) < 0 && executor.stackCalls == 0u,
+                    "non-FSEXT device entered devctl callback"))
+            return false;
+        memory.write32(driver + 4u, 0x10000010u);
+        memory.write32(operations + 23u * 4u, 0u);
+        if (!expect(callDevctl(ioman, executor, name, argument, stack) < 0 && executor.stackCalls == 0u,
+                    "missing devctl handler entered callback"))
+            return false;
+        memory.write32(operations + 23u * 4u, handler);
+        return expect(callDevctl(ioman, executor, name, argument, stack) == kErrorUnsupported && executor.stackCalls == 1u,
+                      "default checked executor did not reject a valid devctl before execution");
+    }
