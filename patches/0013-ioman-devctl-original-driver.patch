+    bool testDevctlGuestAbiAndScratchReuse()
+    {
+        constexpr uint32_t base = 0x10000u;
+        constexpr uint32_t driver = base + 0x250u;
+        constexpr uint32_t path = base + 0x300u;
+        constexpr uint32_t argument = base + 0x320u;
+        constexpr uint32_t buffer = base + 0x330u;
+        constexpr uint32_t results = base + 0x340u;
+        constexpr uint32_t capture = base + 0x500u;
+        constexpr uint32_t registeredGp = 0x12345678u;
+
+        iop_test::Host host;
+        IopEmulator emulator(host);
+        const iop_test::Irx image = devctlIrx();
+        const ModuleLoadResult loaded = emulator.loadModuleImage("host0:devctl-test.irx", image.bytes);
+        if (!expect(loaded.moduleId > 0 && loaded.startResult == 0, "synthetic devctl module did not start"))
+            return false;
+
+        std::array<uint32_t, 15> observed{};
+        if (!expect(emulator.readMemory(capture, observed.data(), sizeof(observed)), "missing devctl capture") ||
+            !expect(observed[0] != 0u, "devctl did not receive iop_file_t") ||
+            !expect(observed[1] == path + 5u, "devctl suffix did not exclude device and unit") ||
+            !expect(observed[2] == 0x4391u && observed[3] == argument, "devctl register arguments changed") ||
+            !expect(observed[4] == 5u && observed[5] == buffer && observed[6] == 4u,
+                    "devctl o32 stack arguments changed") ||
+            !expect(observed[7] == registeredGp, "devctl did not use the registered driver GP") ||
+            !expect(observed[8] == 0u && observed[9] == 2u && observed[10] == driver && observed[11] == 0u,
+                    "iop_file_t fields differ from the original ABI") ||
+            !expect(observed[12] == 2u && observed[13] != 0u && observed[13] == observed[14],
+                    "devctl did not reuse its completed iop_file_t scratch slot"))
+            return false;
+
+        std::array<uint32_t, 2> returned{};
+        std::array<char, 4> written{};
+        return expect(emulator.readMemory(results, returned.data(), sizeof(returned)) &&
+                          static_cast<int32_t>(returned[0]) == -37 && static_cast<int32_t>(returned[1]) == -37,
+                      "devctl did not preserve the signed handler result") &&
+               expect(emulator.readMemory(buffer, written.data(), written.size()) && written[0] == 'O' && written[1] == 'K',
+                      "devctl handler did not receive the caller buffer");
+    }
