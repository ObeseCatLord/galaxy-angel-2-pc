+    int32_t callDevctl(IopIoman &ioman, RejectedStackExecutor &executor, uint32_t name,
+                        uint32_t argument, uint32_t stackPointer)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = name;
+        cpu.gpr[5] = 0x4391u;
+        cpu.gpr[6] = argument;
+        cpu.gpr[7] = 4u;
+        cpu.gpr[29] = stackPointer;
+        return ioman.dispatchImport(31u, cpu, executor) ? result(cpu) : kErrorInvalid;
+    }
