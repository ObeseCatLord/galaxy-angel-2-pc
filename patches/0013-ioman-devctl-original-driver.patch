+        const size_t colon = path.find(':');
+        if (colon == std::string::npos || colon == 0u) return kErrorNoDevice;
+        size_t unitStart = colon;
+        while (unitStart != 0u && std::isdigit(static_cast<unsigned char>(path[unitStart - 1u]))) --unitStart;
+        uint32_t unit = 0u;
+        for (size_t index = unitStart; index < colon; ++index)
+        {
+            const uint32_t digit = uint32_t(path[index] - '0');
+            if (unit > (uint32_t(INT32_MAX) - digit) / 10u) return kErrorInvalid;
+            unit = unit * 10u + digit;
+        }
+        const std::string_view deviceName = std::string_view(path).substr(0u, unitStart);
+        const auto device = std::find_if(m_devices.begin(), m_devices.end(), [&](const Device &candidate)
+            { return candidate.name == deviceName; });
+        if (device == m_devices.end()) return kErrorNoDevice;
+        // Copy identities before invoking guest code, which may mutate the registry.
+        const uint32_t address = device->address, gp = device->gp;
+        if (!m_memory.ownsRamRange(address, 20u)) return kErrorFault;
+        if ((m_memory.read32(address + 4u) & 0xF0000000u) != 0x10000000u) return kErrorUnsupported;
+        const uint32_t operations = m_memory.read32(address + 16u);
+        if (operations == 0u || !m_memory.ownsRamRange(operations, 24u * 4u)) return kErrorFault;
+        const uint32_t function = m_memory.read32(operations + 23u * 4u);
+        if (function == 0u) return kErrorUnsupported;
+        if ((function & 3u) != 0u || !m_memory.ownsRamRange(function, 4u)) return kErrorFault;
+        const uint32_t sp = cpu.gpr[29];
+        if (sp > UINT32_MAX - 24u || !m_memory.ownsRamRange(sp + 16u, 8u)) return kErrorFault;
+        const uint32_t output = m_memory.read32(sp + 16u), outputSize = m_memory.read32(sp + 20u);
+        const uint32_t argument = cpu.gpr[6], argumentSize = cpu.gpr[7];
+        if ((argumentSize != 0u && (argument == 0u || !m_memory.ownsRamRange(argument, argumentSize))) ||
+            (outputSize != 0u && (output == 0u || !m_memory.ownsRamRange(output, outputSize)))) return kErrorFault;
+        const auto freeSlot = std::find(m_devctlScratchInUse.begin(), m_devctlScratchInUse.end(), false);
+        if (freeSlot == m_devctlScratchInUse.end()) return kErrorNoMemory;
+        if (m_devctlScratch == 0u)
+        {
+            m_devctlScratch = m_memory.allocate(uint32_t(m_devctlScratchInUse.size()) * 16u, 16u);
+            if (m_devctlScratch == 0u) return kErrorNoMemory;
+        }
+        const size_t slot = size_t(freeSlot - m_devctlScratchInUse.begin());
+        const uint32_t file = m_devctlScratch + uint32_t(slot) * 16u;
+        const std::array<uint32_t, 4> fields{0u, unit, address, 0u};
+        if (!m_memory.writeRam(file, fields.data(), sizeof(fields))) return kErrorFault;
+        m_devctlScratchInUse[slot] = true;
+        const std::array<uint32_t, 3> stackArguments{argumentSize, output, outputSize};
+        uint32_t result = uint32_t(kErrorIo);
+        const IopGuestCallStatus status = executor.executeGuestFunctionWithStackArgumentsChecked(
+            function, file, nameAddress + uint32_t(colon) + 1u, cpu.gpr[5], argument,
+            gp, stackArguments, 2000000u, result);
+        if (status == IopGuestCallStatus::ResetRequired)
+        {
+            // The executor has halted guest execution. Keep this scratch slot
+            // quarantined with any references until the whole IOP is reset.
+            cpu.stopped = true;
+            cpu.executionFault = true;
+            return kErrorIo;
+        }
+        m_devctlScratchInUse[slot] = false;
+        if (status == IopGuestCallStatus::Rejected)
+            return int32_t(result) < 0 ? int32_t(result) : kErrorIo;
+        return int32_t(result);
     }
 
