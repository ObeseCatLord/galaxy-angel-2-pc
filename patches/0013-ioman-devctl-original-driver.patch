diff --git a/ps2xIOP/tests/iop_device_callback_boundaries.inc b/ps2xIOP/tests/iop_device_callback_boundaries.inc
new file mode 100644
index 0000000..b154b66
--- /dev/null
+++ b/ps2xIOP/tests/iop_device_callback_boundaries.inc
@@ -0,0 +1,125 @@
+// Included after the real Impl definition only by the IOMAN test target.
+#include "iop_compat_test_support.h"
+
+namespace ps2x::iop::detail
+{
+    bool testIopDeviceCallbackBoundaries()
+    {
+        const auto check = [](bool value, const char *message)
+        {
+            if (!value) std::cerr << "FAIL: " << message << '\n';
+            return value;
+        };
+        // Outer driver returns immediately. A due guest callback tail-calls
+        // devctl on the inner driver, which exhausts its instruction budget.
+        // The failure therefore comes from real nested guest execution.
+        const auto prepare = [&](IopEmulator::Impl &state)
+        {
+            auto &memory = state.memory;
+            if (!memory.zeroRam(0x10000u, 0x5000u)) return false;
+            const auto words = [&](uint32_t address, std::initializer_list<uint32_t> values)
+            {
+                for (uint32_t value : values) { memory.write32(address, value); address += 4u; }
+            };
+            if (!memory.writeRam(0x13080u, "outer", 6u) ||
+                !memory.writeRam(0x13090u, "inner", 6u) ||
+                !memory.writeRam(0x130A0u, "outer0:", 8u) ||
+                !memory.writeRam(0x130B0u, "inner0:", 8u)) return false;
+            words(0x13000u, {0x13080u, 0x10000000u, 1u, 0u, 0x13100u});
+            words(0x13020u, {0x13090u, 0x10000000u, 1u, 0u, 0x13200u});
+            memory.write32(0x1315Cu, 0x11000u);
+            memory.write32(0x1325Cu, 0x11100u);
+            IopCpuState add{};
+            for (uint32_t device : {0x13000u, 0x13020u})
+            {
+                add.gpr[4] = device;
+                if (!state.ioman.dispatchImport(20u, add, state) || add.gpr[2] != 0u) return false;
+            }
+            // Decoder recognizes a real ioman import table and ordinal stub.
+            words(0x12000u, {0x41E00000u, 0u, 0x0104u});
+            if (!memory.writeRam(0x1200Cu, "ioman", 6u)) return false;
+            for (uint32_t ordinal = 0u; ordinal <= 31u; ++ordinal)
+                words(0x12014u + ordinal * 8u, {0x03E00008u, 0x24000000u | ordinal});
+            words(0x11000u, {0x03E00008u, 0u});
+            words(0x11100u, {0x08004440u, 0u}); // J 11100; NOP
+            words(0x11200u, {
+                0x3C040001u, 0x348430B0u, 0x34054391u, 0x00003021u, 0x00003821u,
+                0xAFA00010u, 0xAFA00014u,
+                0x08000000u | ((0x12014u + 31u * 8u) >> 2u), 0u,
+            });
+            return true;
+        };
+
+        // Establish the crucial otherwise-complete CPU state at the budget
+        // boundary: service runs after the JR delay slot has reached sentinel.
+        iop_test::Host firstHost;
+        IopEmulator::Impl first(firstHost);
+        if (!check(prepare(first), "could not prepare nested boundary fixture")) return false;
+        first.pendingGuestCallbacks.emplace(2u, IopEmulator::Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+        IopCpuState outer{};
+        outer.pc = 0x11000u;
+        outer.gpr[29] = 0x13FE0u;
+        outer.gpr[31] = kCallReturnSentinel;
+        first.runCpu(outer, 2000000u);
+        if (!check(first.resetRequired && first.totalInstructions >= 2000000u,
+                   "nested callback did not latch failure at the outer budget boundary") ||
+            !check(outer.pc == kCallReturnSentinel && !outer.yielded && !outer.missingImport && !outer.executionFault,
+                   "outer CPU failed for a reason other than the nested fault latch")) return false;
+
+        // The actual outer devctl must propagate that latch, preserving both
+        // file slots. A local return sentinel cannot release outer scratch.
+        iop_test::Host secondHost;
+        IopEmulator::Impl second(secondHost);
+        if (!check(prepare(second), "could not prepare outer devctl fixture")) return false;
+        second.pendingGuestCallbacks.emplace(2u, IopEmulator::Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+        IopCpuState caller{};
+        caller.gpr[4] = 0x130A0u;
+        caller.gpr[5] = 0x4391u;
+        caller.gpr[29] = 0x13FE0u;
+        if (!check(second.ioman.dispatchImport(31u, caller, second) && second.resetRequired && caller.executionFault,
+                   "outer devctl falsely completed after nested callback failure") ||
+            !check(second.ioman.m_devctlScratchInUse[0] && second.ioman.m_devctlScratchInUse[1],
+                   "nested failure released quarantined outer or inner scratch")) return false;
+        uint32_t result = 0u;
+        if (!check(second.executeGuestFunctionWithStackArgumentsChecked(
+                       0x11000u, 0u, 0u, 0u, 0u, 0u, {}, 2u, result) == IopGuestCallStatus::ResetRequired,
+                   "checked executor did not give global fault precedence")) return false;
+
+        // A due callback fails before normal ready-thread selection. Capture a
+        // real ready thread and verify neither its state nor CPU is consumed.
+        iop_test::Host thirdHost;
+        IopEmulator::Impl third(thirdHost);
+        if (!check(prepare(third), "could not prepare scheduling boundary fixture")) return false;
+        third.memory.write32(0x13308u, 0x11300u);
+        third.memory.write32(0x1330Cu, 0x400u);
+        third.memory.write32(0x13310u, 10u);
+        third.memory.write32(0x11300u, 0x3C080001u);
+        third.memory.write32(0x11304u, 0xAD084000u); // observable marker at 14000
+        third.memory.write32(0x11308u, 0x03E00008u);
+        IopCpuState create{};
+        create.gpr[4] = 0x13300u;
+        if (!third.kernel.dispatchThreadImport(4u, create, 0u) || int32_t(create.gpr[2]) <= 0) return false;
+        create.gpr[4] = create.gpr[2];
+        if (!third.kernel.dispatchThreadImport(6u, create, 0u) || create.gpr[2] != 0u) return false;
+        IopThread *ready = third.kernel.beginNextReady(0u);
+        if (!check(ready != nullptr, "fixture thread was not ready")) return false;
+        third.kernel.endTimeslice(*ready, kThreadReturnSentinel);
+        const IopCpuState before = ready->cpu;
+        const auto stateBefore = ready->state;
+        third.pendingGuestCallbacks.emplace(0u, IopEmulator::Impl::ScheduledGuestCallback{0x11200u, 0u, 0u});
+        third.runCycles(1000u);
+        return check(third.resetRequired && stateBefore == IopThreadState::Ready && ready->state == stateBefore,
+                     "service failure selected or changed an unrelated ready thread") &&
+               check(ready->cpu.gpr == before.gpr && ready->cpu.pc == before.pc &&
+                         ready->cpu.hi == before.hi && ready->cpu.lo == before.lo && ready->cpu.cop0 == before.cop0 &&
+                         ready->cpu.pendingLoadReg == before.pendingLoadReg &&
+                         ready->cpu.pendingLoadValue == before.pendingLoadValue && ready->cpu.pendingLoad == before.pendingLoad &&
+                         ready->cpu.branchPending == before.branchPending && ready->cpu.branchTarget == before.branchTarget &&
+                         ready->cpu.yielded == before.yielded && ready->cpu.stopped == before.stopped &&
+                         ready->cpu.exception == before.exception &&
+                         ready->cpu.missingImport == before.missingImport && ready->cpu.executionFault == before.executionFault,
+                     "service failure changed the unrelated thread CPU") &&
+               check(third.memory.read32(0x14000u) == 0u,
+                     "unrelated ready thread executed after service failure");
+    }
+}
