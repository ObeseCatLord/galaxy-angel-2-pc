+PS2IopHostAdapter::CallScope PS2IopHostAdapter::enterCycleCall(uint8_t *rdram)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    // A nested pump retains its current invocation token, context and backing.
+    // Only an unscoped ordinary worker advance needs a new serialized scope.
+    if (m_activeToken != 0u) return {};
+    return enterCall(nullptr, rdram);
+}
+
+namespace
+{
+    bool nativeRpcRamRange(uint32_t address, size_t size)
+    {
+        // Main RAM and its existing direct/uncached/kseg aliases only. The
+        // general pointer helper mirrors other addresses; SDK metadata must
+        // not turn a malformed pointer into a different valid list node.
+        const bool alias = address < 0x20000000u ||
+                           (address >= 0x20000000u && address < 0x40000000u) ||
+                           (address >= 0x80000000u && address < 0xC0000000u);
+        const uint32_t physical = address & 0x1FFFFFFFu;
+        return alias && (address & 3u) == 0u && physical < PS2_RAM_SIZE &&
+               size <= PS2_RAM_SIZE - physical;
+    }
+}
+
+void PS2IopHostAdapter::configureNativeEeRpcQueueRoot(uint32_t address)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    if (m_activeToken != 0u)
+        throw std::logic_error("native EE RPC metadata must be configured outside IOP execution");
+    if (!nativeRpcRamRange(address, 4u))
+        throw std::invalid_argument("native EE RPC queue-root address is outside aligned EE RAM");
+    m_nativeEeRpcQueueRoot = address;
+}
+
+ps2x::iop::GuestRpcBinding PS2IopHostAdapter::lookupGuestRpcBinding(uint32_t sid)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_callMutex);
+    if (!m_nativeEeRpcQueueRoot || !m_activeToken)
+        return {}; // no configured SDK authority / no serialized guest call
+    const auto read = [&](uint32_t address, void *out, size_t size, uint8_t *&physical)
+    {
+        if (!address || !nativeRpcRamRange(address, size) || !guestRange(address, size, physical)) return false;
+        std::memcpy(out, physical, size);
+        return true;
+    };
+    uint32_t queueAddress = 0;
+    uint8_t *physical = nullptr;
+    if (!read(m_nativeEeRpcQueueRoot, &queueAddress, 4u, physical)) return {-2, 0u, 0u};
+    // Original SDK membership is authoritative. No native/HLE merge, cached
+    // queue head, registry publication, or fallback on incomplete traversal.
+    std::unordered_set<const uint8_t *> queues, servers;
+    uint32_t remaining = 512u; // one budget shared by both lists
+    while (queueAddress)
+    {
+        std::array<uint32_t, 6> queue{};
+        if (remaining == 0u) return {-5, 0u, 0u};
+        --remaining;
+        if (!read(queueAddress, queue.data(), sizeof(queue), physical)) return {-2, 0u, 0u};
+        if (!queues.insert(physical).second) return {-5, 0u, 0u};
+        uint32_t serverAddress = queue[2];
+        while (serverAddress)
+        {
+            std::array<uint32_t, 17> server{};
+            if (remaining == 0u) return {-5, 0u, 0u};
+            --remaining;
+            if (!read(serverAddress, server.data(), sizeof(server), physical)) return {-2, 0u, 0u};
+            if (!servers.insert(physical).second) return {-5, 0u, 0u};
+            if (server[0] == sid)
+                return {0, serverAddress, server[2]};
+            serverAddress = server[14]; // original SDK link at +0x38
+        }
+        queueAddress = queue[5]; // original SDK next at +0x14
+    }
+    return {0, 0u, 0u}; // fully searched, absent provider
+}
