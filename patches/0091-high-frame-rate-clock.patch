+    m_frameWaitTarget = 0;
+    m_frameLastWaitTick = 0;
+    m_frameWaiting = false;
     m_runtime.memory().gs().vsyncTick.store(0u, std::memory_order_release);
     m_runtime.memory().resetEeTimers();
 
@@ -1901,6 +1913,34 @@ void EeScheduler::completeExternalWait(uint32_t type, uint64_t token, int result
     blockCurrent(std::move(wait));
 }
 
+bool EeScheduler::frameDriven() const noexcept
+{
+    // The game runs a scene at the native rate (ga2_framepace::setNative): the real VBLANK drives the display.
+    return m_frameClockOn && !ga2_framepace::nativeNow() && m_frameTicks - m_frameLastWaitTick <= 6u;
+}
+
+[[noreturn]] void EeScheduler::waitFrameTick(uint32_t interval, std::function<void(R5900Context &)> completion)
+{
+    assertExecutor();
+    const uint64_t fps = std::max<uint32_t>(1u, m_frameFps);
+    if (!m_frameClockOn)
+    {
+        // The clock starts at the first wait; ticks fire from then on.
+        m_frameClockOn = true;
+        m_frameTicks = 0;
+        m_frameLastWake = 0;
+        m_frameCycle0 = m_eeCycle;
+        m_frameHost0 = std::chrono::steady_clock::now();
+        scheduleEvent(m_frameCycle0 + kFrameCycleNumerator / fps,
+                      m_frameHost0 + std::chrono::nanoseconds(kFrameNanosecondNumerator / fps),
+                      EeEvent{EeEventType::FrameTick, 0, 1});
+    }
+    m_frameWaitTarget = std::max<uint64_t>(m_frameLastWake + std::max<uint32_t>(interval, 1u), m_frameTicks + 1u);
+    m_frameWaiting = true;
+    m_frameLastWaitTick = m_frameTicks;
+    blockCurrent(EeWaitState{EeWaitReason::External, EeExternalWait{kFrameWaitType, 0}, std::move(completion)});
+}
+
 GuestThread *EeScheduler::thread(int id)
 {
     auto it = m_threads.find(id);
@@ -2397,6 +2437,19 @@ void EeScheduler::processDueDeadlines()
                               hostBase + kVBlankPeriod,
                               EeEvent{EeEventType::VBlankStart, 0, 0});
             }
+            else if (scheduled.event.type == EeEventType::FrameTick)
+            {
+                // Same rule as the VBLANK chain: after a slow stretch rebase
+                // the host clock instead of firing ticks back to back.
+                const uint64_t fps = std::max<uint32_t>(1u, m_frameFps);
+                const uint64_t next = scheduled.event.value + 1u;
+                const auto late = std::chrono::steady_clock::now() - scheduled.hostDeadline;
+                if (late > std::chrono::milliseconds(50))
+                    m_frameHost0 += late;
+                scheduleEvent(m_frameCycle0 + next * kFrameCycleNumerator / fps,
+                              m_frameHost0 + std::chrono::nanoseconds(next * kFrameNanosecondNumerator / fps),
+                              EeEvent{EeEventType::FrameTick, 0, next});
+            }
             processEvent(scheduled.event);
         }
     }
@@ -2411,8 +2464,12 @@ void EeScheduler::processEvent(const EeEvent &event)
         break;
     case EeEventType::VBlankStart:
         ++m_vsyncTick;
-        if (ga2_pgs::rendering())
+        // At GA2_FPS the frame clock's ticks scan out while the game waits on it.
+        if (ga2_pgs::rendering() && !frameDriven())
             ga2_pgs::vsync(m_runtime.memory().gs());
+        ga2_trace::setClocks(m_vsyncTick, m_frameTicks);
+        if (!m_frameClockOn)
+            ga2_framepace::perfReport(0, m_vsyncTick); // native mode: the same report (flips, presented, CPU)
         {
             // Opt-in speed meter: guest vsyncs per host second (60 = full speed).
             static const bool perf = [] { const char *v = std::getenv("GA2_PERF"); return v && *v && *v != '0'; }();
@@ -2490,6 +2547,28 @@ void EeScheduler::processEvent(const EeEvent &event)
         }
         dispatchIrq(false, 2u);
         break;
+    case EeEventType::FrameTick:
+    {
+        m_frameTicks = event.value;
+        if (m_frameWaiting)
+            m_frameLastWaitTick = m_frameTicks;
+        bool scannedOut = false;
+        if (ga2_pgs::rendering() && frameDriven() && ga2_framepace::scanoutDue(m_frameTicks))
+        {
+            ga2_pgs::vsync(m_runtime.memory().gs());
+            scannedOut = true;
+        }
+        ga2_framepace::notePresentTick(scannedOut);
+        ga2_framepace::perfReport(m_frameTicks, m_vsyncTick);
+        ga2_trace::setClocks(m_vsyncTick, m_frameTicks);
+        if (m_frameWaiting && m_frameTicks >= m_frameWaitTarget)
+        {
+            m_frameWaiting = false;
+            m_frameLastWake = m_frameTicks;
+            completeExternalWait(kFrameWaitType, 0, KE_OK);
+        }
+        break;
+    }
     case EeEventType::ExternalWake:
         completeExternalWait(event.id, event.value, KE_OK);
         break;
