diff --git a/ps2xRuntime/include/runtime/ga2_framepace.h b/ps2xRuntime/include/runtime/ga2_framepace.h
new file mode 100644
index 0000000..0ee65e3
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_framepace.h
@@ -0,0 +1,102 @@
+// High frame rate (GA2_FPS=<61..240>) and the frame-timing oracle trace
+// (GA2_FRAMETRACE=<file>); docs/rendering/horplus-and-framerate.md.
+//
+// The games run one Update(dt) + Render per loop iteration and wait for the
+// VBLANK in RenderFlip. At GA2_FPS=N the game-side hooks
+// (native/compat/ga2_framerate.cpp) give the game dt = 1/(N*1000/1001) and
+// replace that wait with waitTick(): the scheduler keeps a second clock that
+// ticks N*1000/1001 times per second (cycle- and host-paced like the VBLANK
+// chain) and the guest thread sleeps until its next tick. The real VBLANK
+// (vsync counter, IOP, sound, movies) stays at 59.94 Hz. While the game
+// waits on that clock the GS scans out at every tick (a frame is shown for
+// each guest flip) instead of at the emulated VBLANK.
+//
+// Unset or 60 means native timing: nothing here changes behaviour then.
+#pragma once
+
+#include <cstdarg>
+#include <cstdint>
+
+class PS2Runtime;
+
+namespace ga2_framepace
+{
+    // GA2_FPS as an integer in 61..240; 0 = native (unset, 60, invalid, VR,
+    // software GS). Read once.
+    int fps();
+    inline bool enabled() { return fps() > 0; }
+    // Seconds per frame at fps(): 1001 / (1000 * fps) (the NTSC-style
+    // N*1000/1001 rate, so 120 is exactly twice the 59.94 Hz VBLANK).
+    float step();
+    // Frames per second at fps(): fps * 1000 / 1001.
+    double hz();
+
+    // Game thread: sleep until the `interval`-th next frame tick (counted from
+    // the tick this game thread last woke at, like the games' own VBLANK
+    // wait), then resume at `resumePc` with v0 = 0. Never returns.
+    [[noreturn]] void waitTick(PS2Runtime &runtime, uint32_t interval, uint32_t resumePc);
+    // Frame ticks fired so far (0 when the clock never started).
+    uint64_t ticks(const PS2Runtime &runtime);
+
+    // Game thread: this game iteration runs at the native rate (59.94 Hz, the
+    // real VBLANK): the GS scans out at the VBLANK, not at the frame clock.
+    void setNative(bool native);
+    bool nativeNow();
+
+    // Game thread: the game is about to write new display registers (a flip).
+    void noteFlip();
+    uint64_t flips();
+    // Game time (ga2_trace) of the iteration whose frame the last flip showed.
+    double flipGameTime();
+
+    // Scheduler (EE thread): scan out at this tick? True when a flip happened
+    // since the last scan-out (or the screen was not refreshed for a while).
+    bool scanoutDue(uint64_t tick);
+    // Presentation thread: a new frame went to the window.
+    void notePresented();
+    // Scheduler: counters for the GA2_PERF line.
+    void notePresentTick(bool scannedOut);
+    void perfReport(uint64_t tick, uint64_t vsyncTick);
+}
+
+// Scripted pad for the oracle (GA2_PAD_SCRIPT, native/compat/ga2_framerate.cpp):
+// buttons the game sees held (active-high mask in the PS2 pad's bit values),
+// set per game iteration so that runs at different rates press at equal game
+// time. Combined with the real pad in PSPadBackend::readState.
+namespace ga2_framepace
+{
+    enum PadBit : uint16_t
+    {
+        PadSelect = 0x0001, PadL3 = 0x0002, PadR3 = 0x0004, PadStart = 0x0008, PadUp = 0x0010, PadRight = 0x0020,
+        PadDown = 0x0040, PadLeft = 0x0080, PadL2 = 0x0100, PadR2 = 0x0200, PadL1 = 0x0400, PadR1 = 0x0800,
+        PadTriangle = 0x1000, PadCircle = 0x2000, PadCross = 0x4000, PadSquare = 0x8000,
+    };
+    void setScriptedPad(uint16_t held);
+    uint16_t scriptedPad();
+}
+
+// The oracle: one line per game loop iteration plus events, stamped with the
+// game's own time (the sum of the dt it was given) so that runs at different
+// rates can be compared at equal game time (tools/framerate_oracle.py).
+namespace ga2_trace
+{
+    // GA2_FRAMETRACE=<file> is set (the file opens on first use).
+    bool enabled();
+    // Game time (seconds) the world state currently reflects; set by the
+    // Update hook, stamped on every line.
+    void setGameTime(double seconds);
+    double gameTime();
+    // Free-form line: "<kind> gt=<game time> wall=<s> vs=<vsync> tick=<n> <body>".
+    void line(const char *kind, const char *fmt, ...) __attribute__((format(printf, 2, 3)));
+    // The same with an explicit game time.
+    void lineAt(const char *kind, double gameTime, const char *fmt, ...) __attribute__((format(printf, 3, 4)));
+    // F lines (GA2_FRAMETRACE_FRAMES=1): a fingerprint of every frame the GS
+    // scans out, tagged with the game time of the iteration that drew it.
+    bool framesEnabled();
+    void frameSignature(const uint32_t *pixels, uint32_t width, uint32_t height, bool bgra, uint64_t flip, double gameTime);
+    // The guest vsync count and frame tick stamped into lines (scheduler).
+    void setClocks(uint64_t vsync, uint64_t tick);
+    // Starts logging the IOP's sound key-ons and CD reads as events (no-op
+    // unless enabled()).
+    void installObservers();
+}
