+
     constexpr uint64_t kVBlankPeriodCycles = EeScheduler::kEeClockHz * 1001u / 60000u;
     constexpr uint64_t kVBlankDurationCycles = microsecondsToEeCycles(500u);
     constexpr uint64_t kAlarmTickCycles = microsecondsToEeCycles(kAlarmTickMicroseconds);
@@ -150,6 +156,12 @@ void EeScheduler::reset(uint8_t *rdram, const R5900Context &mainContext)
     m_gsVSyncCallback = 0;
     m_gsVSyncCallbackGp = 0;
     m_gsVSyncCallbackSp = 0;
+    m_frameClockOn = false;
+    m_frameTicks = 0;
