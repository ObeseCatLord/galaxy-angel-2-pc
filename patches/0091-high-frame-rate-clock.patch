+#include <vector>
+
+namespace ga2_framepace
+{
+    namespace
+    {
+        int parseFps()
+        {
+            const char *v = std::getenv("GA2_FPS");
+            if (!v || !*v)
+                return 0;
+            const double asked = std::atof(v);
+            const int n = int(std::lround(asked));
+            if (n == 60 || n == 0)
+                return 0;
+            if (n < 61 || n > 240)
+            {
+                std::fprintf(stderr, "[ga2 fps] GA2_FPS=%s is outside 60..240; native timing\n", v);
+                return 0;
+            }
+            // VR presents through the headset's own frame loop and tags each
+            // frame at the emulated VBLANK (ga2_stereo): native pacing there.
+            if (const char *vr = std::getenv("GA2_VR"); vr && std::strcmp(vr, "1") == 0)
+            {
+                std::fprintf(stderr, "[ga2 fps] GA2_FPS ignored in VR (the headset paces the game); native timing\n");
+                return 0;
+            }
+            // Only the GPU GS shows a frame per flip.
+            if (const char *gs = std::getenv("GA2_GS"); gs && std::strcmp(gs, "cpu") == 0)
+            {
+                std::fprintf(stderr, "[ga2 fps] GA2_FPS needs the GPU GS (GA2_GS=cpu); native timing\n");
+                return 0;
+            }
+            std::fprintf(stderr, "[ga2 fps] high frame rate: %d fps (game step %.6f s)\n", n, 1001.0 / (1000.0 * n));
+            return n;
+        }
+
+        std::atomic<uint64_t> g_flips{0}, g_presented{0};
+        // Scheduler thread only.
+        uint64_t g_lastScanFlips = ~0ull;
+        uint64_t g_lastScanTick = 0;
+        struct Stats
+        {
+            uint64_t ticks = 0, scans = 0, flips = 0, vsync = 0, presented = 0;
+            std::chrono::steady_clock::time_point at = std::chrono::steady_clock::now();
+        } g_stats;
+
+        // CPU seconds (user + system) per thread of this process, by thread name.
+        std::map<std::string, double> threadCpu()
+        {
+            std::map<std::string, double> out;
+            if (DIR *dir = opendir("/proc/self/task"))
+            {
+                const double hz = double(sysconf(_SC_CLK_TCK));
+                while (const dirent *e = readdir(dir))
+                {
+                    if (e->d_name[0] == '.')
+                        continue;
+                    char path[96], line[512];
+                    std::snprintf(path, sizeof(path), "/proc/self/task/%s/stat", e->d_name);
+                    if (FILE *f = std::fopen(path, "r"))
+                    {
+                        if (std::fgets(line, sizeof(line), f))
+                        {
+                            const char *open = std::strchr(line, '('), *close = std::strrchr(line, ')');
+                            unsigned long utime = 0, stime = 0;
+                            if (open && close && std::sscanf(close + 2, "%*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %lu %lu", &utime, &stime) == 2)
+                                out[std::string(open + 1, close)] += double(utime + stime) / hz;
+                        }
+                        std::fclose(f);
+                    }
+                }
+                closedir(dir);
+            }
+            return out;
+        }
+        std::map<std::string, double> g_lastCpu;
+    }
+
+    int fps()
+    {
+        static const int value = parseFps();
+        return value;
+    }
+
+    float step() { return fps() > 0 ? float(1001.0 / (1000.0 * fps())) : float(1001.0 / 60000.0); }
+
+    double hz() { return fps() > 0 ? fps() * 1000.0 / 1001.0 : 60000.0 / 1001.0; }
+
+    [[noreturn]] void waitTick(PS2Runtime &runtime, uint32_t interval, uint32_t resumePc)
+    {
+        EeScheduler &scheduler = runtime.eeScheduler();
+        scheduler.configureFrameClock(uint32_t(fps()));
+        scheduler.waitFrameTick(interval, [resumePc](R5900Context &context) { context.pc = resumePc; });
+    }
+
+    uint64_t ticks(const PS2Runtime &runtime) { return runtime.eeScheduler().frameTicks(); }
+
+    void notePresented() { g_presented.fetch_add(1, std::memory_order_relaxed); }
+
+    namespace
+    {
+        std::atomic<uint16_t> g_scriptedPad{0};
+    }
+    void setScriptedPad(uint16_t held) { g_scriptedPad.store(held, std::memory_order_relaxed); }
+    uint16_t scriptedPad() { return g_scriptedPad.load(std::memory_order_relaxed); }
+
+    namespace
+    {
+        std::atomic<double> g_flipTime{0.0};
+        std::atomic<bool> g_native{false};
+    }
+    void setNative(bool native) { g_native.store(native, std::memory_order_relaxed); }
+    bool nativeNow() { return g_native.load(std::memory_order_relaxed); }
+    void noteFlip()
+    {
+        g_flipTime.store(ga2_trace::gameTime(), std::memory_order_relaxed);
+        g_flips.fetch_add(1, std::memory_order_relaxed);
+    }
+    double flipGameTime() { return g_flipTime.load(std::memory_order_relaxed); }
+
+    uint64_t flips() { return g_flips.load(std::memory_order_relaxed); }
+
+    bool scanoutDue(uint64_t tick)
+    {
+        const uint64_t f = flips();
+        if (f != g_lastScanFlips || tick - g_lastScanTick >= 8u)
+        {
+            g_lastScanFlips = f;
+            g_lastScanTick = tick;
+            return true;
+        }
+        return false;
+    }
+
+    void notePresentTick(bool scannedOut)
+    {
+        ++g_stats.ticks;
+        if (scannedOut)
+            ++g_stats.scans;
+    }
+
+    void perfReport(uint64_t tick, uint64_t vsyncTick)
+    {
+        static const bool perf = [] { const char *v = std::getenv("GA2_PERF"); return v && *v && *v != '0'; }();
+        if (!perf)
+            return;
+        const auto now = std::chrono::steady_clock::now();
+        const double seconds = std::chrono::duration<double>(now - g_stats.at).count();
+        if (seconds < 5.0)
+            return;
+        const uint64_t f = flips();
+        std::fprintf(stderr,
+                     "[ga2 fps] tick=%llu ticks %.1f/s, guest flips %.1f/s, scan-outs %.1f/s, presented %.1f/s, vsync %.1f/s (%.0f%% of %d fps)\n",
+                     static_cast<unsigned long long>(tick), double(g_stats.ticks) / seconds,
+                     double(f - g_stats.flips) / seconds, double(g_stats.scans) / seconds,
+                     double(g_presented.load(std::memory_order_relaxed) - g_stats.presented) / seconds,
+                     double(vsyncTick - g_stats.vsync) / seconds,
+                     100.0 * double(f - g_stats.flips) / seconds / hz(), fps() > 0 ? fps() : 60);
+        // Where the host's time goes: busiest threads, as a share of one core.
+        {
+            const auto now = threadCpu();
+            std::string line;
+            std::vector<std::pair<double, std::string>> busy;
+            for (const auto &[name, total] : now)
+            {
+                const double before = g_lastCpu.count(name) ? g_lastCpu[name] : 0.0;
+                if ((total - before) / seconds > 0.02)
+                    busy.push_back({(total - before) / seconds, name});
+            }
+            std::sort(busy.rbegin(), busy.rend());
+            for (size_t i = 0; i < busy.size() && i < 5; ++i)
+            {
+                char part[96];
+                std::snprintf(part, sizeof(part), " %s %.0f%%", busy[i].second.c_str(), busy[i].first * 100.0);
+                line += part;
+            }
+            g_lastCpu = now;
+            std::fprintf(stderr, "[ga2 fps] cpu (share of one core):%s\n", line.c_str());
+        }
+        g_stats.ticks = g_stats.scans = 0;
+        g_stats.flips = f;
+        g_stats.presented = g_presented.load(std::memory_order_relaxed);
+        g_stats.vsync = vsyncTick;
+        g_stats.at = now;
+    }
+}
+
+namespace ga2_trace
+{
+    namespace
+    {
+        std::mutex g_mutex;
+        FILE *g_file = nullptr;
+        bool g_tried = false;
+        std::atomic<double> g_gameTime{0.0};
+        std::atomic<uint64_t> g_vsync{0}, g_tick{0};
+        const std::chrono::steady_clock::time_point g_start = std::chrono::steady_clock::now();
+
+        FILE *file()
+        {
+            if (!g_tried)
+            {
+                g_tried = true;
+                if (const char *path = std::getenv("GA2_FRAMETRACE"); path && *path)
+                {
+                    g_file = std::fopen(path, "w");
+                    if (g_file)
+                        std::setvbuf(g_file, nullptr, _IOLBF, 1 << 16);
+                    else
+                        std::fprintf(stderr, "[ga2 trace] cannot open %s\n", path);
+                }
+            }
+            return g_file;
+        }
+    }
+
+    bool enabled()
+    {
+        static const bool on = [] { const char *p = std::getenv("GA2_FRAMETRACE"); return p && *p; }();
+        return on;
+    }
+
+    void setGameTime(double seconds) { g_gameTime.store(seconds, std::memory_order_relaxed); }
+
+    double gameTime() { return g_gameTime.load(std::memory_order_relaxed); }
+
+    void setClocks(uint64_t vsync, uint64_t tick)
+    {
+        g_vsync.store(vsync, std::memory_order_relaxed);
+        g_tick.store(tick, std::memory_order_relaxed);
+    }
+
+    namespace
+    {
+        void emit(const char *kind, double gt, const char *body)
+        {
+            const double wall = std::chrono::duration<double>(std::chrono::steady_clock::now() - g_start).count();
+            std::lock_guard<std::mutex> lock(g_mutex);
+            if (FILE *f = file())
+                std::fprintf(f, "%s gt=%.7f wall=%.4f vs=%llu tk=%llu %s\n", kind, gt, wall,
+                             static_cast<unsigned long long>(g_vsync.load(std::memory_order_relaxed)),
+                             static_cast<unsigned long long>(g_tick.load(std::memory_order_relaxed)), body);
+        }
+    }
+
+    void line(const char *kind, const char *fmt, ...)
+    {
+        if (!enabled())
+            return;
+        char body[4096];
+        va_list args;
+        va_start(args, fmt);
+        std::vsnprintf(body, sizeof(body), fmt, args);
+        va_end(args);
+        emit(kind, gameTime(), body);
+    }
+
+    void lineAt(const char *kind, double gt, const char *fmt, ...)
+    {
+        if (!enabled())
+            return;
+        char body[4096];
+        va_list args;
+        va_start(args, fmt);
+        std::vsnprintf(body, sizeof(body), fmt, args);
+        va_end(args);
+        emit(kind, gt, body);
+    }
+
+    bool framesEnabled()
+    {
+        static const bool on = enabled() && [] { const char *v = std::getenv("GA2_FRAMETRACE_FRAMES"); return v && *v && *v != '0'; }();
+        return on;
+    }
+
+    // 16 x 14 grid of mean luma (one hex byte each) and the mean colour.
+    void frameSignature(const uint32_t *pixels, uint32_t width, uint32_t height, bool bgra, uint64_t flip, double gameTime)
+    {
+        constexpr uint32_t kCols = 16, kRows = 14;
+        if (!pixels || width < kCols || height < kRows)
+            return;
+        uint64_t luma[kRows][kCols] = {}, count[kRows][kCols] = {};
+        uint64_t sum[3] = {0, 0, 0};
+        for (uint32_t y = 0; y < height; ++y)
+        {
+            const uint32_t row = y * kRows / height;
+            const uint32_t *p = pixels + size_t(y) * width;
+            for (uint32_t x = 0; x < width; ++x)
+            {
+                const uint32_t v = p[x];
+                const uint32_t r = bgra ? (v >> 16) & 0xff : v & 0xff, g = (v >> 8) & 0xff, b = bgra ? v & 0xff : (v >> 16) & 0xff;
+                const uint32_t col = x * kCols / width;
+                luma[row][col] += (r * 299 + g * 587 + b * 114) / 1000;
+                ++count[row][col];
+                sum[0] += r;
+                sum[1] += g;
+                sum[2] += b;
+            }
+        }
+        char blocks[kRows * kCols * 2 + 1];
+        for (uint32_t r = 0; r < kRows; ++r)
+            for (uint32_t c = 0; c < kCols; ++c)
+                std::snprintf(blocks + (r * kCols + c) * 2, 3, "%02x", unsigned(count[r][c] ? luma[r][c] / count[r][c] : 0));
+        const double pixelsTotal = double(width) * height;
+        lineAt("F", gameTime, "flip=%llu mean=%.3f,%.3f,%.3f blocks=%s", static_cast<unsigned long long>(flip),
+               sum[0] / pixelsTotal, sum[1] / pixelsTotal, sum[2] / pixelsTotal, blocks);
+    }
+}
+
+namespace ga2_trace
+{
+    void installObservers()
+    {
+        if (!enabled())
+            return;
+        ps2x::iop::TraceObservers &o = ps2x::iop::traceObservers();
+        // SPU2 register offsets: core = bit 10; KON lo/hi at 0x1A0/0x1A2.
+        o.spuWrite = [](uint32_t offset, uint16_t value) {
+            const uint32_t reg = offset & 0x3ffu;
+            if ((reg == 0x1a0u || reg == 0x1a2u) && value != 0u)
+                line("E", "kind=kon core=%u half=%u mask=%04x", (offset >> 10) & 1u, (reg - 0x1a0u) / 2u, unsigned(value));
+        };
+        o.cdRead = [](uint32_t lsn, uint32_t sectors) { line("E", "kind=cd lsn=%u n=%u", lsn, sectors); };
+    }
+}
