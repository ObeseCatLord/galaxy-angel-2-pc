+++ b/ps2xRuntime/src/lib/ps2_mouse.cpp
@@ -1,6 +1,7 @@
 #include "ps2_mouse.h"
 #include "ps2_mouse_menus.h"
 #include "ps2_host_backend.h"
+#include "runtime/ga2_activity.h"
 
