diff --git a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
new file mode 100644
index 0000000..5166d1f
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
@@ -0,0 +1,260 @@
+// Texture packs for paraLLEl-GS (see gs_texpacks.h): every texture the GS
+// samples is identified by a hash of its decoded RGBA (texels through the
+// palette, at its full 2^TW x 2^TH size), read from the CPU copy of GS memory
+// that the runtime keeps alongside the GPU renderer. A PNG named after that
+// hash in a pack folder replaces it, at any resolution.
+#include "gs_texpacks.h"
+
+#if defined(PS2X_HAVE_PGS)
+
+#include "runtime/gs/ps2_gs_memory.h"
+#include "raylib.h"
+
+#include "device.hpp"
+#include "gs_interface.hpp"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+using namespace Vulkan;
+using namespace ParallelGS;
+
+namespace ga2_texpacks
+{
+    namespace
+    {
+        const uint8_t *g_vram = nullptr;
+        std::mutex g_mutex;
+        std::vector<std::string> g_packs;     // highest priority first
+        std::unordered_map<uint64_t, std::string> g_index;
+        bool g_indexed = false;
+        std::atomic<bool> g_changed{false};
+        std::string g_dumpDir;
+        // paraLLEl-GS tells replacement images apart by address for as long
+        // as it runs, so every image handed out stays alive here (this also
+        // keeps PNGs from being decoded twice).
+        std::unordered_map<std::string, ImageHandle> g_images;
+        std::unordered_set<uint64_t> g_dumped;
+
+        uint32_t expand16(uint32_t c)
+        {
+            const uint32_t r = (c & 31u) << 3, g = ((c >> 5) & 31u) << 3, b = ((c >> 10) & 31u) << 3;
+            const uint32_t a = (c & 0x8000u) ? 0x80u : 0u;
+            return r | (g << 8) | (b << 16) | (a << 24);
+        }
+
+        // One CLUT entry (CSM1 layout) for index i.
+        uint32_t clutEntry(uint8_t *vram, uint32_t cbp, uint32_t cpsm, bool eightBit, uint32_t i)
+        {
+            uint32_t x, y;
+            if (eightBit)
+            {
+                const uint32_t swizzled = (i & 0xE7u) | ((i & 0x08u) << 1) | ((i & 0x10u) >> 1);
+                x = swizzled & 15u;
+                y = swizzled >> 4;
+            }
+            else
+            {
+                x = i & 7u;
+                y = i >> 3;
+            }
+            if (cpsm == 0x02u || cpsm == 0x0Au)
+                return expand16(GSMem::ReadCT16(vram, cbp, 1, x, y));
+            return GSMem::ReadCT32(vram, cbp, 1, x, y);
+        }
+
+        // The texture as RGBA (PS2 alpha, 0x80 = opaque); false for formats
+        // not handled here.
+        bool decode(uint64_t tex0, std::vector<uint32_t> &out, uint32_t &w, uint32_t &h)
+        {
+            uint8_t *vram = const_cast<uint8_t *>(g_vram);
+            const uint32_t tbp = uint32_t(tex0 & 0x3FFFu), tbw = uint32_t((tex0 >> 14) & 0x3Fu);
+            const uint32_t psm = uint32_t((tex0 >> 20) & 0x3Fu);
+            w = 1u << std::min<uint32_t>(10u, uint32_t((tex0 >> 26) & 0xFu));
+            h = 1u << std::min<uint32_t>(10u, uint32_t((tex0 >> 30) & 0xFu));
+            const uint32_t cbp = uint32_t((tex0 >> 37) & 0x3FFFu), cpsm = uint32_t((tex0 >> 51) & 0xFu);
+            out.resize(size_t(w) * h);
+            uint32_t palette[256] = {};
+            const bool p8 = psm == 0x13u || psm == 0x1Bu, p4 = psm == 0x14u || psm == 0x24u || psm == 0x2Cu;
+            if (p8 || p4)
+                for (uint32_t i = 0; i < (p8 ? 256u : 16u); ++i)
+                    palette[i] = clutEntry(vram, cbp, cpsm, p8, i);
+            for (uint32_t y = 0; y < h; ++y)
+                for (uint32_t x = 0; x < w; ++x)
+                {
+                    uint32_t c = 0;
+                    switch (psm)
+                    {
+                    case 0x00u: c = GSMem::ReadCT32(vram, tbp, tbw, x, y); break;
+                    case 0x01u: c = GSMem::ReadCT24(vram, tbp, tbw, x, y) | 0x80000000u; break;
+                    case 0x02u: c = expand16(GSMem::ReadCT16(vram, tbp, tbw, x, y)); break;
+                    case 0x0Au: c = expand16(GSMem::ReadCT16S(vram, tbp, tbw, x, y)); break;
+                    case 0x13u: c = palette[GSMem::ReadP8(vram, tbp, tbw, x, y) & 255u]; break;
+                    case 0x1Bu: c = palette[GSMem::ReadP8H(vram, tbp, tbw, x, y) & 255u]; break;
+                    case 0x14u: c = palette[GSMem::ReadP4(vram, tbp, tbw, x, y) & 15u]; break;
+                    case 0x24u: c = palette[GSMem::ReadP4HL(vram, tbp, tbw, x, y) & 15u]; break;
+                    case 0x2Cu: c = palette[GSMem::ReadP4HH(vram, tbp, tbw, x, y) & 15u]; break;
+                    default: return false;
+                    }
+                    out[size_t(y) * w + x] = c;
+                }
+            return true;
+        }
+
+        uint64_t hashPixels(const std::vector<uint32_t> &px, uint32_t w, uint32_t h)
+        {
+            uint64_t hash = 0x9E3779B97F4A7C15ull ^ (uint64_t(w) << 32 | h);
+            for (uint32_t v : px)
+            {
+                hash ^= v;
+                hash *= 0x100000001B3ull;
+                hash ^= hash >> 29;
+            }
+            return hash;
+        }
+
+        void buildIndex()
+        {
+            g_index.clear();
+            for (const std::string &dir : g_packs)
+            {
+                std::error_code ec;
+                for (auto it = std::filesystem::recursive_directory_iterator(dir, ec);
+                     !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec))
+                {
+                    const auto &p = it->path();
+                    if (p.extension() != ".png")
+                        continue;
+                    const std::string stem = p.stem().string();
+                    if (stem.size() != 16 || stem.find_first_not_of("0123456789abcdef") != std::string::npos)
+                        continue;
+                    g_index.emplace(std::stoull(stem, nullptr, 16), p.string()); // first pack wins
+                }
+            }
+            g_indexed = true;
+            if (!g_packs.empty())
+                std::fprintf(stderr, "[texpacks] %zu replacement textures in %zu pack(s)\n", g_index.size(), g_packs.size());
+        }
+
+        std::vector<std::string> splitList(const char *list)
+        {
+            std::vector<std::string> out;
+            if (!list)
+                return out;
+            std::string s = list;
+            size_t start = 0;
+            while (start <= s.size())
+            {
+                size_t end = s.find(';', start);
+                if (end == std::string::npos)
+                    end = s.size();
+                if (end > start)
+                    out.push_back(s.substr(start, end - start));
+                start = end + 1;
+            }
+            return out;
+        }
+
+        class Replacement final : public TextureReplacementInterface
+        {
+        public:
+            ImageHandle replace(const TextureDescriptor &, uint64_t tex0, uint64_t, Device &device) override
+            {
+                if (!g_vram)
+                    return {};
+                std::lock_guard<std::mutex> lock(g_mutex);
+                if (!g_indexed)
+                    buildIndex();
+                if (g_index.empty() && g_dumpDir.empty())
+                    return {};
+                std::vector<uint32_t> px;
+                uint32_t w = 0, h = 0;
+                if (!decode(tex0, px, w, h))
+                    return {};
+                const uint64_t hash = hashPixels(px, w, h);
+                char name[32];
+                std::snprintf(name, sizeof(name), "%016llx", static_cast<unsigned long long>(hash));
+                if (!g_dumpDir.empty() && g_dumped.insert(hash).second)
+                {
+                    // PNG alpha 255 = opaque (the GS's 0x80 doubled).
+                    std::vector<uint32_t> png(px);
+                    for (uint32_t &c : png)
+                    {
+                        const uint32_t a = std::min<uint32_t>(255u, (c >> 24) * 2u);
+                        c = (c & 0x00FFFFFFu) | (a << 24);
+                    }
+                    ::Image image{png.data(), int(w), int(h), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+                    ExportImage(image, (std::filesystem::path(g_dumpDir) / (std::string(name) + ".png")).string().c_str());
+                }
+                const auto it = g_index.find(hash);
+                if (it == g_index.end())
+                    return {};
+                if (const auto cached = g_images.find(it->second); cached != g_images.end())
+                    return cached->second;
+                ::Image image = LoadImage(it->second.c_str());
+                if (!image.data)
+                    return {};
+                ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                // Back to the GS's alpha range.
+                auto *texels = static_cast<uint32_t *>(image.data);
+                for (int i = 0; i < image.width * image.height; ++i)
+                {
+                    const uint32_t a = ((texels[i] >> 24) + 1u) >> 1;
+                    texels[i] = (texels[i] & 0x00FFFFFFu) | (a << 24);
+                }
+                // paraLLEl-GS takes replacement images in the GENERAL layout.
+                ImageCreateInfo info = ImageCreateInfo::immutable_2d_image(uint32_t(image.width), uint32_t(image.height),
+                                                                          VK_FORMAT_R8G8B8A8_UNORM);
+                info.initial_layout = VK_IMAGE_LAYOUT_GENERAL;
+                info.usage |= VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+                ImageInitialData initial{image.data, 0, 0};
+                ImageHandle handle = device.create_image(info, &initial);
+                UnloadImage(image);
+                g_images.emplace(it->second, handle);
+                return handle;
+            }
+        };
+
+        Replacement g_replacement;
+    }
+
+    void setVram(const uint8_t *vram) { g_vram = vram; }
+
+    TextureReplacementInterface *interface()
+    {
+        static bool configured = false;
+        if (!configured)
+        {
+            configured = true;
+            std::lock_guard<std::mutex> lock(g_mutex);
+            g_packs = splitList(std::getenv("GA2_TEXTURE_PACKS"));
+            if (const char *dump = std::getenv("GA2_TEX_DUMP"); dump && *dump)
+            {
+                g_dumpDir = dump;
+                std::error_code ec;
+                std::filesystem::create_directories(g_dumpDir, ec);
+            }
+        }
+        return &g_replacement;
+    }
+
+    void setPacks(const std::vector<std::string> &dirs)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        if (dirs == g_packs)
+            return;
+        g_packs = dirs;
+        g_indexed = false;
+        g_changed.store(true);
+    }
+
+    bool takeChanged() { return g_changed.exchange(false); }
+}
+
+#endif
diff --git a/ps2xRuntime/src/lib/gs/gs_texpacks.h b/ps2xRuntime/src/lib/gs/gs_texpacks.h
new file mode 100644
index 0000000..e1d6feb
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_texpacks.h
@@ -0,0 +1,30 @@
+// Texture packs and dumps for the paraLLEl-GS bridge (gs_texpacks.cpp).
+//
+//   GA2_TEXTURE_PACKS=<dir>[;<dir>...]  folders of <hash>.png replacements
+//                                       (first folder wins; any resolution)
+//   GA2_TEX_DUMP=<dir>                  writes every texture the GS samples
+//                                       as <hash>.png (alpha 255 = opaque)
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#if defined(PS2X_HAVE_PGS)
+namespace ParallelGS
+{
+    class TextureReplacementInterface;
+}
+
+namespace ga2_texpacks
+{
+    // The CPU copy of GS memory (texels are decoded from it).
+    void setVram(const uint8_t *vram);
+    ParallelGS::TextureReplacementInterface *interface();
+    // Replace the pack list (e.g. button packs on a device change).
+    void setPacks(const std::vector<std::string> &dirs);
+    // The pack list changed since the last call (the bridge then drops its
+    // cached textures).
+    bool takeChanged();
+}
+#endif
