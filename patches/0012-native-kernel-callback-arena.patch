+    void irqHandler(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        const uint32_t sp = getReg(*ctx, 29);
+        writeU32(ram, kCallbackSpAddress, sp);
+        writeU32(ram, kBorrowerIdAddress, static_cast<uint32_t>(scheduler.currentThreadId()));
+        writeU32(ram, kHandlerGpAddress, getReg(*ctx, 28));
+        writeU32(ram, kHandlerRunsAddress, readU32(ram, kHandlerRunsAddress) + 1u);
+        writeU64(ram, sp - kStoreOffset, kIrqPoison);
+
+        scheduler.signalSemaphore(static_cast<int>(readU32(ram, kSemaphoreIdAddress)), true);
+
+        EeThreadCreateParams child{};
+        child.entry = kChildEntry;
+        child.stack = kChildStack;
+        child.stackSize = kChildStackSize;
+        child.priority = 10;
+        const int childId = scheduler.createThread(child);
+        writeU32(ram, kChildIdAddress, static_cast<uint32_t>(childId));
+        scheduler.startThread(childId, 0u, *ctx, true);
+
+        ctx->pc = kIrqResume;
+        scheduler.sleepCurrent();
+    }
+
+    void parentResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeU32(ram, kParentResumeRunsAddress, readU32(ram, kParentResumeRunsAddress) + 1u);
+        if (readU32(ram, kCallbackDoneAddress) == 0u)
+        {
+            writeU32(ram, kParentMarkerAddress, kParentMarker);
+            ctx->pc = kParentResume;
+            runtime->eeScheduler().sleepCurrent();
+        }
+
+        const bool contextIntact = getReg(*ctx, 28) == kParentGp && getReg(*ctx, 16) == kParentS0;
+        writeU32(ram, kParentContextIntactAddress, contextIntact ? 1u : 0u);
+        writeU32(ram, kParentFinalAddress, 1u);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void childEntry(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        const uint32_t callbackSp = readU32(ram, kCallbackSpAddress);
+        const uint64_t poison = readU64(ram, callbackSp - kStoreOffset);
+        const bool callbackBorrowedFromParent = inside(callbackSp, kMainStackBase, kMainStackLimit);
+        const bool parentRanBeforeCompletion = readU32(ram, kParentResumeRunsAddress) != 0u;
+
+        writeU32(ram, kChildRunsAddress, readU32(ram, kChildRunsAddress) + 1u);
+        writeU32(ram, kChildPoisonIntactAddress, poison == kIrqPoison ? 1u : 0u);
+        writeU32(ram, kBorrowedParentResumedAddress,
+                 callbackBorrowedFromParent && parentRanBeforeCompletion ? 1u : 0u);
+        scheduler.wakeupThread(static_cast<int>(readU32(ram, kBorrowerIdAddress)), false);
+        ctx->pc = 0u;
+    }
+
+    void irqResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t sp = getReg(*ctx, 29);
+        writeU32(ram, kCallbackPoisonIntactAddress,
+                 readU64(ram, sp - kStoreOffset) == kIrqPoison ? 1u : 0u);
+        setReg(*ctx, 28, 0xDEADC0DEu);
+        setReg(*ctx, 16, 0xBAD0BEEFu);
+        writeU32(ram, kCallbackDoneAddress, 1u);
+
+        const GuestThread *parent = runtime->eeScheduler().thread(EeScheduler::kMainThreadId);
+        if (parent && parent->status == EeThreadStatus::Waiting && parent->wait.reason == EeWaitReason::Sleep)
+        {
+            runtime->eeScheduler().wakeupThread(EeScheduler::kMainThreadId, false);
+        }
+        ctx->pc = 0u;
+    }
+
+    void arenaDriver(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        std::memset(ram + kArenaState, 0, 0x34u);
+        const uint32_t owners = getReg(*ctx, 4);
+        for (uint32_t id = 1u; id <= owners; ++id)
+        {
+            GuestInvocation invocation{};
+            invocation.context.pc = kArenaOuter;
+            setReg(invocation.context, 4, id);
+            runtime->eeScheduler().queueInvocation(std::move(invocation));
+        }
+        if (owners == 2u)
+        {
+            ctx->pc = kArenaWake;
+            runtime->eeScheduler().sleepCurrent();
+        }
+        ctx->pc = 0u;
+    }
+
+    void arenaOuter(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t id = getReg(*ctx, 4), sp = getReg(*ctx, 29);
+        writeU32(ram, arenaSlot(0u, id), sp);
+        writeU32(ram, arenaSlot(0x10u, id), static_cast<uint32_t>(runtime->eeScheduler().currentThreadId()));
+        writeU64(ram, sp - kStoreOffset, kArenaOuterPoison);
+        GuestInvocation nested{};
+        nested.context = *ctx;
+        nested.context.pc = kArenaNested;
+        setReg(nested.context, 29, 0u);
+        setReg(nested.context, 31, 0u);
+        ctx->pc = kArenaOuterResume;
+        runtime->eeScheduler().invokeCurrent(std::move(nested));
+    }
+
+    void arenaNested(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t id = getReg(*ctx, 4), sp = getReg(*ctx, 29);
+        writeU32(ram, arenaSlot(8u, id), sp);
+        writeU64(ram, sp - kStoreOffset, kArenaNestedPoison);
+        if (id == 2u)
+            runtime->eeScheduler().wakeupThread(EeScheduler::kMainThreadId, true);
+        ctx->pc = kArenaNestedResume;
+        runtime->eeScheduler().sleepCurrent();
+    }
+
+    void arenaNestedResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        const uint32_t id = getReg(*ctx, 4);
+        writeU32(ram, arenaSlot(0x28u, id), readU64(ram, getReg(*ctx, 29) - kStoreOffset) == kArenaNestedPoison ? 1u : 0u);
+        ctx->pc = 0u;
+    }
+
+    void arenaOuterResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t id = getReg(*ctx, 4);
+        writeU32(ram, arenaSlot(0x20u, id), readU64(ram, getReg(*ctx, 29) - kStoreOffset) == kArenaOuterPoison ? 1u : 0u);
+        if (readU32(ram, kArenaState + 0x30u) + 1u == 2u) runtime->requestStop();
+        writeU32(ram, kArenaState + 0x30u, readU32(ram, kArenaState + 0x30u) + 1u);
+        ctx->pc = 0u;
+    }
+
+    void arenaWake(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        for (uint32_t id = 1u; id <= 2u; ++id)
+            runtime->eeScheduler().wakeupThread(static_cast<int>(readU32(ram, arenaSlot(0x10u, id))), false);
+        ctx->pc = 0u;
+    }
+}
