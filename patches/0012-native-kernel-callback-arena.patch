+        throw std::logic_error("EE callback arena configuration has outstanding reservations");
+    const auto overlaps = [begin, end](uint64_t first, uint64_t last)
+    { return first < last && begin < last && first < end; };
+    if (overlaps(m_runtime.guestHeapBase(), m_runtime.guestHeapLimit()))
+        throw std::runtime_error("EE callback arena overlaps guest heap entitlement");
+    // Existing native SDK packet/server/TLS/boot-mode pools are fixed claims.
+    if (overlaps(0x01F00000u, 0x01F31000u))
+        throw std::runtime_error("EE callback arena overlaps native SDK storage");
+    for (const auto &[id, owner] : m_threads)
+    {
+        if (!owner.invocations.empty())
+            throw std::logic_error("EE callback arena configuration has live invocations");
+        if (id <= 0 || (owner.stack == 0u && owner.stackSize == 0u) ||
+            (owner.stack == 0u && owner.status == EeThreadStatus::Dormant)) continue;
+        uint32_t base = 0u;
+        bool scratch = false;
+        if (owner.stackSize == 0u ||
