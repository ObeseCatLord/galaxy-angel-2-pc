diff --git a/ps2xIOP/src/iop_reboot_image.cpp b/ps2xIOP/src/iop_reboot_image.cpp
new file mode 100644
index 0000000..bf582e6
--- /dev/null
+++ b/ps2xIOP/src/iop_reboot_image.cpp
@@ -0,0 +1,99 @@
+#include "ps2x/iop/iop_reboot_image.h"
+#include "ps2x/iop/ps2_path.h"
+#include <algorithm>
+#include <array>
+#include <set>
+
+namespace ps2x::iop
+{
+    namespace
+    {
+        uint32_t word(std::span<const uint8_t> b, size_t p)
+        { return uint32_t(b[p]) | uint32_t(b[p+1]) << 8 | uint32_t(b[p+2]) << 16 | uint32_t(b[p+3]) << 24; }
+    }
+
+    bool parseRebootImage(std::span<const uint8_t> image, std::vector<RebootImageEntry> &entries)
+    {
+        entries.clear();
+        if (image.size() < 32u || image.size() > 16u * 1024u * 1024u) return false;
+        constexpr std::array<uint8_t, 10> reset{'R','E','S','E','T',0,0,0,0,0};
+        for (size_t start = 0; start + 16u <= std::min(image.size(), size_t(512u * 1024u)); start += 16u)
+        {
+            if (!std::equal(reset.begin(), reset.end(), image.begin() + start)) continue;
+            std::vector<RebootImageEntry> candidate;
+            std::set<std::string> names;
+            size_t offset = 0, extTotal = 0;
+            bool terminated = false;
+            for (size_t n = 0; n < 512u; ++n)
+            {
+                const size_t p = start + n * 16u;
+                if (p + 16u > image.size()) return false;
+                const uint32_t size = word(image, p + 12u);
+                const uint32_t ext = image[p+10] | uint32_t(image[p+11]) << 8;
+                std::string name;
+                bool padding = false;
+                for (size_t j = 0; j < 10u; ++j)
+                {
+                    const char c = char(image[p+j]);
+                    if (!c) { padding = true; continue; }
+                    if (padding || !((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_')) return false;
+                    name += c;
+                }
+                if (name.empty()) { if (size || ext) return false; terminated = true; break; }
+                if (!names.insert(name).second || offset > image.size() || size > image.size() - offset) return false;
+                candidate.push_back({name, uint32_t(offset), size});
+                offset += (size_t(size) + 15u) & ~size_t(15u);
+                extTotal += ext;
+            }
+            if (!terminated) return false;
+            const auto directory = std::find_if(candidate.begin(), candidate.end(), [](const auto &e) { return e.name == "ROMDIR"; });
+            const auto extension = std::find_if(candidate.begin(), candidate.end(), [](const auto &e) { return e.name == "EXTINFO"; });
+            if (directory == candidate.end() || directory->offset != start ||
+                directory->size < (candidate.size() + 1u) * 16u || extension == candidate.end() || extension->size != extTotal) return false;
+            entries = std::move(candidate);
+            return true;
+        }
+        return false;
+    }
+
+    std::optional<std::string> RebootTransferTracker::observe(const SifTransfer &t,
+                                                            std::span<const uint8_t> packet,
+                                                            uint32_t subAddress)
+    {
+        if (t.phase == SifTransferPhase::BeforeCopy)
+        {
+            m_before = t;
+            return {};
+        }
+        auto before = m_before;
+        m_before.reset();
+        if (!before || t.kind != SifTransferKind::SetDma || before->kind != t.kind ||
+            before->sourceAddress != t.sourceAddress || before->destinationAddress != t.destinationAddress ||
+            before->size != t.size || before->attributes != t.attributes || t.size != 104u || t.attributes != 0x44u ||
+            (t.destinationAddress != 0u && t.destinationAddress != subAddress) || packet.size() != 104u) return {};
+        if (word(packet, 0u) != 104u || word(packet, 4u) != 0u || word(packet, 8u) != 0x80000003u ||
+            word(packet, 12u) != 0u || word(packet, 20u) != 0u) return {};
+        const uint32_t argSize = word(packet, 16u);
+        if (!argSize || argSize > 80u) return {};
+        // The observed original SDK supplies strlen(args), excluding NUL;
+        // tolerate a counted terminator too, but require it inside the packet.
+        const bool countedNull = packet[24u + argSize - 1u] == 0u;
+        if (!countedNull && (argSize == 80u || packet[24u + argSize] != 0u)) return {};
+        const auto args = packet.subspan(24u, argSize - (countedNull ? 1u : 0u));
+        if (std::find(args.begin(), args.end(), 0u) != args.end()) return {};
+        const std::string command(args.begin(), args.end());
+        constexpr std::string_view prefix = "rom0:UDNL ";
+        if (!command.starts_with(prefix)) return {};
+        const std::string path = command.substr(prefix.size());
+        const auto parsed = parsePs2Path(path);
+        if (!parsed || parsed.device != Ps2PathDevice::Cdrom) return {};
+        std::string normalized;
+        for (char c : parsed.path)
+        {
+            if (c == '/' && !normalized.empty() && normalized.back() == '/') continue;
+            normalized += c;
+        }
+        if (normalized != "MODULES/IOPRP300.IMG") return {};
+        return "cdrom0:" + normalized;
+    }
+}
