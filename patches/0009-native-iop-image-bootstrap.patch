diff --git a/ps2xIOP/tests/iop_reboot_image_tests.cpp b/ps2xIOP/tests/iop_reboot_image_tests.cpp
new file mode 100644
index 0000000..32c86a0
--- /dev/null
+++ b/ps2xIOP/tests/iop_reboot_image_tests.cpp
@@ -0,0 +1,70 @@
+#include "ps2x/iop/iop_reboot_image.h"
+#include <array>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+using namespace ps2x::iop;
+static void require(bool value, const char *message) { if (!value) throw std::runtime_error(message); }
+static void word(std::span<uint8_t> data, size_t offset, uint32_t value)
+{ for (size_t n = 0; n < 4; ++n) data[offset+n] = uint8_t(value >> (8*n)); }
+int main(int argc, char **argv)
+{
+    try
+    {
+        std::array<uint8_t,104> packet{};
+        word(packet,0,104); word(packet,8,0x80000003);
+        constexpr char args[] = "rom0:UDNL cdrom0:\\MODULES\\IOPRP300.IMG;1";
+        word(packet,16,sizeof(args)); std::memcpy(packet.data()+24,args,sizeof(args));
+        SifTransfer t{SifTransferKind::SetDma,SifTransferPhase::BeforeCopy,0x834080,0,104,0x44};
+        RebootTransferTracker tracker;
+        require(!tracker.observe(t,{},0),"BeforeCopy acted on command");
+        t.phase = SifTransferPhase::AfterCopy;
+        auto path=tracker.observe(t,packet,0);
+        require(path && *path == "cdrom0:MODULES/IOPRP300.IMG","original command not recognized");
+        require(!tracker.observe(t,packet,0),"duplicate AfterCopy rebooted");
+        // Exact observed packet has doubled separators and excludes the NUL
+        // from arglen; it resolves to the same verified ISO file.
+        auto observed = packet;
+        constexpr char originalArgs[] = "rom0:UDNL cdrom0:\\\\MODULES\\\\IOPRP300.IMG;1";
+        std::fill(observed.begin()+24,observed.end(),0);
+        std::memcpy(observed.data()+24,originalArgs,sizeof(originalArgs));
+        word(observed,16,sizeof(originalArgs)-1u);
+        t.phase=SifTransferPhase::BeforeCopy;tracker.observe(t,{},0);t.phase=SifTransferPhase::AfterCopy;
+        require(tracker.observe(t,observed,0)==path,"observed SDK strlen/doubled separator contract rejected");
+        auto checkRejected=[&](auto mutate)
+        {
+            auto p=packet; auto transfer=t;
+            transfer.phase=SifTransferPhase::BeforeCopy; tracker.observe(transfer,{},0);
+            transfer.phase=SifTransferPhase::AfterCopy; mutate(p,transfer);
+            require(!tracker.observe(transfer,p,0),"malformed command accepted");
+        };
+        checkRejected([](auto &p,auto &){word(p,8,0x80000002);});
+        checkRejected([](auto &p,auto &){word(p,0,103);});
+        checkRejected([](auto &p,auto &){word(p,16,81);});
+        checkRejected([](auto &p,auto &){word(p,20,1);});
+        checkRejected([](auto &p,auto &){p[24]=0;});
+        checkRejected([](auto &,auto &s){s.attributes=4;});
+        checkRejected([](auto &,auto &s){s.sourceAddress+=16;});
+        checkRejected([](auto &,auto &s){s.destinationAddress=16;});
+
+        std::vector<uint8_t> image(80,0); std::vector<RebootImageEntry> entries;
+        std::memcpy(image.data(),"RESET",5);
+        std::memcpy(image.data()+16,"ROMDIR",6);word(image,28,64);
+        std::memcpy(image.data()+32,"EXTINFO",7);
+        require(parseRebootImage(image,entries) && entries.size()==3,"valid bounded ROMDIR rejected");
+        auto bad=image;word(bad,28,0xffffffff);require(!parseRebootImage(bad,entries),"oversized extent accepted");
+        bad=image;word(bad,44,1);require(!parseRebootImage(bad,entries),"extinfo mismatch accepted");
+        bad=image;bad[6]='X';require(!parseRebootImage(bad,entries),"malformed RESET padding accepted");
+        for(int n=1;n<argc;++n)
+        {
+            std::ifstream file(argv[n],std::ios::binary);
+            std::vector<uint8_t> original((std::istreambuf_iterator<char>(file)),{});
+            require(parseRebootImage(original,entries),"supplied original image rejected");
+            std::cout << "original ROMDIR entries=" << entries.size() << '\n';
+        }
+        std::cout << "reboot descriptor/image checks passed\n";
+        return 0;
+    }
+    catch(const std::exception &e) { std::cerr << e.what() << '\n'; return 1; }
+}
