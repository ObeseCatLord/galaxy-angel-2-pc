+#pragma once
+#include "ps2x/iop/iop_types.h"
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace ps2x::iop
+{
+    struct RebootImageEntry { std::string name; uint32_t offset; uint32_t size; };
+    // ROMDIR is an IOP image format, independent of the mounted ISO filesystem.
+    bool parseRebootImage(std::span<const uint8_t> image, std::vector<RebootImageEntry> &entries);
+
+    // One successful copy consumes one matching BeforeCopy descriptor. No packet
+    // pointers survive service callbacks or the destructive reset boundary.
+    class RebootTransferTracker
+    {
+    public:
+        std::optional<std::string> observe(const SifTransfer &transfer,
+                                          std::span<const uint8_t> packet,
+                                          uint32_t subAddress);
+        void clear() { m_before.reset(); }
+    private:
+        std::optional<SifTransfer> m_before;
+    };
+}
