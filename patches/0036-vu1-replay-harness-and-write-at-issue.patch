diff --git a/ps2xTest/src/ga2_vu1_replay.cpp b/ps2xTest/src/ga2_vu1_replay.cpp
new file mode 100644
index 0000000..7020fcd
--- /dev/null
+++ b/ps2xTest/src/ga2_vu1_replay.cpp
@@ -0,0 +1,211 @@
+// Replays a GA2_VU1CAP capture through this build's VU1 interpreter and checks
+// every run against the digests the capturing build recorded. Also reports the
+// replay time, which makes it a VU1 microbenchmark.
+//
+//   ga2_vu1_replay <capture> [--repeat N] [--verbose]
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+    struct Run
+    {
+        uint32_t kind, startPC, top, itop, maxCycles;
+        uint64_t cycleBefore, codeHash;
+        VU1State state;
+        std::vector<uint8_t> data;
+        uint64_t stateDigest, dataDigest, gifDigest, gifBytes, cycleAfter;
+        uint32_t ended;
+    };
+
+    struct Reader
+    {
+        const std::vector<uint8_t> &buf;
+        size_t pos = 0;
+        bool ok = true;
+        template <typename T>
+        T get()
+        {
+            T v{};
+            if (pos + sizeof(T) > buf.size()) { ok = false; return v; }
+            std::memcpy(&v, buf.data() + pos, sizeof(T));
+            pos += sizeof(T);
+            return v;
+        }
+        bool bytes(void *dst, size_t n)
+        {
+            if (pos + n > buf.size()) { ok = false; return false; }
+            std::memcpy(dst, buf.data() + pos, n);
+            pos += n;
+            return true;
+        }
+    };
+
+    struct GifHash
+    {
+        uint64_t digest = 1469598103934665603ull;
+        uint64_t bytes = 0;
+    };
+
+    void gifSink(void *user, const uint8_t *data, uint32_t size)
+    {
+        auto *g = static_cast<GifHash *>(user);
+        g->digest = VU1Interpreter::digestBytes(data, size, g->digest);
+        g->bytes += size;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 2)
+    {
+        std::fprintf(stderr, "usage: %s <capture> [--repeat N] [--verbose]\n", argv[0]);
+        return 2;
+    }
+    int repeat = 1;
+    bool verbose = false;
+    for (int i = 2; i < argc; ++i)
+    {
+        if (!std::strcmp(argv[i], "--repeat") && i + 1 < argc)
+            repeat = std::max(1, std::atoi(argv[++i]));
+        else if (!std::strcmp(argv[i], "--verbose"))
+            verbose = true;
+    }
+
+    std::vector<uint8_t> buf;
+    {
+        std::FILE *f = std::fopen(argv[1], "rb");
+        if (!f) { std::perror(argv[1]); return 2; }
+        std::fseek(f, 0, SEEK_END);
+        buf.resize(static_cast<size_t>(std::ftell(f)));
+        std::fseek(f, 0, SEEK_SET);
+        if (std::fread(buf.data(), 1, buf.size(), f) != buf.size()) { std::perror("read"); return 2; }
+        std::fclose(f);
+    }
+
+    std::unordered_map<uint64_t, std::vector<uint8_t>> codes;
+    std::vector<Run> runs;
+    Reader r{buf};
+    while (r.ok && r.pos < buf.size())
+    {
+        const uint32_t magic = r.get<uint32_t>();
+        if (magic == 0x43314356u)
+        {
+            const uint64_t hash = r.get<uint64_t>();
+            std::vector<uint8_t> code(r.get<uint32_t>());
+            r.bytes(code.data(), code.size());
+            codes[hash] = std::move(code);
+        }
+        else if (magic == 0x52315256u)
+        {
+            Run run{};
+            run.kind = r.get<uint32_t>();
+            run.startPC = r.get<uint32_t>();
+            run.top = r.get<uint32_t>();
+            run.itop = r.get<uint32_t>();
+            run.maxCycles = r.get<uint32_t>();
+            run.cycleBefore = r.get<uint64_t>();
+            run.codeHash = r.get<uint64_t>();
+            (void)r.get<uint32_t>(); // code size
+            if (r.get<uint32_t>() != sizeof(VU1State)) { std::fprintf(stderr, "VU1State layout differs from the capture\n"); return 2; }
+            r.bytes(&run.state, sizeof(VU1State));
+            run.data.resize(r.get<uint32_t>());
+            r.bytes(run.data.data(), run.data.size());
+            run.stateDigest = r.get<uint64_t>();
+            run.dataDigest = r.get<uint64_t>();
+            run.gifDigest = r.get<uint64_t>();
+            run.gifBytes = r.get<uint64_t>();
+            run.cycleAfter = r.get<uint64_t>();
+            run.ended = r.get<uint32_t>();
+            if (r.ok)
+                runs.push_back(std::move(run));
+        }
+        else
+            break; // truncated tail of a capture that was still being written
+    }
+    std::printf("capture: %zu runs, %zu code images\n", runs.size(), codes.size());
+
+    auto memory = std::make_unique<PS2Memory>();
+    if (!memory->initialize()) { std::fprintf(stderr, "PS2Memory init failed\n"); return 2; }
+    auto gs = std::make_unique<GS>();
+    auto vu = std::make_unique<VU1Interpreter>(VU1Interpreter::Unit::VU1);
+    GifHash gif;
+    vu->setGifSink(gifSink, &gif);
+
+    uint64_t mismatches = 0, cycles = 0;
+    double seconds = 0.0;
+    for (int pass = 0; pass < repeat; ++pass)
+    {
+        uint64_t loadedCode = 0;
+        bool haveCode = false;
+        for (size_t i = 0; i < runs.size(); ++i)
+        {
+            const Run &run = runs[i];
+            const auto code = codes.find(run.codeHash);
+            if (code == codes.end()) { std::fprintf(stderr, "run %zu: missing code image\n", i); return 2; }
+            if (!haveCode || loadedCode != run.codeHash)
+            {
+                // Through the bus so the code generation advances like a VIF MPG.
+                for (uint32_t off = 0; off < code->second.size(); off += 4u)
+                {
+                    uint32_t word;
+                    std::memcpy(&word, code->second.data() + off, 4);
+                    memory->write32(0x11008000u + off, word);
+                }
+                loadedCode = run.codeHash;
+                haveCode = true;
+            }
+            std::memcpy(memory->getVU1Data(), run.data.data(), run.data.size());
+            gif = GifHash{};
+            vu->restoreForReplay(run.state, run.cycleBefore);
+
+            const auto t0 = std::chrono::steady_clock::now();
+            if (run.kind == 0u)
+                vu->execute(memory->getVU1Code(), static_cast<uint32_t>(code->second.size()),
+                            memory->getVU1Data(), static_cast<uint32_t>(run.data.size()), *gs, memory.get(),
+                            run.startPC, run.top, run.itop, run.maxCycles);
+            else
+                vu->resume(memory->getVU1Code(), static_cast<uint32_t>(code->second.size()),
+                           memory->getVU1Data(), static_cast<uint32_t>(run.data.size()), *gs, memory.get(),
+                           run.top, run.itop, run.maxCycles);
+            seconds += std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+            cycles += vu->cycle() - run.cycleBefore;
+
+            if (pass != 0)
+                continue;
+            const uint64_t stateDigest = VU1Interpreter::digestState(vu->state());
+            const uint64_t dataDigest = VU1Interpreter::digestBytes(memory->getVU1Data(), run.data.size());
+            const bool ok = stateDigest == run.stateDigest && dataDigest == run.dataDigest &&
+                            gif.digest == run.gifDigest && gif.bytes == run.gifBytes &&
+                            vu->cycle() == run.cycleAfter;
+            if (!ok)
+            {
+                ++mismatches;
+                if (verbose || mismatches <= 10)
+                    std::printf("MISMATCH run %zu kind=%u pc=%#x: state %s data %s gif %s (%llu vs %llu bytes) cycles %llu vs %llu\n",
+                                i, run.kind, run.startPC,
+                                stateDigest == run.stateDigest ? "ok" : "DIFF",
+                                dataDigest == run.dataDigest ? "ok" : "DIFF",
+                                gif.digest == run.gifDigest ? "ok" : "DIFF",
+                                static_cast<unsigned long long>(gif.bytes), static_cast<unsigned long long>(run.gifBytes),
+                                static_cast<unsigned long long>(vu->cycle() - run.cycleBefore),
+                                static_cast<unsigned long long>(run.cycleAfter - run.cycleBefore));
+            }
+        }
+    }
+    const double perRun = seconds / (static_cast<double>(runs.size()) * repeat);
+    std::printf("replayed %zu runs x %d: %llu mismatches; %.3f s, %.2f us/run, %.1f ns/VU cycle\n",
+                runs.size(), repeat, static_cast<unsigned long long>(mismatches), seconds, perRun * 1e6,
+                cycles ? seconds * 1e9 / static_cast<double>(cycles) : 0.0);
+    return mismatches == 0 ? 0 : 1;
+}
