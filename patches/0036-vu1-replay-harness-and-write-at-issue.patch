@@ -0,0 +1,182 @@
+// VU1 differential-test capture (GA2_VU1CAP=<file>).
+//
+// Samples execute/resume calls that start from a clean pipeline, records their
+// inputs (state, cycle, code image, data memory) and a digest of what the
+// current interpreter produced (state, data memory, PATH1 bytes, cycles).
+// tools/ga2_vu1_replay re-runs the inputs through another interpreter build
+// and compares, so interpreter optimisations can be proven bit-exact.
+//
+// Records (little endian, appended):
+//   'VC1C' u64 codeHash u32 size bytes[size]             code image, once per hash
+//   'VR1R' u32 kind(0 execute, 1 resume) u32 startPC u32 top u32 itop
+//          u32 maxCycles u64 cycleBefore u64 codeHash u32 codeSize
+//          u32 stateSize VU1State u32 dataSize bytes[dataSize]
+//          u64 stateDigest u64 dataDigest u64 gifDigest u64 gifBytes
+//          u64 cycleAfter u32 ended
+#include "runtime/ps2_vu1.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_set>
+#include <vector>
+
+namespace
+{
+    struct CaptureFile
+    {
+        std::FILE *file = nullptr;
+        uint64_t every = 64;
+        uint64_t max = 6000;
+        uint64_t calls = 0;
+        uint64_t written = 0;
+        std::unordered_set<uint64_t> codes;
+    };
+
+    CaptureFile *captureFile()
+    {
+        static CaptureFile *instance = []() -> CaptureFile *
+        {
+            const char *path = std::getenv("GA2_VU1CAP");
+            if (!path || !*path)
+                return nullptr;
+            auto *c = new CaptureFile();
+            c->file = std::fopen(path, "wb");
+            if (!c->file)
+            {
+                std::fprintf(stderr, "[vu1cap] cannot open %s\n", path);
+                delete c;
+                return nullptr;
+            }
+            if (const char *v = std::getenv("GA2_VU1CAP_EVERY"))
+                c->every = std::max<uint64_t>(1, std::strtoull(v, nullptr, 0));
+            if (const char *v = std::getenv("GA2_VU1CAP_MAX"))
+                c->max = std::strtoull(v, nullptr, 0);
+            std::fprintf(stderr, "[vu1cap] capturing every %llu run(s), at most %llu, to %s\n",
+                         static_cast<unsigned long long>(c->every), static_cast<unsigned long long>(c->max), path);
+            return c;
+        }();
+        return instance;
+    }
+
+    template <typename T>
+    void put(std::vector<uint8_t> &out, const T &value)
+    {
+        const auto *bytes = reinterpret_cast<const uint8_t *>(&value);
+        out.insert(out.end(), bytes, bytes + sizeof(T));
+    }
+}
+
+struct VU1Interpreter::CaptureRecord
+{
+    std::vector<uint8_t> header;
+    uint64_t cycleBefore = 0;
+    uint64_t gifDigest = 1469598103934665603ull;
+    uint64_t gifBytes = 0;
+};
+
+uint64_t VU1Interpreter::digestBytes(const uint8_t *data, size_t size, uint64_t seed)
+{
+    uint64_t h = seed;
+    for (size_t i = 0; i < size; ++i)
+    {
+        h ^= data[i];
+        h *= 1099511628211ull;
+    }
+    return h;
+}
+
+uint64_t VU1Interpreter::digestState(const VU1State &s)
+{
+    uint64_t h = digestBytes(reinterpret_cast<const uint8_t *>(s.vf), sizeof(s.vf));
+    h = digestBytes(reinterpret_cast<const uint8_t *>(s.vi), sizeof(s.vi), h);
+    h = digestBytes(reinterpret_cast<const uint8_t *>(s.acc), sizeof(s.acc), h);
+    const uint32_t words[] = {
+        0, 0, 0, s.r, s.pc, s.mac, s.clip, s.status, s.top, s.itop,
+        s.branchTarget, s.branchDelay,
+        static_cast<uint32_t>(s.ebit) | (uint32_t(s.haltAfterDelaySlot) << 1) |
+            (uint32_t(s.dBitEnabled) << 2) | (uint32_t(s.tBitEnabled) << 3) |
+            (uint32_t(s.stoppedByD) << 4) | (uint32_t(s.stoppedByT) << 5) |
+            (uint32_t(s.branchPending) << 6)};
+    uint32_t w[sizeof(words) / sizeof(words[0])];
+    std::memcpy(w, words, sizeof(w));
+    std::memcpy(&w[0], &s.q, 4);
+    std::memcpy(&w[1], &s.p, 4);
+    std::memcpy(&w[2], &s.i, 4);
+    return digestBytes(reinterpret_cast<const uint8_t *>(w), sizeof(w), h);
+}
+
+void VU1Interpreter::restoreForReplay(const VU1State &state, uint64_t cycle)
+{
+    m_state = state;
+    m_cycle = cycle;
+    m_state.cycles = cycle;
+    resetScheduler();
+    m_lastRunEnded = true;
+}
+
+void VU1Interpreter::captureBegin(uint32_t kind, const uint8_t *vuCode, uint32_t codeSize,
+                                  const uint8_t *vuData, uint32_t dataSize, uint32_t startPC,
+                                  uint32_t top, uint32_t itop, uint32_t maxCycles)
+{
+    CaptureFile *file = captureFile();
+    if (!file || m_unit != Unit::VU1 || file->written >= file->max)
+        return;
+    if ((file->calls++ % file->every) != 0u)
+        return;
+
+    const uint64_t codeHash = digestBytes(vuCode, codeSize);
+    if (file->codes.insert(codeHash).second)
+    {
+        std::vector<uint8_t> code;
+        put(code, uint32_t{0x43314356u}); // "VC1C"
+        put(code, codeHash);
+        put(code, codeSize);
+        code.insert(code.end(), vuCode, vuCode + codeSize);
+        std::fwrite(code.data(), 1, code.size(), file->file);
+    }
+
+    auto *rec = new CaptureRecord();
+    rec->cycleBefore = m_cycle;
+    std::vector<uint8_t> &h = rec->header;
+    h.reserve(64 + sizeof(VU1State) + dataSize);
+    put(h, uint32_t{0x52315256u}); // "VR1R"
+    put(h, kind);
+    put(h, startPC);
+    put(h, top);
+    put(h, itop);
+    put(h, maxCycles);
+    put(h, m_cycle);
+    put(h, codeHash);
+    put(h, codeSize);
+    put(h, static_cast<uint32_t>(sizeof(VU1State)));
+    put(h, m_state);
+    put(h, dataSize);
+    h.insert(h.end(), vuData, vuData + dataSize);
+    m_capture = rec;
+}
+
+void VU1Interpreter::captureGif(const uint8_t *data, uint32_t size)
+{
+    m_capture->gifDigest = digestBytes(data, size, m_capture->gifDigest);
+    m_capture->gifBytes += size;
+}
+
+void VU1Interpreter::captureEnd(const uint8_t *vuData, uint32_t dataSize)
+{
+    CaptureRecord *rec = m_capture;
+    m_capture = nullptr;
+    CaptureFile *file = captureFile();
+    std::vector<uint8_t> &h = rec->header;
+    put(h, digestState(m_state));
+    put(h, digestBytes(vuData, dataSize));
+    put(h, rec->gifDigest);
+    put(h, rec->gifBytes);
+    put(h, m_cycle);
+    put(h, static_cast<uint32_t>(m_lastRunEnded));
+    std::fwrite(h.data(), 1, h.size(), file->file);
+    if (++file->written % 500u == 0u || file->written == file->max)
+        std::fflush(file->file);
+    delete rec;
+}
