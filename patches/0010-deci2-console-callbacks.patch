+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "Kernel/Syscalls/System.h"
+#include "Kernel/Stubs/SIF.h"
+#include "runtime/ee_scheduler.h"
+
+#include <array>
+#include <cstdint>
+#include <cstring>
+#include <initializer_list>
+#include <vector>
+
+namespace
+{
+    constexpr int32_t kInvalid = -1;
+    constexpr int32_t kInvalidSocket = -2;
+    constexpr int32_t kAlreadyUsed = -3;
+    constexpr int32_t kInvalidAddress = -5;
+    constexpr int32_t kAlreadyLocked = -8;
+    constexpr int32_t kNotLocked = -9;
+    constexpr int32_t kNoRoute = -10;
+    constexpr uint16_t kTtyProtocol = 0x0210u;
+
+    constexpr uint32_t kMainPc = 0x00118000u;
+    constexpr uint32_t kResumePc = 0x00118010u;
+    constexpr uint32_t kHandlerPc = 0x00118020u;
+    constexpr uint32_t kArgsAddr = 0x00004000u;
+    constexpr uint32_t kPacketAddr = 0x00004100u;
+    constexpr uint32_t kOptAddr = 0x00004200u;
+    constexpr uint32_t kUserAreaAddr = 0x00004300u;
+    constexpr uint32_t kCallbackGp = 0x13579BDFu;
+    constexpr uint32_t kParentGpAfterOpen = 0x2468ACE0u;
+    constexpr uint32_t kCloseMainPc = 0x00118100u;
+    constexpr uint32_t kCloseParentResumePc = 0x00118110u;
+    constexpr uint32_t kBlockedHandlerPc = 0x00118120u;
+    constexpr uint32_t kBlockedHandlerResumePc = 0x00118130u;
+    constexpr uint32_t kCloseDriverPc = 0x00118140u;
+    constexpr uint32_t kCloseDriverResumePc = 0x00118150u;
+    constexpr uint32_t kReplacementHandlerPc = 0x00118160u;
+
+    struct Fixture
+    {
+        std::vector<uint8_t> ram;
+        PS2Runtime runtime;
+        R5900Context direct{};
+
+        Fixture() : ram(PS2_RAM_SIZE, 0u)
+        {
+            ps2_syscalls::resetDeci2State(&runtime);
+        }
+    };
+
+    struct CallbackState
+    {
+        int32_t socket = 0;
+        bool invalidWriteRange = false;
+        bool resetIopWhileWriting = false;
+        bool busy = false;
+        bool parentResumed = false;
+        bool writeSawBusy = false;
+        bool doneClearedBusy = false;
+        uint32_t writeGp = 0;
+        uint32_t doneGp = 0;
+        uint32_t writeOpt = 0;
+        uint32_t registeredOpt = kOptAddr;
+        uint32_t parentGp = 0;
+        bool nestedPollSawOnlyWrite = false;
+        bool nestedPollSawBusy = false;
+        int32_t nestedPollResult = 0;
+        int32_t firstSendResult = 0;
+        int32_t secondSendResult = 0;
+        int32_t resetResult = 0;
+        int32_t pollResult = 0;
+        std::vector<uint32_t> events;
+    };
+
+    CallbackState g_callback;
+
+    // Scheduler-only liveness fixture: the old WRITE callback blocks while a
+    // second EE thread closes it and queues a replacement DECI2 request.
+    struct CloseReplaceState
+    {
+        int32_t oldSocket = 0;
+        int32_t replacementSocket = 0;
+        int semaphore = 0;
+        int32_t closeResult = 0;
+        int32_t replacementOpenResult = 0;
+        int32_t replacementPollResult = 0;
+        int32_t oldPollResult = 0;
+        uint32_t oldWriteCount = 0;
+        uint32_t oldResumeCount = 0;
+        uint32_t oldDoneCount = 0;
+        bool parentResumed = false;
+        bool replacementPendingAtCancellation = false;
+        std::vector<uint32_t> replacementEvents;
+    };
+
+    CloseReplaceState g_closeReplace;
+
+    void setRegU32(R5900Context &ctx, int reg, uint32_t value)
+    {
+        SET_GPR_U32(&ctx, reg, value);
+    }
+
+    int32_t result(const R5900Context &ctx)
+    {
+        return static_cast<int32_t>(::getRegU32(&ctx, 2));
+    }
+
+    void writeWords(uint8_t *ram, uint32_t address, std::initializer_list<uint32_t> words)
+    {
+        uint32_t offset = 0u;
+        for (uint32_t word : words)
+        {
+            std::memcpy(ram + address + offset, &word, sizeof(word));
+            offset += sizeof(word);
+        }
+    }
+
+    int32_t deciCall(Fixture &fixture, R5900Context &ctx, int32_t code, std::initializer_list<uint32_t> args)
+    {
+        writeWords(fixture.ram.data(), kArgsAddr, args);
+        setRegU32(ctx, 4, static_cast<uint32_t>(code));
+        setRegU32(ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(fixture.ram.data(), &ctx, &fixture.runtime);
+        return result(ctx);
+    }
+
+    int32_t openTty(Fixture &fixture, R5900Context &ctx, uint32_t handler = kHandlerPc,
+                    uint32_t opt = kOptAddr, uint32_t userArea = kUserAreaAddr)
+    {
+        return deciCall(fixture, ctx, 1, {kTtyProtocol, opt, handler, userArea});
+    }
+
+    void writeValidPacket(Fixture &fixture)
+    {
+        // DECI2 header: total length, reserved, protocol, source, destination;
+        // followed by the four-byte bounded local-TTY payload.
+        const std::array<uint8_t, 12> packet = {
+            12u, 0u, 0u, 0u, 0x10u, 0x02u, 'E', 'H', 't', 'e', 's', 't'};
+        std::memcpy(fixture.ram.data() + kPacketAddr, packet.data(), packet.size());
+    }
+
+    void deciCallback(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t event = ::getRegU32(ctx, 4);
+        g_callback.events.push_back(event);
+        if (event == 3u)
+        {
+            g_callback.writeSawBusy = g_callback.busy;
+            g_callback.writeGp = ::getRegU32(ctx, 28);
+            g_callback.writeOpt = ::getRegU32(ctx, 6);
+
+            const uint32_t args[3] = {static_cast<uint32_t>(g_callback.socket),
+                                      g_callback.invalidWriteRange ? PS2_RAM_SIZE - 2u : kPacketAddr,
+                                      g_callback.invalidWriteRange ? 4u : 8u};
+            std::memcpy(ram + kArgsAddr, args, sizeof(args));
+            setRegU32(*ctx, 4, static_cast<uint32_t>(-6));
+            setRegU32(*ctx, 5, kArgsAddr);
+            ps2_syscalls::Deci2Call(ram, ctx, runtime);
+            g_callback.firstSendResult = result(*ctx);
+
+            if (g_callback.invalidWriteRange)
+            {
+                const uint32_t valid[3] = {static_cast<uint32_t>(g_callback.socket), kPacketAddr, 12u};
+                std::memcpy(ram + kArgsAddr, valid, sizeof(valid));
+                setRegU32(*ctx, 4, static_cast<uint32_t>(-6));
+                setRegU32(*ctx, 5, kArgsAddr);
+                ps2_syscalls::Deci2Call(ram, ctx, runtime);
+                g_callback.secondSendResult = result(*ctx);
+            }
+            else
+            {
+                writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_callback.socket)});
+                setRegU32(*ctx, 4, 4u);
+                setRegU32(*ctx, 5, kArgsAddr);
+                ps2_syscalls::Deci2Call(ram, ctx, runtime);
+                g_callback.nestedPollResult = result(*ctx);
+                g_callback.nestedPollSawOnlyWrite = g_callback.events.size() == 1u;
+                g_callback.nestedPollSawBusy = g_callback.busy;
+
+                const uint32_t tail[3] = {static_cast<uint32_t>(g_callback.socket), kPacketAddr + 8u, 4u};
+                std::memcpy(ram + kArgsAddr, tail, sizeof(tail));
+                setRegU32(*ctx, 4, static_cast<uint32_t>(-6));
+                setRegU32(*ctx, 5, kArgsAddr);
+                ps2_syscalls::Deci2Call(ram, ctx, runtime);
+                g_callback.secondSendResult = result(*ctx);
+                if (g_callback.resetIopWhileWriting)
+                {
+                    ps2_stubs::sceSifResetIop(ram, ctx, runtime);
+                    g_callback.resetResult = result(*ctx);
+                }
+            }
+        }
+        else if (event == 4u)
+        {
+            g_callback.doneGp = ::getRegU32(ctx, 28);
+            g_callback.busy = false;
+            g_callback.doneClearedBusy = true;
+        }
+        ctx->pc = 0u;
+    }
+
+    void schedulerMain(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeWords(ram, kArgsAddr, {kTtyProtocol, g_callback.registeredOpt, kHandlerPc, kUserAreaAddr});
+        setRegU32(*ctx, 4, 1u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+        g_callback.socket = result(*ctx);
+
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_callback.socket), static_cast<uint32_t>('H')});
+        setRegU32(*ctx, 4, 3u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+
+        g_callback.busy = true;
+        setRegU32(*ctx, 28, kParentGpAfterOpen);
+        ctx->pc = kResumePc;
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_callback.socket)});
+        setRegU32(*ctx, 4, 4u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+    }
+
+    void schedulerResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_callback.pollResult = result(*ctx);
+        g_callback.parentGp = ::getRegU32(ctx, 28);
+        g_callback.parentResumed = true;
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void blockedWriteHandler(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        if (::getRegU32(ctx, 4) == 3u)
+        {
+            ++g_closeReplace.oldWriteCount;
+            ctx->pc = kBlockedHandlerResumePc;
+            runtime->eeScheduler().waitSemaphore(g_closeReplace.semaphore);
+            return;
+        }
+        ++g_closeReplace.oldDoneCount;
+        ctx->pc = 0u;
+    }
+
+    void blockedWriteResume(uint8_t *, R5900Context *ctx, PS2Runtime *)
+    {
+        ++g_closeReplace.oldResumeCount;
+        ctx->pc = 0u;
+    }
+
+    void replacementHandler(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t event = ::getRegU32(ctx, 4);
+        g_closeReplace.replacementEvents.push_back(event);
+        if (event == 3u)
+        {
+            const uint32_t args[3] = {static_cast<uint32_t>(g_closeReplace.replacementSocket), kPacketAddr, 12u};
+            std::memcpy(ram + kArgsAddr, args, sizeof(args));
+            setRegU32(*ctx, 4, static_cast<uint32_t>(-6));
+            setRegU32(*ctx, 5, kArgsAddr);
+            ps2_syscalls::Deci2Call(ram, ctx, runtime);
+        }
+        ctx->pc = 0u;
+    }
+
+    void closeDriver(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_closeReplace.oldSocket)});
+        setRegU32(*ctx, 4, 2u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+        g_closeReplace.closeResult = result(*ctx);
+
+        writeWords(ram, kArgsAddr, {kTtyProtocol, kOptAddr, kReplacementHandlerPc, kUserAreaAddr});
+        setRegU32(*ctx, 4, 1u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+        g_closeReplace.replacementSocket = result(*ctx);
+        g_closeReplace.replacementOpenResult = result(*ctx);
+
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_closeReplace.replacementSocket), static_cast<uint32_t>('H')});
+        setRegU32(*ctx, 4, 3u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+
+        // Cancel the old invocation while the replacement remains Pending.
+        runtime->eeScheduler().signalSemaphore(g_closeReplace.semaphore, false);
+        ctx->pc = 0u;
+    }
+
+    void closeDriverResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_closeReplace.replacementPollResult = result(*ctx);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void closeReplaceMain(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        auto &scheduler = runtime->eeScheduler();
+        g_closeReplace.semaphore = scheduler.createSemaphore(0, 1, 0, 0);
+        EeThreadCreateParams driver{};
+        driver.entry = kCloseDriverPc;
+        driver.stack = 0x00018000u;
+        driver.stackSize = 0x1000u;
+        driver.priority = 10;
+        const int driverId = scheduler.createThread(driver);
+        scheduler.startThread(driverId, 0u, *ctx, false);
+
+        writeWords(ram, kArgsAddr, {kTtyProtocol, kOptAddr, kBlockedHandlerPc, kUserAreaAddr});
+        setRegU32(*ctx, 4, 1u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+        g_closeReplace.oldSocket = result(*ctx);
+
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_closeReplace.oldSocket), static_cast<uint32_t>('H')});
+        setRegU32(*ctx, 4, 3u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+
+        ctx->pc = kCloseParentResumePc;
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_closeReplace.oldSocket)});
+        setRegU32(*ctx, 4, 4u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+    }
+
+    void closeReplaceParentResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        g_closeReplace.oldPollResult = result(*ctx);
+        g_closeReplace.parentResumed = true;
+        g_closeReplace.replacementPendingAtCancellation = g_closeReplace.replacementEvents.empty();
+        ctx->pc = kCloseDriverResumePc;
+        writeWords(ram, kArgsAddr, {static_cast<uint32_t>(g_closeReplace.replacementSocket)});
+        setRegU32(*ctx, 4, 4u);
+        setRegU32(*ctx, 5, kArgsAddr);
+        ps2_syscalls::Deci2Call(ram, ctx, runtime);
+    }
+
+    void resetCallbackState()
+    {
+        g_callback = {};
+    }
+
+    void resetCloseReplaceState()
+    {
+        g_closeReplace = {};
+    }
+
+    void registerSchedulerFixture(Fixture &fixture)
+    {
+        fixture.runtime.registerFunction(kMainPc, schedulerMain);
+        fixture.runtime.registerFunction(kResumePc, schedulerResume);
+        fixture.runtime.registerFunction(kHandlerPc, deciCallback);
+        writeValidPacket(fixture);
+    }
+
+    void registerCloseReplaceFixture(Fixture &fixture)
+    {
+        fixture.runtime.registerFunction(kCloseMainPc, closeReplaceMain);
+        fixture.runtime.registerFunction(kCloseParentResumePc, closeReplaceParentResume);
+        fixture.runtime.registerFunction(kBlockedHandlerPc, blockedWriteHandler);
+        fixture.runtime.registerFunction(kBlockedHandlerResumePc, blockedWriteResume);
+        fixture.runtime.registerFunction(kCloseDriverPc, closeDriver);
+        fixture.runtime.registerFunction(kCloseDriverResumePc, closeDriverResume);
+        fixture.runtime.registerFunction(kReplacementHandlerPc, replacementHandler);
+        writeValidPacket(fixture);
+    }
+}
+
+void register_ps2_deci2_tests()
+{
+    MiniTest::Case("PS2Deci2", [](TestCase &tc)
+    {
+        tc.Run("scheduler drives DECI2 WRITE through ExSend before guest WRITE_DONE", [](TestCase &t)
+        {
+            Fixture fixture;
+            resetCallbackState();
+            g_callback.registeredOpt = PS2_RAM_SIZE - 2u;
+            registerSchedulerFixture(fixture);
+
+            R5900Context main{};
+            setRegU32(main, 28, kCallbackGp);
+            main.pc = kMainPc;
+            fixture.runtime.eeScheduler().reset(fixture.ram.data(), main);
+            fixture.runtime.eeScheduler().run();
+
+            t.IsTrue(g_callback.parentResumed, "parent must resume after the callback sequence");
+            t.Equals(g_callback.pollResult, 0, "complete checked DECI2 packet should finish successfully");
+            t.Equals(g_callback.events.size(), size_t{2}, "only WRITE and WRITE_DONE callbacks should execute");
+            if (g_callback.events.size() == 2u)
+            {
+                t.Equals(g_callback.events[0], 3u, "first callback should be WRITE");
+                t.Equals(g_callback.events[1], 4u, "second callback should be WRITE_DONE");
+            }
+            t.IsTrue(g_callback.writeSawBusy, "WRITE_DONE must not precede guest completion");
+            t.IsTrue(g_callback.doneClearedBusy && !g_callback.busy,
+                     "the guest WRITE_DONE handler must clear its own busy fixture");
+            t.Equals(g_callback.writeGp, kCallbackGp, "WRITE callback must restore the registration GP");
+            t.Equals(g_callback.doneGp, kCallbackGp, "WRITE_DONE callback must retain the registration GP");
+            t.Equals(g_callback.writeOpt, PS2_RAM_SIZE - 2u,
+                     "WRITE callback must preserve an opaque opt value in a2 without dereferencing it");
+            t.Equals(g_callback.parentGp, kParentGpAfterOpen,
+                     "parent GP changed after open must be restored after both callbacks");
+            t.IsTrue(g_callback.nestedPollSawOnlyWrite && g_callback.nestedPollSawBusy,
+                     "nested Poll during WRITE must not create a second callback or premature completion");
+            t.Equals(g_callback.firstSendResult, 8, "first ExSend chunk should be accepted");
+            t.Equals(g_callback.secondSendResult, 4, "second ExSend chunk should complete the actual packet");
+        });
+
+        tc.Run("DECI2 rejects an invalid callback send range without WRITE_DONE", [](TestCase &t)
+        {
+            Fixture fixture;
+            resetCallbackState();
+            g_callback.invalidWriteRange = true;
+            registerSchedulerFixture(fixture);
+
+            R5900Context main{};
+            main.pc = kMainPc;
+            fixture.runtime.eeScheduler().reset(fixture.ram.data(), main);
+            fixture.runtime.eeScheduler().run();
+
+            t.IsTrue(g_callback.parentResumed, "failed callback must return control to the parent");
+            t.Equals(g_callback.pollResult, kInvalidAddress, "invalid packet range must fail Poll honestly");
+            t.Equals(g_callback.events.size(), size_t{1}, "failed ExSend must not synthesize WRITE_DONE");
+            if (!g_callback.events.empty())
+            {
+                t.Equals(g_callback.events.front(), 3u, "only WRITE should reach the guest");
+            }
+            t.Equals(g_callback.firstSendResult, kInvalidAddress, "ExSend must reject a range crossing guest RAM");
+            t.Equals(g_callback.secondSendResult, kInvalidAddress,
+                     "a terminal ExSend error must reject a later valid packet without accepting it");
+            t.IsTrue(g_callback.busy && !g_callback.doneClearedBusy,
+                     "unsent packets must leave busy ownership with the guest");
+        });
+
+        tc.Run("DECI2 validates open, socket, route, lock, and argument failures", [](TestCase &t)
+        {
+            Fixture fixture;
+            fixture.runtime.registerFunction(kHandlerPc, deciCallback);
+
+            t.Equals(openTty(fixture, fixture.direct, 0x00118100u), kInvalidAddress,
+                     "open must reject a missing handler");
+            const int32_t opaqueOptSocket = openTty(fixture, fixture.direct, kHandlerPc, PS2_RAM_SIZE - 2u);
+            t.IsTrue(opaqueOptSocket > 0, "open must preserve an opaque opt value without dereferencing it");
+            t.Equals(deciCall(fixture, fixture.direct, 2, {static_cast<uint32_t>(opaqueOptSocket)}), 0,
+                     "opaque opt socket should still close normally");
+            t.Equals(openTty(fixture, fixture.direct, kHandlerPc, 0u, PS2_RAM_SIZE - 2u), kInvalidAddress,
+                     "open must reject a userArea range it promises to retain");
+            t.Equals(deciCall(fixture, fixture.direct, 1, {0x9999u, 0u, kHandlerPc, 0u}), kNoRoute,
+                     "non-TTY protocol must be rejected");
+
+            const int32_t socket = openTty(fixture, fixture.direct);
+            t.IsTrue(socket > 0, "supported local TTY open should allocate a socket");
+            t.Equals(openTty(fixture, fixture.direct), kAlreadyUsed,
+                     "one runtime may own only one local TTY protocol socket");
+            t.Equals(deciCall(fixture, fixture.direct, 3, {static_cast<uint32_t>(socket), static_cast<uint32_t>('X')}),
+                     kNoRoute, "unsupported DECI2 destination must fail");
+            t.Equals(deciCall(fixture, fixture.direct, -9, {static_cast<uint32_t>(socket)}), kNotLocked,
+                     "unlocking an unlocked socket must fail");
+            t.Equals(deciCall(fixture, fixture.direct, -8, {static_cast<uint32_t>(socket)}), 0,
+                     "locking an open socket should succeed once");
+            t.Equals(deciCall(fixture, fixture.direct, -8, {static_cast<uint32_t>(socket)}), kAlreadyLocked,
+                     "double locking must fail");
+            t.Equals(deciCall(fixture, fixture.direct, -9, {static_cast<uint32_t>(socket)}), 0,
+                     "unlocking a held socket should succeed");
+            t.Equals(deciCall(fixture, fixture.direct, 99, {static_cast<uint32_t>(socket)}), kInvalid,
+                     "unknown DECI2 operation must fail");
+            t.Equals(deciCall(fixture, fixture.direct, 2, {0x7fffffffu}), kInvalidSocket,
+                     "unknown socket must fail");
+
+            setRegU32(fixture.direct, 4, 1u);
+            setRegU32(fixture.direct, 5, PS2_RAM_SIZE - 4u);
+            ps2_syscalls::Deci2Call(fixture.ram.data(), &fixture.direct, &fixture.runtime);
+            t.Equals(result(fixture.direct), kInvalidAddress, "truncated SDK argument block must fail");
+        });
+
+        tc.Run("DECI2 close and owner reset retire stale pending callbacks only", [](TestCase &t)
+        {
+            Fixture first;
+            Fixture second;
+            first.runtime.registerFunction(kHandlerPc, deciCallback);
+            second.runtime.registerFunction(kHandlerPc, deciCallback);
+            const int32_t firstSocket = openTty(first, first.direct);
+            const int32_t secondSocket = openTty(second, second.direct);
+            t.IsTrue(firstSocket > 0 && secondSocket > 0, "separate runtimes should own independent local TTY sockets");
+
+            t.Equals(deciCall(first, first.direct, 3, {static_cast<uint32_t>(firstSocket), static_cast<uint32_t>('H')}), 0,
+                     "first runtime should queue a local TTY send");
+            t.Equals(deciCall(first, first.direct, 2, {static_cast<uint32_t>(firstSocket)}), 0,
+                     "close should retire the pending local TTY session");
+            t.Equals(deciCall(first, first.direct, 4, {static_cast<uint32_t>(firstSocket)}), kInvalidSocket,
+                     "closed socket must never schedule a stale handler");
+
+            const int32_t resetSocket = openTty(first, first.direct);
+            t.IsTrue(resetSocket > 0, "closed local TTY protocol may be reopened");
+            t.Equals(deciCall(first, first.direct, 3, {static_cast<uint32_t>(resetSocket), static_cast<uint32_t>('H')}), 0,
+                     "reopened socket should queue before reset");
+            ps2_syscalls::resetDeci2State(&first.runtime);
+            t.Equals(deciCall(first, first.direct, 4, {static_cast<uint32_t>(resetSocket)}), kInvalidSocket,
+                     "runtime reset must retire its own stale DECI2 callback sink");
+            t.Equals(deciCall(second, second.direct, -8, {static_cast<uint32_t>(secondSocket)}), 0,
+                     "owner-scoped reset must preserve another runtime's channel");
+        });
+
+        tc.Run("DECI2 close and reopen cancels an attached WRITE callback without disturbing its replacement", [](TestCase &t)
+        {
+            Fixture fixture;
+            resetCloseReplaceState();
+            registerCloseReplaceFixture(fixture);
+
+            R5900Context main{};
+            main.pc = kCloseMainPc;
+            fixture.runtime.eeScheduler().reset(fixture.ram.data(), main);
+            fixture.runtime.eeScheduler().run();
+
+            t.IsTrue(g_closeReplace.parentResumed, "parent must resume after the attached stale callback is cancelled");
+            t.Equals(g_closeReplace.oldWriteCount, 1u, "old WRITE handler must actually execute and suspend before close");
+            t.Equals(g_closeReplace.oldResumeCount, 0u, "closed WRITE handler must never resume after its semaphore wake");
+            t.Equals(g_closeReplace.oldDoneCount, 0u, "closed WRITE handler must never receive WRITE_DONE");
+            t.Equals(g_closeReplace.closeResult, 0, "close must retire the active callback session");
+            t.IsTrue(g_closeReplace.replacementOpenResult > 0,
+                     "reopen must allocate a current replacement channel after close");
+            t.IsTrue(g_closeReplace.replacementSocket != g_closeReplace.oldSocket,
+                     "replacement must not reuse the stale socket identity");
+            t.IsTrue(g_closeReplace.replacementPendingAtCancellation,
+                     "replacement must remain pending until old invocation cancellation completes");
+            t.Equals(g_closeReplace.replacementPollResult, 0,
+                     "replacement channel must complete independently of the cancelled callback");
+            t.Equals(g_closeReplace.replacementEvents.size(), size_t{2},
+                     "replacement channel should receive its own WRITE and WRITE_DONE callbacks");
+            if (g_closeReplace.replacementEvents.size() == 2u)
+            {
+                t.Equals(g_closeReplace.replacementEvents[0], 3u, "replacement first callback should be WRITE");
+                t.Equals(g_closeReplace.replacementEvents[1], 4u, "replacement second callback should be WRITE_DONE");
+            }
+        });
+
+        tc.Run("DECI2 EE callback survives a supported IOP reset", [](TestCase &t)
+        {
+            Fixture fixture;
