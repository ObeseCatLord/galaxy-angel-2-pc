diff --git a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
index 53f8be1..482f27f 100644
--- a/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
+++ b/ps2xRuntime/src/lib/Kernel/EeScheduler.cpp
@@ -2433,6 +2433,22 @@ void EeScheduler::processEvent(const EeEvent &event)
                                  double(vu1.runs) / seconds, double(vu1.cycles) / seconds / 1e6,
                                  double(vu1.nanos) / seconds / 1e6,
                                  vu1.cycles ? double(vu1.nanos) / double(vu1.cycles) : 0.0);
+                    // Where each live guest thread is (status, resume pc, ra).
+                    std::fprintf(stderr, "[ga2 perf] threads:");
+                    for (const auto &[id, thread] : m_threads)
+                    {
+                        if (id <= 0 || thread.status == EeThreadStatus::Dormant) continue;
+                        const R5900Context &c = thread.activeContext();
+                        std::fprintf(stderr, " %d/%d@%x<%x", id, static_cast<int>(thread.status), c.pc,
+                                     static_cast<uint32_t>(_mm_cvtsi128_si32(c.r[31])));
+                    }
+                    // DMA state a stall usually involves (CHCR is not read: reading it
+                    // clears STR in this model).
+                    PS2Memory &mem = m_runtime.memory();
+                    std::fprintf(stderr, " | vif1 qwc=%x madr=%x tadr=%x stat=%x gif qwc=%x d_stat=%x\n",
+                                 mem.readIORegister(0x10009020u) & 0xFFFFu, mem.readIORegister(0x10009010u),
+                                 mem.readIORegister(0x10009030u), mem.readIORegister(0x10003C00u),
+                                 mem.readIORegister(0x1000A020u) & 0xFFFFu, mem.readIORegister(0x1000E010u));
                     last = now;
                     lastTick = m_vsyncTick;
                 }
diff --git a/ps2xRuntime/src/lib/ps2_memory.cpp b/ps2xRuntime/src/lib/ps2_memory.cpp
