new file mode 100644
index 0000000..4b225c1
--- /dev/null
+++ b/ps2xTest/src/ga2_vr_input_tests.cpp
@@ -0,0 +1,599 @@
+#include "MiniTest.h"
+
+#include "ga2_vr_bindings.h"
+#include "ga2_vr_input.h"
+
+#include <map>
+#include <set>
+#include <string>
+#include <vector>
+
+namespace
+{
+    using namespace ga2_vr_input;
+    using ga2_vr_bindings::Act;
+
+    bool has(const Output &o, uint16_t mask) { return (o.buttons & mask) == mask; }
+    bool none(const Output &o, uint16_t mask) { return (o.buttons & mask) == 0; }
+
+    // ---- spec path lists of the interaction profiles (OpenXR 1.1 / extensions) --------------
+    // 'b' boolean, 'f' float, 'v' vector2f, 'p' pose.
+    using Paths = std::map<std::string, char>;
+
+    void add(Paths &p, const std::string &hand, const char *input, char type)
+    {
+        p["/user/hand/" + hand + "/input/" + input] = type;
+    }
+    void stick(Paths &p, const std::string &hand, const char *name, bool click)
+    {
+        const std::string n = name;
+        add(p, hand, name, 'v');
+        add(p, hand, (n + "/x").c_str(), 'f');
+        add(p, hand, (n + "/y").c_str(), 'f');
+        if (click)
+            add(p, hand, (n + "/click").c_str(), 'b');
+        add(p, hand, (n + "/touch").c_str(), 'b');
+    }
+    void poses(Paths &p)
+    {
+        for (const char *hand : {"left", "right"})
+        {
+            add(p, hand, "grip/pose", 'p');
+            add(p, hand, "aim/pose", 'p');
+        }
+    }
+
+    Paths touchPaths()
+    {
+        Paths p;
+        poses(p);
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "squeeze/value", 'f');
+            add(p, h, "trigger/value", 'f');
+            add(p, h, "trigger/touch", 'b');
+            stick(p, h, "thumbstick", true);
+            add(p, h, "thumbrest/touch", 'b');
+        }
+        for (const char *i : {"x/click", "x/touch", "y/click", "y/touch", "menu/click"})
+            add(p, "left", i, 'b');
+        for (const char *i : {"a/click", "a/touch", "b/click", "b/touch", "system/click"})
+            add(p, "right", i, 'b');
+        return p;
+    }
+
+    Paths picoPaths()
+    {
+        Paths p = touchPaths();
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "squeeze/click", 'b');
+            add(p, h, "trigger/click", 'b');
+        }
+        return p;
+    }
+
+    Paths hpPaths()
+    {
+        Paths p;
+        poses(p);
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "menu/click", 'b');
+            add(p, h, "squeeze/value", 'f');
+            add(p, h, "trigger/value", 'f');
+            stick(p, h, "thumbstick", true);
+        }
+        for (const char *i : {"x/click", "y/click"})
+            add(p, "left", i, 'b');
+        for (const char *i : {"a/click", "b/click"})
+            add(p, "right", i, 'b');
+        return p;
+    }
+
+    Paths indexPaths()
+    {
+        Paths p;
+        poses(p);
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "system/click", 'b');
+            add(p, h, "system/touch", 'b');
+            for (const char *i : {"a/click", "a/touch", "b/click", "b/touch", "trigger/click", "trigger/touch", "trackpad/touch"})
+                add(p, h, i, 'b');
+            for (const char *i : {"squeeze/value", "squeeze/force", "trigger/value", "trackpad/force"})
+                add(p, h, i, 'f');
+            stick(p, h, "thumbstick", true);
+            add(p, h, "trackpad", 'v');
+            add(p, h, "trackpad/x", 'f');
+            add(p, h, "trackpad/y", 'f');
+        }
+        return p;
+    }
+
+    Paths viveLikePaths(bool wmr)
+    {
+        Paths p;
+        poses(p);
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "menu/click", 'b');
+            add(p, h, "trackpad", 'v');
+            add(p, h, "trackpad/x", 'f');
+            add(p, h, "trackpad/y", 'f');
+            add(p, h, "trackpad/click", 'b');
+            add(p, h, "trackpad/touch", 'b');
+            add(p, h, "squeeze/click", 'b');
+            if (wmr)
+            {
+                add(p, h, "trigger/value", 'f');
+                stick(p, h, "thumbstick", true);
+            }
+            else
+            {
+                add(p, h, "system/click", 'b');
+                add(p, h, "trigger/click", 'b');
+                add(p, h, "trigger/value", 'f');
+            }
+        }
+        return p;
+    }
+
+    Paths simplePaths()
+    {
+        Paths p;
+        poses(p);
+        for (const char *h : {"left", "right"})
+        {
+            add(p, h, "select/click", 'b');
+            add(p, h, "menu/click", 'b');
+        }
+        return p;
+    }
+
+    Paths specFor(const std::string &profile)
+    {
+        if (profile.find("oculus/touch") != std::string::npos || profile.find("touch_controller_pro") != std::string::npos ||
+            profile.find("touch_controller_plus") != std::string::npos)
+            return touchPaths();
+        if (profile.find("pico") != std::string::npos)
+            return picoPaths();
+        if (profile.find("hp/") != std::string::npos)
+            return hpPaths();
+        if (profile.find("valve/index") != std::string::npos)
+            return indexPaths();
+        if (profile.find("microsoft/") != std::string::npos || profile.find("samsung/") != std::string::npos)
+            return viveLikePaths(true);
+        if (profile.find("htc/vive") != std::string::npos)
+            return viveLikePaths(false);
+        if (profile.find("khr/simple") != std::string::npos)
+            return simplePaths();
+        return {};
+    }
+
+    char actionType(Act a)
+    {
+        switch (a)
+        {
+        case Act::Aim: return 'p';
+        case Act::Trigger:
+        case Act::L1:
+        case Act::R1:
+        case Act::L2:
+        case Act::R2: return 'f';
+        case Act::DPad:
+        case Act::LeftStick:
+        case Act::RightStick:
+        case Act::FacePad: return 'v';
+        default: return 'b';
+        }
+    }
+
+    bool compatible(char action, char path)
+    {
+        if (action == 'b' || action == 'f')
+            return path == 'b' || path == 'f';
+        return action == path;
+    }
+
+    const ga2_vr_bindings::Profile *profileNamed(const char *suffix)
+    {
+        for (const auto &p : ga2_vr_bindings::profiles())
+            if (p.name.find(suffix) != std::string::npos)
+                return &p;
+        return nullptr;
+    }
+
+    std::set<Act> bound(const ga2_vr_bindings::Profile &p)
+    {
+        std::set<Act> out;
+        for (const auto &b : p.bindings)
+            out.insert(b.action);
+        return out;
+    }
+
+    Inputs sceneInputs(Scene scene)
+    {
+        Inputs in;
+        in.scene = scene;
+        return in;
+    }
+}
