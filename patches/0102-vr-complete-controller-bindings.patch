+    g_hostShoulderShared = g_hostShoulder;
     g_hostPadSampled = true;
 }
 
+bool ps2PadHostShoulderPressure(uint8_t out[4])
+{
+    std::lock_guard<std::mutex> lock(g_hostPadMutex);
+    std::memcpy(out, g_hostShoulderShared.data(), 4);
+    return g_hostShoulderShared != std::array<uint8_t, 4>{};
+}
