+                const auto have = [&](Act x) { return a.count(x) != 0; };
+                t.IsTrue(have(Act::Aim) && have(Act::Trigger), profile.name + ": aim and trigger (pointer, confirm, fire)");
+                t.IsTrue(have(Act::Circle) || have(Act::FacePadClick) || have(Act::Trigger), profile.name + ": confirm");
+                t.IsTrue(have(Act::Cross) || have(Act::FacePadClick), profile.name + ": cancel");
+                t.IsTrue(have(Act::Menu) || (have(Act::Start) && have(Act::Select)), profile.name + ": Start and Select");
+            }
+        });
+
+        tc.Run("thumbstick controllers reach every PS2 input", [](TestCase &t) {
+            for (const char *name : {"oculus/touch", "touch_controller_pro", "touch_controller_plus", "pico4", "pico_neo3",
+                                     "hp/mixed", "valve/index", "microsoft/motion", "samsung/odyssey"})
+            {
+                const auto *profile = profileNamed(name);
+                t.IsNotNull(profile, std::string("profile ") + name);
+                if (!profile)
+                    continue;
+                const std::set<Act> a = bound(*profile);
+                for (Act x : {Act::DPad, Act::LeftStick, Act::RightStick, Act::L1, Act::R1, Act::L3, Act::R3, Act::Trigger})
+                    t.IsTrue(a.count(x) != 0, std::string(name) + ": sticks, shoulders and clicks (action " + std::to_string(int(x)) + ")");
+                // Circle, Cross, Square, Triangle: buttons, or a face pad.
+                const bool faces = (a.count(Act::Circle) && a.count(Act::Cross) && a.count(Act::Square) && a.count(Act::Triangle)) ||
+                                   (a.count(Act::FacePad) && a.count(Act::FacePadClick));
+                t.IsTrue(faces, std::string(name) + ": all four face buttons");
+            }
+        });
+
+        tc.Run("Index: A / B of the right hand are Circle / Cross, of the left Square / Triangle, no menu button needed", [](TestCase &t) {
+            const auto *index = profileNamed("valve/index");
+            t.IsNotNull(index, "index profile");
+            if (!index)
+                return;
+            std::map<std::string, Act> byPath;
+            for (const auto &b : index->bindings)
+                byPath[b.path] = b.action;
+            t.IsTrue(byPath["/user/hand/right/input/a/click"] == Act::Circle, "right A = Circle");
+            t.IsTrue(byPath["/user/hand/right/input/b/click"] == Act::Cross, "right B = Cross");
+            t.IsTrue(byPath["/user/hand/left/input/a/click"] == Act::Square, "left A = Square");
+            t.IsTrue(byPath["/user/hand/left/input/b/click"] == Act::Triangle, "left B = Triangle");
+            t.IsTrue(byPath.count("/user/hand/left/input/menu/click") == 0, "Index has no menu button");
+            t.IsTrue(byPath["/user/hand/left/input/trackpad/force"] == Act::Menu, "left trackpad press = menu action");
+        });
+
+        tc.Run("Touch: A / B right = Circle / Cross, X / Y left = Square / Triangle, left menu = menu action", [](TestCase &t) {
+            const auto *touch = profileNamed("oculus/touch");
+            t.IsNotNull(touch, "touch profile");
+            if (!touch)
+                return;
+            std::map<std::string, Act> byPath;
+            for (const auto &b : touch->bindings)
+                byPath[b.path] = b.action;
+            t.IsTrue(byPath["/user/hand/right/input/a/click"] == Act::Circle, "A = Circle");
+            t.IsTrue(byPath["/user/hand/right/input/b/click"] == Act::Cross, "B = Cross");
+            t.IsTrue(byPath["/user/hand/left/input/x/click"] == Act::Square, "X = Square");
+            t.IsTrue(byPath["/user/hand/left/input/y/click"] == Act::Triangle, "Y = Triangle");
+            t.IsTrue(byPath["/user/hand/left/input/menu/click"] == Act::Menu, "menu = Start / Select");
+            t.IsTrue(byPath["/user/hand/left/input/thumbstick/click"] == Act::L3 &&
+                         byPath["/user/hand/right/input/thumbstick/click"] == Act::R3,
+                     "stick clicks = L3 / R3");
+            t.IsTrue(byPath["/user/hand/left/input/squeeze/value"] == Act::L1 &&
+                         byPath["/user/hand/right/input/squeeze/value"] == Act::R1,
+                     "grips = L1 / R1");
+        });
+
+        tc.Run("Vive wands and simple controllers: confirm, cancel, Start, Select; Vive has the D-pad too", [](TestCase &t) {
+            const auto *vive = profileNamed("htc/vive");
+            const auto *simple = profileNamed("khr/simple");
+            t.IsNotNull(vive, "vive profile");
+            t.IsNotNull(simple, "simple profile");
+            if (!vive || !simple)
+                return;
+            const std::set<Act> v = bound(*vive), s = bound(*simple);
+            t.IsTrue(v.count(Act::DPad) && v.count(Act::LeftStick), "Vive: left trackpad is D-pad and stick");
+            t.IsTrue(v.count(Act::FacePad) && v.count(Act::FacePadClick), "Vive: right trackpad is the face buttons");
+            t.IsTrue(v.count(Act::L1) && v.count(Act::R1) && v.count(Act::L3) && v.count(Act::R3), "Vive: grips and clicks");
+            t.IsTrue(s.count(Act::Cross) && s.count(Act::Menu) && s.count(Act::Trigger), "simple: cancel, menu, trigger");
+            t.IsFalse(s.count(Act::DPad) != 0, "simple controllers have no stick for the D-pad");
+        });
+    });
+}
