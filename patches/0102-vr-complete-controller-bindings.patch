diff --git a/ps2xRuntime/include/runtime/ga2_vrpointer.h b/ps2xRuntime/include/runtime/ga2_vrpointer.h
index 5b758c6..a94493a 100644
--- a/ps2xRuntime/include/runtime/ga2_vrpointer.h
+++ b/ps2xRuntime/include/runtime/ga2_vrpointer.h
@@ -29,7 +29,22 @@ namespace ga2_vrpointer
     // Circle in the stereo 3D scenes, where no screen is there to click.
     void wantTrigger(bool want);
 
+    // What the game shows in a battle, for what the controllers' triggers press
+    // (src/lib/ga2_vr_input.h).
+    enum class Scene : uint8_t
+    {
+        Other = 0,   // anything else: in 3D scenes the trigger confirms (Circle)
+        TacticalMap, // as wantTrigger(true)
+        Cockpit,     // cockpit / attack view: the triggers fire (Cross)
+        UnitCamera,  // watching a unit through its camera: the triggers are L2 / R2 (zoom)
+    };
+
+    // Game thread: the scene the game shows now; call every frame it is shown (a
+    // lapse of half a second ends it, like wantTrigger).
+    void setScene(Scene scene);
+
     // ga2_vr (main thread).
+    Scene scene();
     void publish(const Aim &aim);
     void clear();
     bool triggerWanted();
