+
+// Default controller bindings of the VR actions (one action per PS2 input),
+// per OpenXR interaction profile. Data only, so tests can check every path
+// against the profile's path list and the coverage of each profile; ga2_vr.cpp
+// suggests them to the runtime. docs/vr/stereo.md has the same as a table.
+#include <string>
+#include <vector>
+
+namespace ga2_vr_bindings
+{
+    enum class Act
+    {
+        Aim,
+        Trigger,
+        Circle,
+        Cross,
+        Square,
+        Triangle,
+        Start,
+        Select,
+        Menu,
+        L1,
+        R1,
+        L2,
+        R2,
+        L3,
+        R3,
+        DPad,
+        LeftStick,
+        RightStick,
+        FacePad,
+        FacePadClick,
+        Count,
+    };
+
+    struct Binding
+    {
+        Act action;
+        std::string path;
+    };
+
+    struct Profile
+    {
+        std::string name;
+        // Instance extension the runtime must offer for this profile ("" = core).
+        std::string extension;
+        std::vector<Binding> bindings;
+    };
+
+    inline const std::vector<Profile> &profiles()
+    {
+        static const std::vector<Profile> all = [] {
+            using B = Binding;
+            const std::string L = "/user/hand/left/input/", R = "/user/hand/right/input/";
+            std::vector<Profile> out;
+            auto poses = [&](std::vector<B> &b) {
+                b.push_back({Act::Aim, L + "aim/pose"});
+                b.push_back({Act::Aim, R + "aim/pose"});
+            };
+            auto bothHands = [&](std::vector<B> &b, Act a, const char *input) {
+                b.push_back({a, L + input});
+                b.push_back({a, R + input});
+            };
+            auto shoulders = [&](std::vector<B> &b, const char *input) {
+                b.push_back({Act::L1, L + input});
+                b.push_back({Act::R1, R + input});
+            };
+            // Thumbstick controllers: the left stick is the left analog stick and the
+            // D-pad, the right stick the right analog stick, the stick clicks L3 / R3.
+            auto thumbsticks = [&](std::vector<B> &b) {
+                b.push_back({Act::DPad, L + "thumbstick"});
+                b.push_back({Act::LeftStick, L + "thumbstick"});
+                b.push_back({Act::RightStick, R + "thumbstick"});
+                b.push_back({Act::L3, L + "thumbstick/click"});
+                b.push_back({Act::R3, R + "thumbstick/click"});
+            };
+            // A / B on the right hand are Circle / Cross, X / Y on the left Square / Triangle.
+            auto touchFace = [&](std::vector<B> &b) {
+                b.push_back({Act::Circle, R + "a/click"});
+                b.push_back({Act::Cross, R + "b/click"});
+                b.push_back({Act::Square, L + "x/click"});
+                b.push_back({Act::Triangle, L + "y/click"});
+            };
+            auto touchLike = [&] {
+                std::vector<B> b;
+                poses(b);
+                bothHands(b, Act::Trigger, "trigger/value");
+                shoulders(b, "squeeze/value");
+                thumbsticks(b);
+                touchFace(b);
+                b.push_back({Act::Menu, L + "menu/click"});
+                return b;
+            };
+
+            // Simple controllers: a pull of either select is the trigger, the left menu
+            // button Start / Select, the right one Cross. No sticks, so no D-pad.
+            {
+                std::vector<B> b;
+                poses(b);
+                bothHands(b, Act::Trigger, "select/click");
+                b.push_back({Act::Menu, L + "menu/click"});
+                b.push_back({Act::Cross, R + "menu/click"});
+                out.push_back({"/interaction_profiles/khr/simple_controller", "", b});
+            }
+            // Quest, Rift (Touch), Touch Pro / Plus, Pico.
+            out.push_back({"/interaction_profiles/oculus/touch_controller", "", touchLike()});
+            out.push_back({"/interaction_profiles/facebook/touch_controller_pro", "XR_FB_touch_controller_pro", touchLike()});
+            out.push_back({"/interaction_profiles/meta/touch_controller_plus", "XR_META_touch_controller_plus", touchLike()});
+            out.push_back({"/interaction_profiles/bytedance/pico4_controller", "XR_BD_controller_interaction", touchLike()});
+            out.push_back({"/interaction_profiles/bytedance/pico_neo3_controller", "XR_BD_controller_interaction", touchLike()});
+            // HP Reverb G2: Touch's layout, and a menu button on the right hand too.
+            {
+                std::vector<B> b = touchLike();
+                b.push_back({Act::Menu, R + "menu/click"});
+                out.push_back({"/interaction_profiles/hp/mixed_reality_controller", "XR_EXT_hp_mixed_reality_controller", b});
+            }
+            // Index has no menu button: a hard press of the left trackpad is the menu
+            // action (Start on a tap, Select held), the right trackpad is Select. A / B
+            // on both hands: right = Circle / Cross, left = Square / Triangle.
+            {
+                std::vector<B> b;
+                poses(b);
+                bothHands(b, Act::Trigger, "trigger/value");
+                shoulders(b, "squeeze/value");
+                thumbsticks(b);
+                b.push_back({Act::Circle, R + "a/click"});
+                b.push_back({Act::Cross, R + "b/click"});
+                b.push_back({Act::Square, L + "a/click"});
+                b.push_back({Act::Triangle, L + "b/click"});
+                b.push_back({Act::Menu, L + "trackpad/force"});
+                b.push_back({Act::Select, R + "trackpad/force"});
+                out.push_back({"/interaction_profiles/valve/index_controller", "", b});
+            }
+            // Windows Mixed Reality and Odyssey: no face buttons, so the right trackpad's
+            // click is Circle / Cross / Square / Triangle by direction; both menu buttons
+            // are the menu action.
+            {
+                std::vector<B> b;
+                poses(b);
+                bothHands(b, Act::Trigger, "trigger/value");
+                shoulders(b, "squeeze/click");
+                thumbsticks(b);
+                bothHands(b, Act::Menu, "menu/click");
+                b.push_back({Act::FacePad, R + "trackpad"});
+                b.push_back({Act::FacePadClick, R + "trackpad/click"});
+                out.push_back({"/interaction_profiles/microsoft/motion_controller", "", b});
+                out.push_back({"/interaction_profiles/samsung/odyssey_controller", "XR_EXT_samsung_odyssey_controller", b});
+            }
+            // Vive wands: the left trackpad is the left stick and D-pad (its click L3), the
+            // right trackpad's click the face buttons by direction, the right menu button
+            // R3. No right stick, no L2 / R2.
+            {
+                std::vector<B> b;
+                poses(b);
+                bothHands(b, Act::Trigger, "trigger/value");
+                shoulders(b, "squeeze/click");
+                b.push_back({Act::Menu, L + "menu/click"});
+                b.push_back({Act::R3, R + "menu/click"});
+                b.push_back({Act::DPad, L + "trackpad"});
+                b.push_back({Act::LeftStick, L + "trackpad"});
+                b.push_back({Act::L3, L + "trackpad/click"});
+                b.push_back({Act::FacePad, R + "trackpad"});
+                b.push_back({Act::FacePadClick, R + "trackpad/click"});
+                out.push_back({"/interaction_profiles/htc/vive_controller", "", b});
+            }
+            return out;
+        }();
+        return all;
+    }
+}
diff --git a/ps2xRuntime/src/lib/ga2_vr_input.h b/ps2xRuntime/src/lib/ga2_vr_input.h
new file mode 100644
index 0000000..6884be7
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_vr_input.h
@@ -0,0 +1,264 @@
+#pragma once
+
+// VR controller input -> PS2 pad (pure, no OpenXR, no raylib).
+//
+// ga2_vr.cpp samples one OpenXR action per PS2 input into `Inputs` every
+// headset frame and `Mapper::step` turns them into the pad state the game
+// reads: buttons (active-high, the runtime's own bit layout), the two analog
+// sticks and the analog pressure of the shoulder buttons. All the policy that
+// is not "this action is that button" lives here so it can be unit-tested:
+//   - analog values become digital buttons with hysteresis (grips, triggers,
+//     sticks as D-pad / shoulders);
+//   - the menu action is Start on a tap and Select when held;
+//   - both grips held for a second recentre the screen (and press neither
+//     L1 nor R1);
+//   - a face pad (a trackpad whose click is the four face buttons by
+//     quadrant) for controllers without face buttons;
+//   - what the triggers press depends on the scene the game shows (Scene).
+//
+// Which PS2 inputs the games read where is in docs/vr/stereo.md (bindings).
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+
+namespace ga2_vr_input
+{
+    // The runtime's pad bits (ps2_pad.cpp), active-high here.
+    enum : uint16_t
+    {
+        kSelect = 0x0001,
+        kL3 = 0x0002,
+        kR3 = 0x0004,
+        kStart = 0x0008,
+        kUp = 0x0010,
+        kRight = 0x0020,
+        kDown = 0x0040,
+        kLeft = 0x0080,
+        kL2 = 0x0100,
+        kR2 = 0x0200,
+        kL1 = 0x0400,
+        kR1 = 0x0800,
+        kTriangle = 0x1000,
+        kCircle = 0x2000,
+        kCross = 0x4000,
+        kSquare = 0x8000,
+    };
+
+    // What the game shows, as far as the triggers care.
+    enum class Scene : uint8_t
+    {
+        Flat,        // theater screen (2D scenes, menus, movies): the trigger is the mouse click
+        Stereo,      // a 3D scene around the player, no screen to point at: the trigger confirms (Circle)
+        TacticalMap, // battle map: the trigger confirms (Circle) on what the hand points at
+        Cockpit,     // battle cockpit / attack view: the triggers fire (Cross, held)
+        UnitCamera,  // battle camera view of one unit: the triggers are L2 / R2 (zoom)
+    };
+
+    struct Vec2
+    {
+        float x = 0.0f, y = 0.0f; // OpenXR: x right, y up
+    };
+
+    // One frame of sampled actions; unbound or inactive actions stay 0.
+    struct Inputs
+    {
+        bool circle = false, cross = false, square = false, triangle = false;
+        bool start = false, select = false;
+        bool menu = false; // tap = Start, hold = Select
+        bool l3 = false, r3 = false;
+        float l1 = 0.0f, r1 = 0.0f, l2 = 0.0f, r2 = 0.0f; // 0..1
+        float trigger[2] = {0.0f, 0.0f};                   // left, right hand: point / click / fire
+        Vec2 dpad, leftStick, rightStick;
+        Vec2 facePad;           // a trackpad ...
+        bool facePadClick = false; // ... whose click presses Circle / Cross / Square / Triangle by direction
+        int activeHand = 1;     // the hand that pointed last (its trigger confirms)
+        Scene scene = Scene::Flat;
+    };
+
+    struct Output
+    {
+        uint16_t buttons = 0; // active-high
+        // The controllers deflect the stick (otherwise leave the stick to the
+        // other input devices).
+        bool leftActive = false, rightActive = false;
+        uint8_t lx = 0x80, ly = 0x80, rx = 0x80, ry = 0x80; // PS2 pad bytes (0x80 centre, y: 0 = up)
+        uint8_t pressure[4] = {0, 0, 0, 0};                 // L1, R1, L2, R2 (pad bytes 16..19 order)
+        bool recenter = false;                              // both grips were held long enough (one frame)
+    };
+
+    // Tunables (also what the tests exercise).
+    constexpr float kOn = 0.6f, kOff = 0.4f;              // analog -> button hysteresis
+    constexpr float kStickOn = 0.55f, kStickOff = 0.35f;  // stick -> D-pad hysteresis
+    constexpr float kStickDeadzone = 0.12f;
+    constexpr double kMenuHold = 0.6;     // seconds of holding menu for Select
+    constexpr double kTapPulse = 0.12;    // Start stays pressed this long after a tap
+    constexpr double kRecenterHold = 1.0; // seconds of both grips
+    constexpr float kFacePadDeadzone = 0.3f;
+
+    class Mapper
+    {
+    public:
+        Output step(const Inputs &in, double now)
+        {
+            Output out;
+            uint16_t &b = out.buttons;
+
+            // Face buttons: buttons, and the face pad's quadrants.
+            if (in.circle) b |= kCircle;
+            if (in.cross) b |= kCross;
+            if (in.square) b |= kSquare;
+            if (in.triangle) b |= kTriangle;
+            if (in.facePadClick && std::hypot(in.facePad.x, in.facePad.y) > kFacePadDeadzone)
+            {
+                if (std::fabs(in.facePad.x) > std::fabs(in.facePad.y))
+                    b |= in.facePad.x > 0.0f ? kCircle : kSquare;
+                else
+                    b |= in.facePad.y > 0.0f ? kTriangle : kCross;
+            }
+            if (in.l3) b |= kL3;
+            if (in.r3) b |= kR3;
+
+            // Start / Select: direct actions, and the menu action (tap, hold).
+            bool start = in.start, select = in.select;
+            if (in.menu)
+            {
+                if (menuSince_ < 0.0)
+                    menuSince_ = now;
+                if (now - menuSince_ >= kMenuHold)
+                    select = true;
+            }
+            else if (menuSince_ >= 0.0)
+            {
+                if (now - menuSince_ < kMenuHold)
+                    tapUntil_ = now + kTapPulse;
+                menuSince_ = -1.0;
+            }
+            if (now < tapUntil_)
+                start = true;
+            if (start) b |= kStart;
+            if (select) b |= kSelect;
+
+            // D-pad from the D-pad vector with hysteresis.
+            latch(up_, in.dpad.y, kStickOn, kStickOff);
+            latch(down_, -in.dpad.y, kStickOn, kStickOff);
+            latch(left_, -in.dpad.x, kStickOn, kStickOff);
+            latch(right_, in.dpad.x, kStickOn, kStickOff);
+            if (up_) b |= kUp;
+            if (down_) b |= kDown;
+            if (left_) b |= kLeft;
+            if (right_) b |= kRight;
+
+            // Analog sticks.
+            out.leftActive = stick(in.leftStick, out.lx, out.ly);
+            out.rightActive = stick(in.rightStick, out.rx, out.ry);
+
+            // Shoulders: the l1 / r1 / l2 / r2 actions. The right stick pushed left or
+            // right is also L2 / R2 (when its horizontal part dominates), except in
+            // the unit camera view, where the right stick turns the camera and
+            // R1 / R2 pressure zooms: there the triggers are L2 / R2.
+            float l1 = in.l1, r1 = in.r1, l2 = in.l2, r2 = in.r2;
+            if (in.scene != Scene::UnitCamera)
+            {
+                const float x = in.rightStick.x, y = in.rightStick.y;
+                if (std::fabs(x) > std::fabs(y))
+                {
+                    const float v = std::max(0.0f, (std::fabs(x) - 0.25f) / 0.75f);
+                    float &side = x < 0.0f ? l2 : r2;
+                    side = std::max(side, v);
+                }
+            }
+            else
+            {
+                l2 = std::max(l2, in.trigger[0]);
+                r2 = std::max(r2, in.trigger[1]);
+            }
+            latch(l1On_, l1, kOn, kOff);
+            latch(r1On_, r1, kOn, kOff);
+            latch(l2On_, l2, kOn, kOff);
+            latch(r2On_, r2, kOn, kOff);
+
+            // Both grips: recentre, no L1 / R1.
+            bool recenter = false;
+            if (l1On_ && r1On_)
+            {
+                if (bothSince_ < 0.0)
+                    bothSince_ = now;
+                else if (!recentered_ && now - bothSince_ > kRecenterHold)
+                {
+                    recenter = recentered_ = true;
+                }
+                l1 = r1 = 0.0f;
+            }
+            else
+            {
+                bothSince_ = -1.0;
+                recentered_ = false;
+            }
+            out.recenter = recenter;
+            if (!(l1On_ && r1On_))
+            {
+                if (l1On_) b |= kL1;
+                if (r1On_) b |= kR1;
+            }
+            if (l2On_) b |= kL2;
+            if (r2On_) b |= kR2;
+            out.pressure[0] = pressure(l1);
+            out.pressure[1] = pressure(r1);
+            out.pressure[2] = pressure(l2);
+            out.pressure[3] = pressure(r2);
+
+            // Triggers.
+            switch (in.scene)
+            {
+            case Scene::Flat:
+            case Scene::UnitCamera:
+                triggerOn_ = false;
+                break;
+            case Scene::Stereo:
+            case Scene::TacticalMap:
+                latch(triggerOn_, in.trigger[in.activeHand & 1], kOn, kOff);
+                if (triggerOn_) b |= kCircle;
+                break;
+            case Scene::Cockpit:
+                latch(triggerOn_, std::max(in.trigger[0], in.trigger[1]), kOn, kOff);
+                if (triggerOn_) b |= kCross;
+                break;
+            }
+            return out;
+        }
+
+    private:
+        static void latch(bool &state, float v, float on, float off)
+        {
+            if (state)
+                state = v > off;
+            else
+                state = v > on;
+        }
+
+        // A stick as PS2 bytes (radial dead zone, rescaled). true: deflected.
+        static bool stick(const Vec2 &s, uint8_t &bx, uint8_t &by)
+        {
+            const float len = std::hypot(s.x, s.y);
+            if (len <= kStickDeadzone)
+                return false;
+            const float scale = std::min(1.0f, (len - kStickDeadzone) / (1.0f - kStickDeadzone)) / len;
+            const float x = s.x * scale, y = s.y * scale;
+            bx = uint8_t(std::clamp(int(std::lround(128.0f + x * 127.0f)), 1, 255));
+            by = uint8_t(std::clamp(int(std::lround(128.0f - y * 127.0f)), 1, 255));
+            return true;
+        }
+
+        static uint8_t pressure(float v)
+        {
+            return v < 0.08f ? 0 : uint8_t(std::clamp(int(std::lround(v * 255.0f)), 0, 255));
+        }
+
+        bool up_ = false, down_ = false, left_ = false, right_ = false;
+        bool l1On_ = false, r1On_ = false, l2On_ = false, r2On_ = false;
+        bool triggerOn_ = false;
+        double menuSince_ = -1.0, tapUntil_ = -1.0;
+        double bothSince_ = -1.0;
+        bool recentered_ = false;
+    };
+}
