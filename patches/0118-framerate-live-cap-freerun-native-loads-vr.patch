+
+// The tick index whose time has come at `cycle` (ticks are fixed in EE cycles: tick k at
+// m_frameCycle0 + (k - m_frameBase) * numerator / fps).
+uint64_t EeScheduler::frameTickAt(uint64_t cycle) const noexcept
+{
+    if (!m_frameClockOn || cycle < m_frameCycle0)
+        return m_frameTicks;
+    const uint64_t fps = std::max<uint32_t>(1u, m_frameFps);
+    uint64_t k = m_frameBase + (cycle - m_frameCycle0) * fps / kFrameCycleNumerator;
+    while (m_frameCycle0 + (k + 1u - m_frameBase) * kFrameCycleNumerator / fps <= cycle)
+        ++k;
+    while (k > m_frameBase && m_frameCycle0 + (k - m_frameBase) * kFrameCycleNumerator / fps > cycle)
+        --k;
+    return std::max(k, m_frameTicks);
 }
 
-[[noreturn]] void EeScheduler::waitFrameTick(uint32_t interval, std::function<void(R5900Context &)> completion)
+void EeScheduler::scheduleFrameTick(uint64_t tick)
+{
+    const uint64_t fps = std::max<uint32_t>(1u, m_frameFps);
+    const uint64_t since = tick > m_frameBase ? tick - m_frameBase : 1u;
+    auto host = m_frameHost0 + std::chrono::nanoseconds(since * kFrameNanosecondNumerator / fps);
+    // After a slow stretch (or a stretch without waits) rebase the host clock instead of firing ticks back to back.
+    const auto late = std::chrono::steady_clock::now() - host;
+    if (late > std::chrono::milliseconds(50))
+    {
+        m_frameHost0 += late;
+        host += late;
+    }
+    m_frameTickQueued = true;
+    scheduleEvent(m_frameCycle0 + since * kFrameCycleNumerator / fps, host, EeEvent{EeEventType::FrameTick, 0, tick});
+}
