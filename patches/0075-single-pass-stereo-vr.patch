+            XrPosef p{};
+            p.orientation = {q.x, q.y, q.z, q.w};
+            p.position = {s.headLocal[4] + offset.x, s.headLocal[5] + offset.y, s.headLocal[6] + offset.z};
+            return p;
+        }
