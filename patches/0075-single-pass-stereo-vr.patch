diff --git a/ps2xRuntime/src/lib/ga2_stereo.cpp b/ps2xRuntime/src/lib/ga2_stereo.cpp
new file mode 100644
index 0000000..426951b
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_stereo.cpp
@@ -0,0 +1,50 @@
+#include "runtime/ga2_stereo.h"
+
+#include <mutex>
+
+namespace ga2_stereo
+{
+    namespace
+    {
+        std::mutex g_mutex;
+        Setup g_latest, g_building, g_displayed;
+        uint64_t g_serial = 0;
+    }
+
+    void publish(const Setup &setup)
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_latest = setup;
+        g_latest.serial = ++g_serial;
+    }
+
+    void clear()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_latest.active = false;
+    }
+
+    void beginFrame()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_building = g_latest;
+    }
+
+    Setup building()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        return g_building;
+    }
+
+    void flip()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        g_displayed = g_building;
+    }
+
+    Setup displayed()
+    {
+        std::lock_guard<std::mutex> lock(g_mutex);
+        return g_displayed;
+    }
+}
