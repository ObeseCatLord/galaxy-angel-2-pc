@@ -889,10 +988,21 @@ namespace ps2x::iop::detail
 
     void IopKernel::endTimeslice(IopThread &thread, uint32_t returnSentinel)
     {
-        if (thread.state != IopThreadState::Dead && (thread.cpu.pc == returnSentinel || thread.cpu.stopped))
-            thread.state = IopThreadState::Dormant;
-        else if (thread.state == IopThreadState::Running)
-            thread.state = IopThreadState::Ready;
+        // Only a thread that is still running can finish here. A thread that
+        // blocked in its last instruction (a tail-called WaitSema/SleepThread
+        // returns to the sentinel in the same step) keeps its wait state; it
+        // finishes when it is woken and resumes at the sentinel.
+        if (thread.state == IopThreadState::Running)
+        {
+            thread.state = (thread.cpu.pc == returnSentinel || thread.cpu.stopped) ? IopThreadState::Dormant
+                                                                                     : IopThreadState::Ready;
+            // A slice that merely ran out (or a preemption) keeps the thread at
+            // the front of its priority queue; only an explicit rotate sends it
+            // to the back.
+            if (thread.state == IopThreadState::Ready && thread.rotateRequested)
+                thread.readySerial = m_nextReadySerial++;
+        }
+        thread.rotateRequested = false;
         m_currentThread = nullptr;
         cleanupDeadThreads();
     }
