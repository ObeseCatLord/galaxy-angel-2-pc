--- /dev/null
+++ b/ps2xIOP/tests/iop_kernel_sched_tests.cpp
@@ -0,0 +1,378 @@
+// Kernel-level scheduling and semaphore contract: FIFO per priority, priority
+// preemption, rotate/priority changes, DisableDispatchThread and the kernel's
+// semaphore results (KE_SEMA_OVF, KE_WAIT_DELETE, KE_CAN_NOT_WAIT).
+#include "emulator/core/iop_kernel.h"
+#include "emulator/core/iop_memory.h"
+#include "emulator/iop_emulator_const.h"
+
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+
+    constexpr int32_t kSemaZero = -419, kSemaOvf = -420, kWaitDelete = -425, kCanNotWait = -417;
+
+    void require(bool condition, std::string_view message)
+    {
+        if (!condition)
+            throw std::runtime_error(std::string(message));
+    }
+
+    struct Fixture
+    {
+        IopMemory memory;
+        IopKernel kernel{memory};
+        uint64_t cycle = 0;
+
+        int32_t thread(uint32_t priority)
+        {
+            memory.write32(0x1000u + 0u, 0u);
+            memory.write32(0x1000u + 4u, 0u);
+            memory.write32(0x1000u + 8u, 0x4000u);
+            memory.write32(0x1000u + 12u, 0x400u);
+            memory.write32(0x1000u + 16u, priority);
+            IopCpuState cpu{};
+            cpu.gpr[4] = 0x1000u;
+            require(kernel.dispatchThreadImport(4u, cpu, cycle), "CreateThread");
+            require(int32_t(cpu.gpr[2]) > 0, "CreateThread failed");
+            return int32_t(cpu.gpr[2]);
+        }
+        int32_t call(IopCpuState &cpu, uint16_t ordinal, uint32_t a0 = 0u, uint32_t a1 = 0u)
+        {
+            cpu.gpr[4] = a0;
+            cpu.gpr[5] = a1;
+            require(kernel.dispatchThreadImport(ordinal, cpu, cycle), "thread import not handled");
+            return int32_t(cpu.gpr[2]);
+        }
+        int32_t sema(IopCpuState &cpu, uint16_t ordinal, uint32_t a0)
+        {
+            cpu.gpr[4] = a0;
+            require(kernel.dispatchSemaphoreImport(ordinal, cpu), "semaphore import not handled");
+            return int32_t(cpu.gpr[2]);
+        }
+        int32_t start(int32_t id, IopCpuState &caller)
+        {
+            return call(caller, 6u, uint32_t(id), 0u);
+        }
+        int32_t makeSema(uint32_t attr, uint32_t initial, uint32_t maximum)
+        {
+            memory.write32(0x1100u + 0u, attr);
+            memory.write32(0x1100u + 4u, 0u);
+            memory.write32(0x1100u + 8u, initial);
+            memory.write32(0x1100u + 12u, maximum);
+            IopCpuState cpu{};
+            cpu.gpr[4] = 0x1100u;
+            require(kernel.dispatchSemaphoreImport(4u, cpu), "CreateSema");
+            return int32_t(cpu.gpr[2]);
+        }
+        // One scheduler slice: run the next thread, return its id (0 if idle).
+        IopThread *begin() { return kernel.beginNextReady(cycle); }
+        void end(IopThread &t) { kernel.endTimeslice(t, kThreadReturnSentinel); }
+        int32_t sliceOwner()
+        {
+            IopThread *t = begin();
+            if (!t) return 0;
+            const int32_t id = t->id;
+            end(*t);
+            return id;
+        }
+    };
+
+    void equalPriorityIsFifoAndNeverTimeslices()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t a = f.thread(10), b = f.thread(10), c = f.thread(10);
+        // Start in c, a, b order: that, not the thread id, is the queue order.
+        require(f.start(c, boot) == 0 && f.start(a, boot) == 0 && f.start(b, boot) == 0, "start");
+        require(f.sliceOwner() == c, "the first started thread must run first");
+        require(f.sliceOwner() == c, "a slice that merely ends must not rotate equal priorities");
+        // c yields explicitly: it goes to the back.
+        IopThread *t = f.begin();
+        require(t && t->id == c, "c is still at the front");
+        IopCpuState &cpu = t->cpu;
+        require(f.call(cpu, 16u, 0u) == 0 && cpu.yielded, "RotateThreadReadyQueue(0)");
+        f.end(*t);
+        require(f.sliceOwner() == a, "rotate must hand over to the next thread in FIFO order");
+        require(f.sliceOwner() == a, "a stays at the front until it yields or blocks");
+        (void)b;
+    }
+
+    void rotateOfAnotherQueueMovesItsFront()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t hi = f.thread(5), x = f.thread(20), y = f.thread(20);
+        require(f.start(x, boot) == 0 && f.start(y, boot) == 0 && f.start(hi, boot) == 0, "start");
+        IopThread *t = f.begin();
+        require(t && t->id == hi, "highest priority runs");
+        // The running thread rotates priority 20: x (front) goes behind y.
+        require(f.call(t->cpu, 16u, 20u) == 0 && !t->rotateRequested, "rotate of another priority");
+        t->state = IopThreadState::Sleep; // hi sleeps
+        f.end(*t);
+        require(f.sliceOwner() == y, "front of the rotated queue moved behind its peer");
+    }
+
+    void higherPriorityPreemptsAndPreemptedThreadKeepsItsPlace()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t low1 = f.thread(20), low2 = f.thread(20), high = f.thread(5);
+        require(f.start(low1, boot) == 0 && f.start(low2, boot) == 0, "start lows");
+        IopThread *running = f.begin();
+        require(running && running->id == low1, "low1 runs");
+        // low1 is mid-slice when an interrupt handler starts the higher thread.
+        IopCpuState handler{};
+        require(f.start(high, handler) == 0, "start high");
+        require(running->cpu.yielded, "starting a higher-priority thread must preempt the running one");
+        f.end(*running);
+        require(running->state == IopThreadState::Ready, "preempted thread stays ready");
+        IopThread *next = f.begin();
+        require(next && next->id == high, "the higher priority thread runs next");
+        next->state = IopThreadState::Sleep;
+        f.end(*next);
+        require(f.sliceOwner() == low1, "a preempted thread resumes before its equal-priority peer");
+    }
+
+    void wakeupsPreemptOnlyWhenOutranked()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t sleeperHi = f.thread(5), sleeperLo = f.thread(30), runner = f.thread(10);
+        require(f.start(sleeperHi, boot) == 0 && f.start(sleeperLo, boot) == 0, "start");
+        // Put both sleepers to sleep, then start the runner.
+        for (int i = 0; i < 2; ++i)
+        {
+            IopThread *t = f.begin();
+            require(t, "sleeper ready");
+            t->state = IopThreadState::Sleep;
+            f.end(*t);
+        }
+        require(f.start(runner, boot) == 0, "start runner");
+        IopThread *running = f.begin();
+        require(running && running->id == runner, "runner runs");
+        IopCpuState irq{};
+        require(f.call(irq, 26u, uint32_t(sleeperLo)) == 0 && !running->cpu.yielded,
+                "waking a lower priority thread must not preempt");
+        require(f.call(irq, 26u, uint32_t(sleeperHi)) == 0 && running->cpu.yielded,
+                "waking a higher priority thread must preempt");
+        f.end(*running);
+        require(f.sliceOwner() == sleeperHi, "the woken high priority thread runs first");
+    }
+
+    void semaphoreSignalPreempts()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t waiter = f.thread(5), runner = f.thread(10);
+        const int32_t sem = f.makeSema(0, 0, 1);
+        require(f.start(waiter, boot) == 0 && f.start(runner, boot) == 0, "start");
+        IopThread *w = f.begin();
+        require(w && w->id == waiter, "waiter runs first");
+        require(f.sema(w->cpu, 8u, uint32_t(sem)) == 0 && w->state == IopThreadState::Semaphore, "waiter blocks");
+        f.end(*w);
+        IopThread *r = f.begin();
+        require(r && r->id == runner, "runner runs");
+        require(f.sema(r->cpu, 6u, uint32_t(sem)) == 0, "signal");
+        require(r->cpu.yielded, "a signal that readies a higher-priority waiter must preempt the signaller");
+        f.end(*r);
+        require(f.sliceOwner() == waiter, "the waiter runs after the signal");
+    }
+
+    void disableDispatchDefersPreemption()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t low = f.thread(20), high = f.thread(5);
+        require(f.start(low, boot) == 0, "start low");
+        IopThread *running = f.begin();
+        require(running && running->id == low, "low runs");
+        require(f.call(running->cpu, 12u) == 0, "DisableDispatchThread");
+        require(f.start(high, running->cpu) == 0 && !running->cpu.yielded,
+                "no preemption while dispatch is disabled");
+        require(f.call(running->cpu, 13u) == 0 && running->cpu.yielded,
+                "EnableDispatchThread must apply the deferred preemption");
+        f.end(*running);
+        require(f.sliceOwner() == high, "the deferred higher priority thread runs");
+    }
+
+    void priorityChangeReordersAndPreempts()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t a = f.thread(10), b = f.thread(15);
+        require(f.start(a, boot) == 0 && f.start(b, boot) == 0, "start");
+        IopThread *running = f.begin();
+        require(running && running->id == a, "a runs");
+        // a lowers itself below b: it must yield to b.
+        require(f.call(running->cpu, 14u, 0u, 30u) == 0 && running->cpu.yielded, "ChangeThreadPriority(self, lower)");
+        f.end(*running);
+        require(f.sliceOwner() == b, "b outranks a after the change");
+    }
+
+    void expiredDelaysWakeInTimeOrder()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t a = f.thread(10), b = f.thread(10);
+        require(f.start(a, boot) == 0 && f.start(b, boot) == 0, "start");
+        // b delays 100us, a delays 300us; both expire before the next slice.
+        IopThread *t = f.begin();
+        require(t && t->id == a, "a first");
+        require(f.call(t->cpu, 33u, 300u) == 0 && t->state == IopThreadState::Delay, "a delays");
+        f.end(*t);
+        t = f.begin();
+        require(t && t->id == b, "b second");
+        require(f.call(t->cpu, 33u, 100u) == 0 && t->state == IopThreadState::Delay, "b delays");
+        f.end(*t);
+        require(f.begin() == nullptr, "everybody sleeps");
+        f.cycle += kIopClockHz; // one second later
+        require(f.sliceOwner() == b, "the shorter delay wakes (and runs) first");
+    }
+
+    void semaphoreSignalOverflowAndDelete()
+    {
+        Fixture f;
+        IopCpuState cpu{};
+        const int32_t sem = f.makeSema(0, 0, 2);
+        require(f.sema(cpu, 6u, uint32_t(sem)) == 0 && f.sema(cpu, 6u, uint32_t(sem)) == 0, "two signals");
+        require(f.sema(cpu, 6u, uint32_t(sem)) == kSemaOvf, "a third signal reports KE_SEMA_OVF");
+        require(f.sema(cpu, 9u, uint32_t(sem)) == 0 && f.sema(cpu, 9u, uint32_t(sem)) == 0 &&
+                    f.sema(cpu, 9u, uint32_t(sem)) == kSemaZero,
+                "the overflowing signal must not have raised the count");
+
+        // A waiter takes the token directly and a later signal still works.
+        IopCpuState boot{};
+        const int32_t t1 = f.thread(10);
+        require(f.start(t1, boot) == 0, "start");
+        IopThread *t = f.begin();
+        require(t && f.sema(t->cpu, 8u, uint32_t(sem)) == 0 && t->state == IopThreadState::Semaphore, "wait blocks");
+        f.end(*t);
+        require(f.sema(cpu, 7u, uint32_t(sem)) == 0, "iSignalSema hands the token over");
+        t = f.begin();
+        require(t && t->id == t1, "waiter is ready");
+        f.end(*t);
+
+        // DeleteSema releases waiters with KE_WAIT_DELETE.
+        const int32_t sem2 = f.makeSema(0, 0, 1);
+        t = f.begin();
+        require(t && f.sema(t->cpu, 8u, uint32_t(sem2)) == 0 && t->state == IopThreadState::Semaphore, "wait on sem2");
+        f.end(*t);
+        require(f.sema(cpu, 5u, uint32_t(sem2)) == 0, "DeleteSema");
+        t = f.begin();
+        require(t && int32_t(t->cpu.gpr[2]) == kWaitDelete, "the waiter must wake with KE_WAIT_DELETE");
+        f.end(*t);
+    }
+
+    void waitersWakeInArrivalOrderThenPriority()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t first = f.thread(20), second = f.thread(10);
+        const int32_t sem = f.makeSema(0, 0, 4);
+        require(f.start(first, boot) == 0 && f.start(second, boot) == 0, "start");
+        IopThread *t = f.begin(); // second (priority 10) runs first
+        require(t && t->id == second, "second runs");
+        require(f.sema(t->cpu, 8u, uint32_t(sem)) == 0, "second waits");
+        f.end(*t);
+        t = f.begin();
+        require(t && t->id == first, "first runs");
+        require(f.sema(t->cpu, 8u, uint32_t(sem)) == 0, "first waits");
+        f.end(*t);
+        IopCpuState cpu{};
+        require(f.sema(cpu, 6u, uint32_t(sem)) == 0, "signal");
+        require(f.sliceOwner() == second, "the better priority waiter gets the token");
+        // Equal priorities: arrival order.
+        Fixture g;
+        const int32_t p = g.thread(10), q = g.thread(10);
+        const int32_t sg = g.makeSema(0, 0, 4);
+        require(g.start(q, boot) == 0 && g.start(p, boot) == 0, "start");
+        t = g.begin();
+        const int32_t arrivedFirst = t->id;
+        require(g.sema(t->cpu, 8u, uint32_t(sg)) == 0, "first waits");
+        g.end(*t);
+        t = g.begin();
+        require(g.sema(t->cpu, 8u, uint32_t(sg)) == 0, "second waits");
+        g.end(*t);
+        require(g.sema(cpu, 6u, uint32_t(sg)) == 0 && g.sliceOwner() == arrivedFirst,
+                "equal priority waiters are served first come first served");
+    }
+
+    void waitOutsideAThreadCannotBlock()
+    {
+        Fixture f;
+        IopCpuState callback{};
+        const int32_t sem = f.makeSema(0, 1, 1);
+        require(f.sema(callback, 8u, uint32_t(sem)) == 0, "a token is still taken without a thread");
+        require(f.sema(callback, 8u, uint32_t(sem)) == kCanNotWait, "no token: KE_CAN_NOT_WAIT, v0 always written");
+        require(f.kernel.cannotWaitCount() == 1u, "the refusal is counted for diagnostics");
+        // Even with a thread running, a different CPU (an interrupt handler's
+        // private CPU) must not park the interrupted thread.
+        IopCpuState boot{};
+        const int32_t id = f.thread(10);
+        require(f.start(id, boot) == 0, "start");
+        IopThread *t = f.begin();
+        require(t, "thread runs");
+        callback.gpr[2] = 0xDEADu;
+        require(f.sema(callback, 8u, uint32_t(sem)) == kCanNotWait && t->state == IopThreadState::Running,
+                "a callback CPU must not block the interrupted thread");
+        f.end(*t);
+    }
+
+    void tailCalledBlockingImportKeepsItsWait()
+    {
+        Fixture f;
+        IopCpuState boot{};
+        const int32_t id = f.thread(10);
+        const int32_t sem = f.makeSema(0, 0, 1);
+        require(f.start(id, boot) == 0, "start");
+        IopThread *t = f.begin();
+        require(t, "thread runs");
+        // `j WaitSema` as the thread's last instruction: the import returns to
+        // the thread-return sentinel in the same step that blocks.
+        require(f.sema(t->cpu, 8u, uint32_t(sem)) == 0, "wait blocks");
+        t->cpu.pc = kThreadReturnSentinel;
+        f.end(*t);
+        require(t->state == IopThreadState::Semaphore, "a blocked thread must not become dormant at the sentinel");
+        IopCpuState cpu{};
+        require(f.sema(cpu, 6u, uint32_t(sem)) == 0, "signal");
+        t = f.begin();
+        require(t && t->id == id && t->cpu.pc == kThreadReturnSentinel, "woken thread resumes at the sentinel");
+        t->cpu.stopped = true; // runCpu: sentinel reached
+        f.end(*t);
+        require(t->state == IopThreadState::Dormant, "and finishes once it has been woken");
+    }
+}
+
+int main()
+{
+    struct Case { const char *name; void (*run)(); };
+    const Case cases[] = {
+        {"equal priority is FIFO and never time-sliced", equalPriorityIsFifoAndNeverTimeslices},
+        {"rotating another priority queue", rotateOfAnotherQueueMovesItsFront},
+        {"higher priority preempts, preempted keeps its place", higherPriorityPreemptsAndPreemptedThreadKeepsItsPlace},
+        {"wakeups preempt only when outranked", wakeupsPreemptOnlyWhenOutranked},
+        {"semaphore signal preempts", semaphoreSignalPreempts},
+        {"DisableDispatchThread defers preemption", disableDispatchDefersPreemption},
+        {"priority change reorders and preempts", priorityChangeReordersAndPreempts},
+        {"expired delays wake in time order", expiredDelaysWakeInTimeOrder},
+        {"semaphore overflow and delete results", semaphoreSignalOverflowAndDelete},
+        {"semaphore waiters: priority then arrival", waitersWakeInArrivalOrderThenPriority},
+        {"WaitSema outside a thread cannot block", waitOutsideAThreadCannotBlock},
+        {"tail-called blocking import keeps its wait", tailCalledBlockingImportKeepsItsWait},
+    };
+    size_t failures = 0;
+    for (const Case &c : cases)
+    {
+        try { c.run(); std::cout << "PASS " << c.name << '\n'; }
+        catch (const std::exception &error) { ++failures; std::cerr << "FAIL " << c.name << ": " << error.what() << '\n'; }
+    }
+    std::cout << sizeof(cases) / sizeof(cases[0]) - failures << '/' << sizeof(cases) / sizeof(cases[0]) << " cases passed\n";
+    return failures == 0 ? 0 : 1;
+}
