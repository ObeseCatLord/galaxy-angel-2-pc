diff --git a/ps2xRuntime/include/ps2_runtime_macros.h b/ps2xRuntime/include/ps2_runtime_macros.h
index 895032e..fdcd355 100644
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -597,11 +597,6 @@ inline __m128i ps2_u64_to_epi64_pair(uint64_t value)
     return _mm_set1_epi64x(static_cast<long long>(value));
 }
 
-#define PS2_PMFHL_LW(hi, lo) _mm_unpacklo_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_UW(hi, lo) _mm_unpackhi_epi64(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_SLW(hi, lo) _mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi))
-#define PS2_PMFHL_LH(hi, lo) _mm_shuffle_epi32(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0))
-#define PS2_PMFHL_SH(hi, lo) _mm_shufflehi_epi16(_mm_shufflelo_epi16(_mm_packs_epi32(ps2_u64_to_epi64_pair(lo), ps2_u64_to_epi64_pair(hi)), _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0))
 
 // FPU (COP1) operations
 #define FPU_SET_ACC(ctx, res) (ctx->f_acc = res)
@@ -750,9 +745,108 @@ inline __m128i ps2_qfsrv(__m128i rs, __m128i rt, uint32_t sa)
 }
 #define PS2_QFSRV(rs, rt, sa) ps2_qfsrv((__m128i)(rs), (__m128i)(rt), (uint32_t)(sa))
 #define PS2_PCPYLD(rs, rt) _mm_unpacklo_epi64(rt, rs)
-#define PS2_PEXEH(rs) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rs, _MM_SHUFFLE(2, 3, 0, 1)), _MM_SHUFFLE(2, 3, 0, 1))
-#define PS2_PEXEW(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(2, 3, 0, 1))
-#define PS2_PROT3W(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(0, 3, 2, 1))
+// PEXEH: exchange halfwords 0<->2 in each doubleword; PEXCH: 1<->2.
+#define PS2_PEXEH(rs) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rs, _MM_SHUFFLE(3, 0, 1, 2)), _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_PEXCH(rs) _mm_shufflelo_epi16(_mm_shufflehi_epi16(rs, _MM_SHUFFLE(3, 1, 2, 0)), _MM_SHUFFLE(3, 1, 2, 0))
+// PEXEW: words 0<->2; PROT3W: words 0,1,2 rotate (w0=w1, w1=w2, w2=w0), w3 kept.
+#define PS2_PEXEW(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(3, 0, 1, 2))
+#define PS2_PROT3W(rs) _mm_shuffle_epi32(rs, _MM_SHUFFLE(3, 0, 2, 1))
+
+// The EE's LO and HI are 128 bits: ctx->lo/hi hold bits 0-63 (pipeline 0),
+// ctx->lo1/hi1 bits 64-127 (pipeline 1, MULT1/DIV1).
+static inline __m128i ps2_lo128(const R5900Context *ctx) { return _mm_set_epi64x((long long)ctx->lo1, (long long)ctx->lo); }
+static inline __m128i ps2_hi128(const R5900Context *ctx) { return _mm_set_epi64x((long long)ctx->hi1, (long long)ctx->hi); }
+static inline void ps2_set_lo128(R5900Context *ctx, __m128i v)
+{
+    ctx->lo = (uint64_t)_mm_cvtsi128_si64(v);
+    ctx->lo1 = (uint64_t)_mm_cvtsi128_si64(_mm_unpackhi_epi64(v, v));
+}
+static inline void ps2_set_hi128(R5900Context *ctx, __m128i v)
+{
+    ctx->hi = (uint64_t)_mm_cvtsi128_si64(v);
+    ctx->hi1 = (uint64_t)_mm_cvtsi128_si64(_mm_unpackhi_epi64(v, v));
+}
+
+// PMULTH/PMADDH/PMSUBH: eight signed 16x16 products p0..p7.  LO = {p0, p1,
+// p4, p5} and HI = {p2, p3, p6, p7} (set, added or subtracted per word);
+// rd = {LO.w0, HI.w0, LO.w2, HI.w2}.  mode: 0 set, 1 add, -1 subtract.
+static inline __m128i ps2_pmulth(R5900Context *ctx, __m128i rs, __m128i rt, int mode)
+{
+    const __m128i lo16 = _mm_mullo_epi16(rs, rt), hi16 = _mm_mulhi_epi16(rs, rt);
+    const __m128i p0123 = _mm_unpacklo_epi16(lo16, hi16), p4567 = _mm_unpackhi_epi16(lo16, hi16);
+    __m128i lo = _mm_unpacklo_epi64(p0123, p4567); // p0 p1 p4 p5
+    __m128i hi = _mm_unpackhi_epi64(p0123, p4567); // p2 p3 p6 p7
+    if (mode > 0)
+    {
+        lo = _mm_add_epi32(ps2_lo128(ctx), lo);
+        hi = _mm_add_epi32(ps2_hi128(ctx), hi);
+    }
+    else if (mode < 0)
+    {
+        lo = _mm_sub_epi32(ps2_lo128(ctx), lo);
+        hi = _mm_sub_epi32(ps2_hi128(ctx), hi);
+    }
+    ps2_set_lo128(ctx, lo);
+    ps2_set_hi128(ctx, hi);
+    // {lo.w0, hi.w0, lo.w2, hi.w2}
+    return _mm_unpacklo_epi32(_mm_shuffle_epi32(lo, _MM_SHUFFLE(3, 1, 2, 0)), _mm_shuffle_epi32(hi, _MM_SHUFFLE(3, 1, 2, 0)));
+}
+
+// PMFHL: LW {LO.w0, HI.w0, LO.w2, HI.w2}; UW {LO.w1, HI.w1, LO.w3, HI.w3};
+// SLW: each doubleword HI.w:LO.w (w = 0, 2) saturated to 32 bits, sign-extended;
+// LH {LO.h0, LO.h2, HI.h0, HI.h2, LO.h4, LO.h6, HI.h4, HI.h6};
+// SH: the eight words LO.w0 LO.w1 HI.w0 HI.w1 LO.w2 LO.w3 HI.w2 HI.w3
+// saturated to halfwords.
+static inline __m128i ps2_pmfhl(const R5900Context *ctx, int fmt)
+{
+    const __m128i lo = ps2_lo128(ctx), hi = ps2_hi128(ctx);
+    switch (fmt)
+    {
+    case 0: // LW
+        return _mm_unpacklo_epi32(_mm_shuffle_epi32(lo, _MM_SHUFFLE(3, 1, 2, 0)), _mm_shuffle_epi32(hi, _MM_SHUFFLE(3, 1, 2, 0)));
+    case 1: // UW
+        return _mm_unpacklo_epi32(_mm_shuffle_epi32(lo, _MM_SHUFFLE(2, 0, 3, 1)), _mm_shuffle_epi32(hi, _MM_SHUFFLE(2, 0, 3, 1)));
+    case 2: // SLW
+    {
+        int64_t out[2];
+        for (int i = 0; i < 2; ++i)
+        {
+            const uint32_t l = (uint32_t)(i ? (ctx->lo1 & 0xFFFFFFFFu) : (ctx->lo & 0xFFFFFFFFu));
+            const uint32_t h = (uint32_t)(i ? (ctx->hi1 & 0xFFFFFFFFu) : (ctx->hi & 0xFFFFFFFFu));
+            const int64_t v = (int64_t)(((uint64_t)h << 32) | l);
+            out[i] = v > INT32_MAX ? INT32_MAX : v < INT32_MIN ? INT32_MIN : v;
+        }
+        return _mm_set_epi64x(out[1], out[0]);
+    }
+    case 3: // LH
+    {
+        alignas(16) uint16_t l[8], h[8], out[8];
+        _mm_store_si128((__m128i *)l, lo);
+        _mm_store_si128((__m128i *)h, hi);
+        const uint16_t picked[8] = {l[0], l[2], h[0], h[2], l[4], l[6], h[4], h[6]};
+        std::memcpy(out, picked, sizeof(out));
+        return _mm_load_si128((const __m128i *)out);
+    }
+    default: // SH
+    {
+        const __m128i first = _mm_unpacklo_epi64(lo, hi);  // LO.w0 LO.w1 HI.w0 HI.w1
+        const __m128i second = _mm_unpackhi_epi64(lo, hi); // LO.w2 LO.w3 HI.w2 HI.w3
+        return _mm_packs_epi32(first, second);
+    }
+    }
+}
+
+// PMTHL.LW: LO.w0 = rs.w0, HI.w0 = rs.w1, LO.w2 = rs.w2, HI.w2 = rs.w3.
+static inline void ps2_pmthl_lw(R5900Context *ctx, __m128i rs)
+{
+    alignas(16) uint32_t w[4], lo[4], hi[4];
+    _mm_store_si128((__m128i *)w, rs);
+    _mm_store_si128((__m128i *)lo, ps2_lo128(ctx));
+    _mm_store_si128((__m128i *)hi, ps2_hi128(ctx));
+    lo[0] = w[0]; hi[0] = w[1]; lo[2] = w[2]; hi[2] = w[3];
+    ps2_set_lo128(ctx, _mm_load_si128((const __m128i *)lo));
+    ps2_set_hi128(ctx, _mm_load_si128((const __m128i *)hi));
+}
 
 // Additional VU0 operations
 #define PS2_VSQRT(x) sqrtf(x)
