+            t.IsTrue(ctx.lo == ((uint64_t)(uint32_t)-40 << 32 | 10u) && ctx.hi == (160ull << 32 | 90u), "LO/HI words 0-1");
+            t.IsTrue(ctx.lo1 == (360ull << 32 | 250u) && ctx.hi1 == ((uint64_t)(uint32_t)-640 << 32 | 490u), "LO/HI words 2-3");
+            ps2_pmulth(&ctx, rs, rt, 1);
+            t.IsTrue((uint32_t)ctx.lo == 20u && (uint32_t)ctx.hi1 == 980u, "PMADDH adds per word");
