diff --git a/ps2xRuntime/src/lib/ga2_cheat_menu.cpp b/ps2xRuntime/src/lib/ga2_cheat_menu.cpp
new file mode 100644
index 0000000..a203d58
--- /dev/null
+++ b/ps2xRuntime/src/lib/ga2_cheat_menu.cpp
@@ -0,0 +1,155 @@
+#include "ga2_cheat_menu.h"
+#include "runtime/ga2_cheats.h"
+
+#include "raylib.h"
+
+#include <string>
+#include <vector>
+
+namespace ga2_cheats
+{
+    State &state()
+    {
+        static State s;
+        return s;
+    }
+}
+
+namespace ga2_cheat_menu
+{
+    namespace
+    {
+        bool g_open = false;
+        int g_selected = 0;
+        std::string g_notice;
+        double g_noticeUntil = 0.0;
+
+        struct Item
+        {
+            const char *label;
+            std::atomic<bool> *toggle; // nullptr: the skip action
+        };
+
+        std::vector<Item> items()
+        {
+            ga2_cheats::State &s = ga2_cheats::state();
+            return {{"Skip this battle (win, best result)", nullptr},
+                    {"Invincible units", &s.invincible},
+                    {"Infinite energy and spirit", &s.infiniteEnergy},
+                    {"One-hit kills", &s.oneHitKill},
+                    {"Stop the time limit", &s.stopTimer}};
+        }
+
+        Rectangle panel()
+        {
+            const float w = 560.0f, h = 330.0f;
+            return Rectangle{(GetScreenWidth() - w) * 0.5f, (GetScreenHeight() - h) * 0.5f, w, h};
+        }
+
+        Rectangle row(int i)
+        {
+            const Rectangle p = panel();
+            return Rectangle{p.x + 16.0f, p.y + 70.0f + 46.0f * float(i), p.width - 32.0f, 40.0f};
+        }
+
+        void activate(int index, const uint8_t *rdram)
+        {
+            const auto list = items();
+            if (list[size_t(index)].toggle)
+            {
+                list[size_t(index)].toggle->store(!list[size_t(index)].toggle->load());
+                return;
+            }
+            if (!ga2_cheats::battleActive(rdram))
+            {
+                g_notice = "Only during a battle";
+                g_noticeUntil = GetTime() + 2.0;
+                return;
+            }
+            ga2_cheats::state().skipRequested = true;
+            g_notice = "Battle skipped";
+            g_noticeUntil = GetTime() + 2.0;
+            g_open = false;
+        }
+    }
+
+    bool open() { return g_open; }
+
+    void update(const uint8_t *rdram)
+    {
+        if (!ga2_cheats::state().available.load())
+            return;
+        const bool padToggle = IsGamepadAvailable(0) && IsGamepadButtonDown(0, GAMEPAD_BUTTON_LEFT_THUMB) &&
+                               IsGamepadButtonPressed(0, GAMEPAD_BUTTON_RIGHT_THUMB);
+        if (IsKeyPressed(KEY_F1) || padToggle)
+        {
+            g_open = !g_open;
+            return;
+        }
+        if (!g_open)
+            return;
+        const int count = int(items().size());
+        if (IsKeyPressed(KEY_ESCAPE) || IsKeyPressed(KEY_BACKSPACE) || IsGamepadButtonPressed(0, GAMEPAD_BUTTON_RIGHT_FACE_DOWN))
+        {
+            g_open = false;
+            return;
+        }
+        if (IsKeyPressed(KEY_UP) || IsGamepadButtonPressed(0, GAMEPAD_BUTTON_LEFT_FACE_UP))
+            g_selected = (g_selected + count - 1) % count;
+        if (IsKeyPressed(KEY_DOWN) || IsGamepadButtonPressed(0, GAMEPAD_BUTTON_LEFT_FACE_DOWN))
+            g_selected = (g_selected + 1) % count;
+        const Vector2 mouse = GetMousePosition();
+        for (int i = 0; i < count; ++i)
+            if (CheckCollisionPointRec(mouse, row(i)))
+            {
+                if (GetMouseDelta().x != 0.0f || GetMouseDelta().y != 0.0f)
+                    g_selected = i;
+                if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT))
+                {
+                    g_selected = i;
+                    activate(i, rdram);
+                    return;
+                }
+            }
+        if (IsKeyPressed(KEY_ENTER) || IsKeyPressed(KEY_SPACE) || IsKeyPressed(KEY_LEFT) || IsKeyPressed(KEY_RIGHT) ||
+            IsGamepadButtonPressed(0, GAMEPAD_BUTTON_RIGHT_FACE_RIGHT))
+            activate(g_selected, rdram);
+    }
+
+    void draw(const uint8_t *rdram)
+    {
+        if (!g_open)
+        {
+            if (GetTime() < g_noticeUntil)
+            {
+                const int w = MeasureText(g_notice.c_str(), 22);
+                DrawRectangle(20, 20, w + 24, 36, Color{10, 16, 40, 210});
+                DrawText(g_notice.c_str(), 32, 27, 22, Color{150, 205, 255, 255});
+            }
+            return;
+        }
+        const Rectangle p = panel();
+        DrawRectangle(0, 0, GetScreenWidth(), GetScreenHeight(), Color{0, 0, 0, 120});
+        DrawRectangleRounded(p, 0.06f, 8, Color{12, 18, 44, 235});
+        DrawRectangleRoundedLinesEx(p, 0.06f, 8, 2.0f, Color{90, 160, 255, 255});
+        DrawText("CHEATS", int(p.x) + 20, int(p.y) + 18, 30, Color{230, 236, 250, 255});
+        DrawText("F1 / L3+R3: close", int(p.x + p.width) - 190, int(p.y) + 26, 16, Color{130, 140, 170, 255});
+        const auto list = items();
+        const bool battle = ga2_cheats::battleActive(rdram);
+        for (int i = 0; i < int(list.size()); ++i)
+        {
+            const Rectangle r = row(i);
+            if (i == g_selected)
+                DrawRectangleRec(r, Color{30, 44, 90, 255});
+            const bool enabled = list[size_t(i)].toggle || battle;
+            DrawText(list[size_t(i)].label, int(r.x) + 14, int(r.y) + 10, 20,
+                     enabled ? Color{230, 236, 250, 255} : Color{110, 118, 140, 255});
+            const char *value = list[size_t(i)].toggle ? (list[size_t(i)].toggle->load() ? "ON" : "OFF")
+                                                       : (battle ? "Enter" : "no battle");
+            const int w = MeasureText(value, 20);
+            DrawText(value, int(r.x + r.width) - w - 14, int(r.y) + 10, 20,
+                     list[size_t(i)].toggle && list[size_t(i)].toggle->load() ? Color{120, 220, 150, 255}
+                                                                             : Color{150, 160, 190, 255});
+        }
+    }
+}
