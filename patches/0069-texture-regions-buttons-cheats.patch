diff --git a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
index 5166d1f..6a60d70 100644
--- a/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
+++ b/ps2xRuntime/src/lib/gs/gs_texpacks.cpp
@@ -1,13 +1,16 @@
-// Texture packs for paraLLEl-GS (see gs_texpacks.h): every texture the GS
-// samples is identified by a hash of its decoded RGBA (texels through the
-// palette, at its full 2^TW x 2^TH size), read from the CPU copy of GS memory
-// that the runtime keeps alongside the GPU renderer. A PNG named after that
-// hash in a pack folder replaces it, at any resolution.
+// Texture packs for paraLLEl-GS (see gs_texpacks.h): every texture region
+// the GS samples (the cached rectangle paraLLEl-GS derives from the draws'
+// texture coordinates; games often declare textures larger than their art,
+// so the region is what stays stable) is identified by a hash of its decoded
+// RGBA (texels through the palette), read from the CPU copy of GS memory the
+// runtime keeps alongside the GPU renderer. A PNG named after that hash in a
+// pack folder replaces the region, at any resolution.
 #include "gs_texpacks.h"
 
 #if defined(PS2X_HAVE_PGS)
 
 #include "runtime/gs/ps2_gs_memory.h"
+#include <nlohmann/json.hpp>
 #include "raylib.h"
 
 #include "device.hpp"
@@ -17,6 +20,7 @@
 #include <cstdio>
 #include <cstring>
 #include <filesystem>
+#include <fstream>
 #include <mutex>
 #include <unordered_map>
 #include <unordered_set>
@@ -40,6 +44,120 @@ namespace ga2_texpacks
         // as it runs, so every image handed out stays alive here (this also
         // keeps PNGs from being decoded twice).
         std::unordered_map<std::string, ImageHandle> g_images;
+
+        // Button prompts (native/buttons): textures known to hold PS2 button
+        // icons get the port's own icons for the player's input device drawn
+        // over them, at 4x resolution.
+        struct IconSpot
+        {
+            std::string button;
+            int x = 0, y = 0, w = 0, h = 0;
+        };
+        std::string g_style = "playstation";
+        std::string g_buttonDir;
+        bool g_buttonMapLoaded = false;
+        std::unordered_map<uint64_t, std::vector<IconSpot>> g_buttonMap;
+        std::unordered_map<std::string, ::Image> g_icons; // style/button
+
+        void loadButtonMap()
+        {
+            g_buttonMapLoaded = true;
+            if (g_buttonDir.empty())
+                return;
+            std::ifstream in(std::filesystem::path(g_buttonDir) / "map.json");
+            if (!in)
+                return;
+            try
+            {
+                const nlohmann::json doc = nlohmann::json::parse(in);
+                for (const auto &[hash, spots] : doc.at("textures").items())
+                    for (const auto &spot : spots)
+                        g_buttonMap[std::stoull(hash, nullptr, 16)].push_back(
+                            {spot.at("button").get<std::string>(), spot.at("x").get<int>(), spot.at("y").get<int>(),
+                             spot.at("w").get<int>(), spot.at("h").get<int>()});
+                std::fprintf(stderr, "[texpacks] button map: %zu textures\n", g_buttonMap.size());
+            }
+            catch (const std::exception &e)
+            {
+                std::fprintf(stderr, "[texpacks] button map: %s\n", e.what());
+            }
+        }
+
+        const ::Image *icon(const std::string &button)
+        {
+            const std::string key = g_style + "/" + button;
+            auto it = g_icons.find(key);
+            if (it == g_icons.end())
+            {
+                ::Image image = LoadImage((std::filesystem::path(g_buttonDir) / g_style / (button + ".png")).string().c_str());
+                if (image.data)
+                    ImageFormat(&image, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8);
+                it = g_icons.emplace(key, image).first;
+            }
+            return it->second.data ? &it->second : nullptr;
+        }
+
+        // The texture at 4x with the device's icons over the PS2 ones; RGBA
+        // with alpha 255 = opaque.
+        bool composeButtons(const std::vector<uint32_t> &px, uint32_t w, uint32_t h, const std::vector<IconSpot> &spots,
+                            ::Image &out)
+        {
+            constexpr int k = 4;
+            std::vector<uint32_t> base(px);
+            for (uint32_t &c : base)
+                c = (c & 0x00FFFFFFu) | (std::min<uint32_t>(255u, (c >> 24) * 2u) << 24);
+            ::Image src{base.data(), int(w), int(h), 1, PIXELFORMAT_UNCOMPRESSED_R8G8B8A8};
+            out = ImageCopy(src);
+            ImageResize(&out, int(w) * k, int(h) * k);
+            bool drew = false;
+            for (const IconSpot &spot : spots)
+            {
+                const ::Image *art = icon(spot.button);
+                if (!art)
+                    continue;
+                // Cover the PS2 icon with the colour around it, then draw ours.
+                uint64_t sum[4] = {};
+                int n = 0;
+                for (int y = spot.y - 1; y <= spot.y + spot.h; ++y)
+                    for (int x = spot.x - 1; x <= spot.x + spot.w; ++x)
+                    {
+                        const bool border = y == spot.y - 1 || y == spot.y + spot.h || x == spot.x - 1 || x == spot.x + spot.w;
+                        if (!border || x < 0 || y < 0 || x >= int(w) || y >= int(h))
+                            continue;
+                        const uint32_t c = base[size_t(y) * w + size_t(x)];
+                        for (int i = 0; i < 4; ++i)
+                            sum[i] += (c >> (8 * i)) & 255u;
+                        ++n;
+                    }
+                const Color fill = n ? Color{uint8_t(sum[0] / n), uint8_t(sum[1] / n), uint8_t(sum[2] / n), uint8_t(sum[3] / n)}
+                                     : Color{0, 0, 0, 0};
