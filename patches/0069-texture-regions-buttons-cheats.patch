diff --git a/ps2xRuntime/include/runtime/ga2_cheats.h b/ps2xRuntime/include/runtime/ga2_cheats.h
new file mode 100644
index 0000000..427336d
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ga2_cheats.h
@@ -0,0 +1,41 @@
+// Cheat switches shared by the in-game cheat menu (main thread,
+// ga2_cheat_menu.cpp) and the per-disc game hooks that act on them (EE
+// thread, native/compat/ga2_cheats.cpp; docs/cheats/battle.md).
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstring>
+
+namespace ga2_cheats
+{
+    struct State
+    {
+        // Set by the hooks' binding: this disc has battle cheats, and where
+        // the battle manager pointer and its state field are.
+        std::atomic<bool> available{false};
+        std::atomic<uint32_t> managerGlobal{0}, stateOffset{0};
+
+        // One-shot: the running battle ends now as a win with the best result
+        // the battle gives (no damage taken, full time bonus).
+        std::atomic<bool> skipRequested{false};
+        // Toggles.
+        std::atomic<bool> invincible{false}, infiniteEnergy{false}, oneHitKill{false}, stopTimer{false};
+    };
+
+    State &state();
+
+    // A battle is being fought (the manager exists and is in its battle state).
+    inline bool battleActive(const uint8_t *rdram)
+    {
+        State &s = state();
+        if (!rdram || !s.available.load())
+            return false;
+        uint32_t manager = 0, phase = 0;
+        std::memcpy(&manager, rdram + (s.managerGlobal.load() & 0x1FFFFFFu), 4);
+        if (!manager || (manager & 0x1FFFFFFu) + s.stateOffset.load() + 4u > 0x2000000u)
+            return false;
+        std::memcpy(&phase, rdram + ((manager + s.stateOffset.load()) & 0x1FFFFFFu), 4);
+        return phase == 2u;
+    }
+}
