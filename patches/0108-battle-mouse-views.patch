+    bool pointerAnywhere(float &x, float &y);
     // Left button went down this frame over the game image (not on the pad).
     bool clickedGame();
 
@@ -36,4 +39,66 @@ namespace ps2_mouse
     void setFrame(const uint8_t *rgba, uint32_t width, uint32_t height);
     // Its pixel at PS2 frame coordinates (640x448 scale); false without one.
     bool pixel(int x, int y, uint8_t rgb[3]);
+
+    // ---- battle views ----------------------------------------------------
+    // While a battle view runs (the game side, native/compat/ga2_battlepointer
+    // .cpp, calls setBattleState every frame; it lapses a moment after the
+    // last call) the mouse buttons mean what the view needs instead of the
+    // generic Circle / Cross / Select / wheel-as-D-pad:
+    //   map:      left = Circle, Ctrl+left = order all angels (Square, then
+    //             Circle), a quick second click on a unit = focus on it, right
+    //             click = Cross, right drag = pan (BattleEvents), middle click
+    //             on a unit = its H-Weapon (Triangle), middle button held on
+    //             empty map = L2 (the game's angel list opens; the wheel moves
+    //             its cursor; releasing jumps the camera to that angel),
+    //             Ctrl+middle = Start (pause; while paused the generic mapping
+    //             gives the middle button Select, the system menu), the back
+    //             button = L3 (cockpit view), Ctrl+right or the forward button =
+    //             R3 (unit camera), wheel = zoom (BattleEvents), the picture's
+    //             edge scrolls with the game's D-pad;
+    //   cockpit:  left held = fire, right held = charged shot, middle = L3
+    //             (leave), Ctrl+middle = Start, back / forward = L1 / R1 (boost);
+    //   rear (chase) view: left = Circle, right = Cross, middle or the back
+    //             button = L3 (the aiming cockpit view), Ctrl+middle = Start;
+    //   unit camera: dragging with either button turns the camera, a click
+    //             without drag: left = Circle, right = R3 (leave); middle =
+    //             Start; wheel zooms.
+    enum class BattleView : uint8_t
+    {
+        None,
+        Map,
+        Cockpit,
+        UnitCamera,
+        Rear
+    };
+    // PS2 pad bits (the game's own current mapping, 0 = unknown: the default
+    // layout is used) of the logical buttons the views use.
+    struct BattleButtons
+    {
+        uint16_t circle = 0, cross = 0, square = 0, triangle = 0, start = 0, l3 = 0, r3 = 0, l2 = 0;
+        uint16_t fire = 0, charge = 0, l1 = 0, r1 = 0;
+        uint16_t up = 0, down = 0, left = 0, right = 0;
+    };
+    struct BattleState
+    {
+        BattleView view = BattleView::None;
+        BattleButtons buttons;
+        bool pointerOnUnit = false; // map: the pointer is on a unit icon
+        bool modal = false;         // a menu or pause is up: generic pointer behaviour
+        bool edgeScroll = true;     // map: the picture's edge pans
+    };
+    void setBattleState(const BattleState &state);
+    struct BattleEvents
+    {
+        bool dragging = false;     // right (map) or left/right (unit camera) button dragging now
+        int wheel = 0;             // notches since the last call, + = away from the user (zoom in)
+        bool doubleClick = false;  // a quick second left click on the unit the first one was on (its Circle was not sent)
+        bool listHeld = false;     // the middle button is held on empty map: L2 is down (the angel list is open)
+    };
+    // Called by the game side once per frame; clears the counters.
+    BattleEvents takeBattleEvents();
+    // A press (3 frames and more, then a gap) of the given pad bits, queued.
+    void battlePulse(uint16_t bits);
+    // Presses still waiting or in progress.
+    int battlePulsesPending();
 }
