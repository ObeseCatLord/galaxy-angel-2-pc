From 3fb97df2e70b4abdb8be1ff2c876985d7f8bad59 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Wed, 11 Nov 2026 15:25:24 -0600
Subject: [PATCH] VIF1: specialised UNPACK for unmasked transfers with CL >= WL

One instantiation per format (no per-vector division, format switch or
per-field mask branches). Results match the general loop, which still
handles write masks, CL < WL and the undefined VL 3 formats. Zettai ship
map at 1x, 60 fps: game thread 56% -> 54%; frames identical.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp | 91 +++++++++++++++++++-
 1 file changed, 90 insertions(+), 1 deletion(-)

diff --git a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
index e5fa00a..9636eee 100644
--- a/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
+++ b/ps2xRuntime/src/lib/ps2_vif1_interpreter.cpp
@@ -92,6 +92,90 @@ namespace
         }
         return 0u;
     }
+
+    // UNPACK without a write mask and with CL >= WL (every write cycle reads a
+    // source vector), one format per instantiation. Same results as the
+    // general loop in processVIF1Data: fields a format does not decode keep
+    // VU memory's value, and modes 1 and 2 add the row to all four fields.
+    template <uint32_t VN, uint32_t VL>
+    void unpackVif1Unmasked(const uint8_t *src, uint8_t *vu, uint32_t vuAddr, uint32_t cl, uint32_t wl, uint32_t count,
+                            bool zeroExtend, uint32_t mode, uint32_t *row)
+    {
+        constexpr bool kV45 = VL == 3u && VN == 3u;
+        constexpr uint32_t kComponents = VN + 1u;
+        constexpr uint32_t kBytes = kV45 ? 2u : kComponents * (VL == 0u ? 4u : VL == 1u ? 2u : 1u);
+        const bool add = !kV45 && (mode == 1u || mode == 2u);
+        uint32_t block = 0u;
+        uint32_t cycle = 0u;
+        for (uint32_t i = 0u; i < count; ++i, src += kBytes)
+        {
+            uint8_t *dst = vu + ((vuAddr + block + cycle) & 0x3FFu) * 16u;
+            uint32_t v[4];
+            std::memcpy(v, dst, sizeof(v));
+            if constexpr (kV45)
+            {
+                uint16_t packed;
+                std::memcpy(&packed, src, sizeof(packed));
+                v[0] = packed & 0x1Fu;
+                v[1] = (packed >> 5) & 0x1Fu;
+                v[2] = (packed >> 10) & 0x1Fu;
+                v[3] = (packed >> 15) & 0x01u;
+            }
+            else
+            {
+                uint32_t in[kComponents];
+                for (uint32_t c = 0u; c < kComponents; ++c)
+                {
+                    if constexpr (VL == 0u)
+                        std::memcpy(&in[c], src + c * 4u, 4u);
+                    else if constexpr (VL == 1u)
+                    {
+                        uint16_t raw;
+                        std::memcpy(&raw, src + c * 2u, 2u);
+                        in[c] = zeroExtend ? raw : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(raw)));
+                    }
+                    else
+                        in[c] = zeroExtend ? src[c] : static_cast<uint32_t>(static_cast<int32_t>(static_cast<int8_t>(src[c])));
+                }
+                if constexpr (kComponents == 1u)
+                    v[0] = v[1] = v[2] = v[3] = in[0];
+                else
+                    for (uint32_t c = 0u; c < kComponents; ++c)
+                        v[c] = in[c];
+            }
+            if (add)
+                for (uint32_t f = 0u; f < 4u; ++f)
+                {
+                    v[f] += row[f];
+                    if (mode == 2u)
+                        row[f] = v[f];
+                }
+            std::memcpy(dst, v, sizeof(v));
+            if (++cycle == wl)
+            {
+                cycle = 0u;
+                block += cl;
+            }
+        }
+    }
+
+    // False for the formats it does not cover (V2-5, V3-5, V1-5: VL 3 below V4).
+    bool unpackVif1Fast(uint32_t format, const uint8_t *src, uint8_t *vu, uint32_t vuAddr, uint32_t cl, uint32_t wl, uint32_t count,
+                        bool zeroExtend, uint32_t mode, uint32_t *row)
+    {
+        switch (format)
+        {
+#define GA2_UNPACK_CASE(VN, VL) \
+    case (VN << 2) | VL: unpackVif1Unmasked<VN, VL>(src, vu, vuAddr, cl, wl, count, zeroExtend, mode, row); return true;
+            GA2_UNPACK_CASE(0u, 0u) GA2_UNPACK_CASE(0u, 1u) GA2_UNPACK_CASE(0u, 2u)
+            GA2_UNPACK_CASE(1u, 0u) GA2_UNPACK_CASE(1u, 1u) GA2_UNPACK_CASE(1u, 2u)
+            GA2_UNPACK_CASE(2u, 0u) GA2_UNPACK_CASE(2u, 1u) GA2_UNPACK_CASE(2u, 2u)
+            GA2_UNPACK_CASE(3u, 0u) GA2_UNPACK_CASE(3u, 1u) GA2_UNPACK_CASE(3u, 2u) GA2_UNPACK_CASE(3u, 3u)
+#undef GA2_UNPACK_CASE
+        default:
+            return false;
+        }
+    }
 }
 
 void ps2Vif1ResetPath2Decoder(const PS2Memory *memory)
@@ -664,7 +748,12 @@ void PS2Memory::processVIF1Data(const uint8_t *data, uint32_t sizeBytes)
 
             const bool zeroExtend = (imm & 0x4000u) != 0u;
 
-            if (m_vu1Data && totalBytes > 0 && pos + totalBytes <= sizeBytes)
+            if (m_vu1Data && totalBytes > 0 && pos + totalBytes <= sizeBytes && !maskEnable && cl >= wl &&
+                unpackVif1Fast(opcode & 0xFu, data + pos, m_vu1Data, vuAddr, cl, wl, writeVectorCount, zeroExtend,
+                               vif1_regs.mode & 3u, vif1_regs.row))
+            {
+            }
+            else if (m_vu1Data && totalBytes > 0 && pos + totalBytes <= sizeBytes)
             {
                 const uint8_t *srcBase = data + pos;
                 uint32_t srcIndex = 0u;
