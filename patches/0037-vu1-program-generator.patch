+        {
+            uint32_t target = (m_state.pc + 8 + imm * 8) & pcMask;
+            m_state.branchPending = true;
+            m_state.branchTarget = target;
+            m_state.branchDelay = 1;
+        }
+        return;
+    }
+    case 0x2F: // IBGEZ
+    {
+        uint8_t is = VIS(instr);
+        int16_t imm = IMM11(instr);
+        if ((int16_t)readBranchVi(is) >= 0)
+        {
+            uint32_t target = (m_state.pc + 8 + imm * 8) & pcMask;
+            m_state.branchPending = true;
+            m_state.branchTarget = target;
+            m_state.branchDelay = 1;
+        }
