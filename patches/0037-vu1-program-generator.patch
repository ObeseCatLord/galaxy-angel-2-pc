+// Reader and replay helpers for GA2_VU1CAP captures (format in
+// ps2xRuntime/src/lib/vu/ps2_vu1_capture.cpp). Shared by ga2_vu1_replay and
+// ga2_vu1_gen.
+#pragma once
+#include "runtime/gs/gs_frontend.h"
+#include "runtime/ps2_memory.h"
+#include "runtime/ps2_vu1.h"
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <memory>
+#include <algorithm>
+#include <unordered_map>
+#include <vector>
+
+namespace ga2_vu1cap
+{
+    struct Run
+    {
+        uint32_t kind, startPC, top, itop, maxCycles;
+        uint64_t cycleBefore, codeHash;
+        VU1State state;
+        std::vector<uint8_t> data;
+        uint64_t stateDigest, dataDigest, gifDigest, gifBytes, cycleAfter;
+        uint32_t ended;
+    };
+
+    struct Capture
+    {
+        std::unordered_map<uint64_t, std::vector<uint8_t>> codes;
+        std::vector<Run> runs;
+    };
+
+    // Accepts a capture, or a raw code image (then it only adds that image).
+    inline bool load(const char *path, Capture &cap)
+    {
+        std::ifstream in(path, std::ios::binary);
+        if (!in)
+            return false;
+        const std::vector<uint8_t> buf((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+        size_t pos = 0;
+        bool ok = true;
+        auto bytes = [&](void *dst, size_t n) {
+            if (pos + n > buf.size()) { ok = false; return; }
+            std::memcpy(dst, buf.data() + pos, n);
+            pos += n;
+        };
+        auto u32 = [&] { uint32_t v = 0; bytes(&v, 4); return v; };
+        auto u64 = [&] { uint64_t v = 0; bytes(&v, 8); return v; };
+        uint32_t first = 0;
+        if (buf.size() >= 4)
+            std::memcpy(&first, buf.data(), 4);
+        if (first != 0x43314356u && first != 0x52315256u)
+        {
+            cap.codes[VU1Interpreter::digestBytes(buf.data(), buf.size())] = buf;
+            return true;
+        }
+        while (ok && pos < buf.size())
+        {
+            const uint32_t magic = u32();
+            if (magic == 0x43314356u)
+            {
+                const uint64_t hash = u64();
+                std::vector<uint8_t> code(u32());
+                bytes(code.data(), code.size());
+                if (ok)
+                    cap.codes[hash] = std::move(code);
+            }
+            else if (magic == 0x52315256u)
+            {
+                Run run{};
+                run.kind = u32();
+                run.startPC = u32();
+                run.top = u32();
+                run.itop = u32();
+                run.maxCycles = u32();
+                run.cycleBefore = u64();
+                run.codeHash = u64();
+                (void)u32();
+                if (u32() != sizeof(VU1State))
+                {
+                    std::fprintf(stderr, "%s: VU1State layout differs from the capture\n", path);
+                    return false;
+                }
+                bytes(&run.state, sizeof(VU1State));
+                run.data.resize(u32());
+                bytes(run.data.data(), run.data.size());
+                run.stateDigest = u64();
+                run.dataDigest = u64();
+                run.gifDigest = u64();
+                run.gifBytes = u64();
+                run.cycleAfter = u64();
+                run.ended = u32();
+                if (ok)
+                    cap.runs.push_back(std::move(run));
+            }
+            else
+                break; // truncated tail of a capture still being written
+        }
+        return true;
+    }
+
+    struct GifHash
+    {
+        uint64_t digest = 1469598103934665603ull;
+        uint64_t bytes = 0;
+        static void sink(void *user, const uint8_t *data, uint32_t size)
+        {
+            auto *g = static_cast<GifHash *>(user);
+            g->digest = VU1Interpreter::digestBytes(data, size, g->digest);
+            g->bytes += size;
+        }
+    };
+
+    // Replays runs through one interpreter, loading code through the bus so
+    // code generations advance as they do for a VIF MPG.
+    class Replayer
+    {
+    public:
+        Replayer()
+        {
+            m_memory = std::make_unique<PS2Memory>();
+            m_memory->initialize();
+            m_gs = std::make_unique<GS>();
+            m_vu = std::make_unique<VU1Interpreter>(VU1Interpreter::Unit::VU1);
+            m_vu->setGifSink(&GifHash::sink, &m_gif);
+        }
+
+        VU1Interpreter &vu() { return *m_vu; }
+        PS2Memory &memory() { return *m_memory; }
+        const GifHash &gif() const { return m_gif; }
+
+        void run(const Capture &cap, const Run &run)
+        {
+            const std::vector<uint8_t> &code = cap.codes.at(run.codeHash);
+            if (!m_haveCode || m_loadedCode != run.codeHash)
+            {
+                for (uint32_t off = 0; off < code.size(); off += 4u)
+                {
+                    uint32_t word;
+                    std::memcpy(&word, code.data() + off, 4);
+                    m_memory->write32(0x11008000u + off, word);
+                }
+                m_loadedCode = run.codeHash;
+                m_haveCode = true;
+            }
+            std::memcpy(m_memory->getVU1Data(), run.data.data(), run.data.size());
+            m_gif = GifHash{};
+            m_vu->restoreForReplay(run.state, run.cycleBefore);
+            const auto codeSize = static_cast<uint32_t>(code.size());
+            const auto dataSize = static_cast<uint32_t>(run.data.size());
+            if (run.kind == 0u)
+                m_vu->execute(m_memory->getVU1Code(), codeSize, m_memory->getVU1Data(), dataSize, *m_gs,
+                              m_memory.get(), run.startPC, run.top, run.itop, run.maxCycles);
+            else
+                m_vu->resume(m_memory->getVU1Code(), codeSize, m_memory->getVU1Data(), dataSize, *m_gs,
+                             m_memory.get(), run.top, run.itop, run.maxCycles);
+        }
+
+        bool matches(const Run &run) const
+        {
+            return VU1Interpreter::digestState(m_vu->state()) == run.stateDigest &&
+                   VU1Interpreter::digestBytes(m_memory->getVU1Data(), run.data.size()) == run.dataDigest &&
+                   m_gif.digest == run.gifDigest && m_gif.bytes == run.gifBytes &&
+                   m_vu->cycle() == run.cycleAfter;
+        }
+
+    private:
+        std::unique_ptr<PS2Memory> m_memory;
+        std::unique_ptr<GS> m_gs;
+        std::unique_ptr<VU1Interpreter> m_vu;
+        GifHash m_gif;
+        uint64_t m_loadedCode = 0;
+        bool m_haveCode = false;
+    };
+}
diff --git a/ps2xTest/src/ga2_vu1_gen.cpp b/ps2xTest/src/ga2_vu1_gen.cpp
new file mode 100644
index 0000000..acc0bc2
--- /dev/null
+++ b/ps2xTest/src/ga2_vu1_gen.cpp
@@ -0,0 +1,178 @@
+// Generates C++ VU1 programs from VU1 code images.
+//
+//   ga2_vu1_gen <outdir> <capture-or-code.bin>...
+//
+// Inputs are GA2_VU1CAP captures or raw 16 KB code dumps (GA2_VU1_DUMP). For
+// each distinct image the tool writes vu1_<hash>_*.cpp: constexpr decoded
+// pairs (decoded by the interpreter's own decoder) driving the shared
+// VU1Interpreter::stepPair, which the compiler then specialises per pair.
+// Pairs that the captured runs execute are compiled (all pairs for a raw
+// image without runs); anything else falls back to the interpreter's step.
+// The program registers itself under the image hash.
+#include "ga2_vu1_capture.h"
+
+#include <string>
+
+namespace
+{
+    using VU = VU1Interpreter;
+    constexpr uint32_t kChunkPairs = 48;
+
+    std::string usage(const VU::InstructionUsage &u)
+    {
+        char buf[512];
+        std::snprintf(buf, sizeof(buf),
+                      "{.vfRead={{{%u,%u},{%u,%u}}},.vfWrite={%u,%u},.vfReadCount=%u,.viRead=%u,.viWrite=%u,"
+                      ".accRead=%u,.accWrite=%u,.latency=%u,.vfLatency=%u,.viLatency=%u,"
+                      ".pipeline=static_cast<VU::Pipeline>(%u),.waitQ=%d,.waitP=%d,.readsClip=%d,.writesClip=%d,"
+                      ".delaysNextBranchRead=%d,.reserved=%d}",
+                      u.vfRead[0].reg, u.vfRead[0].lanes, u.vfRead[1].reg, u.vfRead[1].lanes,
+                      u.vfWrite.reg, u.vfWrite.lanes, u.vfReadCount, u.viRead, u.viWrite,
+                      u.accRead, u.accWrite, u.latency, u.vfLatency, u.viLatency,
+                      static_cast<unsigned>(u.pipeline), u.waitQ, u.waitP, u.readsClip, u.writesClip,
+                      u.delaysNextBranchRead, u.reserved);
+        return buf;
+    }
+
+    std::string pair(const VU::DecodedInstructionPair &p)
+    {
+        char head[96];
+        std::snprintf(head, sizeof(head), "{.lower=0x%08Xu,.upper=0x%08Xu,", p.lower, p.upper);
+        char tail[160];
+        std::snprintf(tail, sizeof(tail), ",.iBit=%d,.eBit=%d,.mBit=%d,.dBit=%d,.tBit=%d,.upperVfShadowReg=%u,.suppressedLowerVf=%u}",
+                      p.iBit, p.eBit, p.mBit, p.dBit, p.tBit, p.upperVfShadowReg, p.suppressedLowerVf);
+        return std::string(head) + ".lowerUsage=" + usage(p.lowerUsage) + ",.upperUsage=" + usage(p.upperUsage) + tail;
+    }
+
+    std::string header()
+    {
+        return "// Generated by ga2_vu1_gen from a VU1 code image. Do not edit.\n"
+               "#include \"runtime/ps2_vu1_step.inl\"\n\nusing VU = VU1Interpreter;\n"
+               "static_assert(sizeof(VU::DecodedInstructionPair) == " +
+               std::to_string(sizeof(VU::DecodedInstructionPair)) + ", \"regenerate: DecodedInstructionPair layout changed\");\n";
+    }
+
+    bool write(const std::string &path, const std::string &text)
+    {
+        std::ofstream f(path, std::ios::binary | std::ios::trunc);
+        f << text;
+        return static_cast<bool>(f);
+    }
+
+    bool emit(const std::string &outdir, uint64_t hash, const std::vector<uint8_t> &code,
+              const std::vector<uint64_t> &hits)
+    {
+        char base[64];
+        std::snprintf(base, sizeof(base), "vu1_%016llx", static_cast<unsigned long long>(hash));
+        const uint32_t pairs = static_cast<uint32_t>(code.size() / 8u);
+        std::vector<uint32_t> selected;
+        for (uint32_t i = 0; i < pairs; ++i)
+            if (hits.empty() || hits[i] != 0u)
+                selected.push_back(i);
+
+        // Chunks of consecutive selected pairs; each chunk runs its own loop
+        // while execution stays inside it.
+        std::vector<std::vector<uint32_t>> chunks;
+        for (uint32_t index : selected)
+        {
+            if (chunks.empty() || chunks.back().size() >= kChunkPairs)
+                chunks.emplace_back();
+            chunks.back().push_back(index);
+        }
+
+        std::string dispatch = header() + "\n";
+        for (size_t c = 0; c < chunks.size(); ++c)
+            dispatch += "VU::StepResult " + std::string(base) + "_chunk" + std::to_string(c) + "(VU &vu, const VU::StepArgs &a);\n";
+        std::vector<int> chunkOf(pairs, -1);
+        for (size_t c = 0; c < chunks.size(); ++c)
+            for (uint32_t index : chunks[c])
+                chunkOf[index] = static_cast<int>(c);
+        dispatch += "\nnamespace\n{\nusing Chunk = VU::StepResult (*)(VU &, const VU::StepArgs &);\nconstexpr Chunk kChunks[" +
+                    std::to_string(pairs) + "] = {\n";
+        for (uint32_t i = 0; i < pairs; ++i)
+            dispatch += chunkOf[i] < 0 ? "    nullptr,\n" : "    " + std::string(base) + "_chunk" + std::to_string(chunkOf[i]) + ",\n";
+        dispatch += "};\n\n"
+                    "// A chunk is entered with the loop head already done for its pc and\n"
+                    "// returns Continue with the loop head done for a pc outside itself.\n"
+                    "VU::StepResult run(VU &vu, const VU::StepArgs &a)\n{\n"
+                    "    if (!vu.stepLoopHead(a))\n        return VU::StepResult::Stop;\n"
+                    "    for (;;)\n    {\n"
+                    "        const uint32_t pc = vu.state().pc;\n"
+                    "        const Chunk chunk = (pc & 7u) == 0u ? kChunks[(pc >> 3) & " + std::to_string(pairs - 1) + "u] : nullptr;\n"
+                    "        const VU::StepResult r = chunk ? chunk(vu, a) : vu.stepGeneric(a);\n"
+                    "        if (r != VU::StepResult::Continue)\n            return r;\n"
+                    "        if (!chunk && !vu.stepLoopHead(a))\n            return VU::StepResult::Stop;\n"
+                    "    }\n}\n\n";
+        char reg[160];
+        std::snprintf(reg, sizeof(reg), "struct Register\n{\n    Register() { VU::registerJitProgram(0x%016llxull, run); }\n} registerProgram;\n}\n",
+                      static_cast<unsigned long long>(hash));
+        dispatch += reg;
+        if (!write(outdir + "/" + base + ".cpp", dispatch))
+            return false;
+
+        for (size_t c = 0; c < chunks.size(); ++c)
+        {
+            std::string out = header() + "\nnamespace\n{\n";
+            for (uint32_t index : chunks[c])
+                out += "constexpr VU::DecodedInstructionPair kP" + std::to_string(index) + " = " +
+                       pair(VU::decodeForCodegen(code.data(), index * 8u)) + ";\n";
+            out += "}\n\nVU::StepResult " + std::string(base) + "_chunk" + std::to_string(c) +
+                   "(VU &vu, const VU::StepArgs &a)\n{\n    for (;;)\n    {\n        VU::StepResult r;\n"
+                   "        const uint32_t pc = vu.state().pc;\n"
+                   "        if ((pc & 7u) != 0u)\n            return VU::StepResult::Continue;\n"
+                   "        switch (pc >> 3)\n        {\n";
+            for (uint32_t index : chunks[c])
+                out += "        case " + std::to_string(index) + ": r = vu.stepPair(kP" + std::to_string(index) + ", a); break;\n";
+            out += "        default: return VU::StepResult::Continue;\n        }\n"
+                   "        if (r != VU::StepResult::Continue)\n            return r;\n"
+                   "        if (!vu.stepLoopHead(a))\n            return VU::StepResult::Stop;\n    }\n}\n";
+            if (!write(outdir + "/" + base + "_" + std::to_string(c) + ".cpp", out))
+                return false;
+        }
+        std::printf("%s: %zu of %u pairs in %zu chunks\n", base, selected.size(), pairs, chunks.size());
+        return true;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc < 3)
+    {
+        std::fprintf(stderr, "usage: %s <outdir> <capture-or-code.bin>...\n", argv[0]);
+        return 2;
+    }
+    ga2_vu1cap::Capture cap;
+    for (int i = 2; i < argc; ++i)
+        if (!ga2_vu1cap::load(argv[i], cap))
+        {
+            std::perror(argv[i]);
+            return 2;
+        }
+
+    // Coverage: replay every captured run through the interpreter.
+    std::unordered_map<uint64_t, std::vector<uint64_t>> hits;
+    {
+        ga2_vu1cap::Replayer replayer;
+        std::vector<uint64_t> counts(2048, 0);
+        replayer.vu().setPcHitCounter(counts.data());
+        for (const auto &run : cap.runs)
+        {
+            std::fill(counts.begin(), counts.end(), 0);
+            replayer.run(cap, run);
+            auto &h = hits[run.codeHash];
+            h.resize(2048, 0);
+            for (size_t i = 0; i < counts.size(); ++i)
+                h[i] += counts[i];
+        }
+    }
+    for (const auto &[hash, code] : cap.codes)
+    {
+        const auto it = hits.find(hash);
+        std::vector<uint64_t> h = it != hits.end() ? it->second : std::vector<uint64_t>{};
+        if (!h.empty())
+            h.resize(code.size() / 8u);
+        if (!emit(argv[1], hash, code, h))
+            return 1;
+    }
+    return 0;
+}
