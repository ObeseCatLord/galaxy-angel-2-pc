+// ---------------------------------------------------------------------------
+// Generated VU1 programs (tools: ps2xTest/ga2_vu1_gen). A program is selected
+// by a hash of the whole code image, so its constant decoded pairs are exactly
+// what the interpreter would decode. GA2_VU1JIT=0 forces the interpreter;
+// GA2_VU1_DUMP=<dir> writes code images that have no generated program.
+namespace
+{
+    std::unordered_map<uint64_t, VU1Interpreter::JitProgram> &jitRegistry()
+    {
+        static std::unordered_map<uint64_t, VU1Interpreter::JitProgram> registry;
+        return registry;
+    }
+}
+
+void VU1Interpreter::registerJitProgram(uint64_t codeHash, JitProgram program)
+{
+    jitRegistry()[codeHash] = program;
+}
+
+VU1Interpreter::DecodedInstructionPair VU1Interpreter::decodeForCodegen(const uint8_t *vuCode, uint32_t pc)
+{
+    static const VU1Interpreter decoder(Unit::VU1);
+    return decoder.decodeInstructionPair(vuCode, pc);
+}
+
+VU1Interpreter::StepResult VU1Interpreter::stepGeneric(const StepArgs &args)
+{
+    return stepPair(getDecodedInstructionPairForPc(args.vuCode, args.codeSize, args.memory, m_state.pc), args);
+}
+
+VU1Interpreter::JitProgram VU1Interpreter::lookupJitProgram(const uint8_t *vuCode, uint32_t codeSize, PS2Memory *memory)
+{
+    static const bool disabled = [] {
+        const char *v = std::getenv("GA2_VU1JIT");
+        return v && std::strcmp(v, "0") == 0;
+    }();
+    if (disabled || m_unit != Unit::VU1 || !memory || vuCode != memory->getVU1Code())
+        return nullptr;
+    const uint64_t generation = memory->getVU1CodeGeneration();
+    if (m_jitMemory == memory && m_jitGeneration == generation)
+        return m_jitProgram;
+    m_jitMemory = memory;
+    m_jitGeneration = generation;
+    const uint64_t hash = digestBytes(vuCode, codeSize);
+    const auto &registry = jitRegistry();
+    const auto it = registry.find(hash);
+    m_jitProgram = it != registry.end() ? it->second : nullptr;
+
+    static std::unordered_map<uint64_t, bool> reported;
+    if (!m_jitProgram && !registry.empty() && !reported[hash])
+    {
+        reported[hash] = true;
+        std::fprintf(stderr, "[vu1jit] no generated program for code image %016llx; interpreting\n",
+                     static_cast<unsigned long long>(hash));
+        if (const char *dir = std::getenv("GA2_VU1_DUMP"); dir && *dir)
+        {
+            char name[64];
+            std::snprintf(name, sizeof(name), "/%016llx.bin", static_cast<unsigned long long>(hash));
+            if (std::FILE *f = std::fopen((std::string(dir) + name).c_str(), "wb"))
+            {
+                std::fwrite(vuCode, 1, codeSize, f);
+                std::fclose(f);
+            }
+        }
+    }
+    return m_jitProgram;
+}
