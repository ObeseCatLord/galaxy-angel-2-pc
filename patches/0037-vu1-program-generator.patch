+        return;
+    }
+    case 0x16: // FSAND
+    {
+        const uint8_t it = VIT(instr);
+        const uint16_t imm12 = static_cast<uint16_t>((((instr >> 21) & 0x1u) << 11) | (instr & 0x7FFu));
+        if (it != 0)
