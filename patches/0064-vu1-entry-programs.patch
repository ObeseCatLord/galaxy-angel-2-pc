     m_jitProgram = it != registry.end() ? it->second.program : nullptr;
     // Flag elision assumes a program's flags are only read by its own image.
@@ -1110,22 +1246,28 @@ VU1Interpreter::JitProgram VU1Interpreter::lookupJitProgram(const uint8_t *vuCod
     m_jitHash = hash;
     m_jitElidesFlags = it != registry.end() && it->second.elidesFlags;
 
-    static std::unordered_map<uint64_t, bool> reported;
-    if (!m_jitProgram && !registry.empty() && !reported[hash])
+    if (!m_jitProgram && !jitEntryRegistry().empty())
     {
-        reported[hash] = true;
-        std::fprintf(stderr, "[vu1jit] no generated program for code image %016llx; interpreting\n",
-                     static_cast<unsigned long long>(hash));
-        if (const char *dir = std::getenv("GA2_VU1_DUMP"); dir && *dir)
+        if (!m_jitEntryCache)
+            m_jitEntryCache = std::make_shared<JitEntryCache>();
+        auto &tables = m_jitEntryCache->tables;
+        if (tables.size() >= 256u)
+            tables.clear();
+        std::unique_ptr<JitEntryTable> &table = tables[hash];
+        if (!table)
         {
-            char name[64];
-            std::snprintf(name, sizeof(name), "/%016llx.bin", static_cast<unsigned long long>(hash));
-            if (std::FILE *f = std::fopen((std::string(dir) + name).c_str(), "wb"))
-            {
-                std::fwrite(vuCode, 1, codeSize, f);
-                std::fclose(f);
-            }
+            table = std::make_unique<JitEntryTable>();
+            table->chunks.assign(codeSize / 8u, nullptr);
+            table->tried.assign(codeSize / 8u, 0u);
+            table->readsStatus = ps2_vu1_reach::readsStatus(vuCode, codeSize / 8u);
         }
+        m_jitEntryTable = table.get();
+        m_jitElidesFlags = table->elidesFlags;
+        m_jitProgram = &VU1Interpreter::runJitEntries;
+        return m_jitProgram;
     }
+
+    if (!m_jitProgram && !registry.empty())
+        reportJitMiss(vuCode, codeSize, hash, -1);
     return m_jitProgram;
 }
