new file mode 100644
index 0000000..05eda0b
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_vu1_reach.h
@@ -0,0 +1,118 @@
+// The pairs a VU1 microprogram can reach from its entry point, and a key for
+// them. Games upload microprograms into code memory in changing combinations
+// (with stale code between them), so whole-image hashes keep missing; a
+// program keyed by its entry pair and the contents of the pairs it reaches is
+// found again in any image that holds the same code at the same place.
+// Shared by the runtime (lookup) and ga2_vu1_gen (generation), which must
+// agree exactly.
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace ps2_vu1_reach
+{
+    inline uint32_t word(const uint8_t *code, uint32_t index, uint32_t half)
+    {
+        uint32_t w = 0;
+        std::memcpy(&w, code + index * 8u + half * 4u, 4);
+        return w;
+    }
+
+    // Lower-instruction branch kinds (I bit clear); 0x2A/0x2B are not branches.
+    inline bool isDirectBranch(uint32_t op)
+    {
+        return op == 0x20u || op == 0x21u || (op >= 0x28u && op <= 0x2Fu && op != 0x2Au && op != 0x2Bu);
+    }
+    inline bool isIndirectJump(uint32_t op) { return op == 0x24u || op == 0x25u; }
+
+    struct Program
+    {
+        std::vector<uint32_t> pairs; // ascending pair indices
+        uint64_t key = 0;
+    };
+
+    // Control flow by pairs, as in ga2_vu1_gen's flag analysis: a branch or
+    // jump acts after its delay slot and an E bit ends the program after the
+    // pair that follows it. BAL/JALR also continue after their delay slot
+    // (where a JR returns); JR targets are unknown and not followed (the
+    // runtime tries them as entries of their own). A run starting at the
+    // entry has nothing pending, so the entry also continues to the next pair.
+    inline Program reach(const uint8_t *code, uint32_t pairCount, uint32_t entry)
+    {
+        Program p;
+        if (pairCount == 0u || entry >= pairCount)
+            return p;
+        std::vector<uint8_t> seen(pairCount, 0u);
+        std::vector<uint32_t> work{entry};
+        while (!work.empty())
+        {
+            const uint32_t i = work.back();
+            work.pop_back();
+            if (i >= pairCount || seen[i])
+                continue;
+            seen[i] = 1u;
+            if (i == entry)
+                work.push_back(i + 1u);
+            if (i == 0u)
+            {
+                work.push_back(1u);
+                continue;
+            }
+            const uint32_t prevLower = word(code, i - 1u, 0), prevUpper = word(code, i - 1u, 1);
+            if ((prevUpper >> 30) & 1u) // i is the E bit's delay slot: the program ends after it
+                continue;
+            const uint32_t op = prevLower >> 25;
+            if ((prevUpper >> 31) == 0u && isDirectBranch(op))
+            {
+                int32_t imm = static_cast<int32_t>(prevLower & 0x7FFu);
+                if (imm & 0x400) imm -= 0x800;
+                work.push_back(static_cast<uint32_t>((static_cast<int64_t>(i) + imm + pairCount) % pairCount));
+                if (op != 0x20u) // conditional falls through; BAL returns here
+                    work.push_back(i + 1u);
+                continue;
+            }
+            if ((prevUpper >> 31) == 0u && isIndirectJump(op))
+            {
+                if (op == 0x25u) // JALR returns here
+                    work.push_back(i + 1u);
+                continue;
+            }
+            work.push_back(i + 1u);
+        }
+        // FNV-1a over the image size, the entry and each reached pair.
+        uint64_t h = 1469598103934665603ull;
+        auto mix = [&h](uint32_t v) {
+            for (int b = 0; b < 4; ++b)
+            {
+                h ^= (v >> (8 * b)) & 0xFFu;
+                h *= 1099511628211ull;
+            }
+        };
+        mix(pairCount);
+        mix(entry);
+        for (uint32_t i = 0; i < pairCount; ++i)
+            if (seen[i])
+            {
+                p.pairs.push_back(i);
+                mix(i);
+                mix(word(code, i, 0));
+                mix(word(code, i, 1));
+            }
+        p.key = h;
+        return p;
+    }
+
+    // Any FSAND/FSEQ/FSOR in the image: status flag results are observable.
+    inline bool readsStatus(const uint8_t *code, uint32_t pairCount)
+    {
+        for (uint32_t i = 0; i < pairCount; ++i)
+        {
+            const uint32_t op = word(code, i, 0) >> 25;
+            if ((word(code, i, 1) >> 31) == 0u && (op == 0x14u || op == 0x16u || op == 0x17u))
+                return true;
+        }
+        return false;
+    }
+}
