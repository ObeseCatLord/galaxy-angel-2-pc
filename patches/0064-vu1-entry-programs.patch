+    // By reach key (which covers the entry pair too).
+    std::unordered_map<uint64_t, RegisteredEntry> &jitEntryRegistry()
+    {
+        static std::unordered_map<uint64_t, RegisteredEntry> registry;
+        return registry;
+    }
+
+    // Reports a code image (and entry pair, or -1 for the image) without a
+    // generated program once; GA2_VU1_DUMP also keeps the image and the
+    // entries that missed (<hash>.entries) for ga2_vu1_gen.
+    void reportJitMiss(const uint8_t *vuCode, uint32_t codeSize, uint64_t hash, int64_t entryPair)
+    {
+        static std::unordered_map<uint64_t, bool> reported;
+        const uint64_t id = hash ^ (static_cast<uint64_t>(entryPair + 1) * 0x9E3779B97F4A7C15ull);
+        if (reported[id])
+            return;
+        reported[id] = true;
+        if (entryPair < 0)
+            std::fprintf(stderr, "[vu1jit] no generated program for code image %016llx; interpreting\n",
+                         static_cast<unsigned long long>(hash));
+        else
+            std::fprintf(stderr, "[vu1jit] no generated program for entry %04llx of code image %016llx; interpreting\n",
+                         static_cast<unsigned long long>(entryPair), static_cast<unsigned long long>(hash));
+        const char *dir = std::getenv("GA2_VU1_DUMP");
+        if (!dir || !*dir)
+            return;
+        char name[64];
+        std::snprintf(name, sizeof(name), "/%016llx", static_cast<unsigned long long>(hash));
+        if (std::FILE *f = std::fopen((std::string(dir) + name + ".bin").c_str(), "wb"))
+        {
+            std::fwrite(vuCode, 1, codeSize, f);
+            std::fclose(f);
+        }
+        if (entryPair >= 0)
+            if (std::FILE *f = std::fopen((std::string(dir) + name + ".entries").c_str(), "a"))
+            {
+                std::fprintf(f, "%lld\n", static_cast<long long>(entryPair));
+                std::fclose(f);
+            }
+    }
 }
 
+// The entry programs found in one code image so far: chunk per pair, and the
+// pairs already tried as entries. Everything here follows from the image's
+// contents, so a table is kept per image hash and reused when the game
+// uploads that image again.
+struct VU1Interpreter::JitEntryTable
+{
+    std::vector<JitProgram> chunks;
+    std::vector<uint8_t> tried;
+    bool readsStatus = false;
+    bool elidesFlags = false;
+};
+
+struct VU1Interpreter::JitEntryCache
+{
+    std::unordered_map<uint64_t, std::unique_ptr<JitEntryTable>> tables;
+};
+
 void VU1Interpreter::registerJitProgram(uint64_t codeHash, JitProgram program, bool elidesFlags)
 {
     jitRegistry()[codeHash] = {program, elidesFlags};
 }
 
+void VU1Interpreter::registerJitEntry(uint32_t entryPair, uint64_t reachKey, const JitProgram *chunks, bool elidesFlags,
+                                      bool statusElided)
+{
+    jitEntryRegistry()[reachKey] = {chunks, entryPair, elidesFlags, statusElided};
+}
+
+// Runs a microprogram from the merged entry-program table: chunks where a
+// matching program covers the pc, the interpreter elsewhere. A pc no program
+// covers yet (a run's entry, a JR target) is tried once as an entry.
+VU1Interpreter::StepResult VU1Interpreter::runJitEntries(VU1Interpreter &vu, const StepArgs &a)
+{
+    JitEntryTable &table = *vu.m_jitEntryTable;
+    const uint32_t pairs = static_cast<uint32_t>(table.chunks.size());
+    auto resolve = [&](uint32_t entry) {
+        const ps2_vu1_reach::Program reached = ps2_vu1_reach::reach(a.vuCode, pairs, entry);
+        table.tried[entry] = 1u;
+        for (uint32_t p : reached.pairs)
+            table.tried[p] = 1u;
+        const auto &registry = jitEntryRegistry();
+        const auto r = registry.find(reached.key);
+        if (r == registry.end() || r->second.entryPair != entry || (r->second.statusElided && table.readsStatus))
+        {
+            reportJitMiss(a.vuCode, a.codeSize, vu.m_jitHash, entry);
+            return;
+        }
+        // Each chunk carries its own program's analysis, and chunks are only
+        // entered with nothing pending, so programs can share a table.
+        for (uint32_t p : reached.pairs)
+            if (!table.chunks[p])
+                table.chunks[p] = r->second.chunks[p];
+        table.elidesFlags = table.elidesFlags || r->second.elidesFlags;
+    };
+
+    if (!vu.stepLoopHead(a))
+        return StepResult::Stop;
+    for (;;)
+    {
+        const uint32_t pc = vu.m_state.pc;
+        JitProgram chunk = nullptr;
+        // After an interpreted pair something may be pending that a chunk's
+        // entry facts rule out: interpret until it settles.
+        if ((pc & 7u) == 0u && (pc >> 3) < pairs && !vu.resumesInDelaySlot())
+        {
+            const uint32_t index = pc >> 3;
+            chunk = table.chunks[index];
+            if (!chunk && !table.tried[index])
+            {
+                resolve(index);
+                chunk = table.chunks[index];
+                vu.m_jitElidesFlags = table.elidesFlags;
+            }
+        }
+        const StepResult r = chunk ? chunk(vu, a) : vu.stepGeneric(a);
+        if (r != StepResult::Continue)
+            return r;
+        if (!chunk && !vu.stepLoopHead(a))
+            return StepResult::Stop;
+    }
+}
