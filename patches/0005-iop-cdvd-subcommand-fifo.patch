+        uint8_t readSubcommandRegister(uint8_t offset)
+        {
+            if (offset == 0x16u) return subcommand;
+            if (offset == 0x17u)
+                return subcommandResultPosition < subcommandResults.size() ? 0u : 0x40u;
+            if (offset == 0x18u && subcommandResultPosition < subcommandResults.size())
+                return subcommandResults[subcommandResultPosition++];
+            return 0u;
+        }
+
+        void writeSubcommandRegister(uint8_t offset, uint8_t value)
+        {
+            if (offset == 0x17u)
+            {
+                if (subcommandParameters.size() < 16u) subcommandParameters.push_back(value);
+                else subcommandParameterOverflow = true;
+                return;
+            }
+            if (offset != 0x16u) return; // Result FIFO is read-only.
+            subcommand = value;
+            subcommandResultPosition = 0u;
+            subcommandResults = {0x80u}; // Unsupported/invalid command status.
+            if (!subcommandParameterOverflow && value == 0x03u &&
+                subcommandParameters.size() == 1u && subcommandParameters[0] == 0u)
+            {
+                // Native controller profile: the reference's default mecha
+                // version, serialized least-significant byte first.
+                subcommandResults = {0x03u, 0x06u, 0x02u, 0x00u};
+            }
+            else if (!subcommandParameterOverflow && value == 0x08u && subcommandParameters.empty())
+            {
+                using namespace std::chrono;
+                const auto now = floor<seconds>(system_clock::now()) + hours{9};
+                const auto day = floor<days>(now);
+                const year_month_day date{day};
+                const hh_mm_ss time{now - day};
+                const auto bcd = [](unsigned number) { return uint8_t((number / 10u) * 16u + number % 10u); };
+                subcommandResults = {0u, bcd(unsigned(time.seconds().count())),
+                    bcd(unsigned(time.minutes().count())), bcd(unsigned(time.hours().count())),
+                    0u, bcd(unsigned(date.day())), bcd(unsigned(date.month())),
+                    bcd(unsigned(int(date.year()) % 100))};
+            }
+            else if (!subcommandParameterOverflow && value == 0x1Bu && subcommandParameters.empty())
+            {
+                // Cancel power-off readiness. The native controller has no
+                // pending console power-off request, so cancellation succeeds.
+                subcommandResults = {0u};
+            }
+            else
+            {
+                std::ostringstream message;
+                message << "[IOP CDVD] unsupported/invalid SCMD command=0x" << std::hex << unsigned(value)
+                        << " parameters=" << std::dec << subcommandParameters.size();
+                host.log(LogLevel::Warning, message.str());
+            }
+            subcommandParameters.clear();
+            subcommandParameterOverflow = false;
+        }
