+    bool testCdvdSubcommandFifo()
+    {
+        NullHost host;
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        IopCdvd cdvd(host, memory, kernel);
+        memory.setCdvdSubcommandAccess(
+            [&](uint8_t offset) { return cdvd.readSubcommandRegister(offset); },
+            [&](uint8_t offset, uint8_t value) { cdvd.writeSubcommandRegister(offset, value); });
+        constexpr uint32_t command = 0xBF402016u, parameters = 0xBF402017u, results = 0xBF402018u;
+        if (!expect(memory.read8(parameters) == 0x40u && memory.read8(results) == 0u,
+                    "reset subcommand FIFO is not empty")) return false;
+        memory.write8(parameters, 0u);
+        memory.write8(command, 3u);
+        if (!expect(memory.read8(command) == 3u && memory.read8(parameters) == 0u,
+                    "mecha version command did not publish results")) return false;
+        memory.write8(results + 1u, 0xA5u);
+        if (!expect(memory.read8(results + 1u) == 0xA5u && memory.read8(parameters) == 0u &&
+                    (memory.read32(0x1F402014u) >> 24u) == 0u,
+                    "neighbor/status access consumed a result byte")) return false;
+        if (!expect(memory.read8(results) == 3u && memory.read8(0x1F402018u) == 6u &&
+                    memory.read16(results) == 0xA502u && memory.read32(results) == 0xA500u &&
+                    memory.read8(parameters) == 0x40u,
+                    "aliased/mixed-width result reads did not drain exactly four bytes")) return false;
+        memory.write8(command, 3u); // Missing parameter must not reuse the old zero.
+        if (!expect(memory.read16(parameters) == 0x8000u && memory.read8(parameters) == 0x40u,
+                    "halfword status was sampled after consuming its last result")) return false;
+        memory.write8(command, 3u);
+        if (!expect(memory.read32(command) == 0xA5800003u && memory.read8(parameters) == 0x40u,
+                    "word status was sampled after consuming its last result")) return false;
+        for (uint32_t n = 0u; n < 17u; ++n) memory.write8(parameters, 0u);
+        memory.write8(command, 3u);
+        if (!expect(memory.read8(results) == 0x80u, "parameter overflow returned success")) return false;
+        memory.write8(parameters, 0u);
+        memory.write8(command, 3u);
+        if (!expect(memory.read8(results) == 3u, "overflow poisoned the next valid request")) return false;
+        cdvd.reset();
+        if (!expect(memory.read8(command) == 0u && memory.read8(parameters) == 0x40u &&
+                    memory.read8(results) == 0u, "controller reset retained a partial reply")) return false;
+        memory.reset();
+        kernel.reset();
+        memory.write8(command, 8u);
+        std::array<uint8_t, 8> clock{};
+        for (auto &byte : clock) byte = memory.read8(results);
+        const auto bcd = [](uint8_t value) { return (value & 15u) < 10u && (value >> 4u) < 10u; };
+        if (!expect(clock[0] == 0u && clock[4] == 0u && bcd(clock[1]) && clock[1] <= 0x59u &&
+                    bcd(clock[2]) && clock[2] <= 0x59u && bcd(clock[3]) && clock[3] <= 0x23u &&
+                    bcd(clock[5]) && clock[5] >= 1u && clock[5] <= 0x31u &&
+                    bcd(clock[6]) && clock[6] >= 1u && clock[6] <= 0x12u && bcd(clock[7]) &&
+                    memory.read8(parameters) == 0x40u,
+                    "RTC reply is not a complete valid BCD snapshot")) return false;
+        memory.write8(command, 0x1Bu);
+        if (!expect(memory.read8(results) == 0u && memory.read8(parameters) == 0x40u,
+                    "power-off readiness cancellation did not complete")) return false;
+        memory.write8(command, 0xFEu);
+        memory.write8(results, 0u); // Read-only result port cannot fake a success.
+        return expect(memory.read8(results) == 0x80u && memory.read8(parameters) == 0x40u,
+                      "unsupported command/result-port write fabricated success");
+    }
