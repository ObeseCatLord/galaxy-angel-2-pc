From afeafc7c48644d4d9d97f9e8f0923d2219659923 Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Wed, 14 Oct 2026 03:13:18 -0500
Subject: [PATCH] ga2: mouse on dialogue buttons, system menu, choices, yes/no
 prompts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Menus recognised from the presented picture (shared by all three games):
- dialogue box Auto / Back / Menu buttons press Triangle / Square / Select;
- the system menu (ロード / セーブ / オプション / ゲームをやめる) and
  yes/no prompts (はい / いいえ) follow the pointer: the item whose centre
  row is red is the cursor, Up/Down (Left/Right for yes/no) move it;
- story choices (thought bubble, white dot = selected row) likewise.
A left press belongs to what it landed on until release, so a button that
changes look when pressed no longer turns the rest of the press into Circle.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 ps2xRuntime/src/lib/ps2_mouse.cpp       |  38 +++-
 ps2xRuntime/src/lib/ps2_mouse.h         |   5 +
 ps2xRuntime/src/lib/ps2_mouse_menus.cpp | 251 +++++++++++++++++++++---
 ps2xRuntime/src/lib/ps2_runtime.cpp     |   2 +
 4 files changed, 268 insertions(+), 28 deletions(-)

diff --git a/ps2xRuntime/src/lib/ps2_mouse.cpp b/ps2xRuntime/src/lib/ps2_mouse.cpp
index 797d1a0..2f7bbb3 100644
--- a/ps2xRuntime/src/lib/ps2_mouse.cpp
+++ b/ps2xRuntime/src/lib/ps2_mouse.cpp
@@ -31,7 +31,7 @@ namespace ps2_mouse
         std::array<Button, 14> g_buttons{};
         double g_lastMove = -10.0;
         uint16_t g_held = 0;
-        bool g_overPad = false, g_clickedGame = false;
+        bool g_overPad = false, g_clickedGame = false, g_pressOwned = false;
         int g_wheelNotches = 0, g_wheelPhase = 0;
         uint16_t g_wheelDirection = 0;
 
@@ -128,7 +128,14 @@ namespace ps2_mouse
         // confirm; elsewhere the left button is Circle.
         const uint16_t menu = ps2_mouse_menus::update();
         g_held |= menu;
-        if (!pad && overGame && IsMouseButtonDown(MOUSE_BUTTON_LEFT) && !ps2_mouse_menus::ownsClick())
+        // A press belongs to what it landed on until release: one that opened
+        // a menu through an on-screen button must not turn into Circle when
+        // the button's look changes under the still-held mouse.
+        if (IsMouseButtonPressed(MOUSE_BUTTON_LEFT))
+            g_pressOwned = pad != nullptr || ps2_mouse_menus::ownsClick();
+        if (!IsMouseButtonDown(MOUSE_BUTTON_LEFT))
+            g_pressOwned = false;
+        if (!pad && overGame && IsMouseButtonDown(MOUSE_BUTTON_LEFT) && !g_pressOwned && !ps2_mouse_menus::ownsClick())
             g_held |= kCircle;
         if (IsMouseButtonDown(MOUSE_BUTTON_RIGHT))
             g_held |= kCross;
@@ -206,6 +213,33 @@ namespace ps2_mouse
         }
     }
 
+    namespace
+    {
+        const uint8_t *g_frame = nullptr;
+        uint32_t g_frameWidth = 0, g_frameHeight = 0;
+    }
+
+    void setFrame(const uint8_t *rgba, uint32_t width, uint32_t height)
+    {
+        g_frame = rgba;
+        g_frameWidth = width;
+        g_frameHeight = height;
+    }
+
+    bool pixel(int x, int y, uint8_t rgb[3])
+    {
+        if (!g_frame || g_frameWidth == 0 || g_frameHeight == 0)
+            return false;
+        // The presented picture may be supersampled (2x/4x): scale from 640x448.
+        const uint32_t fx = static_cast<uint32_t>(x) * g_frameWidth / static_cast<uint32_t>(g_sourceWidth);
+        const uint32_t fy = static_cast<uint32_t>(y) * g_frameHeight / static_cast<uint32_t>(g_sourceHeight);
+        if (x < 0 || y < 0 || fx >= g_frameWidth || fy >= g_frameHeight)
+            return false;
+        const uint8_t *p = g_frame + (size_t(fy) * g_frameWidth + fx) * 4u;
+        rgb[0] = p[0]; rgb[1] = p[1]; rgb[2] = p[2];
+        return true;
+    }
+
     uint16_t heldButtons() { return g_held; }
     bool clickedGame() { return g_clickedGame; }
 
diff --git a/ps2xRuntime/src/lib/ps2_mouse.h b/ps2xRuntime/src/lib/ps2_mouse.h
index 4324f29..db41591 100644
--- a/ps2xRuntime/src/lib/ps2_mouse.h
