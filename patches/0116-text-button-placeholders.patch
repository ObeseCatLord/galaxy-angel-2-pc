+++ b/ps2xTest/src/ga2_text_icons_tests.cpp
@@ -0,0 +1,40 @@
+#include "MiniTest.h"
+
+#include "runtime/ga2_text_icons.h"
+
+#include <cstring>
+#include <set>
+#include <string>
+
+void register_ga2_text_icons_tests()
+{
+    MiniTest::Case("GA2TextIcons", [](TestCase &tc) {
+        tc.Run("the reserved characters are valid, in order and not the escape character", [](TestCase &t) {
+            using namespace ga2_text_icons;
+            t.Equals(unsigned(kFirstCode >> 8), 0xF0u, "lead byte in the user-defined range");
+            t.IsTrue(kGlyphCount > 0, "there are glyphs");
+            for (unsigned i = 0; i < kGlyphCount; ++i)
+            {
+                t.Equals(unsigned(kGlyphs[i].index), i, "index = position");
+                const unsigned trail = (kFirstCode & 0xFFu) + i;
+                t.IsTrue(trail >= 0x40u && trail <= 0x7Eu && trail != 0x5Cu, "trail byte valid and not a backslash");
+                t.IsTrue(kGlyphs[i].parts == 1 || kGlyphs[i].parts == 2, "one or two cells");
+                t.IsTrue(kGlyphs[i].part < kGlyphs[i].parts, "part within the icon");
+            }
+        });
+
+        tc.Run("every glyph bitmap is drawn and unique (the texture replacement tells them apart by it)", [](TestCase &t) {
+            using namespace ga2_text_icons;
+            std::set<std::string> seen;
+            for (unsigned i = 0; i < kGlyphCount; ++i)
+            {
+                bool ink = false;
+                for (uint8_t b : kGlyphs[i].bitmap)
+                    ink = ink || b != 0;
+                t.IsTrue(ink, "the bitmap has pixels");
+                const bool fresh = seen.insert(std::string(reinterpret_cast<const char *>(kGlyphs[i].bitmap), kGlyphBytes)).second;
+                t.IsTrue(fresh, "no two glyphs share a bitmap");
+            }
+        });
+    });
+}
