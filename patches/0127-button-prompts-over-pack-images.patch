diff --git a/ps2xRuntime/src/lib/gs/gs_buttonmatch.h b/ps2xRuntime/src/lib/gs/gs_buttonmatch.h
new file mode 100644
index 0000000..3749d41
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_buttonmatch.h
@@ -0,0 +1,306 @@
+// Finding the games' PS2 button icons inside a texture-pack image (gs_texpacks.cpp).
+//
+// The button map (native/buttons/map.json) lists icon rectangles in the ORIGINAL
+// texture. A language pack replaces the whole texture; for the options, load/save
+// and similar screens the artist kept the icon where it was, but in the tutorial and
+// message-box translations the text was laid out again and the icons moved. So the
+// original icon pixels (the decoded original at the mapped rectangle) are used as a
+// template and looked for in the pack image: only confident matches are accepted,
+// and nothing is touched when there is none (never cover text).
+//
+// Pure functions on RGBA words (R | G << 8 | B << 16 | A << 24, alpha 255 = opaque)
+// so the tests can drive them without Vulkan or raylib.
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace ga2_buttonmatch
+{
+    struct Rgba
+    {
+        int w = 0, h = 0;
+        std::vector<uint32_t> px;
+    };
+
+    struct Rect
+    {
+        int x = 0, y = 0, w = 0, h = 0;
+    };
+
+    struct Match
+    {
+        Rect r;          // in pack pixels
+        float score = 0; // mean absolute difference per channel (0 = identical)
+        int spot = -1;   // index of the spot whose template matched
+    };
+
+    // Acceptance: a match is confident when its mean per-channel difference is below
+    // kAbsolute and well below what a flat patch of the template's mean colour would
+    // score (kRelative of the template's own contrast); templates with less contrast
+    // than kMinContrast say nothing and are never searched for.
+    constexpr float kAbsolute = 24.0f;
+    constexpr float kRelative = 0.30f;
+    constexpr float kMinContrast = 14.0f;
+    // A translator may have redrawn the icon (same button, same colours, slightly different art): the
+    // looser limits below then apply, but only to templates with a coloured symbol and only when the found
+    // symbol has the same colour (a cross is not taken for a circle).
+    constexpr float kLooseAbsolute = 40.0f;
+    constexpr float kLooseRelative = 0.60f;
+    constexpr float kHueTolerance = 28.0f; // degrees
+
+    inline int channel(uint32_t c, int i) { return int((c >> (8 * i)) & 255u); }
+
+    // Fully transparent pixels carry no colour.
+    inline uint32_t canonical(uint32_t c) { return (c >> 24) ? c : 0u; }
+
+    // Whether the point (x, y), relative to the rectangle's corner in the same units, is inside the
+    // stadium inscribed in a w x h rectangle (an ellipse for squares, a pill for wide rectangles),
+    // grown by `margin`.
+    inline bool inStadium(float x, float y, float w, float h, float margin)
+    {
+        const float r = std::min(w, h) * 0.5f + margin;
+        const float cy = h * 0.5f;
+        const float x0 = std::min(w, h) * 0.5f, x1 = w - x0;
+        const float cx = std::clamp(x, x0, x1);
+        const float dx = x - cx, dy = y - cy;
+        return dx * dx + dy * dy <= r * r;
+    }
+
+    struct Sample
+    {
+        int dx, dy;
+        int c[4];
+    };
+
+    struct Template
+    {
+        int w = 0, h = 0;
+        std::vector<Sample> samples; // the stadium's pixels, in a scattered order (early exits stay cheap)
+        float contrast = 0;          // mean absolute deviation from the mean colour
+        // The coloured symbol: hue (degrees) of the saturated pixels and their share of the stadium; hue < 0
+        // when the template has none (grey keycaps and pills), which then only ever match tightly.
+        float hue = -1, share = 0;
+    };
+
+    // Hue (degrees) of an RGB colour, and whether it is saturated and bright enough to carry one.
+    inline bool hueOf(int r, int g, int b, float &hue)
+    {
+        const int mx = std::max({r, g, b}), mn = std::min({r, g, b});
+        if (mx - mn < 60 || mx < 90)
+            return false;
+        const float d = float(mx - mn);
+        float h = mx == r ? float(g - b) / d : mx == g ? 2.0f + float(b - r) / d : 4.0f + float(r - g) / d;
+        h *= 60.0f;
+        hue = h < 0 ? h + 360.0f : h;
+        return true;
+    }
+
+    inline float hueDistance(float a, float b)
+    {
+        const float d = std::fabs(a - b);
+        return std::min(d, 360.0f - d);
+    }
+
+    // The mean hue and share of the saturated pixels of `samples` (pixels colour-weighted by vector mean).
+    template <class GetRgba>
+    inline void symbolColour(size_t n, GetRgba get, float &hue, float &share)
+    {
+        double sx = 0, sy = 0;
+        size_t count = 0;
+        for (size_t i = 0; i < n; ++i)
+        {
+            int c[4];
+            get(i, c);
+            float h;
+            if (c[3] > 128 && hueOf(c[0], c[1], c[2], h))
+            {
+                sx += std::cos(h * 0.0174533f);
+                sy += std::sin(h * 0.0174533f);
+                ++count;
+            }
+        }
+        share = n ? float(count) / float(n) : 0.0f;
+        hue = count ? float(std::atan2(sy, sx) / 0.0174533) : -1.0f;
+        if (hue < 0 && count)
+            hue += 360.0f;
+    }
+
+    // The original rectangle `spot`, resampled by (sx, sy) (bilinear) into the pack's pixel grid.
+    inline Template makeTemplate(const Rgba &orig, const Rect &spot, float sx, float sy)
+    {
+        Template t;
+        t.w = std::max(1, int(std::lround(spot.w * sx)));
+        t.h = std::max(1, int(std::lround(spot.h * sy)));
+        std::vector<Sample> all;
+        for (int y = 0; y < t.h; ++y)
+            for (int x = 0; x < t.w; ++x)
+            {
+                if (!inStadium(float(x) + 0.5f, float(y) + 0.5f, float(t.w), float(t.h), -0.5f))
+                    continue;
+                // Source position of the pixel centre inside the original rectangle.
+                const float fx = spot.x + (float(x) + 0.5f) / sx - 0.5f, fy = spot.y + (float(y) + 0.5f) / sy - 0.5f;
+                const int x0 = int(std::floor(fx)), y0 = int(std::floor(fy));
+                const float ax = fx - float(x0), ay = fy - float(y0);
+                Sample s{x, y, {0, 0, 0, 0}};
+                for (int ch = 0; ch < 4; ++ch)
+                {
+                    float v = 0;
+                    for (int j = 0; j < 4; ++j)
+                    {
+                        const int px = std::clamp(x0 + (j & 1), 0, orig.w - 1), py = std::clamp(y0 + (j >> 1), 0, orig.h - 1);
+                        const float wgt = ((j & 1) ? ax : 1 - ax) * ((j >> 1) ? ay : 1 - ay);
+                        v += wgt * float(channel(canonical(orig.px[size_t(py) * size_t(orig.w) + size_t(px)]), ch));
+                    }
+                    s.c[ch] = int(std::lround(v));
+                }
+                all.push_back(s);
+            }
+        if (all.empty())
+            return t;
+        double mean[4] = {};
+        for (const Sample &s : all)
+            for (int ch = 0; ch < 4; ++ch)
+                mean[ch] += s.c[ch];
+        for (double &m : mean)
+            m /= double(all.size());
+        double dev = 0;
+        for (const Sample &s : all)
+            for (int ch = 0; ch < 4; ++ch)
+                dev += std::fabs(s.c[ch] - mean[ch]);
+        t.contrast = float(dev / (4.0 * double(all.size())));
+        symbolColour(all.size(), [&](size_t i, int *c) { for (int ch = 0; ch < 4; ++ch) c[ch] = all[i].c[ch]; }, t.hue, t.share);
+        // A fixed stride coprime to the count scatters the samples across the template.
+        const size_t n = all.size();
+        size_t stride = n / 2 + 1;
+        auto gcd = [](size_t a, size_t b) { while (b) { const size_t r = a % b; a = b; b = r; } return a; };
+        while (gcd(stride, n) != 1)
+            ++stride;
+        t.samples.reserve(n);
+        for (size_t i = 0, k = 0; i < n; ++i, k = (k + stride) % n)
+            t.samples.push_back(all[k]);
+        return t;
+    }
+
+    // Mean per-channel absolute difference of the template placed at (ox, oy); stops (returning a value
+    // above `limit`) as soon as it cannot get below it.
+    inline float scoreAt(const Rgba &img, const Template &t, int ox, int oy, float limit)
+    {
+        const long long cap = (long long)(limit * 4.0f * float(t.samples.size()));
+        long long sum = 0;
+        for (const Sample &s : t.samples)
+        {
+            const uint32_t c = canonical(img.px[size_t(oy + s.dy) * size_t(img.w) + size_t(ox + s.dx)]);
+            for (int ch = 0; ch < 4; ++ch)
+                sum += std::abs(channel(c, ch) - s.c[ch]);
+            if (sum > cap)
+                return limit + 1.0f;
+        }
+        return float(double(sum) / (4.0 * double(t.samples.size())));
+    }
+
+    // The places in `pack` that show one of the icons cut from `orig` at `spots` (original pixels);
+    // overlapping finds are reduced to the best one. Spots may repeat a button: each distinct place is
+    // reported once, tagged with the spot that matched it best.
+    inline std::vector<Match> findIcons(const Rgba &pack, const Rgba &orig, const std::vector<Rect> &spots)
+    {
+        std::vector<Match> candidates;
+        if (pack.w <= 0 || pack.h <= 0 || orig.w <= 0 || orig.h <= 0)
+            return candidates;
+        const float sx = float(pack.w) / float(orig.w), sy = float(pack.h) / float(orig.h);
+        for (size_t i = 0; i < spots.size(); ++i)
+        {
+            const Rect &sp = spots[i];
+            if (sp.w <= 0 || sp.h <= 0 || sp.x < 0 || sp.y < 0 || sp.x + sp.w > orig.w || sp.y + sp.h > orig.h)
+                continue;
+            const Template t = makeTemplate(orig, sp, sx, sy);
+            if (t.samples.empty() || t.contrast < kMinContrast || t.w > pack.w || t.h > pack.h)
+                continue;
+            const float tight = std::min(kAbsolute, kRelative * t.contrast);
+            const bool coloured = t.hue >= 0 && t.share >= 0.04f;
+            const float limit = coloured ? std::max(tight, std::min(kLooseAbsolute, kLooseRelative * t.contrast)) : tight;
+            for (int y = 0; y + t.h <= pack.h; ++y)
+                for (int x = 0; x + t.w <= pack.w; ++x)
+                {
+                    const float score = scoreAt(pack, t, x, y, limit);
+                    if (score > limit)
+                        continue;
+                    if (score > tight)
+                    {
+                        // Only a redrawn icon of the same colour is accepted this loosely.
+                        float hue, share;
+                        symbolColour(t.samples.size(), [&](size_t k, int *c) {
+                            const Sample &s = t.samples[k];
+                            const uint32_t px = canonical(pack.px[size_t(y + s.dy) * size_t(pack.w) + size_t(x + s.dx)]);
+                            for (int ch = 0; ch < 4; ++ch) c[ch] = channel(px, ch);
+                        }, hue, share);
+                        if (hue < 0 || hueDistance(hue, t.hue) > kHueTolerance || share < t.share * 0.4f || share > t.share * 2.5f)
+                            continue;
+                    }
+                    candidates.push_back({{x, y, t.w, t.h}, score, int(i)});
+                }
+        }
+        std::stable_sort(candidates.begin(), candidates.end(),
+                         [](const Match &a, const Match &b) { return a.score < b.score; });
+        std::vector<Match> kept;
+        for (const Match &m : candidates)
+        {
+            bool overlaps = false;
+            for (const Match &k : kept)
+            {
+                const int ix = std::max(0, std::min(m.r.x + m.r.w, k.r.x + k.r.w) - std::max(m.r.x, k.r.x));
+                const int iy = std::max(0, std::min(m.r.y + m.r.h, k.r.y + k.r.h) - std::max(m.r.y, k.r.y));
+                if (double(ix) * double(iy) > 0.2 * double(std::min(m.r.w * m.r.h, k.r.w * k.r.h)))
+                {
+                    overlaps = true;
+                    break;
+                }
+            }
+            if (!overlaps)
+                kept.push_back(m);
+        }
+        std::sort(kept.begin(), kept.end(), [](const Match &a, const Match &b) {
+            return a.r.y != b.r.y ? a.r.y < b.r.y : a.r.x < b.r.x;
+        });
+        return kept;
+    }
+
+    // The colour around a rectangle: the per-channel median of the one-pixel ring just outside it.
+    inline uint32_t ringColor(const Rgba &img, const Rect &r)
+    {
+        std::vector<int> ch[4];
+        for (int y = r.y - 1; y <= r.y + r.h; ++y)
+            for (int x = r.x - 1; x <= r.x + r.w; ++x)
+            {
+                const bool border = y == r.y - 1 || y == r.y + r.h || x == r.x - 1 || x == r.x + r.w;
+                if (!border || x < 0 || y < 0 || x >= img.w || y >= img.h)
+                    continue;
+                const uint32_t c = img.px[size_t(y) * size_t(img.w) + size_t(x)];
+                for (int i = 0; i < 4; ++i)
+                    ch[i].push_back(channel(c, i));
+            }
+        uint32_t out = 0;
+        for (int i = 0; i < 4; ++i)
+        {
+            if (ch[i].empty())
+                continue;
+            std::nth_element(ch[i].begin(), ch[i].begin() + ch[i].size() / 2, ch[i].end());
+            out |= uint32_t(ch[i][ch[i].size() / 2]) << (8 * i);
+        }
+        return out;
+    }
+
+    // Paint the stadium of the rectangle (x, y, w, h; in the image's own pixels, grown by `margin`) with
+    // `color`, leaving the rectangle's corners (the art around a round button) alone.
+    inline void coverStadium(uint32_t *px, int imgW, int imgH, const Rect &r, float margin, uint32_t color)
+    {
+        const int x0 = std::max(0, r.x - int(std::ceil(margin))), x1 = std::min(imgW, r.x + r.w + int(std::ceil(margin)));
+        const int y0 = std::max(0, r.y - int(std::ceil(margin))), y1 = std::min(imgH, r.y + r.h + int(std::ceil(margin)));
+        for (int y = y0; y < y1; ++y)
+            for (int x = x0; x < x1; ++x)
+                if (inStadium(float(x - r.x) + 0.5f, float(y - r.y) + 0.5f, float(r.w), float(r.h), margin))
+                    px[size_t(y) * size_t(imgW) + size_t(x)] = color;
+    }
+}
diff --git a/ps2xRuntime/src/lib/gs/gs_buttonpack.h b/ps2xRuntime/src/lib/gs/gs_buttonpack.h
new file mode 100644
index 0000000..8c200e9
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_buttonpack.h
@@ -0,0 +1,107 @@
+// Button prompts over a texture-pack image (gs_texpacks.cpp): the pack's PNG with
+// the PS2 icons found in it (gs_buttonmatch.h) covered and the style's icons drawn
+// in their place. Needs raylib for the image work, nothing else, so the offline
+// check (tools/modding/check_pack_buttons.cpp) builds from it.
+#pragma once
+
+#include "gs_buttonmatch.h"
+
+#include "raylib.h"
+
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ga2_buttonmatch
+{
+    struct IconSpot
+    {
+        std::string button;
+        int x = 0, y = 0, w = 0, h = 0; // in the original texture's pixels
+    };
+
+    // The style's icon for a button; `wide` asks for the keycap/pill variant when the style has one.
+    using IconLookup = std::function<const ::Image *(const std::string &button, bool wide)>;
+
+    // Wide spots (pills, 'Menu' keys) take the wide variant of the icon.
+    inline bool wideSpot(int w, int h) { return w * 10 >= h * 15; }
+
+    // The visible part of the icon fitted, keeping its shape, into the rectangle (output pixels).
+    inline void drawIconFitted(::Image &out, const ::Image &art, float x, float y, float w, float h)
+    {
+        const Rectangle src = GetImageAlphaBorder(art, 0.05f);
+        const float scale = std::min(w / src.width, h / src.height);
+        const float dw = src.width * scale, dh = src.height * scale;
+        ImageDraw(&out, art, src, Rectangle{x + (w - dw) * 0.5f, y + (h - dh) * 0.5f, dw, dh}, WHITE);
+    }
+
+    // `pack`: the pack image (RGBA8, alpha 255 = opaque). `orig`: the original texture's pixels as decoded from
+    // GS memory (alpha 0x80 = opaque), ow x oh, which the spots refer to. The result is the pack image, scaled
+    // up to at least `scale` times the original's size, with every confidently found PS2 icon replaced. False
+    // (and `out` empty) when no icon is found: the pack image should then be used as it is. `matchesOut`, when
+    // given, receives the icons found (pack pixels).
+    inline bool composePackButtons(const ::Image &pack, const std::vector<uint32_t> &orig, int ow, int oh,
+                                   const std::vector<IconSpot> &spots, int scale, const IconLookup &lookup, ::Image &out,
+                                   std::vector<Match> *matchesOut = nullptr)
+    {
+        out = ::Image{};
+        if (!pack.data || pack.format != PIXELFORMAT_UNCOMPRESSED_R8G8B8A8 || pack.width <= 0 || pack.height <= 0 ||
+            ow <= 0 || oh <= 0 || orig.size() < size_t(ow) * size_t(oh) || spots.empty())
+            return false;
+        Rgba packRgba;
+        packRgba.w = pack.width;
+        packRgba.h = pack.height;
+        packRgba.px.assign(static_cast<const uint32_t *>(pack.data), static_cast<const uint32_t *>(pack.data) + size_t(pack.width) * size_t(pack.height));
+        Rgba origRgba;
+        origRgba.w = ow;
+        origRgba.h = oh;
+        origRgba.px.resize(size_t(ow) * size_t(oh));
+        for (size_t i = 0; i < origRgba.px.size(); ++i)
+        {
+            const uint32_t c = orig[i];
+            origRgba.px[i] = (c & 0x00FFFFFFu) | (std::min<uint32_t>(255u, (c >> 24) * 2u) << 24);
+        }
+        std::vector<Rect> rects;
+        for (const IconSpot &s : spots)
+            rects.push_back({s.x, s.y, s.w, s.h});
+        const std::vector<Match> found = findIcons(packRgba, origRgba, rects);
+        if (matchesOut)
+            *matchesOut = found;
+        if (found.empty())
+            return false;
+        // The colours around the icons, from the untouched pack image.
+        std::vector<uint32_t> fills;
+        for (const Match &m : found)
+            fills.push_back(ringColor(packRgba, m.r));
+
+        const int outW = std::max(pack.width, ow * scale), outH = std::max(pack.height, oh * scale);
+        out = ImageCopy(pack);
+        if (outW != pack.width || outH != pack.height)
+            ImageResize(&out, outW, outH);
+        const float fx = float(outW) / float(pack.width), fy = float(outH) / float(pack.height);
+        bool drew = false;
+        for (size_t i = 0; i < found.size(); ++i)
+        {
+            const IconSpot &spot = spots[size_t(found[i].spot)];
+            const ::Image *art = lookup(spot.button, wideSpot(spot.w, spot.h));
+            if (!art)
+                continue;
+            const Rect &r = found[i].r;
+            const Rect o{int(std::floor(r.x * fx)), int(std::floor(r.y * fy)),
+                         int(std::ceil((r.x + r.w) * fx)) - int(std::floor(r.x * fx)),
+                         int(std::ceil((r.y + r.h) * fy)) - int(std::floor(r.y * fy))};
+            // The PS2 icon's anti-aliased edge reaches one pack pixel past the matched disc.
+            coverStadium(static_cast<uint32_t *>(out.data), out.width, out.height, o, std::max(fx, fy), fills[i]);
+            drawIconFitted(out, *art, float(o.x), float(o.y), float(o.w), float(o.h));
+            drew = true;
+        }
+        if (!drew)
+        {
+            UnloadImage(out);
+            out = ::Image{};
+        }
+        return drew;
+    }
+}
