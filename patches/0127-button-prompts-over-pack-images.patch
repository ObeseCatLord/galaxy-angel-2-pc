diff --git a/ps2xTest/src/ga2_buttonmatch_tests.cpp b/ps2xTest/src/ga2_buttonmatch_tests.cpp
new file mode 100644
index 0000000..b1263a2
--- /dev/null
+++ b/ps2xTest/src/ga2_buttonmatch_tests.cpp
@@ -0,0 +1,196 @@
+#include "MiniTest.h"
+#include "gs/gs_buttonmatch.h"
+
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace
+{
+    using namespace ga2_buttonmatch;
+
+    uint32_t rgba(int r, int g, int b, int a = 255) { return uint32_t(r) | uint32_t(g) << 8 | uint32_t(b) << 16 | uint32_t(a) << 24; }
+
+    Rgba blank(int w, int h, uint32_t c)
+    {
+        Rgba img;
+        img.w = w;
+        img.h = h;
+        img.px.assign(size_t(w) * size_t(h), c);
+        return img;
+    }
+
+    // A PS2-style button: dark disc with a coloured symbol (kind 0: ring, 1: cross, 2: bar).
+    void drawButton(Rgba &img, int x0, int y0, int size, int kind)
+    {
+        const float c = size * 0.5f;
+        for (int y = 0; y < size; ++y)
+            for (int x = 0; x < size; ++x)
+            {
+                const float dx = x + 0.5f - c, dy = y + 0.5f - c;
+                if (dx * dx + dy * dy > c * c)
+                    continue;
+                uint32_t col = rgba(28, 30, 44);
+                const float r2 = dx * dx + dy * dy;
+                if (kind == 0 && r2 < (c * 0.6f) * (c * 0.6f) && r2 > (c * 0.3f) * (c * 0.3f))
+                    col = rgba(230, 70, 60);
+                if (kind == 1 && (std::abs(dx - dy) < 1.2f || std::abs(dx + dy) < 1.2f) && r2 < (c * 0.7f) * (c * 0.7f))
+                    col = rgba(70, 110, 240);
+                if (kind == 2 && std::abs(dy) < c * 0.15f && std::abs(dx) < c * 0.6f)
+                    col = rgba(240, 240, 240);
+                img.px[size_t(y0 + y) * size_t(img.w) + size_t(x0 + x)] = col;
+            }
+    }
+
+    // Stripes standing in for text.
+    void drawText(Rgba &img, int x0, int y0, int w, int h)
+    {
+        for (int y = y0; y < y0 + h; ++y)
+            for (int x = x0; x < x0 + w; ++x)
+                if (((x / 2) + (y / 3)) % 3 == 0)
+                    img.px[size_t(y) * size_t(img.w) + size_t(x)] = rgba(250, 250, 250);
+    }
+
+    Rgba scaled(const Rgba &src, int k)
+    {
+        Rgba out = blank(src.w * k, src.h * k, 0);
+        for (int y = 0; y < out.h; ++y)
+            for (int x = 0; x < out.w; ++x)
+                out.px[size_t(y) * size_t(out.w) + size_t(x)] = src.px[size_t(y / k) * size_t(src.w) + size_t(x / k)];
+        return out;
+    }
+}
+
+void register_ga2_buttonmatch_tests()
+{
+    MiniTest::Case("GA2ButtonMatch", [](TestCase &tc) {
+        const uint32_t bg = rgba(190, 170, 120);
+
+        tc.Run("an icon that kept its place is found there", [](TestCase &t) {
+            Rgba orig = blank(96, 64, rgba(190, 170, 120));
+            drawButton(orig, 10, 12, 20, 0);
+            Rgba pack = orig;
+            const auto found = findIcons(pack, orig, {{10, 12, 20, 20}});
+            t.Equals(found.size(), size_t(1), "one match");
+            if (found.size() == 1)
+            {
+                t.Equals(found[0].r.x, 10, "x");
+                t.Equals(found[0].r.y, 12, "y");
+                t.IsTrue(found[0].score < 0.5f, "identical pixels");
+            }
+        });
+
+        tc.Run("a moved icon is found, one per occurrence, and the old place is left alone", [](TestCase &t) {
+            Rgba orig = blank(160, 64, rgba(190, 170, 120));
+            drawButton(orig, 4, 4, 20, 1);
+            Rgba pack = blank(160, 64, rgba(190, 170, 120));
+            drawText(pack, 4, 4, 30, 20); // the English text where the icon was
+            drawButton(pack, 60, 30, 20, 1);
+            drawButton(pack, 120, 10, 20, 1);
+            const auto found = findIcons(pack, orig, {{4, 4, 20, 20}});
+            t.Equals(found.size(), size_t(2), "both occurrences");
+            if (found.size() == 2)
+            {
+                t.Equals(found[0].r.x, 120, "first (top) one");
+                t.Equals(found[0].r.y, 10, "its row");
+                t.Equals(found[1].r.x, 60, "second");
+                t.Equals(found[1].r.y, 30, "its row");
+            }
+        });
+
+        tc.Run("a pack without the icon matches nothing (text is never covered)", [](TestCase &t) {
+            Rgba orig = blank(96, 64, rgba(190, 170, 120));
+            drawButton(orig, 10, 12, 20, 0);
+            Rgba pack = blank(96, 64, rgba(190, 170, 120));
+            drawText(pack, 0, 0, 96, 64);
+            t.IsTrue(findIcons(pack, orig, {{10, 12, 20, 20}}).empty(), "nothing found");
+            // Another button's icon is not mistaken for this one.
+            Rgba other = blank(96, 64, rgba(190, 170, 120));
+            drawButton(other, 40, 20, 20, 1);
+            t.IsTrue(findIcons(other, orig, {{10, 12, 20, 20}}).empty(), "cross is not a circle");
+        });
+
+        tc.Run("each match carries the spot that matched it", [](TestCase &t) {
+            Rgba orig = blank(96, 64, rgba(190, 170, 120));
+            drawButton(orig, 4, 4, 20, 0);
+            drawButton(orig, 40, 4, 20, 1);
+            Rgba pack = blank(96, 64, rgba(190, 170, 120));
+            drawButton(pack, 30, 30, 20, 1);
+            drawButton(pack, 60, 30, 20, 0);
+            const auto found = findIcons(pack, orig, {{4, 4, 20, 20}, {40, 4, 20, 20}});
+            t.Equals(found.size(), size_t(2), "two matches");
+            if (found.size() == 2)
+            {
+                t.Equals(found[0].spot, 1, "cross at x=30");
+                t.Equals(found[1].spot, 0, "circle at x=60");
+            }
+        });
+
+        tc.Run("a pack at twice the resolution is searched at its own scale", [](TestCase &t) {
+            Rgba orig = blank(96, 64, rgba(190, 170, 120));
+            drawButton(orig, 8, 8, 20, 0);
+            Rgba small = blank(96, 64, rgba(190, 170, 120));
+            drawButton(small, 50, 30, 20, 0);
+            const Rgba pack = scaled(small, 2);
+            const auto found = findIcons(pack, orig, {{8, 8, 20, 20}});
+            t.Equals(found.size(), size_t(1), "one match");
+            if (found.size() == 1)
+            {
+                t.Equals(found[0].r.x, 100, "x in pack pixels");
+                t.Equals(found[0].r.y, 60, "y in pack pixels");
+                t.Equals(found[0].r.w, 40, "width in pack pixels");
+            }
+        });
+
+        tc.Run("a template without contrast is never searched for", [](TestCase &t) {
+            const Rgba orig = blank(64, 64, rgba(100, 100, 100));
+            const Rgba pack = blank(64, 64, rgba(100, 100, 100));
+            t.IsTrue(findIcons(pack, orig, {{10, 10, 16, 16}}).empty(), "flat");
+            t.IsTrue(findIcons(pack, orig, {{60, 60, 16, 16}}).empty(), "outside the original");
+        });
+
+        tc.Run("pills (wide spots) are matched too", [](TestCase &t) {
+            Rgba orig = blank(120, 40, rgba(190, 170, 120));
+            for (int y = 0; y < 14; ++y)
+                for (int x = 0; x < 40; ++x)
+                {
+                    const float dx = std::max(0.0f, std::abs(x + 0.5f - 20.0f) - 13.0f), dy = y + 0.5f - 7.0f;
+                    if (dx * dx + dy * dy <= 49.0f)
+                        orig.px[size_t(y + 5) * 120 + size_t(x + 6)] = (x > 10 && x < 30 && y > 3 && y < 10 && (x / 3) % 2 == 0) ? rgba(240, 240, 240) : rgba(90, 90, 100);
+                }
+            Rgba pack = blank(120, 40, rgba(190, 170, 120));
+            for (int y = 0; y < 14; ++y)
+                for (int x = 0; x < 40; ++x)
+                    pack.px[size_t(y + 20) * 120 + size_t(x + 70)] = orig.px[size_t(y + 5) * 120 + size_t(x + 6)];
+            const auto found = findIcons(pack, orig, {{6, 5, 40, 14}});
+            t.Equals(found.size(), size_t(1), "found");
+            if (found.size() == 1)
+            {
+                t.Equals(found[0].r.x, 70, "x");
+                t.Equals(found[0].r.y, 20, "y");
+            }
+        });
+
+        tc.Run("the ring colour is the median around the rectangle", [bg](TestCase &t) {
+            Rgba img = blank(20, 20, bg);
+            img.px[size_t(4) * 20 + 7] = rgba(255, 255, 255); // text pixel on the ring
+            t.Equals(ringColor(img, {8, 8, 4, 4}), bg, "median ignores a stray pixel");
+            img.px[size_t(8) * 20 + 7] = rgba(0, 0, 0);
+            t.Equals(ringColor(img, {8, 8, 4, 4}), bg, "also one dark pixel");
+        });
+
+        tc.Run("covering fills the disc but leaves the rectangle's corners", [bg](TestCase &t) {
+            Rgba img = blank(40, 40, bg);
+            drawButton(img, 10, 10, 20, 0);
+            coverStadium(img.px.data(), img.w, img.h, {10, 10, 20, 20}, 1.0f, bg);
+            bool clean = true;
+            for (const uint32_t c : img.px)
+                clean = clean && c == bg;
+            t.IsTrue(clean, "no icon pixel is left");
+            Rgba corner = blank(40, 40, rgba(1, 2, 3));
+            coverStadium(corner.px.data(), corner.w, corner.h, {10, 10, 20, 20}, 1.0f, bg);
+            t.Equals(corner.px[size_t(10) * 40 + 10], rgba(1, 2, 3), "corner untouched");
+            t.Equals(corner.px[size_t(20) * 40 + 20], bg, "centre covered");
+        });
+    });
+}
