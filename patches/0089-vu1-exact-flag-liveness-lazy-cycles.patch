+// What ga2_vu1_gen decides about a code image, shared with the differential
+// fuzzer (ga2_vu1_fuzz) so both run the same analysis: flag liveness, what can
+// be pending when a pair starts, branch targets and the statically scheduled
+// blocks of a chunk.
+#pragma once
+#include "runtime/ps2_vu1.h"
+#include "runtime/ps2_vu1_reach.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace ga2_vu1plan
+{
+using VU = VU1Interpreter;
+
+// Which FMAC flag results can any instruction observe? (Whole-program.)
+//
+// Status: only FSAND/FSEQ/FSOR read it, so it is dead everywhere unless the
+// image contains one. MAC: FMAND/FMEQ/FMOR read the MAC of the latest FMAC
+// result whose 4-cycle latency has elapsed. A result p is dead when, on
+// every path, a later flag-producing instruction q is at least 4 pairs (so at
+// least 4 cycles) old at the reader: q's result is then visible and replaces
+// p's, whatever follows q. At a program end (E bit, or a D/T halt, which
+// may also not halt) the pipelines drain and only the last result survives. Indirect jumps lead
+// anywhere, so they count as readers. Values are unaffected: only flag
+// bookkeeping is skipped.
+// inSet (entry programs): only these pairs are known; leaving them counts
+// as reaching any reader.
+inline std::vector<uint8_t> flagModes(const std::vector<uint8_t> &code, const std::vector<uint8_t> *inSet = nullptr)
+{
+    const uint32_t pairs = static_cast<uint32_t>(code.size() / 8u);
+    auto word = [&](uint32_t index, uint32_t half) {
+        uint32_t w = 0;
+        std::memcpy(&w, code.data() + index * 8u + half * 4u, 4);
+        return w;
+    };
+    constexpr int kEnd = -1, kAnywhere = -2;
+    std::vector<bool> macReader(pairs), statusReader(pairs), producer(pairs), haltPair(pairs);
+    std::vector<bool> clipReader(pairs), clipProducer(pairs), clipElidable(pairs);
+    bool statusRead = false;
+    // Control flow over pairs, in two flavours: a pair entered as the delay
+    // slot of the branch (or E bit) before it (1), and a pair entered any other
+    // way (0, by a jump to it). Their successors differ: a delay slot goes where
+    // the branch goes (or ends the program), any other pair to the next one.
+    // Node = 2 * pair + flavour.
+    enum BranchKind : uint8_t { kNoBranch, kDirect, kConditional, kIndirect };
+    std::vector<uint8_t> branchKind(pairs, kNoBranch);
+    std::vector<bool> eBit(pairs);
+    for (uint32_t i = 0; i < pairs; ++i)
+    {
+        const uint32_t lower = word(i, 0), upper = word(i, 1);
+        const bool iBit = (upper >> 31) != 0u;
+        producer[i] = VU::upperProducesFmacFlags(upper);
+        const uint32_t op = lower >> 25;
+        eBit[i] = ((upper >> 30) & 1u) != 0u;
+        // A D/T halt can end the run here: the pipelines drain, so what
+        // survives is the last result, as at an E bit (a later run or MSCAL
+        // may read MAC first).
+        haltPair[i] = ((upper >> 27) & 3u) != 0u;
+        // CLIP (upper); FCSET (lower) also writes the clip register.
+        clipElidable[i] = (upper & 0x3Cu) == 0x3Cu && ((upper & 3u) | ((upper >> 4) & 0x7Cu)) == 0x1Fu;
+        clipProducer[i] = clipElidable[i] || (!iBit && op == 0x11u);
+        if (!iBit)
+        {
+            clipReader[i] = op == 0x10u || op == 0x12u || op == 0x13u || op == 0x1Cu; // FCEQ, FCAND, FCOR, FCGET
+            macReader[i] = op == 0x18u || op == 0x1Au || op == 0x1Bu; // FMEQ, FMAND, FMOR
+            statusReader[i] = op == 0x14u || op == 0x16u || op == 0x17u; // FSEQ, FSAND, FSOR
+            statusRead = statusRead || statusReader[i];
+            if (op == 0x24u || op == 0x25u)
+                branchKind[i] = kIndirect;
+            else if (op == 0x20u || op == 0x21u)
+                branchKind[i] = kDirect;
+            else if (op >= 0x28u && op <= 0x2Fu && op != 0x2Au && op != 0x2Bu)
+                branchKind[i] = kConditional;
+        }
+    }
+    std::vector<std::vector<int>> succ(2u * pairs);
+    // The pair after i, as entered from it.
+    auto nextAfter = [&](uint32_t i) {
+        return static_cast<int>(2u * ((i + 1u) % pairs) + ((branchKind[i] != kNoBranch || eBit[i]) ? 1u : 0u));
+    };
+    for (uint32_t i = 0; i < pairs; ++i)
+    {
+        succ[2u * i] = {nextAfter(i)};
+        const uint32_t before = (i + pairs - 1u) % pairs;
+        if (eBit[before]) // E bit: its delay slot ends the program
+            succ[2u * i + 1u] = {kEnd};
+        else if (branchKind[before] == kIndirect)
+            succ[2u * i + 1u] = {kAnywhere};
+        else if (branchKind[before] != kNoBranch)
+        {
+            const uint32_t lower = word(before, 0);
+            int32_t imm = static_cast<int32_t>(lower & 0x7FFu);
+            if (imm & 0x400) imm -= 0x800;
+            const uint32_t target = static_cast<uint32_t>((static_cast<int64_t>(before) + 1 + imm + pairs) % pairs);
+            succ[2u * i + 1u] = {static_cast<int>(2u * target)};
+            if (branchKind[before] == kConditional)
+                succ[2u * i + 1u].push_back(nextAfter(i));
+        }
+        else
+            succ[2u * i + 1u] = succ[2u * i]; // not entered this way
+    }
+    if (inSet)
+        for (auto &list : succ)
+            for (int &n : list)
+                if (n >= 0 && !(*inSet)[static_cast<uint32_t>(n) / 2u])
+                    n = kAnywhere;
+    // GA2_VU1GEN_ALLFLAGS=1: keep every flag result (a strict oracle build
+    // for digest-mode replay).
+    if (const char *all = std::getenv("GA2_VU1GEN_ALLFLAGS"); all && *all == '1')
+        return std::vector<uint8_t>(pairs, VU::kFlagAll);
+    std::vector<uint8_t> modes(pairs, statusRead ? VU::kFlagStatus : 0u);
+    // Whether the result of pair p (a producer) can be read by anything:
+    // `reader` pairs read the register, `producer` pairs overwrite it.
+    auto observable = [&](uint32_t p, const std::vector<bool> &producerOf, const std::vector<bool> &reader) {
+        // A halt can end the run right after the pair, or after the delay slot that follows a
+        // halting branch: the last result survives.
+        if (haltPair[p] || haltPair[(p + pairs - 1u) % pairs])
+            return true;
+        // State: pairs since the first later producer (-1: none yet).
+        std::vector<uint8_t> seen(2u * pairs * 6u, 0);
+        std::vector<std::pair<int, int>> stack;
+        for (int n : succ[2u * p])
+            stack.emplace_back(n, -1);
+        const uint32_t before = (p + pairs - 1u) % pairs;
+        if (eBit[before] || branchKind[before] != kNoBranch) // p may be a delay slot
+            for (int n : succ[2u * p + 1u])
+                stack.emplace_back(n, -1);
+        while (!stack.empty())
+        {
+            auto [node, since] = stack.back();
+            stack.pop_back();
+            if (since >= 4)
+                continue;                       // superseded for every later reader
+            if (node == kAnywhere)
+                return true;
+            if (node == kEnd)
+            {
+                if (since < 0)
+                    return true;                // the end keeps the last result
+                continue;
+            }
+            const uint32_t n = static_cast<uint32_t>(node) / 2u;
+            if (reader[n])
+                return true;
+            // A D/T halt ends the run only when the unit has the bit enabled: the
+            // pipelines drain and the last result survives (if the halt pair's own
+            // result is not the last one). Otherwise the run goes on.
+            if (haltPair[n] && since < 0 && !producerOf[n])
+                return true;
+            if (seen[static_cast<uint32_t>(node) * 6u + static_cast<uint32_t>(since + 1)]++)
+                continue;
+            // Age of the first later producer: once it is four pairs old
+            // its result is visible to every reader and hides p's.
+            const int next = since >= 0 ? since + 1 : (producerOf[n] ? 1 : -1);
+            for (int s : succ[static_cast<uint32_t>(node)])
+                stack.emplace_back(s, next);
+        }
+        return false;
+    };
+    for (uint32_t p = 0; p < pairs; ++p)
+    {
+        if (producer[p] && observable(p, producer, macReader))
+            modes[p] |= VU::kFlagMac;
+        if (clipElidable[p] && observable(p, clipProducer, clipReader))
+            modes[p] |= VU::kFlagClip;
+    }
+    return modes;
+}
+
+// What can be pending when a pair starts (see VU1Interpreter::PairEntry).
+// A pending branch is consumed by the branch's image successor (its delay
+// slot). The E bit and halt bits act after the pair that follows them, so
+// with a branch before them they take effect at the branch's destination:
+// its target, its fall-through, or (for JR/JALR) anywhere.
+struct EntryFacts
+{
+    std::vector<bool> mayBranch, mayEnd, mayHalt;
+};
+
+inline EntryFacts entryFacts(const std::vector<uint8_t> &code)
+{
+    const uint32_t pairs = static_cast<uint32_t>(code.size() / 8u);
+    auto word = [&](uint32_t index, uint32_t half) {
+        uint32_t w = 0;
+        std::memcpy(&w, code.data() + (index % pairs) * 8u + half * 4u, 4);
+        return w;
+    };
+    auto isBranch = [&](uint32_t index) {
+        const uint32_t lower = word(index, 0), upper = word(index, 1), op = lower >> 25;
+        return (upper >> 31) == 0u &&
+               (op == 0x20u || op == 0x21u || op == 0x24u || op == 0x25u || (op >= 0x28u && op <= 0x2Fu));
+    };
+    EntryFacts f{std::vector<bool>(pairs), std::vector<bool>(pairs), std::vector<bool>(pairs)};
+    for (uint32_t i = 0; i < pairs; ++i)
+    {
+        const uint32_t prev = (i + pairs - 1u) % pairs;
+        f.mayBranch[i] = isBranch(prev);
+        f.mayEnd[i] = ((word(prev, 1) >> 30) & 1u) != 0u;
+        f.mayHalt[i] = ((word(prev, 1) >> 27) & 3u) != 0u; // D (bit 28), T (bit 27)
+    }
+    for (uint32_t b = 0; b < pairs; ++b)
+    {
+        if (!isBranch(b))
+            continue;
+        const uint32_t slotUpper = word(b + 1u, 1);
+        const bool end = ((slotUpper >> 30) & 1u) != 0u, halt = ((slotUpper >> 27) & 3u) != 0u;
+        if (!end && !halt)
+            continue;
+        const uint32_t op = word(b, 0) >> 25;
+        std::vector<uint32_t> targets;
+        if (op == 0x24u || op == 0x25u)
+            for (uint32_t t = 0; t < pairs; ++t)
+                targets.push_back(t);
+        else
+        {
+            int32_t imm = static_cast<int32_t>(word(b, 0) & 0x7FFu);
+            if (imm & 0x400) imm -= 0x800;
+            targets.push_back(static_cast<uint32_t>((static_cast<int64_t>(b) + 1 + imm + pairs) % pairs));
+            targets.push_back((b + 2u) % pairs);
+        }
+        for (uint32_t t : targets)
+        {
+            f.mayEnd[t] = f.mayEnd[t] || end;
+            f.mayHalt[t] = f.mayHalt[t] || halt;
+        }
+    }
+    return f;
+}
+
+// Pairs that direct branches jump to. Control enters a block there, so a
+// block starts at each of them rather than running across one.
+inline std::vector<bool> branchTargets(const std::vector<uint8_t> &code)
+{
+    const uint32_t pairs = static_cast<uint32_t>(code.size() / 8u);
+    std::vector<bool> target(pairs, false);
+    for (uint32_t b = 0; b < pairs; ++b)
+    {
+        const uint32_t lower = ps2_vu1_reach::word(code.data(), b, 0), upper = ps2_vu1_reach::word(code.data(), b, 1);
+        if ((upper >> 31) != 0u || !ps2_vu1_reach::isDirectBranch(lower >> 25))
+            continue;
+        int32_t imm = static_cast<int32_t>(lower & 0x7FFu);
+        if (imm & 0x400) imm -= 0x800;
+        target[static_cast<uint32_t>((static_cast<int64_t>(b) + 1 + imm + pairs) % pairs)] = true;
+    }
+    return target;
+}
+
+
+// A statically scheduled block starting at a chunk pair (see ps2_vu1.h).
+struct Block
+{
+    uint32_t first = 0;
+    std::vector<uint32_t> pairs;
+    bool endsInBranch = false; // the last two pairs are a branch and its delay slot
+    VU::BlockSchedule schedule;
+};
+
+
+// Blocks of one chunk (ascending pair indices ch, their decoded pairs):
+// runs of consecutive pairs that fall through to each other, with nothing
+// pending from a branch, E bit or halt, entered only at their first pair (so
+// split at branch targets). A block may end with a branch and its delay slot.
+inline std::unordered_map<uint32_t, Block> planBlocks(const std::vector<uint32_t> &ch,
+                                                      const std::vector<VU::DecodedInstructionPair> &decoded,
+                                                      const EntryFacts &facts, const std::vector<bool> &isTarget,
+                                                      uint32_t pairs)
+{
+    std::unordered_map<uint32_t, Block> blockAt;
+    // A pair may be entered with nothing pending from the pair before it.
+    auto clean = [&](size_t k) {
+        const uint32_t index = ch[k];
+        return index + 1u < pairs && !facts.mayEnd[index] && !facts.mayHalt[index];
+    };
+    auto inBlock = [&](size_t k) { return clean(k) && !facts.mayBranch[ch[k]] && VU::blockablePair(decoded[k]); };
+    // A block may end with a branch and its delay slot.
+    auto branchPair = [&](size_t k) { return clean(k) && !facts.mayBranch[ch[k]] && VU::blockableBranchPair(decoded[k]); };
+    auto slotPair = [&](size_t k) { return clean(k) && VU::blockablePair(decoded[k]); };
+    auto follows = [&](size_t e) { return e < ch.size() && ch[e] == ch[e - 1] + 1u && !isTarget[ch[e]]; };
+    for (size_t k = 0; k < ch.size();)
+    {
+        size_t e = k;
+        if (inBlock(k))
+        {
+            ++e;
+            while (e - k < VU::kMaxBlockPairs - 2u && follows(e) && inBlock(e))
+                ++e;
+        }
+        bool branchEnd = false;
+        if (e < ch.size() && (e == k || follows(e)) && branchPair(e) && follows(e + 1u) && slotPair(e + 1u))
+        {
+            e += 2u;
+            branchEnd = true;
+        }
+        if (e == k)
+        {
+            ++k;
+            continue;
+        }
+        if (e - k >= 2u)
+        {
+            Block b;
+            b.first = ch[k];
+            b.endsInBranch = branchEnd;
+            b.pairs.assign(ch.begin() + static_cast<long>(k), ch.begin() + static_cast<long>(e));
+            if (VU::scheduleBlockForCodegen(decoded.data() + k, static_cast<uint32_t>(e - k), b.schedule))
+                blockAt.emplace(b.first, std::move(b));
+        }
+        k = e;
+    }
+    return blockAt;
+}
