 namespace ga2_vu1
 {
+    // Copies one lane as bits. VU registers also hold integers, whose patterns
+    // include signaling NaNs; compilers merge neighbouring float lane copies
+    // into vector arithmetic (a multiply by 1.0 for the lane that is only
+    // copied), which would quiet them.
+    __attribute__((always_inline)) inline void copyLane(float *dst, const float *src)
+    {
+        uint32_t bits;
+        __builtin_memcpy(&bits, src, sizeof(bits));
+        __builtin_memcpy(dst, &bits, sizeof(bits));
+    }
+
     // VU operand rule for four lanes at once (VU1Interpreter::normalizeOperand):
     // denormals read as signed zero, Inf/NaN as signed max. Branchless.
     __attribute__((always_inline)) inline void normalizeOperands4(const float *in, float *out)
@@ -46,6 +57,87 @@ namespace ga2_vu1
         }
 #endif
     }
+
+#if defined(__SSE2__)
+    // Four 32-bit lanes from the high dwords of two double pairs (sign and
+    // all-ones compare masks live there).
+    __attribute__((always_inline)) inline __m128i packHigh(__m128d lo, __m128d hi)
+    {
+        return _mm_castps_si128(_mm_shuffle_ps(_mm_castpd_ps(lo), _mm_castpd_ps(hi), _MM_SHUFFLE(3, 1, 3, 1)));
+    }
+
+    // The component-order bit mask (x in bit 0) of the all-ones lanes of m, and the
+    // same in the order of the MAC/dest bits (x in bit 3).
+    __attribute__((always_inline)) inline int componentBits(__m128i m) { return _mm_movemask_ps(_mm_castsi128_ps(m)); }
+    __attribute__((always_inline)) inline int laneBits(__m128i m)
+    {
+        return _mm_movemask_ps(_mm_castsi128_ps(_mm_shuffle_epi32(m, _MM_SHUFFLE(0, 1, 2, 3))));
+    }
+    __attribute__((always_inline)) inline int componentDestBits(uint8_t dest)
+    {
+        return ((dest >> 3) & 1) | ((dest >> 1) & 2) | ((dest << 1) & 4) | ((dest << 3) & 8);
+    }
+
+    // Whether every lane of dest in an FMAC result has a biased exponent in
+    // [lo, hi]. A single-rounding result (sum, difference, product) in
+    // [1, 253] is a normal number whose exact value is one too, and needs no
+    // clamping and has only a sign flag. A product-sum result is computed in
+    // float with two roundings, which agrees when in [61, 253] and the
+    // product itself did not saturate (see productSumUnsaturated).
+    __attribute__((always_inline)) inline bool lanesInRange(const float *result, uint8_t dest, int lo, int hi)
+    {
+        const __m128i bits = _mm_loadu_si128(reinterpret_cast<const __m128i *>(result));
+        const __m128i e = _mm_and_si128(_mm_srli_epi32(bits, 23), _mm_set1_epi32(0xFF));
+        const __m128i ok = _mm_and_si128(_mm_cmpgt_epi32(e, _mm_set1_epi32(lo - 1)), _mm_cmpgt_epi32(_mm_set1_epi32(hi + 1), e));
+        return (~componentBits(ok) & componentDestBits(dest)) == 0;
+    }
+
+    // Whether no lane of dest in the product vs * b of a product-sum has a magnitude
+    // of 2^127 or more (judged from the operands' exponents; the float multiply
+    // saturates at FLT_MAX, which hides an overflow that the exact sum shows).
+    __attribute__((always_inline)) inline bool productSumUnsaturated(const float *vs, const float *b, uint8_t dest)
+    {
+        const __m128i evs = _mm_and_si128(_mm_srli_epi32(_mm_loadu_si128(reinterpret_cast<const __m128i *>(vs)), 23), _mm_set1_epi32(0xFF));
+        const __m128i eb = _mm_and_si128(_mm_srli_epi32(_mm_loadu_si128(reinterpret_cast<const __m128i *>(b)), 23), _mm_set1_epi32(0xFF));
+        const __m128i ok = _mm_cmpgt_epi32(_mm_set1_epi32(380), _mm_add_epi32(evs, eb));
+        return (~componentBits(ok) & componentDestBits(dest)) == 0;
+    }
+
+    struct ExactClasses
+    {
+        __m128i zero, over, under, sign; // all-ones lanes, component order
+    };
+
+    // Classifies four exact (double) FMAC results as normalizeFmacExactResult
+    // does, and fixes the float results of the lanes in dest accordingly
+    // (zero and underflow -> signed zero, overflow -> signed FLT_MAX). Returns
+    // false, changing nothing, when a lane in dest is exactly FLT_MAX: the
+    // double may hide an overflow there and the caller decides precisely.
+    __attribute__((always_inline)) inline bool classifyExact(__m128d exactLo, __m128d exactHi, uint8_t dest, float *result,
+                                                             ExactClasses &c)
+    {
+        const __m128d absMask = _mm_castsi128_pd(_mm_set1_epi64x(0x7FFFFFFFFFFFFFFFll));
+        const __m128d maxD = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::max()));
+        const __m128d minD = _mm_set1_pd(static_cast<double>(std::numeric_limits<float>::min()));
+        const __m128d absLo = _mm_and_pd(exactLo, absMask), absHi = _mm_and_pd(exactHi, absMask);
+        const int destLanes = componentDestBits(dest);
+        const __m128i atMax = packHigh(_mm_cmpeq_pd(absLo, maxD), _mm_cmpeq_pd(absHi, maxD));
+        if ((componentBits(atMax) & destLanes) != 0)
+            return false;
+        c.zero = packHigh(_mm_cmpeq_pd(exactLo, _mm_setzero_pd()), _mm_cmpeq_pd(exactHi, _mm_setzero_pd()));
+        c.over = packHigh(_mm_cmpgt_pd(absLo, maxD), _mm_cmpgt_pd(absHi, maxD));
+        c.under = _mm_andnot_si128(c.zero, packHigh(_mm_cmplt_pd(absLo, minD), _mm_cmplt_pd(absHi, minD)));
+        c.sign = _mm_and_si128(packHigh(exactLo, exactHi), _mm_set1_epi32(static_cast<int>(0x80000000u)));
+        const __m128i toZero = _mm_or_si128(c.zero, c.under);
+        const __m128i fixed = _mm_or_si128(_mm_and_si128(toZero, c.sign),
+                                           _mm_and_si128(c.over, _mm_or_si128(c.sign, _mm_set1_epi32(0x7F7FFFFF))));
+        const __m128i laneSelect = _mm_set_epi32(dest & 1 ? -1 : 0, dest & 2 ? -1 : 0, dest & 4 ? -1 : 0, dest & 8 ? -1 : 0);
+        const __m128i change = _mm_and_si128(_mm_or_si128(toZero, c.over), laneSelect);
+        const __m128i r = _mm_loadu_si128(reinterpret_cast<const __m128i *>(result));
+        _mm_storeu_si128(reinterpret_cast<__m128i *>(result), _mm_or_si128(_mm_andnot_si128(change, r), _mm_and_si128(change, fixed)));
+        return true;
+    }
+#endif
 }
