+        if (code == 0x1Cu)
+            return {true, 1u, 0u};
+        if (code == 0x1Eu)
+            return {true, 2u, 0u};
+        if (code == 0x2Au)
+            return {true, 3u, 0u};
+        if (op >= 0x3Cu && code == 0x2Eu)
+            return {true, 4u, 0u};
