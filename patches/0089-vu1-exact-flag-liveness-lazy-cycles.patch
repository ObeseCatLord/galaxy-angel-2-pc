+// Differential fuzzer for the VU1 interpreter and the generated VU1 programs.
+//
+//   ga2_vu1_fuzz emit <dir> <images> <seed> [maxPairs [--flagheavy]]
+//       Writes random 16 KB code images (<hash>.bin) and the entry pairs to
+//       run them from (<hash>.entries) into <dir>.
+//   ga2_vu1_fuzz run <dir> <statesPerImage> [seed] [--lines] [--flags <mode>]
+//       Runs every image of <dir> from random machine states (registers,
+//       flags, data memory with GIF packets) and compares the runtime, with
+//       the generated programs linked into this binary, against its
+//       interpreter: state, VU memory, GIF packets, cycles. The status flag is
+//       only compared in images that read it, and MAC and CLIP results only
+//       when a run ended (the same promise as ga2_vu1_check --reference). A run
+//       with a small cycle budget is sometimes resumed. FUZZ_MAXREPORT=<n>
+//       lists n mismatches (default 20); FUZZ_TRACE=<image>:<state> lists the
+//       pairs the interpreter ran for one state.
+//       --lines prints one digest line per run of the interpreter (the oracle),
+//       to compare two builds of the interpreter: diff the outputs.
+//       --flags <mode> runs the candidate as an interpreter computing only
+//       that set of flag results (1 MAC, 2 status, 4 CLIP), which exercises
+//       the paths generated programs use when flags are dead.
+//   ga2_vu1_fuzz list <image.bin>
+//       The pairs of an image with the generator's flag modes.
+//
+// Testing generated programs: emit images, run ga2_vu1_gen <outdir> <dir>/*.bin
+// (the .entries files make them entry programs), compile the output and link
+// it with this file's object (ga2_vu1_programs in the native build does that
+// for the game's programs), then run. GA2_VU1GEN_CHUNKPAIRS=10 while
+// generating splits the small programs into several chunk functions, which
+// tests the hand-over between chunks.
+//
+// The programs are random but valid (no reserved instructions), with branches
+// that stay inside the program, E bits and D/T halts, XGKICK packets, flag
+// readers and writers, FDIV/EFU operations and operands from every float
+// class (zero, denormal, Inf/NaN, FLT_MAX, FLT_MIN neighbourhoods).
+#include "ga2_vu1_capture.h"
+#include "ga2_vu1_plan.h"
+#include "runtime/ps2_vu1_reach.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+
+namespace
+{
+    using VU = VU1Interpreter;
+
+    struct Rng
+    {
+        uint64_t s;
+        explicit Rng(uint64_t seed)
+        {
+            // splitmix64 to spread nearby seeds
+            uint64_t z = seed + 0x9E3779B97F4A7C15ull;
+            z = (z ^ (z >> 30)) * 0xBF58476D1CE4E5B9ull;
+            z = (z ^ (z >> 27)) * 0x94D049BB133111EBull;
+            s = (z ^ (z >> 31)) | 1ull;
+        }
+        uint64_t next()
+        {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            return s;
+        }
+        uint32_t u32() { return static_cast<uint32_t>(next() >> 24); }
+        uint32_t below(uint32_t n) { return n ? u32() % n : 0u; }
+        bool chance(uint32_t percent) { return below(100) < percent; }
+        template <typename T, size_t N>
+        T pick(const T (&a)[N]) { return a[below(static_cast<uint32_t>(N))]; }
+    };
+
+    uint32_t randFloatBits(Rng &r)
+    {
+        const uint32_t sign = r.chance(50) ? 0x80000000u : 0u;
+        const uint32_t mant = r.u32() & 0x7FFFFFu;
+        switch (r.below(24))
+        {
+        case 0: case 1: case 2: case 3: case 4: case 5: case 6: case 7: case 8: case 9: case 10:
+            return sign | ((100u + r.below(55u)) << 23) | mant; // moderate magnitudes
+        case 11: return sign;                                              // zero
+        case 12: return sign | (r.chance(50) ? (mant & 0xFFu) : mant);   // denormal (or zero)
+        case 13: return sign | 0x7F800000u | (r.chance(50) ? 0u : mant);   // Inf/NaN
+        case 14: return sign | 0x7F7FFFFFu - r.below(4);                  // FLT_MAX
+        case 15: return sign | 0x00800000u + r.below(4);                  // FLT_MIN
+        case 16: { static const float v[] = {1.0f, 2.0f, 0.5f, 3.0f, 4.0f, 16.0f, 255.0f, 4096.0f, 0.25f};
+                   float f = v[r.below(9)]; uint32_t b; std::memcpy(&b, &f, 4); return sign | (b & 0x7FFFFFFFu); }
+        case 17: return r.u32();                                           // any bits
+        case 18: return sign | ((1u + r.below(254u)) << 23) | mant;        // any normal exponent
+        case 19: return sign | ((253u + r.below(2u)) << 23) | mant;        // overflow neighbourhood
+        case 20: return sign | ((1u + r.below(3u)) << 23) | mant;          // underflow neighbourhood
+        case 21: return sign | ((126u + r.below(3u)) << 23) | mant;
+        default: return sign | ((110u + r.below(36u)) << 23) | mant;
+        }
+    }
+
+    uint32_t randIntReg(Rng &r, uint32_t pairs)
+    {
+        switch (r.below(8))
+        {
+        case 0: return r.u32() & 0xFFFFu;
+        case 1: return static_cast<uint32_t>(static_cast<int32_t>(static_cast<int16_t>(r.u32())));
+        case 2: return r.below(4u);
+        default: return r.below(pairs + 4u);
+        }
+    }
+
+    // ---- Programs
+
+    struct Prog
+    {
+        std::vector<uint8_t> code;
+        std::vector<uint32_t> entries;
+        uint32_t pairs = 0;
+    };
+
+    uint32_t vfReg(Rng &r)
+    {
+        if (r.chance(75))
+            return r.below(8u);
+        return r.below(32u);
+    }
+    uint32_t viReg(Rng &r) { return r.chance(80) ? r.below(8u) : r.below(16u); }
+    uint32_t destMask(Rng &r)
+    {
+        if (r.chance(4)) return 0u;
+        if (r.chance(35)) return 0xFu;
+        return r.below(16u);
+    }
+    uint32_t imm11(int32_t v) { return static_cast<uint32_t>(v) & 0x7FFu; }
+
+    // flagHeavy: mostly FMAC arithmetic and MAC/clip readers, in short programs (flag-result checks).
+    uint32_t upperWord(Rng &r, bool flagHeavy)
+    {
+        const uint32_t dest = destMask(r), ft = vfReg(r), fs = vfReg(r), fd = vfReg(r);
+        const uint32_t common = (dest << 21) | (ft << 16) | (fs << 11);
+        const uint32_t kind = flagHeavy ? r.below(100) * 85 / 100 : r.below(100);
+        if (kind < 38)
+        {
+            static const uint32_t ops[] = {
+                0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
+                0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
+                0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2B, 0x2C, 0x2D, 0x2E, 0x2F,
+                // arithmetic is the interesting part
+                0x00, 0x03, 0x07, 0x0B, 0x0F, 0x18, 0x1A, 0x1C, 0x21, 0x28, 0x29, 0x2A, 0x2C, 0x2D, 0x2E};
+            return common | (fd << 6) | r.pick(ops);
+        }
+        if (kind < 78)
+        {
+            static const uint32_t specials[] = {
+                0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07, 0x08, 0x09, 0x0A, 0x0B, 0x0C, 0x0D, 0x0E, 0x0F,
+                0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17, 0x18, 0x19, 0x1A, 0x1B, 0x1C, 0x1D, 0x1E, 0x1F,
+                0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27, 0x28, 0x29, 0x2A, 0x2C, 0x2D, 0x2E,
+                0x1F, 0x1F, 0x1F, 0x08, 0x0B, 0x29, 0x2A, 0x14, 0x10, 0x1D};
+            const uint32_t sp = r.pick(specials);
+            return common | ((sp >> 2) << 6) | 0x3Cu | (sp & 3u);
+        }
+        return 0x000002FFu; // NOP
+    }
+
+    uint32_t specialLower(uint32_t dest, uint32_t ft, uint32_t fs, uint32_t sp)
+    {
+        return (0x40u << 25) | (dest << 21) | (ft << 16) | (fs << 11) | ((sp >> 2) << 6) | 0x3Cu | (sp & 3u);
+    }
+
+    bool isBranchLower(uint32_t lower)
+    {
+        const uint32_t op = lower >> 25;
+        return op == 0x20u || op == 0x21u || op == 0x24u || op == 0x25u || (op >= 0x28u && op <= 0x2Fu && op != 0x2Au && op != 0x2Bu);
+    }
+
+    uint32_t lowerWord(Rng &r, uint32_t pairs, uint32_t index, bool branchOk, bool flagHeavy)
+    {
+        const uint32_t dest = destMask(r), ft = vfReg(r), fs = vfReg(r);
+        const uint32_t it = viReg(r), is = viReg(r), id = viReg(r);
+        const uint32_t mem = r.below(64u);
+        const int32_t memImm = static_cast<int32_t>(r.below(8u)) - 3;
+        uint32_t kind = r.below(100);
+        if (flagHeavy && kind >= 30 && kind < 62)
+            kind = 50 + r.below(12u); // flag readers
+        else if (flagHeavy && kind >= 62)
+            kind = r.below(30u);
+        if (kind < 16) // NOP
+            return r.chance(70) ? 0x8000033Cu : 0u;
+        if (kind < 30)
+        {
+            switch (r.below(8))
+            {
+            case 0: return (0x00u << 25) | (dest << 21) | (ft << 16) | (is << 11) | imm11(static_cast<int32_t>(mem) % 32 - 4); // LQ
+            case 1: return (0x01u << 25) | (dest << 21) | (it << 16) | (fs << 11) | imm11(static_cast<int32_t>(mem) % 32 - 4); // SQ
+            case 2: return (0x04u << 25) | (dest << 21) | (it << 16) | (is << 11) | imm11(memImm);                    // ILW
+            case 3: return (0x05u << 25) | (dest << 21) | (it << 16) | (is << 11) | imm11(memImm);                    // ISW
+            case 4: return specialLower(dest, ft, is, 0x34); // LQI
+            case 5: return specialLower(dest, it, fs, 0x35); // SQI
+            case 6: return specialLower(dest, ft, is, 0x36); // LQD
+            default: return specialLower(dest, it, fs, 0x37); // SQD
+            }
+        }
+        if (kind < 48) // integer
+        {
+            switch (r.below(9))
+            {
+            case 0: return (0x08u << 25) | ((r.below(16u)) << 21) | (it << 16) | (is << 11) | (r.u32() & 0x7FFu); // IADDIU
+            case 1: return (0x09u << 25) | ((r.below(16u)) << 21) | (it << 16) | (is << 11) | (r.u32() & 0x7FFu); // ISUBIU
+            case 2: return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | 0x30u; // IADD
+            case 3: return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | 0x31u; // ISUB
+            case 4: return (0x40u << 25) | (it << 16) | (is << 11) | ((r.u32() & 0x1Fu) << 6) | 0x32u; // IADDI
+            case 5: return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | 0x34u; // IAND
+            case 6: return (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | 0x35u; // IOR
+            case 7: return specialLower(r.below(16u), it, fs, 0x3C); // MTIR
+            default: return specialLower(dest, ft, is, 0x3D); // MFIR
+            }
+        }
+        if (kind < 62) // flag access
+        {
+            switch (r.below(12))
+            {
+            case 0: return (0x10u << 25) | (r.u32() & 0xFFFFFFu);                  // FCEQ
+            case 1: return (0x11u << 25) | (r.u32() & 0xFFFFFFu);                  // FCSET
+            case 2: return (0x12u << 25) | (r.u32() & 0xFFFFFFu);                  // FCAND
+            case 3: return (0x13u << 25) | (r.u32() & 0xFFFFFFu);                  // FCOR
+            case 4: return (0x14u << 25) | ((r.below(2u)) << 21) | (it << 16) | (r.u32() & 0x7FFu);  // FSEQ
+            case 5: return (0x15u << 25) | ((r.below(2u)) << 21) | (r.u32() & 0x7FFu);               // FSSET
+            case 6: return (0x16u << 25) | ((r.below(2u)) << 21) | (it << 16) | (r.u32() & 0x7FFu);  // FSAND
+            case 7: return (0x17u << 25) | ((r.below(2u)) << 21) | (it << 16) | (r.u32() & 0x7FFu);  // FSOR
+            case 8: return (0x18u << 25) | (it << 16) | (is << 11);                // FMEQ
+            case 9: return (0x1Au << 25) | (it << 16) | (is << 11);                // FMAND
+            case 10: return (0x1Bu << 25) | (it << 16) | (is << 11);               // FMOR
+            default: return (0x1Cu << 25) | (it << 16);                            // FCGET
+            }
+        }
+        if (kind < 74) // vector moves, R/P
+        {
+            switch (r.below(10))
+            {
+            case 0: case 1: return specialLower(dest, ft, fs, 0x30);  // MOVE
+            case 2: return specialLower(dest, ft, fs, 0x31);          // MR32
+            case 3: return specialLower(dest, ft, fs, 0x40);          // RNEXT
+            case 4: return specialLower(dest, ft, fs, 0x41);          // RGET
+            case 5: return specialLower(dest, ft, fs, 0x42) | (r.below(4u) << 21); // RINIT
+            case 6: return specialLower(dest, ft, fs, 0x43) | (r.below(4u) << 21); // RXOR
+            case 7: return specialLower(dest, ft, fs, 0x64);          // MFP
+            case 8: return specialLower(dest, it, fs, 0x68 + r.below(2u)); // XTOP/XITOP
+            default: return specialLower(dest, it, is, 0x3E + r.below(2u)); // ILWR/ISWR
+            }
+        }
+        if (kind < 84) // FDIV / EFU
+        {
+            const uint32_t fsf = r.below(4u) << 21, ftf = r.below(4u) << 23;
+            static const uint32_t efu[] = {0x70, 0x71, 0x72, 0x73, 0x74, 0x75, 0x76, 0x77, 0x78, 0x79, 0x7A, 0x7C, 0x7D, 0x7B};
+            switch (r.below(8))
+            {
+            case 0: return specialLower(0, ft, fs, 0x38) | fsf | ftf;
+            case 1: return specialLower(0, ft, fs, 0x39) | ftf;
+            case 2: return specialLower(0, ft, fs, 0x3A) | fsf | ftf;
+            case 3: return specialLower(0, ft, fs, 0x3B); // WAITQ
+            default: return specialLower(0, ft, fs, r.pick(efu)) | fsf;
+            }
+        }
+        if (kind < 87) // XGKICK
+            return specialLower(0, 0, 0, 0x6C) | (is << 11);
+        if (!branchOk)
+            return r.chance(50) ? 0x8000033Cu : (0x40u << 25) | (it << 16) | (is << 11) | (id << 6) | 0x30u;
