+        case 3: return (0x25u << 25) | (it << 16) | (is << 11);              // JALR
+        case 4: return (0x28u << 25) | (it << 16) | (is << 11) | imm;        // IBEQ
+        case 5: return (0x29u << 25) | (it << 16) | (is << 11) | imm;        // IBNE
+        case 6: return (0x2Cu << 25) | (is << 11) | imm;                     // IBLTZ
+        case 7: return (0x2Du << 25) | (is << 11) | imm;                     // IBGTZ
+        case 8: return (0x2Eu << 25) | (is << 11) | imm;                     // IBLEZ
+        default: return (0x2Fu << 25) | (is << 11) | imm;                    // IBGEZ
+        }
+    }
+
+    Prog makeProgram(Rng &r, uint32_t maxPairs, bool flagHeavy)
+    {
+        Prog p;
+        p.code.assign(0x4000u, 0u);
+        p.pairs = 12u + r.below(maxPairs > 12u ? maxPairs - 11u : 1u);
+        bool prevBranch = false, prevEnd = false;
+        const bool withEnd = true; // a program that falls off its end would run through all of code memory
+        for (uint32_t i = 0; i < p.pairs; ++i)
+        {
+            uint32_t upper = 0, lower = 0;
+            for (int attempt = 0; attempt < 32; ++attempt)
+            {
+                upper = upperWord(r, flagHeavy);
+                const bool iBit = r.chance(5);
+                if (iBit)
+                    upper |= 0x80000000u;
+                const bool last = i + 1u == p.pairs;
+                const bool endPair = withEnd && i + 2u == p.pairs;
+                lower = iBit ? randFloatBits(r) : lowerWord(r, p.pairs, i, !prevBranch && !prevEnd && !last && !endPair && i + 4u < p.pairs, flagHeavy);
+                if (!iBit && prevEnd && isBranchLower(lower))
+                    continue;
+                if (endPair)
+                    upper |= 0x40000000u; // E bit; the next pair is its delay slot
+                else if (r.chance(1))
+                    upper |= r.chance(50) ? 0x10000000u : 0x08000000u; // D / T
+                else if (r.chance(1) && !prevBranch && i + 3u < p.pairs && !isBranchLower(lower))
+                    upper |= 0x40000000u; // an early E bit
+                if (r.chance(3))
+                    upper |= 0x20000000u; // M
+                const VU::DecodedInstructionPair d = VU::decodeForCodegen(std::vector<uint8_t>{
+                    static_cast<uint8_t>(lower), static_cast<uint8_t>(lower >> 8), static_cast<uint8_t>(lower >> 16), static_cast<uint8_t>(lower >> 24),
+                    static_cast<uint8_t>(upper), static_cast<uint8_t>(upper >> 8), static_cast<uint8_t>(upper >> 16), static_cast<uint8_t>(upper >> 24)}.data(), 0u);
+                if (d.upperUsage.reserved || d.lowerUsage.reserved)
+                    continue;
+                break;
+            }
+            const bool branch = (upper >> 31) == 0u && isBranchLower(lower);
+            std::memcpy(p.code.data() + i * 8u, &lower, 4);
+            std::memcpy(p.code.data() + i * 8u + 4u, &upper, 4);
+            prevEnd = ((upper >> 30) & 1u) != 0u;
+            prevBranch = branch;
+        }
+        p.entries.push_back(0u);
+        if (r.chance(35))
+            p.entries.push_back(r.below(p.pairs));
+        return p;
+    }
+
+    // ---- Machine state
+
+    VU1State randomState(Rng &r, uint32_t pairs)
+    {
+        VU1State s{};
+        for (auto &reg : s.vf)
+            for (float &lane : reg)
+            {
+                const uint32_t b = randFloatBits(r);
+                std::memcpy(&lane, &b, 4);
+            }
+        s.vf[0][0] = s.vf[0][1] = s.vf[0][2] = 0.0f;
+        s.vf[0][3] = 1.0f;
+        for (int k = 1; k < 16; ++k)
+            s.vi[k] = static_cast<int32_t>(randIntReg(r, pairs));
+        s.vi[0] = 0;
+        for (float &lane : s.acc)
+        {
+            const uint32_t b = randFloatBits(r);
+            std::memcpy(&lane, &b, 4);
+        }
+        auto fl = [&r](float &f) { const uint32_t b = randFloatBits(r); std::memcpy(&f, &b, 4); };
+        fl(s.q);
+        fl(s.p);
+        fl(s.i);
+        s.r = 0x3F800000u | (r.u32() & 0x7FFFFFu);
+        s.mac = r.u32() & 0xFFFFu;
+        s.clip = r.u32() & 0xFFFFFFu;
+        s.status = r.u32() & 0xFFFu;
+        s.top = r.u32() & 0x3FFu;
+        s.itop = r.u32() & 0x3FFu;
+        s.dBitEnabled = r.chance(10);
+        s.tBitEnabled = r.chance(10);
+        return s;
+    }
+
+    void randomData(Rng &r, std::vector<uint8_t> &data)
+    {
+        data.resize(0x4000u);
+        for (size_t q = 0; q < data.size() / 16u; ++q)
+        {
+            uint32_t w[4];
+            if (r.chance(14))
+            {
+                // A GIF tag: small NLOOP, usually EOP, PACKED/REGLIST/IMAGE.
+                const uint64_t nloop = r.below(4u), eop = r.chance(80) ? 1u : 0u, nreg = r.below(16u), flg = r.below(3u);
+                const uint64_t lo = nloop | (eop << 15) | (flg << 58) | (nreg << 60);
+                w[0] = static_cast<uint32_t>(lo);
+                w[1] = static_cast<uint32_t>(lo >> 32);
+                w[2] = r.u32();
+                w[3] = r.u32();
+            }
+            else
+                for (uint32_t &x : w)
+                    x = randFloatBits(r);
+            std::memcpy(data.data() + q * 16u, w, 16);
+        }
+    }
+
+    // ---- Running
+
+    class Machine
+    {
+    public:
+        explicit Machine(bool generated)
+        {
+            memory = std::make_unique<PS2Memory>();
+            memory->initialize();
+            gs = std::make_unique<GS>();
+            vu = std::make_unique<VU1Interpreter>(VU1Interpreter::Unit::VU1);
+            vu->setGifSink(&ga2_vu1cap::GifHash::sink, &gif);
+            vu->setGeneratedProgramsEnabled(generated);
+        }
+        void load(const std::vector<uint8_t> &code)
+        {
+            for (uint32_t off = 0; off < code.size(); off += 4u)
+            {
+                uint32_t word;
+                std::memcpy(&word, code.data() + off, 4);
+                memory->write32(0x11008000u + off, word);
+            }
+        }
+        void start(const VU1State &state, const std::vector<uint8_t> &data, uint64_t cycle)
+        {
+            std::memcpy(memory->getVU1Data(), data.data(), data.size());
+            gif = ga2_vu1cap::GifHash{};
+            vu->restoreForReplay(state, cycle);
+        }
+        void execute(uint32_t pc, uint32_t top, uint32_t itop, uint32_t maxCycles)
+        {
+            vu->execute(memory->getVU1Code(), 0x4000u, memory->getVU1Data(), 0x4000u, *gs, memory.get(), pc, top, itop, maxCycles);
+        }
+        void resume(uint32_t top, uint32_t itop, uint32_t maxCycles)
+        {
+            vu->resume(memory->getVU1Code(), 0x4000u, memory->getVU1Data(), 0x4000u, *gs, memory.get(), top, itop, maxCycles);
+        }
+        std::unique_ptr<PS2Memory> memory;
+        std::unique_ptr<GS> gs;
+        std::unique_ptr<VU1Interpreter> vu;
+        ga2_vu1cap::GifHash gif;
+    };
+
+    struct Digest
+    {
+        uint64_t state, data, gif, gifBytes, cycle;
+        bool ended;
+    };
+
+    Digest digest(Machine &m, bool maskStatus, bool maskMac, bool maskClip = false)
+    {
+        VU1State s = m.vu->state();
+        if (maskStatus)
+            s.status = 0u;
+        if (maskMac)
+            s.mac = 0u;
+        if (maskClip)
+            s.clip = 0u;
+        return {VU1Interpreter::digestState(s), VU1Interpreter::digestBytes(m.memory->getVU1Data(), 0x4000u), m.gif.digest,
+                m.gif.bytes, m.vu->cycle(), m.vu->lastRunEnded()};
+    }
+
+    // Names of the state fields that differ (for mismatch reports).
+    std::string stateDiff(const VU1State &a, const VU1State &b)
+    {
+        std::string out;
+        char buf[256];
+        for (int r = 0; r < 32; ++r)
+            if (std::memcmp(a.vf[r], b.vf[r], 16) != 0)
+            {
+                uint32_t x[4], y[4];
+                std::memcpy(x, a.vf[r], 16);
+                std::memcpy(y, b.vf[r], 16);
+                std::snprintf(buf, sizeof(buf), " vf%d(%08x.%08x.%08x.%08x/%08x.%08x.%08x.%08x)", r, x[0], x[1], x[2], x[3], y[0], y[1], y[2], y[3]);
+                out += buf;
+            }
+        for (int r = 0; r < 16; ++r)
+            if (a.vi[r] != b.vi[r])
+            {
+                std::snprintf(buf, sizeof(buf), " vi%d(%d/%d)", r, a.vi[r], b.vi[r]);
+                out += buf;
+            }
+        if (std::memcmp(a.acc, b.acc, 16) != 0) out += " acc";
+        if (std::memcmp(&a.q, &b.q, 4) != 0) out += " q";
+        if (std::memcmp(&a.p, &b.p, 4) != 0) out += " p";
+        if (std::memcmp(&a.i, &b.i, 4) != 0) out += " i";
+        if (a.r != b.r) out += " r";
+        if (a.pc != b.pc) out += " pc";
+        if (a.mac != b.mac) { std::snprintf(buf, sizeof(buf), " mac(%x/%x)", a.mac, b.mac); out += buf; }
+        if (a.clip != b.clip) { std::snprintf(buf, sizeof(buf), " clip(%x/%x)", a.clip, b.clip); out += buf; }
+        if (a.status != b.status) { std::snprintf(buf, sizeof(buf), " status(%x/%x)", a.status, b.status); out += buf; }
+        if (a.ebit != b.ebit || a.haltAfterDelaySlot != b.haltAfterDelaySlot || a.branchPending != b.branchPending ||
+            a.branchTarget != b.branchTarget || a.branchDelay != b.branchDelay || a.stoppedByD != b.stoppedByD ||
+            a.stoppedByT != b.stoppedByT)
+            out += " control";
+        return out;
+    }
+
+    // ignoreCycles: a run waits for its last flag result to commit before it ends,
+    // so without FMAC flag results at all, or without CLIP results (--flags 4, 1),
+    // it can end earlier.
+    bool same(const Digest &a, const Digest &b, bool ignoreCycles = false)
+    {
+        return a.state == b.state && a.data == b.data && a.gif == b.gif && a.gifBytes == b.gifBytes &&
+               (ignoreCycles || a.cycle == b.cycle) && a.ended == b.ended;
+    }
+
+    std::vector<uint8_t> readFile(const std::filesystem::path &p)
+    {
+        std::ifstream in(p, std::ios::binary);
+        return std::vector<uint8_t>((std::istreambuf_iterator<char>(in)), std::istreambuf_iterator<char>());
+    }
+
+    // list <image.bin>: the pairs with the generator's flag modes.
+    int list(int argc, char **argv)
+    {
+        if (argc < 3)
+            return 2;
+        const std::vector<uint8_t> code = readFile(argv[2]);
+        const std::vector<uint8_t> modes = ga2_vu1plan::flagModes(code);
+        const ga2_vu1plan::EntryFacts facts = ga2_vu1plan::entryFacts(code);
+        const std::vector<bool> targets = ga2_vu1plan::branchTargets(code);
+        uint32_t last = 0;
+        for (uint32_t i = 0; i < code.size() / 8u; ++i)
+            if (ps2_vu1_reach::word(code.data(), i, 0) || ps2_vu1_reach::word(code.data(), i, 1))
+                last = i;
+        for (uint32_t i = 0; i <= last; ++i)
+        {
+            const uint32_t lo = ps2_vu1_reach::word(code.data(), i, 0), up = ps2_vu1_reach::word(code.data(), i, 1);
+            std::printf("%4u %08x %08x mode %u%s%s%s%s\n", i, lo, up, modes[i], VU::upperProducesFmacFlags(up) ? " P" : "",
+                        targets[i] ? " T" : "", facts.mayBranch[i] ? " mb" : "", (up >> 30) & 1u ? " E" : "");
+        }
+        return 0;
+    }
+
+    int emit(int argc, char **argv)
+    {
+        if (argc < 5)
+            return 2;
+        const std::filesystem::path dir = argv[2];
+        const uint32_t images = static_cast<uint32_t>(std::atoi(argv[3]));
+        const uint64_t seed = std::strtoull(argv[4], nullptr, 0);
+        const uint32_t maxPairs = argc > 5 ? static_cast<uint32_t>(std::atoi(argv[5])) : 48u;
+        const bool flagHeavy = argc > 6 && !std::strcmp(argv[6], "--flagheavy");
+        std::filesystem::create_directories(dir);
+        for (uint32_t k = 0; k < images; ++k)
+        {
+            Rng r(seed * 1000003ull + k);
+            const Prog p = makeProgram(r, maxPairs, flagHeavy);
+            const uint64_t hash = VU1Interpreter::digestBytes(p.code.data(), p.code.size());
+            char name[64];
+            std::snprintf(name, sizeof(name), "%016llx", static_cast<unsigned long long>(hash));
+            std::ofstream(dir / (std::string(name) + ".bin"), std::ios::binary)
+                .write(reinterpret_cast<const char *>(p.code.data()), static_cast<std::streamsize>(p.code.size()));
+            std::ofstream entries(dir / (std::string(name) + ".entries"));
+            for (uint32_t e : p.entries)
+                entries << e << "\n";
+        }
+        std::printf("wrote %u images to %s\n", images, dir.c_str());
+        return 0;
+    }
+
+    int run(int argc, char **argv)
+    {
+        if (argc < 4)
+            return 2;
+        const std::filesystem::path dir = argv[2];
+        const uint32_t states = static_cast<uint32_t>(std::atoi(argv[3]));
+        uint64_t seed = 1;
+        bool lines = false;
+        int flagMode = -1;
+        for (int i = 4; i < argc; ++i)
+        {
+            if (!std::strcmp(argv[i], "--lines"))
+                lines = true;
+            else if (!std::strcmp(argv[i], "--flags") && i + 1 < argc)
+                flagMode = std::atoi(argv[++i]);
+            else
+                seed = std::strtoull(argv[i], nullptr, 0);
+        }
+        std::vector<std::filesystem::path> images;
+        for (const auto &e : std::filesystem::directory_iterator(dir))
+            if (e.path().extension() == ".bin")
+                images.push_back(e.path());
+        std::sort(images.begin(), images.end());
+
+        const char *statsEnv = std::getenv("GA2_VU1_BLOCKSTATS");
+        const bool blockStats = statsEnv && *statsEnv && *statsEnv != '0';
+        VU1Interpreter::s_blockStatsOn = blockStats;
+        std::string traceImage;
+        uint32_t traceState = ~0u;
+        if (const char *t = std::getenv("FUZZ_TRACE"))
+        {
+            const std::string spec = t;
+            const size_t colon = spec.find(':');
+            if (colon != std::string::npos)
+            {
+                traceImage = spec.substr(0, colon);
+                traceState = static_cast<uint32_t>(std::atoi(spec.c_str() + colon + 1));
+            }
+        }
+        const uint64_t maxReport = std::getenv("FUZZ_MAXREPORT") ? std::strtoull(std::getenv("FUZZ_MAXREPORT"), nullptr, 0) : 20u;
+        Machine ref(false), cand(flagMode < 0);
+        if (flagMode >= 0)
+            cand.vu->setDecodeFlagMode(static_cast<uint8_t>(flagMode));
+        uint64_t runs = 0, mismatches = 0, endedRuns = 0, resumed = 0;
+        for (const auto &path : images)
+        {
+            const std::vector<uint8_t> code = readFile(path);
+            if (code.size() != 0x4000u)
+                continue;
+            std::vector<uint32_t> entries;
+            {
+                std::ifstream in(std::filesystem::path(path).replace_extension(".entries"));
+                for (uint32_t e = 0; in >> e;)
+                    entries.push_back(e);
+            }
+            if (entries.empty())
+                entries.push_back(0u);
+            // --flags <mode>: the candidate is the interpreter computing only that mode's flag results
+            // (kFlagMac=1, kFlagStatus=2, kFlagClip=4); what it skips is not compared.
+            const bool readsStatus = flagMode < 0 ? ps2_vu1_reach::readsStatus(code.data(), static_cast<uint32_t>(code.size() / 8u))
+                                                  : (flagMode & 2) != 0;
+            if (flagMode >= 0)
+            {
+                // A reader of a result the candidate does not compute needs it.
+                bool skip = false;
+                for (uint32_t i = 0; i < 2048u && !skip; ++i)
+                {
+                    if ((ps2_vu1_reach::word(code.data(), i, 1) >> 31) != 0u)
+                        continue;
+                    const uint32_t op = ps2_vu1_reach::word(code.data(), i, 0) >> 25;
+                    skip = ((flagMode & 2) == 0 && (op == 0x14u || op == 0x16u || op == 0x17u)) ||
+                           ((flagMode & 1) == 0 && (op == 0x18u || op == 0x1Au || op == 0x1Bu)) ||
+                           ((flagMode & 4) == 0 && (op == 0x10u || op == 0x12u || op == 0x13u || op == 0x1Cu));
+                }
+                if (skip)
+                    continue;
+            }
+            const uint64_t hash = VU1Interpreter::digestBytes(code.data(), code.size());
+            uint32_t pairs = 1u;
+            for (uint32_t i = 0; i < 2048u; ++i)
+                if (ps2_vu1_reach::word(code.data(), i, 0) || ps2_vu1_reach::word(code.data(), i, 1))
+                    pairs = i + 1u;
+            ref.load(code);
+            cand.load(code);
+            Rng r(seed ^ (hash * 0x9E3779B97F4A7C15ull));
+            for (uint32_t k = 0; k < states; ++k)
+            {
+                const VU1State state = randomState(r, pairs);
+                std::vector<uint8_t> data;
+                randomData(r, data);
+                const uint32_t entry = entries[r.below(static_cast<uint32_t>(entries.size()))];
+                const uint32_t top = r.u32() & 0x3FFu, itop = r.u32() & 0x3FFu;
+                const uint64_t cycle = r.below(64u);
+                uint32_t budget = r.chance(20) ? 8u + r.below(60u) : 200u + r.below(1200u);
+                ref.start(state, data, cycle);
+                cand.start(state, data, cycle);
+                // FUZZ_TRACE=<image stem>:<state index>: the pairs the interpreter ran.
+                std::vector<uint64_t> hitCounts(2048, 0u);
+                const bool trace = traceImage == path.stem().string() && traceState == k;
+                if (trace)
+                    ref.vu->setPcHitCounter(hitCounts.data());
+                ref.execute(entry * 8u, top, itop, budget);
+                if (trace)
+                {
+                    std::printf("trace %s state %u entry %u budget %u cycle0 %llu: mac %x -> %x, pairs run:", traceImage.c_str(), k, entry, budget,
+                                static_cast<unsigned long long>(cycle), state.mac, ref.vu->state().mac);
+                    for (uint32_t i = 0; i < 2048u; ++i)
+                        if (hitCounts[i])
+                            std::printf(" %u%s", i, hitCounts[i] > 1 ? ("x" + std::to_string(hitCounts[i])).c_str() : "");
+                    std::printf("\n");
+                }
+                cand.execute(entry * 8u, top, itop, budget);
+                for (uint32_t step = 0;; ++step)
+                {
+                    const bool ended = ref.vu->lastRunEnded();
+                    const bool noMac = flagMode >= 0 && (flagMode & 1) == 0, noClip = flagMode >= 0 && (flagMode & 4) == 0;
+                    const Digest a = digest(ref, !readsStatus, false), b = digest(cand, !readsStatus, noMac, noClip);
+                    const bool relax = flagMode >= 0 && ((flagMode & 3) == 0 || (flagMode & 4) == 0);
+                    // A run cut off by its budget has not drained the pipelines: MAC and CLIP results
+                    // the flag analysis proved unobservable (given the program runs on) may be missing.
+                    const bool ok = ended ? same(digest(ref, !readsStatus, noMac, noClip), b, relax)
+                                          : same(digest(ref, !readsStatus, true, true), digest(cand, !readsStatus, true, true), relax);
+                    ++runs;
+                    endedRuns += ended;
+                    if (lines)
+                        std::printf("%s %u.%u state=%016llx data=%016llx gif=%016llx/%llu cycle=%llu ended=%d\n",
+                                    path.stem().c_str(), k, step, static_cast<unsigned long long>(a.state),
+                                    static_cast<unsigned long long>(a.data), static_cast<unsigned long long>(a.gif),
+                                    static_cast<unsigned long long>(a.gifBytes), static_cast<unsigned long long>(a.cycle), ended);
+                    if (!ok)
+                    {
+                        ++mismatches;
+                        if (mismatches <= maxReport)
+                            std::printf("MISMATCH %s state %u step %u entry %u: state %s%s data %s gif %s cycles %llu vs %llu (ended %d vs %d)\n",
+                                        path.stem().c_str(), k, step, entry, a.state == b.state ? "ok" : "DIFF",
+                                        a.state == b.state ? "" : stateDiff(ref.vu->state(), cand.vu->state()).c_str(),
+                                        a.data == b.data ? "ok" : "DIFF", a.gif == b.gif && a.gifBytes == b.gifBytes ? "ok" : "DIFF",
+                                        static_cast<unsigned long long>(a.cycle), static_cast<unsigned long long>(b.cycle), ended, b.ended);
+                        break;
+                    }
+                    if (ended || step >= 3u || !r.chance(60))
+                        break;
+                    ++resumed;
+                    budget = 8u + r.below(300u);
+                    if (trace)
+                        std::fill(hitCounts.begin(), hitCounts.end(), 0u);
+                    ref.resume(top, itop, budget);
+                    cand.resume(top, itop, budget);
+                    if (trace)
+                    {
+                        std::printf("trace resume %u budget %u pairs run:", step + 1u, budget);
+                        for (uint32_t i = 0; i < 2048u; ++i)
+                            if (hitCounts[i])
+                                std::printf(" %u%s", i, hitCounts[i] > 1 ? ("x" + std::to_string(hitCounts[i])).c_str() : "");
+                        std::printf("\n");
+                    }
+                }
+            }
+        }
+        std::fprintf(stderr, "%zu images, %llu checks (%llu ended, %llu resumes): %llu mismatches\n", images.size(),
+                     static_cast<unsigned long long>(runs), static_cast<unsigned long long>(endedRuns),
+                     static_cast<unsigned long long>(resumed), static_cast<unsigned long long>(mismatches));
+        if (blockStats)
+        {
+            const VU1Interpreter::BlockStats &st = VU1Interpreter::blockStats();
+            std::fprintf(stderr, "blocks: %llu entries, %llu ran, %llu pairs ran in blocks, %llu cycles in blocks\n",
+                         static_cast<unsigned long long>(st.entries), static_cast<unsigned long long>(st.ran),
+                         static_cast<unsigned long long>(st.pairsRan), static_cast<unsigned long long>(st.cyclesRan));
+        }
+        return mismatches ? 1 : 0;
+    }
+}
+
+int main(int argc, char **argv)
+{
+    if (argc >= 2 && !std::strcmp(argv[1], "emit"))
+        return emit(argc, argv);
+    if (argc >= 2 && !std::strcmp(argv[1], "run"))
+        return run(argc, argv);
+    if (argc >= 2 && !std::strcmp(argv[1], "list"))
+        return list(argc, argv);
+    std::fprintf(stderr, "usage: %s emit <dir> <images> <seed> [maxPairs [--flagheavy]] | run <dir> <statesPerImage> [seed] [--lines]\n", argv[0]);
+    return 2;
+}
