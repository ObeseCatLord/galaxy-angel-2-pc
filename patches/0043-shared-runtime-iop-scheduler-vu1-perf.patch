diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
index 45e8ab7..7303208 100644
--- a/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp
@@ -11,6 +11,8 @@
 #include <cmath>
 #include <cstdio>
 #include <cstdlib>
+#include <atomic>
+#include <chrono>
 #include <cstring>
 #include <filesystem>
 #include <limits>
@@ -973,10 +975,39 @@ void VU1Interpreter::resume(uint8_t *vuCode, uint32_t codeSize,
         captureEnd(vuData, dataSize);
 }
 
+namespace
+{
+    // GA2_PERF: VU1 microprogram runs, VU cycles and host time since last read.
+    const bool g_vu1Perf = [] { const char *v = std::getenv("GA2_PERF"); return v && *v && *v != '0'; }();
+    std::atomic<uint64_t> g_vu1Runs{0}, g_vu1Cycles{0}, g_vu1Nanos{0};
+}
+
+VU1Interpreter::PerfSample VU1Interpreter::takePerfSample()
+{
+    return {g_vu1Runs.exchange(0), g_vu1Cycles.exchange(0), g_vu1Nanos.exchange(0)};
+}
+
 void VU1Interpreter::run(uint8_t *vuCode, uint32_t codeSize,
                          uint8_t *vuData, uint32_t dataSize,
                          GS &gs, PS2Memory *memory, uint32_t maxCycles)
 {
+    const auto perfStart = g_vu1Perf ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    const uint64_t perfCycle = m_cycle;
+    struct PerfScope
+    {
+        const std::chrono::steady_clock::time_point start;
+        const uint64_t cycle;
+        const uint64_t &now;
+        ~PerfScope()
+        {
+            if (!g_vu1Perf) return;
+            g_vu1Runs.fetch_add(1, std::memory_order_relaxed);
+            g_vu1Cycles.fetch_add(now - cycle, std::memory_order_relaxed);
+            g_vu1Nanos.fetch_add(uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                     std::chrono::steady_clock::now() - start).count()),
+                                 std::memory_order_relaxed);
+        }
+    } perfScope{perfStart, perfCycle, m_cycle};
     m_activeVuData = vuData;
     m_activeVuDataSize = dataSize;
     m_activeGs = &gs;
