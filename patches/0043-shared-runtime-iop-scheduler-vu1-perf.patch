From cf815d534ba5f5b920408ec7f7f1b62df674f34c Mon Sep 17 00:00:00 2001
From: ObeseCatLord <6099645+ObeseCatLord@users.noreply.github.com>
Date: Tue, 13 Oct 2026 16:03:34 -0500
Subject: [PATCH] ga2: shared runtime option for fast builds, IOP scheduler
 walk, VU1 perf counters

- PS2X_RUNTIME_SHARED builds ps2_runtime as a shared library (PIC
  everywhere, Granite PIC, -Bsymbolic-functions, no relink of executables
  on library changes). A runtime/IOP .cpp change now rebuilds one library
  instead of relinking five ~400 MB recompiled executables.
- The program's function table symbols are weak references from the
  runtime, so tools without a program (and a shared runtime) still load.
- IOP scheduler: per-timeslice walks use an id-ordered thread vector
  instead of the std::map (10% of CPU in a VU-heavy scene), wake and select
  in one pass, dead-thread cleanup only when a thread died.
- GA2_PERF also reports VU1 runs, VU cycles and host time per second.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 CMakeLists.txt                                |  8 ++++
 ps2xIOP/src/emulator/core/iop_kernel.cpp      | 39 ++++++++++++-------
 ps2xIOP/src/emulator/core/iop_kernel.h        |  5 +++
 ps2xRuntime/CMakeLists.txt                    | 17 +++++++-
 ps2xRuntime/include/ps2_runtime.h             | 15 +++++--
 ps2xRuntime/include/runtime/ps2_vu1.h         |  7 ++++
 ps2xRuntime/src/lib/Kernel/EeScheduler.cpp    |  9 ++++-
 ps2xRuntime/src/lib/ps2_runtime.cpp           |  3 +-
 ps2xRuntime/src/lib/vu/ps2_vu1_core.cpp       | 31 +++++++++++++++
 ps2xRuntime/src/runner/register_functions.cpp |  4 +-
 ps2xTest/CMakeLists.txt                       |  4 ++
 ps2xTest/src/test_function_table.cpp          | 11 ++++--
 12 files changed, 125 insertions(+), 28 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c7c7af5..dd0a14d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -17,6 +17,14 @@ option(PS2X_BUILD_RECOMP "Build ps2xRecomp" ON)
 option(PS2X_BUILD_RUNTIME "Build ps2xRuntime" ON)
 option(PS2X_BUILD_ANALYZER "Build ps2xAnalyzer" ON)
 option(PS2X_BUILD_TEST "Build ps2xTest" ON)
+# Shared ps2_runtime: changing the runtime relinks one library instead of
+# every (very large) recompiled game executable.
+option(PS2X_RUNTIME_SHARED "Build ps2_runtime as a shared library" OFF)
+if(PS2X_RUNTIME_SHARED)
+    set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+    # Executables need not relink when only the runtime library changes.
+    set(CMAKE_LINK_DEPENDS_NO_SHARED ON)
+endif()
 option(PS2X_BUILD_STUDIO "Build ps2xStudio" ON)
 
 if(ANDROID)
diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index 75b7f97..be0c265 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -45,9 +45,17 @@ namespace ps2x::iop::detail
         return m_nextRpcLifetimeGeneration++;
     }
 
+    void IopKernel::rebuildThreadList()
+    {
+        m_threadList.clear();
+        for (auto &[id, thread] : m_threads)
+            m_threadList.push_back(&thread);
+    }
+
     void IopKernel::reset()
     {
         m_threads.clear();
+        m_threadList.clear();
         m_semaphores.clear();
         m_eventFlags.clear();
         m_nextThreadId = 1;
@@ -94,6 +102,7 @@ namespace ps2x::iop::detail
             }
             const int id = thread.id;
             m_threads.emplace(id, std::move(thread));
+            rebuildThreadList();
             setV0(id);
             return true;
         }
@@ -109,6 +118,7 @@ namespace ps2x::iop::detail
             if (it->second.stackBase != 0u)
                 (void)m_memory.freeAllocation(it->second.stackBase);
             m_threads.erase(it);
+            rebuildThreadList();
             setV0(0);
             return true;
         }
@@ -817,20 +827,15 @@ namespace ps2x::iop::detail
 
     IopThread *IopKernel::beginNextReady(uint64_t currentCycle)
     {
-        for (auto &[id, thread] : m_threads)
-        {
-            if (thread.state == IopThreadState::Delay && thread.wakeCycle <= currentCycle)
-                thread.state = IopThreadState::Ready;
-        }
-
+        // One pass: wake expired delays and pick the highest-priority ready
+        // thread (lowest priority value, then lowest id).
         IopThread *next = nullptr;
-        for (auto &[id, thread] : m_threads)
+        for (IopThread *thread : m_threadList)
         {
-            if (thread.state != IopThreadState::Ready)
-                continue;
-            if (next == nullptr || thread.priority < next->priority ||
-                (thread.priority == next->priority && thread.id < next->id))
-                next = &thread;
+            if (thread->state == IopThreadState::Delay && thread->wakeCycle <= currentCycle)
+                thread->state = IopThreadState::Ready;
+            if (thread->state == IopThreadState::Ready && (next == nullptr || thread->priority < next->priority))
+                next = thread; // id order: the first of equal priority wins
         }
         if (next == nullptr)
             return nullptr;
@@ -845,10 +850,10 @@ namespace ps2x::iop::detail
     uint64_t IopKernel::nextWakeCycle(uint64_t fallback) const
     {
         uint64_t nextWake = fallback;
-        for (const auto &[id, thread] : m_threads)
+        for (const IopThread *thread : m_threadList)
         {
-            if (thread.state == IopThreadState::Delay)
-                nextWake = std::min(nextWake, thread.wakeCycle);
+            if (thread->state == IopThreadState::Delay)
+                nextWake = std::min(nextWake, thread->wakeCycle);
         }
         return nextWake;
     }
@@ -865,6 +870,9 @@ namespace ps2x::iop::detail
 
     void IopKernel::cleanupDeadThreads()
     {
+        if (std::none_of(m_threadList.begin(), m_threadList.end(),
+                         [](const IopThread *thread) { return thread->state == IopThreadState::Dead; }))
+            return;
         for (auto thread = m_threads.begin(); thread != m_threads.end();)
         {
             if (thread->second.state != IopThreadState::Dead)
@@ -876,6 +884,7 @@ namespace ps2x::iop::detail
                 (void)m_memory.freeAllocation(thread->second.stackBase);
             thread = m_threads.erase(thread);
         }
+        rebuildThreadList();
     }
 
     void IopKernel::terminateThreadsInRange(uint32_t base, uint32_t size)
