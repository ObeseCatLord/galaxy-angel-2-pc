-extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = (g_ps2RecompiledFunctionTableEnd - g_ps2RecompiledFunctionTableBase) >> 2;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount = kSlotCount;
 
