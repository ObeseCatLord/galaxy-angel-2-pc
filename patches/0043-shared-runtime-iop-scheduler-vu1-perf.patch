                 const double seconds = std::chrono::duration<double>(now - last).count();
                 if (seconds >= 5.0)
                 {
-                    std::fprintf(stderr, "[ga2 perf] vsync=%llu rate=%.2f/s (%.0f%% speed)\n",
+                    const auto vu1 = VU1Interpreter::takePerfSample();
+                    std::fprintf(stderr, "[ga2 perf] vsync=%llu rate=%.2f/s (%.0f%% speed) vu1: %.0f runs/s, "
+                                         "%.1f Mcycles/s, %.0f ms/s host, %.2f ns/cycle\n",
                                  static_cast<unsigned long long>(m_vsyncTick),
                                  static_cast<double>(m_vsyncTick - lastTick) / seconds,
-                                 100.0 * static_cast<double>(m_vsyncTick - lastTick) / seconds / 59.94);
+                                 100.0 * static_cast<double>(m_vsyncTick - lastTick) / seconds / 59.94,
+                                 double(vu1.runs) / seconds, double(vu1.cycles) / seconds / 1e6,
+                                 double(vu1.nanos) / seconds / 1e6,
+                                 vu1.cycles ? double(vu1.nanos) / double(vu1.cycles) : 0.0);
                     last = now;
                     lastTick = m_vsyncTick;
                 }
