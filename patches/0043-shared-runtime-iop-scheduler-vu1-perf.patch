@@ -147,6 +148,10 @@ namespace ps2x::iop::detail
 
         IopMemory &m_memory;
         std::map<int, IopThread> m_threads;
+        // m_threads in id order, for the per-timeslice scheduler walks (map
+        // node pointers are stable); rebuilt whenever a thread is added/removed.
+        std::vector<IopThread *> m_threadList;
+        void rebuildThreadList();
         std::map<int, Semaphore> m_semaphores;
