diff --git a/ps2xRuntime/CMakeLists.txt b/ps2xRuntime/CMakeLists.txt
index a8b8d43..3c4990c 100644
--- a/ps2xRuntime/CMakeLists.txt
+++ b/ps2xRuntime/CMakeLists.txt
@@ -375,7 +375,12 @@ function(ps2x_stage_ffmpeg_runtime_dlls target_name)
     )
 endfunction()
 
-add_library(ps2_runtime STATIC
+if(PS2X_RUNTIME_SHARED)
+    set(PS2X_RUNTIME_LIBRARY_TYPE SHARED)
+else()
+    set(PS2X_RUNTIME_LIBRARY_TYPE STATIC)
+endif()
+add_library(ps2_runtime ${PS2X_RUNTIME_LIBRARY_TYPE}
     src/lib/game_overrides.cpp
     src/lib/gs/ps2_gif_arbiter.cpp
     src/lib/ps2_audio.cpp
@@ -521,12 +526,22 @@ if(TARGET OpenSSL::Crypto)
     target_compile_definitions(ps2_runtime PRIVATE PS2X_DISC_SHA256=1)
 endif()
 target_link_libraries(ps2_runtime PUBLIC ps2_host_backend ffmpeg ps2_iop)
+if(PS2X_RUNTIME_SHARED AND CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+    # Calls inside the library stay direct; the function table symbols come
+    # from the executable at load time.
+    target_compile_options(ps2_runtime PRIVATE -fno-semantic-interposition)
+    target_link_options(ps2_runtime PRIVATE "LINKER:-Bsymbolic-functions")
+endif()
 
 # paraLLEl-GS (Vulkan compute GS, LGPL-3.0+): built standalone from an external
 # checkout when PS2X_PGS_DIR points at it.
 set(PS2X_PGS_DIR "" CACHE PATH "paraLLEl-GS checkout (with Granite) for the GPU GS")
 if(PS2X_PGS_DIR AND EXISTS "${PS2X_PGS_DIR}/CMakeLists.txt")
     set(PARALLEL_GS_STANDALONE ON CACHE BOOL "" FORCE)
+    if(PS2X_RUNTIME_SHARED)
+        # Granite forces non-PIC objects unless asked; a shared runtime needs PIC.
+        set(GRANITE_POSITION_INDEPENDENT ON CACHE BOOL "" FORCE)
+    endif()
     add_subdirectory("${PS2X_PGS_DIR}" "${CMAKE_BINARY_DIR}/parallel-gs" EXCLUDE_FROM_ALL)
     target_link_libraries(ps2_runtime PRIVATE parallel-gs)
     target_compile_definitions(ps2_runtime PRIVATE PS2X_HAVE_PGS=1)
diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index 11b8fec..46e6f75 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -593,9 +593,16 @@ private:
 };
 
 // Generated by ps2xRecomp in ps2xRuntime/src/runner/register_functions.cpp.
-extern const uint32_t g_ps2RecompiledFunctionTableBase;
-extern const uint32_t g_ps2RecompiledFunctionTableEnd;
-extern const uint32_t g_ps2RecompiledFunctionTableSlotCount;
-extern PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[];
+// Defined by the recompiled program. Weak so tools that link the runtime
+// without a program (and a shared runtime) still load.
+#if defined(__GNUC__) || defined(__clang__)
+#define PS2X_PROGRAM_SYMBOL __attribute__((weak))
+#else
+#define PS2X_PROGRAM_SYMBOL
+#endif
+extern const uint32_t g_ps2RecompiledFunctionTableBase PS2X_PROGRAM_SYMBOL;
+extern const uint32_t g_ps2RecompiledFunctionTableEnd PS2X_PROGRAM_SYMBOL;
+extern const uint32_t g_ps2RecompiledFunctionTableSlotCount PS2X_PROGRAM_SYMBOL;
+extern PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[] PS2X_PROGRAM_SYMBOL;
 
 #endif // PS2_RUNTIME_H
