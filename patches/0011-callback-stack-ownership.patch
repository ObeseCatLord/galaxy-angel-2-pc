+    constexpr uint64_t kCallbackStore = 0x4E41544956455F45ull;
+    constexpr uint32_t kStoreOffset = 0x18u;
+
+    constexpr uint32_t kOuterSpAddress = 0x00018000u;
+    constexpr uint32_t kInnerSpAddress = 0x00018004u;
+    constexpr uint32_t kIrqSpAddress = 0x00018008u;
+    constexpr uint32_t kOuterGpAddress = 0x0001800Cu;
+    constexpr uint32_t kInnerGpAddress = 0x00018010u;
+    constexpr uint32_t kCallbackRunsAddress = 0x00018014u;
+    constexpr uint32_t kIrqRunsAddress = 0x00018018u;
+    constexpr uint32_t kWakeRunsAddress = 0x0001801Cu;
+    constexpr uint32_t kParentContextAddress = 0x00018020u;
+    constexpr uint32_t kLegacyParentEntry = 0x00178100u;
+    constexpr uint32_t kLegacyParentResume = 0x00178110u;
+    constexpr uint32_t kLegacyCallback = 0x00178120u;
+    constexpr uint32_t kLegacyCallbackResume = 0x00178130u;
+    constexpr uint32_t kLegacyWakeThread = 0x00178140u;
+    constexpr uint32_t kQueuedFailureDriver = 0x00178150u;
+    constexpr uint32_t kQueuedFailureRestart = 0x00178160u;
+    constexpr uint32_t kCollisionChildEntry = 0x00178170u;
+    constexpr uint32_t kCollisionCallback = 0x00178180u;
+    constexpr uint32_t kCollisionChildResume = 0x00178190u;
+
+    constexpr uint32_t kLegacySpAddress = 0x00018100u;
+    constexpr uint32_t kLegacyPoisonIntactAddress = 0x00018104u;
+    constexpr uint32_t kLegacyHeapRejectedAddress = 0x00018108u;
+    constexpr uint32_t kLegacyStackRejectedAddress = 0x0001810Cu;
+    constexpr uint32_t kLegacyMetadataIntactAddress = 0x00018110u;
+    constexpr uint32_t kLegacyHeapMetadataIntactAddress = 0x00018114u;
+    constexpr uint32_t kCollisionSpAddress = 0x00018118u;
+    constexpr uint32_t kCollisionCallbackRunsAddress = 0x0001811Cu;
+    constexpr uint32_t kCollisionResumeRunsAddress = 0x00018120u;
+    constexpr uint32_t kLegacyWakeStack = 0x00010000u;
+    constexpr uint32_t kLegacyWakeStackSize = 0x00008000u;
+    constexpr uint64_t kLegacyPoison = 0xD1750A6E5AFECA11ull;
+    uint32_t gQueuedCancelCount = 0u;
+    uint32_t gQueuedRestartCount = 0u;
+
+    struct TestEnv
+    {
+        TestEnv() : ram(PS2_RAM_SIZE, 0u)
+        {
+        }
+
+        std::vector<uint8_t> ram;
+        PS2Runtime runtime;
+    };
+
+    void setReg(R5900Context &ctx, int reg, uint32_t value)
+    {
+        SET_GPR_U32(&ctx, reg, value);
+    }
+
+    uint32_t getReg(const R5900Context &ctx, int reg)
+    {
+        return ::getRegU32(&ctx, reg);
+    }
+
+    void writeU32(uint8_t *ram, uint32_t address, uint32_t value)
+    {
+        std::memcpy(ram + address, &value, sizeof(value));
+    }
+
+    uint32_t readU32(const uint8_t *ram, uint32_t address)
+    {
+        uint32_t value = 0u;
+        std::memcpy(&value, ram + address, sizeof(value));
+        return value;
+    }
+
+    void writeU64(uint8_t *ram, uint32_t address, uint64_t value)
+    {
+        std::memcpy(ram + address, &value, sizeof(value));
+    }
+
+    uint64_t readU64(const uint8_t *ram, uint32_t address)
+    {
+        uint64_t value = 0u;
+        std::memcpy(&value, ram + address, sizeof(value));
+        return value;
+    }
+
+    void bindLegacyOwner(TestEnv &env, R5900Context &main)
+    {
+        main = R5900Context{};
+        setReg(main, 29, 0x00180000u);
+        env.runtime.eeScheduler().reset(env.ram.data(), main);
+        env.runtime.eeScheduler().bindMainContextForSyscall(main, env.ram.data());
+    }
+
+    void storeCallbackFrame(uint8_t *ram, R5900Context *ctx, uint32_t spAddress, uint32_t gpAddress)
+    {
+        const uint32_t sp = getReg(*ctx, 29);
+        writeU32(ram, spAddress, sp);
+        if (gpAddress != 0u)
+        {
+            writeU32(ram, gpAddress, getReg(*ctx, 28));
+        }
+        std::memcpy(ram + sp - kStoreOffset, &kCallbackStore, sizeof(kCallbackStore));
+    }
+
+    void parentEntry(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        setReg(*ctx, 4, kParentGp);
+        setReg(*ctx, 5, kMainStackBase);
+        setReg(*ctx, 6, kMainStackSize);
+        ps2_syscalls::SetupThread(ram, ctx, runtime);
+
+        setReg(*ctx, 4, kHeapBase);
+        setReg(*ctx, 5, kMainStackBase - kHeapBase);
+        ps2_syscalls::SetupHeap(ram, ctx, runtime);
+
+        setReg(*ctx, 28, kParentGp);
+        setReg(*ctx, 16, kParentS0);
+        std::memcpy(ram + kParentSavedReturn, &kParentCanary, sizeof(kParentCanary));
+
+        EeScheduler &scheduler = runtime->eeScheduler();
+        scheduler.addIrqHandler(false, 2u, kIrqHandler, true, 0xCAFEu, kParentGp, 0u);
+        scheduler.dispatchIrq(false, 2u);
+
+        GuestInvocation callback{};
+        callback.kind = GuestInvocationKind::RpcCallback;
+        callback.context = *ctx;
+        callback.context.pc = kOuterRpcCallback;
+        setReg(callback.context, 29, 0u);
+        setReg(callback.context, 31, 0u);
+        ctx->pc = kParentResume;
+        scheduler.invokeCurrent(std::move(callback));
+    }
+
+    void outerRpcCallback(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeU32(ram, kCallbackRunsAddress, readU32(ram, kCallbackRunsAddress) + 1u);
+        GuestInvocation callback{};
+        callback.kind = GuestInvocationKind::RpcCallback;
+        callback.context = *ctx;
+        callback.context.pc = kInnerRpcCallback;
+        setReg(callback.context, 29, 0u);
+        setReg(callback.context, 31, 0u);
+        ctx->pc = kOuterRpcResume;
+        runtime->eeScheduler().invokeCurrent(std::move(callback));
+    }
+
+    void innerRpcCallback(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeU32(ram, kCallbackRunsAddress, readU32(ram, kCallbackRunsAddress) + 1u);
+        EeScheduler &scheduler = runtime->eeScheduler();
+        EeThreadCreateParams wakeThread{};
+        wakeThread.entry = kWakeThreadEntry;
+        wakeThread.stack = 0x0001A000u;
+        wakeThread.stackSize = 0x8000u;
+        wakeThread.priority = 10;
+        const int id = scheduler.createThread(wakeThread);
+        scheduler.startThread(id, 0u, *ctx, false);
+        ctx->pc = kInnerRpcResume;
+        scheduler.sleepCurrent();
+    }
+
+    void innerRpcResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        storeCallbackFrame(ram, ctx, kInnerSpAddress, kInnerGpAddress);
+        ctx->pc = 0u;
+    }
+
+    void outerRpcResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        storeCallbackFrame(ram, ctx, kOuterSpAddress, kOuterGpAddress);
+        ctx->pc = 0u;
+    }
+
+    void wakeThreadEntry(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeU32(ram, kWakeRunsAddress, readU32(ram, kWakeRunsAddress) + 1u);
+        runtime->eeScheduler().wakeupThread(EeScheduler::kMainThreadId, false);
+        ctx->pc = 0u;
+    }
+
+    void irqHandler(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        writeU32(ram, kIrqRunsAddress, readU32(ram, kIrqRunsAddress) + 1u);
+        storeCallbackFrame(ram, ctx, kIrqSpAddress, 0u);
+        ctx->pc = 0u;
+    }
+
+    void parentResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const bool contextPreserved = getReg(*ctx, 28) == kParentGp && getReg(*ctx, 16) == kParentS0;
+        writeU32(ram, kParentContextAddress, contextPreserved ? 1u : 0u);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void legacyParentEntry(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        GuestInvocation callback{};
+        callback.kind = GuestInvocationKind::RpcCallback;
+        callback.context.pc = kLegacyCallback;
+        runtime->eeScheduler().assignInvocationStack(callback);
+        ctx->pc = kLegacyParentResume;
+        runtime->eeScheduler().invokeCurrent(std::move(callback));
+    }
+
+    void legacyCallback(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        const uint32_t sp = getReg(*ctx, 29);
+        writeU32(ram, kLegacySpAddress, sp);
+        std::memcpy(ram + sp - kStoreOffset, &kLegacyPoison, sizeof(kLegacyPoison));
+
+        EeThreadCreateParams wakeThread{};
+        wakeThread.entry = kLegacyWakeThread;
+        wakeThread.stack = kLegacyWakeStack;
+        wakeThread.stackSize = kLegacyWakeStackSize;
+        wakeThread.priority = 10;
+        const int id = runtime->eeScheduler().createThread(wakeThread);
+        runtime->eeScheduler().startThread(id, 0u, *ctx, false);
+        ctx->pc = kLegacyCallbackResume;
+        runtime->eeScheduler().sleepCurrent();
+    }
+
+    void legacyCallbackResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        const uint64_t poison = readU64(ram, getReg(*ctx, 29) - kStoreOffset);
+        writeU32(ram, kLegacyPoisonIntactAddress, poison == kLegacyPoison ? 1u : 0u);
+        ctx->pc = 0u;
+    }
+
+    void legacyWakeThread(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        const uint32_t callbackSp = readU32(ram, kLegacySpAddress);
+        const uint32_t reservationBase = callbackSp - 0x3FF0u;
+        const uint32_t heapBase = runtime->guestHeapBase();
+        const uint32_t heapLimit = runtime->guestHeapLimit();
+        bool heapRejected = false;
+        bool stackRejected = false;
+        try
+        {
+            runtime->configureGuestHeap(reservationBase, callbackSp + 0x10u);
+        }
+        catch (const std::runtime_error &)
+        {
+            heapRejected = true;
+        }
+        try
+        {
+            scheduler.setupCurrentThread(reservationBase, 0x4000u, 0u);
+        }
+        catch (const std::runtime_error &)
+        {
+            stackRejected = true;
+        }
+        const GuestThread *self = scheduler.currentThread();
+        const bool metadataIntact = self && self->stack == kLegacyWakeStack && self->stackSize == kLegacyWakeStackSize;
+        const bool heapMetadataIntact = runtime->guestHeapBase() == heapBase && runtime->guestHeapLimit() == heapLimit;
+        writeU32(ram, kLegacyHeapRejectedAddress, heapRejected ? 1u : 0u);
+        writeU32(ram, kLegacyStackRejectedAddress, stackRejected ? 1u : 0u);
+        writeU32(ram, kLegacyMetadataIntactAddress, metadataIntact ? 1u : 0u);
+        writeU32(ram, kLegacyHeapMetadataIntactAddress, heapMetadataIntact ? 1u : 0u);
+        scheduler.wakeupThread(EeScheduler::kMainThreadId, false);
+        ctx->pc = 0u;
+    }
+
+    void legacyParentResume(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void queuedFailureDriver(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        runtime->configureGuestHeap(0x01FC0000u, PS2_RAM_SIZE);
+        GuestInvocation queued{};
+        queued.kind = GuestInvocationKind::RpcCallback;
+        queued.onCancel = [] { ++gQueuedCancelCount; };
+        runtime->eeScheduler().queueInvocation(std::move(queued));
+        ctx->pc = 0u;
+    }
+
+    void queuedFailureRestart(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ++gQueuedRestartCount;
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    void collisionChildEntry(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        GuestInvocation callback{};
+        callback.kind = GuestInvocationKind::RpcCallback;
+        callback.context.pc = kCollisionCallback;
+        ctx->pc = kCollisionChildResume;
+        runtime->eeScheduler().invokeCurrent(std::move(callback));
+    }
+
+    void collisionCallback(uint8_t *ram, R5900Context *ctx, PS2Runtime *)
+    {
+        writeU32(ram, kCollisionSpAddress, getReg(*ctx, 29));
+        writeU32(ram, kCollisionCallbackRunsAddress, readU32(ram, kCollisionCallbackRunsAddress) + 1u);
+        ctx->pc = 0u;
+    }
+
+    void collisionChildResume(uint8_t *ram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        writeU32(ram, kCollisionResumeRunsAddress, readU32(ram, kCollisionResumeRunsAddress) + 1u);
+        ctx->pc = 0u;
+        runtime->requestStop();
+    }
+
+    bool storeIsOutsideParentFrame(uint32_t stackPointer)
+    {
+        const uint64_t first = static_cast<uint64_t>(stackPointer) - kStoreOffset;
+        const uint64_t last = first + sizeof(kCallbackStore);
+        return last <= kParentFrameFirst || first >= kParentFrameLast;
+    }
+
+    bool storeIsOutsideHeap(uint32_t stackPointer, uint32_t heapLimit)
+    {
+        const uint64_t first = static_cast<uint64_t>(stackPointer) - kStoreOffset;
+        const uint64_t last = first + sizeof(kCallbackStore);
+        return last <= kHeapBase || first >= heapLimit;
+    }
+}
+
+void register_ps2_invocation_stack_tests()
+{
+    MiniTest::Case("PS2InvocationStack", [](TestCase &tc)
+    {
+        tc.Run("native callback and queued IRQ frames preserve the live parent frame", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(kParentEntry, parentEntry);
+            env.runtime.registerFunction(kParentResume, parentResume);
+            env.runtime.registerFunction(kOuterRpcCallback, outerRpcCallback);
+            env.runtime.registerFunction(kOuterRpcResume, outerRpcResume);
+            env.runtime.registerFunction(kInnerRpcCallback, innerRpcCallback);
+            env.runtime.registerFunction(kInnerRpcResume, innerRpcResume);
+            env.runtime.registerFunction(kWakeThreadEntry, wakeThreadEntry);
+            env.runtime.registerFunction(kIrqHandler, irqHandler);
+
+            R5900Context main{};
+            main.pc = kParentEntry;
+            setReg(main, 28, kParentGp);
+            setReg(main, 29, kLiveParentSp);
+            env.runtime.eeScheduler().reset(env.ram.data(), main);
+            env.runtime.eeScheduler().run();
+
+            uint64_t canary = 0u;
+            std::memcpy(&canary, env.ram.data() + kParentSavedReturn, sizeof(canary));
+            const uint32_t outerSp = readU32(env.ram.data(), kOuterSpAddress);
+            const uint32_t innerSp = readU32(env.ram.data(), kInnerSpAddress);
+            const uint32_t irqSp = readU32(env.ram.data(), kIrqSpAddress);
+            const uint32_t heapLimit = env.runtime.guestHeapLimit();
+
+            t.Equals(heapLimit, kMainStackBase, "SetupThread metadata must bound the configured heap");
+            t.Equals(readU32(env.ram.data(), kCallbackRunsAddress), 2u,
+                     "both nested RpcCallback guest frames must execute");
+            t.Equals(readU32(env.ram.data(), kWakeRunsAddress), 1u,
+                     "a second EE thread must wake the blocked nested callback");
+            t.Equals(readU32(env.ram.data(), kIrqRunsAddress), 1u,
+                     "the queued IRQ must execute after the callback sequence");
+            t.Equals(readU32(env.ram.data(), kOuterGpAddress), kParentGp,
+                     "outer RpcCallback must inherit the parent GP");
+            t.Equals(readU32(env.ram.data(), kInnerGpAddress), kParentGp,
+                     "nested RpcCallback must inherit the parent GP");
+            t.Equals(readU32(env.ram.data(), kParentContextAddress), 1u,
+                     "callback dispatch must preserve the parent GP and saved register context");
+            t.Equals(canary, kParentCanary,
+                     "callback and IRQ guest stores must not overwrite the parent saved-return canary");
+            for (uint32_t stackPointer : {outerSp, innerSp, irqSp})
+            {
+                t.IsTrue(stackPointer != 0u, "every native callback path must receive a guest stack");
+                t.IsTrue(storeIsOutsideHeap(stackPointer, heapLimit),
+                         "callback frame stores must stay outside the heap configured by SetupHeap");
+                t.IsTrue(storeIsOutsideParentFrame(stackPointer),
+                         "callback frame stores must stay outside the parent live frame");
+            }
+        });
+
+        tc.Run("isolated fallback rejects heap and other-thread declarations before callback execution", [](TestCase &t)
+        {
+            TestEnv heapEnv;
+            R5900Context heapMain{};
+            bindLegacyOwner(heapEnv, heapMain);
+            heapEnv.runtime.configureGuestHeap(0x01FC0000u, PS2_RAM_SIZE);
+            bool heapRejected = false;
+            try
+            {
+                (void)heapEnv.runtime.eeScheduler().invocationStackTop();
+            }
+            catch (const std::runtime_error &)
+            {
+                heapRejected = true;
+            }
+            t.IsTrue(heapRejected, "fallback allocation must reject a declared heap before guest callback stores run");
+
+            TestEnv threadEnv;
+            R5900Context threadMain{};
+            bindLegacyOwner(threadEnv, threadMain);
+            EeThreadCreateParams declaredThread{};
+            declaredThread.stack = PS2_RAM_SIZE - 0x4000u;
+            declaredThread.stackSize = 0x4000u;
+            declaredThread.priority = 10;
+            t.IsTrue(threadEnv.runtime.eeScheduler().createThread(declaredThread) > 0,
+                     "overlap check needs a separately declared EE thread stack");
+            bool stackRejected = false;
+            try
+            {
+                (void)threadEnv.runtime.eeScheduler().invocationStackTop();
+            }
+            catch (const std::runtime_error &)
+            {
+                stackRejected = true;
+            }
+            t.IsTrue(stackRejected, "fallback allocation must reject another thread's declared stack before callback execution");
+        });
+
+        tc.Run("cached fallback is revalidated after a later heap declaration", [](TestCase &t)
+        {
+            TestEnv env;
+            R5900Context main{};
+            bindLegacyOwner(env, main);
+            const uint32_t cachedTop = env.runtime.eeScheduler().invocationStackTop();
+            env.runtime.configureGuestHeap(0x01F00000u, PS2_RAM_SIZE);
+            bool reuseRejected = false;
+            try
+            {
+                (void)env.runtime.eeScheduler().invocationStackTop();
+            }
+            catch (const std::runtime_error &)
+            {
+                reuseRejected = true;
+            }
+            t.IsTrue(cachedTop != 0u, "legacy owner should receive a cacheable fallback stack top");
+            t.IsTrue(reuseRejected,
+                     "a cached fallback with no live lease must reject reuse after heap ownership expands over it");
+        });
+
+        tc.Run("attached legacy callback rejects overlapping declarations and preserves its poisoned frame", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(kLegacyParentEntry, legacyParentEntry);
+            env.runtime.registerFunction(kLegacyParentResume, legacyParentResume);
+            env.runtime.registerFunction(kLegacyCallback, legacyCallback);
+            env.runtime.registerFunction(kLegacyCallbackResume, legacyCallbackResume);
+            env.runtime.registerFunction(kLegacyWakeThread, legacyWakeThread);
+
+            R5900Context main{};
+            main.pc = kLegacyParentEntry;
+            setReg(main, 29, 0x00180000u);
+            env.runtime.eeScheduler().reset(env.ram.data(), main);
+            env.runtime.eeScheduler().run();
+
+            t.IsTrue(readU32(env.ram.data(), kLegacySpAddress) != 0u,
+                     "legacy callback must receive an isolated runtime-derived stack");
+            t.Equals(readU32(env.ram.data(), kLegacyHeapRejectedAddress), 1u,
+                     "other thread heap declaration overlapping a live callback lease must throw");
+            t.Equals(readU32(env.ram.data(), kLegacyStackRejectedAddress), 1u,
+                     "other thread stack declaration overlapping a live callback lease must throw");
+            t.Equals(readU32(env.ram.data(), kLegacyMetadataIntactAddress), 1u,
+                     "rejected stack declaration must retain the other thread's old metadata");
+            t.Equals(readU32(env.ram.data(), kLegacyHeapMetadataIntactAddress), 1u,
+                     "rejected heap declaration must retain the prior heap metadata");
+            t.Equals(readU32(env.ram.data(), kLegacyPoisonIntactAddress), 1u,
+                     "blocked callback must resume with its original poison frame intact");
+        });
+
+        tc.Run("unsafe queued attachment retires once after failure and scheduler can restart", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(kQueuedFailureDriver, queuedFailureDriver);
+            env.runtime.registerFunction(kQueuedFailureRestart, queuedFailureRestart);
+            gQueuedCancelCount = 0u;
+            gQueuedRestartCount = 0u;
+
+            R5900Context failingMain{};
+            failingMain.pc = kQueuedFailureDriver;
+            env.runtime.eeScheduler().reset(env.ram.data(), failingMain);
+            bool rejected = false;
+            try
+            {
+                env.runtime.eeScheduler().run();
+            }
+            catch (const std::runtime_error &)
+            {
+                rejected = true;
+            }
+            t.IsTrue(rejected, "unsafe queued callback attachment must fail through scheduler preparation");
+            t.IsFalse(env.runtime.eeScheduler().isRunning(),
+                      "failed scheduler run must clear its running state before cold-load retirement");
+            t.IsTrue(env.runtime.eeScheduler().retireInvocationStacksForColdLoad(),
+                     "failed scheduler run must clear running state so cold-load retirement can proceed");
+            t.Equals(gQueuedCancelCount, 1u, "cold-load retirement must cancel the retained unsafe queued callback exactly once");
+            env.runtime.eeScheduler().reset(env.ram.data(), R5900Context{});
+            t.Equals(gQueuedCancelCount, 1u, "following reset must not repeat queued callback cancellation");
+
+            R5900Context restartMain{};
+            restartMain.pc = kQueuedFailureRestart;
+            env.runtime.eeScheduler().reset(env.ram.data(), restartMain);
+            env.runtime.eeScheduler().run();
+            t.Equals(gQueuedRestartCount, 1u, "scheduler must restart after a failed queued attachment and cold reset");
+        });
+
+        tc.Run("borrowed stack equal to cached fallback remains external to fallback lease provenance", [](TestCase &t)
+        {
+            TestEnv env;
+            env.runtime.registerFunction(kCollisionChildEntry, collisionChildEntry);
+            env.runtime.registerFunction(kCollisionCallback, collisionCallback);
+            env.runtime.registerFunction(kCollisionChildResume, collisionChildResume);
+
+            R5900Context main{};
+            bindLegacyOwner(env, main);
+            (void)env.runtime.eeScheduler().invocationStackTop();
+            GuestInvocation external{};
+            setReg(external.context, 29, 0x00018000u);
+            try
+            {
+                env.runtime.eeScheduler().invokeCurrent(std::move(external));
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+            }
+            const uint32_t cachedSecondTop = env.runtime.eeScheduler().invocationStackTop();
+            const uint32_t childLiveSp = cachedSecondTop + 0x20u;
+            EeThreadCreateParams child{};
+            child.entry = kCollisionChildEntry;
+            child.stack = childLiveSp - 0x8000u;
+            child.stackSize = 0x8000u;
+            child.priority = 10;
+            const int childId = env.runtime.eeScheduler().createThread(child);
+            t.IsTrue(childId > 0, "collision test needs a separately owned child stack");
+            env.runtime.eeScheduler().startThread(childId, 0u, main, false);
+            try
+            {
+                env.runtime.eeScheduler().sleepCurrent();
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+            }
+            env.runtime.eeScheduler().run();
+
+            t.Equals(readU32(env.ram.data(), kCollisionCallbackRunsAddress), 1u,
+                     "borrowed callback with a colliding numeric stack top must execute");
+            t.Equals(readU32(env.ram.data(), kCollisionResumeRunsAddress), 1u,
+                     "borrowed callback must return to its owning child context");
+            t.Equals(readU32(env.ram.data(), kCollisionSpAddress), cachedSecondTop,
+                     "borrowed stack may numerically equal an earlier cached fallback top without inheriting its lease");
+        });
+
+        tc.Run("cold reset rewinds the arena and clears fallback cache keys", [](TestCase &t)
+        {
+            TestEnv env;
+            R5900Context main{};
+            bindLegacyOwner(env, main);
+            GuestInvocation oldFirst{};
+            env.runtime.eeScheduler().assignInvocationStack(oldFirst);
+            const uint32_t oldFirstTop = getReg(oldFirst.context, 29);
+            env.runtime.eeScheduler().reset(env.ram.data(), R5900Context{});
+
+            R5900Context reloadedMain{};
+            setReg(reloadedMain, 29, 0x00180000u);
+            env.runtime.eeScheduler().bindMainContextForSyscall(reloadedMain, env.ram.data());
+            GuestInvocation reloadFirst{};
+            env.runtime.eeScheduler().assignInvocationStack(reloadFirst);
+            const uint32_t reloadFirstTop = getReg(reloadFirst.context, 29);
+            writeU64(env.ram.data(), reloadFirstTop - kStoreOffset, 0x9999AAAABBBBCCCCull);
+            try
+            {
+                env.runtime.eeScheduler().invokeCurrent(std::move(reloadFirst));
+            }
+            catch (const EeDispatcherTransfer &)
+            {
+            }
+            GuestInvocation reloadSecond{};
+            env.runtime.eeScheduler().assignInvocationStack(reloadSecond);
+            const uint32_t reloadSecondTop = getReg(reloadSecond.context, 29);
+            writeU64(env.ram.data(), reloadSecondTop - kStoreOffset, 0xDDDDEEEEFFFF0001ull);
+
+            t.Equals(reloadFirstTop, oldFirstTop,
+                     "cold reset must rewind the fallback arena for the first reloaded owner key");
+            t.IsTrue(reloadSecondTop != reloadFirstTop,
+                     "new depth key after reset must not alias the reloaded first callback stack");
+            t.Equals(readU64(env.ram.data(), reloadFirstTop - kStoreOffset), 0x9999AAAABBBBCCCCull,
+                     "new depth allocation must not overwrite the reloaded first callback canary");
+        });
+    });
+}
