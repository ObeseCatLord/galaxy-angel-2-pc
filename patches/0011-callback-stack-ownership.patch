+}
+
+void EeScheduler::validateInvocationStackDeclaration(uint32_t address, uint32_t bytes) const
+{
+    if (isRunning()) assertExecutor();
+    if (bytes == 0u) return;
+    uint32_t begin = 0u;
+    bool scratch = false;
+    if (!resolveEeGuestRange(address, bytes, begin, scratch) || scratch)
+        throw std::runtime_error("EE stack or heap declaration is not a bounded RAM range");
+    const uint64_t end = uint64_t(begin) + bytes;
+    const auto validate = [begin, end](const GuestInvocation &invocation)
+    {
+        if (invocation.stackReservationBegin < invocation.stackReservationEnd &&
+            begin < invocation.stackReservationEnd && invocation.stackReservationBegin < end)
+            throw std::runtime_error("EE declaration overlaps a live isolated callback stack");
+    };
+    for (const auto &[id, owner] : m_threads)
+        for (const auto &invocation : owner.invocations) validate(invocation);
+    for (const auto &invocation : m_pendingInvocations) validate(invocation);
+}
+
+void EeScheduler::prepareInvocationStack(GuestInvocation &invocation)
+{
+    if (getRegU32(&invocation.context, 29) == 0u)
+        assignInvocationStack(invocation);
+    if (invocation.stackReservationBegin == 0u && invocation.stackReservationEnd == 0u) return;
+    if (invocation.stackReservationBegin >= invocation.stackReservationEnd ||
+        invocation.stackReservationEnd > PS2_RAM_SIZE ||
+        invocation.stackReservationEnd - invocation.stackReservationBegin != 0x4000u ||
+        ((invocation.stackReservationBegin | invocation.stackReservationEnd) & 0xFu) != 0u)
+        throw std::runtime_error("EE callback stack reservation extent is invalid");
+    validateIsolatedInvocationStack(invocation.stackReservationEnd - 0x10u);
+}
