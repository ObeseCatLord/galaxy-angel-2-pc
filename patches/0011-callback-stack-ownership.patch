+void EeScheduler::assignInvocationStack(GuestInvocation &invocation)
+{
+    const auto stack = selectInvocationStack();
+    SET_GPR_U32(&invocation.context, 29, stack.top);
+    invocation.stackReservationBegin = stack.begin;
+    invocation.stackReservationEnd = stack.end;
