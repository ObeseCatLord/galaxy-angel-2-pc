+                g_trace.workerCancelThrows = false;
+                throw std::runtime_error("EE21 worker cancellation");
+            }
+        };
+        runtime->eeScheduler().invokeCurrent(std::move(invocation));
+    }
+
+    void workerInvocation(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
