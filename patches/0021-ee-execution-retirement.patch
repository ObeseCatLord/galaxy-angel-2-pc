+    void internalDriver(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        GuestInvocation child{};
+        child.kind = GuestInvocationKind::RpcCallback;
+        child.context = *ctx;
+        child.context.pc = kInternalSleep;
+        child.onCancel = []
+        {
+            ++g_trace.internalCancelCount;
+            if (g_trace.internalCancelThrows)
