+        scheduler.sleepCurrent();
+    }
+
+    void workerTerminate(uint8_t *, R5900Context *, PS2Runtime *runtime)
+    {
+        uint32_t ownedStack = 0u;
+        (void)runtime->eeScheduler().terminateThread(g_trace.workerId, ownedStack, false);
+    }
