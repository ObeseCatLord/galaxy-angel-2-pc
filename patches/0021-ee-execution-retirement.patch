+    void internalSleep(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        const EeExecutionOwner active = scheduler.currentExecutionOwner();
+        g_trace.retainedInternal = {active.threadId, active.lifetime, 0u};
+        g_trace.retainedInternalId = active.threadId;
+        (void)scheduler.wakeupThread(EeScheduler::kMainThreadId, false);
+        ctx->pc = kInternalSleep;
+        scheduler.sleepCurrent();
+    }
+
+    void internalTerminate(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        ctx->pc = 0u;
+        uint32_t ownedStack = 0u;
+        (void)runtime->eeScheduler().terminateThread(g_trace.retainedInternalId, ownedStack, false);
+    }
