+uint64_t EeScheduler::reserveExecutionLifetime()
+{
+    if (m_executionLifetimeSequence == std::numeric_limits<uint64_t>::max())
+        throw std::overflow_error("EE execution lifetime exhausted");
+    return ++m_executionLifetimeSequence;
+}
+
+void EeScheduler::checkInvocationSequenceCapacity(size_t count) const
+{
+    if (count > std::numeric_limits<uint64_t>::max() - m_invocationSequence)
+        throw std::overflow_error("EE invocation sequence exhausted");
+}
+
+void EeScheduler::retireOrdinaryContexts()
+{
+    for (auto &[id, owner] : m_threads) makeDormant(owner);
+    m_currentThreadId = 0;
+}
+
+EeExecutionOwner EeScheduler::currentExecutionOwner() const noexcept
+{
+    const GuestThread *owner = currentThread();
+    if (!owner || owner->executionLifetime == 0u) return {};
+    return {owner->id, owner->executionLifetime,
+            owner->invocations.empty() ? 0u : owner->invocations.back().sequence};
+}
+
+bool EeScheduler::hasExecutionAccess(const EeExecutionOwner &key) const noexcept
+{
+    const GuestThread *owner = thread(key.threadId);
+    if (!owner || key.lifetime == 0u || owner->executionLifetime != key.lifetime)
+        return false;
+    if (key.invocationSequence == 0u) return true;
+    return std::any_of(owner->invocations.begin(), owner->invocations.end(),
+        [&key](const GuestInvocation &invocation)
+        { return invocation.sequence == key.invocationSequence; });
+}
+
+bool EeScheduler::setExecutionRetirementObserver(const void *owner,
+    std::function<void(const EeExecutionOwner &)> observer)
+{
+    if (!owner || !observer ||
+        (m_executionRetirementOwner && m_executionRetirementOwner != owner))
+        return false;
+    m_executionRetirementObserver = std::move(observer);
+    m_executionRetirementOwner = owner;
+    return true;
+}
+
+void EeScheduler::clearExecutionRetirementObserver(const void *owner) noexcept
+{
+    if (owner && m_executionRetirementOwner == owner)
+    {
+        m_executionRetirementObserver = {};
+        m_executionRetirementOwner = nullptr;
+    }
+}
