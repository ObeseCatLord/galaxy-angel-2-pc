+    struct TempElf
+    {
+        std::filesystem::path directory;
+        std::filesystem::path path;
+
+        TempElf(uint32_t firstAddress, uint32_t secondAddress, uint32_t secondSize)
+        {
+            directory = std::filesystem::temp_directory_path() / "ps2-ee-owner21";
+            std::filesystem::create_directories(directory);
+            path = directory / ("fixture-" + std::to_string(firstAddress) + "-" +
+                                std::to_string(secondAddress) + ".elf");
+            std::vector<uint8_t> bytes(124u, 0u);
+            const auto u16 = [&](size_t at, uint16_t value) { std::memcpy(bytes.data() + at, &value, 2u); };
+            const auto u32 = [&](size_t at, uint32_t value) { std::memcpy(bytes.data() + at, &value, 4u); };
+            u32(0u, 0x464C457Fu); bytes[4] = bytes[5] = bytes[6] = 1u;
+            u16(16u, 2u); u16(18u, 8u); u32(20u, 1u); u32(24u, firstAddress);
+            u32(28u, 52u); u16(40u, 52u); u16(42u, 32u); u16(44u, 2u);
+            for (uint32_t i = 0u; i != 2u; ++i)
+            {
+                const size_t at = 52u + i * 32u;
+                u32(at, 1u); u32(at + 4u, 116u + i * 4u);
+                u32(at + 8u, i == 0u ? firstAddress : secondAddress);
+                u32(at + 16u, 4u); u32(at + 20u, i == 0u ? 4u : secondSize);
+                u32(at + 24u, 6u); u32(at + 28u, 16u);
+            }
+            u32(116u, 0x11223344u); u32(120u, 0x55667788u);
+            std::ofstream out(path, std::ios::binary);
+            out.write(reinterpret_cast<const char *>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+            if (!out) throw std::runtime_error("EE21 synthetic ELF write failed");
+        }
+    };
+
+    void resetAndBind(Env &env, R5900Context &main, uint32_t pc)
+    {
+        main = R5900Context{};
+        main.pc = pc;
+        setReg(main, 29, 0x01FF0000u);
+        env.runtime.eeScheduler().reset(env.ram.data(), main);
+        env.runtime.eeScheduler().bindMainContextForSyscall(main, env.ram.data());
+    }
+}
