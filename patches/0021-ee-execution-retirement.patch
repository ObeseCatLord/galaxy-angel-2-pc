index 0000000..bdd1684
--- /dev/null
+++ b/ps2xTest/src/ps2_execution_counter_tests.cpp
@@ -0,0 +1,136 @@
+// Authored synthetic tests; no production counter controls or layout casts.
+#include "MiniTest.h"
+#include "ps2_runtime.h"
+#include "ps2_runtime_macros.h"
+#include "runtime/ee_scheduler.h"
+#include <cstddef>
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+struct InvocationCounterTag {
+    using type=uint64_t EeScheduler::*;
+    friend type accessMember(InvocationCounterTag);
+};
+struct LifetimeCounterTag {
+    using type=uint64_t EeScheduler::*;
+    friend type accessMember(LifetimeCounterTag);
+};
+struct PendingTag {
+    using type=std::deque<GuestInvocation> EeScheduler::*;
+    friend type accessMember(PendingTag);
+};
+template<class Tag,typename Tag::type Pointer> struct ExplicitMemberAccess {
+    friend typename Tag::type accessMember(Tag){return Pointer;}
+};
+// C++20 [temp.spec]/6 explicit-instantiation access exception. Definitions and
+// helpers stay in this TU; the class/header and production APIs remain intact.
+template struct ExplicitMemberAccess<InvocationCounterTag,&EeScheduler::m_invocationSequence>;
+template struct ExplicitMemberAccess<LifetimeCounterTag,&EeScheduler::m_executionLifetimeSequence>;
+template struct ExplicitMemberAccess<PendingTag,&EeScheduler::m_pendingInvocations>;
+uint64_t& invocationCounter(EeScheduler&s){return s.*accessMember(InvocationCounterTag{});}
+uint64_t& lifetimeCounter(EeScheduler&s){return s.*accessMember(LifetimeCounterTag{});}
+const std::deque<GuestInvocation>& pending(const EeScheduler&s){return s.*accessMember(PendingTag{});}
+constexpr uint64_t kMax=std::numeric_limits<uint64_t>::max();
+constexpr uint32_t kNever=0x00197000u;
+unsigned entered=0;
+void neverEntry(uint8_t*,R5900Context*ctx,PS2Runtime*){++entered;ctx->pc=0;}
+bool sameCpu(const R5900Context&a,const R5900Context&b){
+    return std::memcmp(&a,&b,offsetof(R5900Context,fcr31)+sizeof(a.fcr31))==0;
+}
+struct Env {
+    std::vector<uint8_t>ram=std::vector<uint8_t>(PS2_RAM_SIZE,0xA5);
+    PS2Runtime runtime;
+    R5900Context main{};
+    Env(){
+        main.pc=kNever;SET_GPR_U32(&main,29,0x01FF0000u);
+        runtime.eeScheduler().reset(ram.data(),main);
+        runtime.eeScheduler().bindMainContextForSyscall(main,ram.data());
+    }
+};
+bool overflowMatches(const std::exception&e,const char*message){
+    return dynamic_cast<const std::overflow_error*>(&e)&&std::string(e.what())==message;
+}
+GuestInvocation invocation(int&cancelled,bool throwing=false){
+    GuestInvocation g{};g.context.pc=kNever;
+    g.onCancel=[&cancelled,throwing]{++cancelled;if(throwing)throw std::runtime_error("distinct cancellation fault");};
+    return g;
+}
+}
+
+void register_ps2_execution_counter_tests(){
+    MiniTest::Case("EEExecutionCounter",[](TestCase&tc){
+        tc.Run("queued sequence exhaustion cancels once and preserves original fault",[](TestCase&t){
+            Env e;auto&s=e.runtime.eeScheduler();
+            const auto owner=s.currentExecutionOwner();const auto cpu=*s.currentContext();
+            const auto runtimeCpu=e.runtime.cpu();const auto ram=e.ram;const auto size=pending(s).size();
+            invocationCounter(s)=kMax;int cancelled=0;bool original=false;
+            try{s.queueInvocation(invocation(cancelled,true));}
+            catch(const std::exception&x){original=overflowMatches(x,"EE invocation sequence exhausted");}
+            t.IsTrue(original,"queue rejection must preserve overflow despite throwing cancellation");
+            t.Equals(cancelled,1,"rejected queued ownership must cancel exactly once");
+            t.Equals(invocationCounter(s),kMax,"queued sequence must not wrap");
+            t.Equals(pending(s).size(),size,"rejection must not insert or remove queued work");
+            t.IsTrue(s.currentExecutionOwner()==owner&&sameCpu(*s.currentContext(),cpu)&&
+                sameCpu(e.runtime.cpu(),runtimeCpu)&&e.ram==ram,"queue rejection must preserve owner and CPU/RAM");
+        });
+        tc.Run("checked child and sequence exhaustion reject before stack preparation",[](TestCase&t){
+            for(bool group:{false,true}){
+                Env e;auto&s=e.runtime.eeScheduler();const auto owner=s.currentExecutionOwner();
+                const auto cpu=*s.currentContext();const auto ram=e.ram;
+                invocationCounter(s)=kMax;int cancelled=0;bool original=false;
+                try{
+                    if(group){std::vector<GuestInvocation>v;v.push_back(invocation(cancelled));v.push_back(invocation(cancelled));s.invokeCurrentSequence(std::move(v));}
+                    else s.invokeCurrent(invocation(cancelled));
+                }catch(const std::exception&x){original=overflowMatches(x,"EE invocation sequence exhausted");}
+                t.IsTrue(original,"child/group exhaustion must report the specific capacity fault");
+                t.Equals(cancelled,group?2:1,"every rejected child must cancel once");
+                t.Equals(invocationCounter(s),kMax,"child sequence must not wrap");
+                t.IsTrue(s.currentThread()->invocations.empty()&&s.currentExecutionOwner()==owner&&
+                    sameCpu(*s.currentContext(),cpu)&&e.ram==ram,"rejected children must not prepare frames or alter parent");
+            }
+        });
+        tc.Run("lifetime exhaustion rejects start and reset before retirement",[](TestCase&t){
+            Env e;auto&s=e.runtime.eeScheduler();const auto owner=s.currentExecutionOwner();
+            EeThreadCreateParams p{};p.entry=kNever;p.stack=0x001A0000u;p.stackSize=0x1000;p.priority=10;
+            const int id=s.createThread(p);t.IsTrue(id>0,"worker creation must succeed before seeding");
+            const auto cpu=*s.currentContext();const auto runtimeCpu=e.runtime.cpu();const auto ram=e.ram;
+            lifetimeCounter(s)=kMax;
+            for(bool reset:{false,true}){
+                bool original=false;
+                try{if(reset)s.reset(e.ram.data(),e.main);else s.startThread(id,0,e.main,false);}
+                catch(const std::exception&x){original=overflowMatches(x,"EE execution lifetime exhausted");}
+                t.IsTrue(original,"start/reset must reject actual exhausted lifetime capacity");
+                t.Equals(lifetimeCounter(s),kMax,"lifetime must not wrap");
+                t.IsTrue(s.hasExecutionAccess(owner)&&s.currentExecutionOwner()==owner&&
+                    s.thread(id)->status==EeThreadStatus::Dormant&&s.thread(id)->executionLifetime==0&&
+                    sameCpu(*s.currentContext(),cpu)&&sameCpu(e.runtime.cpu(),runtimeCpu)&&e.ram==ram,
+                    "start/reset exhaustion must preserve old owner and unactivated worker");
+            }
+        });
+        tc.Run("idle dispatcher exhaustion retains pending ownership without activation",[](TestCase&t){
+            Env e;auto&s=e.runtime.eeScheduler();
+            // A real dispatcher return from the reset main's PC0 retires it
+            // before pending-work activation. No STOP suppresses that path.
+            R5900Context idle{};s.reset(e.ram.data(),idle);
+            int cancelled=0;e.runtime.registerFunction(kNever,neverEntry);entered=0;
+            s.queueInvocation(invocation(cancelled));const auto seq=invocationCounter(s);
+            const auto pendingSize=pending(s).size();const auto ram=e.ram;
+            lifetimeCounter(s)=kMax;bool original=false;
+            try{s.run();}catch(const std::exception&x){original=overflowMatches(x,"EE execution lifetime exhausted");}
+            t.IsTrue(original,"actual idle dispatcher reservation must execute and reject capacity");
+            t.Equals(entered,0u,"queued guest must not execute on rejected activation");
+            t.Equals(cancelled,0,"pending job ownership must remain queued until explicit cancellation");
+            t.Equals(pending(s).size(),pendingSize,"failed activation must not dequeue work");
+            t.Equals(invocationCounter(s),seq,"failed activation must not change queued sequence");
+            t.Equals(lifetimeCounter(s),kMax,"dispatcher lifetime must not wrap");
+            t.IsTrue(!s.thread(-1)&&s.currentThreadId()==0&&e.ram==ram,
+                "exhaustion must not create or activate an internal owner or write guest RAM");
+            s.discardInvocations();t.Equals(cancelled,1,"later explicit teardown must settle queued ownership once");
+        });
+    });
+}
