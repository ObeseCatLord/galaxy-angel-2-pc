+            t.Equals(g_trace.retired.matches(g_trace.workerOrdinary), size_t{0},
+                     "discard and rejected lifecycle operations must not publish false retirement");
+
+            t.IsTrue(scheduler.retireInvocationStacksForColdLoad(),
+                     "quiescent cold retirement must settle the retained ordinary worker");
+            t.IsFalse(scheduler.hasExecutionAccess(g_trace.workerOrdinary),
+                      "successful cold retirement must revoke the old positive worker owner");
+            t.Equals(g_trace.retired.matches(g_trace.workerOrdinary), size_t{1},
+                     "successful cold retirement must notify the old positive worker exactly once");
+            t.Equals(scheduler.startThread(g_trace.workerId, 0u, main, false), 0,
+                     "retired positive worker may restart normally");
+            const GuestThread *restarted = scheduler.thread(g_trace.workerId);
+            const EeExecutionOwner restartedOwner{g_trace.workerId,
+                restarted ? restarted->executionLifetime : 0u, 0u};
+            t.IsTrue(restartedOwner.lifetime > g_trace.workerOrdinary.lifetime &&
+                         scheduler.hasExecutionAccess(restartedOwner),
+                     "normal restart must publish a fresh positive worker lifetime");
+            t.Equals(scheduler.terminateThread(g_trace.workerId, ownedStack, false), 0,
+                     "normally restarted worker must terminate after old lifetime retirement");
+            t.Equals(scheduler.deleteThread(g_trace.workerId, ownedStack), 0,
+                     "normally restarted and retired positive worker must delete");
+        });
+
+        tc.Run("busy loader call rejects without disturbing ordinary execution", [](TestCase &t)
+        {
+            g_trace = {};
+            Env env;
+            t.IsTrue(env.runtime.memory().initialize(), "busy-load fixture requires RDRAM");
+            TempElf image(0x00104000u, 0x00105000u, 4u);
+            g_busyElfPath = image.path.string();
+            env.runtime.registerFunction(kBusyLoadEntry, busyLoadEntry);
+            R5900Context main{};
+            main.pc = kBusyLoadEntry;
+            env.runtime.eeScheduler().reset(env.ram.data(), main);
+            EeScheduler &scheduler = env.runtime.eeScheduler();
+            int observerToken = 0;
+            t.IsTrue(scheduler.setExecutionRetirementObserver(
+                &observerToken, [&scheduler](const EeExecutionOwner &owner)
+                {
+                    if (owner == g_trace.ordinary) scheduler.requestStop();
+                }), "busy-load fixture must install a nonthrowing observer");
+            scheduler.run();
+            t.IsTrue(g_trace.busyLoadRejected, "active guest execution must reject cold loading");
+            t.IsFalse(scheduler.hasExecutionAccess(g_trace.ordinary),
+                      "rejected busy load must not prevent ordinary return retirement");
+        });
+
+        tc.Run("cold ELF loading retires before writes and failed later segments require reset", [](TestCase &t)
+        {
+            Env env;
+            t.IsTrue(env.runtime.memory().initialize(), "loader requires actual RDRAM backing");
+            R5900Context main{};
+            resetAndBind(env, main, kReturnEntry);
+            const EeExecutionOwner old = env.runtime.eeScheduler().currentExecutionOwner();
+            int observerToken = 0;
+            RetireLog retired{};
+            t.IsTrue(env.runtime.eeScheduler().setExecutionRetirementObserver(
+                &observerToken, [&retired](const EeExecutionOwner &owner) { retired.append(owner); }),
+                "loader observer registration must succeed");
+            TempElf valid(0x00100000u, 0x00101000u, 4u);
+            t.IsTrue(env.runtime.loadELF(valid.path.string()), "cold synthetic ELF must load");
+            t.Equals(read32(env.runtime.memory().getRDRAM(), 0x00100000u), 0x11223344u,
+                     "successful cold load must write its first segment");
+            t.IsFalse(env.runtime.eeScheduler().hasExecutionAccess(old),
+                      "cold load must retire old execution before segment writes");
+            t.Equals(retired.count, size_t{1}, "cold load must notify once for the old ordinary owner");
+
+            const R5900Context loadedCpu = env.runtime.cpu();
+            bool validRunRejected = false;
+            try { env.runtime.eeScheduler().run(); }
+            catch (const std::logic_error &) { validRunRejected = true; }
+            t.IsTrue(validRunRejected, "cold-loaded scheduler must reject dispatch until reset");
+            t.IsTrue(sameContext(env.runtime.cpu(), loadedCpu),
+                     "rejected dispatch after successful load must preserve every loaded CPU field");
+
+            env.runtime.eeScheduler().reset(env.ram.data(), env.runtime.cpu());
+            env.runtime.eeScheduler().bindMainContextForSyscall(env.runtime.cpu(), env.ram.data());
+            const EeExecutionOwner afterSuccessfulReset = env.runtime.eeScheduler().currentExecutionOwner();
+            t.IsTrue(afterSuccessfulReset.lifetime > old.lifetime &&
+                         env.runtime.eeScheduler().thread(EeScheduler::kMainThreadId)->context.pc == loadedCpu.pc,
+                     "reset must consume the new successful-load context with a fresh lifetime");
+
+            TempElf malformed(0x00102000u, PS2_RAM_SIZE - 2u, 8u);
+            const uint32_t firstCanary = read32(env.runtime.memory().getRDRAM(), 0x00102000u);
+            t.Equals(firstCanary, 0u, "malformed-load first segment must begin as an observable canary");
+            t.IsFalse(env.runtime.loadELF(malformed.path.string()), "late malformed segment must fail");
+            t.Equals(read32(env.runtime.memory().getRDRAM(), 0x00102000u), 0x11223344u,
+                     "documented partial failure must expose the first write");
+            const R5900Context partiallyLoadedCpu = env.runtime.cpu();
+            bool failedRunRejected = false;
+            try { env.runtime.eeScheduler().run(); }
+            catch (const std::logic_error &) { failedRunRejected = true; }
+            t.IsTrue(failedRunRejected, "partially failed cold load must also reject dispatch until reset");
+            t.IsTrue(sameContext(env.runtime.cpu(), partiallyLoadedCpu),
+                     "rejected dispatch after partial load must preserve every new CPU field");
+            env.runtime.eeScheduler().reset(env.ram.data(), env.runtime.cpu());
+            env.runtime.eeScheduler().bindMainContextForSyscall(env.runtime.cpu(), env.ram.data());
+            const EeExecutionOwner afterPartialReset = env.runtime.eeScheduler().currentExecutionOwner();
+            t.IsTrue(afterPartialReset.lifetime > afterSuccessfulReset.lifetime &&
+                         env.runtime.eeScheduler().thread(EeScheduler::kMainThreadId)->context.pc == partiallyLoadedCpu.pc,
+                     "reset after partial load must consume its intended context with another fresh lifetime");
+        });
+
+        tc.Run("throwing queued cancellation retries through actual cold-discard cleanup", [](TestCase &t)
+        {
+            Env env;
+            R5900Context main{};
+            resetAndBind(env, main, kReturnEntry);
+            EeScheduler &scheduler = env.runtime.eeScheduler();
+            int observerToken = 0;
+            RetireLog retired{};
+            t.IsTrue(scheduler.setExecutionRetirementObserver(
+                &observerToken, [&retired](const EeExecutionOwner &owner) { retired.append(owner); }),
+                "throwing-cancel fixture must install its observer");
+            const EeExecutionOwner oldMain = scheduler.currentExecutionOwner();
+            bool throwOnce = true;
+            int cancelCount = 0;
+            GuestInvocation pending{};
+            pending.onCancel = [&]
+            {
+                ++cancelCount;
+                if (throwOnce)
+                {
+                    throwOnce = false;
+                    throw std::runtime_error("EE21 test cancellation");
+                }
+            };
+            scheduler.queueInvocation(std::move(pending));
+
+            bool cancellationThrew = false;
+            try { (void)scheduler.retireInvocationStacksForColdLoad(); }
+            catch (const std::runtime_error &) { cancellationThrew = true; }
+            t.IsTrue(cancellationThrew, "throwing queued cancellation must escape cold-discard cleanup");
+            t.IsFalse(scheduler.hasExecutionAccess(oldMain),
+                      "cold retirement must not leave the old ordinary owner accessible");
+            t.Equals(retired.matches(oldMain), size_t{1},
+                     "failed pending cancellation must not duplicate ordinary retirement notice");
+
+            t.IsTrue(scheduler.retireInvocationStacksForColdLoad(),
+                     "later successful cold retirement must retry queued cancellation cleanup");
+            t.Equals(cancelCount, 2, "later retirement must retry the queued callback exactly once");
+            t.Equals(retired.matches(oldMain), size_t{1},
+                     "successful retry must retain exactly one old ordinary retirement notice");
+            scheduler.reset(env.ram.data(), main);
+            scheduler.bindMainContextForSyscall(main, env.ram.data());
+            t.IsTrue(scheduler.currentExecutionOwner().lifetime > oldMain.lifetime,
+                     "reset after successful cleanup must establish a new ordinary lifetime");
+        });
+    });
+}
