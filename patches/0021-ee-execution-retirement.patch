+    void workerController(uint8_t *, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &scheduler = runtime->eeScheduler();
+        EeThreadCreateParams worker{};
+        worker.entry = kWorkerEntry;
+        worker.stack = 0x001A4000u;
+        worker.stackSize = 0x8000u;
+        worker.priority = 10;
